void Wait (long MicroSeconds)
{   
	MSG	msg; 
	UINT	MS=(UINT)MicroSeconds;
	
	SetTimer (hWndMain,9999,MS,0);
	msg.wParam = 0; 
	while (msg.wParam != 9999)
		GetMessage (&msg,hWndMain,WM_TIMER,WM_TIMER); 
	KillTimer (hWndMain,9999);
	return;
}

BOOL UpdateGlobalFile (LPSTR RptFile,LPSTR VName,LPSTR Value)
{
	char	str[1028];
	HFILE	Fid; 
	LPSTR	lpEq,lpDot;
	HFILE	FidOut;
	char	OldFile[128],NewFile[128],VarName[36];
	OFSTRUCT	OFStruct; 
	
	Fid = GSSiOpenFile (RptFile,&OFStruct,OF_READ); 
	if (Fid==HFILE_ERROR)
		return FALSE;  
	_fullpath(OldFile,RptFile,sizeof(OldFile));
	_fstrcpy(NewFile,OldFile);
	lpDot = _fstrrchr(NewFile,'.');
	if (lpDot) *lpDot=0;
	_fstrcat(NewFile,".ugf");
	FidOut = GSSiOpenFile(NewFile,&OFStruct,OF_CREATE);  
	
	_fstrcpy(VarName,"[");
	_fstrcat(VarName,VName);
	_fstrcat(VarName,"]");
	while (fgetstring (str,1024,Fid)) 
	{
		if (lpEq = _fstrchr(str,'='))
		{
			*lpEq=0;
			if (!_fstricmp(VarName,str))
			{   
				*lpEq++ = '=';
				_fstrcpy (lpEq,Value);
			} 
			else
				*lpEq = '=';
		}
		fputstring (str,FidOut);
	}                     
Exit:
	GSSiClose (Fid);
	GSSiClose (FidOut);
	GSSiRemove (OldFile);
	GSSiRename (NewFile,OldFile);
	
	return TRUE;
}
 
void GetRunDate (LPSTR RunID, LPSTR Date)
{
	char	str[260];
	HFILE	Fid;  
	OFSTRUCT	OFStruct;
	LPSTR	lpComma; 
	
	Fid = GSSiOpenFile ("rundate.txt",&OFStruct,OF_READ);   
	*Date = 0;
	if (Fid==HFILE_ERROR)
		return;  
	
	while (fgetstring (str,256,Fid)) 
	{
		if (lpComma = _fstrchr(str,','))
		{
			*lpComma++=0;
			if (!_fstricmp(RunID,str))
			{
				_fstrcpy(Date,lpComma);
				goto Exit;
			}
		}
	}                     
Exit:
	GSSiClose (Fid);
	
	return;
}

DWORD NextVarTime (void)
{
	if (VarTime < ULONG_MAX)
		VarTime++;
	else
		VarTime = 0;
		/* reset all times to 0 */
	return VarTime;
}
                                         
BOOL LoadGlobalInit (LPSTR File,BOOL First)
{   
	char	str[260], str2[260], mess[512];
	HFILE	Fid;  
	int		n=0; 
	BOOL	noerr=TRUE; 
	LPSTR	lpEq, lpEnd;  
	OFSTRUCT	OFStruct; 
	  
	LayerID = 0;
	Fid = GSSiOpenFile (File,&OFStruct,OF_READ);
	if (Fid==HFILE_ERROR)
		return TRUE; 
	if (TraceOn)
	{ 
		sprintf (str,"Loading global init file %s",File);
		GSSiTrace (str);
	} 
	while (fgetstring (str,256,Fid))
	{
		n++;
		if (str[0] != '\0' && str[0] != '#')
		{ 
			lpEq = _fstrchr (str,'=');
			if (!lpEq)
			{   
				sprintf (str2,"Error on line %i of %s",n,File);               
				noerr = FALSE;
				MessageBox( GetFocus(),str,str2,MB_ICONEXCLAMATION);
			}
			else
			{
				lpEq--;
				if (str[0] != '[' && *lpEq != ']')
				{
					sprintf (str2,"Error on line %i of %s",n,File);               
					noerr = FALSE;
					MessageBox( GetFocus(),str,str2,MB_ICONEXCLAMATION);
				}
				else
				{   
					*lpEq = '\0';  
					lpEq+=2;
					lpEnd = _fstrchr(lpEq,0);
					lpEnd--;
					if (*lpEnd == ';') *lpEnd = 0;
					_fstrcpy (str2,lpEq);
					if (First || _fstricmp (&str[1],"%DATA_LOC"))
						SetGlobalValue (&str[1],str2);  
					if (TraceOn)
					{ 
						sprintf (mess,"%s: %s",&str[1],str2);
						GSSiTrace (mess);
					}
					
				}
			}
		}
	}
	GSSiClose (Fid);
	if (TraceOn)
	{ 
		sprintf (str,"Close global init file %s",File);
		GSSiTrace (str);
	}  
	
	
	return noerr;
} 

BOOL GetCurrentGraphicsDBName (LPSTR Name,short Type)
{
	short	NumFields=25, NumIndexFields=1; 
	short	CurrentVersion=1002; 
	HANDLE	hStr=GSSiGlobAlloc (GMEM_MOVEABLE,1024);
	LPSTR	DefStr = GlobalLock (hStr); 
	USHORT	StringID=IDS_GRAPHICSDEF;
    
    if (Type == 2)
    {   
    	NumFields = 6;
    	CurrentVersion = 2001;
    	StringID = IDS_GRAPHIC2DEF;
    }
   	sprintf (Name,"[%%DL]grt%i%i.gmd",Type,CurrentVersion); 
   	if (!ExistFile (Name))
   	{
		if (!LoadString(hInst, StringID, DefStr, 256))
			goto RtnFalse;  
		if (StringID == IDS_GRAPHICSDEF)
		{
			if (!LoadString(hInst, IDS_GRAPHICSDEF2, _fstrchr (DefStr,0), 256))
				goto RtnFalse;
		}  
		if (!CreateGWDDatabase (Name,CurrentVersion,NumFields,NumIndexFields,DefStr))
			goto RtnFalse; 
	} 
	GSSiGlobUlFree (&hStr);
	return TRUE;
RtnFalse:
	GSSiGlobUlFree (&hStr);
	return FALSE;
}

short OpenDataFile (LPSTR InName,LPSTR SQL, short Access, HANDLE *hDB)

{ 
	short	i, NumFields,Type, l, nf; 
	LPSTR	pTable=0;
	LPOPENFILEDATA	FilePtr;
	LPOPENSQLDATA	SQLPtr;
	LPFIELDINFO	lpFieldInfoSave, lpFieldInfo;
	HANDLE	FileHandle, handle, hFields;
	LPGWDHEADER	lpGWDHead;
	LPSTR	lpEq, lpDelim,lpFieldStart;
	short	index, LocDelim;   
	LPSTR	IDName;
	LPSTR	str, cName;   
   	LPSTR	drive,dir,fname,ext, driver, table;   
   	LPSTR	Name;
   	LPOFSTRUCT	pOFStruct;
	HANDLE	hMem=0;
	
    if (*hDB) 
    {
		SQLPtr = (LPOPENSQLDATA) GlobalLock (*hDB);
        FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle);
	    Type = FilePtr->Type;  
	    GlobalUnlock (SQLPtr->OFHandle);
	    GlobalUnlock (*hDB);
	    return Type;
	} 
	hMem=GSSiGlobAlloc (GHND,2048);
	str = GlobalLock (hMem);
	IDName = str + 256;
	cName = IDName + 256;
	drive = cName + 256;
	dir = drive + 8;
	fname = dir + 128;
	ext = fname + 64;
	driver = ext + 8;   
	table = driver + 128;
	pOFStruct = (LPOFSTRUCT)(table + 256);
	Name=cName;
    _fstrcpy (Name,InName); 
    if (_fstrstr (Name,"attribut\\graphics.gmd"))   
    {
    	LPSTR lpEQ = _fstrchr (Name,'=');
    	
    	if (lpEQ)
    		lpEQ++;
    	else
    		lpEQ = Name;  
    	GetCurrentGraphicsDBName (lpEQ,1);
    }
    if (_fstrstr (Name,"attribut\\graphic2.gmd"))   
    {
    	LPSTR lpEQ = _fstrchr (Name,'=');
    	
    	if (lpEQ)
    		lpEQ++;
    	else
    		lpEQ = Name;  
    	GetCurrentGraphicsDBName (lpEQ,2);
    }
    ExpandText (Name);    
    
    if (!_fstricmp (Name,"HLTLIST"))
    {   
    	HltFetchPos = BT_FIRST;
    	goto RtnTrue;
    }
    
	lpEq = MatchLev (Name,'=');
	LocDelim = _fstrcspn (Name,",|(;");
	if ((long)lpEq - (long)Name > LocDelim) 
		lpEq = 0;
	if (lpEq) 
	{
		*lpEq = 0;
		_fstrcpy (IDName,Name);
		*lpEq = '=';
		Name = ++lpEq;
	}
	l = _fstrlen (Name);
    if (_fstrncmp(Name,"ODBC|",5))
    	_fstrupr (Name);
    if (_fstrstr(Name,".GMD"))
    	Type = UMIFS_DATAFILE;
    else if (_fstrstr(Name,".GCF"))
    	Type = COMBO_DATAFILE;
    else if (_fstrstr(Name,".DBF"))
    	Type = DBF_DATAFILE;
    else if (!_fstrncmp (Name,"ODBC|",5))
    	Type =ODBC_DATAFILE;
    else if (_fstrstr(Name,".TXT"))
    	Type =TEXT_DATAFILE;
    else if (_fstrstr(Name,".DTM"))
    	Type =DTM_DATAFILE;
    else
    	goto RtnFalse;
    if ((FilePtr = InOpenFileList(Name)))
    	goto ProcessSQL;
	switch (Type)
	{   
		case 0:
			FileHandle = NULL;
			break;
			
		case UMIFS_DATAFILE:
			FileHandle = OpenGWDatabase (Name,Access);
			break;

		case COMBO_DATAFILE:
			FileHandle = OpenComboDatabase (Name,SQL);
			break;

		case FOXPRO_DATAFILE:
	       	FileHandle = OpenExternalDatabase (Name); 
	       	break;

	    case MSACCESS_DATAFILE:
	       	FileHandle = OpenExternalDatabase (Name);
 	    	break; 

	    case DTM_DATAFILE:
	       	FileHandle = DTMOpen (Name,DBL_MAX,BT_READ);
 	    	break; 

        case ODBC_DATAFILE:
	       	FileHandle = OpenExternalDatabase (Name); 
            if(FileHandle)
            {
		       	pTable = (_fstrchr(Name,'|')) ;
		       	if(pTable)
		       	{ 
		       	  pTable++;
		       	  pTable = (_fstrchr(pTable,'|')) ;
				  if(pTable)
				  { 
		       	    pTable++;
		          	FileHandle =OpenDatabaseTable (FileHandle, pTable);
		          }
	            }  
	        }
 	    	break;
        case DBF_DATAFILE:
        {   
        	
        	_splitpath (Name,drive,dir,fname,ext); 
        	sprintf (driver,"DBF;DefaultDir=%s%s",drive,dir);
	       	FileHandle = OpenExternalDatabase (driver); 
            if(FileHandle && *fname != '*')
            {   
            	sprintf (table,"%s%s",fname,ext);
	          	FileHandle =OpenDatabaseTable (FileHandle, table);
	        } 
	    }
 	    	break;
        case TEXT_DATAFILE:
        {   
        	HFILE	Fid=GSSiOpenFile (Name,pOFStruct,OF_READ);
        	
        	if (Fid == HFILE_ERROR) 
        	{
				FileHandle = NULL;
				GSSiMessageBox ("Unable to open TXT file",Name,MB_ICONEXCLAMATION);
			}
			else
			{   
				GSSiClose (Fid);
		       	_splitpath (pOFStruct->szPathName,drive,dir,fname,ext); 
	        	sprintf (driver,"TXT;DefaultDir=%s%s",drive,dir);
		       	FileHandle = OpenExternalDatabase (driver); 
	            if(FileHandle)
	            {   
	            	sprintf (table,"%s%s",fname,ext);
		          	FileHandle =OpenDatabaseTable (FileHandle, table);
		        }
		    } 
	    }
 	    	break;
    }
    if(!FileHandle)
    	goto RtnFalse;
    	            
    NumFields = 0;  
    hFields = GlobalAlloc (GMEM_MOVEABLE,MAXFIELDS*sizeof(FIELDINFO));
    lpFieldInfoSave = (LPFIELDINFO)GlobalLock(hFields);  
    index = 0;
	lpFieldInfo = GetFieldInfo (FileHandle,TRUE,Type);
	while (lpFieldInfo)
	{   
		lpFieldInfo->index = index++; 
		lpFieldInfo->hCurVal = 0;
		*lpFieldInfoSave++ = *lpFieldInfo;
		NumFields++;
		lpFieldInfo = GetFieldInfo (FileHandle,FALSE,Type);
	}
	GlobalUnlock(hFields);
    if (!NumFields && pTable)
    	goto RtnFalse;	
AllocFilePtr: 
	nf = max (NumFields,5);
    handle = GlobalAlloc (GHND,sizeof(OPENFILEDATA)+nf*sizeof(FIELDINFO));
    FilePtr = (LPOPENFILEDATA)GlobalLock (handle);
    FilePtr->myhandle = handle;  
    FilePtr->Type = Type;
    FilePtr->MacroID = CurrentMacro; 
	if (Type == UMIFS_DATAFILE || Type == DTM_DATAFILE)
		_fullpath (FilePtr->fullpath,Name,_MAX_PATH);  
	else
		_fstrcpy (FilePtr->fullpath,Name);
	FilePtr->Offset = -1;
    FilePtr->FileHandle = FileHandle;
    FilePtr->NumFields = NumFields;
    lpFieldInfoSave = (LPFIELDINFO)GlobalLock(hFields);
	lpFieldInfo = &FilePtr->FldInfo;
	if (NumFields)
		for (i=0;i<NumFields;i++,lpFieldInfoSave++,lpFieldInfo++)
			*lpFieldInfo = *lpFieldInfoSave;
	else
	{
		for (i=0;i<nf;i++,lpFieldInfoSave++,lpFieldInfo++) 
		{   
			if (!i)
				_fstrcpy (lpFieldInfo->name,"RESULT");
			else
				sprintf (lpFieldInfo->name,"RESULT%i",i+1);  
			lpFieldInfo->type = SQL_VARCHAR;
			lpFieldInfo->length = 255;
		}
	    FilePtr->NumFields = nf;
	}
    GSSiGlobUlFree (&hFields);

ProcessSQL: 
    handle = GlobalAlloc(GHND,sizeof(OPENSQLDATA)+MAXFIELDINSQL*sizeof(SQLFIELD));
    SQLPtr = (LPOPENSQLDATA)GlobalLock (handle); 
    _fstrcpy (SQLPtr->IDName,IDName);
    FilePtr->SQLHandles[FilePtr->NumSQLs++] = handle;
    SQLPtr->myhandle = handle;
    SQLPtr->OFHandle = FilePtr->myhandle;
	ProcessFileSQL (SQLPtr,FilePtr,SQL);                                        
    
    GlobalUnlock (SQLPtr->myhandle);  
    GlobalUnlock (FilePtr->myhandle);  
    *hDB = handle;
    AddToOpenFileList(handle); 
RtnTrue:  
	GSSiGlobUlFree (&hMem);
	return TRUE;
RtnFalse:
	GSSiGlobUlFree (&hMem);
	return FALSE;
} 

void ProcessFileSQL (LPOPENSQLDATA SQLPtr,LPOPENFILEDATA FilePtr,LPSTR SQL)
{
    short	NumFieldInSQL = 0; 
    HANDLE	hMem=GSSiGlobAlloc (GMEM_MOVEABLE,256);
    LPSTR	str=GlobalLock (hMem);
    HANDLE	hFields = GlobalAlloc (GHND,MAXFIELDINSQL*sizeof(SQLFIELD));
    LPSQLFIELD	SQLField = (LPSQLFIELD)GlobalLock(hFields);     
	LPSQLFIELD	lpSQLField; 
    LPSTR	lpFieldStart = str;  
    LPSTR	lpEq; 
    LPGWDHEADER	lpGWDHead;    
	LPGWFLDINFO	lpGWFldInfo;
    short	i;
    
    _fstrcpy (str,SQL); 
    lpEq = _fstrchr (lpFieldStart,'=');
    while (lpEq)
    {   
    	LPSTR	lpGlobal, lpEndGlobal, lpFieldEnd, lpString, lpStringEnd;  
     
     	lpFieldEnd = lpEq; 
     	lpStringEnd = _fstrchr (lpEq,';');
     	if (!lpStringEnd)
        {
        	lpStringEnd = _fstrchr (lpEq,0);
        	*(lpStringEnd+1) = 0;
        }
        else
     		*lpStringEnd = 0;  
     	lpEq++; 
     	while (*lpEq == ' ') lpEq++;
     	_fstrcpy (SQLField->String,lpEq);
NextGlobal:
    	if ((lpGlobal = _fstrchr (lpEq,'['))) 
	    {    
	    	if ((lpEndGlobal = _fstrchr (lpGlobal,']')))
	    	{    
	    		*lpFieldEnd = '\0';
	    		lpGlobal++;
	    		*lpEndGlobal = '\0';
		     	Truncate (lpFieldStart);
		    	if (FilePtr->Type == UMIFS_DATAFILE)
		    	{   
		    		lpGWDHead =(LPGWDHEADER) GlobalLock (FilePtr->FileHandle);

		        	for (i=0,lpGWFldInfo=lpGWDHead->pFldInfo;i<lpGWDHead->NumFields;i++,lpGWFldInfo++)
		        	{	
		        		if (!_fstricmp (lpGWFldInfo->Name,lpFieldStart))
		        		{ 
		        			SQLField->FieldNum = i; 
		        			break;
		        		}
		        	}
		        	GlobalUnlock (FilePtr->FileHandle);
		    	}
		    	else
		    		SQLField->FieldNum = -1; 
		    	SQLField->hGlobal = AllocateVar (lpGlobal);
		    	NumFieldInSQL++;
		    	SQLField++; 
		    	lpEq = lpEndGlobal;  
		    	lpEq++;
		    	goto NextGlobal;
		    }
	    }
       	lpFieldStart = lpStringEnd;
       	lpFieldStart++;
	    lpEq = _fstrchr (lpFieldStart,'=');
    } 
    GlobalUnlock(hFields);
    
    _fstrcpy (SQLPtr->SQL,SQL);  
    SQLPtr->st = 2;
    if (NumFieldInSQL)
    	SQLPtr->NumGlobals = NumFieldInSQL; 
    else
    	SQLPtr->NumGlobals = -1; 
    SQLField = (LPSQLFIELD)GlobalLock (hFields);
    lpSQLField = &SQLPtr->SQLField;
    for (i=0;i<NumFieldInSQL;i++,SQLField++,lpSQLField++)
    	*lpSQLField = *SQLField;  
	if (FilePtr->Type == UMIFS_DATAFILE)
	    SQLPtr->IndexToUse =  SelectGWDIndex (FilePtr->FileHandle,SQLPtr);
    GSSiGlobUlFree (&hFields);   
    GSSiGlobUlFree (&hMem);
	return;
}

int	SelectGWDIndex (HANDLE hFile,LPOPENSQLDATA	SQLPtr)
{
	LPGWDHEADER	lpGWDHead;
	LPGWFLDINFO	lpGWFldInfo;  
	LPSQLFIELD	lpSQLField;
	short	index=-1, i,j,k, nif=0, maxf=-1;
	
	if (SQLPtr->NumGlobals == -1)
		return 0;
	lpGWDHead =(LPGWDHEADER) GlobalLock (hFile);
	for (i=0;i<lpGWDHead->NumIndex;i++)
	{	
		nif=0;
		for (k=0;k<lpGWDHead->NumIndexFields[i];k++)
		{ 
			for (j=0,lpSQLField=&SQLPtr->SQLField;j<SQLPtr->NumGlobals;j++,lpSQLField++)
			{ 
				if (lpGWDHead->IndexFields[i][k] == lpSQLField->FieldNum)
					goto NextField;
			} 
			goto NextIndex;
NextField:
			nif++;
		}
NextIndex:
		if (nif > maxf) 
		{
			index = i;
			maxf = nif;
		}
	} 
	GlobalUnlock (hFile);
	return index;
}


HANDLE GetDBHandleFromSQL (HANDLE hSQL)
{   HANDLE	DBHandle;
	LPOPENFILEDATA	FilePtr;
	LPOPENSQLDATA	SQLPtr;

	SQLPtr = (LPOPENSQLDATA)GlobalLock (hSQL);
	FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle);
	DBHandle = FilePtr->FileHandle;
	GlobalUnlock (SQLPtr->OFHandle);
	GlobalUnlock (hSQL);  
	return DBHandle;
}

BOOL CloseDataFile (BOOL Final, HANDLE *hDB)
{   
	HANDLE	handle; 
	LPOPENFILEDATA	FilePtr;
	LPOPENSQLDATA	SQLPtr;
	int	i,j, NewNum; 
	
	if (!*hDB)
		return(TRUE);
	
	SQLPtr = (LPOPENSQLDATA)GlobalLock (*hDB); 
	if (!SQLPtr) 
	{
		*hDB = 0;
		return TRUE;
	}
	FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle); 
	GSSiGlobUlFree (&FilePtr->BufferHandle); 
	NewNum = FilePtr->NumSQLs;
	for (i=j=0;i<FilePtr->NumSQLs;i++)
	{   
		FilePtr->SQLHandles[j] = FilePtr->SQLHandles[i];
		if (FilePtr->SQLHandles[i] != *hDB)
			j++; 
		else
			NewNum--;
	}
	FilePtr->NumSQLs = NewNum;
	if (FilePtr->NumSQLs)
	{
		GlobalUnlock (SQLPtr->OFHandle); 
		goto DeallocSQL;
	}
	
	switch (FilePtr->Type)
	{
		case UMIFS_DATAFILE:
			CloseGWDatabase (FilePtr->FileHandle);
 			break;

		case DTM_DATAFILE:
			DTMClose (&FilePtr->FileHandle);
 			break;

		case COMBO_DATAFILE:
			CloseComboDatabase (FilePtr->FileHandle);
 			break;

		case FOXPRO_DATAFILE:
	       	if (Final)
	       	{
	          CloseExternalDatabase (FilePtr->FileHandle);
              break;
	       	}
	    case ODBC_DATAFILE:  
	    case DBF_DATAFILE:
	    case TEXT_DATAFILE:
	    case MSACCESS_DATAFILE:
	        {
			  ClearCurVals (FilePtr);
			  if (SQLPtr->hstmt)
			  {
				SQLFreeStmt(SQLPtr->hstmt, SQL_DROP);
				SQLPtr->hstmt = NULL;
			  } 
              CloseExternalDatabase (FilePtr->FileHandle);
              break;
	    	} 

    }
    handle = FilePtr->myhandle; 
    FilePtr->myhandle = 0;
    GSSiGlobUlFree (&handle);
DeallocSQL:
    RemoveFromOpenFileList(*hDB); 
	GSSiGlobUlFree (hDB);
    return (TRUE);
}  

void SetUDIValue (LPSTR Name, LPSTR Value)
{   
	int		i,j;
	LPTAGDEF	pTAGDef;
	
	SetGlobalValue (Name,Value); 
	LoadTAGDef();
	if (NumTAGDef>0)
	{
		pTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
		for (i=0;i<NumTAGDef;i++,pTAGDef++)
		{ 
			if (!_fstrcmp(pTAGDef->Prefix,Name))
			{   
				for (j=0;j<pTAGDef->NumVar;j++)
				{
					SetGlobalValueLen (pTAGDef->VarName[j],&Value[pTAGDef->VarStart[j]],pTAGDef->VarLen[j]);
				}
				goto GotTAG;
			}
		}
	GotTAG:
		GlobalUnlock (hTAGDef);
	}
	SetGlobalValue2 (hUDI,Value,0);
		
	return;  
}  

BOOL LoadTAGDef (void)
{   
	HFILE	TDFid; 
	LPSTR	lpSpace;
	OFSTRUCT	OFStruct;  
	char	TDFile[128], Mess[256];
	int		i,j, lineno=0;
	LPTAGDEF	pTAGDef;
	
	
	if (NumTAGDef<0)
	{   
		char	line[260];
			
		_fstrcpy (TDFile,"[%DATA_LOC]tagdef.txt");
		TDFid = GSSiOpenFile(TDFile,&OFStruct,OF_READ);
		NumTAGDef=0;
		if (TDFid != HFILE_ERROR)
		{   
			hTAGDef=GSSiGlobAlloc (GHND,UINT_MAX);
			pTAGDef = 0; 
	NextLine: 
			lineno++;
			if (!fgetstring (line,256,TDFid))
				goto EndFile;  
			if (*line=='#' || !*line); 
			else if (line[0]!=' ') 
			{   
				NumTAGDef++;
				if (pTAGDef)
					pTAGDef++;
				else
					pTAGDef = (LPTAGDEF)GlobalLock (hTAGDef); 
				if (sscanf (line,"%s %i %i %i",
					&pTAGDef->Prefix,&pTAGDef->Len,&pTAGDef->IncBeg,&pTAGDef->IncLen) != 4)
				{
					sprintf (Mess,"Invalid line number %i in TAG definition file\r\n%s",lineno,line);
					MessageBox (GetFocus(),Mess,NULL,MB_ICONEXCLAMATION);
				}
			}
			else
			{   
				lpSpace = _fstrchr (&line[1],' ');
				if (sscanf (&line[1],"%s %i %i %i",
					&pTAGDef->VarName[pTAGDef->NumVar],&pTAGDef->VarStart[pTAGDef->NumVar],
					&pTAGDef->VarLen[pTAGDef->NumVar]) != 3)
				{
					sprintf (Mess,"Invalid line number %i in TAG definition file\r\n%s",lineno,line);
					MessageBox (GetFocus(),Mess,NULL,MB_ICONEXCLAMATION);
				}
				pTAGDef->VarStart[pTAGDef->NumVar]-=1;
				pTAGDef->NumVar++;
			}  
			goto NextLine;
	EndFile: 
			if (hTAGDef) 
			{
				GlobalUnlock (hTAGDef); 
				hTAGDef = GlobalReAlloc (hTAGDef,(long)NumTAGDef*sizeof(TAGDEF),GMEM_MOVEABLE);
			}
			GSSiClose (TDFid);
		}  
	}
	return TRUE; 
}


void SetUDIValueLen (LPSTR Name, LPSTR Value, short len)
{
	char	Value2[66];
	
	strncpy0(Value2,Value,len);
	SetUDIValue (Name,Value2);
	return;
}

void SetGlobalValue (LPSTR InName, LPSTR InValue)
{   
	VARPNT	VP;
	HANDLE	handle, hVal; 
	BOOL	BVal, FoundLit;
	LPSTR	lpPar, lpEndPar=NULL, Value, Name;
	short	Index=0; 
	short	n;
    
    if (!ContinueProcessing)
    	return; 
    hVal = GSSiGlobAlloc (GMEM_MOVEABLE,2048+256);
    Value = GlobalLock (hVal); 
    Name = Value + 2048;
   	_fstrcpy (Value,InValue);
	ExpandText (Value);
	FoundLit = FoundLiteral;	                  
	_fstrcpy (Name,InName);
	ExpandText (Name);
	if ((lpPar=_fstrchr (Name,'.')))
	{   
		HANDLE	hSQLPtr; 

		*lpPar++ = 0;
			
       	hSQLPtr = GetDBByIDName (Name);
       	if (!hSQLPtr)
       		goto Rtn; 
	    SetGMDField (hSQLPtr,lpPar,Value);
	    goto Rtn;
    }
	lpPar = _fstrrchr(Name,'(');
	if (lpPar)
	{
		lpEndPar = _fstrchr(lpPar,')');
		if (lpEndPar)
		{   
			*lpPar = 0;
			if ((handle = FindVar (Name)))
			{
				VP = (VARPNT)GlobalLock (handle);
				if (!VP->Type)
					*lpPar = '(';
				GlobalUnlock (handle);
			}
			else
				*lpPar = '('; 
			lpPar++;
			Index = atoi(lpPar);
		}
	}
	SetGlobalValue3 (Name,Value,Index,FoundLit);
Rtn:    
	GSSiGlobUlFree (&hVal);
	return;
}          
void SetGlobalValue3 (LPSTR Name, LPSTR Value, short Index, BOOL FoundLit)
{
	VARPNT	VP;
	HANDLE	handle;  
	
	if (!*Name)
		return;
	handle = AllocateVar (Name); 
	VP = (VARPNT)GlobalLock (handle);
	VP->ContainsGorF = FoundLit; 
	GlobalUnlock (handle);  
	SetGlobalValue2 (handle,Value,Index);
	if (FoundLit)
		LinkIncludedVars (handle,Value);
	return;
} 

void SetLinkedVarTime (VARPNT VP)
{   
	VARPNT	VPLinked;  
	UINT 	i;
	
	for (i=0;i<VP->NumLinkedVars;i++)
	{
		VPLinked = (VARPNT)GlobalLock (VP->LinkedVar[i]);
		if (!VPLinked)
		{ 
			VP->NumLinkedVars = 0;
			return;
		}
		VPLinked->changetime = VP->changetime;
		GlobalUnlock (VP->LinkedVar[i]);	
	}
	return;
} 

void LinkIncludedVars (HANDLE hVar,LPSTR Value)
{   
	HANDLE	hMem = GSSiGlobAlloc (GMEM_MOVEABLE,4096);
	LPSTR	pMem = GlobalLock (hMem);
	
	_fstrcpy (pMem,Value);
	LinkToVar = hVar;
	ExpandText (pMem);
	GSSiGlobUlFree (&hMem);
	LinkToVar = 0;
	return;
}

void SetGlobalValue2 (HANDLE handle, LPSTR Value, short Index)
{
	VARPNT	VP;
	BOOL	BVal; 
	short	n, type, i,ii, ib, ie;    
	long	Color;
	char	nullval=0;
    
    if (!handle)
    	return; 
    if (!Value)
    	Value = &nullval;
	VP = (VARPNT)GlobalLock (handle);
	type = VP->Type; 
	if (type == 99 && AltProjLocked)
		ii=1;
	else 
	{   
		if (VP->ValueIsHandle)
		{
			HANDLE handle = atol (VP->Value);
			GSSiGlobFree (&handle); 
			VP->ValueIsHandle = 0;
		}
	
		VP->Len = min (255,_fstrlen(Value));
		if (type == 102) //%DL
			_fullpath (VP->Value,Value,255); 
		else 
		{   
			if (VP->Len == 255)
				Value[255] = 0;
			_fstrcpy (VP->Value,Value);
		}
		VP->changetime = NextVarTime();
		SetLinkedVarTime (VP);
		if (VP->Type == 99)
			ConvertCoordClose (); 
	} 
	GlobalUnlock (handle);  
	if (!type)
		return;
	switch (type)
	{
		case 2:
			if (!_fstrcspn (Value," 1TtYy"))
				FileProjectionType = 1;
			else
				FileProjectionType = 0;
			break;  
		case 3:
			CurState = atoi (Value); 
			if (CurState > 0 && CurState < 74)
				HaveStates[CurState]=TRUE;
			break;
		case 4:
			if (!_fstrcspn (Value," 1TtYy"))
				ShowScale = TRUE;
			else
				ShowScale = FALSE;
			break;     
		case 5:
			if (!_fstrcspn (Value," 1TtYy"))
				BVal = TRUE;
			else
				BVal = 2;  
			if (CurVis->FileIsVisible[Index])
				CurVis->FileIsVisible[Index]=BVal;
			break;     
		case 6:
			if (!_fstrcspn (Value," 1TtYy"))
				DoGraphics = TRUE;
			else
				DoGraphics = FALSE;
			break;     
		case 7: 
			SetTrace(atoi(Value));
			break;     
		case 8:
			if (!_fstrcspn (Value," 1TtYy"))
				FillAreas = TRUE;
			else
				FillAreas = FALSE;
			break; 
		case 9:  
			InternalRefno = atol (Value);
			break; 
		case 10:
			MaxPick = atoi (Value);
			MaxPick = min (MaxPick,MAXPICKITEMS);
			MaxPick = max (1,MaxPick);
			break;
		case 11:
			if (Index >=0 && Index < 8)
				PenCOLOR[Index] = atol (Value);
			break;
		case 12:
			if (Index >=0 && Index < 8)
				PenWIDTH[Index] = atoi (Value);
			break;   
		case 13:
			if (Index >=0 && Index < 10)
				GlobalColors[Index]=atol (Value);
			break;
		case 14:
			TextFreq = atol (Value);
			break;
		case 15:
			CurFont = atol (Value);
			break;
			   
		case 16: 
			if (CurView)
			{
				if (CurView->hWnd)
					SetWindowText (CurView->hWnd,Value); 
				break;
			}                      
			if (hWndMain)
				SetWindowText (hWndMain,Value); 
			break;
			   
		case 19:
			if (!_fstrcspn (Value," 1TtYy"))
				DisplayMarkers = 1;
			else
				DisplayMarkers = 0;
			break;   
			
		case 20:
			if (!_fstrcspn (Value," 1TtYy"))
				DisplaySymbol = 1;
			else
				DisplaySymbol = 0;
			break;   
			
		case 35:  
			MaxDisplayPoints = IDNINT (atof (Value));
			break;
			
		case 37:
			if (!_fstrcspn (Value," 1TtYy"))
				SetRefno = 1;
			else
				SetRefno = 0;
			break;   
			
		case 38:
			if (Index <1 || Index >3) break;
			if (!_fstrcspn (Value," 1TtYy"))
				DisplayCoord[Index-1] = 1;
			else
				DisplayCoord[Index-1] = 0;
			break;
			   
		case 39:
			if (!_fstrcspn (Value," 1TtYy"))
				ByState = 1;
			else
				ByState = 0;
			break; 
			
		case 44:  
			if (!_fstrcspn (Value," 1TtYy"))
				UseBinFileList = 1;
			else
				UseBinFileList = 0;
			break;
			 
		case 45:
			if (Index >=0 && Index < 8)
				AreaCOLOR[Index] = atol (Value);  
				
		case 46:
			PickLimit = atof (Value);
			break;
				
		case 47:  
			ProcessGCmdStrings = atoi (Value);
			break;
			 
		case 48:
			HighlightColor = atol (Value);
			break;
				
		case 49:  
			if (!_fstrcspn (Value," 1TtYy"))
				Display16BitColor = 1;
			else
				Display16BitColor = 0;
			break;
			 
		case 50:  
			if (!_fstrcspn (Value," 1TtYy"))
				FastOrthos = 1;
			else
				FastOrthos = 0;
			break;
			
		case 51:  
			if (!_fstrcspn (Value," 1TtYy"))
				ShowFileBounds = 1;
			else
				ShowFileBounds = 0;
			break;
			 
		case 52:  
			if (!_fstrcspn (Value," 1TtYy"))
				CursorIsLocked = 1;
			else
				CursorIsLocked = 0;
			break;
			 
		case 53:
			UserPickAP = atof (Value);  
			if (UserPickAP == 0)
				CurPickCursor = hPickNearCursor;
			else if (UserPickAP > 0)
				CurPickCursor = hPickAPCursor;   
			else
				CurPickCursor = hPickAPCursor;
			break;
				
		case 54:
			AddressTextSize = atof (Value);
			break;
				
		case 55:
			StreetTextSize = atof (Value);
			break;

		case 56:  
			if (!_fstrcspn (Value," 1TtYy"))
				WantStreets = 1;
			else
				WantStreets = 0;
			break; 
			
		case 57:  
			OrthoAdjustX = atof (Value);
			break;
			
		case 58:  
			OrthoAdjustY = atof (Value);
			break;
			
		case 59:
			for (i = 6;i;i--)
				if (!_fstricmp (Value,AreaUnitOpts[i-1]))
				{
					OutAreaUnits = i;
					SetGlobalValueLong ("%AREAUNITS",OutAreaUnits);
					break; 
				} 
			
			break;
		case 62: 
			n = _fstrlen (Value);
			if (n)
			for (i = 5;i;i--)
				if (!_fstrnicmp (Value,DistUnitOpts[i-1],n))
				{
					OutDistUnits = i;
					SetGlobalValueLong ("%DISTANCEUNITS",OutDistUnits); 
					break;           
				}
			break;
		case 63:
			MinSpeed = atof (Value);
			break;

		case 64:
			MaxSpeed = atof (Value);
			break;

		case 65:
			if (!_fstrcspn (Value," 0FfNn"))
			{   
				ProcessErrorString ();
				ContinueProcessing = FALSE; 
			}
					    
   			break;
        
		case 78:
			
			Index = min (Index,32);
			n = sscanf (Value,"%Flf %Flf",&UserPoints[Index].x,&UserPoints[Index].y);  
			break;
			
		case 79: /*%BOUNDS*/ 
			switch (Index)
			{
				default:
				case 1:
				case 2:
					sscanf (Value,"%Flf %Flf",&UserBounds[Index-1].x,&UserBounds[Index-1].y);
				break;
				case 0:
					sscanf (Value,"%Flf %Flf %Flf %Flf",&UserBounds[0].x,&UserBounds[0].y,&UserBounds[1].x,&UserBounds[1].y);
				break;
			}
		break;
		case 80: /*%VPBOUNDS*/ 
			switch (Index)
			{   
				default:
				case 0:
					sscanf (Value,"%Flf %Flf %Flf %Flf",&CurView->WBounds.xmn, 
												  		&CurView->WBounds.ymn,
												  		&CurView->WBounds.xmx,
												  		&CurView->WBounds.ymx);  
				break;
				case 1:
					sscanf (Value,"%Flf %Flf",&CurView->WBounds.xmn,&CurView->WBounds.ymn);
				break;
				case 2:
					sscanf (Value,"%Flf %Flf",&CurView->WBounds.xmx,&CurView->WBounds.ymx);
				break; 
			}
		CurView->HaveBounds=TRUE;
		CurView->NewBounds = CurView->WBounds;
		break;
		
		case 81:  
			if (!_fstrcspn (Value," 1TtYy"))
				RedisplayOnly = 1;
			else
				RedisplayOnly = 0;
			break;
			
		case 84:
			BaseUnitsPerOrthoPixel=atof (Value);
			if (!BaseUnitsPerOrthoPixel)
				BaseUnitsPerOrthoPixel=1;
			break;
			
		case 85:
			StretchMode = atoi (Value);
			if (StretchMode < 1 || StretchMode > 3)
				StretchMode = STRETCH_DELETESCANS;
			break;
			
		case 86:
			if (!_fstrcspn (Value," 1TtYy"))
				DoTime = 1;
			else
				DoTime = 0;
			break;   
			
		case 89:
			if (!_fstrcspn (Value," 0FfNn"))
				TrackVideo = FALSE;
			else
				TrackVideo = TRUE;
			break;
        
        case 90:
        	Index = max (0,min(Index,15));
        	_fstrcpy (FontNames[Index],Value); 
        	if (hSizingFont[Index])
        	{
        		DeleteObject (hSizingFont[Index]);
        		hSizingFont[Index]=0; 
        	}
        	break;
        	
		case 91:  
			LayerID = atol (Value);
			break;
			
		case 92:
			ConvertMapVP = -1;
			for (i=0;i<CurView->NumFiles;i++)
			{  
				if (!Expandicmp (Value,CurView->lpFiles[i]))
				{
					ConvertMapFileNo = i;
					ConvertMapVP = CurView->ID;
					break;
				}
			} 
			break;
			
		case 93:
			MaxPointSize = atof (Value);
			break;

		case 94:
			if (!_fstrcspn (Value," 1TtYy"))
				DisplayHLTPattern = TRUE;
			else
				DisplayHLTPattern = FALSE;
			break;
        
		case 95:
			if (!_fstrcspn (Value," 1TtYy"))
				DisplayLinkedCursors = TRUE;
			else
				DisplayLinkedCursors = FALSE;
			break;
		case 96:
			TrackColor=atol (Value);
			break;
        
        case 97:
        	_fstrcpy (ImageExtension,Value);
        	break;
        	
		case 98:
			if (!_fstrcspn (Value," 1TtYy"))
				PickAllPieces = TRUE;
			else
				PickAllPieces = FALSE;
			break;

		case 100:
			InclusionOpt=atol (Value);
			break;
        
		case 101:
			TrackWidth=atol (Value);
			break;

		case 102:
			HighlightWidth = atol (Value);
			break;
		
		case 103:
			AutoClearOffset = atob (Value);
			break;
		
		case 104:
			MaskOffsetLine = atob (Value);
			break;
		
		case 105:  
			GraphicsTextFactor = atof (Value);
			break;
		
		case 110:
			UseItemLen = atob (Value);	
			break;
			
		case 111:
			WantFunNames = atob (Value);	
			break;
			
		case 112:
			ProcessAllElements = atob (Value);	
			break;
		
		case 114:
			ShowInvisiblePointsSymbol = atoi (Value);
			break;	

		case 115:
			MaxTextLayer = atoi (Value);
			break;	

		case 116:
			CurrentAZ = LTWOPI(atof (Value));
			CreateDigCursor (CurView->hDC);
			break;	
        
        case 118:
			if (Index >=1 && Index < 5)
        		TraceType[Index-1]=atob(Value);  
        		
        case 119:
        	WindowColor = atol (Value);
        	break;
            
        case 122:
        	ShowLinkLines = atob (Value);	
        	break;
        case 123:
        	if ((UseRefOrTAGIndex = atob (Value)))
	        	IgnorePrevLayers = FALSE;
	        else 	
	        	IgnorePrevLayers = TRUE;
        	break;
        
        case 124:
        	if (CurTheme)
        	{   
        		Color = atol (Value);
        		if (!Index)
        		{
        			ib=0;
        			ie=MAX_THEME_CLASSES;
        		}
        		else if (Index > 0 && Index <= MAX_THEME_CLASSES)
        		{
        			ib = Index-1;
        			ie = Index;
        		}
        		else
        			break;
        		for (i=ib;i<ie;i++)
        			CurTheme->ClassColor[i] = Color;
        	}
        	break;
        
        case 125:
        {		
			LPCMDSTRING    pCmdStr;   
	
			if (CurView)
			{   
				if (CurView->FunStackHandle)
				{
					pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
					pCmdStr->Prompt = PRMT_USERPROMPT;
					_fstrcpy (pCmdStr->PromptText,Value);
					GlobalUnlock (CurView->FunStackHandle);
					SetPrompt (PRMT_USERPROMPT,FALSE);
				} 
			}
		}
		break;
		
        case 126:
        	PickPerim = atoi (Value);	
        	break;
        
        case 127:
        	CurveChordDist = atof (Value);
        	break;	  
        	
		case 128:
			AutoPan = atob (Value);
			break;
		
		case 129:
			GetSegFromGlobals = atob (Value);
			break;
		case 130:
			if(atob (Value))
				InvertNetDir=-1;
			else
				InvertNetDir=1;
			break;
		
		case 131:  
			GraphicsPointFactor = atof (Value);
			break;
		
		case 132:
			MaskOffsetLine = atob (Value);
			break;
		
		case 133:
			OutlineZoomArea = atob (Value);
			break;
		
		case 134:
			BleedThrough = atob (Value);
			break;
		
		case 135:
			OffsetLineOffset = atof (Value);
			break;
		
		case 136:
			LocationOffset = atof (Value);
			break;
		
		case 138:
			TimeRangeBeg = atol (Value); 
			break;
		
		case 139:
			TimeRangeEnd = atol (Value); 
            break;
        
        case 140:
        	if (*Value == 'T' || *Value == 't')
        		FileProjectionType = 2;
        	else
        		FileProjectionType = 0;
        	break;
        	
        case 142:
        	if (*Value == 'T' || *Value == 't')
        		OpenDisplayedRefs();
        	else
        		CloseDisplayedRefs();
        	break;
        	
        case 143:
       		AlwaysUseSymDict = atob (Value);
        	break;
        case 144:
        	LoadCompiledTran = atob (Value);
        	break;
        	
		case 148:  
			LineSymbolFactor = atof (Value);
			break;

        case 151:
       		GetCopySize = atob (Value);
        	break;
		
        case 152:
       		DisplayFiles = atob (Value);
        	break;   
        case 153:
        	DisplayAllRefs = atob(Value);
        	break;
		case 154:  
			InvisPointFactor = atof (Value);
			break;
		case 155:  
			ShowValSize = atof (Value);
			break;
		case 156: 
			if (_fstrchr(Value,':')) 
				_fstrcpy (NewTAG,Value);
			break;
        case 157:
        	WantOrthoResDisplay = atoi (Value);
        	break;
        case 158:
        	ComputeArea = atob (Value);
        	break;
        case 159:
        	ShowBadSyms = atob (Value);
        	break;
        case 160:
        	PickDeletes = atob (Value);
        	break;
        case 162:
        	StandardSQL = atob (Value);
        	break;
        case 163:
        	MinCacheDriveFreeSpace = atol (Value) * 1024 * 1024;
        	break;
        case 165:
        	ShortestRoute = atob (Value);
        	break;
		case 166:
			SnapPolygons = atob (Value);
			break;
        case 168:
       		AutoType = atob (Value);
        	break;
		case 169:
			ShowRefno = atob (Value);
			break;
		default:
			break;
	}
/*	if (TraceOn)
	{
		char	str[300];
		extern	HWND hWndMain;
		sprintf(str,"%s set to %s",Name,Value);
		//GSSiTrace (str);
		SetWindowText(hWndMain,str);
	} */
	return;
}   
short GetGlobalVal (HANDLE hGlobal,LPSTR OutStr,long Index)
{   VARPNT	VarPnt, VarPnt2;
	int	l; 
	time_t	systime;     
	DPOINT	DPoint;
	
	if (!hGlobal)
	{
		*OutStr = 0;
		return 0;
	}
	VarPnt = (VARPNT)GlobalLock (hGlobal);  
	*OutStr=0;
	switch (VarPnt->Type)
	{   
		default:
		case 99:
		case 92:
		case 0: 
			if (VarPnt->ContainsGorF) 
			{
				HANDLE	hMem = GSSiGlobAlloc (GMEM_MOVEABLE,4096);
				LPSTR	pMem = GlobalLock (hMem);  
				
				_fstrcpy(pMem,VarPnt->Value); 
				ExpandText (pMem);
				l = _fstrlen (pMem);
				_fstrcpy(OutStr,pMem);
				GSSiGlobUlFree (&hMem);
			}
			else
			{
				_fstrcpy(OutStr,VarPnt->Value);
				l = VarPnt->Len; 
			}             
			GlobalUnlock (hGlobal);
			return l;
		case 1:  
			time (&systime);
			ltoa ((long)systime,OutStr,10);
           	break;
		case 2:  
			if (FileProjectionType == 1)
				_fstrcpy (OutStr,"T");
			else
				_fstrcpy (OutStr,"F");
           	break;
		case 3:
			sprintf (OutStr,"%2.2i",CurState);
           	break;
		case 4:  
			if (ShowScale)
				_fstrcpy (OutStr,"T");
			else
				_fstrcpy (OutStr,"F");
           	break;
		case 9:
           	ltoa (InternalRefno,OutStr,10);
           	break;
		case 10:
           	itoa (MaxPick,OutStr,10);
           	break;
		case 15:
           	itoa (CurFont,OutStr,10);
           	break;
		case 17:
           	ltoa (PrintReportID,OutStr,10);
           	break;
		case 18:
           	ltoa (PrintReportPage,OutStr,10);
           	break;
		case 21:
           	itoa (tmtime.tm_year+1900,OutStr,10);
           	break;
		case 22:
           	itoa (tmtime.tm_year,OutStr,10);
           	break;
		case 23:
           	itoa (tmtime.tm_mon+1,OutStr,10);
           	break;
		case 24:
           	itoa (tmtime.tm_yday+1,OutStr,10);
           	break;
		case 25:
           	itoa (tmtime.tm_mday,OutStr,10);
           	break;
		case 26:
           	itoa (tmtime.tm_wday+1,OutStr,10);
           	break;
		case 27:
           	itoa (tmtime.tm_hour,OutStr,10);
           	break;
		case 28:
           	itoa (tmtime.tm_min,OutStr,10);
			GlobalUnlock (hGlobal);
			return (_fstrlen(OutStr)); 
		case 29:
           	itoa (tmtime.tm_sec,OutStr,10);
           	break;
		case 30:
		{
			char CMonth[12][10]={"January","February","March","April","May","June","July","August","September","October","November","December"};  
			if (tmtime.tm_mon < 0 || tmtime.tm_mon > 11)  
				*OutStr=0; 
			else
				_fstrcpy (OutStr,CMonth[tmtime.tm_mon]);
           	break;
		}	
		case 31:
		{
			char CDay[7][10]={"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};  
			if (tmtime.tm_wday < 0 || tmtime.tm_wday > 6)  
				*OutStr=0; 
			else
				_fstrcpy (OutStr,CDay[tmtime.tm_wday]);
           	break;
		}	
		case 32: 
		{
			short	year;
			   
			if (tmtime.tm_year < 100)
				year = tmtime.tm_year;
			else
				year = tmtime.tm_year-100;
           	sprintf (OutStr,"%i/%i/%2.2i",tmtime.tm_mon+1,tmtime.tm_mday,year);
        }
           	break;
		case 33: 
		{
			char	AMPM[4];
			
			if (tmtime.tm_hour < 12)
				_fstrcpy (AMPM,"AM");
			else
				_fstrcpy (AMPM,"PM");
           	sprintf (OutStr,"%i:%i%s",(tmtime.tm_hour+11)%12+1,tmtime.tm_min,AMPM);
		}
           	break;
		case 34: 
           	sprintf (OutStr,"%2.2i:%i",tmtime.tm_hour,tmtime.tm_min);  
           	break;
		case 36: 
           	ltoa ((long)MostPoints,OutStr,10);
           	break; 
           	
		case 37:
			if (SetRefno)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
			break;   
			
		case 40: 
		case 41:
		case 42:
		case 43:
		{
			LPDOUBLE	pRVal;  
			short	i;
			
			i=VarPnt->Type-40;
			pRVal = &CurView->WBounds.xmn;
			pRVal+=i;
			sprintf (OutStr,"%.14lg",*pRVal);
		}
		break;  
		case 47:  
           	itoa (ProcessGCmdStrings,OutStr,10);
           	break;
		case 50:
			if (FastOrthos)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
			break;   
			
		case 53:
			sprintf (OutStr,"%.14lg",UserPickAP);
		break;  
		case 54:
			sprintf (OutStr,"%.14lg",AddressTextSize);
		break;  
		case 55:
			sprintf (OutStr,"%.14lg",StreetTextSize);
		break;  
		case 60:
			sprintf (OutStr,"%.14lg",CurrentPoint.x);
		break;  
		case 61:
			sprintf (OutStr,"%.14lg",CurrentPoint.y);
		break;  
		case 59:
			_fstrcpy (OutStr,AreaUnitOpts[OutAreaUnits-1]);
		break;
		case 62:
			_fstrcpy (OutStr,DistUnitOpts[OutDistUnits-1]);
		break;
		case 63:
			sprintf (OutStr,"%.14lg",MinSpeed);
		break;  
		case 64:
			sprintf (OutStr,"%.14lg",MaxSpeed);
		break; 
		case 65:  
			if (ContinueProcessing)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
		break;
		case 78: /*%POINTS*/ 
			Index = min (Index,32);
			sprintf (OutStr,"%.14lg %.14lg",UserPoints[Index].x,UserPoints[Index].y);
		break;
		case 79: /*%BOUNDS*/ 
			switch (Index)
			{
				default:
				case 1:
				case 2:
					sprintf (OutStr,"%.14lg %.14lg",UserBounds[Index-1].x,UserBounds[Index-1].y);
				break;
				case 0:
					sprintf (OutStr,"%.14lg %.14lg %.14lg %.14lg",UserBounds[0].x,UserBounds[0].y,UserBounds[1].x,UserBounds[1].y);
				break;
			}
		break;
		case 80: /*%VPBOUNDS*/ 
			switch (Index)
			{   
				default:
				case 0:
					sprintf (OutStr,"%.14lg %.14lg %.14lg %.14lg",CurView->WBounds.xmn, 
												  CurView->WBounds.ymn,
												  CurView->WBounds.xmx,
												  CurView->WBounds.ymx);  
				break;
				case 1:
					sprintf (OutStr,"%.14lg %.14lg",CurView->WBounds.xmn,CurView->WBounds.ymn);
				break;
				case 2:
					sprintf (OutStr,"%.14lg %.14lg",CurView->WBounds.xmx,CurView->WBounds.ymx);
				break; 
			} 
		
		break;
		
		case 82:    // ESC
			*OutStr++=0x1B;  
			*OutStr--=0;
		break;
		case 83:   // CR
			*OutStr++=0x0D;  
			*OutStr--=0;
		break; 
		
		case 87:
           	ltoa (MinFileTime,OutStr,10);
           	break;

		case 88:
           	ltoa (MaxFileTime,OutStr,10);
           	break; 
           	
        case 90:
        	Index = max (0,min(Index,15));
        	_fstrcpy (OutStr,FontNames[Index]);
        	break; 
        	
        case 91:
           	itoa (LayerID,OutStr,10);
		    break;  
		    
		case 93:
			sprintf (OutStr,"%.14lg",MaxPointSize); 
		break;
		  
		case 94:  
			if (DisplayHLTPattern)
				_fstrcpy (OutStr,"T");
			else
				_fstrcpy (OutStr,"F");
           	break; 
        
        case 97:
        	_fstrcpy (OutStr,ImageExtension);
        	break; 

		case 98:  
			if (PickAllPieces)
				_fstrcpy (OutStr,"T");
			else
				_fstrcpy (OutStr,"F");
           	break; 
        
		case 100:
           	ltoa (InclusionOpt,OutStr,10);
           	break;
           	 
		case 101:
           	ltoa ((long)TrackWidth,OutStr,10);
           	break; 

		case 102:
           	ltoa ((long)HighlightWidth,OutStr,10);
           	break; 
           	
		case 103:
           	ltoa ((long)AutoClearOffset,OutStr,10);
           	break;  
		case 104:
           	ltoa ((long)MaskOffsetLine,OutStr,10);
           	break; 
		case 105:
			sprintf (OutStr,"%.14lg",GraphicsTextFactor);
			break;  
		case 106:
				    ConvertCoordClose ();
					ConvertCoordInit();
			DPoint = CurrentPoint;
			ConvertCoord (&DPoint,1,3);
			sprintf (OutStr,"%.14lg",DPoint.x);  
			break;
		case 107:
				    ConvertCoordClose ();
					ConvertCoordInit();
			DPoint = CurrentPoint;
			ConvertCoord (&DPoint,1,3);
			sprintf (OutStr,"%.14lg",DPoint.y);
			break;  
		case 108:
				    ConvertCoordClose ();
					ConvertCoordInit();
			DPoint = CurrentPoint;
			ConvertCoord (&DPoint,1,3);
			sprintf (OutStr,"%.14lg %.14lg",DPoint.x,DPoint.y);
			break;  
		case 109:
			DPoint = CurrentPoint;
			sprintf (OutStr,"%.14lg %.14lg",DPoint.x,DPoint.y);
			break;
			
		case 113:
			VarPnt2 = (VARPNT)GlobalLock (hPrefix);
			_fstrcpy (OutStr,VarPnt2->Value);
			_fstrcat (OutStr,":");
			GlobalUnlock (hPrefix);
			VarPnt2 = (VARPNT)GlobalLock (hUDI);
			_fstrcat (OutStr,VarPnt2->Value);
			GlobalUnlock (hUDI);
        	break;
		case 116:
			sprintf (OutStr,"%.14lg",CurrentAZ);
			break;  
		case 117:
			sprintf (OutStr,"%.14lg",(double)PY);
			break;  
        case 120:
        	if (!hMacArgs)
        		break;
			if (Index >=1 && Index <= 10)
			{   
				LPSTR	pArg;
				
				pArg = GlobalLock (hMacArgs);
				pArg += (Index-1) * 4096;
        		_fstrcpy (OutStr,pArg);
        		GlobalUnlock (hMacArgs);
        	}
        	break;  
		case 121:
           	ultoa (LastRecTime,OutStr,10);
           	break; 

        case 125:
        {		
			LPCMDSTRING    pCmdStr;   
	
			if (CurView)
			{   
				if (CurView->FunStackHandle)
				{
					pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
					if (pCmdStr->Prompt == PRMT_USERPROMPT)
						_fstrcpy (OutStr,pCmdStr->PromptText);
					GlobalUnlock (CurView->FunStackHandle);
				}
			}
		}
		break;   
		
		case 127:
			sprintf (OutStr,"%.14lg",CurveChordDist);
		break; 
		
		case 128:  
			if (AutoPan)
				_fstrcpy (OutStr,"T");
			else
				_fstrcpy (OutStr,"F");
           	break; 
        
		case 131:
			sprintf (OutStr,"%.14lg",GraphicsPointFactor);
			break;  

		case 132:
			if (MaskOffsetLine)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
			break;   
			
		case 133:
			if (OutlineZoomArea)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
			break;   
			
		case 134:
			if (BleedThrough)
				*OutStr++ = '1';
			else
				*OutStr++ = '0';
			*OutStr--=0;
			break;   
			
		case 135:
			sprintf (OutStr,"%.14lg",OffsetLineOffset);
		break; 
		
		case 136:
			sprintf (OutStr,"%.14lg",LocationOffset);
		break; 
		
		case 137:
			GetWindowsDirectory (OutStr,144);  
		break; 
			
		case 138:
			ltoa (TimeRangeBeg,OutStr,10);
		break;
			
		case 139:
			ltoa (TimeRangeEnd,OutStr,10);
		break;
			
		case 141:
			itoa (FileNum+1,OutStr,10);
		break;
		
		case 145:
			sprintf (OutStr,"%.14lg %.14lg %.14lg %.14lg",TAGBox.BlowUpBounds.xmn, 
														  TAGBox.BlowUpBounds.ymn,
														  TAGBox.BlowUpBounds.xmx,
														  TAGBox.BlowUpBounds.ymx);  
		    break;
		    
		case 146:
			sprintf (OutStr,"%i %i %i %i",TAGBox.rect.left, 
										  TAGBox.rect.bottom,
										  TAGBox.rect.right,
										  TAGBox.rect.top);  
			break;	
		case 147:
			ltoa (TrackingStatus,OutStr,10);
		break;  
		
		case 148:
			sprintf (OutStr,"%.14lg",LineSymbolFactor);
			break;    
			
		case 149:
			itoa (TextType,OutStr,10);
		break;  

		case 150:
           	ltoa ((long)TotCopySize,OutStr,10);
           	break;  
           	
		case 155:
			sprintf (OutStr,"%.14lg",ShowValSize);
			break; 
			   
		case 161:
           	ltoa (ODBCRecNum,OutStr,10);
           	break; 
           	
        case 164:
           	itoa (PolyInfoTheme,OutStr,10);
           	break;
		case 165:
			itoa (ShortestRoute,OutStr,10);
		break;  
		case 167:
			sprintf (OutStr,"%.14lg %.14lg",TXLoc.x,TXLoc.y);
		break;  
   	 
			
	}
	GlobalUnlock (hGlobal);
	return (_fstrlen(OutStr)); 
}

short Expandicmp (LPSTR String1, LPSTR String2)
{
	HANDLE	h1=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
	HANDLE	h2=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
	LPSTR	pString1=GlobalLock (h1);
	LPSTR	pString2=GlobalLock (h2); 
	short	rtn;
	
	_fstrcpy (pString1,String1);
	ExpandText (pString1); 
	_fstrcpy (pString2,String2);
	ExpandText (pString2); 
	rtn = _fstricmp (pString1,pString2);
	GlobalUnlock (h1);
	GlobalFree (h1);
	GlobalUnlock (h2);
	GlobalFree (h2);
	return rtn;
}

void SetGlobalValueReal (LPSTR Name, double val)
{   char	txt[32];  

	sprintf (txt,"%.14lg",val);
	SetGlobalValue (Name,txt);
	return;
} 

void SetGlobalValueDPoint (LPSTR Name, DPOINT Point)
{   char	txt[64];  

	sprintf (txt,"%.14lg %.14lg",Point.x,Point.y);
	SetGlobalValue (Name,txt);
	return;
} 

void SetGlobalValueLong (LPSTR Name, long val)
{   char	txt[16]; 

	ltoa (val,txt,10);
	SetGlobalValue (Name,txt);
	return;
}

void SetGlobalValueBool (LPSTR Name, BOOL val)
{   char	txt[32]; 
    
    if (val)
		SetGlobalValue (Name,"T");  
	else
		SetGlobalValue (Name,"F");  
	return;
}

void SetGlobalValueRect (LPSTR Name, RECT Rect)
{   char	txt[32]; 

	recttoa (txt,Rect);
	SetGlobalValue (Name,txt);
	return;
}

void SetGlobalValueLen (LPSTR Name, LPSTR Value, short len)
{   
	VARPNT	VP;
	LPSTR	EndChar;
	HANDLE	handle;
	
	handle = AllocateVar (Name);  
	VP = (VARPNT)GlobalLock (handle);
	if (VP->ValueIsHandle)
	{
		HANDLE handle = atol (VP->Value);
		GSSiGlobFree (&handle); 
		VP->ValueIsHandle = 0;
	}
	_fstrncpy (VP->Value,Value,len);
	EndChar = VP->Value + len;
	*EndChar = 0;
	VP->Len = _fstrlen (VP->Value);
	VP->changetime = NextVarTime();
	SetLinkedVarTime (VP); 
	GlobalUnlock (handle);
	return;
}     

BOOL SetGlobalFromCheckBox (HWND hWndDlg,UINT Control,LPSTR VarName)
{   
	BOOL	rtn;
	
	rtn = SendDlgItemMessage (hWndDlg,Control,BM_GETCHECK,0,0);
	SetGlobalValueBool (VarName,rtn);
	return rtn;
} 

short ProcessDelimTextHeader(LPSTR INstr,LPHANDLE phDLT)
{
	LPSTR	BeginLoc, EndLoc, EqLoc, DashLoc; 
	char	EndChar; 
	BOOL	Done=FALSE;
	LPSHORT	nDLTvar;
	LPHANDLE	DLTVar; 
	LPSHORT	DLTStart,DLTLen; 
	short	lHead=_fstrlen (INstr); 
	HANDLE	hHead = GSSiGlobAlloc (GMEM_MOVEABLE,lHead+1);
	LPSTR	str = GlobalLock (hHead);
	                                 
	_fstrcpy (str,INstr);
	nDLTvar = 0; 
	*phDLT = GSSiGlobAlloc (GHND,2 + MAXDLTVAR * (2*sizeof(short)+sizeof(HANDLE)));
	nDLTvar = (LPSHORT)GlobalLock (*phDLT);
	DLTVar = (LPHANDLE)(nDLTvar + 1);
	DLTStart = (LPSHORT)(DLTVar + MAXDLTVAR);
	DLTLen = (LPSHORT)(DLTStart + MAXDLTVAR);
	
Next:if (*str == '"')
	{
		str++;
		EndChar = '"';
	}
	else
		EndChar = ',';
	BeginLoc = str;
	EndLoc = _fstrchr(str,EndChar); 
	if (!EndLoc)
	{
		Done=TRUE;
		EndLoc = _fstrchr (str,0); 
	}
	*EndLoc = '\0';
	EqLoc = _fstrchr(str,'=');
	if (EqLoc)
	{
		*EqLoc = '\0';
		EqLoc++; 
		DashLoc = _fstrchr(EqLoc,'-');
		if (!DashLoc)
			goto Exit;
		*DashLoc = '\0';
		DashLoc++;
		DLTStart[*nDLTvar] = atoi (EqLoc)-1;
		DLTLen[*nDLTvar] = atoi (DashLoc)-DLTStart[*nDLTvar];
		if (DLTStart[*nDLTvar]<0 || DLTLen[*nDLTvar]<0) 
			goto Exit;
	}
	else
		DLTStart[*nDLTvar]=-1;	
	DLTVar[(*nDLTvar)++] = AllocateVar(BeginLoc);  
	if (Done)
	{   
		short	n=*nDLTvar;
		
		GlobalUnlock (*phDLT); 
		GSSiGlobUlFree (&hHead);
		return(n);
	}
	str = ++EndLoc;
	if (!*str)
	{   
		short	n=*nDLTvar;
		
		GlobalUnlock (*phDLT);
		GSSiGlobUlFree (&hHead);
		return(n);
	}
	if (*str == ',') 
		str++;
	goto Next; 
Exit:
	GSSiGlobUlFree (phDLT);
	GSSiGlobUlFree (&hHead);
	return 0;	
}  

