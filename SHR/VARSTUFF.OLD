BOOL GetNextHLTListItem (BOOL First)
{ 
    long	Sequence, Ref;
	HIGHLIGHTDATA	HighlightData;
	
	if (First)
		HltFetchPos = BT_FIRST;
	if (BT_FIND (hHighlight2,(LPSTR)&Sequence,HltFetchPos,BT_ANY,(LPSTR)&Ref))
		return FALSE;
	HltFetchPos = BT_NEXT; 
   	BT_FIND (hHighlight,(LPSTR)&Ref,BT_FIRST,BT_EQ,(LPSTR)&HighlightData);  
	PickList[0]=HighlightData.PD;
	ProcessPickedItem (0,FALSE);        		
	return TRUE;
}  

LPVIEWPORT SetVPFromName (LPSTR Arg2,LPSHORT pErr)
{   
	short	iview;
	
	*pErr = FALSE;
	if (!*Arg2)
		return CurView;  
	if (!_fstricmp (Arg2,"COMMAND"))
	{
		SetViewport(CommandViewport);
		return CurView;
	}
	for (iview=0;iview<NumViewports;iview++)
	{   
		if (!_fstricmp (Arg2,pViewports[iview]->Name))
    		return pViewports[iview];
	}
	*pErr = TRUE;
	return CurView;
} 

BOOL ProcessMacroFile (LPSTR Name,LPSTR RtnVal,LPHANDLE phArgs)
{   
	HANDLE	hSTR=GSSiGlobAlloc (GMEM_MOVEABLE,4096+256+sizeof(OFSTRUCT));
	LPSTR	str = GlobalLock (hSTR);
    LPSTR	RtnValue=&str[4096];   
   	LPOFSTRUCT	pOFStruct=(LPOFSTRUCT)(RtnValue+256);
	HANDLE	hMacro = 0;
	LPSTR	pMacro;
	double	Off; 
	long	Offset, lMacro=0;
	BOOL	rtn=FALSE, AtEnd=FALSE;
    extern	HANDLE	hPIDAddDB,hPIDPid;  
    FIELDINFO Field; 
    int		status;     
    LPSTR	SaveRtnPointer, pEndCmd;
   	LPSTR	pStr; 
   	long	ThisMacro;
    
   ThisMacro = ++CurrentMacro;
   if (RtnVal)
    	*RtnVal = 0;
    if (*Name)
    {                                               
    	HFILE		Fid;
    	
		hMacro = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
    	pMacro = GlobalLock (hMacro);
    	*pMacro = 0;
	    if (!_fstricmp (Name,"INLINE"))
	    {
	    	if (phArgs)
	    	{   
	    		HANDLE hNewArgs;
	    		LPSTR	pNewArgs;
	    		long	l=GlobalSize (*phArgs);
	    		
	    		pStr = GlobalLock (*phArgs);
	    		_fstrcpy (pMacro,pStr);
	    		pStr += 4096; 
	    		l -= 4096;
	    		hNewArgs=GSSiGlobAlloc(GMEM_MOVEABLE,l);
				pNewArgs = GlobalLock (hNewArgs);
                _fmemmove (pNewArgs,pStr,(size_t)l);
	    		GSSiGlobUlFree (phArgs);
	    		GlobalUnlock (hNewArgs);
	    		*phArgs = hNewArgs;
	    	}
	    }
    	else
    	{
	    	Fid = GSSiOpenFile (Name,pOFStruct,OF_READ);
	    	if (Fid == HFILE_ERROR)
	    		goto Exit;
	    	while (fgetstring (str,4090,Fid))
	    		if (*str != '#')
	    		{   
	    			Truncate (str);
	    			pStr = FirstNonBlank(str);
	    			lMacro += _fstrlen (pStr);   
	    			if (lMacro > UINT_MAX)
	    			{
	    				GSSiClose (Fid);  
	    				GSSiMessageBox (Name,"Macro file exceeds maximum length",MB_ICONEXCLAMATION);
	    				goto Exit;
	    			}
	    			_fstrcat (pMacro,pStr);   
	    		}
	    	GSSiClose (Fid); 
	    }
    	SaveRtnPointer = pMacroReturnValue;
    	pMacroReturnValue = RtnValue;
    	*pMacroReturnValue = 0;
    	while (*pMacro)
    	{   
    		HANDLE	hCmd;
    		LPSTR	pCmd;
    		
    		pEndCmd = MatchLev (pMacro,';');
    		if (!pEndCmd)
    		{
    			AtEnd = TRUE;
    			pEndCmd = _fstrchr (pMacro,0);
    		}
    		else
    			*pEndCmd = 0;
    		hCmd = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
    		pCmd = GlobalLock (hCmd);
    		_fstrcpy (pCmd,pMacro); 
    		pMacro = pEndCmd;
    		if (!AtEnd)
    			pMacro++;
    		AtEnd = FALSE;
    		if (phArgs)
    			hMacArgs = *phArgs;
    		else
    			hMacArgs = 0;
	    	ExpandText (pCmd);
    		hMacArgs = 0;
	    	GSSiGlobUlFree (&hCmd); 
	    	if (!ContinueProcessing)
	    	{
	    		if (pMacroReturnValue)
	    		{  
	    			if (RtnVal)       
	    				_fstrcpy (RtnVal,pMacroReturnValue);
	    			ContinueProcessing = TRUE;
	    		}
	    		*pMacro = 0;
	    	}
	    }
    	pMacroReturnValue = SaveRtnPointer;
		DoPaint = TRUE;
    }
	rtn = TRUE;
Exit:
    GSSiGlobUlFree (&hSTR);
    GSSiGlobUlFree (&hMacro);  
    CloseMacroFiles (ThisMacro);
    return rtn;
} 

int	GetFunctionID (LPSTR str, LPSTR ParenLoc)
{	
	int		l; 
	 
	str++;
	l = ParenLoc - str; 
	switch (l)
	{
		case 1: 
			return GetFunctionID1 (str);
		case 2: 
			return GetFunctionID2 (str);
		case 3: 
			return GetFunctionID3 (str);
		case 4: 
			return GetFunctionID4 (str);
		case 5: 
			return GetFunctionID5 (str);
		case 6: 
			return GetFunctionID6 (str);
		case 7: 
			return GetFunctionID7 (str);
		case 8: 
			return GetFunctionID8 (str);
		case 9: 
			return GetFunctionID9 (str);
		case 10: 
			return GetFunctionID10 (str);
		case 11: 
			return GetFunctionID11 (str);
		case 12: 
			return GetFunctionID12 (str);
		case 13: 
			return GetFunctionID13 (str);
		case 14: 
			return GetFunctionID14 (str);
		case 15: 
			return GetFunctionID15 (str);
		case 16: 
			return GetFunctionID16 (str);
		case 18: 
			return GetFunctionID18 (str);
		default:
			return 0;
	}
}



           

