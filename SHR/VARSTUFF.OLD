BOOL OpenGSStreetNames (int mode, int which)
{   
	char	str[128]="[STATE]\\";
	if (hNames2)
		return TRUE;
	if (CurState >= 0)
	{   
		ExpandText (str);
		SetGlobalValue("%GEOSPAN_LOC",str);
		if (which >= 2)
		{
			hNames2 = BT_OPEN ("[STATE]\\stname2.btr", 0, mode, 0);
			if (!hNames2 && mode == BT_WRITE) 
			{
				CreateStnameFilesUpdate ();
				hNames2 = BT_OPEN ("[STATE]\\stname2.btr", 0, mode, 0);
		    }
		}
		if (which%2)
			hNames1 = BT_OPEN ("[STATE]\\stname1.btr", 0, mode, 0);
		return TRUE; 
	}
	else
	{
		hNames2 = BT_OPEN ("stname2.btr", 0, mode, 0);
		if (!hNames2) 
		{
			CreateStnameFilesUpdate ();
			hNames2 = BT_OPEN ("stname2.btr", 0, mode, 0);
	    }
		hNames1 = BT_OPEN ("stname1.btr", 0, mode, 0);
		return TRUE; 
	}
} 

void CloseGSStreetNames(void)
{
	BT_CLOSE (hNames1); 
	BT_CLOSE (hNames2);
	hNames1 = 0;
	hNames2 = 0;  
	HaveState = -1;
	return;
} 

long GetCmdID (LPSTR lpCmdID)
{
	HFILE	Fid; 
	char	str[132];
	long	ID;
	LPSTR	lpSpace, lpParen; 
	OFSTRUCT	OFStruct;
	char CmdFName[64]="[%INDIR]cmdid";
	
	if (!lpCmdID)
	{
		return 0;
	} 
	Truncate (lpCmdID);
	if (*lpCmdID == '"')
	{   
		LPLONG	pNumCmd, pCmdOffset;  
		LPSTR	pCmd, pEndQuote;
		long	NewOff;   
		int		l;
		
		pEndQuote = lpCmdID;
		pEndQuote++;
		pEndQuote = MatchLev (pEndQuote,'"');
		if (!pEndQuote)
			return 0;
		*pEndQuote = 0;
		pNumCmd = (LPLONG)GlobalLock (*phWhichCmdList);
		(*pNumCmd)++;
		pCmdOffset = pNumCmd;
		pCmdOffset += *pNumCmd;
		if (*pNumCmd == 1)
		{
			*pCmdOffset = 1024*4 + 4;
		}
		else
		{	
			pCmdOffset--;
			pCmd = pCmd;	
			pCmd = (LPSTR)pNumCmd;
			pCmd+=*pCmdOffset;
			l = _fstrlen (pCmd);
			NewOff = *pCmdOffset + l + 1;
			pCmdOffset++;
			*pCmdOffset = NewOff;
		}
		pCmd = (LPSTR)pNumCmd;
		pCmd+=*pCmdOffset;
		_fstrcpy (pCmd,++lpCmdID); 
		REPLAC (pCmd,"[%ARG]",IncludeFileArg,_fstrlen(pCmd)+_fstrlen(IncludeFileArg));
		GlobalUnlock (*phWhichCmdList);
		if (phWhichCmdList == &hUserCmd)
			return (58000+*pNumCmd);
		else			
			return (59500+*pNumCmd);
	} 
		
	lpParen = _fstrchr (lpCmdID,'(');
	if (lpParen)
		*lpParen = 0;    
	ID = ConvertCMDToNum (lpCmdID);
	if (lpParen)
		*lpParen = '(';
	return ID;
}

BOOL ExecuteUserCmd (int CmdID)
{ 
	LPLONG	pNumCmd, pCmdOffset;  
	LPSTR	pCmd, pEndQuote, pCommand;
	long	NewOff, l;
	HANDLE	handle;   
	BOOL	rtn=TRUE;
	
	if (!*phWhichCmdList)
		return FALSE;	
	pNumCmd = (LPLONG)GlobalLock (*phWhichCmdList);    
	if (!pNumCmd)
		return FALSE;  
	if (CmdID < 0 || CmdID > *pNumCmd)
		return FALSE;
	pCmdOffset = pNumCmd;
	pCmdOffset += CmdID;
	pCmd = (LPSTR)pNumCmd;
	pCmd+=*pCmdOffset;
	l = _fstrlen (pCmd);    
	if (!l)
	{
		GlobalUnlock (*phWhichCmdList);
		return FALSE;
	}
	handle = GSSiGlobAlloc (GMEM_MOVEABLE,l+10);
	pCommand = GlobalLock (handle); 
	_fstrcpy (pCommand,pCmd);
	GlobalUnlock (*phWhichCmdList);    
	
	if (*pCommand == '|')
		rtn = ExecuteCommandString (++pCommand);
	else
		AddGraphicsCmd (CurView->hWnd,pCommand,FALSE,0); 		
	GlobalUnlock (handle);
	GlobalFree (handle);   
	return rtn;
}
	
BOOL ExecuteCommandString (LPSTR pCmd)
{
	BOOL	MoreCommands; 
	LPSTR	EndCommand, pCommand;
	long	lc;  
	HANDLE	hCmd; 
	LPVIEWPORT	SaveVP =  CurView;
	           
	lc = _fstrlen (pCmd);
	if (!lc)
		return TRUE;
	hCmd = GSSiGlobAlloc (GMEM_MOVEABLE,lc+1);
	pCommand = GlobalLock (hCmd);  
	_fstrcpy (pCommand,pCmd);
//	CurView = pViewports[CommandViewport-1]; //tempdebu
   	SetViewport(CommandViewport);
	
	MoreCommands =  TRUE;
	while (MoreCommands)
	{
		EndCommand = MatchLev (pCommand,';');
		if (!EndCommand)
		{
			MoreCommands = FALSE;
			EndCommand = _fstrchr (pCommand,0);
		} 
		*EndCommand = 0;
		DoUserCommand (pCommand);
		pCommand = EndCommand;
		pCommand++;
	} 
	GSSiGlobUlFree (&hCmd);
	if (ConfigLoaded)
		CurView = SaveVP;
	return TRUE;
} 

BOOL DoUserCommand (LPSTR Cmd)
{   
	UINT	CmdID;
	long	lCmdID; 
	HANDLE	hStr=GSSiGlobAlloc (GMEM_MOVEABLE,256);
	LPSTR	cmd=GlobalLock (hStr);
	
	lCmdID = GetCmdID (Cmd);
	if (lCmdID < 0)
	{   
		CmdID = -lCmdID; 
		AddGraphicsFunction (CurView->hWnd, CmdID,0);
	}	
    else if (lCmdID)
    {
    	CmdID = lCmdID; 
		PostMessage(hWndMain, WM_COMMAND, CmdID, CurView->ID);
	}
    else  
    {
    	_fstrcpy (cmd,Cmd);
		ExpandText (cmd);
	}
	GSSiGlobUlFree (&hStr);
	return TRUE;
} 

double GetViewportScale (HDC hDC)
{                
	double scale, WDist, IDist, BaseScale;
	int	iLogPixsX;   
	DPOINT	p1,p2; 
	long	OrthRes[4]={1,4,16,16};   
	short	ires; 
	char	str[32];
	LPSTR	lpComma;

	OrthScale=0;	
	if (!hDC)
		return 0;
	iLogPixsX = GetDeviceCaps(hDC, LOGPIXELSX);
	if (!iLogPixsX)
		return 0;   
	IDist = (double)(CurView->DrawRect.right - CurView->DrawRect.left)/(double)iLogPixsX;
    if (!IDist)  
    	return 0;
	if (!PRJ_TYPE[1])
	{   
		p1.x = CurView->WBounds.xmn;
		p2.x = CurView->WBounds.xmx;
		p1.y = (CurView->WBounds.ymn + CurView->WBounds.ymx) / 2;
		p2.y = p1.y;
		WDist = ArcDistance(p1, p2);
	}
	else
		WDist = CurView->WBounds.xmx - CurView->WBounds.xmn;
    
	scale = WDist/IDist; 
	if (PRJ_TYPE[1] != 2)
		scale *= MFT; 
	scale /= 5280.0; 
    
    if (CurView->DesiredWidth) 
    	BaseScale = WDist/(CurView->DesiredWidth * (1.0-2*(CurView->Margin+max(0,CurView->BorderPct))/100));
    else
    	BaseScale = 0;
    SetGlobalValueReal ("%BASESCALE",BaseScale);
    _fstrcpy (str,"[%ORTHOLEVS]");
    ExpandText (str);
    if (*str)
    {   
    	OrthRes[1]=OrthRes[2]=OrthRes[3]=999999999;
    	OrthRes[0] = atol (str);
    	if (!(lpComma = _fstrchr (str,',')))   
    		goto GetScale;
    	lpComma++;
    	OrthRes[1] = atol (lpComma);
    	if (!(lpComma = _fstrchr (lpComma,',')))   
    		goto GetScale;
    	lpComma++;
    	OrthRes[2] = atol (lpComma);
    	if (!(lpComma = _fstrchr (lpComma,',')))   
    		goto GetScale;
    	lpComma++;
    	OrthRes[3] = atol (lpComma);
    }    
GetScale:
    IDist = (double)(CurView->DrawRect.right - CurView->DrawRect.left);
    if (IDist)
		OrthScale = (WDist/BaseUnitsPerOrthoPixel)/IDist;
	ires = 0;
	if (OrthScale >= OrthRes[1])
		ires = 1;
	if (OrthScale >= OrthRes[2])
		ires = 2;
	if (OrthScale >= OrthRes[3])
		ires = 3;
	ires = min (MaxOrthoRes,max (ires,GetGlobalLVal ("[%MINORTHORES]")));
	SetGlobalValueLong ("%ORTHORES",OrthRes[ires]);
	
	return scale;
}

long ConvertPoint (LPSTR CvtFile,LPDPOINT Point,short Direction)
{
	 char	SaveProj[32], project[32];
	 LPSTR	lpDot, lpEnd;
	 short	SaveUnits;
	 long	rtn=0;
		 		 
	 SaveUnits = PRJ_UNITS[3];
	 _fstrcpy (SaveProj,"[%ALT_PROJECTION]");
	 ExpandText (SaveProj);   
	 _fstrcpy (project,CvtFile);
     if ((lpDot=_fstrrchr(project,'.')))
        *lpDot = 0;
     SetGlobalValue("%ALT_PROJECTION",project);
     ConvertCoordClose ();
	 if ((rtn=ConvertCoordInit()))
	 	goto Exit;
/*     if (*str)
     { 
         if (!_fstrcmp(str,"Feet"))
            PRJ_UNITS[3] = 1;
         else if (!_fstrcmp(str,"Meters"))
            PRJ_UNITS[3] = 2; 
     } */ 
     if (Direction==1)
	 	rtn=ConvertCoord (Point,3,1);  
	 else
	 	rtn=ConvertCoord (Point,1,3); 
Exit: 
     PRJ_UNITS[3] = SaveUnits;
	 SetGlobalValue ("%ALT_PROJECTION",SaveProj);
     ConvertCoordClose ();
     return rtn;
}
BOOL LoadInternalGMD (LPGWDHEADER lpGWDHead,long iref)
{   
	short	ii, Type;
	char	SymName[34];
	struct {
			long	refno;
			char	prefix[8], udi[64], hastext, Type, SymName[32];
			short	symnum, Layer;
			double	Length, Area, Perimeter, AZM, Elev;
			long	MinTime, MaxTime;
			double	BPX, BPY, MPX, MPY, EPX, EPY;
			char	text[256];
			char	FileName[256];
			char	Globals[256];
			long	NumPoints; } Type1;
	struct {
			long	refno;  
			char	prefix[8], udi[64];
			short	symnum, Type,Layer;  
			/*DPOINT	BeginPoint, EndPoint, PickedPoint;
			double	PCT, Length, OffDist;*/
		   } Type2;
	
	switch (lpGWDHead->Version)
	{
		case 1001: 
		case 1002:

		if (InGraphicsProcessor)
			ii=1;
		else
			if (!SetPickGlobalsCalled)
				break;	
       
       SetPickGlobalsCalled = FALSE;
		_fmemset (&Type1,0,sizeof(Type1));
		  
		Type1.refno = iref;
		_fstrncpy (Type1.prefix,CurrentTAG,8); 
		_fstrncpy (Type1.udi,CurrentUDI,64);
		Type1.Layer = FileNum;
		if (InGraphicsProcessor)
			ScanItemForDBVals ();
		GetGlobalVal (hTEXT,Type1.text,0);    
		if (*Type1.text)
			Type1.hastext = 'Y';
		else
			Type1.hastext = 'N';  
		if (CurrentType == GF_TEXT)
			Type = CurrentTextBaseType;
		else
			Type = CurrentType;
		switch (Type)
		{
			case GF_POINT:
				Type1.Type = 'P';  
				Type1.AZM = CurPointAZ; 
				Type1.BPX = Type1.MPX = Type1.EPX = CurPointLocD.x;
				Type1.BPY = Type1.MPY = Type1.EPY = CurPointLocD.y; 
				Type1.NumPoints = 1;
				break;
			case GF_LINE:
			case GF_POLYLINE:
			{   
				HPPOINT	lpEndPoint;  
				HPDPOINT	lpDEndPoint;
				double	Dist;
				
				Type1.Type = 'L'; 
				Type1.MPX = 0;
				Type1.MPX = 0;
GetPolylineEP:
				if (InGraphicsProcessor)
				{    
					Type1.NumPoints = nCurPoints;  
					Type1.Layer = FileNum;
					if (HiPrecis)
					{   
						HPDPOINT	lpPoints=lpDCurPoints;
						long		nPnts=nCurPoints;
						
						if (hDynamicSeg)
						{
							lpPoints=(HPDPOINT)GlobalLock (hDynamicSeg);
							nPnts = nDynamicCoord;
						}
						lpDEndPoint = lpPoints + (nPnts-1); 
						Type1.BPX = lpPoints->x;
						Type1.BPY = lpPoints->y;  
						Type1.EPX = lpDEndPoint->x;
						Type1.EPY = lpDEndPoint->y;
						Type1.AZM = getazd (lpPoints,lpDEndPoint);  
						if (CurrentType == GF_CURVE)
						{   
							DPOINT	BP,RP; 
							short	rc; 
							double	Radius;
								
							Type1.MPX = lpPoints[1].x;
							Type1.MPX = lpPoints[1].y;
							rc = RCURVE(&Type1.BPX,&Type1.BPY,&Type1.MPX,&Type1.MPY,&Type1.EPX,&Type1.EPY,
										&RP.x,&RP.y,&Dist); 
							BP.x = Type1.BPX;
							BP.y = Type1.BPY;
							Radius = ldistp (BP,RP);
							Type1.Length = Dist; 
							SetGlobalValueReal ("%RADIUS",Radius);
						}
						else if (ComputeArea)
							ComputeProjectedAreaAreaD (lpPoints,-nPnts,&Dist); 
						if (hDynamicSeg)
							GlobalUnlock (hDynamicSeg); 
						CurLength = Dist;
					}
					else
					{   
						DPOINT	BPointW, EPointW;
						
						CurStartPoint = *lpCurPoints;
						lpEndPoint = lpCurPoints + (nCurPoints-1);   
						BPointW = FilePtToBasePt (CurStartPoint);
						EPointW = FilePtToBasePt (*lpEndPoint);
						Type1.BPX = BPointW.x;
						Type1.BPY = BPointW.y;  
						Type1.EPX = EPointW.x;
						Type1.EPY = EPointW.y;
						Type1.AZM = getaz (*lpCurPoints,*lpEndPoint);  
						if (ComputeArea)
						{
							ComputeProjectedAreaArea (lpCurPoints,-nCurPoints,&Dist);  
							CurLength = Dist;
							Type1.Length = ConvertDist(Dist,OutDistUnits);
						}
					}
				}  
				else if (CurrentProcessedPickedItem >=0) 
				{   
					CurLength = PickList[CurrentProcessedPickedItem].Length;
					Type1.Length = ConvertDist(PickList[CurrentProcessedPickedItem].Length,OutDistUnits); 
				}
			}
				break;
			case GF_CURVE:		 
				Type1.Type = 'C'; 
				Type1.NumPoints = 3;  
				goto GetPolylineEP;
				break;
			case GF_AREA:
			{
				double	Dist, Area;
							  
				Type1.Type = 'A';  
				if (InGraphicsProcessor)
				{   
					Type1.NumPoints = nCurPoints;
					if (ComputeArea)
					{
						if (HiPrecis)
							Area = ComputeProjectedAreaAreaD (lpDCurPoints,nCurPoints,&Dist);
						else  
							Area = ComputeProjectedAreaArea (lpCurPoints,nCurPoints,&Dist); 
						CurLength = Dist;
						CurArea = Area; 
						Type1.Area = ConvertArea (Area,OutAreaUnits); 
						Type1.Perimeter = ConvertDist(Dist,OutDistUnits);
					}
				}
				else if (CurrentProcessedPickedItem >=0) 
				{   
					CurLength = PickList[CurrentProcessedPickedItem].Length;
					CurArea = PickList[CurrentProcessedPickedItem].Area;
					Type1.Area = ConvertArea (PickList[CurrentProcessedPickedItem].Area,OutAreaUnits); 
					Type1.Perimeter = ConvertDist(PickList[CurrentProcessedPickedItem].Length,OutDistUnits); 
				}
			}
				break;
			case GF_TEXT:			 
				Type1.Type = 'T';
				Type1.AZM = TXRot;
				break;
		}
		Type1.Elev = (double)iref/10;
		Type1.MinTime = GRStartTime;
		Type1.MaxTime = GREndTime; 
		_fstrcpy (Type1.Globals,"[%GLOBALS]");
		ExpandText (Type1.Globals);
		Type1.symnum = CurrentDesc;
		if (InGraphicsProcessor)  
		{
			if (!GetOpenFileSymName (CurrentDesc,SymName))
				GetDictSymName (CurrentDesc,SymName);
			_fstrcpy (Type1.FileName,PltName);
			ExpandText (Type1.FileName);   
		}
		else
		{   
			double	Radius;
			
			Type1.BPX = CurBP.x;
			Type1.BPY = CurBP.y;
			Type1.MPX = 0;
			Type1.MPX = 0;
			Type1.EPX = CurEP.x;
			Type1.EPY = CurEP.y;
			GetSymbolName (CurrentDesc,SymName,NULL,0,NULL);
			_fstrcpy (Type1.FileName,PickName);
			ExpandText (Type1.FileName);   
			if (CurrentType == GF_CURVE)
			{   
				DPOINT	BP,RP; 
				short	rc; 
				double	CLEN;
								
				Type1.MPX = CurMP.x;
				Type1.MPY = CurMP.y;
				rc = RCURVE(&Type1.BPX,&Type1.BPY,&Type1.MPX,&Type1.MPY,&Type1.EPX,&Type1.EPY,
							&RP.x,&RP.y,&CLEN); 
				BP.x = Type1.BPX;
				BP.y = Type1.BPY;
				Type1.Length = CLEN; 
				CurLength = CLEN;
				Radius = ldistp (BP,RP);
			} 
			else
				Radius = 0;
				SetGlobalValueReal ("%RADIUS",Radius);
		}
		_fstrncpy (Type1.SymName,SymName,32);
		_fmemmove (&lpGWDHead->GWDData,&Type1,sizeof(Type1)); 
		break;
	
		case 2001:
		_fmemset (&Type2,0,sizeof(Type2));
		Type2.refno = iref; 
		_fstrncpy (Type2.prefix,CurrentTAG,8); 
		_fstrncpy (Type2.udi,CurrentUDI,64);     
		Type2.symnum = CurrentDesc;
		if (CurrentType == GF_TEXT)
			Type = CurrentTextBaseType;
		else
			Type = CurrentType; 
		Type2.Type = Type;  
		Type2.Layer = FileNum;
/*		Type2.BeginPoint = PickList[NumPicked-1].BeginPoint;
		Type2.EndPoint = PickList[NumPicked-1].EndPoint;
		Type2.PickedPoint = PickList[NumPicked-1].PickedPoint;
		Type2.PCT = PickList[NumPicked-1].PCT;
		Type2.Length = PickList[NumPicked-1].Length;
		Type2.OffDist = PickList[NumPicked-1].OffDist;*/
		_fmemmove (&lpGWDHead->GWDData,&Type2,sizeof(Type2)); 
		break;	
	}
	return TRUE;	
}

BOOL GetCurVal (LPSTR Val,short maxval, UINT StringID)
{   
	char	str[128]="[";
	
	*Val=0;
	if (!StringID)
		return FALSE; 
	if (!LoadString(hInst, StringID, &str[1], 127))
		return FALSE;
	_fstrcat (str,"]");	
	ExpandText (str); 
	_fstrcpy (Val,str);
	if (*Val)
		return TRUE;
	else
		return FALSE;
} 

void SetCurVal (LPSTR Val,UINT StringID)
{   
	char	str[128];
	
	if (!StringID)
		return;
	if (!LoadString(hInst, StringID, str, 128))
		return;
	SetGlobalValue (str,Val);
	return;
}
void SaveGlobalVals (HFILE Fid)
{
	unsigned short	i=NumVars; 
	LPSTR	pstr;
	VARPNT	VarPtr;
    HANDLE	hMem=GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
    LPSTR	pMem = GlobalLock (hMem);
    long	lMem=0; 
    short	nVars=0,l;
 	short	Length, Version=1, id=OB_SAVEGLOBALS; 
 	HANDLE	hStr=GSSiGlobAlloc (GMEM_MOVEABLE,256);
 	LPSTR	str=GlobalLock (hStr);   

 	_lwrite (Fid,&id,2);  
 	_lwrite (Fid,&Version,2);
 	_lwrite (Fid,&Version,2);
	while (i--)
	{   
		VarPtr = (VARPNT)GlobalLock (VarHandles[i]);
		if (VarPtr)
		{
			if (VarPtr->Save)
			{
				nVars++;
				_fstrcpy (pMem,VarPtr->Name);
				l = _fstrlen (VarPtr->Name);
				pMem += (l+1);
				lMem += (l+2);  
				*pMem = VarPtr->ContainsGorF;
				pMem++;
				_fstrcpy (str,VarPtr->Value);  
				SubstituteDL (str);
				pstr = str;
				if (*str == '@')
					pstr++;
				_fstrcpy (pMem,pstr);  
				l = _fstrlen (pMem);
				pMem += (l+1);
				lMem += (l+1);
			}	
			GlobalUnlock (VarHandles[i]);
		}
	} 
	_lwrite (Fid,&nVars,2);
	_lwrite (Fid,&lMem,4);
	GlobalUnlock (hMem);
	pMem = GlobalLock (hMem);
	_lwrite (Fid,pMem,(size_t)lMem); 
	GSSiGlobUlFree (&hMem);
	GSSiGlobUlFree (&hStr);
	return;
} 

void ExpandGlobalRaw (LPSTR Name,LPSTR Value, short maxlen)
{
	VARPNT	VP;
	HANDLE	handle; 
	
	if ((handle = FindVar (Name)))
	{
		VP = (VARPNT)GlobalLock (handle); 
		_fstrcpy (Value,VP->Value);
		if (VP->ContainsGorF)
		{
			REPLAC (Value,"[","@[",maxlen);
			REPLAC (Value,"$","@$",maxlen); 
		}
		GlobalUnlock (handle);
	} 
		else *Value=0;
	return;
} 


long OutputToFile (LPSTR File, LPSTR DBName,LPSTR pSQL, HANDLE hFields,BOOL UseHLT,BOOL OutToScreen,BOOL GMHeader,HWND StatusWnd,HWND hWndDlg)
{   
    HANDLE      hSQL; 
    LPINT       lpField, StartField;
    short         NumFields;
    long        rtn=0, TotRecs=0, AtRec=0;
    char        str[260];
    short         st,ifield,j; 
    LPSTR       lpHead, lpRec, lpEnd;
    LPOPENFILEDATA  FilePtr;
    LPOPENSQLDATA   SQLPtr=0;
    LPFIELDINFO lpFieldInfo; 
    HANDLE      SaveHandle, hRec, hHead;
    HFILE       OutFid, IndexFid;     
    long        iref, nRecs, Recloc,maxrowlen;
    extern  HANDLE  hHighlight;    
    
typedef struct
    {
        short Show; 
        long    Sequence; 
        PICKDATA    PD; 
    } HIGHLIGHTDATA;
    HIGHLIGHTDATA   HighlightData;
    
    OFSTRUCT    OFStruct; 
    char    IndexFile[144];
    
    hSQL=0;
    if (!OpenDataFile (DBName,pSQL,BT_READ,&hSQL))
        return FALSE;   
    
    if (UseHLT)
    	TotRecs = BT_NUM_IN_INDEX (hHighlight); 
/*    else if (StatusWnd)
    	TotRecs = NumSQLRows (hSQL);   */
    hHead = GSSiGlobAlloc(GHND,4096);
    hRec  = GSSiGlobAlloc(GMEM_MOVEABLE,4096);   
    lpRec = GlobalLock(hRec);
    lpHead = GlobalLock(hHead);
    OutFid = GSSiOpenFile (File,&OFStruct,OF_CREATE);
    if (OutFid == HFILE_ERROR)
    {
    	GSSiMessageBox (File,"Unable to create output file",MB_ICONEXCLAMATION);
    	goto Exit;
    }
    if (OutToScreen)
    { 
        GetTempFileName (0,"idx",0,(LPSTR)IndexFile); 
        IndexFid = GSSiOpenFile(IndexFile,&OFStruct,OF_CREATE);
    }
    else
        IndexFid=0; 
        
    SQLPtr = (LPOPENSQLDATA)GlobalLock (hSQL);
    FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle);
    if (hFields)
    {   
	    lpField = (LPINT) GlobalLock(hFields);
	    NumFields = *lpField++;
	    StartField = lpField;   
	}
    lpFieldInfo = &FilePtr->FldInfo;   
    for (ifield=0;ifield<FilePtr->NumFields;ifield++,lpFieldInfo++)
    {   
    	if (hFields)
    	{
            for (j=0,lpField=StartField;j<NumFields;j++,lpField++) 
            {
                if (ifield==*lpField) goto UseFld;
            }
            goto SkipFld;
        }
UseFld: 
		if (*lpHead)
			_fstrcat (lpHead,",");
		if (GMHeader)
		{   
			CreateGMTextHeader (lpFieldInfo,lpHead);
        }
        else
		{ 
			if (lpFieldInfo->type == BT_RIGHT_CHAR || lpFieldInfo->type == BT_CHAR ||
				lpFieldInfo->type == SQL_CHAR || lpFieldInfo->type == SQL_VARCHAR)
	        	sprintf (_fstrchr(lpHead,0),"\"%s\"",lpFieldInfo->name);
	        else
	        	sprintf (_fstrchr(lpHead,0),"%s",lpFieldInfo->name);
        }
SkipFld:; 
    }
    fputstring (lpHead,OutFid);
	nRecs=0;
    maxrowlen=0;
    if (UseHLT)
	    st = BT_FIND (hHighlight,(LPSTR)&iref,BT_FIRST,BT_ANY,(LPSTR)&HighlightData); 
	else
		st = 0;
    while (!st)
    {   
    	if (UseHLT)
    	{
	   		PickList[0]=HighlightData.PD;
			ProcessPickedItem (0,FALSE);  
	    } 
		AtRec++;
		if (TotRecs && StatusWnd)      		
	        PctBox (StatusWnd,TotRecs,AtRec,-1);
	    else 
	    {
	    	sprintf (str,"%ld records written",AtRec);
	    	SetWindowText (hWndDlg,str);
	    }
        lpFieldInfo = &FilePtr->FldInfo;   
        *lpRec = 0;
        for (ifield=0;ifield<FilePtr->NumFields;ifield++,lpFieldInfo++)
        {   
        	if (hFields)
        	{
	            for (j=0,lpField=StartField;j<NumFields;j++,lpField++) 
	            {
	                if (ifield==*lpField) goto UseField;
	            }
	            goto SkipField;
	        }
    UseField:
            if (GetValFromOpenFiles (lpFieldInfo->name,str) < 0)
                goto NextHlt; 
            Truncate (str);
            if (*lpRec)
            	_fstrcat (lpRec,",");
			if (lpFieldInfo->type == BT_RIGHT_CHAR || lpFieldInfo->type == BT_CHAR ||
				lpFieldInfo->type == SQL_CHAR || lpFieldInfo->type == SQL_VARCHAR)
	        	sprintf (_fstrchr(lpRec,0),"\"%s\"",str);
	        else
	        	sprintf (_fstrchr(lpRec,0),"%s",str);
     SkipField:;
        }
NextHlt: 
		if (_fstrlen(lpRec)>1)
		{
	        
	        Recloc = _llseek(OutFid,0,1);
	        if (IndexFid)
	            _lwrite (IndexFid,(char *)&Recloc,sizeof(Recloc)); 
	        nRecs++;
	        fputstring (lpRec,OutFid);
	        maxrowlen = max(maxrowlen,(signed)_fstrlen(lpRec)); 
	        rtn++;  
	    }
	    if (CheckForContinue ())
	    {
			if (UseHLT)
	        	st = BT_FIND (hHighlight,(LPSTR)&iref,BT_NEXT,BT_ANY,(LPSTR)&HighlightData);
	        else
			{
				if (FetchDBRec (hSQL))
					st=0;
				else
					st=1;
			}
		}
		else 
		{
	    	GSSiMessageBox ("Operation cancelled by user","",MB_ICONEXCLAMATION);
	    	break;
	    }
			
    }
    if (IndexFid)
    {   long rec;
        _llseek (IndexFid,0,0);
        for (rec=0;rec<nRecs;rec++)
        {
            _lread(IndexFid,&Recloc,sizeof(Recloc));
            _lwrite(OutFid,(char *)&Recloc,sizeof(Recloc));
        }
        _lwrite(OutFid,(char *)&nRecs,sizeof(nRecs));
        _lwrite(OutFid,(char *)&maxrowlen,sizeof(maxrowlen));
        GSSiClose(IndexFid);
        IndexFid = GSSiOpenFile(IndexFile,&OFStruct,OF_DELETE);
    }      
    GSSiClose (OutFid);
Exit:
    if (hFields)     
    	GlobalUnlock(hFields);
    GSSiGlobUlFree(&hRec);
    GSSiGlobUlFree(&hHead);
    if (SQLPtr)
    {
	    GlobalUnlock (SQLPtr->OFHandle);
	    GlobalUnlock (hSQL);
	}
    CloseDataFile (TRUE, &hSQL);
    return (rtn);
}

BOOL GetOriginalImageBounds (LPSTR IndexPath,LPSTR ImageName,LPMNMXCORD	lpBounds)
{
	LPFILEINDEX lpIndex;
	HANDLE	handle; 
	LPSTR	lpDot;
	BOOL	SaveIgnoreBounds=IgnoreBounds; 
		                 	
	DBoundsInit (lpBounds);
	IgnoreBounds=TRUE;
	handle = OpenMapIndex (IndexPath);
	if (!handle)
	{
		IgnoreBounds = SaveIgnoreBounds;
		return FALSE;   
	}
	lpIndex = (LPFILEINDEX)GlobalLock (handle); 
NextFile:
	if (lpIndex->FileInIndex >= lpIndex->NumFiles-1)
	{   
	    if (!(lpIndex=GetNextIndexHeader(&handle)))
		{
			IgnoreBounds = SaveIgnoreBounds;
	    	return TRUE;
	    }
	    goto NextFile;
	}
	GetNextIndexEntry(lpIndex); 
	lpDot = _fstrrchr (lpIndex->CurrentEntry->Name,'.');
	if (lpDot)
		*lpDot = 0;
	if (!_fstricmp (lpIndex->CurrentEntry->Name,ImageName))
		AddMinMaxD (lpBounds,&lpIndex->CurrentEntry->Bounds);
	if (lpDot)
		*lpDot = '.';
	goto NextFile;
}
