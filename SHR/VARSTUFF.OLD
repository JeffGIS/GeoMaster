BOOL GetDelimTextData(LPSTR str,HANDLE hDLT)
{
	LPSTR	BeginLoc, EndLoc;
	char	EndChar; 
	int		ivar=0, LineLen,l; 
	VARPNT	VarPtr;
	LPSHORT	nDLTvar;
	LPHANDLE	DLTVar; 
	LPSHORT	DLTStart,DLTLen;
	
	nDLTvar = (LPSHORT)GlobalLock (hDLT);
	DLTVar = (LPHANDLE)(nDLTvar + 1);
	DLTStart = (LPSHORT)(DLTVar + MAXDLTVAR);
	DLTLen = (LPSHORT)(DLTStart + MAXDLTVAR);
	 
	for (ivar=0;ivar<*nDLTvar;ivar++)
	{   
		VarPtr = (VARPNT)GlobalLock (DLTVar[ivar]);
		VarPtr->Len = 0;
		VarPtr->changetime = NextVarTime();
		SetLinkedVarTime (VarPtr); 
		GlobalUnlock (DLTVar[ivar]);
	} 
	ivar=0;
	if (DLTStart[0]>=0)
	{   
		LineLen = _fstrlen(str);
		for (ivar=*nDLTvar-1;ivar>=0;ivar--)
		{   
			VarPtr = (VARPNT)GlobalLock (DLTVar[ivar]);
			if (DLTStart[ivar]<LineLen)
			{   
				if (VarPtr->ValueIsHandle)
				{
					HANDLE handle = atol (VarPtr->Value);
					GSSiGlobFree (&handle); 
					VarPtr->ValueIsHandle = 0;
				}
				BeginLoc = str+DLTStart[ivar];
				EndLoc = BeginLoc + DLTLen[ivar];
				EndChar = *EndLoc;
				*EndLoc = '\0';
				_fstrcpy (VarPtr->Value,BeginLoc); 
				l = _fstrlen(BeginLoc);
				VarPtr->Len = min (l,DLTLen[ivar]);
				*EndLoc = EndChar; 
			}
			GlobalUnlock (DLTVar[ivar]);
		} 
		goto RtnTrue;
	}	 
Next:if (*str == '"')
	{
		str++;
		EndChar = '"';
	}
	else
		EndChar = ',';
	BeginLoc = str;
	EndLoc = _fstrchr(str,EndChar);
	if (EndLoc)
		*EndLoc = '\0';  
	VarPtr = (VARPNT)GlobalLock (DLTVar[ivar]);
	if (VarPtr->ValueIsHandle)
	{
		HANDLE handle = atol (VarPtr->Value);
		GSSiGlobFree (&handle); 
		VarPtr->ValueIsHandle = 0;
	}
	strncpy0 (VarPtr->Value,BeginLoc,255); 
	VarPtr->Len = _fstrlen(BeginLoc); 
	GlobalUnlock (DLTVar[ivar]);
	if (!EndLoc) goto RtnTrue;
	str = ++EndLoc; 
	if (!*str) goto RtnTrue;
	if (EndChar == '"')
	{
		if (*str != ',') goto RtnFalse;
		str++; 
	}
	ivar++;
	if (ivar >= *nDLTvar) goto RtnTrue;
	goto Next;
	
RtnTrue:
	GlobalUnlock (hDLT);  
	return TRUE;
RtnFalse:
	GlobalUnlock (hDLT);  
	return FALSE;
}  

HANDLE	GetDLTVarHandle (short ivar,HANDLE hDLT)
{   
	HANDLE	rtn=0;
	
	LPSHORT	nDLTvar;
	LPHANDLE	DLTVar; 
	LPSHORT	DLTStart,DLTLen;
	
	nDLTvar = (LPSHORT)GlobalLock (hDLT);
	DLTVar = (LPHANDLE)(nDLTvar + 1);
	DLTStart = (LPSHORT)(DLTVar + MAXDLTVAR);
	DLTLen = (LPSHORT)(DLTStart + MAXDLTVAR);  
	rtn = DLTVar[ivar];
	GlobalUnlock (hDLT);
	return rtn;
}

BOOL GetDLTVarName (short ivar,HANDLE hDLT, LPSTR Name)
{
	VARPNT	VarPtr;
	LPSHORT	nDLTvar;
	LPHANDLE	DLTVar; 
	LPSHORT	DLTStart,DLTLen;
	
	nDLTvar = (LPSHORT)GlobalLock (hDLT);
	DLTVar = (LPHANDLE)(nDLTvar + 1);
	if (ivar > *nDLTvar)
	{
		GlobalUnlock (hDLT);
		return FALSE;
	}
	ivar--;
	VarPtr = (VARPNT)GlobalLock (DLTVar[ivar]);
	_fstrcpy (Name,VarPtr->Name); 
	GlobalUnlock (DLTVar[ivar]);
	GlobalUnlock (hDLT);
	return TRUE;
}

void SetVarSaveStatus (LPSTR Name,BOOL Save)
{   VARPNT  VarPnt;   
	HANDLE	handle;

	handle = AllocateVar (Name);
	VarPnt = (VARPNT)GlobalLock(handle);  
	VarPnt->Save = Save;
	GlobalUnlock (handle);
	return;
} 

void UpdateVarHandle (HANDLE OldHandle,HANDLE NewHandle)
{   
	UINT	i,l	;
	VARPNT  VarPnt;
	
	for (i=0;i<NumVars;i++)
	{   
		if (VarHandles[i] == OldHandle)
			VarHandles[i] = NewHandle;
		else
		{
			VarPnt = (VARPNT)GlobalLock (VarHandles[i]);
			l=VarPnt->NumLinkedVars;  
			while (l--)
			{
				if (VarPnt->LinkedVar[l] == OldHandle)
					VarPnt->LinkedVar[l] = NewHandle;
			}
			GlobalUnlock (VarHandles[i]); 
		}
	}
	return;
}

BOOL GetVarSaveStatus (LPSTR Name)
{   VARPNT  VarPnt;   
	HANDLE	handle; 
	BOOL	Save;
	short	ii;

	if (!(handle = FindVar(Name)))
		return TRUE;
	VarPnt = (VARPNT)GlobalLock(handle);  
	Save = VarPnt->Save;
	GlobalUnlock (handle);
	if (!Save)
		ii=1;
	return Save;
}

HANDLE	AllocateVar (LPSTR Name)
{   VARPNT  VarPnt;   
	HANDLE	handle;

	if (handle = FindVar(Name))
		return (handle);
	
	AddToVarNameTable (Name);
	handle = GSSiGlobAlloc(GHND,sizeof(VARINFO));
	VarHandles[NumVars++]= handle;
	VarPnt = (VARPNT)GlobalLock(handle);  
	VarPnt->Handle = handle;
	_fstrcpy(VarPnt->Name,Name);   
	VarPnt->Save = TRUE;
	GlobalUnlock (handle);
	return (handle);

}
 
void SetIntRefno (long Ref)
{
	VARPNT  VarPnt;  
	
   	InternalRefno = Ref; 
   	if (hIntRefno)
   	{
		VarPnt = (VARPNT)GlobalLock (hIntRefno);
		VarPnt->changetime = NextVarTime();
		SetLinkedVarTime (VarPnt); 
        GlobalUnlock (hIntRefno);
    }
    return;
}

void AddToVarNameTable (LPSTR Name)
{   
	LPVARNAMEINDEXITEM	lpVN;  
	UINT	i;
	
	if (NumVars >= MAXGLOBALS) 
		BlowOut ("Maximum globals exceeded",NULL);
	if (_fstrlen (Name) > 61)
		MessageBox (GetFocus(),"Length of variable name exceeds 61 characters",Name,MB_ICONEXCLAMATION);
	if (!hVarNameTable)
		hVarNameTable = GSSiGlobAlloc (GMEM_MOVEABLE,(long)sizeof(VARNAMEINDEXITEM)*MAXGLOBALS);
	lpVN = (LPVARNAMEINDEXITEM)GlobalLock (hVarNameTable); 
	for (i=0;i<NumVars;i++,lpVN++)
	{
		if (_fstricmp (Name,lpVN->Name) < 0)
		{   
			_fmemmove ((LPVOID)(lpVN+1),(LPVOID)lpVN,((USHORT)NumVars-i)*sizeof(VARNAMEINDEXITEM));
			goto Exit;
		}
	}
Exit:
	strncpy0 (lpVN->Name,Name,62);
	lpVN->id = NumVars; 
	GlobalUnlock (hVarNameTable);   
	return;
}

void DestroyVarNameTable (void)
{  
	GSSiGlobFree (&hVarNameTable);
	return;
}        		

HANDLE	AllocateTypeVar (LPSTR Name,short Type)
{   VARPNT  VarPnt;   
	HANDLE	handle;

	if (handle = FindVar(Name))
	{
		VarPnt = (VARPNT)GlobalLock(handle);  
		if (VarPnt->Type != Type)
			VarPnt->Type = Type;
		GlobalUnlock (handle);
		return (handle);
	}
	AddToVarNameTable (Name);
	
	handle = GSSiGlobAlloc(GHND,sizeof(VARINFO));
	VarHandles[NumVars++]= handle;
	VarPnt = (VARPNT)GlobalLock(handle);  
	VarPnt->Type = Type; 
	VarPnt->Save = FALSE;
	VarPnt->Handle = handle;
	_fstrcpy(VarPnt->Name,Name);
	GlobalUnlock (handle);
	return (handle);

}
void NextPage (HDC hPr)
{   
	PrintReportPage++; 
	if (Printing)
	{
		EndPage (hPr);
		StartPage (hPr);  
	}

	return;
}  

void ProcessText (LPSTR InText)
{
	HANDLE	handle=GSSiGlobAlloc (GMEM_MOVEABLE,(long)4096);
	LPSTR	Text=GlobalLock (handle);
	
	_fstrcpy (Text,InText);
	ExpandText (Text);
	GSSiGlobUlFree (&handle);
	return;
}

void ProcessGlobal (LPSTR Global)
{
	HANDLE	handle=GSSiGlobAlloc (GMEM_MOVEABLE,(long)4096);
	LPSTR	str=GlobalLock (handle);
	
	GetGlobalCVal (Global,str,NULL);
	ExpandText (str);
	GSSiGlobUlFree (&handle);
	return;
}

LPSTR ExpandText (LPSTR InText)
{
	HANDLE	hMem=NULL, hMemTrace;
	LPSTR	InLoc, OutLoc, NewText, BegBrack, EndBrack, loc, EqLoc, pLchr;
	LPSTR	pEnd, pStr;
	long	l,ii;
	BOOL	FoundLit=FALSE, SaveIE=InExpand;
	
	InExpand = TRUE;
	if (TraceType[0])
	{   
		hMem=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
		pStr = GlobalLock (hMem);
		sprintf (pStr,"EXPIN:%s",InText);
		GSSiTraceLev (pStr,1);
		GSSiGlobUlFree (&hMem);
	}
	InLoc = InText;   
	if (*InLoc == '{')
	{
//		pLchr = LastChr (InLoc);
    	pEnd = MatchLev ((LPSTR)(InLoc+1),'}');
    	if (pEnd)
    	{
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,UINT_MAX);
			NewText = OutLoc = GlobalLock(hMem);
			l = pEnd - InLoc -1;
			InLoc++;
			if (l) _fmemmove(OutLoc,InLoc,(size_t) l);
			OutLoc[l] = 0;
	    	InLoc = OutLoc;
	    }
    }

	while (*InLoc && ContinueProcessing)
	{
		if (*InLoc == '@') /* literal */
		{
			if (!hMem)
			{
				hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
				NewText = GlobalLock(hMem);
				l = (InLoc - InText);
				if (l>0) _fmemmove(NewText,InText,(size_t) l);
				OutLoc = NewText + l;
			}
			InLoc++;
			*OutLoc++ = *InLoc;
			if (*InLoc != '@')
				InLoc++;
			FoundLit = TRUE;
		}
		else if (*InLoc == '[')
		{   
			if (!(EndBrack = MatchLev((LPSTR)(InLoc+1),']'))) goto OutChar; 
			if (!hMem)
			{
				hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
				NewText = GlobalLock(hMem);
				l = (InLoc - InText);
				if (l>0) _fmemmove(NewText,InText,(size_t) l);
				OutLoc = NewText + l;
			}
			EqLoc = EndBrack;
			EqLoc++;
			if (*EqLoc=='=')
			{   HANDLE	hMemEq;
				LPSTR	EqText, SemiCLoc, VName; 
				BOOL	FoundSemiC=FALSE;
			    
			    VName = InLoc;
			    VName++;
			    *EndBrack = '\0';
			    SemiCLoc = MatchLev (EqLoc,';');
			    if (!SemiCLoc)
			    	SemiCLoc = _fstrchr (EqLoc,'\0'); 
			    else
			    	FoundSemiC=TRUE;
			    *SemiCLoc = '\0';
				hMemEq = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
				EqText = GlobalLock(hMemEq);
				l = (SemiCLoc - EqLoc);
				if (l>0) _fmemmove(EqText,++EqLoc,(size_t) l);  
				if (LinkToVar)
					ExpandText (EqText);
				else
					SetGlobalValue (VName,EqText); 
				GSSiGlobUlFree (&hMemEq);
				InLoc = SemiCLoc;  
				if (FoundSemiC)
					InLoc++;
			}
			else
			{
				l = EndBrack - InLoc - 1; 
				InLoc++;
				_fmemmove(OutLoc,InLoc,(size_t) l);
				InLoc = ++EndBrack;
				loc = OutLoc + l;
				*loc = '\0';
				loc = ExpandText (OutLoc);
			    l = GetVal(OutLoc,OutLoc);
			    OutLoc+=l;
			}
		}
		else if (!_fstrnicmp (InLoc,"WHILE(",6))
		{
			long	lWhile, lLoop, nLoops=-1;  
			LPSTR	pWhile, pWhile2, pLoop;
			HANDLE	hLoop, hWhile, hStr;
				
			InLoc += 6;
			pEnd = MatchLev (InLoc,')');
			if (!pEnd)
				goto WhileError; 
			pWhile = InLoc;
			lWhile = pEnd++ - InLoc; 
			if (*pEnd != '{')
				goto WhileError;   
			InLoc = pEnd;
			InLoc++;
			pEnd = MatchLev (InLoc,'}');
			if (!pEnd)
				goto WhileError; 
			lLoop = pEnd++ - InLoc;
			hLoop = GSSiGlobAlloc (GHND,lLoop+1);
			pLoop = GlobalLock (hLoop);
			_fstrncpy (pLoop,InLoc,(size_t)lLoop); 
			GlobalUnlock (hLoop);
			InLoc = pEnd;
			hWhile = GSSiGlobAlloc (GHND,lWhile+1);
			pWhile2 = GlobalLock (hWhile);
			_fstrncpy (pWhile2,pWhile,(size_t)lWhile); 
			GlobalUnlock (hWhile); 
			hStr = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
			pStr = GlobalLock (hStr); 
			nLoops = 0;
	NextWhileLoop: 
			if (ContinueProcessing)
			{
				BOOL	Rtn;
				short	rc;
				
				pWhile = GlobalLock (hWhile);
				_fstrcpy (pStr,pWhile);
				GlobalUnlock (hWhile);
				Rtn = LogicP (pStr,&rc);
//				ExpandText (pStr);
//				if (!_fstrcspn (pStr," 1TtYy"))     
				if (Rtn && !rc)
				{
					pLoop = GlobalLock (hLoop);
					_fstrcpy (pStr,pLoop);
					GlobalUnlock (hLoop);
					ExpandText (pStr);
					if (ContinueProcessing) 
					{
						nLoops++;
						goto NextWhileLoop;    
					}
				}  
			}
			GSSiGlobUlFree (&hStr);
			GlobalFree (hLoop);
			GlobalFree (hWhile);
	WhileError:
			if (!hMem)
			{
				hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
				NewText = GlobalLock(hMem);
				l = (InLoc - InText);
				if (l>0) _fmemmove(NewText,InText,(size_t) l);
				OutLoc = NewText + l;
			}
			ltoa (nLoops,OutLoc,10);
			OutLoc = _fstrchr (OutLoc,0);
		}
		else if (!_fstrnicmp (InLoc,"IF(",3))
		{
			long	lIF, lTHEN;  
			LPSTR	pEndIF, pStartIF=InLoc;
			LPSTR	pIF, pIF2, pTHEN;
			HANDLE	hTHEN, hIF, hStr;
			BOOL	IfRtn, IfOK = FALSE;
			short	rc;
				
			if (!(pEndIF = MatchLev (InLoc,';')))
				pEndIF = _fstrchr (InLoc,0);
			InLoc += 3;
			pEnd = MatchLev (InLoc,')');
			if (!pEnd)
				goto IfError; 
			pIF = InLoc;
			lIF = pEnd++ - InLoc; 
			if (!(pEnd = FirstNonBlank(pEnd)))
				goto IfError;
			if (!_fstrncmp (pEnd,"THEN",4))
				pEnd+=4;
			if (*pEnd != '{')
				goto IfError;   
			InLoc = pEnd;
			InLoc++;
			pTHEN = InLoc;
			pEnd = MatchLev (InLoc,'}');
			if (!pEnd)
				goto IfError; 
			lTHEN = pEnd++ - pTHEN;
			InLoc = pEnd;
			hIF = GSSiGlobAlloc (GHND,4096);
			pIF2 = GlobalLock (hIF);
			_fstrncpy (pIF2,pIF,(size_t)lIF); 
			IfRtn = LogicP (pIF2,&rc); 
			GSSiGlobUlFree (&hIF);
			if (rc)
				goto IfError; 
			if (!hMem)
			{
				hMem = GSSiGlobAlloc(GMEM_MOVEABLE,UINT_MAX);
				NewText = GlobalLock(hMem);
				l = (pStartIF - InText);
				if (l>0) _fmemmove(NewText,InText,(size_t) l);
				OutLoc = NewText + l;
			}  
			if (IfRtn)
			{   
				if (*pEndIF == ';')
					InLoc = pEndIF + 1;
				else
					InLoc = pEndIF;
				_fstrncpy (OutLoc,pTHEN,(size_t)lTHEN);
				OutLoc[lTHEN]=0;
				ExpandText (OutLoc); 
				OutLoc = _fstrchr (OutLoc,0);
			}
			else
			{
				InLoc = FirstNonBlank(InLoc);
				if (!_fstrncmp (InLoc,"ELSE",4))
				{
					InLoc += 4;
					l = pEndIF - InLoc;
					if (l)
					{
						_fstrncpy (OutLoc,InLoc,(size_t)l);
						OutLoc[l]=0;
						ExpandText (OutLoc); 
						OutLoc = _fstrchr (OutLoc,0);
					}
				}	
				if (*pEndIF == ';')
					InLoc = pEndIF + 1;
				else
					InLoc = pEndIF;
			}
			IfOK = TRUE;
	IfError:
			if (ContinueProcessing)
				ContinueProcessing = IfOK;
		}
		else if (*InLoc == '$')
		{   
			int	FunID;
			
			if (!(BegBrack = _fstrchr(InLoc,'('))) goto OutChar;
			if (!(EndBrack = MatchLev((LPSTR)(BegBrack+1),')'))) goto OutChar;  
			if (!(FunID = GetFunctionID(InLoc,BegBrack))) goto OutChar;
			if (!hMem)
			{
				hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
				NewText = GlobalLock(hMem);
				l = (InLoc - InText);
				if (l>0) _fmemmove(NewText,InText,(size_t) l);
				OutLoc = NewText + l;
			}
			BegBrack++;
			l = EndBrack - BegBrack; 
			InLoc = BegBrack;
			_fmemmove(OutLoc,InLoc,(size_t) l);
			InLoc = ++EndBrack;
			loc = OutLoc + l;
			*loc = '\0';
			if (ContinueProcessing)
			{
				if (FunID > 799 && FunID != 904)
		    		l = GetFunctionValue2(FunID,OutLoc,OutLoc); 
		    	else
		    		l = GetFunctionValue(FunID,OutLoc,OutLoc);
		    }
		    else
		    	l=0;
		    OutLoc+=l;
		}
		else
		{
OutChar:	if (hMem)
				*OutLoc++ = *InLoc++;
			else
				InLoc++;
		}
	}
	FoundLiteral = FoundLit;
	if (TraceType[0])
	{
		hMemTrace=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
		pStr = GlobalLock (hMemTrace); 
		if (hMem)   
		{
			l = OutLoc - NewText;
			NewText[l]=0;
			sprintf (pStr,"EXPOUT:%s",NewText); 
		}
		else
			sprintf (pStr,"EXPOUT:%s",InText); 
		GSSiTraceLev (pStr,-1);
		GSSiGlobUlFree (&hMemTrace);
	}
	InExpand = SaveIE;
	if (hMem)
	{
		l = OutLoc - NewText;
		if (*NewText == '"' && l > 1)
		{ 
			if (*(LPSTR)(NewText + l-1) == '"')
			{
				*(LPSTR)(NewText + l-1)	= 0;
				NewText++;
				l -= 2;
			}
		}
		*OutLoc++ = '\0'; 
		_fstrcpy(InText,NewText);
		InText+=l;
		GSSiGlobUlFree (&hMem);
		return (InText);
	}
	if (*InText == '"') 
	{
		l = _fstrlen (InText);
		if (l > 1 && *(LPSTR)(InText + l - 1) == '"') 
		{
			_fmemmove (InText,(InText+1),(size_t)l-2); 
			*(LPSTR)(InText + l - 2) = 0;
		}
	}
	return (InLoc);
}

