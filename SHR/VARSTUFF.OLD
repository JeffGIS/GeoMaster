BOOL GetGlobalCVal (LPSTR Global,LPSTR Val,LPSTR Default)
{
	HANDLE	hStr=GSSiGlobAlloc (GMEM_MOVEABLE,256);
	LPSTR	str=GlobalLock (hStr);
	
	if (*Global != '[')
	{
		*str = '[';
		_fstrcpy (&str[1],Global);
		_fstrcat (str,"]");  
	}
	else
		_fstrcpy (str,Global);
	ExpandText (str);   
	if (!*str)
	{   
		if (Default)
			_fstrcpy (Val,Default);
		else
			*Val = 0; 
		GSSiGlobUlFree (&hStr);
		return FALSE;
	}
	_fstrcpy (Val,str);
	GSSiGlobUlFree (&hStr);
	return TRUE;
} 

