void CloseAllRequestedFiles (void)
{ 
	UINT	i;
	
	if (KeepFilesOpen)
		for (i=0;i<MAXFILEHANDLES;i++)
		{
			if (OpenFileFid[i] != HFILE_ERROR)
			{
				if (OpenFileCloseRequested[i])
				{
					_lclose (OpenFileFid[i]); 
					LogOpenFilesClose (OpenFileFid[i]); 
				}
			}
		}  
	return;
}

void LogOpenFilesOpen (UINT Mode,HFILE Fid,LPOFSTRUCT pOFStruct)
{   
	short	i,j,ii; 
	LPSTR	pDot;   
	static	BOOL	FirstFileOpen=TRUE;
	
	if (FirstFileOpen)
	{ 
		for (i=0;i<MAXFILEHANDLES;i++)
			OpenFileFid[i] = HFILE_ERROR;   
		FirstFileOpen = FALSE;
    }
	if (Fid == HFILE_ERROR)
		return;
	if ((pDot=_fstrstr (pOFStruct->szPathName,".PLT")))
	{
		char	test[128];  
		
		*pDot = 0;
		_fstrcpy (test,pOFStruct->szPathName);  
		*pDot = '.';  
		_fstrcat (test,".rin");
		for (i=0;i<MAXFILEHANDLES;i++) 
		{
			if (OpenFileFid[i] != HFILE_ERROR)
			{ 
				if (!_fstricmp (test,OpenFileStruct[i].szPathName))
					ii=1;//BlowOut();
			}
		}
	}
	if (Mode & OF_EXIST)
		return;
	if (Mode & OF_DELETE)
		return; 
	MaxHFile = max (MaxHFile,Fid);
	for (i=0;i<MAXFILEHANDLES;i++) 
		if (OpenFileFid[i] == HFILE_ERROR)
			goto Gotid;
	i = -1;
	if (KeepFilesOpen) 
	{   
		for (j=0;j<MAXFILEHANDLES;j++)
		{
			if (OpenFileFid[j] != HFILE_ERROR) 
			{
				if (OpenFileCloseRequested[j])
				{
					_lclose (OpenFileFid[j]); 
					LogOpenFilesClose (OpenFileFid[j]);
					i = j;
				}
			}
		}
	}
	if (i >= 0)
		goto Gotid;
	MessageBox (GetFocus(),"Open file limit exceeded",NULL,MB_ICONEXCLAMATION);
	return;
Gotid:			
	OpenFileFid[i] = Fid;     
	OpenFileStruct[i] = *pOFStruct;
	OpenFileMode[i] = Mode;
	OpenFileCloseRequested[i] = FALSE;    
	NumOpenFiles++;
	return;
}

void LogOpenFilesClose (HFILE Fid)
{   
	UINT	i,ii;
	
	if (Fid == HFILE_ERROR)
		return;
	for (i=0;i<MAXFILEHANDLES;i++)
		if (OpenFileFid[i] == Fid)
		{
			OpenFileFid[i] = HFILE_ERROR;
			NumOpenFiles--; 
			return;
		} 
	ii=1;
		
	return;
} 

HFILE FileAlreadyOpen (LPSTR InName,UINT Mode)
{   
	UINT	i;
	
	if (KeepFilesOpen) 
	{   
		LPSTR	pFullPath = _fullpath (NULL,InName,0);
		for (i=0;i<MAXFILEHANDLES;i++)
		{
			if (OpenFileFid[i] != HFILE_ERROR)
			{
				if (!_fstricmp (pFullPath,OpenFileStruct[i].szPathName))
				{
					free (pFullPath); 
					if (Mode == OF_READ && OpenFileMode[i] == OF_READ)
					{
						_llseek (OpenFileFid[i],0,0);
						return OpenFileFid[i];       
					}
					_lclose (OpenFileFid[i]); 
					LogOpenFilesClose (OpenFileFid[i]);
					return HFILE_ERROR;
				}
			}
		}  
		free (pFullPath);
	}
	return HFILE_ERROR;
}

BOOL RequestFileClose (HFILE Fid)
{   
	UINT	i;
	
	if (!KeepFilesOpen || ShareEnabled)
		return FALSE;
	for (i=0;i<MAXFILEHANDLES;i++)
		if (OpenFileFid[i] == Fid) 
		{ 
			if (OpenFileMode[i] == OF_READ)
			{ 
				OpenFileCloseRequested[i] = TRUE;
				return TRUE;
			} 
			return FALSE;
		}   
	return FALSE;
}

short	GetNumOpenFiles (void)
{
	return NumOpenFiles;
}

short GetOpenFileID (HFILE Fid)
{   
	short	i;
	
	if (Fid < 0)
		return -1;
	for (i=0;i<MAXFILEHANDLES;i++)
		if (OpenFileFid[i] == Fid) 
		{   
			return i;
		}
	return -1;
}  

void DumpOpenFiles (void)
{   
	char	str[256];  
	UINT	i;
	   
	if (!TraceOn)  
		return; 
	sprintf (str,"%i Open Files:");   
	GSSiTrace (str);
	for (i=0;i<MAXFILEHANDLES;i++)
	{
		if (OpenFileFid[i] != HFILE_ERROR)
		{ 
			sprintf (str,"    -%i %s %u",OpenFileFid[i],OpenFileStruct[i].szPathName,OpenFileMode[i]);    
			GSSiTrace (str);
		}
	}
	return;
}

BOOL BackupFiles (LPSTR FileList,LPSTR BUDir)
{
	HFILE	Fid1;
	OFSTRUCT	OFStruct; 
	char	FromFile[260], ToFile[260];    
	BOOL	rtn=FALSE;
	
	Fid1 = GSSiOpenFile (FileList,&OFStruct,OF_READ);
	if (Fid1 == HFILE_ERROR)
		return FALSE; 
	while (fgetstring (FromFile,256,Fid1))
	{ 
		_fstrcpy (ToFile,BUDir);
		_fstrcat (ToFile,"\\");
		_fstrcat (ToFile,FromFile);  
		if (!makedirectories (ToFile,FALSE))
			goto Exit;
		if (!copyfile (ToFile,FromFile,FALSE,0,0,0,0,0,0))   
		{
			GSSiMessageBox ("Backup failed on above file",FromFile,MB_ICONEXCLAMATION);
			goto Exit;                                                                 
		}
	} 
	rtn = TRUE;
Exit:
	GSSiClose (Fid1);
	return rtn;
}


void GSSiDeleteObject (HGDIOBJ *handle)
{   int	i;

	if (*handle)
	{
		if (!DeleteObject (*handle))
			i=1;
		*handle = 0;
	}
	return;
}

short loadtabs (LPSHORT Tabs)
{
	OFSTRUCT OFStruct;
	HFILE	Fid;   
	char	txt[256]; 
	short	n; 
	LPSTR	lpBeg, lpEnd;
	
	Fid = GSSiOpenFile ("tabs.txt",&OFStruct,OF_READ);
	fgetstring (txt,200,Fid);
	n = 0;  
	lpBeg = txt;
	while (lpBeg)
	{
		if ((lpEnd = _fstrchr (lpBeg,' ')))
			*lpEnd++ = 0;
		*Tabs++ = atoi (lpBeg);
		n++;
		lpBeg = lpEnd; 
	}   
	GSSiClose (Fid);
	return n; 
}

BOOL makedirectories (LPSTR Name,BOOL IsDir)
{   
	char	FullName[128], Dir[130], FName[64], Ext[8], NewName[128]="", drive[4]; 
	LPSTR	StartDir, EndDir;  
	OFSTRUCT	OFStruct;
	BOOL	Replace;
	
	_fmemset (Dir,0,130);
	_fstrcpy (Dir,Name);
	ExpandText (Dir);
	_fullpath (FullName,Dir,sizeof(FullName));
	EndDir = _fstrchr (FullName,0);
	EndDir++;
	*EndDir = 0;
	_splitpath (FullName,drive,Dir,FName,Ext); 
	
	if (!IsDir || *Ext)	
		sprintf (FullName,"%s%s",drive,Dir);
	else
		sprintf (FullName,"%s%s%s",drive,Dir,FName); 
	StartDir = FullName; 
	while (*StartDir)
	{
		EndDir = _fstrchr ((LPSTR)(StartDir+1),'\\');
		if (!EndDir)
			EndDir = _fstrchr (StartDir,0); 
		*EndDir = 0;
		if (*StartDir != '\\' && *NewName)
			_fstrcat (NewName,"\\");
		_fstrcat (NewName,StartDir); 
		if (*LastChr (NewName) != ':')
		{
			if (_mkdir (NewName) == -1 && errno == ENOENT)
				return FALSE;
		}
		StartDir = ++EndDir;
	} 
	
	return TRUE;
} 

double	GetDriveFreeSpace (char Drive)
{   
	short	st, idrive;
	char	drive = tolower(Drive);
	
	struct  {
	   unsigned total_clusters;          // Clusters per drive
	   unsigned avail_clusters;          // Available clusters
	   unsigned sectors_per_cluster;     // Sectors per cluster
	   unsigned bytes_per_sector;        // Bytes per sector
	
	}diskspace; 
	
	idrive = drive - 'a' + 1;               
    st = _dos_getdiskfree(idrive, (struct _diskfree_t *)&diskspace ); 
    if (st)
    	return -1;
    else
    	return ((double)diskspace.avail_clusters * (double)diskspace.sectors_per_cluster * (double)diskspace.bytes_per_sector); 
}

double	GetDriveSize (char Drive)
{   
	short	st, idrive;
	char	drive = tolower(Drive);
	
	struct  {
	   unsigned total_clusters;          // Clusters per drive
	   unsigned avail_clusters;          // Available clusters
	   unsigned sectors_per_cluster;     // Sectors per cluster
	   unsigned bytes_per_sector;        // Bytes per sector
	
	}diskspace; 
	
	idrive = drive - 'a' + 1;               
    st = _dos_getdiskfree(idrive, (struct _diskfree_t *)&diskspace ); 
    if (st)
    	return -1;
    else
    	return ((double)diskspace.total_clusters * (double)diskspace.sectors_per_cluster * (double)diskspace.bytes_per_sector); 
}

long	GetProcessorID (void)
{
	DWORD End,Start = GetTickCount();
	DWORD	i; 
	double	j;
	
	for (i=0;i<100000;i++)
		j = sqrt ((double)i);
	End = GetTickCount();
	return (End-Start);
} 

long GetComputerID (void)
{ 
	long	IDs[5], ID=0;
	short	i; 
	double	s = GetDriveSize ('c');
	
	for (i=0;i<5;i++)
		IDs[i] = GetProcessorID(); 
	ID = 1; 
	for (i=0;i<5;i++)
		ID += IDs[i];  
	ID /= 5;
	ID += ID%2;
	return ID;
}

BOOL GetVolumeLabel(WORD wDrive, LPSTR lpBuff)
{

    struct _find_t  finfo;
    char            sztmp[10];
    
    *lpBuff = 0;
    _fstrcpy(sztmp, "X:\\*.*");
    sztmp[0] = 'A' + wDrive;
    if (_dos_findfirst(sztmp, _A_VOLID, &finfo) != 0)
        return FALSE;
    _fstrcpy(lpBuff, finfo.name); 
    Strip (lpBuff,'.');
    return TRUE;
  
  
} 

void AppendFile (LPSTR File,LPSTR Line)
{
	OFSTRUCT	OFStruct;
	HFILE		Fid;
	
	Fid = GSSiOpenFile (File,&OFStruct,OF_READWRITE);
	if (Fid == HFILE_ERROR)
		Fid = GSSiOpenFile (File,&OFStruct,OF_CREATE_NODELETE);
	_llseek (Fid,0,2);
	fputstring (Line,Fid);
	GSSiClose (Fid);
	return;
}

void AddToMinMaxD (LPMNMXCORD mm1, LPDPOINT pPoint)
{
    mm1->xmn = min (mm1->xmn,pPoint->x);
    mm1->xmx = max (mm1->xmx,pPoint->x);
    mm1->ymn = min (mm1->ymn,pPoint->y);
    mm1->ymx = max (mm1->ymx,pPoint->y); 
    return;
}

void AddMinMax (LPMINMAX mm1, LPMINMAX mm2)
{
    mm1->xmn = min (mm1->xmn,mm2->xmn);
    mm1->xmx = max (mm1->xmx,mm2->xmx);
    mm1->ymn = min (mm1->ymn,mm2->ymn);
    mm1->ymx = max (mm1->ymx,mm2->ymx);
    return;
}

void AddMinMaxD (LPMNMXCORD mm1, LPMNMXCORD mm2)
{
    mm1->xmn = min (mm1->xmn,mm2->xmn);
    mm1->xmx = max (mm1->xmx,mm2->xmx);
    mm1->ymn = min (mm1->ymn,mm2->ymn);
    mm1->ymx = max (mm1->ymx,mm2->ymx);
    return;
}

double ArcDistance(DPOINT p1, DPOINT p2)  
// retrns distance in meters between two lat-longs
{
  double GreatCircle, cos_c, ArcCos, sina,sinb, cosa, cosb, cosl;

    sina =  sin(p1.y/RADIAN);
    sinb =  sin(p2.y/RADIAN);
    cosa =  cos(p1.y/RADIAN);
    cosb =  cos(p2.y/RADIAN);
    cosl =  cos((p2.x-p1.x)/RADIAN);

   cos_c = sina*sinb+cosa*cosb*cosl;
   ArcCos = acos(cos_c);
   GreatCircle = fabs(6371100 * ArcCos);


return GreatCircle;
}  

DPOINT NewLatLong(double Lat,double Long,double Dist,double Direction)
{
 DPOINT LatLong;
//given:          Fixed 7 Oct 96 lda
//  Point N is at the North Pole
//  Point A is at the Given Lat,Long
//  Length of two sides of a triangle and the angle it forms
    double  cosc,cosb,cosa,sinb,sinc,sina,cosC,cosA;



    cosc = cos(Dist/6371100);
    sinc = sin(Dist/6371100);
    cosb = cos((90e0-Lat)/RADIAN);
    sinb = sin((90e0-Lat)/RADIAN);
    cosa = cos(Direction)*sinb*sinc+cosb*cosc;
    cosA = acos(cosa);
    cosA *= RADIAN;
    LatLong.y = 90e0 - cosA;   
    sina = acos(cosa);
    sina = sin(sina);
    cosC = (cosc-(cosb*cosa)) / (sinb*sina);
    cosC = acos(cosC);
    cosC *= RADIAN;
    if(Direction > PY)
      LatLong.x = Long - cosC;
    else
      LatLong.x = Long + cosC;  

  return LatLong;
}      
long Factorial (long value)
{
    long    n=0;  
    
    while (value--)
        n+=value;
    return  n;
} 

UINT ItemInList (short i,UINT nElements,HANDLE hElements)
{   
	LPSHORT	Elements;
	UINT	j;
	
	if (!nElements)
		return 0;
	Elements = (LPSHORT)GlobalLock (hElements);
	for (j=0;j<nElements;j++)
		if (i == Elements[j])
		{
			GlobalUnlock (hElements);
			return (j+1);
		}
	GlobalUnlock (hElements);
	return 0;
}

