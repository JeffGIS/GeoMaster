BOOL    GetFileName (HWND hWnd,LPSTR Name, short StringID)
{ 
    char    CurDir[_MAX_DIR+1], InitDir[_MAX_DIR+1], Drive[_MAX_DRIVE+1], Dir[_MAX_DIR+1];
    short       SaveDrive,ii; 
    BOOL    rtn=FALSE;
    LPSTR   lpEnd, lpPrev;
    
    SaveCurView (0);
    SetFilterString (StringID);
    if (!_getcwd (CurDir,_MAX_DIR))
    {   
    	char	str[64];
    	sprintf (str,"getcwd fails %i",errno);
    	GSSiMessageBox (str,NULL,MB_ICONEXCLAMATION);
    }
    SetWindowText (hWnd,CurDir);
    SaveDrive = _getdrive(); 
    _splitpath (Name,Drive,Dir,0,0); 
    sprintf (InitDir,"%s%s",Drive,Dir);
    lpEnd = LastChr(InitDir);  
    lpPrev = lpEnd;
    if (lpPrev != InitDir)
    	lpPrev--;
    if (*lpEnd == '\\' && *lpPrev != ':')
    	*lpEnd = 0;
    if (GetOpenFileCD (hWnd,Name,InitDir))
    {   
         rtn=TRUE;  
         SubstituteDL (Name);
    }
    _chdrive (SaveDrive);
    if (_chdrive (SaveDrive))
    	ii=1; 
    if (_chdir (CurDir))
    	ii=1;
    SaveCurView (1);
    return rtn;
}   

void SubstituteDL (LPSTR Name)
{   
	if (GetGlobalBVal ("[%SUBDL]"))
	{  
		char	DL[128]="[%DL]";
		short	l=_fstrlen (Name); 
		HANDLE	hMEM=GSSiGlobAlloc (GMEM_MOVEABLE,l+1);
		LPSTR	TempName = GlobalLock (hMEM);         	
		ExpandText (DL);
		_fstrupr (DL); 
		_fstrcpy (TempName,Name);
		_fstrupr (TempName);
		l = _fstrlen (DL);
		         	
		if (!_fstrnicmp (DL,Name,l))
			sprintf (Name,"@[%cDL]%s",'%',&TempName[l]); 
		GSSiGlobUlFree (&hMEM);
	}
    return;
}

void ClientRectToScreenRect (HWND hWnd,LPRECT pRect)
{   
    POINT   pt;
    
    pt.x = pRect->left;
    pt.y = pRect->bottom;
    ClientToScreen (hWnd,&pt);
    pRect->left = pt.x;
    pRect->bottom = pt.y;
    pt.x = pRect->right;
    pt.y = pRect->top;
    ClientToScreen (hWnd,&pt);
    pRect->right = pt.x;
    pRect->top = pt.y; 
    return;
}

double Round (double Value,double RoundTo)
{   
	double Rem;
	
	Rem = fmod(Value,RoundTo);
	if (Rem >= RoundTo / 2)
		Value = Value - Rem + RoundTo;
	else
		Value = Value - Rem; 
	return Value;
} 

double DecDegFromDMS (LPSTR DMS,LPSHORT pErr)
{   
	double dir=1, deg,min,sec;   
	LPSTR	pEnd;
	
	switch (*DMS)
	{
		case 'N':
		case 'E':
			DMS++;
			break;
		case 'S':
		case 'W':
			dir=-1;
			DMS++;
			break;
	}
	deg = strtod (DMS,&pEnd);
	pEnd++;
	min = strtod (pEnd,&pEnd);
	pEnd++;
	sec = strtod (pEnd,&pEnd);  
	deg += min / 60 + sec / 3600; 
	deg *= dir;
	return deg;
}

BOOL GetDMS (double DecDegrees,LPSHORT Deg,LPSHORT Min,LPDOUBLE Sec)
{   
	double	Neg=1, Rem, SEC=(double)1/(double)3600;
	
	if (DecDegrees > 360)
		return FALSE;
	if (DecDegrees < 0)                
	{
		Neg = -1;
		DecDegrees = fabs (DecDegrees);
	}
	DecDegrees += SEC/5000;
	*Deg = floor (DecDegrees);
	Rem = DecDegrees - (double)*Deg;
	Rem *= 60;
	*Min = floor (Rem);
	Rem = Rem - (double)*Min;
	*Sec = Rem * 60;
	if (*Sec < 0.0000001)
		*Sec = 0; 
	*Deg *= Neg;
	return TRUE;
}

LPSTR ValueConv (double Value, short ValConv,double RoundTo, BOOL Commas)
{   static char VCBuff[32];
    char        fmt[32];
    LPSTR   p1, p2, bp, pDot;
    short       n, ndp;  
    double  rndp;
    
    if (RoundTo <= 0) RoundTo = 1; 
    Value = Round (Value,RoundTo);
    if (RoundTo<1)
    {
        rndp = log10(RoundTo); 
        ndp = abs((short)IDNINT(rndp)); 
        sprintf (fmt,"%%.%if",ndp);
        sprintf (VCBuff,fmt,Value);
    }
    else
        sprintf (VCBuff,"%.0f",Value); 
    if (Commas)
    	AddCommas (VCBuff);
    return (VCBuff);  
}

LPSTR AddCommas (LPSTR InBuff)
{
	char	Buff[32],VCBuff[32];
    LPSTR   p1, p2, bp, pDot;
    short	n;
	
	if (_fstrlen (InBuff) > 32)
		return InBuff;
    _fstrcpy (Buff,InBuff);
    bp = Buff; 
    p2=&VCBuff[31]; 
    pDot = _fstrchr (Buff,'.');
    if (pDot)
    {
    	p1 = pDot-1;
    	pDot = _fstrchr(Buff,0);
    	while (pDot > p1)
    		*p2-- = *pDot--;
    }
    else
    {
    	p1 = _fstrchr(Buff,0)-1;
    	*p2-- = 0;
    }
    for (n=0;p1>=bp;p1--,n++)
    {   if (n == 3 && *p1 != '-')
        {   *p2--=',';
            n=0;
        }
        *p2--=*p1;
    }
    ++p2;
    _fstrcpy (InBuff,p2);
    return InBuff;
}

short   Strip(LPSTR str, char chr)
{   short   n=0;
    LPSTR strnew;
                  
    strnew = str;                 
    while (*str)
    {
        if (*str != chr)
        {            
            *strnew = *str;
            strnew++;      
        }
        else
            n++;
        str++;
    }
    *strnew='\0';
    return n;
}

void RWRITE (double RVAL, short NDP, LPSTR OutLoc) 
 
{
    char    Format[16];
            
    sprintf (Format,"%%.%if",NDP);
    sprintf (OutLoc,Format,RVAL); 
    return;
} 

double dread (LPSTR str, short nbytes)
{
    char    savechar;
    LPSTR   pSaveChar;
    double  rval;
    
    pSaveChar = str + nbytes;
    savechar = *pSaveChar;
    *pSaveChar = 0;       
    rval = atof(str);
    *pSaveChar = savechar;
    return rval;
}
        

long ldread (LPSTR str, short nbytes)
{
    char    savechar;
    LPSTR   pSaveChar;
    long    rval;
    
    pSaveChar = str + nbytes;
    savechar = *pSaveChar;
    *pSaveChar = 0;       
    rval = atol(str);
    *pSaveChar = savechar;
    return rval;
}
        
 
BOOL rread (LPSTR str, LPDOUBLE lpRval, LPINT lpNdp)
{
    LPSTR lpEnd, lpDp;
    
    *lpRval = strtod (str,&lpEnd);
    if (*lpEnd)
    	return FALSE;
    lpDp = _fstrchr (str,'.');
    if (lpDp)
        *lpNdp = lpEnd - lpDp;
    else
        *lpNdp = 0;
    return TRUE;
}
    

LPSTR ReplaceChar (LPSTR str, char from, char to)
{
    LPSTR Instr;
    
    Instr = str;
    while (*str)
    {
        if (*str == from) *str = to;
        str++;
    }
    return Instr; 
}  

LPSTR RemoveDoubleQuotes (LPSTR str)
{        
	LPSTR	EndChar=str;
	short	l;
	
	if (*str != '"')
		return str;
	l = _fstrlen (str);
	if (l < 2)
		return str;
	EndChar += l-1;
	if (*EndChar != '"')
		return str;
	l -= 2;
	if (!l)
		*str = 0;
	else
	{
		_fmemmove (str,(LPSTR)(str+1),l);
		EndChar = str+l;
		*EndChar = 0;
	}
	return str;
}

LPSTR ConvertCharBtwnDoubleQuotes (LPSTR str, char from, char to)
{   
	LPSTR	Begin, End, rtn=str;
	
Next:
	Begin = _fstrchr (str,'"'); 
	if (!Begin)
		return rtn;
	Begin++;
	End = _fstrchr (Begin,'"');
	if (!End)
		return str;
	while (Begin < End)
	{
		if (*Begin == from)
			*Begin = to;
		Begin++;
	}
	str = Begin + 1;
	goto Next;
}

short DrawRectPoly(HDC hDC, LPRECT Rect, HPEN hPen)
{
    POINT   Points[5];
    HPEN    CurPen;
    short       i;
    
    if (hPen)
        CurPen = SelectObject (hDC,hPen);
    Points[0].x = Rect->left;
    Points[0].y = Rect->bottom;
    Points[1].x = Rect->left;
    Points[1].y = Rect->top;    
    Points[2].x = Rect->right;
    Points[2].y = Rect->top;
    Points[3].x = Rect->right;
    Points[3].y = Rect->bottom; 
    Points[4] = Points[0];
    i = Polyline (hDC,Points,5);         
    if (hPen)
        SelectObject (hDC,CurPen);  
    return (i);
}  
 
void hmemmove (HPSTR out,HPSTR in,long len)
{
	while (len--)
		*out++ = *in++;   
	return;
}

void hmemset (HPSTR out,char in,long len)
{
	while (len--)
		*out++ = in;   
	return;
}

BOOL ReverseBOOL (BOOL In)
{
	if (In)
		return FALSE;
	return TRUE;
}

HGLOBAL GSSiGlobAlloc(UINT fuAlloc, long cbAlloc)
{   HGLOBAL handle;
    short	ii;

    if (cbAlloc <= 0)
   {    
        HaltMapDisplay(FALSE);
        MessageBox( 0, "Invalid memory allocation",0, MB_OK|MB_ICONEXCLAMATION);
        BlowOut(NULL,NULL);
   }
    if (cbAlloc == 2) 
    	ii=1;
    handle = GlobalAlloc (fuAlloc, (DWORD)cbAlloc);
    if (!handle)
   {    
   		HANDLE	hMess = GlobalAlloc (GMEM_MOVEABLE,128);
   		LPSTR	pMess = GlobalLock (hMess);
   		
        HaltMapDisplay(FALSE);   
        sprintf (pMess,"Error: %ld bytes",cbAlloc);
        MessageBox( 0, "Insufficient memory for this operation",pMess, MB_OK|MB_ICONEXCLAMATION);  
        GlobalUnlock (hMess);
        GlobalFree (hMess);
        PostMessage(hWndMain, WM_CLOSE, 0, 0L);  
        BlowOut(NULL,NULL);
   }
    
    return (handle);
}  

BOOL IntersectBounds (LPMNMXCORD pBounds1,LPMNMXCORD pBounds2,LPMNMXCORD pBoundsInt)
{   
	if (pBounds1->xmn > pBounds2->xmx || 
		pBounds1->ymn > pBounds2->ymx ||
		pBounds1->xmx < pBounds2->xmn ||
		pBounds1->ymx < pBounds2->ymn)
		return FALSE;
	pBoundsInt->xmn = max (pBounds1->xmn,pBounds2->xmn);
	pBoundsInt->ymn = max (pBounds1->ymn,pBounds2->ymn);
	pBoundsInt->xmx = min (pBounds1->xmx,pBounds2->xmx);
	pBoundsInt->ymx = min (pBounds1->ymx,pBounds2->ymx);
	return TRUE;
}

BOOL RectInRect(LPRECT pRectIn,LPRECT pRectTest)
{   
	RECT	IntRect;
	return IntersectRect(&IntRect,pRectIn,pRectTest);
}
     
void InflateBounds (LPMNMXCORD pBounds, double Value)
{      
	pBounds->xmn -= Value;
	pBounds->xmx += Value;
	pBounds->ymn -= Value;
	pBounds->ymx += Value;
	return;
} 

DPOINT FPointToDPoint (FPOINT point)
{
	DPOINT	DPoint;
	
	DPoint.x = point.x;
	DPoint.y = point.y;
	return DPoint;
}

FPOINT DPointToFPoint (DPOINT DPoint)
{
	FPOINT FPoint ={DPoint.x,DPoint.y};
	
	return FPoint;
}

DPOINT PointToDPoint (POINT Point)
{
	DPOINT p;
	
	p.x = Point.x;
	p.y = Point.y;
	return p;
}

POINT DPointToPoint (DPOINT Point)
{
	POINT p;
	
	p.x = max ((long)SHRT_MIN,min ((long)SHRT_MAX,IDNINT (Point.x)));
	p.y = max ((long)SHRT_MIN,min ((long)SHRT_MAX,IDNINT (Point.y)));
	return p;
}

void AddPointToRect (POINT Point,LPRECT pBounds)
{   
    pBounds->left = min (pBounds->left,Point.x);
    pBounds->right = max (pBounds->right,Point.x);
    pBounds->top = min (pBounds->top,Point.y);
    pBounds->bottom = max (pBounds->bottom,Point.y);
    return;
}

