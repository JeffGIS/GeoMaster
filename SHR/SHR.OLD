double BoundsArea (LPMNMXCORD pBounds)
{
	double Area;     
	DPOINT	Point1, Point2, Point3;
	 
	Point1.x = pBounds->xmn;
	Point1.y = pBounds->ymn;
	Point2.x = pBounds->xmn;
	Point2.y = pBounds->ymx;
	Point3.x = pBounds->xmx;
	Point3.y = pBounds->ymx;
	Area = ldistp (Point1,Point2) * ldistp (Point2,Point3); 
	return Area;
}

POINT MinMaxMidPoint (LPMINMAX pBounds)
{
	POINT point;
	
	point.x = ((long)pBounds->xmn + (long)pBounds->xmx) / 2;
	point.y = ((long)pBounds->ymn + (long)pBounds->ymx) / 2;

	return point;
}

DPOINT MinMaxMidPointD (LPMNMXCORD pBounds)
{
	DPOINT point;
	
	point.x = (pBounds->xmn + pBounds->xmx) / 2;
	point.y = (pBounds->ymn + pBounds->ymx) / 2;

	return point;
}

