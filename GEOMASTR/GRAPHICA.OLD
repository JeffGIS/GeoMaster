short	LastDayOfMonth (long systime)
{   
	long	testtime;
	struct	tm	tmtime;
	short	wantmonth, iday=32;
	
	tmtime = *localtime (&systime);
	wantmonth = tmtime.tm_mon;
	do
	{
		tmtime = *localtime (&systime);
		iday--;
		tmtime.tm_mday = iday; 
		testtime = mktime (&tmtime); 
		if (testtime < 0)
			return iday;
		tmtime = *localtime (&testtime);
	} while (tmtime.tm_mon != wantmonth); 
	return iday;
}

BOOL GoToNextControl (HWND hWndDlg,UINT FromControl,UINT ToControl)
{
	SetFocus (GetDlgItem(hWndDlg,ToControl));
	SendMessage(GetDlgItem(hWndDlg, ToControl),EM_SETSEL, 0, MAKELONG(0, -1));
	return TRUE;
} 

BOOL PointsFromLinfit (HWND hWnd, WORD Message, WORD wParam, LONG lParam,short Function)
{  
 char key;
 long			Radius;  
 POINT	MousePoint;
 
 switch (Message)
   {
   	case GF_INIT:  
	    if (!TotHLTPoints)
	    	return FALSE;
       	AddLBUTTON = FALSE;
		PostMessage(hWnd, GF_EXECUTE,0, 0L); 
   		break;
   	
   	case GF_EXECUTE:	
    {   
		hNewPolyPoints = LinfitHLTItems (&NumNewPolyPoints,Function);
	    PostMessage(hWnd, GF_CLOSE,0, 0L);
	} 
		break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

HANDLE	LinfitHLTItems (LPWORD pNumPoints,short Function)
{
	HPDPOINT	pPoints;
	short	pos=BT_FIRST;
	HANDLE	hPoints, hWeights,RtnhPoints=GSSiGlobAlloc (GMEM_MOVEABLE,2*sizeof(DPOINT));   
	HPDPOINT	pRtnPoints=(HPDPOINT)GlobalLock (RtnhPoints), pBegPoint;
	HPDOUBLE	pWeights;
	HIGHLIGHTDATA	HighlightData; 
	DPOINT	OpenEnd;  
	long	Refno, NumPoints=0, LOFMDF, i,NumNewPoints; 
	BOOL	First=TRUE, Reverse1=FALSE, Reverse2=FALSE;  
	double	D1, D2, MinD, A, B, MAXDIF, TotWeight=0, Dist;

    if (!TotHLTPoints)
    	return 0;
    hPoints = GSSiGlobAlloc (GMEM_MOVEABLE,(long)TotHLTPoints*sizeof(DPOINT)); 
    pPoints = (HPDPOINT)GlobalLock (hPoints);
    hWeights = GSSiGlobAlloc (GMEM_MOVEABLE,(long)TotHLTPoints*sizeof(double)); 
    pWeights = (HPDOUBLE)GlobalLock (hWeights);
	while (!BT_FIND (hHighlight,(LPSTR)&Refno,pos,BT_ANY,(LPSTR)&HighlightData))
	{   
		pos = BT_NEXT;
		PickList[0] = HighlightData.PD; 
		pBegPoint = pPoints;
		NumNewPoints = GetPickItemPoints (0,FALSE,&pPoints);
		if (NumNewPoints == 1)
			pPoints--;
		else
		{  
			NumPoints += NumNewPoints; 
			Dist = ldistp (*pBegPoint++,*pBegPoint);
			*pWeights++ = Dist;
			for (i=1;i<NumNewPoints-1;i++)
			{
				Dist = ldistp (*pBegPoint++,*pBegPoint);
				*pWeights = (*(pWeights-1) + Dist)/2;
				pWeights++;
			}             
			*pWeights++ = Dist;
		}
	}
	GlobalUnlock (hPoints);
	pPoints = (HPDPOINT)GlobalLock (hPoints); 
	GlobalUnlock (hWeights);
	pWeights = (HPDOUBLE)GlobalLock (hWeights); 
	*pNumPoints = 2;  
	switch (Function)
	{
		case GF_LINFIT:
		if (LINFIT (pPoints,NumPoints,&A,&B,&MAXDIF,&LOFMDF))
		{ 
			if (fabs(B) < 1)
			{
				pRtnPoints[0].x = HLTBounds.xmn;
				pRtnPoints[0].y = A + pRtnPoints[0].x * B;
				pRtnPoints[1].x = HLTBounds.xmx;
				pRtnPoints[1].y = A + pRtnPoints[1].x * B;
			}
			else
			{                                        
				pRtnPoints[0].y = HLTBounds.ymn;
				pRtnPoints[0].x = (pRtnPoints[0].y - A)/B;
				pRtnPoints[1].y = HLTBounds.ymx;
				pRtnPoints[1].x = (pRtnPoints[1].y - A)/B;
			}
		}
		else
		{
				pRtnPoints[0].y = HLTBounds.ymn;
				pRtnPoints[0].x = pPoints->x;
				pRtnPoints[1].y = HLTBounds.ymx;
				pRtnPoints[1].x = pPoints->x;
		} 
		break;
		
		default:
		{
			double AveX=0,AveY=0;
			
			for (i=0;i<NumPoints;i++,pPoints++,pWeights++)
			{
				AveX += pPoints->x * *pWeights;
				AveY += pPoints->y * *pWeights;
				TotWeight += *pWeights;
			}
			AveX /= TotWeight;
			AveY /= TotWeight;
			if (Function == GF_HORZFIT) 
			{
				pRtnPoints[0].x = HLTBounds.xmn;
				pRtnPoints[0].y = AveY;
				pRtnPoints[1].x = HLTBounds.xmx;
				pRtnPoints[1].y = AveY;
			}
			else
			{                                        
				pRtnPoints[0].y = HLTBounds.ymn;
				pRtnPoints[0].x = AveX;
				pRtnPoints[1].y = HLTBounds.ymx;
				pRtnPoints[1].x = AveX;
			}
		}
	}  
	GSSiGlobUlFree (&hWeights);
	GSSiGlobUlFree (&hPoints);
	GlobalUnlock (RtnhPoints);
	return RtnhPoints;
}

BOOL IntersectPolys1 (short Type,long nPnts1,HPDPOINT pPolyPoints1,
								 long nPnts2,HPDPOINT pPolyPoints2,
								 LPDPOINT pNearPoint,LPDPOINT pIntPoint)
{
    double   A1, A2, XP, YP, XMID1, XMID2, YMID1, YMID2, AMID,
             PAX1, PAY1, PAX2, PAY2, MNX, MNY, MXY,
             XMIDMN, XMIDMX, YMIDMN, YMIDMX, XMID2_NEED, YMID2_NEED;
    HPDPOINT	lpAreaPoints=pPolyPoints2, lpPoint;
    DPOINT	BeginPoint, BeginAreaPoint, IntPt;
    long i, iline, ibeg=0, IRC ;
	MNMXCORD Bounds1, Bounds2;
	BOOL	HavePoint = FALSE;  
	double	d, MinDist=DBL_MAX;
	
	if (Type == GF_AREA)
	{
		lpPoint = pPolyPoints1 + (nPnts1-1);
      	BeginPoint = *lpPoint;
    }
	else
	{
		ibeg = 1;    
      	BeginPoint = *pPolyPoints1++; 
    }
    for (iline = ibeg; iline < nPnts1; iline++)
    {
      if (LDIST (BeginPoint.x,BeginPoint.y,pPolyPoints1->x,pPolyPoints1->y) < P_TOL)
      	goto S200; 
      A2 = getazd (&BeginPoint,pPolyPoints1);
      DBoundsInit (&Bounds1);
	  AddDPointToMinMax (&BeginPoint,&Bounds1);
	  AddDPointToMinMax (pPolyPoints1,&Bounds1);
	  ExpandBounds (&Bounds1,P_TOL);

      lpPoint = lpAreaPoints + (nPnts2-1);
      BeginAreaPoint = *lpPoint;
      lpPoint = lpAreaPoints;
      for (i = 0; i <nPnts2; i++,lpPoint++)
      {
/*C******* LOOK ONLY FOR INTERSECTIONS WITH X LE XP  */
	      DBoundsInit (&Bounds2);
		  AddDPointToMinMax (&BeginAreaPoint,&Bounds2);
		  AddDPointToMinMax (lpPoint,&Bounds2); 
		  ExpandBounds (&Bounds2,P_TOL);
		  if (BoundsInBounds (&Bounds1,&Bounds2,1))
		  {
	          A1 = getazd (&BeginAreaPoint,lpPoint);
	          IRC = LIN_SEC (BeginAreaPoint.x,BeginAreaPoint.y,A1,
	          				 BeginPoint.x,BeginPoint.y, A2,
	          				 &IntPt.x, &IntPt.y);
/*C******* IGNORE PARALLEL LINES */
          	  if (IRC != 0)
          	  	goto S100; 
			  if (DPointInBounds (&IntPt,&Bounds1) && DPointInBounds (&IntPt,&Bounds2)) 
			  {
			  	if (!pIntPoint)
			  		return TRUE; 
			  	HavePoint = TRUE;
			  	d = ldistp (IntPt,*pNearPoint);
			  	if (d < MinDist)
			  	{
          	  		*pIntPoint = IntPt;
			  		MinDist = d;
			  	}
			  }	
		  }
S100:     BeginAreaPoint = *lpPoint;
      } 
S200:
      	BeginPoint = *pPolyPoints1++; 
	} 
	return HavePoint;
} 

short IntersectPolys2 (long nPnts1,HPDPOINT pPolyPoints1,
					  long nPnts2,HPDPOINT pPolyPoints2,
					  double FromDist1,LPDOUBLE pIntDist,LPDPOINT pIntPoint,
					  LPDOUBLE	pInAZ, LPDOUBLE OutAZ,LPSHORT OutReverseDir,LPSHORT WhichPoly)
{
    double   A1, A2, XP, YP, XMID1, XMID2, YMID1, YMID2, AMID,
             PAX1, PAY1, PAX2, PAY2, MNX, MNY, MXY,
             XMIDMN, XMIDMX, YMIDMN, YMIDMX, XMID2_NEED, YMID2_NEED;
    HPDPOINT	lpPoint;
    DPOINT	BeginPoint, BeginPoint2, IntPt;
    long i, iline, ibeg=0, IRC, NumLines=nPnts1-1 ;
	MNMXCORD Bounds1, Bounds2;
	BOOL	HavePoint = FALSE;  
	double	d, MinDist=DBL_MAX, d1=0, d2=0,seglen;
	short	nOutAZ=0;
	
	pIntDist[0] = DBL_MAX;
	BeginPoint = *pPolyPoints1++;
    for (iline = 0; iline < NumLines; iline++)
    { 
      seglen = ldistp (BeginPoint,*pPolyPoints1);	
      if (d1 + seglen <= FromDist1)
      	goto S200;
      if (LDIST (BeginPoint.x,BeginPoint.y,pPolyPoints1->x,pPolyPoints1->y) < P_TOL)
      	goto S200; 
      A2 = getazd (&BeginPoint,pPolyPoints1);
      DBoundsInit (&Bounds1);
	  AddDPointToMinMax (&BeginPoint,&Bounds1);
	  AddDPointToMinMax (pPolyPoints1,&Bounds1);
	  ExpandBounds (&Bounds1,P_TOL);

      lpPoint = pPolyPoints2;
      BeginPoint2 = *lpPoint++;
      d2 = 0;
      for (i = 0; i <nPnts2-1; i++,lpPoint++)
      {
	      DBoundsInit (&Bounds2);
		  AddDPointToMinMax (&BeginPoint2,&Bounds2);
		  AddDPointToMinMax (lpPoint,&Bounds2); 
		  ExpandBounds (&Bounds2,P_TOL);
		  if (BoundsInBounds (&Bounds1,&Bounds2,1))
		  {
	          A1 = getazd (&BeginPoint2,lpPoint);
	          IRC = LIN_SEC (BeginPoint2.x,BeginPoint2.y,A1,
	          				 BeginPoint.x,BeginPoint.y, A2,
	          				 &IntPt.x, &IntPt.y);
			  if (IRC == 2)
			  { 
			  	IRC = 0;
			  	if (ldistp (BeginPoint,BeginPoint2) < P_TOL)
			  		IntPt = BeginPoint;
			  	else if (ldistp (BeginPoint,*lpPoint) < P_TOL)
			  		IntPt = BeginPoint;	
			  	else if (ldistp (*pPolyPoints1,BeginPoint2) < P_TOL)
			  		IntPt = *pPolyPoints1;
			  	else if (ldistp (*pPolyPoints1,*lpPoint) < P_TOL)
			  		IntPt = *pPolyPoints1;	
			  	else
			  		IRC = 2;
			  }
			  		
          	  if (IRC != 0)  goto S100; 
			  if (DPointInBounds (&IntPt,&Bounds1) && DPointInBounds (&IntPt,&Bounds2)) 
			  {
			  	HavePoint = TRUE;
			  	d = ldistp (IntPt,BeginPoint);
			  	if (d + d1 >FromDist1+P_TOL && d + d1 + P_TOL <= pIntDist[0])
			  	{   
			  		*pInAZ = getazd (&BeginPoint,&IntPt);
			  		nOutAZ = 0;
          	  		*pIntPoint = IntPt;
			  		pIntDist[0] = d + d1;
			  		pIntDist[1] = ldistp (IntPt,BeginPoint2) + d2;
			  		if (ldistp (IntPt,BeginPoint2) > P_TOL)
			  		{
			  			OutAZ[nOutAZ] = getazd (&IntPt,&BeginPoint2);
			  			WhichPoly[nOutAZ] = 1;
			  			OutReverseDir[nOutAZ++] = TRUE;   
			  		}
			  		if (ldistp (IntPt,*lpPoint) > P_TOL)
			  		{
			  			OutAZ[nOutAZ] = getazd (&IntPt,lpPoint);
			  			WhichPoly[nOutAZ] = 1;
			  			OutReverseDir[nOutAZ++] = FALSE;
			  		} 
			  		else if (i+1 <nPnts2-1)
			  		{
			  			OutAZ[nOutAZ] = getazd (&IntPt,(HPDPOINT)(lpPoint+1));
			  			WhichPoly[nOutAZ] = 1;
			  			OutReverseDir[nOutAZ++] = FALSE;
			  		}
			  		if (ldistp (IntPt,*pPolyPoints1) > P_TOL)
			  		{
			  			OutAZ[nOutAZ] = A2;
			  			WhichPoly[nOutAZ] = 0;
			  			OutReverseDir[nOutAZ++] = FALSE;
			  		}
			  		else if (iline+1 < NumLines)
			  		{
			  			OutAZ[nOutAZ] = getazd (pPolyPoints1,(HPDPOINT)(pPolyPoints1+1));
			  			WhichPoly[nOutAZ] = 0;
			  			OutReverseDir[nOutAZ++] = FALSE;
			  		}
			  	}
			  }	
		  }
S100:     d2 += ldistp (BeginPoint2,*lpPoint);
		  BeginPoint2 = *lpPoint;
		  if (nOutAZ)
		  	return nOutAZ;
      } 
S200:   
		d1 += ldistp (BeginPoint,*pPolyPoints1);
      	BeginPoint = *pPolyPoints1++; 
	} 
	return nOutAZ;
} 

void SnapPolyPoints (long nPnts,HPDPOINT pPoints, double SnapTol)
{   
	DWORD	i,j;
	
	for (i=1;i<nPnts;i++)
		for (j=0;j<i;j++)
		if (ldistp (pPoints[i],pPoints[j]) <= SnapTol)
		{
			pPoints[i] = pPoints[j];
			break;
		}
	return;
}

BOOL RemoveDupPolyPoints (LPLONG pnPnts,HPDPOINT pPoints, double Tol)
{   
	DWORD	i,j;
	long	NewnPnts=0;
	
	for (i=1;i<*pnPnts;i++)
		if (ldistp (pPoints[i],pPoints[NewnPnts]) > Tol)
		{   
			NewnPnts++;
			pPoints[NewnPnts] = pPoints[i];
		}
	NewnPnts++; 
	if (*pnPnts == NewnPnts)
		return FALSE;
	*pnPnts = NewnPnts;
	return TRUE;
}

short PolyCrossesItself (short wantcross,long nPnts,HPDPOINT pPoints,LPDPOINT pIntPoint)
{   
	// returns
	//	0 - no cross
	//	1 - line intersection found
	//	2 - line on top of another but not equeal
	//	3 - dup lines (probably link line)
    double   A1, A2, XP, YP, XMID1, XMID2, YMID1, YMID2, AMID,
             PAX1, PAY1, PAX2, PAY2, MNX, MNY, MXY,
             XMIDMN, XMIDMX, YMIDMN, YMIDMX, XMID2_NEED, YMID2_NEED;
    HPDPOINT	pPolyPoints2, lpPoint, pPointNew;
    DPOINT	BeginPoint, BeginAreaPoint, IntPt;
    long i, iline, ibeg=0, IRC ;
	MNMXCORD Bounds1, Bounds2;
	double	d, MinDist=DBL_MAX;  
	short	nCross=0;   
	HANDLE	hTemp=0;
	
	SnapPolyPoints (nPnts,pPoints,GetGlobalDVal2 ("[%SNAPPOLYTOL]",0));
	if (ldistp (pPoints[0],pPoints[nPnts-1]) > P_TOL)
	{
		hTemp = GSSiGlobAlloc (GMEM_MOVEABLE,(nPnts+1)*sizeof(DPOINT));
		pPointNew = (HPDPOINT)GlobalLock (hTemp);
		hmemmove ((HPSTR)pPointNew,(HPSTR)pPoints,nPnts*sizeof(DPOINT));
		pPointNew[nPnts++] = *pPoints;
		pPoints = pPointNew;
	}
    for (iline = 0; iline < nPnts-2; iline++)
    {
		if (LDIST (pPoints[iline].x,pPoints[iline].y,pPoints[iline+1].x,pPoints[iline+1].y) < P_TOL)
			goto S200; 
		A2 = getazd (&pPoints[iline],&pPoints[iline+1]);
		DBoundsInit (&Bounds1);
		AddDPointToMinMax (&pPoints[iline],&Bounds1);
		AddDPointToMinMax (&pPoints[iline+1],&Bounds1);
		ExpandBounds (&Bounds1,P_TOL);

		for (i = iline+1; i <nPnts-1; i++)
		{
	      DBoundsInit (&Bounds2);
		  AddDPointToMinMax (&pPoints[i],&Bounds2);
		  AddDPointToMinMax (&pPoints[i+1],&Bounds2);
		  ExpandBounds (&Bounds2,P_TOL);
		  if (BoundsInBounds (&Bounds1,&Bounds2,1))
		  {
				if (LinesEqual (pPoints,iline,iline+1,i,i+1))
				{
			  		nCross++;
          			*pIntPoint = MidPointD (pPoints[i],pPoints[i+1]);
			  		if (nCross >= wantcross) 
			  		{
			  			GSSiGlobUlFree (&hTemp);
			  			return 3;               
			  		}
			 	}
			  	else
			  	{
		        	A1 = getazd (&pPoints[i],&pPoints[i+1]);
		        	IRC = LIN_SEC (pPoints[i].x,pPoints[i].y,A1,
		         				   pPoints[iline].x,pPoints[iline].y,A2,
		          				   &IntPt.x, &IntPt.y);

	          		if (IRC ==  2)
	          		{
				 		if ( ((i == iline + 1) && !DPointInBounds (&pPoints[i+1],&Bounds1) && !DPointInBounds (&pPoints[iline],&Bounds2)  ||
				 			 ((i== nPnts -2) && !iline) && !DPointInBounds (&pPoints[i],&Bounds1) && !DPointInBounds (&pPoints[iline+1],&Bounds2)) )
				 			 ;
				 		else
				 		{
		          			nCross++; 
		          			*pIntPoint = MidPointD (pPoints[i],pPoints[i+1]);
					  		if (nCross >= wantcross)
					  		{
					  			GSSiGlobUlFree (&hTemp);
					  			return 2;
					  		}
					  	}
				  	} 
				  	else if (!IRC)
					 	if (DPointInBounds (&IntPt,&Bounds1) && DPointInBounds (&IntPt,&Bounds2)) 
					 	{   
					 		if (!( (ldistp (IntPt,pPoints[i]) < P_TOL || ldistp (IntPt,pPoints[i+1]) < P_TOL) &&
					 			   (ldistp (IntPt,pPoints[iline]) < P_TOL || ldistp (IntPt,pPoints[iline+1]) < P_TOL)))
					 		{   
					 			BOOL	IntIsOK=FALSE;
					 			
					 			if (hPolyPartLen)
					 			{
					 				LPWORD	pPartLen = (LPWORD)GlobalLock (hPolyPartLen); 
					 				long	PointID=-1;
					 				short	ip;
					 				
					 				for (ip = 0; ip < nPoly; ip++,pPartLen++)  
					 				{   
					 					PointID += *pPartLen;
					 					if (ip>1)
					 						PointID++;
					 					if (PointID == i || PointID == iline)
					 						IntIsOK = TRUE;
					 				}
									GlobalUnlock (hPolyPartLen);
                                } 
                                if (!IntIsOK)
                                {
				          			nCross++; 
							  		if (nCross >= wantcross)  
							  		{
			          	  				*pIntPoint = IntPt;
								  		GSSiGlobUlFree (&hTemp);
						  				return 1; 
						  			}
						  		}
					 	 	}
						}
				}
				
		  }
      } 
S200:;
	} 
	GSSiGlobUlFree (&hTemp);
	return 0;
} 


BOOL FAR PASCAL DATELIMITSMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 
	char	str[128], year[8], month[4], day[4];
	long	systime;
	static	long	Begtime, Endtime;
	LPSTR	lpEnd, pTAB;	
	struct	tm	tmtime;
	int		TabStops[3]={1000,1100};
	short	nchar, iday, Choice, sub;
	static	HANDLE	hSaveBM=0;
	
 short  BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
        cwCenter(hWndDlg, 0);
        hSaveBM = EnterBlockingWindow (hWndDlg);
      	SendDlgItemMessage (hWndDlg,IDC_DATERANGES,LB_SETTABSTOPS,2,(LPARAM)&TabStops); 
    	Begtime = TimeRangeBeg;
    	Endtime = TimeRangeEnd;  
       	GetCurVal (str,sizeof(str),IDS_FILEDATERANGES); 
        FillList (hWndDlg,IDC_DATERANGES,str,0);
    case GSSI_REINITDIALOG:  
    
		if (TimeRangeBeg > 0)	
		{			
			tmtime = *localtime (&TimeRangeBeg);  
			if (tmtime.tm_year > 99)
				sub=100;
			else
				sub=0; 
			sprintf (str,"%2.2i",tmtime.tm_year-sub);
			SetDlgItemText (hWndDlg,IDC_FROMYEAR,str);
			sprintf (str,"%2.2i",tmtime.tm_mon+1);
			SetDlgItemText (hWndDlg,IDC_FROMMONTH,str);
			sprintf (str,"%2.2i",tmtime.tm_mday);
			SetDlgItemText (hWndDlg,IDC_FROMDAY,str);
		}
		if (TimeRangeEnd == LONG_MAX)	
		 	break;   
			tmtime = *localtime (&TimeRangeEnd); 
			if (tmtime.tm_year > 99)
				sub=100;
			else
				sub=0; 
			sprintf (str,"%2.2i",tmtime.tm_year-sub);
			SetDlgItemText (hWndDlg,IDC_TOYEAR,str); 
			sprintf (str,"%2.2i",tmtime.tm_mon+1);
			SetDlgItemText (hWndDlg,IDC_TOMONTH,str);
			sprintf (str,"%2.2i",tmtime.tm_mday);
			SetDlgItemText (hWndDlg,IDC_TODAY,str);
			
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
    	 PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:  
    	 if (HIWORD(lParam) == EN_CHANGE && wParam != IDC_DATERANGES)  
    	 {
	         nchar = GetDlgItemText(hWndDlg,wParam,str,8);
	    	 switch (wParam)
	    	 {
	    	 	case IDC_FROMYEAR: 
	    	 		if (nchar == 2)
	    	 			GoToNextControl (hWndDlg,wParam,IDC_FROMMONTH);
	    	 		break;
	    	 	case IDC_FROMMONTH:
	    	 		if (nchar == 2)
	    	 			GoToNextControl (hWndDlg,wParam,IDC_FROMDAY);
	    	 		break;
	    	 	case IDC_FROMDAY:
	    	 		if (*str == 'l' || *str == 'L')
	    	 		{
						tmtime = *localtime (&Begtime); 
						tmtime.tm_mday = LastDayOfMonth(Begtime); 
			    		TimeRangeBeg = mktime (&tmtime); 
		       	 		sprintf (str,"%2.2i",tmtime.tm_mday);
		       	 		SetDlgItemText (hWndDlg,IDC_FROMDAY,str);
	    	 		}
	    	 		if (nchar == 2)
	    	 			GoToNextControl (hWndDlg,wParam,IDC_TOYEAR);
	    	 		break;
	    	 	case IDC_TOYEAR:
	    	 		if (nchar == 2)
	    	 			GoToNextControl (hWndDlg,wParam,IDC_TOMONTH);
	    	 		break;
	    	 	case IDC_TOMONTH:
	    	 		if (nchar == 2)
	    	 			GoToNextControl (hWndDlg,wParam,IDC_TODAY);
	    	 		break;
	    	 	case IDC_TODAY:
	    	 		if (*str == 'l' || *str == 'L')
	    	 		{
						tmtime = *localtime (&Endtime); 
						tmtime.tm_mday = LastDayOfMonth(Endtime); 
			    		TimeRangeEnd = mktime (&tmtime); 
		       	 		sprintf (str,"%2.2i",tmtime.tm_mday);
		       	 		SetDlgItemText (hWndDlg,IDC_TODAY,str);
	    	 		}
	    	 		if (nchar == 2)
	    	 			SetFocus (GetDlgItem(hWndDlg,IDOK));
	    	 		break;
	    	 }
	     }	 
         switch(wParam)
         {  
            case IDC_DATERANGES: /* List box                              */
              {
                switch(HIWORD(lParam))
                    {
                     case LBN_DBLCLK:  
				    	PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
                     	break;
                     case LBN_SELCHANGE:
		                  Choice=SendDlgItemMessage(hWndDlg,IDC_DATERANGES,
												    LB_GETCURSEL,NULL,NULL); 
		         		  SendDlgItemMessage(hWndDlg,IDC_DATERANGES,LB_GETTEXT,
		         		  					 Choice,(DWORD)&str); 
		         		  if ((pTAB = _fstrchr (str,'\t')))
		         		  {
			         		  *pTAB++ = 0;
			         		  sscanf (pTAB,"%ld %ld",&TimeRangeBeg,&TimeRangeEnd);
				       	 	  PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
				       	  }
		         	}
		    }
		    	break;
		    	
         	case IDC_DATE_ADD: 
         		*str = 0;
           		if (GetTextString (hWndDlg,str,64,"Enter new date identifier",NULL,NULL,0))
           		{   
           			char	Name[144]; 
           			HFILE	Fid;
           			OFSTRUCT	OFStruct;
           			
			       	GetCurVal (Name,sizeof(Name),IDS_FILEDATERANGES);
			       	if (!ExistFile (Name)) 
			       		Fid = GSSiOpenFile (Name,&OFStruct,OF_CREATE); 
					sprintf (_fstrchr (str,0),"|%ld %ld",Begtime,Endtime);			       		
			       	AppendFile (Name,str);
        			FillList (hWndDlg,IDC_DATERANGES,Name,0);
           		}
         		break;
         		
         	case IDC_DATE_REMOVE: 
            {
            	 short	Item;
            	 
                 Item = SendDlgItemMessage((HWND) hWndDlg, IDC_DATERANGES, LB_GETCURSEL,0,0);
                 if (Item != LB_ERR)
	         	 	SendDlgItemMessage(hWndDlg,IDC_DATERANGES,LB_DELETESTRING,Item,0);
			}
         		break;
         		
         	case IDC_DATE_TODAY:  
         		time (&systime);
				tmtime = *localtime (&systime);  
	    		TimeRangeBeg = TimeRangeEnd = mktime (&tmtime);  
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_YESTERDAY:  
         		time (&systime);
         		systime -= (60L * 60L * 24L);
				tmtime = *localtime (&systime);  
	    		TimeRangeBeg = TimeRangeEnd = mktime (&tmtime);  
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_THISMONTH:  
         		time (&systime);
				tmtime = *localtime (&systime); 
				tmtime.tm_mday = 1; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mday = LastDayOfMonth(TimeRangeBeg); 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_LASTMONTH:  
         		time (&systime);
				tmtime = *localtime (&systime); 
				tmtime.tm_mday = 1; 
	    		systime = mktime (&tmtime) - (60L * 60L * 24L * 15L); 
				tmtime = *localtime (&systime); 
				tmtime.tm_mday = 1; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mday = LastDayOfMonth(TimeRangeBeg); 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_THISYEAR:  
         		time (&systime);
				tmtime = *localtime (&systime); 
				tmtime.tm_mon = 0; 
				tmtime.tm_mday = 1; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mon = 11; 
	    		TimeRangeEnd = mktime (&tmtime); 
				tmtime.tm_mday = LastDayOfMonth(TimeRangeEnd); 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_LASTYEAR:  
         		time (&systime);
				tmtime = *localtime (&systime); 
				tmtime.tm_mon = 0; 
				tmtime.tm_mday = 1; 
         		systime = mktime (&tmtime) - (60L * 60L * 24L * 182L); 
				tmtime = *localtime (&systime); 
				tmtime.tm_mon = 0; 
				tmtime.tm_mday = 1; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mon = 11; 
	    		TimeRangeEnd = mktime (&tmtime); 
				tmtime.tm_mday = LastDayOfMonth(TimeRangeEnd); 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_THISWEEK:  
         		time (&systime);
				tmtime = *localtime (&systime); 
				tmtime.tm_mday -= tmtime.tm_wday; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mday += 6; 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
         	case IDC_DATE_LASTWEEK:  
         		time (&systime); 
         		systime -= (60L * 60L * 24L * 7L);
				tmtime = *localtime (&systime); 
				tmtime.tm_mday -= tmtime.tm_wday; 
	    		TimeRangeBeg = mktime (&tmtime); 
				tmtime.tm_mday += 6; 
	    		TimeRangeEnd = mktime (&tmtime); 
       	 		PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
         		break;
         		
            case IDC_FROMYEAR:  
            case IDC_FROMMONTH:
            case IDC_FROMDAY:
                 if (HIWORD(lParam) ==  EN_KILLFOCUS)
                 { 
                 	if (!GetDlgItemText (hWndDlg,IDC_FROMYEAR,year,5))
                 	{
//                 		GoToNextControl (hWndDlg,IDC_FROMYEAR,IDC_FROMYEAR); 
                 		break;
                 	} 
                 	if (!GetDlgItemText (hWndDlg,IDC_FROMMONTH,month,3))
                 		break;
                 	GetDlgItemText (hWndDlg,IDC_FROMDAY,day,3);
                 	sprintf (str,"$CLK(%s-%s-1 00:00:00,1)",year,month); 
                 	ExpandText (str);
                 	systime = atol (str); 
                 	iday = atoi (day);
                 	iday = max (1,min (iday,LastDayOfMonth(systime)));
                 	sprintf (str,"$CLK(%s-%s-%i 00:00:00,1)",year,month,iday); 
                 	ExpandText (str);
                 	Begtime = atol (str);
                 	_fstrcpy (str,ctime(&Begtime));
                 	lpEnd = _fstrchr (str,0);
                 	lpEnd--;
                 	*lpEnd = 0;
                 	SetDlgItemText (hWndDlg,IDC_FROMDATETEXT,str);
                 }
            break;
            case IDC_TOYEAR:  
                 if (HIWORD(lParam) ==  EN_KILLFOCUS)
                 { 
                 	if (!GetDlgItemText (hWndDlg,IDC_TOYEAR,year,5))
                 	{
                 		GetDlgItemText (hWndDlg,IDC_FROMYEAR,year,5);
                 		SetDlgItemText (hWndDlg,IDC_TOYEAR,year);
                 	} 
                 	goto ShowToDate; 
                 }
                 break;
            case IDC_TOMONTH:
                 if (HIWORD(lParam) ==  EN_KILLFOCUS)
                 { 
            
                 	if (!GetDlgItemText (hWndDlg,IDC_TOMONTH,month,3))
                 	{
                 		GetDlgItemText (hWndDlg,IDC_FROMMONTH,month,3);
                 		SetDlgItemText (hWndDlg,IDC_TOMONTH,month);
                 	}
                 	goto ShowToDate;  
                 }
                 break;
            case IDC_TODAY:
                 if (HIWORD(lParam) ==  EN_KILLFOCUS)
                 { 
                 	if (!GetDlgItemText (hWndDlg,IDC_TODAY,day,3))
                 	{
                 		GetDlgItemText (hWndDlg,IDC_FROMDAY,day,3);
                 		SetDlgItemText (hWndDlg,IDC_TODAY,day);
                 	}
                 	goto ShowToDate;  
                 }
                 break;
         ShowToDate:
               		GetDlgItemText (hWndDlg,IDC_TOYEAR,year,5);
               		GetDlgItemText (hWndDlg,IDC_TOMONTH,month,3);
               		GetDlgItemText (hWndDlg,IDC_TODAY,day,3);
                 	sprintf (str,"$CLK(%s-%s-1 00:00:00,1)",year,month); 
                 	ExpandText (str);
                 	systime = atol (str);
                 	iday = atoi (day);
                 	iday = max (1,min (iday,LastDayOfMonth(systime)));
                 	sprintf (str,"$CLK(%s-%s-%i 23:59:59,1)",year,month,iday); 
                 	ExpandText (str);
                 	Endtime = atol (str);
                 	_fstrcpy (str,ctime(&Endtime));
                 	lpEnd = _fstrchr (str,0);
                 	lpEnd--;
                 	*lpEnd = 0;
                 	SetDlgItemText (hWndDlg,IDC_TODATETEXT,str);
            	break;
            case IDCANCEL: 
                GSSiEndDialog(hWndDlg, FALSE,hSaveBM);
            break;      
            
            case IDC_REMOVE_DATE:
            	TimeRangeBeg = 0;
            	TimeRangeEnd = LONG_MAX;
                GSSiEndDialog(hWndDlg, TRUE,hSaveBM);
            	break;
            
            case IDOK: 
             	if (!GetDlgItemText (hWndDlg,IDC_FROMYEAR,year,5))
             		break;
             	if (!GetDlgItemText (hWndDlg,IDC_FROMMONTH,month,3))
             		break;
             	if (!GetDlgItemText (hWndDlg,IDC_FROMDAY,day,3))
             		break; 
             	sprintf (str,"$CLK(%s-%s-%s 00:00,1)",year,month,day); 
             	ExpandText (str);
             	TimeRangeBeg = atol (str);
             	if (!GetDlgItemText (hWndDlg,IDC_TOYEAR,year,5))
             		break;
             	if (!GetDlgItemText (hWndDlg,IDC_TOMONTH,month,3))
             		break;
             	if (!GetDlgItemText (hWndDlg,IDC_TODAY,day,3))
             		break; 
             	sprintf (str,"$CLK(%s-%s-%s 23:59:59,1)",year,month,day); 
             	ExpandText (str);
             	TimeRangeEnd = atol (str); 
             	if (TimeRangeBeg > TimeRangeEnd)
             	{   
             		GMMessageBox (MSG_DATERANGE,0,MB_ICONEXCLAMATION);
             		break;
             	}
                GSSiEndDialog(hWndDlg, TRUE,hSaveBM);
         		break;
            
         }
         break;   

    default:
        return FALSE;
   }
 return TRUE;
}
  
BOOL UpdateDateRange (HPSTR buf, long len, LPLONG MinTime, LPLONG MaxTime)
{   
	HPSHORT	ipnt;
	long	Offset;
	short	i, SymNum=0;
	LPBYTE	Pcode; 
	HPSTR	EndLoc;
	LPINT	pItemLen; 

    EndLoc = buf+len;
    ipnt = (HPSHORT)EndLoc;
    *ipnt = 0;
    ipnt = (HPSHORT)buf;  
    Pcode = (LPBYTE)ipnt;
    if (*Pcode != 12)
    	return FALSE; 
	CurElementType = 0;
    while (*ipnt != 0)
    {   
    	Pcode = (LPBYTE)ipnt;
    	ipnt++;

	    switch (*Pcode)
        {   
            case 8:	/*	description */
	 		{   
	 		    ConvertSymbol (ipnt); 
	 		    CreateFileSymList (ipnt);
	 			SymNum = *ipnt;
	 			ipnt++;
	 		}
	 		break;
	 		
		    case 9:	/*	refno	*/
		    {   
		    	short ii, ltag;   
		    	static	long	debugrefno=1591435;
	           	LPLONG	pRefno =(LPLONG) ipnt;

	           	if (*pRefno == debugrefno)
	           		ii=1;  
	           	if (ReReference)
	           		*pRefno = GetNewRefno(PltName,NULL,NULL,NULL,NULL); 
	           	CurrentRefno = LastRef = *pRefno; 
	        	ipnt += 2; 
	        	ltag = *++Pcode;
	        	if (ltag) 
	        	{   LPSTR	lpTAG;
	                	
	        		lpTAG = (LPSTR)ipnt;
					ipnt = (LPINT) (lpTAG + ltag + ltag%2);
				}  
		    }
		    break;
	
			case 37: 
			{
				long	StartTime, EndTime;
					
				StartTime = *(LPLONG)ipnt;
				ipnt+=2;
				EndTime = *(LPLONG)ipnt;
				ipnt+=2; 
				*MinTime = min (StartTime,*MinTime);
				*MaxTime = max (EndTime,*MaxTime);
			}
			break;
            
            default: 
				SkipSubRec (Pcode,&ipnt);
            break;

        } 
    } 
    if (hSetNewSymType)
    {   
    	LPSHORT	pNum=(LPSHORT)GlobalLock (hSetNewSymType);
    	
    	while (*pNum)
    	{    
    		if (*pNum == SymNum)
    		{
		    	switch (CurElementType)
		    	{
		    		case GF_POINT: 
		    			pNum++;
		    			(*pNum)++;
		    		break;
		    		
		    		case GF_LINE:
		    		case GF_POLYLINE:
		    		case GF_CURVE:
		    			pNum += 2;
		    			(*pNum)++;
		    		break;
		    		
		    		case GF_AREA:
		    			pNum += 3;
		    			(*pNum)++;
		    		break;
		    	}  
		    	break;
		    }         
		    pNum += 4;
	    }
    	GlobalUnlock (hSetNewSymType);
    }
	return TRUE;
}  

BOOL CreateAreaGrid (LPSTR File,LPSTR Symbol,double Dist)
{
	short  NumSyms=0, AreaSym;  
	WORD	np=5;
	HANDLE hSymDesc=0, hPoly; 
	long	NewRefno; 
	long	nRows, nCols, iRow, iCol; 
	HPDPOINT	pPoly, pPoly0;
    
    _fstrcpy (PltName,File);
	if (!OpenMap (CurView->hWnd,CurView->hDC))
		return FALSE;
	if (!(AreaSym = GetDictSymbolNumber (Symbol)))
		return FALSE;
	AddToSymList (AreaSym,&NumSyms,&hSymDesc);
	EditBounds = CurView->FileMNMX; 
	CloseMap (FALSE);
	nCols = 1 + (EditBounds.xmx - EditBounds.xmn) / Dist;
	nRows = 1 + (EditBounds.ymx - EditBounds.ymn) / Dist; 
	hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,5*sizeof(DPOINT));
	for (iRow = 0;iRow < nRows;iRow++)
	{
		for (iCol = 0; iCol < nCols; iCol++)
		{
			pPoly = pPoly0 = (HPDPOINT)GlobalLock (hPoly);  
			pPoly->x = EditBounds.xmn + iCol * Dist;
			pPoly++->y = EditBounds.ymn + iRow * Dist;
			pPoly->x = EditBounds.xmn + iCol * Dist;
			pPoly++->y = EditBounds.ymn + (iRow+1) * Dist;
			pPoly->x = EditBounds.xmn + (iCol+1) * Dist;
			pPoly++->y = EditBounds.ymn + (iRow+1) * Dist;
			pPoly->x = EditBounds.xmn + (iCol+1) * Dist;
			pPoly++->y = EditBounds.ymn + iRow * Dist;
			*pPoly = *pPoly0;
			GlobalUnlock (hPoly);
			NewRefno = GetNewRefno(PltName,NULL,NULL,NULL,NULL);
            AddPolyToMap (1,&np, &hPoly,0,NewRefno,NULL,-1,AreaSym,NULL,NULL,NULL,
                            -1,-1,0,0,0,0,0,TRUE);
		}
	} 
	CloseMap(TRUE);
	AddSymToMap (NumSyms,hSymDesc,0,NULL); 
	DestroySymList (&NumSyms,&hSymDesc);    
	GSSiGlobFree (&hPoly);
	return TRUE;
} 

void OpenDisplayedRefs(void)
{	BTVARDESC	BTVar[2]; 
	char	File[144]; 

	CloseDisplayedRefs();
	GetTempFileName(0,"gm",0,File);
	BTVar[0].BT_VARTYP=BT_INTEGER;
	BTVar[0].BT_VARLEN=4;
	BTVar[0].BT_VAROFF=0;
	BT_CREATE (File, 2, FALSE, 1, 1,(LPBTVARDESC)BTVar,FALSE, 0, 0, FALSE);
	hDisplayedRefs = BT_OPEN (File, 0, BT_WRITE, 0);
	return;
}

void CloseDisplayedRefs(void)
{   
	BT_CLOSEANDDELETE (&hDisplayedRefs);
	return;
} 

int	GetSymbolNum (LPSTR Name)
{
	LPVISLIST	SaveVis;
	int			l;
	
	if (AlwaysUseSymDict)
		return GetDictSymbolNumber (Name);
	CurrentSymNum = 0;
	_fstrcpy(CurrentSymName,Name);
	GetVisList (NULL,-9999,NULL,NULL,-1);
	return (CurrentSymNum);
} 
 
BOOL GetSymbolName (int Desc, LPSTR Name,LPSHORT pParent, short From, LPSHORT pIsPar)
{
	static		int		LastDesc=-1, LastIsPar, LastParent;
	static		char	LastName[34]; 
	OFSTRUCT	OFStruct;
    short       Signature;   
    long   		PrimeOffset;
	
	if (From != 2 && AlwaysUseSymDict)
	{
		HANDLE	hSymbol;
		LPSYMBOL pSymbol; 
		
		hSymbol = GetDictSymDesc (Desc);
		if (hSymbol)
		{ 
			pSymbol = (LPSYMBOL)GlobalLock (hSymbol);  
			_fstrcpy (Name,pSymbol->Name);  
			if (pParent)
				*pParent = pSymbol->Parent;
			if (pIsPar) 
			{
				if (!pSymbol->Type)
					*pIsPar = 1; 
				else
					*pIsPar = 0; 
			}
	     	GlobalUnlock (hSymbol); 
			DestroySymbol (hSymbol); 
			return TRUE;
		} 
		else
			return FALSE;
	}
	if (!CurView)
		SetCurView (pViewports[CommandViewport-1]);
	CurrentSymParent = 0; 
	CurSymIsParent = FALSE;
	*CurrentSymName=0;
	if (From == 2) //get from edit file
	{
	    DuplicateDescInit();
        CloseMap (FALSE);  
        _fstrcpy (PltName,EditName);
        Fid = GSSiOpenFile (PltName,(LPOFSTRUCT)&OFStruct,OF_READ); 
        if (Fid != HFILE_ERROR)
        {
		    _llseek(Fid,(LONG)-(6),2);
		    _lread (Fid,&Signature,2);
		    if (Signature == 32349)
		    {  
		    	BYTE	MV;
		    	
			    _lread (Fid,&MV,1);  
			    MapVersion = MV;
                _llseek(Fid,(LONG)-(6+12),2);
                _lread (Fid,&PrimeOffset,4);
                _llseek(Fid,PrimeOffset,0);
                ProcessPrimarySeg (0, 0, 0,FALSE);
                _llseek(Fid,UsedDescOffset,0);
                ProcessPrimarySeg (0,-Desc,NULL,FALSE); 
            }
            GSSiClose (Fid); 
        }
        Fid = -1;
	    DuplicateDescClose(); 
	    goto Exit;
	}
	if (Desc == LastDesc && LastName[0])
	{
		_fstrcpy (Name,LastName); 
		if (pParent)
			*pParent = LastParent; 
		if (pIsPar)
			*pIsPar = LastIsPar; 
		return TRUE;
	}
	{
		HANDLE	hVis=GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(VISLIST));
		LPVISLIST	SaveVis=CurVis;
		
		CurVis = (LPVISLIST)GlobalLock (hVis);
		if (SaveVis)
			*CurVis = *SaveVis;
		else
			InitVis ();
		if (From >= 0)
		{
			SelectVisList (From);
			GetVisList (NULL,-Desc,NULL,NULL,-1);
		}
		else 
		{   
			CurVis->FileIsVisible[-(From+1)]=TRUE;
			GetVisList (NULL,-Desc,NULL,NULL,-From);  
		}
		_fstrcpy (Name,CurrentSymName);
		CurVis = SaveVis;
		GSSiGlobUlFree (&hVis);
	} 
Exit:
	if (*CurrentSymName) 
	{
		LastDesc = Desc;  
		LastParent = CurrentSymParent;
		ConvertSymName (CurrentSymName);
		_fstrcpy (LastName,CurrentSymName); 
		if (pParent)
			*pParent = CurrentSymParent;
		if (pIsPar)
			*pIsPar = CurSymIsParent; 
		LastIsPar = CurSymIsParent; 
		return TRUE;
	} 
	else if (pParent)
		*pParent = 0;
	LastDesc = -1; 
	LastParent = 0;
	return FALSE;
}
void AddGraphicsCmd (HWND hWnd,LPSTR Cmd,BOOL Keydef, UINT StartPrompt)
{   
	unsigned short	len=_fstrlen(Cmd);
	HANDLE	hCmd = GSSiGlobAlloc (GHND,len+sizeof(CMDSTRING)+1);
	LPCMDSTRING    pCmdStrPrev,pCmdStr = (LPCMDSTRING)GlobalLock (hCmd);  
	LPSTR	pPrevCmd;
	
	_fstrcpy (pCmdStr->Cmd,Cmd);
	pCmdStr->EndLoc = len;
	pCmdStr->MyHandle = hCmd;  
	pCmdStr->VP = CurView->ID;        
	pCmdStr->Prompt = StartPrompt;
	pCmdStr->PrevHandle = CurView->FunStackHandle;
	GlobalUnlock (hCmd);
	if (CurView->FunStackHandle)
	{
		pCmdStrPrev = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);   
		pPrevCmd = pCmdStrPrev->Cmd;
		if (!_fstrcmp (pCmdStrPrev->Cmd,Cmd))
		{   
/*			AddLBUTTON = pCmdStrPrev->AddLBUTTON; 
			GSSiGlobFree (&pCmdStrPrev->hError);
	    	GSSiGlobFree (&pCmdStrPrev->hWhile);
			GlobalUnlock (CurView->FunStackHandle);
			GlobalFree (hCmd);
	    	if (AddLBUTTON && HaveCurrentLBUTTON)
	    	{
	    		HaveCurrentLBUTTON = FALSE;
	    		if (Keydef) 
	    			PostMessage (hWndMain,WM_LBUTTONDOWN,0,MAKELONG(CurrentLBUTDOWNLoc.x,CurrentLBUTDOWNLoc.y)); 
	    		IgnoreLbutton = FALSE;
	    		PostMessage (hWndMain,WM_LBUTTONUP,0,MAKELONG(CurrentLBUTDOWNLoc.x,CurrentLBUTDOWNLoc.y));
	    	}
			retrn;  
*/   
			ResetFunStack (FALSE);
		}
		GlobalUnlock (CurView->FunStackHandle);
	}		
	CurView->FunStackHandle = hCmd;
	RemoveGraphicsFunction (hWnd);
    return;
}

