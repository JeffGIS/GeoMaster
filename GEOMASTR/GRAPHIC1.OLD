DPOINT FilePtToBasePt (POINT Point)
{   DPOINT  NewPoint;
    
    ProjectFilePt (&Point);
    TRANS2 ((double) Point.x,(double) Point.y,
            &NewPoint.x,&NewPoint.y,hTranFileToBase);
    return (NewPoint);
}

DPOINT CopyFilePtToBasePt (POINT Point)
{   DPOINT  NewPoint;
    
    ProjectFilePt (&Point);
    TRANS2 ((double) Point.x,(double) Point.y,
            &NewPoint.x,&NewPoint.y,hTranCopyFile);
    return (NewPoint);
}

DPOINT FilePtToBasePtD (DPOINT Point)
{   DPOINT  NewPoint;
    
    TRANS2 (Point.x, Point.y,
            &NewPoint.x,&NewPoint.y,hTranFileToBase);
    return (NewPoint);
}

DPOINT FilePtToBasePtNP (POINT Point)
{   DPOINT  NewPoint;
    
    TRANS2 ((double) Point.x,(double) Point.y,
            &NewPoint.x,&NewPoint.y,hTranFileToBase);
    return (NewPoint);
}

DPOINT FilePtToBasePtNPD (DPOINT Point)
{   DPOINT  NewPoint;
    
    TRANS2 (Point.x, Point.y,
            &NewPoint.x,&NewPoint.y,hTranFileToBase);
    return (NewPoint);
}

BOOL SetFileBounds ()
{    double     xscale, yscale, scale, dist1, dist2;
     long   rect_width, rect_height, iscale;
     long   bounds_width, bounds_height;
     long   ifactor;
     DPOINT DPoint, BasePt1, BasePt2, FilePT1, FilePT2;
     POINT  Point1, Point2, WinPT1, WinPT2, Point;
     MNMXCORD   WinBounds;
     long   MAX_BOUNDS=64000;
     RECT   WinRect ;
     
     if (CurView->hWnd && !FileMode)
        GetClientRect (CurView->hWnd,&WinRect);
     else
        WinRect = MainRect;
     
     CurView->FileFactor = 1;
     Point1.x=0;
     Point1.y=0;     
     BasePt1 = FilePtToBasePt(Point1);
     Point2.x=10000;
     Point2.y=10000;
     BasePt2 = FilePtToBasePt(Point2); 
     FileDistToBaseDist = ldistp (BasePt1,BasePt2)/idist(Point1,Point2); 
     if (FileDistToBaseDist == 0)
        FileDistToBaseDist=1;
     if (Pick || FullCurves)  
     	CurveExpansionFactor = 1;
     else
     	CurveExpansionFactor = FileDistToWinDist;
     WinPT1.x = 100;
     WinPT1.y = 100; 
     FilePT1 = WinCoordToFileCoordD(WinPT1);
     WinPT2.x = 200;
     WinPT2.y = 100; 
     FilePT2 = WinCoordToFileCoordD(WinPT2);
     dist1 = idist(WinPT1,WinPT2);
     dist2 = ldistp(FilePT1,FilePT2);
     if (dist2 == 0)
        dist2 = 1;
     FileDistToWinDist = dist1/dist2; 
     BaseDistToWinDist = FileDistToWinDist / FileDistToBaseDist;
     if (dist1 == 0)
        dist1 = 1;
     WindowToFileFactor = dist2/dist1; 
     
     PixelsPerHInch=(float)(10*dist1/dist2);
     WidthFactor = dist2/dist1;
//     if (Pick) rturn(TRUE);
     
     Point.x = WinRect.left;
     Point.y = WinRect.bottom;
     DPoint = WinPtToBasePt (Point);
     WinBounds.xmn = DPoint.x;
     WinBounds.ymn = DPoint.y;
     Point.x = WinRect.right;
     Point.y = WinRect.top;
     DPoint = WinPtToBasePt (Point);
     WinBounds.xmx = DPoint.x;
     WinBounds.ymx = DPoint.y;
     TRANS2 (WinBounds.xmn,WinBounds.ymn,
             &CurView->FileBounds.xmn,&CurView->FileBounds.ymn,hTranBaseToFile);
     TRANS2 (WinBounds.xmx,WinBounds.ymx,
             &CurView->FileBounds.xmx,&CurView->FileBounds.ymx,hTranBaseToFile);
             
Loop:
	 if (!CurView->FileFactor)
	 	return FALSE;
     CurView->Bounds.xmn = IDNINT (CurView->FileBounds.xmn/CurView->FileFactor);
     CurView->Bounds.xmx = IDNINT (CurView->FileBounds.xmx/CurView->FileFactor);
     CurView->Bounds.ymn = IDNINT (CurView->FileBounds.ymn/CurView->FileFactor);
     CurView->Bounds.ymx = IDNINT (CurView->FileBounds.ymx/CurView->FileFactor); 
     rect_width = CurView->DrawRect.right - CurView->DrawRect.left;
     rect_height = CurView->DrawRect.bottom - CurView->DrawRect.top;
     bounds_width = CurView->Bounds.xmx - CurView->Bounds.xmn;
     bounds_height = CurView->Bounds.ymx - CurView->Bounds.ymn;
     if (bounds_width > MAX_BOUNDS || bounds_height > MAX_BOUNDS ||
         CurView->Bounds.xmn < SHRT_MIN || CurView->Bounds.xmx > SHRT_MAX ||
         CurView->Bounds.ymn < SHRT_MIN || CurView->Bounds.ymx > SHRT_MAX )
     {
        CurView->FileFactor = CurView->FileFactor * 2;
        goto Loop;
     }

     TRANS2 (CurView->WBounds.xmn,CurView->WBounds.ymn,
             &CurView->FileBounds.xmn,&CurView->FileBounds.ymn,hTranBaseToFile);
     TRANS2 (CurView->WBounds.xmx,CurView->WBounds.ymx,
             &CurView->FileBounds.xmx,&CurView->FileBounds.ymx,hTranBaseToFile);
     CurView->Bounds.xmn = IDNINT (CurView->FileBounds.xmn/CurView->FileFactor)-1;
     CurView->Bounds.xmx = IDNINT (CurView->FileBounds.xmx/CurView->FileFactor)+1;
     CurView->Bounds.ymn = IDNINT (CurView->FileBounds.ymn/CurView->FileFactor)-1;
     CurView->Bounds.ymx = IDNINT (CurView->FileBounds.ymx/CurView->FileFactor)+1;
     rect_width = CurView->DrawRect.right - CurView->DrawRect.left;
     rect_height = CurView->DrawRect.bottom - CurView->DrawRect.top;
     bounds_width = CurView->Bounds.xmx - CurView->Bounds.xmn;
     bounds_height = CurView->Bounds.ymx - CurView->Bounds.ymn;  
     if (rect_width == 0)
        rect_width = 1;
     if (rect_height == 0)
        rect_height = 1;
     xscale = (double) bounds_width / rect_width;
     yscale = (double )bounds_height / rect_height;
     if (xscale > yscale)
        scale = xscale;
     else
        scale = yscale;
     
     if (scale == 0)
        scale = 1;
     ifactor = (long)min (SHRT_MAX,SHRT_MAX / scale);
     iscale = (long)(scale * ifactor);
     if (iscale < 1) iscale = 1;
     if (ifactor == 0)
        ifactor = 1;
     scale = (float) iscale / ifactor;
     
     WidthFactor /= CurView->FileFactor;
     CurView->wOrigX = (short)CurView->Bounds.xmn;
     CurView->wOrigY = (short)CurView->Bounds.ymx;
     CurView->wExtX = (short)iscale;
     CurView->wExtY = (short)-iscale;
     CurView->vExtX = (short)ifactor;
     CurView->vExtY = (short)ifactor;  

    return (TRUE);
}

void GetItemLoc (short item,LPLONG Segment,LPWORD Offset)
{
    *Segment = PickList[item].Segment;
    *Offset = PickList[item].Offset;
    return;
}

BOOL OpenPlotFile (void)
{   OFSTRUCT    OFStruct;

    if (Fid>=0)
    	return (TRUE);
    if (!PltName[0])
    	return(FALSE);
    Fid = GSSiOpenFile (PltName,(LPOFSTRUCT)&OFStruct,OF_READ); 
    if (Fid == HFILE_ERROR)
    {
        Fid=-1;
        return FALSE;
    }
    return (TRUE);
}

BOOL ClosePlotFile (void)
{   if (Fid<0)
		return (FALSE);
    GSSiClose (Fid);
    Fid = -1;
    return (TRUE);
}

void ShowPickedItem (HWND hWnd, short InItem)
{   LPINT       ipnt, EndItem;
    HANDLE      hpltBuf;
    LPSTR       LPpltBuf;
    LPITEM      ItemHeader;
    POINT       CenterPoint;
    HANDLE      hVisList;
    LPVISLIST   SaveVis=0;
    LPVIEWPORT  SaveView;
    short		iLen, Item, SavePassID;
    
    Item = max (InItem,0);                     
    SaveView = CurView;
    SetViewport (PickList[Item].ViewID);

    if (!GetPickName (Item))
        goto Exit;

    if (!PickName[0]) goto Exit;
    _fstrcpy (PltName,PickName);

    CloseMap (FALSE);
    if (!OpenMap (CurView->hWnd,CurView->hDC)) goto Exit;
    
    if (InItem >= 0)
    {
	    hVisList=GSSiGlobAlloc (GHND,sizeof(VISLIST));
	    SaveVis = CurVis;
	    CurVis = (LPVISLIST)GlobalLock (hVisList); 
	    CurVis->hVisList=hVisList;
	    InitVis (); 
	    if (PickList[Item].Type == 4)
	    {
	    	_fmemset (&CurVis->WantType,0,20);
	    	CurVis->WantType[2] = 1;
	    }
	    else
		    CurVis->WantType[8]=1;
		CurVis->WantType[6] = SaveVis->WantType[6]; 
	}
    
    _llseek (Fid,PickList[Item].Segment,0);
    nRead = _lread (Fid,&nBytes,2);
    hpltBuf = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nBytes+2);
    LPpltBuf = GlobalLock (hpltBuf);
    LPpltBuf[nRead] = 0;
    nRead = _lread (Fid,LPpltBuf,nBytes);
    if (nRead != nBytes || PickList[Item].Offset > nRead) 
    {
    	InvalidItem (NULL,TRUE);
    	goto Exit;
    }
    ipnt = (LPINT)(LPpltBuf + PickList[Item].Offset);
    ItemHeader = (LPITEM) ipnt;
    if (InvalidItem (ItemHeader,TRUE))
        goto Exit; 
    iLen = abs(ItemHeader->Len);
    if (iLen)
    {
	    EndItem = ipnt + iLen;
	    EndItem+=6;
	    *EndItem = 0;   
	}
    AddMinMax (&PickMinMax,&ItemHeader->MinMax);
    if (!BlockInWindow (&ItemHeader->MinMax,2))
    {   if (AutoPan)
        {
            CenterPoint.x = ((long)ItemHeader->MinMax.xmn + ItemHeader->MinMax.xmx)/2;
            CenterPoint.y = ((long)ItemHeader->MinMax.ymn + ItemHeader->MinMax.ymx)/2;
            CenterWindow (hWnd,FilePtToBasePt(CenterPoint),FALSE);
        }
    }
    else
    {   
        SavePassID = CurView->PassID;
    	if (InItem >= 0)
    	{
        	Highlight = TRUE; 
			CurView->PassID = 2; 
		}
        CurView->hRgn = CreateVPRgn(FALSE);
        SelectClipRgn (CurView->hDC,CurView->hRgn);
        DeleteObject(CurView->hRgn);
        SetDisplayMode (CurView->hDC, GF_MAPMODE);
        OpenBasePens();
        PickedPointLoc = PickList[Item].BeginPoint; 
        ProcessSingleItem = TRUE;
		HaveFirstHeader=FALSE;
        while(ProcessGraphicsRec (CurView->hDC,ipnt,LPpltBuf,nRead))
        {
		    GlobalUnlock (hpltBuf);
		    GlobalFree  (hpltBuf);
		    _llseek (Fid,ContinuationOffset,0);
		    nRead = _lread (Fid,&nBytes,2);
		    hpltBuf = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nBytes+2);
		    LPpltBuf = GlobalLock (hpltBuf);
		    LPpltBuf[nRead] = 0;
		    nRead = _lread (Fid,LPpltBuf,nBytes);
		    if (nRead != nBytes) 
		    {
				ProcessSingleItem=HaveFirstHeader=FALSE;
		    	InvalidItem (NULL,TRUE);
		    	goto Exit;
		    }
		    ipnt = (LPINT)LPpltBuf;
        }
		ProcessSingleItem=HaveFirstHeader=FALSE;
        CloseBasePens();
        Highlight = FALSE;
        CloseMap(FALSE);  
        CurView->PassID = SavePassID;
    }
    GSSiGlobUlFree (&hpltBuf);
    hpltBuf=0; 
Exit:
    if (SaveVis)
    {
	    GSSiGlobUlFree (&hVisList);
	    CurVis = SaveVis;
	} 
    SetCurView ( SaveView); 
	ClearFullWindowBitmap ();
    
    return;
}
short CenterWindow (HWND hWnd, DPOINT CenterPoint, BOOL Imediate)
{    double BWidth, BHeight;
     
	 HaltMapDisplay(FALSE); 
     BWidth = CurView->WBounds.xmx - CurView->WBounds.xmn;
     BHeight = CurView->WBounds.ymx - CurView->WBounds.ymn;
     CurView->NewBounds.xmn = CenterPoint.x - BWidth/2;
     CurView->NewBounds.ymn = CenterPoint.y - BHeight/2;
     CurView->NewBounds.xmx = CenterPoint.x + BWidth/2;
     CurView->NewBounds.ymx = CenterPoint.y + BHeight/2;
     CurView->CurZoomAreaRef = 0;
     ZoomToRect(CurView->NewBounds,Imediate);
     return (0);
}

/*
 * ComputeWMFChecksum( lpwmf ) : WORD
 *
 *    lpwmf          pointer to metafile header
 *
 * This function computes the checksum for the given metafile header,
 * which is an Aldus disk metafile header.  The checksum is the result
 * of XORing the first 10 words in the file.
 *
 */

WORD FAR PASCAL ComputeWMFChecksum(
    LPWMFHEADER     lpwmf )
{
    LPWORD          lpChecksum;
    WORD            idChecksum;

    /* initialize checksum */
    idChecksum = 0;

    /* calculate checksume */
    lpChecksum = (LPWORD)&(lpwmf->idChecksum);
/*  for (lp = (LPWORD)lpwmf; FP_OFF(lp) < FP_OFF(lpChecksum); ++lp)
        idChecksum ^= *lp;
*/
    return idChecksum;
}

BOOL ItemInRegion (HRGN hRgn,HPPOINT lpPoints, long npnts)
{   RECT    Rect, NewRect;
    HPPOINT lpPoint;
    DWORD     i;
    
    Rect.left = SHRT_MAX;
    Rect.right = SHRT_MIN;
    Rect.bottom = SHRT_MIN;
    Rect.top = SHRT_MAX;

    for (i=0,lpPoint=lpPoints;i<npnts;i++,lpPoint++)
    {
        Rect.left = min (Rect.left,lpPoint->x);
        Rect.right = max (Rect.right,lpPoint->x);
        Rect.top = min (Rect.top,lpPoint->y);
        Rect.bottom = max (Rect.bottom,lpPoint->y);
    }

    return (IntersectRect (&NewRect,&Rect,&CurView->Rect));
}

void SetNewBoundsToBounds(void)
{
    CurView->NewBounds=CurView->WBounds;
}
void PaintMap (HWND hWnd, HDC hDC,BOOL Imediate,LPRECT pUpdateRect)
{ 
    static  BOOL    First=TRUE;
    RECT	IntRect;
    
    if (DisableHalt)
    	return;
    if (!DoPaint)
    	return;
    if (!PeopleNet) 
    	HaltMapDisplay(FALSE); 
    if (!OpenConfig(hWnd,hDC))
    	return;  
    InDisplayProcessing = TRUE;
    DisplayCycle++;
    TotCopySize = 0;
	PrevLayerVP=0;
    InImediate = Imediate;
    if (FirstDisplayOfConfig)
    {   
        First = FALSE;
        DisplayFinOpt = 2;  
        FirstDisplayOfConfig = FALSE;
    }
    HavePaint = TRUE;  
    if (ConfigLevel)
    	SetMainRect (hWnd,hDC,pUpdateRect);
    else
    	SetMainRect (hWnd,hDC,NULL);
	SelectClipRgn (hDC,NULL);
	if (!pUpdateRect)
    	FillRectPoly (hDC,&MainRect,WindowColor);
    else
    	FillRectPoly (hDC,pUpdateRect,WindowColor);
    if (SetupViewports (hWnd,hDC,0,MainRect))
    {
	    NumViewportsToDisplay = NumViewports;
	    for (DisplayViewID=0;DisplayViewID<NumViewportsToDisplay;DisplayViewID++)
	    {
	        SetCurView (pViewportsD[DisplayViewID]);
	        if (!pUpdateRect || IntersectRect (&IntRect,pUpdateRect,&CurView->Rect))
	        {
		        CurView->Display = TRUE; 
		        ResetViewport (TRUE,TRUE); 
		    }
	    }
	    DisplayViewID = 0;
	    while (DisplayViewID<NumViewportsToDisplay)
	        if (DisplayViewport (hWnd,hDC,Imediate))
	        	goto Next;
	}
    InDisplayProcessing = FALSE;
    return;

Next:
    ImediateProcessing (Imediate);
    
    return;
}  

void SetThemeOrder (void)
{   
	UINT	i; 
	LPTHEME	pTheme;
	
	CurView->NumThemes=0;
	for (i=0;i<NumViewports;i++)
	{
		if ((pTheme=pViewports[i]->pTheme))
		{
			if (pTheme->TargetViewport == CurView->ID) 
				CurView->pThemes[CurView->NumThemes++] = pTheme;
		}
	}
	return;
}

void ResetViewport (BOOL WantDisplayPass,BOOL FromPaintMap)
{    
     HPEN   NewPen;
     RECT   ShadowRect, SaveRect;
     LPVIEWPORT SaveVP;
     short    itheme, DisplayVP, TargetVP, i; 
	 LPCOORDINATEDISPLAY	CD;       
	 long	Color;
	 
	 if (!CurView)
	 	return; 
	 SetThemeOrder ();
 	 CloseEditRect(); 
 	 RemoveInfoBoxRectForVP(CurView->ID);
	 EnlargeScreen (0,0);   
	 if (CurView->hProfileRoute)
	 	DisplayProfileLoc (NULL,NULL,NULL);
     if (CurView->pTheme)
     	CurView->pTheme->VPDisplayed = FALSE;
     if (!CurViewActive()/* || CurView->Width < 0*/)
     	return;
	 DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);
     if (CurView->pTheme) 
     {
     	CurView->pTheme->VPDisplayed = TRUE;
     	if (CurView->pTheme->ID == PF_COORD_DISPLAY)
     	{
     		CD=(LPCOORDINATEDISPLAY)CurView->pTheme;
     		if (*CD->AltCVTFile)
     		{
                SetGlobalValue("%ALT_PROJECTION",CD->AltCVTFile);
			    ConvertCoordClose ();
				ConvertCoordInit(); 
			} 
     	}
     }
     Color = GetGlobalLVal2("[%BACKGROUND_COLOR]",-1);
     if (Color >= 0)
        CurView->BackGroundColor = Color;
     CurView->CurFile=-1; 
     CurView->Display=TRUE;  
     GSSiGlobFree (&CurView->hTAGList);
     CurView->hTAGList = GSSiGlobAlloc(GHND,1024);
     _fmemset (CurView->CurVisType,0,3201*2);
     /*IncrementFile ();*/
     SetDisplayMode (CurView->hDC, GF_TEXTMODE);
     CurView->WantPass[0]=FALSE;
     CurView->FirstFile = TRUE;        
     SetROP2(CurView->hDC,R2_COPYPEN);
     for (itheme = 0;itheme<CurView->NumThemes;itheme++)
     {
        CurTheme = CurView->pThemes[itheme];
        if (ThemeNeedsDataPass ()) CurView->WantPass[0]=TRUE;
     }
     if (CurView->WantPass[0])
     {
        CurView->PassID=0;    
     }
     else
        CurView->PassID=1;
     CurView->WantPass[1]=WantDisplayPass;
/*       CurView->HaveBounds=FALSE;*/
     
     if (!WantDisplayPass)
     	return;
     
     if (!FromPaintMap)
     {                               
	     RedrawActiveFunctions(GF_CLEAR);
		 if (CurView->ID == CommandViewport) 
		 {
			LPVIEWPORT	SaveView=CurView; 
			short	i;
		       		
			for (i=0;i<NumViewports;i++)
			{
				SetCurView ( pViewportsD[i]); 
				if (CurView != SaveView)
			       	RedrawActiveFunctions(GF_CLEAR_CMD);  
			}
			SetCurView ( SaveView);
		 } 
	 }
	 if (CurView->DisplayInParent && CurView->Parent)
	 {
	 	CurView->Rect = pViewports[CurView->Parent-1]->Rect;
	 	CurView->DrawRect = pViewports[CurView->Parent-1]->DrawRect;  
	 	CurView->WBounds = pViewports[CurView->Parent-1]->WBounds;  
	 	CurView->NewBounds = pViewports[CurView->Parent-1]->NewBounds;  
	 }
     if (CurView->hReport)
     {
        RECT    ReportRect; 
        double  Factor1, Factor2;
        char    str[32];
        
        ltoa (CurView->ReportRefno,str,10);
        SetGlobalValue ("%INT_REFNO",str);
        SetGlobalValue (CurView->Prefix,CurView->UDI);
        SetGlobalValue ("%PREFIX",CurView->Prefix); 
        SetUDIValue (CurView->Prefix,CurView->UDI); 
        CurrentUDILen = _fstrlen(CurView->UDI);
        ReportRect = SizeReport (CurView->hDC,CurView->hReport,CurView->DrawRect);
        if (CurView->ShrinkToFit)
        {
            CurView->ReportFactor = 1.0;
            CurView->DrawRect = ReportRect; 
        }
        else
        { 
            Factor1 = (double)(CurView->DrawRect.right - CurView->DrawRect.left+1)/
                      (double)(ReportRect.right - ReportRect.left+1);
            Factor2 = (double)(CurView->DrawRect.bottom - CurView->DrawRect.top+1)/
                      (double)(ReportRect.bottom - ReportRect.top+1);
            CurView->ReportFactor = min (Factor1,Factor2);
        }
     }
	 if (CurView->DisplayInParent && CurView->Parent)   
	 	return;
     SaveRect = CurView->DrawRect;
     CurView->DrawRect = CurView->Rect;
     InflateRect (&CurView->DrawRect,ShadowInc,ShadowInc);
     /*CurView->hRgn = CreateRectRgnIndirect (&CurView->DrawRect);*/
     if (!FileMode)
     {
         CurView->hRgn = CreateVPRgn(FALSE);
         SelectClipRgn (CurView->hDC,CurView->hRgn);
         DeleteObject(CurView->hRgn);
     }
     CurView->DrawRect = SaveRect;
/*     if (CurView->Shadow)
     	DisplayShadow (CurView->hDC,&CurView->Rect,ShadowInc);*/
     if (CurView->MarginPan && !Printing)
     {
         FillRectPoly (CurView->hDC,&CurView->Rect,RGB(98,98,98));
     }
     if (CurView->BackGroundColor!=ULONG_MAX)
     {   
   	 	 Color = CurView->BackGroundColor;
         if (ComputePCTTheme)
         {
         	if (CurView->ID == ComputePCTTheme->TargetViewport)
     	 		Color = ComputePCTBKGColor;
     	 }

         if (CurView->MarginPan && !Printing)
            FillRectPoly (CurView->hDC,&CurView->DrawRect,Color);
         else
            FillRectPoly (CurView->hDC,&CurView->Rect,Color);
     }
     if (CurView->BorderPct >= 0)
     {
         NewPen=CreatePen(PS_SOLID,(short) IDNINT ((double)((MaxDimension * CurView->BorderPct)/100)),CurView->BorderColor);
/*       OldPen = SelectObject (CurView->hDC,NewPen);
         OldBrush = SelectObject (CurView->hDC,GetStockObject(0_BRUSH)); */
         DrawRectPoly (CurView->hDC,&CurView->Rect,NewPen); 
/*       Rectangle (CurView->hDC,CurView->Rect.left,CurView->Rect.top,
                    CurView->Rect.right,CurView->Rect.bottom); 
         SelectObject (CurView->hDC,OldPen);
         SelectObject (CurView->hDC,OldBrush); */
         DeleteObject (NewPen);
     }
     if (CurView->BoundsDisplayID &&
     	 CurView->BoundsDisplayID <= NumViewports)
     {   
         DisplayVP = CurView->BoundsDisplayID;
         TargetVP  = CurView->ID;
         CurView->BoundsDisplayed = FALSE;
         BoundsDisplayTheme (TRUE);
         SaveVP = CurView;
         SetCurView (pViewports[DisplayVP-1]);
         CurView->BoundsDisplayVP = TargetVP;
         SetCurView ( SaveVP);
     } 
     
    return;
}

BOOL DisplayViewport (HWND hWnd, HDC hDC, BOOL Immediate)
{ 
extern  time_t  Counter;
BOOL    WT; 
static	short   FirstDisplayPass=1;

	if (NumViewportsToDisplay < 0)
		goto NextView;
Start:
    while (DisplayViewID < NumViewportsToDisplay)
    {   SetCurView ( pViewportsD[DisplayViewID]);
        if (CurViewActive() && CurView->Display &&
            !(CurView->Type == 7 && !Immediate))
            goto NextView;
       	DisplayViewID++; 
        if (Printing)
        	return FALSE;
    }
    return (FALSE);
    
NextView:
    if (CurView->hReport)
    {    
        char    str[32];
        
        ltoa (CurView->ReportRefno,str,10);
        SetGlobalValue ("%INT_REFNO",str);
        SetGlobalValue (CurView->Prefix,CurView->UDI);
        SetGlobalValue ("%PREFIX",CurView->Prefix); 
        SetUDIValue (CurView->Prefix,CurView->UDI); 
        CurrentUDILen = _fstrlen(CurView->UDI);
        DisplayReport (hDC,CurView->hReport,CurView->DrawRect,
                       CurView->ReportFactor,CurView->ReportRefno);
        DisplayViewID++; 
        goto Start;
    }
    if (CurView->Type == 7 && !Printing)
    {
        if (CurView->Bitmap && EqualRect(&CurView->Rect,&CurView->BitmapRect))
        {
            if(!Pick)DisplayTAGs(hDC);
            DisplayViewID++; 
            goto Start;
        }
        else
        	DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);
        Counter = LONG_MAX;
    }
    else
        Counter = 100;
    SelectVisList (FALSE); 
    FirstDisplayPass=1;
    if (CurVis) 
    {
        if (!CurVis->WantType[5] || ComputePCTTheme)
        {
            if (CurView->PassID == 1) 
            {
                CurView->PassID++;
                CurView->CurFile=-1;
			}
            FirstDisplayPass=2;   
        }
        if (!CurVis->WantType[0])
        {
            if (CurView->PassID == 2)
            {
                CurView->PassID++;
                CurView->CurFile=-1;
			}
            if (FirstDisplayPass==2)
            	FirstDisplayPass=3;   
        }
    }
     
NextFile: 
    if (CurView->PassID >= 5 || CurView->PassID <= 3)
    {
        if (CurView->PassID < 5 && CurView->FirstFile && CurView->PassID==FirstDisplayPass)
        {
            if (CurView->HaveBounds)
            {
            	HANDLE hSaveDisplay=GSSiGlobAlloc (GMEM_MOVEABLE,2*MAX_VIEWPORTS);
            	short	SaveDisplayViewID = DisplayViewID;
            	short	SaveNumViewportsToDisplay = NumViewportsToDisplay; 
            	short	SaveFDP = FirstDisplayPass; 
            	short	i;
            	LPSHORT	pSaveDisplay=(LPSHORT)GlobalLock (hSaveDisplay);
            	
            	for (i=0;i<NumViewportsToDisplay;i++)
            		*pSaveDisplay++ = pViewportsD[i]->Display;
            	GlobalUnlock (hSaveDisplay);
            	SetBounds(CurView->hWnd,1);  
            	pSaveDisplay = (LPSHORT)GlobalLock (hSaveDisplay);   
            	NumViewportsToDisplay = SaveNumViewportsToDisplay;
            	DisplayViewID = SaveDisplayViewID;      
            	FirstDisplayPass = SaveFDP;
            	for (i=0;i<NumViewportsToDisplay;i++)
            		pViewportsD[i]->Display = *pSaveDisplay++;
            	GSSiGlobUlFree (&hSaveDisplay); 
            	SelectVisList (FALSE);
            }
		}
    }
    if (CurView->FirstFile && CurView->PassID==FirstDisplayPass)
    {   
		DisplayTAGs2 (CurView->hDC,1,0);    
        ThemeBeginDisplayPass(); 
        if (CurView->PassID == 99)
        	goto NextVP; 
    }
    if (CurView->PassID >= 5 || CurView->PassID <= 3)
    {   
        if (!GetNextViewportFile (FALSE))
        	goto NoFile;
        CurView->FirstFile = FALSE;
        DisplayPlotInit(hWnd,Immediate);
        return (TRUE);
    }
NoFile:
    PltName[0]='\0';
    if (CurView->PassID>=3)
    {   
        CurView->PassID=4; 
        if (!Pick)
        {
	        DisplayPolyOff ();
	        DisplayMaskArea(); 
	        DisplayEditLimits();
	    }
        if (ThemeEndDisplayPass(FALSE))
        {
			ResetViewport (TRUE,FALSE); 
			goto NextView;
        }
        DisplayVPThemeLegends ();
        ThemeDisplayLegend(3); 
        if (!Pick)
	        DisplayTAGs(hDC);
        if (CurView->Type == 7)
        {    
			DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);
            if (!Printing)
            {
                CurView->Bitmap = SaveScreen2 (CurView->hDC, CurView->Rect,CurView,&CurView->BitmapID);
                CurView->BitmapRect = CurView->Rect;
            }
        }  
       	RedrawActiveFunctions(GF_REDRAW);  
       	if (CurView->ID == CommandViewport) 
       	{
       		LPVIEWPORT	SaveView=CurView; 
       		short	i;
       		
       		for (i=0;i<NumViewports;i++)
       		{
				SetCurView ( pViewportsD[i]); 
				if (CurView != SaveView)
			       	RedrawActiveFunctions(GF_REDRAW_CMD);  
       		}
       		SetCurView ( SaveView);
       	}
NextVP:
        DisplayViewID++;   
        if (Printing)
        	return FALSE;
        while (DisplayViewID < NumViewportsToDisplay)
        {   SetCurView ( pViewportsD[DisplayViewID]);
            if (CurViewActive() && CurView->Display && !(CurView->Type == 7 && !Immediate)/* && CurView->Width>=0*/) break;
            DisplayViewID++; 
        } 
//        if (Immediate)
        	goto Start;
        return (FALSE);
    } 
    else
    {   
        CurView->PassID++;
        CurView->CurFile=-1; 
        CurView->FirstFile = TRUE;
//        IncrementFile (); 
        if (CurView->PassID == 1) ThemeEndDataPass();
        if (!CurVis || ComputePCTTheme)
            WT = FALSE;
        else
            WT = CurVis->WantType[5];//Orthos
        if (!WT && CurView->PassID == 1)
        {
            CurView->PassID++; 
            CurView->CurFile=-1;
		}
        if (!CurVis)
            WT = FALSE;
        else
            WT = CurVis->WantType[0];  
        if (!WT && CurView->PassID == 2) 
        {
            CurView->PassID++;   
            CurView->CurFile=-1;
		}
		if (CurView->PassID > 2 && ComputePCTTheme)
			goto NoFile;
        goto NextFile;
    }
     
}

BOOL LoadMapDir (HWND hWnd)
{
    short nRc;
       
    DoPaint = FALSE;
     {
#if WIN32
      nRc = DialogBox(hInst, (LPSTR)"LOAD_MD", hWnd, LOADMDMsgProc);
#else
      FARPROC lpfnLOADMDMsgProc;
      lpfnLOADMDMsgProc = MakeProcInstance((FARPROC)LOADMDMsgProc, hInst);
      nRc = DialogBox(hInst, (LPSTR)"LOAD_MD", hWnd, lpfnLOADMDMsgProc);
      FreeProcInstance(lpfnLOADMDMsgProc);
#endif
     }

    return (TRUE);
} 
double CvtDist (double Dist,short FromUnits,short ToUnits) 
{
	double NewDist=Dist;
	
	if (FromUnits == 1 && ToUnits == 2)
		NewDist *= FTM;
	else if (FromUnits == 2 && ToUnits == 1)
		NewDist *= MFT;
	
	return NewDist;
}
BOOL GetMapIndexBounds (LPSTR Name,LPMNMXCORD FileBounds)
{
    OFSTRUCT    OFStruct; 
    short     Version;
    HFILE   FidIndex=0;
    long    Signature, EndOffset;
    
Start:
	FileBounds->xmn = 0;
	FileBounds->xmx = -1;
	FileBounds->ymn = 0;
	FileBounds->ymx = -1;
    FidIndex = GSSiOpenFile (Name,(LPOFSTRUCT) &OFStruct,OF_READ);
    if (FidIndex == HFILE_ERROR)
        return(TRUE);                                                
    EndOffset = _llseek(FidIndex,(LONG)-(6),2);
    _lread (FidIndex,&Signature,4);
    _lread (FidIndex,&Version,2);
    if (Signature != 80251)
    {    
        GSSiClose (FidIndex); 
        GSSiMessageBox("This is not a valid index file",OFStruct.szPathName, MB_OK);
        return(FALSE);
    }
    if (Version > 2)
    {
    BadMap:  
        GSSiClose(FidIndex);
        GSSiMessageBox("This index file version is not recognized",Name, MB_OK);
        return(FALSE);
    }
    if (Version < 1) goto BadMap; 
    if (Version == 1)
    {
        GSSiClose(FidIndex);
        ConvertIndexV1ToV2(Name); 
        goto Start;
    }
        
    _llseek(FidIndex,0,0);
    _lread (FidIndex,FileBounds,sizeof(MNMXCORD));
    GSSiClose (FidIndex); 
    return TRUE;
}

HANDLE OpenMapIndex (LPSTR Name)
{
    OFSTRUCT    OFStruct; 
    short     Version;
    HFILE   FidIndex=0;
    long    Signature, EndOffset;
    HANDLE  Handle;
    LPFILEINDEX lpIndex;
    FILEINDEX FirstIndex;   
    MNMXCORD    TestBounds;
	MNMXCORD	FileBounds;
    char        File[128], drive[8], dir[128], leaf[40], IndexRes[16];
    
    _fstrcpy (File,Name);
    ExpandText (File);
    _splitpath (File,drive,dir,leaf,0); 
    if (!_fstrnicmp (leaf,"index",5))
    	_fstrcpy (IndexRes,&leaf[5]);
    else
    	IndexRes[0]=0;
Start:
    FidIndex = GSSiOpenFile (Name,(LPOFSTRUCT) &OFStruct,OF_READ);
    if (FidIndex == HFILE_ERROR)
        return(0);                                                
    SetGlobalValue ("%INDEXRES",IndexRes);
    sprintf (File,"%s%sglobal.ini",drive,dir);
    if (!CurView->SubFile)
		ProcessGlobal ("[%LAYERINIT]");
    LoadGlobalInit (File,FALSE);
	GetViewportScale (CurView->hDC); 
    EndOffset = _llseek(FidIndex,(LONG)-(6),2);
    _lread (FidIndex,&Signature,4);
    _lread (FidIndex,&Version,2);
    if (Signature != 80251)
    {    
        GSSiClose (FidIndex); 
        ContinueProcessing=FALSE;
        GSSiMessageBox("This is not a valid index file",OFStruct.szPathName, MB_OK);
        return(0);
    }
    if (Version > 2)
    {   
    BadMap: 
        GSSiClose (FidIndex); 
        ContinueProcessing=FALSE;
        GSSiMessageBox("This index file version is not recognized",OFStruct.szPathName, MB_OK);
        return(0);
    }
    if (Version < 1) goto BadMap; 
    if (Version == 1)
    {
        GSSiClose(FidIndex);
        ConvertIndexV1ToV2(Name); 
        goto Start;
    }
        
    _llseek(FidIndex,0,0);
    _lread (FidIndex,&FileBounds,sizeof(MNMXCORD));
    if (!AdjustFileBounds (CurView->ID,FileNum,&FileBounds,NULL))
    {
        GSSiClose (FidIndex);
        return 0;
    }
	CurView->FileMNMX = FileBounds;
    SetRezoomBounds (FileBounds);   
    if (!CurView->HaveBounds)
        CurView->NewBounds = FileBounds;
    if (!RectInWBounds(&FileBounds) &&(!UpdateOrthoIndex||PltType!=5))
    {
        GSSiClose (FidIndex);
        return 0;
    }
    _lread (FidIndex, &FirstIndex,STOREDINDEXLENGTH);
    FirstIndex.EndOffset = EndOffset; 
    FirstIndex.FirstFoundFile=TRUE;
    _fstrcpy(FirstIndex.FileName,OFStruct.szPathName);
    Handle = GSSiGlobAlloc(GMEM_MOVEABLE,sizeof(FILEINDEX)+FirstIndex.Length);
    lpIndex = (LPFILEINDEX)GlobalLock(Handle);
    *lpIndex = FirstIndex;
    lpIndex->FirstIndexFileOffset = _llseek (FidIndex,0,1);
    lpIndex->FileInIndex=0; 
    lpIndex->CurrentEntryOffset=-1; 
    if (lpIndex->NumFiles > UINT_MAX)
    	lpIndex->NumFiles = UINT_MAX - 1;
    _lread (FidIndex,&lpIndex->FirstIndex,(size_t)lpIndex->Length);
    lpIndex->NextHeaderOffset = _llseek (FidIndex,0,1);
    GSSiClose (FidIndex);  
    TestBounds = lpIndex->Bounds;
    if (!AdjustFileBounds (CurView->ID,FileNum,&TestBounds,NULL))
    	goto NotIn;
    
    if (!RectInWBounds(&TestBounds) &&(!UpdateOrthoIndex||PltType!=5)) 
    { 
NotIn:   
        lpIndex->FileInIndex+=lpIndex->NumFiles;
        if (!(lpIndex=GetNextIndexHeader(&Handle)))
            return 0;
    }
    lpIndex->CurrentEntry=0; 
    GlobalUnlock (Handle);
    return Handle;  
}

LPFILEINDEX GetNextIndexHeader(LPHANDLE pHandle)
{
    HFILE   FidIndex=0;
    OFSTRUCT    OFStruct; 
    LPFILEINDEX lpIndex;
    FILEINDEX CurIndex,NextIndex;
    short	ii;
    
    GlobalUnlock(*pHandle);
    lpIndex = (LPFILEINDEX)GlobalLock(*pHandle);
    CurIndex = *lpIndex;
    GSSiGlobUlFree (pHandle);
Next:
    if (CurIndex.NextHeaderOffset >= CurIndex.EndOffset)
    { 
NotFound:
        *pHandle = 0;  
        if (FidIndex)
            GSSiClose(FidIndex);
        return 0;
    }
    if (!FidIndex)      
        FidIndex = GSSiOpenFile(CurIndex.FileName,&OFStruct,OF_READ); 
    if (CurIndex.NextHeaderOffset == 321)
    	ii=1;
    if (_llseek(FidIndex,CurIndex.NextHeaderOffset,0) == HFILE_ERROR)
    	goto NotFound;
    if (_lread (FidIndex, &NextIndex,STOREDINDEXLENGTH) != STOREDINDEXLENGTH)
    	goto NotFound;
    NextIndex.NumFiles+=CurIndex.NumFiles; 
    NextIndex.EndOffset = CurIndex.EndOffset; 
    NextIndex.FileInIndex = CurIndex.FileInIndex; 
    NextIndex.FirstFoundFile=CurIndex.FirstFoundFile;
    _fstrcpy(NextIndex.FileName,CurIndex.FileName);
    NextIndex.NextHeaderOffset = _llseek (FidIndex,0,1)+NextIndex.Length;
    if (!AdjustFileBounds (CurView->ID,FileNum,&NextIndex.Bounds,NULL))
    	goto GetNextIndex;
    if (!RectInWBounds(&NextIndex.Bounds)&&(!UpdateOrthoIndex||PltType!=5))
    {
GetNextIndex:
        _llseek(FidIndex,NextIndex.NextHeaderOffset,0); 
        NextIndex.FileInIndex=NextIndex.NumFiles;     
        CurIndex = NextIndex;
        goto Next;
    }
    *pHandle = GSSiGlobAlloc(GMEM_MOVEABLE,sizeof(FILEINDEX)+NextIndex.Length);
    lpIndex = (LPFILEINDEX)GlobalLock(*pHandle);
    *lpIndex = NextIndex;
    lpIndex->FirstIndexFileOffset = _llseek (FidIndex,0,1);
    _lread (FidIndex,&lpIndex->FirstIndex,(size_t)lpIndex->Length);
    lpIndex->NextHeaderOffset = _llseek (FidIndex,0,1);
    lpIndex->CurrentEntryOffset=-1;
    GSSiClose (FidIndex);
    
    return lpIndex;
}

void CloseMapIndex (LPSTR Name,HANDLE hlpFI, BOOL Write)
{ 
    OFSTRUCT    OFStruct; 
    short FidIdx;
    short     Version=1;
    long    Signature=80251; 
    long    ii;
    LPFILEINDEX lpFI; 
    
    if (!hlpFI)
    	return;
    lpFI = (LPFILEINDEX)GlobalLock(hlpFI);
    if (Write)
    { 
        FidIdx = GSSiOpenFile (Name,(LPOFSTRUCT) &OFStruct,OF_CREATE);
        _lwrite (FidIdx,(char *)&lpFI->Type,2);
        _lwrite (FidIdx,(char *)&lpFI->NumFiles,2);
        _lwrite (FidIdx,(char *)&lpFI->Length,4);
        _lwrite (FidIdx,(char *)&lpFI->OrthoRes,8);
        if (!BigWrite (FidIdx,&lpFI->FirstIndex,lpFI->Length-sizeof(FILEINDEX)))
            GSSiMessageBox("Error writing index - disk may be full",
                       "Fatal Write Error",MB_OK|MB_ICONQUESTION|MB_TASKMODAL);
        
        ii=_lwrite (FidIdx,(char *)&Signature,4);
        ii=_lwrite (FidIdx,(char *)&Version,2);
        GSSiClose (FidIdx);
    }
    GSSiGlobUlFree (&hlpFI);
    return;
}
BOOL GetNextIndexEntry (LPFILEINDEX lpIndex)
{   
    short     ii;
    char    FAR *pnt;
    LPFILEINDEXENTRY	pCurFileIndexEntry=&CurFileIndexEntry;
    
    if (lpIndex->FileInIndex >= (long)lpIndex->NumFiles)
    	return FALSE;
    pnt = (char *)(LPFILEINDEXENTRY)&lpIndex->FirstIndex;
    if (lpIndex->CurrentEntryOffset<0)
    { 
        lpIndex->CurrentEntryOffset=0; 
        lpIndex->CurrentEntry = (LPFILEINDEXENTRY)pnt;
        lpIndex->FileInIndex++;
        goto Exit;
    }                                                       
    pnt += lpIndex->CurrentEntryOffset;
    lpIndex->CurrentEntry = (LPFILEINDEXENTRY)pnt;
    pnt += lpIndex->CurrentEntry->Len;
    lpIndex->CurrentEntryOffset += lpIndex->CurrentEntry->Len;
    lpIndex->CurrentEntry = (LPFILEINDEXENTRY) pnt;
    lpIndex->FileInIndex++; 
Exit:
	pCurFileIndexEntry->Len = lpIndex->CurrentEntry->Len;
	pCurFileIndexEntry->BMWidth = lpIndex->CurrentEntry->BMWidth;
	pCurFileIndexEntry->BMHeight = lpIndex->CurrentEntry->BMHeight;
	pCurFileIndexEntry->BMBitCount = lpIndex->CurrentEntry->BMBitCount;
	pCurFileIndexEntry->Bounds = lpIndex->CurrentEntry->Bounds;
	_fstrncpy (pCurFileIndexEntry->Name,lpIndex->CurrentEntry->Name,128);
//    _fmemmove (pCurFileIndexEntry,lpIndex->CurrentEntry,lpIndex->CurrentEntry->Len);
    return TRUE;
}

BOOL GetPickName (short Item)
{    
    HFILE       FidSub; 
    LPSTR lpSlash, lpParen;
    LPFILEINDEX lpIndex;  
    LPVIEWPORT  SaveView;  
    OFSTRUCT    OFStruct; 
    HANDLE	hBinFileList;
    BOOL    SaveIgnoreBounds;
    short     ifile, SaveCurFile=CurView->CurFile;
    char    SubFileName[132], OrigFile[128]="";
    short       NumFiles;
    LPSHORT      lpNumFiles;       
    LPFILELISTENTRY lpEntry;
    
    if (Item < 0 || Item > MAXPICKITEMS-1)
    	return FALSE;
    if (PickList[Item].FileNum == -1) //used in mergetag process in shapefile load
    {
    	_fstrcpy (PickName,PltName);
    	return TRUE;
    }
    SaveView = CurView;     
    SaveIgnoreBounds = IgnoreBounds;
    IgnoreBounds=TRUE;    
    SetViewport (PickList[Item].ViewID);
   	SaveCurFile = CurView->CurFile;
    if (PickList[Item].FileNum <0 || PickList[Item].FileNum >= CurView->NumFiles)
		goto RtnFalse;
    CurView->CurFile = PickList[Item].FileNum; 
    FileNum = CurView->CurFile;
    SubFile = max (0,CurView->SubFile-1);
    if (CurView->FileType[CurView->CurFile]<4)
    {
        _fstrcpy (PickName,CurView->lpFiles[CurView->CurFile]);
    }
    else
    { 
        if (CurView->hlpIndex[CurView->CurFile]) 
            CloseMapIndex (CurView->lpFiles[CurView->CurFile],
                           CurView->hlpIndex[CurView->CurFile],FALSE); 
                           
        if (PickList[Item].SubFile)
        {   
            _fstrcpy (OrigFile,CurView->lpFiles[CurView->CurFile]);
        	if (UseBinFileList) 
        	{
            	char        File[128], drive[8], dir[128];
            
	            _fstrcpy (File,OrigFile);
	            ExpandText (File);
	            _splitpath (File,drive,dir,0,0);
	            sprintf (File,"%s%sfilelist.bin",drive,dir);
            	hBinFileList = LoadBinaryFileList (OrigFile,File);
		        lpNumFiles = (LPSHORT)GlobalLock (hBinFileList);
		        NumFiles = *lpNumFiles;   
		        if ((PickList[Item].SubFile-1) > NumFiles || !NumFiles)
		        {   
		            GSSiGlobUlFree (&hBinFileList);
		            goto RtnFalse;
		        }
		        lpNumFiles++;
		        lpEntry = (LPFILELISTENTRY)lpNumFiles;
		        lpEntry += (PickList[Item].SubFile - 1);
		        _fstrcpy(CurView->lpFiles[CurView->CurFile],lpEntry->Name); 
		        GSSiGlobUlFree (&hBinFileList); 
		    }
        	else
        	{
	            FidSub = GSSiOpenFile(CurView->lpFiles[CurView->CurFile],&OFStruct,OF_READ);
	            if (FidSub == HFILE_ERROR)
	                goto RtnFalse;
	            ifile = 1;
	            while (ifile <= PickList[Item].SubFile)
	            {
	                if (!fgetstring(SubFileName,128,FidSub))
	                {
	                    GSSiClose (FidSub);
	                    goto RtnFalse;
	                }
	                ifile++;
	            }
	            GSSiClose (FidSub);
	            _fstrcpy (CurView->lpFiles[CurView->CurFile],SubFileName);
	        }
        }
        
        if (!(CurView->hlpIndex[CurView->CurFile]=
            OpenMapIndex (CurView->lpFiles[CurView->CurFile]))) goto RtnFalse; 
        lpIndex = (LPFILEINDEX)GlobalLock(CurView->hlpIndex[CurView->CurFile]);
            
Next:
        GetNextIndexEntry(lpIndex);
        if (lpIndex->FileInIndex < PickList[Item].FileInIndex)
        {
	        if (lpIndex->FileInIndex >=(long)lpIndex->NumFiles)
	        {   
	            if (!(lpIndex=GetNextIndexHeader(&CurView->hlpIndex[CurView->CurFile])))
	                goto RtnFalse;
	        }
            goto Next;  
        }
        
        _fstrcpy (PickName,lpIndex->CurrentEntry->Name);
        lpSlash = _fstrrchr(PickName,'\\');
        if (!lpSlash)
        {
            _fstrcpy (PickName,CurView->lpFiles[CurView->CurFile]);
            lpSlash = _fstrrchr(PickName,'\\');
            if (lpSlash)
            {
                ++lpSlash;
                *lpSlash = '\0';
            }
            _fstrcat (PickName,lpIndex->CurrentEntry->Name); 
        }
		lpParen=_fstrrchr (PickName,'(');
		if (lpParen)
			*lpParen++ = 0;
        GlobalUnlock(CurView->hlpIndex[CurView->CurFile]);
        CloseMapIndex (CurView->lpFiles[CurView->CurFile],
                       CurView->hlpIndex[CurView->CurFile],FALSE);
        CurView->hlpIndex[CurView->CurFile] = 0;

    }
    PltType = CurView->FileType[CurView->CurFile]; 
    if (OrigFile[0])
        _fstrcpy (CurView->lpFiles[CurView->CurFile],OrigFile);
    CurView->CurFile = SaveCurFile;
    SetCurView ( SaveView); 
    IgnoreBounds = SaveIgnoreBounds;
    return (TRUE);     
RtnFalse:    
    IgnoreBounds = SaveIgnoreBounds;
    if (OrigFile[0])
        _fstrcpy (CurView->lpFiles[CurView->CurFile],OrigFile);
    CurView->CurFile = SaveCurFile;
    SetCurView ( SaveView);
    PickName[0]=0;
    return (FALSE);
}


BOOL GetNextViewportFile (BOOL VisScan)
{   
    char    Mess[256];
    short    ii;     
    long	Offset=-1;
    MNMXCORD    Bounds, TestBounds;
    LPFILEINDEX lpIndex;
    LPVIEWPORT  SaveView;
    LPSTR   lpSlash;
    float   RSQMIN;
    double  BASEX[4], BASEY[4], BMX[4], BMY[4]; 
    static  BOOL    UseAVI=FALSE; 
    char    drive[8], dir[128], CurEntryName[128];
    LPSTR	lpParen;
    
    if (!ContinueProcessing)
        return (FALSE);
    
    if (CurView->ID == CommandViewport && DisplayOnlyHLT)
    {   
    	if (CurView->CurFile < 0)
    	{
	    	*PltName = 0;
	    	PltType = 6;
	    	CurView->CurFile = 1;
		    StartHLTRef = LONG_MIN;		
	    	return TRUE;
	    }
	    else
	    	return FALSE;
    }
Start:
    if (CurView->CurFile == -1)
    	IncrementFile (); 
    if (CurView->CurFile >= CurView->NumFiles)
        return (FALSE);
    FileNum = CurView->CurFile;
    SubFile = max (0,CurView->SubFile-1);  
    PltType = CurView->FileType[CurView->CurFile];

    if (CurView->FileType[CurView->CurFile]==6)
    {
        IncrementFile (); 
	   	return (TRUE);
    }     
    if (CurView->FileType[CurView->CurFile]<4)
    {   
    	 ConvertLayer = -1;
//    	 if (!VisScan && !PeopleNet) removed 5/7/01 - ConvertCoordClose now called whenever [%ALT_PROJECTION] is set
//	     	ConvertCoordClose ();
         _fstrcpy (PltName,CurView->lpFiles[CurView->CurFile]);
         FileInIndex = 0; 
         if (!VisScan && !PeopleNet && !FastPick)
         {
			 ProcessGlobal ("[%LAYERINIT]");
	         _fstrcpy (Mess,PltName);
	         ExpandText (Mess);
	         _splitpath (Mess,drive,dir,0,0);
	         sprintf (Mess,"%s%sglobal.ini",drive,dir);
	         LoadGlobalInit (Mess,FALSE); 
	     }
         IncrementFile (); 
         if (ForceRefIndex || ForceTAGIndex || UseRefOrTAGIndex)
            OpenRefIndex(TRUE);
         goto DisplayFile;
    } 
    if (VisScan && CurView->FileType[CurView->CurFile]==5)
    {
        IncrementFile ();
        goto Start;
    }
        
    if (!CurView->hlpIndex[CurView->CurFile]) 
    {
        if (!(CurView->hlpIndex[CurView->CurFile]=
            OpenMapIndex (CurView->lpFiles[CurView->CurFile])))
        {
            IncrementFile ();
            goto Start;
        }
        _fstrcpy (PltName,CurView->lpFiles[CurView->CurFile]);
        UseAVI=FALSE;
        PltType = CurView->FileType[CurView->CurFile];
        if (PltType == 5)
        {
	        lpSlash = _fstrrchr(PltName,'\\');
	        if (lpSlash)
	        {
	            ++lpSlash;
	            *lpSlash = '\0';
	        } 
            _fstrcat (PltName,"orthos[%INDEXRES]"); 
            _fstrcat (PltName,ImageExtension); 
            
            if (ShowFileBounds || FileOnSystem(PltName)) 
                UseAVI=TRUE;       
        }
        lpIndex = (LPFILEINDEX)GlobalLock(CurView->hlpIndex[CurView->CurFile]);
        if (PltType != 5 && (ForceRefIndex || ForceTAGIndex || UseRefOrTAGIndex))
            OpenRefIndex(TRUE);
    }
    else
        lpIndex = (LPFILEINDEX)GlobalLock(CurView->hlpIndex[CurView->CurFile]);
            
Next: 
	if (!lpIndex)
    {
        IncrementFile ();
        goto Start;
    }
    if (lpIndex->FileInIndex >= (long)lpIndex->NumFiles)
    {   
            
        if (UpdateOrthoIndex && CurView->FileType[CurView->CurFile]==5)
        {   
            HFILE   FidIndex;
            OFSTRUCT    OFStruct;
            
            FidIndex = GSSiOpenFile(lpIndex->FileName,&OFStruct,OF_READWRITE);
            _llseek (FidIndex,lpIndex->FirstIndexFileOffset,0);
            _lwrite (FidIndex,&lpIndex->FirstIndex,(size_t)lpIndex->Length);
            GSSiClose (FidIndex);
        } 
        if (!(lpIndex=GetNextIndexHeader(&CurView->hlpIndex[CurView->CurFile])))
        {   
            IncrementFile ();
            goto Start;
        }
    }
    if (lpIndex->FirstFoundFile)
    {   
        lpIndex->FirstFoundFile=FALSE;
/*        if (CurView->FileType[CurView->CurFile]==5)
        { 
            if (CurView->WindowZoomedToOrtho && CurView->OrthoRes >=0)
            {
                CurView->OrthoRes = lpIndex->OrthoRes;
                SetNewBoundsToOrtho();
                SetBounds(CurView->hWnd,1);
            }
            else if (CurView->WindowIsZoomed)
                SetNewBoundsToBounds();
            else if (!CurView->HaveBounds)
            {
                SaveView = CurView;
                CurView = pViewports[0];
                Bounds = CurView->WBounds;
                CurView = SaveView;
                CurView->NewBounds = Bounds;
                SetBounds(CurView->hWnd,1); 
            }
        }*/
            
    }
    if (!GetNextIndexEntry(lpIndex))
    	goto Next; 
    _fstrcpy (CurEntryName,lpIndex->CurrentEntry->Name);
	lpParen=_fstrrchr (CurEntryName,'(');
	if (lpParen)
		*lpParen++ = 0;
    
    if (lpIndex->UsesTimes && lpParen)
    {
    	long	MinTime, MaxTime;
    	LPSTR	lpSpace=_fstrchr(lpParen,' ');
    	
    	*lpSpace++ = 0;
    	MinTime = atol (lpParen);
    	MaxTime = atol (lpSpace);
		if (MinTime > TimeRangeEnd || MaxTime < TimeRangeBeg)
    		goto Next;               
    }
    TestBounds = lpIndex->CurrentEntry->Bounds;
    if (!AdjustFileBounds (CurView->ID,CurView->CurFile,&TestBounds,CurEntryName))
    	goto NotIn;
    if (!RectInWBounds (&TestBounds))
    {
NotIn:   
        if (CurView->FileType[CurView->CurFile]!=5) goto Next; 
        if (!UpdateOrthoIndex) goto Next; 
    }
    if (CurView->OrthoDisplayName[0]&&CurView->FileType[CurView->CurFile]==5)
    {   
        char    TestName[128];
        
        _fstrcpy(TestName,CurEntryName);
        if (!_fstrchr (CurView->OrthoDisplayName,':'))
        {
            LPSTR   lpColon;
            
            lpColon = _fstrchr (TestName,':');
            if (lpColon)
                *lpColon = 0; 
            else
            {
                lpColon = _fstrrchr (TestName,'.');
                if (lpColon)
                    *lpColon = 0; 
            }
        }
        if (_fstricmp(CurView->OrthoDisplayName,TestName))
            goto Next;
    }
    if (CurView->FileType[CurView->CurFile]==5)
    {
        lpIndex->CurrentEntry->Bounds=TestBounds;
        ComputeIndexOrthoRes (lpIndex);
        if (CurView->OrthoRes >=0 && CurView->WindowZoomedToOrtho)
    		CurView->OrthoRes = lpIndex->OrthoRes;
    }
    _fstrcpy (PltName,CurEntryName);
    lpSlash = _fstrrchr(PltName,'\\');
    if (!lpSlash || UseAVI)
    {
        _fstrcpy (PltName,CurView->lpFiles[CurView->CurFile]);
        lpSlash = _fstrrchr(PltName,'\\');
        if (lpSlash)
        {
            ++lpSlash;
            *lpSlash = '\0';
        } 
        if (UseAVI)
        {
            _fstrcat (PltName,"orthos[%INDEXRES]");  
            _fstrcat (PltName,ImageExtension); 
        }
        else 
            _fstrcat (PltName,CurEntryName);
         
    } 
	ConvertNameToCDName (PltName);
    if (!UseAVI && !Pick)
    {
        if (!ExistFile (PltName)) 
        {
        	GlobalUnlock (CurView->hlpIndex[CurView->CurFile]);
            goto Start;
        } 
    }

    PltType = CurView->FileType[CurView->CurFile];
    if (PltType == 4) goto Exit;  
    if (UseAVI) 
    {   
    	LPSTR	lpAT;
    	
    	if ((lpAT = _fstrrchr (lpIndex->CurrentEntry->Name,'@')))
    	{
    		lpAT++;
    		CurOrthoFrame = atol (lpAT); 
    		if (CurOrthoFrame < 0)
    			goto Next;
    	}
    	else
        	CurOrthoFrame = lpIndex->FileInIndex-1;
    }
    else
        CurOrthoFrame = -1;
    ExpandText (PltName);
    if (!OrthoInBuffer(PltName, CurOrthoFrame))
    {  
    	LPORTHO CurOrtho = (LPORTHO)GlobalLock (hOrthos) + OrthoID; 
    	
        _fstrcpy (CurOrtho->Name,PltName);
        _fstrcpy (CurOrtho->OrigName,CurEntryName); 
        CurOrtho->Frame = CurOrthoFrame;
        CurOrtho->Bounds = lpIndex->CurrentEntry->Bounds;
        CurOrtho->Width=lpIndex->CurrentEntry->BMWidth;
        CurOrtho->Height=lpIndex->CurrentEntry->BMHeight; 
        CurOrtho->BitCount=lpIndex->CurrentEntry->BMBitCount;
        ComputeIndexOrthoRes (lpIndex);
        CurOrtho->Res = lpIndex->OrthoRes; 
        GlobalUnlock (hOrthos);
    } 
    {
    	LPORTHO CurOrtho = (LPORTHO)GlobalLock (hOrthos) + OrthoID; 
     
	    Offset = CurOrthoFrame;
	    CurOrtho->LastUsed = OrthoUse++;
	    CloseTRANS2 (&hTranBMToBase);
	    CloseTRANS2 (&hTranBaseToBM); 
	    if (CurOrtho->BitCount != 8)
	        ii=1;
	    BMX[0]=-1;
	    BMX[1]=-1;
	    BMX[2]=lpIndex->CurrentEntry->BMWidth;
	    BMX[3]=BMX[2];
	    BMY[0]=-1;
	    BMY[1]=lpIndex->CurrentEntry->BMHeight;
	    BMY[2]=BMY[1];
	    BMY[3]=-1;
	    BASEX[0]=CurOrtho->Bounds.xmn-CurOrtho->Res;
	    BASEX[1]=BASEX[0];
	    BASEX[2]=CurOrtho->Bounds.xmx+CurOrtho->Res;
	    BASEX[3]=BASEX[2];
	    BASEY[0]=CurOrtho->Bounds.ymn-CurOrtho->Res;
	    BASEY[1]=CurOrtho->Bounds.ymx+CurOrtho->Res;
	    BASEY[2]=BASEY[1];
	    BASEY[3]=BASEY[0];
		CurView->FileMNMX=CurOrtho->Bounds;
	    hTranBMToBase = STRAN2 (BMX,BMY,BASEX,BASEY,4,&RSQMIN,1,NULL);
	    hTranBaseToBM = STRAN2 (BASEX,BASEY,BMX,BMY,4,&RSQMIN,1,NULL);
        GlobalUnlock (hOrthos);
	}
Exit:
    GlobalUnlock(CurView->hlpIndex[CurView->CurFile]); 
    FileInIndex = lpIndex->FileInIndex; 
DisplayFile:
    if (ForceRefIndex || ForceTAGIndex)
    {   
        char    str[128], Type[12];
        
        if (ForceRefIndex)
        	_fstrcpy (Type,"reference");
        else
        	_fstrcpy (Type,"TAG");                                     
        sprintf (str,"Building %s index",Type);
   		StatusWindowUpdate (str,PltName, NumCopyFiles,++CopyFileNum);
    }  
    if (GetGlobalBVal ("[%DISPLAYFILENAME]")) 
    	SetWindowText (hWndMain,PltName); 
    if (DoMapCopy)
    {
    	if (CurView->SubFile)
	    	CopyMapFile(CurView->OrigFile,PltName,Offset,CurFileIndexEntry);
    	else
	    	CopyMapFile(CurView->lpFiles[FileNum],PltName,Offset,CurFileIndexEntry);
	}
/*    if (RestartOption)
    {
        HFILE   FidRestart;
        OFSTRUCT    OFStruct;
        
        if (RestartName[0])
        {
            if (_fstricmp (RestartName,PltName)==0)
                RestartName[0]=0; 
            if (FileNum)
                goto Start;
        }
        FidRestart = GSSiOpenFile ("restart.txt",&OFStruct,OF_CREATE);
        fputstring (PltName,FidRestart);
        GSSiClose (FidRestart);
    } */
    return (TRUE);
}                        

double ComputeRes (short h, short w, MNMXCORD bounds)
{   double dBM, dBase, res;

    dBM = LDIST (1,1,w,h);
    dBase = LDIST (bounds.xmn,bounds.ymn,bounds.xmx,bounds.ymx);
    res = dBase / dBM;
    return (res);
    
} 

void IncrementFile ()
{
    short       NumFiles;
    LPINT       lpNumFiles;       
    MNMXCORD    TestBounds; 
    char		str[256];
    
    if (!CurView)
    	return;                     
Start:    
    if (CurView->SubFile)
    {   
        LPFILELISTENTRY lpEntry;
        
        if (CurView->SubFile == 1 ||
        	(CurView->CurFile >= 0 && CurView->SubFile > 1 && !CurView->hBinFileList))
        {   
            char        File[128], drive[8], dir[128];
            
			ProcessGlobal ("[%LAYERINIT]");
		    SetGlobalValue ("%LAYER_PROJECTION","");
		    if (!PeopleNet)
	    		ConvertCoordClose ();
            _fstrcpy (File,CurView->OrigFile);
            ExpandText (File);
            _splitpath (File,drive,dir,0,0);
            sprintf (File,"%s%sglobal.ini",drive,dir);
            LoadGlobalInit (File,FALSE);
			GetViewportScale (CurView->hDC); 
            sprintf (File,"%s%sfilelist.bin",drive,dir);
            if (!PeopleNet)
            {
	            _fstrcpy (str,"[%LAYER_PROJECTION]");  
			    SetGlobalValue ("%ALT_PROJECTION",str); 
	            ExpandText (str);
	            if (*str)
				    ConvertLayer = CurView->CurFile;
	            else
	            	ConvertLayer = -1;
	        }	
            CurView->hBinFileList = LoadBinaryFileList (CurView->OrigFile,File);
        }  
        lpNumFiles = (LPSHORT)GlobalLock (CurView->hBinFileList);
        NumFiles = *lpNumFiles;   
        if (CurView->SubFile > NumFiles || !NumFiles)
        {   
            GSSiGlobUlFree (&CurView->hBinFileList);
            goto NextFile;
        }
        lpNumFiles++;
        lpEntry = (LPFILELISTENTRY)lpNumFiles;
        lpEntry += (CurView->SubFile - 1);
        
        CurView->SubFile++;  
	    TestBounds = lpEntry->MinMax;
	    if (!AdjustFileBounds (CurView->ID,CurView->CurFile,&TestBounds,NULL)) 
	    {
	        GlobalUnlock (CurView->hBinFileList);
	    	goto Start;
        }
        if (!RectInWBounds(&TestBounds))
	    {
	        GlobalUnlock (CurView->hBinFileList);
	    	goto Start;
        }
        _fstrcpy(CurView->lpFiles[CurView->CurFile],lpEntry->Name); 
        GlobalUnlock (CurView->hBinFileList);
        return;
    }
NextFile: 
    if (CurView->SubFile)
        _fstrcpy (CurView->lpFiles[CurView->RestoreFile],CurView->OrigFile);
    CurView->CurFile++;   
    CurView->SubFile = CurView->RestoreFile =0;
    CloseOrthoAVI ();
    if (!CurView->CurFile) CurView->FirstFile = TRUE;
    if (CurView->CurFile >= CurView->NumFiles)
    {   
    	return; 
    }
    if (CurView->hlpIndex[CurView->CurFile]) 
    {
        CloseMapIndex (CurView->lpFiles[CurView->CurFile],
                       CurView->hlpIndex[CurView->CurFile],FALSE);
        CurView->hlpIndex[CurView->CurFile] = 0;   
    }
    _fstrupr (CurView->lpFiles[CurView->CurFile]); 
    if (!CurVis || !CurVis->FileIsVisible[CurView->CurFile]) goto NextFile; 
    if (!AutoTypeConvert ())
    	goto NextFile;
    if (CurVis->FileIsVisible[CurView->CurFile]==2 && CurView->PassID == 2) goto NextFile;
    if ((CurView->FileType[CurView->CurFile]!=3 && CurView->FileType[CurView->CurFile]!=5)&& CurView->PassID ==1)
        goto NextFile;
    if (CurView->FileType[CurView->CurFile]==5 && (!CurVis->WantType[5] || ForceTAGIndex || ForceRefIndex || ReorgFile))
        goto NextFile;
    if (CurView->FileType[CurView->CurFile]==5 && CurView->PassID !=1 && CurView->PassID != 5 && !PickOrtho)
        goto NextFile;
    if (CurView->FileType[CurView->CurFile]==6 && Pick)
        goto NextFile;
	if (!PeopleNet && (!FastPick || CurView->CurFile != FastPickFileNum || FileInIndex != FastPickFII) &&
		 CurView->FileType[CurView->CurFile]!=6)
	{      
    	if (!ExistFile (CurView->lpFiles[CurView->CurFile]))
        	goto NextFile;
    }
    if (_fstrstr(CurView->lpFiles[CurView->CurFile],"FILELIST.TXT"))
    {
        CurView->SubFile=1;CurView->RestoreFile=CurView->CurFile;
        _fstrcpy (CurView->OrigFile,CurView->lpFiles[CurView->CurFile]);
        goto Start;
    } 
    if (ForceTAGIndex || ForceRefIndex)
    {   
    	char	TAGVisList[128], str[128]; 
    	LPSTR	lpBS;
    	
    	if (CurView->FileType[CurView->CurFile]==6)
    		goto NextFile;
    	_fstrcpy (str,CurView->lpFiles[CurView->CurFile]);
    	ExpandText(str);
    	_fullpath (TAGVisList,str,128); 
    	lpBS = _fstrrchr (TAGVisList,'\\');
    	lpBS++;
    	*lpBS = 0; 
    	if (ForceTAGIndex)
    		_fstrcat (TAGVisList,"tagindex.vis");
    	else
    		_fstrcat (TAGVisList,"refindex.vis");
 	    if (ExistFile(TAGVisList))
		 	LoadVisList (TAGVisList);
		else
			InitVis ();
    }
    StartHLTRef = LONG_MIN;		
    return;
}  

BOOL AutoTypeConvert (void)
{
    if (AutoType && (CurView->FileType[CurView->CurFile]==2 || CurView->FileType[CurView->CurFile]==4))
    {
    	LPSTR	pPlt=_fstrstr (CurView->lpFiles[CurView->CurFile],".PLT");
    	short	itype;
    	 
    	if (pPlt)
    	{
    		pPlt += 4;
    		*pPlt = 0;
    		itype = FileType (CurView->lpFiles[CurView->CurFile]);
    		switch (itype)
    		{ 
    			case 0:
    				return FALSE;
    			case 1: 
    				CurView->FileType[CurView->CurFile] = 2;
    				break;
    			case 2: 
    				CurView->FileType[CurView->CurFile] = 4;
    				_fstrcat (CurView->lpFiles[CurView->CurFile],"\\INDEX");
    				break;
    		}
    	}
    }
    return TRUE;
}

HANDLE LoadBinaryFileList (LPSTR TextFile,LPSTR BinFile)
{  
    HFILE   FidTxt, FidBin;
    struct _stat    stattxt, statbin; 
    double  dtime;
    short     ii, NumFiles; 
    LPINT   lpNumFiles;
    OFSTRUCT    OFStruct;
    long     len;
    LPFILELISTENTRY lpEntry;  
    HANDLE  hBinFileList;   
    char    str[132];
    
    if (PeopleNet)
    {   
    	statbin.st_size = UINT_MAX;
		FidBin = GSSiOpenFile (BinFile,(LPOFSTRUCT)&OFStruct,OF_READ);
		if (FidBin != HFILE_ERROR)
			goto GetBin;
	}
    FidTxt = GSSiOpenFile (TextFile,(LPOFSTRUCT)&OFStruct,OF_READ);
    if (FidTxt==HFILE_ERROR) 
        return 0;  
    if (!UseBinFileList)
    	goto MakeBin;
    ii=_fstat (FidTxt,&stattxt);
    FidBin = GSSiOpenFile (BinFile,(LPOFSTRUCT)&OFStruct,OF_READ);
    if (FidBin==HFILE_ERROR) 
        goto MakeBin;
    ii=_fstat (FidBin,&statbin);
    dtime = difftime (stattxt.st_mtime,statbin.st_mtime);
    if (dtime<0 && statbin.st_size) 
    {
        GSSiClose (FidTxt);
        goto GetBin;
    }
    GSSiClose (FidBin); 
    
MakeBin:
    if (UseBinFileList)
    	FidBin = GSSiOpenFile (BinFile,(LPOFSTRUCT)&OFStruct,OF_CREATE);
    NumFiles = 0;    
    hBinFileList = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
    lpNumFiles = (LPSHORT)GlobalLock (hBinFileList);
    lpNumFiles++;
    lpEntry = (LPFILELISTENTRY)lpNumFiles;
    len = 2;
    while (fgetstring(str,128,FidTxt))
    {   
    	Truncate (str);
        _fstrcpy (lpEntry->Name,str);
        if (GetMapIndexBounds (lpEntry->Name,&lpEntry->MinMax))
        {
	        NumFiles++; 
	        lpEntry++; 
	        len += sizeof(FILELISTENTRY); 
	    }
    }
    GSSiClose (FidTxt); 
    GlobalUnlock (hBinFileList);  
    lpNumFiles = (LPSHORT)GlobalLock (hBinFileList);
    *lpNumFiles = NumFiles;
    if (!UseBinFileList) 
    {
    	GlobalUnlock (hBinFileList);  
	    return hBinFileList;
	}
    _lwrite (FidBin,lpNumFiles,(UINT)len); 
    GSSiClose (FidBin);
    GSSiGlobUlFree (&hBinFileList);
    FidBin = GSSiOpenFile (BinFile,(LPOFSTRUCT)&OFStruct,OF_READ);
    ii=_fstat (FidBin,&statbin);
    
GetBin:
    hBinFileList = GSSiGlobAlloc (GMEM_MOVEABLE,statbin.st_size);
    lpNumFiles = (LPSHORT)GlobalLock (hBinFileList);
    _lread (FidBin,lpNumFiles,(UINT)statbin.st_size);
    GlobalUnlock (hBinFileList);
    GSSiClose (FidBin);   
    return hBinFileList;
}
 
