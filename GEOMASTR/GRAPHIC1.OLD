{
    SelectObject(hDC, HighlightBrush); 
//    SetTextColor (hDC,RGB(255,0,0));
//    SetBkMode (hDC,TRANSPARENT);
    return;
}

BOOL WindowZoom (HWND hWnd, WORD Message, WORD wParam, LPARAM lParam)
{ switch (Message)
   {
    case GF_INIT:
        CurView->ZBRect = CurView->DrawRect;
        AddGraphicsFunction (hWnd, GF_ZOOM_RECT,0);
        break;

    case GF_COMPLETE: 
        if (ZoomBoxRect.xmn < ZoomBoxRect.xmx)  
        {
            CurView->NewBounds = ZoomBoxRect;
            if (CurView->OrthoRes >=0 && CurView->WindowZoomedToOrtho == 1)
                CurView->WindowZoomedToOrtho = 0;  
        	RemoveGraphicsFunction (hWnd);  
        	ClearCurrentCD ();
            DisplayCycle++;
            SetBounds (hWnd,CurView->hDC);  
            DisplayCycle--;
		    CurView->CurZoomAreaRef = 0;
            RedisplayViewport(FALSE,FALSE);
            CurView->WindowIsZoomed = TRUE;
	        ZoomBoxRect.xmn=2;
	        ZoomBoxRect.xmx=1;
        }
        else
			PostMessage(hWnd, GF_CLOSE,0, 0L); 
        break;

    default:
        return (FALSE);
    }
    return (TRUE);
} 

BOOL SelectViewport (POINT MousePoint,BOOL MapsOnly, BOOL DigitizerInput)
{    
    LPVIEWPORT  SaveView;
    short         iview;
    
    if (IgnoreSelectVP)
    	return TRUE;
    SaveView = CurView;
//    CloseMap (FALSE);
    if (DigitizerInput)
    {   
    	SetViewport(CommandViewport);
    	CurVis = CurView->pVisList1;   
        SetFocus (CurView->hWnd); 
        return CurView->ID;
    }
    for (iview = NumViewports-1;iview>=0; iview--)
//    for (iview = 0; iview < NumViewports; iview++)
    {   SetCurView ( pViewportsD[iview]); 
        if (CurViewActive() && !CurView->DisplayInParent && (!MapsOnly || CurView->Type == 1))
        if (PtInRect (&CurView->Rect,MousePoint))
        {   CurVis = CurView->pVisList1;   
            SetFocus (CurView->hWnd);
            SetViewport (CurView->ID);  
			if (!CurView->LinkedTo)
				RemoveLinkedCursors (); 
			if (LastVP && LastVP != CurView)
			{   
				DisplayProfileLoc (NULL,NULL,NULL);
			    NotifyFunction (LastVP,GF_EXIT_VIEWPORT);  
				LastVP = CurView;
			    NotifyFunction (LastVP,GF_ENTER_VIEWPORT);  
			} 
			else
				LastVP = CurView;
            return CurView->ID;
        }
    }
    SetCurView ( SaveView);
    RemoveLinkedCursors ();
    NotifyFunction (LastVP,GF_EXIT_VIEWPORT);  
    LastVP = 0;
    return FALSE;
}

BOOL SetAutoPan (BOOL AP)
{   BOOL oldAP;

    oldAP = AutoPan;
    AutoPan = AP;
    return (oldAP);
}

short PanWindow (HWND hWnd, float PanVert, float PanHorz)
{    double bwidth, bheight;

	 DoPaint = TRUE;
     bwidth = CurView->WBounds.xmx - CurView->WBounds.xmn;
     bheight = CurView->WBounds.ymx - CurView->WBounds.ymn;
     CurView->NewBounds.xmn = CurView->WBounds.xmn + PanHorz * bwidth;
     CurView->NewBounds.ymn = CurView->WBounds.ymn + PanVert * bheight;
     CurView->NewBounds.xmx = CurView->NewBounds.xmn + bwidth;
     CurView->NewBounds.ymx = CurView->NewBounds.ymn + bheight;    
	 CurView->CurZoomAreaRef = 0;
     ZoomToRect(CurView->NewBounds,FALSE);

/*     DisplayCycle++;
     SetBounds (hWnd,CurView->hDC);
     DisplayCycle--;
     RedisplayViewport(FALSE,FALSE);
     CurView->WindowIsZoomed = TRUE;*/
     return (0);
}

POINT WinCoordToFileCoord(POINT WinPoint)
{  
     DPOINT BasePt;


     BasePt = WinPtToBasePt (WinPoint);
     return (BasePtToFilePt(BasePt));
     
}

DPOINT WinCoordToFileCoordD(POINT WinPoint)
{  
     DPOINT BasePt;

     BasePt = WinPtToBasePt (WinPoint);
     return (BasePtToFilePtD(BasePt));
     
}

DPOINT WinCoordToVPCoord(POINT WinPoint)
{    float  xfactor, yfactor;
     long   rect_width, rect_height;
     double bwidth, bheight;
     short    xinc, yinc;
     RECT   Rect;
     DPOINT OutPoint;

     Rect = CurrentRect;

     rect_width = Rect.right - Rect.left;
     rect_height = Rect.bottom - Rect.top;
     if (!rect_width || !rect_height) 
     {
        OutPoint.x = 0;
        OutPoint.y = 0;
        return (OutPoint);
     }
     xfactor = ((float)WinPoint.x-Rect.left)/rect_width;
     yfactor = (float)(1.0 - ((float)WinPoint.y-Rect.top)/rect_height);
     bwidth = CurView->Bounds.xmx - CurView->Bounds.xmn;
     bheight = CurView->Bounds.ymx - CurView->Bounds.ymn;
     xinc = (short) (xfactor * bwidth);
     OutPoint.x = CurView->Bounds.xmn + xinc;
     yinc = (short) (yfactor * bheight);
     OutPoint.y = CurView->Bounds.ymn + yinc;
     return (OutPoint);
}    

POINT FileCoordToWinCoord(POINT SegPoint)
{  
     POINT  OutPoint; 
     DPOINT BasePoint;
     
     BasePoint = FilePtToBasePt(SegPoint);
     OutPoint = BasePtToWinPt (&BasePoint);

     return (OutPoint);
}
BOOL SetRezoomBounds (MNMXCORD Bounds)
{                                     
    if (RezoomRect.xmx < RezoomRect.xmn)
    {
        RezoomRect = Bounds;
        return TRUE;
    }
    else
        return FALSE;
}
void UnallocateConfig ()
{   short iview, ifile;
    HANDLE handle;
    
    if (FidConfig == HFILE_ERROR)
    	return;  
    RemoveAllInfoBoxRect();
    GSSiGlobFree (&hMenuMask);  
    LastVP = 0;
    for (iview=0;iview<NumViewports;iview++)
    {   
        SetCurView ( pViewports[iview]);
        if (!CurView) break; 
    	ClearPolyOff ();
//        SaveDisplayRedefFile(CurView->DisplayRedefFile);
        if (CurView->hPenRedef)
            GlobalFree (CurView->hPenRedef);
        CurView->hPenRedef=0;
	 	DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);  
	 	CurView->DisplayFunStack = 0; 
	 	DisplayFunctionStack ();
        for (ifile=0;ifile<CurView->NumFiles;ifile++)
        {
            if (CurView->FileType[ifile]>3 && CurView->hlpIndex[ifile])
            {
                CloseMapIndex (CurView->lpFiles[ifile],
                               CurView->hlpIndex[ifile],FALSE);
                CurView->hlpIndex[ifile] = 0;
            }
        }
        CloseObject (CurView->pTheme);  
       	GSSiGlobFree (&CurView->ToolbarHandle);   
	    GSSiGlobFree (&CurView->hProfileRoute);
	    GSSiGlobFree (&CurView->hProfileElev);
        BoundsDisplayDestroy (CurView->lpBoundsDisplay); 
        CurView->lpBoundsDisplay=0;
        
        if (IsBadStringPtr(CurView->pVisList1, sizeof(VISLIST)))
        	CurView->pVisList1 = 0;
        CurVis = CurView->pVisList1;
        if (CurView->pVisListManual == CurVis)
            CurView->pVisListManual=0;
        while (CurVis)
        {
            handle = CurVis->hVisList;
            CurVis =  (LPVISLIST) CurVis->NextVisList;
            GlobalUnlock(handle);
            GlobalFree(handle);
        }   
        CurVis = CurView->pPickList1;  
        if (CurView->pPickListManual == CurVis)
            CurView->pPickListManual=0;
        while (CurVis)
        {
            handle = CurVis->hVisList;
            CurVis =  (LPVISLIST) CurVis->NextVisList;
            GSSiGlobUlFree (&handle);
        }   
        if (CurView->pVisListManual)
        {
            handle = CurView->pVisListManual->hVisList;
            GSSiGlobUlFree (&handle);
        }
        if (CurView->pPickListManual)
        {
            handle = CurView->pPickListManual->hVisList;
            GSSiGlobUlFree (&handle);
        } 
        {
		    HANDLE	hLast;
			LPCMDSTRING    pCmdStr; 
					
		    while (CurView->FunStackHandle)
		    { 
		    	pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
		    	if (!pCmdStr)
		    	{
		    		CurView->FunStackHandle	= 0;
		    		break;
		    	}
		    	hLast = pCmdStr->PrevHandle;
		    	GSSiGlobFree (&pCmdStr->hError);
	    		GSSiGlobUlFree (&CurView->FunStackHandle);
	    		CurView->FunStackHandle = hLast; 
	    	}
		}        
	 	CloseEditRect();
        if (CurView->hTAGList) 
            GlobalFree(CurView->hTAGList); 
        UnloadReport (CurView->hReport);  
            CurView->hReport=0;
            
        DestroySavedScreen (&CurView->LinkedCursorHandle,0);
        CloseTRANS2 (&CurView->hTranWinToBase);
        CloseTRANS2 (&CurView->hTranBaseToWin);
        if (CurView->hFileTransIn > 1)
        { 
        	CloseTRANS2 (&CurView->hFileTransIn); 
        	CloseTRANS2 (&CurView->hFileTransOut);
        } 
        CurView->hFileTransIn = 0;

        GSSiGlobUlFree (&hViewports[iview]);
        pViewports[iview] = 0;
    } 
    if (hViewportsMenu) 
    {
        short ii;
        ii = DestroyMenu (hViewportsMenu);
    }
    SetCurView (0);
    hViewportsMenu = 0;
    ClearTAGs();
	CloseOrthos ();
    FidConfig = HFILE_ERROR;
    NumViewports = 0;  
    CommandViewport = 0;
    NumPassiveFun = 0;  
//	if (hWndPrompt)
//	    DestroyWindow(hWndPrompt);
	CloseGEOSPANVideo ();
	SetGlobalValue ("%OPENVIDEOWINDOW","F");
    ConfigLoaded = FALSE;
    return;
}
BOOL OpenConfig (HWND hWnd,HDC hDC)
{   short     Signature, Version, n;
    OFSTRUCT    OFStruct;  
    HANDLE		hVisList;
    short     len, iv,MenuMask, i;
    LPVIEWPORT  SaveView;
    LPSTR   LastVisList;
    LPVISLIST   SaveVis;
    short     imenu,   NumIB;
    short     NumViews;
    LPSHORT   lpMenuMask; 
    long    ii;   
    char    Cfg[16], str[256], FullPath[128], Suffix[8];
    LPSTR	pStr; 
    static	BOOL	First = TRUE;
    
    if (FidConfig != HFILE_ERROR)
    	return (TRUE);
    if (!CfgName[0])
    	return (FALSE);    
    if (CreateConfig)
    	CreateTestConfig ();   
    CreateConfig = FALSE;
    if (!ConfigLevel)
     	_fstrcpy (Lev0CfgName,CfgName);
    
    nAVLVP = 0;
    LastVP = CurView = 0;
    RezoomRect.xmn = 0;
    RezoomRect.xmx = -1;
    NumViewports = 0;  
    _fmemset (pViewports,0,MAX_VIEWPORTS*sizeof(LPVIEWPORT)); 
    ExpandText (CfgName); 
    _fullpath (FullPath,CfgName,sizeof(FullPath)); 
    _fstrlwr (FullPath);
    _splitpath (FullPath,0,0,Cfg,Suffix);
    if (!*Suffix)
    	_fstrcat (FullPath,".gmc");
    SetGlobalValue ("%CONFIGPATH",FullPath); 
    SetGlobalValue ("%CONFIG",Cfg);
    sprintf (str,"GeoMaster: %s",FullPath);
    SetGlobalValue ("%WT",str);
    FidConfig = GSSiOpenFile (FullPath,(LPOFSTRUCT)&OFStruct,OF_READ);
    if (FidConfig == HFILE_ERROR) 
    {   char    DLName[128];
    
        _fstrcpy (DLName,"[%DATA_LOC]");
        _fstrcat (DLName,CfgName);
        FidConfig = GSSiOpenFile (DLName,(LPOFSTRUCT)&OFStruct,OF_READ);
        if (FidConfig == HFILE_ERROR)
        {
            GSSiMessageBox("Configuration file not found",CfgName, MB_OK);
            return (FALSE);
        } 
    } 
	_fstat (FidConfig,&OpenConfigStat);
    SetGlobalValue ("%CONFIG",Cfg);
    SetCurVal (CfgName,IDS_FILEGMC);
    _llseek(FidConfig,(LONG)-(4),2);

    _lread (FidConfig,&Signature,2);
    _lread (FidConfig,&Version,2);
    if (Signature != 28052)
    {   CloseConfig ();
        GSSiMessageBox("This is not a valid configuration file",CfgName, MB_OK);
        return (FALSE);
    }
    if (Version > 4)
    {   CloseConfig ();
        GSSiMessageBox("This configuration file version is not recognized",CfgName, MB_OK);
        return(FALSE);
    }
    
    _llseek(FidConfig,0,0);
    if (Version >= 3)
    {   
    	pStr = GlobalLock (hStartupCommand);
        _lread (FidConfig,pStr,256);
        GlobalUnlock (hStartupCommand);
    	pStr = GlobalLock (hStartupMenu);
        _lread (FidConfig,pStr,128);
        OneSpace (pStr);
        GlobalUnlock (hStartupMenu);
        _lread (FidConfig,&NumIB,sizeof(NumIB));  
        while (NumIB--)
        {
            _lread(FidConfig,&TAGBox,sizeof(TAGBOX));
            SaveTAG(-1);
        }  
        pStr = GlobalLock (hStartupMenu);
        if (*pStr)
        {   
            if (!GMLoadMenu (hWndMain,pStr)) 
            {   
                char    mess[256];
                
                sprintf (mess,"Failed to load menu '%s'",pStr);
                GSSiMessageBox(mess,0, MB_OK|MB_ICONEXCLAMATION);
            }
        }
        else if (hUserMenu && hWnd) 
        {   
        	HMENU	hMenuOld = GetMenu (hWnd);  
        	HMENU	hMenu = LoadMenu (hInst,"GEOMASTER");
        	
			SetMenu (hWnd,hMenu); 
         	DestroyUserPopups (&hCurPopups);
			hUserMenu = 0;         
			if (hMenuOld)
				DestroyMenu (hMenuOld);  
        }
        GlobalUnlock (hStartupMenu);
    }   
    _lread (FidConfig,&NumViews,2);
    _lread (FidConfig,&CommandViewport,2); 
    if (!CommandViewport)
    	CommandViewport = 1;
    _lread (FidConfig,&NumMenuMask,sizeof(NumMenuMask)); 
    GSSiGlobFree (&hMenuMask);
    if (NumMenuMask)
    { 
	    hMenuMask=GSSiGlobAlloc(GMEM_MOVEABLE,(NumMenuMask+1)*sizeof(short));
	    lpMenuMask=(LPSHORT)GlobalLock(hMenuMask); 
	    for (imenu=0;imenu<NumMenuMask;imenu++,lpMenuMask++)
	    {
	        _lread (FidConfig,lpMenuMask,sizeof(MenuMask));  
	        if (hWnd)
	        {
	            if (!DeleteMenu (GetMenu(hWnd),*lpMenuMask,MF_BYCOMMAND))
	                ii=1;
	        }
	    }
	    GlobalUnlock(hMenuMask);
	} 
    if (hWnd) DrawMenuBar(hWnd); 
    _lread (FidConfig,&WindowColor,4);
    _lread(FidConfig,&TAGBox,sizeof(TAGBOX));
    ii=sizeof(VIEWPORT);
    ii=sizeof(NEWOBJECT);
    for (iv=0;iv<NumViews;iv++)
    {
        hViewports[iv]=GSSiGlobAlloc (GHND,sizeof(VIEWPORT)+MAX_VIEWPORT_FILES*128);
        SetCurView ( (LPVIEWPORT) GlobalLock (hViewports[iv]));
        pViewports[iv]=CurView;
        pViewportsD[iv]=CurView;
        if (Version == 1)
        {
            i=_lread (FidConfig,CurView,sizeof(VIEWPORT_v0));
            _fstrcpy (CurView->PickMacroFile,"pikmacro.txt"); 
        } 
        else if (Version < 4)
        {
            i=_lread (FidConfig,CurView,sizeof(VIEWPORT_v2)); 
            CurView->NumNewObjects=0; 
            _fmemset (CurView->NewObjectMap,0,sizeof(CurView->NewObjectMap));
        }
        else 
            i=_lread (FidConfig,CurView,sizeof(VIEWPORT));  
        if (CurView->ID < 1 || CurView->ID > MAX_VIEWPORTS)
        {
	        GSSiMessageBox("Corrupted configuration file",FullPath, MB_OK|MB_ICONEXCLAMATION);
	        return FALSE;
        }
        CurView->Version=4; 
        ClearVPFields (CurView);  
        CurView->hDC = hDC;
        CurView->hWnd = hWnd;   
        if (!_fstricmp (CurView->Name,"Format"))
        	CurView->Type = 0;
        if (CurView->UpdateFile > CurView->NumFiles)
        	CurView->UpdateFile = 0;
        CurView->NumNewObjects = min (CurView->NumNewObjects,100);
        if (CurView->OldFunctionStact0)
        {
        	CurView->StartupFunction = CurView->OldFunctionStact0;
        	CurView->OldFunctionStact0 = 0; 
        	_fmemset (CurView->Space2,0,sizeof(CurView->Space2));
        }        	
        if (!_fstricmp (CurView->FunctionDir,"fundir"))
            _fstrcpy (CurView->FunctionDir,"index.txt");
        if (CurView->Type != 7) CurView->ZoomTarget = 0;

        for (i=0;i<CurView->NumFiles;i++)
        {
            _lread (FidConfig,&len,2);
            CurView->lpFiles[i]=(LPSTR) &CurView->EndOfViewport + i * 128;
            _lread (FidConfig,CurView->lpFiles[i],len); 
            _fstrupr (CurView->lpFiles[i]);

        } 
        for (i=0;i<CurView->NumVisList;i++)
        {
            hVisList=GSSiGlobAlloc (GHND,sizeof(VISLIST));
            CurVis =(LPVISLIST) GlobalLock (hVisList);
            _lread (FidConfig,CurVis,sizeof(VISLIST));
            CurVis->hVisList = hVisList;
            if (!i)
            {
                CurView->pVisList1=CurVis;
                CurVis->LastVisList = 0;
            }
            else
            {   
                CurVis->LastVisList = LastVisList;
                SaveVis = CurVis;
                CurVis =(LPVISLIST) LastVisList;
                CurVis->NextVisList = (LPSTR)SaveVis;
                CurVis = SaveVis;
            }
            CurVis->NextVisList = 0;
            LastVisList = (LPSTR)CurVis;
        } 
        for (i=0;i<CurView->NumPickList;i++)
        {
            hVisList=GSSiGlobAlloc (GHND,sizeof(VISLIST));
            CurVis =(LPVISLIST) GlobalLock (hVisList);
            _lread (FidConfig,CurVis,sizeof(VISLIST));
            CurVis->hVisList = hVisList;
            if (!i)
            {
                CurView->pPickList1=CurVis;
                CurVis->LastVisList = 0;
            }
            else
            {   
                CurVis->LastVisList = LastVisList;
                SaveVis = CurVis;
                CurVis =(LPVISLIST) LastVisList;
                CurVis->NextVisList = (LPSTR)SaveVis;
                CurVis = SaveVis;
            }
            CurVis->NextVisList = 0;
            LastVisList = (LPSTR)CurVis;
        } 
        if (CurView->pVisListManual)
        {
            hVisList=GSSiGlobAlloc (GHND,sizeof(VISLIST));
            CurVis =(LPVISLIST) GlobalLock (hVisList);
            _lread (FidConfig,CurVis,sizeof(VISLIST));
            CurVis->hVisList = hVisList;   
            CurView->pVisListManual = CurVis;
        }
        if (CurView->pPickListManual)
        {
            hVisList=GSSiGlobAlloc (GHND,sizeof(VISLIST));
            CurVis =(LPVISLIST) GlobalLock (hVisList);
            _lread (FidConfig,CurVis,sizeof(VISLIST));
            CurVis->hVisList = hVisList;   
            CurView->pPickListManual = CurVis;
        }
        if (CurView->VisName[0])
            LoadVisList (CurView->VisName);
        if (CurView->PickName[0])
            LoadPickList (CurView->PickName);
        LoadDisplayRedefFile(CurView->DisplayRedefFile);   

        ReadObject(FidConfig,FALSE,NULL,OB_SAVEMASK);
        
        if (CurView->pTheme)
        {
            if (ReadObject(FidConfig,FALSE,&CurView->pTheme,0))
            	CurView->pTheme->DisplayViewport = CurView->ID;
        }
        if (CurView->BoundsDisplayID)
        {
            BoundsDisplayRead (&CurView->lpBoundsDisplay,FidConfig);
        }
        if (CurView->ZoomTarget && CurView->ZoomTarget < CurView->ID)
        {
            pViewportsD[iv] = pViewportsD[CurView->ZoomTarget-1];
            pViewportsD[CurView->ZoomTarget-1]=CurView;
        } 

//          AddActivateSwitch();

    }
    n = 0; 
    for (iv=0;iv<NumViews;iv++)
    {   
        if (pViewports[iv]->Type == 7)
            pViewportsD[n++] = pViewports[iv];
    }
    for (iv=0;iv<NumViews;iv++)
    {   
        if (pViewports[iv]->Type != 7 && !pViewports[iv]->pTheme)
            pViewportsD[n++] = pViewports[iv];
    }
    for (iv=0;iv<NumViews;iv++)
    {   
        if (pViewports[iv]->Type != 7 && pViewports[iv]->pTheme)
            pViewportsD[n++] = pViewports[iv];
    }
    
    for (iv=0;iv<NumViews;iv++)
    {
        SetCurView ( pViewports[iv]);  
//        sprintf (str,"%i %i",iv);
//        SetWindowText (hWndMain,str);
        if (CurView->pTheme)
        {
            SaveView = CurView;
            CurTheme = CurView->pTheme; 
            if (CurTheme->ID == GF_BOUNDS_DISPLAY_THEME)
            	CurTheme->NumVals = -1;
            if (CurTheme->TargetViewport)
            { 
	            SetCurView ( pViewports[CurTheme->TargetViewport-1]); 
	            if (CurView)
	            {
	                CurView->pThemes[CurView->NumThemes]=CurTheme;
	                CurView->NumThemes++;  
		            if (CurTheme->ID == GF_BOUNDS_DISPLAY_THEME) 
		            {
	                    BoundsDisplayDestroy (CurView->lpBoundsDisplay); 
				        CurView->lpBoundsDisplay=0;
				    }
	            }
	            SetCurView (SaveView);  
	        }
        }
    }
    LoadedHLTFromConfig = FALSE;
    while (ReadObject (FidConfig, FALSE,NULL,NULL));
    GSSiClose (FidConfig);
	LoadGlobalInit ("global.ini",FALSE);
	GetPrivateProfileString ("Install","InDir","c:\\geomastr",str,sizeof(str),"geomastr.ini"); 
	_fstrcat (str,"\\"); 
	SetGlobalValue("%INDIR",str);
    if (ExistFile ("startup.bmp") && FirstSchmooze && hWnd)
    { 
        FirstSchmooze=FALSE;
        {
#if WIN32
          DialogBox(hInst, (LPSTR)"SCHMOOZ", hWnd, SCHMOOZMsgProc);
#else
          FARPROC lpfnSCHMOOZMsgProc;
          lpfnSCHMOOZMsgProc = MakeProcInstance((FARPROC)SCHMOOZMsgProc, hInst);
          DialogBox(hInst, (LPSTR)"SCHMOOZ", hWnd, lpfnSCHMOOZMsgProc);
          FreeProcInstance(lpfnSCHMOOZMsgProc);
#endif
        }
    }
    NumViewports = NumViews; 
    if (!NumViewports)
    	return FALSE;
    TransferSavedZoom ();  
    DetermineVPDisplaySequence ();
    SetCurView (pViewports[CommandViewport-1]);
    if (!CurView->HaveBounds && hDC)
    {
    	if (GetVisBounds (&CurView->NewBounds,hDC))
    	{   
    		CurView->HaveBounds=TRUE; 
    		CurView->WindowIsZoomed = TRUE;
    		CurView->WBounds = CurView->NewBounds;
//           	SetBounds(CurView->hWnd,hDC); 
        }
    }
    else
    	CurView->NewBounds = CurView->WBounds;
    ResetToViewport = 0;
    if (!LoadedHLTFromConfig)  
		ClearHighlightList (FALSE); 
    if (GetGlobalBVal ("[%PROMPTS]"))   
    	hWndPrompt=1;
/*    {
	  FARPROC lpfnPROMPTSMsgProc;
	  
      lpfnPROMPTSMsgProc = MakeProcInstance((FARPROC)PROMPTSMsgProc, hInst);
      CreateDialog(hInst, (LPSTR)"PROMPTS", hWnd, lpfnPROMPTSMsgProc);
    } */
    
    if (GetGlobalBVal ("[%OPENVIDEOWINDOW]"))
    	GEOSPANVideo(hWndMain);
    SetGlobalValue ("%CONFIGPATH",FullPath); 
    SetGlobalValue ("%CONFIG",Cfg);
    ConfigLoaded = TRUE;
    for (iv=0;iv<NumViews;iv++)
    {
        SetCurView ( pViewports[iv]);  
        if (ValidStartupFunction(CurView->StartupFunction))
        {
           	AddLBUTTON = TRUE;
			AddGraphicsFunction (0, CurView->StartupFunction,0);        
		}
		else
			CurView->StartupFunction = 0;
    }
    SetCurView (pViewports[CommandViewport-1]);
    FirstDisplayOfConfig = TRUE;
    if (CFGOpenTrackingStatus)
    	GPSTracking (1);	
    CFGOpenTrackingStatus = FALSE; 
    if (First)
    {
    	First = FALSE; 
    	RunSportMapStartupCommand ();
    }
    return(TRUE); 
}

BOOL SaveConfig (LPSTR Name)
{   short     Signature, Version=4;  
    OFSTRUCT    OFStruct;
    short     len, iv,  i;
    short     imenu;
    LPINT   lpMenuMask;
    short     NumViews; 
    LPVISLIST   SaveVisList, SavePickList;  
    LPVISLIST	SaveInVis=CurVis;
    HBITMAP SaveBitmap;   
    short     NumIB; 
    LPSTR	pStr;  
    LPTHEME	SaveTheme;
    
    FidConfig = GSSiOpenFile (Name,(LPOFSTRUCT)&OFStruct,OF_CREATE);
    if (FidConfig == HFILE_ERROR) 
    {   char    str[256];
        
        sprintf (str,"Unable to create config file: %s",Name);
        GSSiMessageBox(str,0, MB_OK|MB_ICONEXCLAMATION);
        return (FALSE);
    } 
    SetGlobalValue("%P","");	 
    pStr = GlobalLock (hStartupCommand);
    _lwrite (FidConfig,pStr,256);
    GlobalUnlock (hStartupCommand);
    pStr = GlobalLock (hStartupMenu);
    _lwrite (FidConfig,pStr,128); 
    GlobalUnlock (hStartupMenu);
    if (SaveInfoBox)
    	NumIB = GetNumInfoBox ();
    else
    	NumIB = 0;
    _lwrite (FidConfig,(char *)&NumIB,sizeof(NumIB)); 
    if (NumIB)
        WriteInfoBoxes (FidConfig);
    NumViews=NumViewports; 
    _lwrite (FidConfig,(char *)&NumViewports,2);
    _lwrite (FidConfig,(char *)&CommandViewport,2);               
    _lwrite (FidConfig,(char *)&NumMenuMask,sizeof(NumMenuMask));
    if (NumMenuMask)
    { 
	    lpMenuMask = (LPSHORT)GlobalLock (hMenuMask); 
	    for (imenu=0;imenu<NumMenuMask;imenu++,lpMenuMask++)
	        _lwrite (FidConfig,(char *)lpMenuMask,sizeof(short));  
	    GlobalUnlock (hMenuMask);
	}
    _lwrite (FidConfig,(char *)&WindowColor,4);
    _lwrite(FidConfig,(char *)&TAGBox,sizeof(TAGBOX));
    for (iv=0;iv<NumViews;iv++)
    {
        SetCurView ( pViewports[iv]); 
        SaveBitmap = CurView->Bitmap;
        CurView->Bitmap = 0;
        if (!CurView->lpBoundsDisplay)
        	CurView->BoundsDisplayID = 0;
		CurView->NumVisList = 0;  
        CurVis = CurView->pVisList1;
        while (CurVis)
        {  
            CurView->NumVisList++;
            CurVis =(LPVISLIST) CurVis->NextVisList;
        } 
		CurView->NumPickList = 0;  
        CurVis = CurView->pPickList1;
        while (CurVis)
        {  
            CurView->NumPickList++;
            CurVis =(LPVISLIST) CurVis->NextVisList;
        } 
        SavePickList = CurView->pPickList1;
        SaveVisList = CurView->pVisList1;
        CurView->pPickList1 = 0;
        CurView->pVisList1 = 0;  
        if (!SaveZoom)
        {
            CurView->WindowIsZoomed = FALSE; 
            CurView->HaveBounds = FALSE;
        }
        CurView->NumNewObjects = min (CurView->NumNewObjects,100);
        CloseNewObjects(); 
        SaveTheme = CurView->pTheme;
//        if (CurView->pTheme && CurView->Type != 7)
//        	CurView->pTheme = 0;

        i=_lwrite (FidConfig,(char *)CurView,sizeof(VIEWPORT));
       	CurView->pTheme = SaveTheme; 
        CurView->pPickList1 = SavePickList;
        CurView->pVisList1 = SaveVisList;
        for (i=0;i<CurView->NumFiles;i++)
        {   
            len = _fstrlen(CurView->lpFiles[i])+1;
            _lwrite (FidConfig,(char *)&len,2);
            CurView->lpFiles[i]=(LPSTR) &CurView->EndOfViewport + i * 128;
            _lwrite (FidConfig,CurView->lpFiles[i],len);
        } 
        CurVis = CurView->pVisList1;
        while (CurVis)
        {  
            _lwrite (FidConfig,(char *)CurVis,sizeof(VISLIST));
            CurVis =(LPVISLIST) CurVis->NextVisList;
        } 
        CurVis = CurView->pPickList1;
        while (CurVis)
        {  
            _lwrite (FidConfig,(char *)CurVis,sizeof(VISLIST));
            CurVis =(LPVISLIST) CurVis->NextVisList;
        } 
        if (CurView->pVisListManual)
            _lwrite (FidConfig,(char *)CurView->pVisListManual,sizeof(VISLIST));
        if (CurView->pPickListManual)
            _lwrite (FidConfig,(char *)CurView->pPickListManual,sizeof(VISLIST));   
        if (CurView->hMaskArea && SaveZoom) 
        	WriteMaskArea (FidConfig);
        if (CurView->pTheme/* && CurView->Type == 7*/)
        {
            CurTheme = CurView->pTheme;
            WriteCurTheme(FidConfig);
        }  
        if (!CurView->lpBoundsDisplay)
        	CurView->BoundsDisplayID = 0;
        if (CurView->BoundsDisplayID)
        {
            BoundsDisplayWrite (CurView->lpBoundsDisplay,FidConfig);
        } 
        CurView->Bitmap = SaveBitmap;
    } 
    if (SaveGlobals)
    	SaveGlobalVals (FidConfig);
    if (SaveHLTList)
    	FidConfig = SaveHighlightListToConfig (FidConfig);
//    if (SaveInfoBox)
//    	SaveInfoBoxes (FidConfig);
    Signature = 28052;
    _lwrite (FidConfig,(char *)&Signature,2);
    _lwrite (FidConfig,(char *)&Version,2);
    GSSiClose (FidConfig);     
    CurVis = SaveInVis;
    return(TRUE); 
}

void CloseConfig ()
{
   	GSSiClose (FidConfig);
    FidConfig = HFILE_ERROR;
    return;
}



