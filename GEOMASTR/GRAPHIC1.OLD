void HaltMapDisplay(BOOL ClearCFGStack)
{   short iview; 
    LPVIEWPORT SaveView; 
    short	ii;  
    extern	HANDLE	hSymdb;
                        
//    DisplayFinOpt = 0; 
	TrapKillTimer=FALSE; 
    if (DisableHalt)
    	return; 
/*    {//tempdebu
    	char str[128];
	    static	long lastcycle=-1;
    	
    	haltseq++;  
    	if (haltseq == debughalt)
    		ii=1;
    	sprintf (str,"Halt %ld",haltseq);
    	SetWindowText (hWndMain,str);    
    	if (DisplayCycle==lastcycle)
    		ii=1;
    	lastcycle = DisplayCycle;
    }*/ 
    CloseSymDict();  
	CloseDisplayedRefs();
	ClosePrevLayers ();
	CloseOrthos ();
    if (hSymdb)
    	ii=1;
    SaveView = CurView;
	ComputePCTTheme=0;
    for (iview = 0;iview<NumViewports;iview++)
    {   
    	if (pViewports[iview])
    	{
	        SetCurView ( pViewports[iview]); 
	        if (CurView->NumFiles)
	        {
	            if (CurView->PassID == 0)
	                ThemeEndDataPass();
	            else if (CurView->PassID <5)
	                ThemeEndDisplayPass(TRUE);
	        }
	    }   
    }  
    SetCurView ( SaveView);
    CloseAllIndexes ();
    CloseMap (FALSE); 
    CloseRefIndex();  
    CloseSymDict();
    AddTextRect(NULL);
    CloseTRANS2 (&hTranBMToBase);
    CloseTRANS2 (&hTranBaseToBM);
    ConvertCoordClose ();
    if (ClearCFGStack) 
    {
    	while (ConfigLevel)
		{   
			LPSTR	pFile;
			HDC		hDC=GetDC (hWndMain);
			
	        UnallocateConfig (); 
	        pFile = GlobalLock (hSavedConfig[ConfigLevel-1]);
	        _fstrcpy (CfgName,pFile);
	        GlobalUnlock (hSavedConfig[ConfigLevel-1]); 
	        OpenConfig(hWndMain,hDC);   
	        GSSiRemove (CfgName);
	        ConfigLevel--;
	        if (!ConfigLevel)
	        	_fstrcpy (CfgName,Lev0CfgName);
	        ReleaseDC (hWndMain,hDC);
		}	
		NextCFGTAG[0] = 0;
    } 
    InDisplayProcessing = FALSE;  
    TrapKillTimer=TRUE;
    return;
}

void GetItemMinMax (LPMINMAX pMinMax,LPMNMXCORD Rect) 
{
    POINT   Point;
    DPOINT  DPoint;
    
    if (pMinMax)
    {
        Point.x = pMinMax->xmn;
        Point.y = pMinMax->ymn;
        DPoint = FilePtToBasePt (Point);
        Rect->xmn = DPoint.x-FileDistToBaseDist;
        Rect->ymn = DPoint.y-FileDistToBaseDist;
        Point.x = pMinMax->xmx;
        Point.y = pMinMax->ymx;
        DPoint = FilePtToBasePt (Point);
        Rect->xmx = DPoint.x+FileDistToBaseDist;
        Rect->ymx = DPoint.y+FileDistToBaseDist;
    }
    return;
}

void SetLineHighlight(HDC hDC, short mode)
{    
    if (Pick)
    	return;  
    if (HiPrecis)
    {
	    if (mode == 2)
	        SelectObject(hDC, UnHighlightPenHP);
	    else
	        SelectObject(hDC, HighlightPenHP); 
	}
	else
	{
	    if (mode == 2)
	        SelectObject(hDC, UnHighlightPen);
	    else
	        SelectObject(hDC, HighlightPen);
	}
    return;
} 

