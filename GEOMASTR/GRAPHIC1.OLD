}

void OpenBasePens(void)
{   LOGBRUSH    NDB; 
	COLORREF	Color;
    short i, Width;
    
    if (!Display)
    	return;
    if (!HaveBasePens)
    {   
    	hRedBrush =   CreateSolidBrush(RGB(255,   0,   0));
        hGreenBrush = CreateSolidBrush(RGB(  0, 255,   0));
        hBlueBrush =  CreateSolidBrush(RGB(  0,   0, 255));  
        Color = GetGlobalLVal2 ("[%AREABORDERCOLOR]",AutoYellow(0));
        Width = GetGlobalLVal2 ("[%AREABORDERWIDTH]",1);
    	hAreaBorderPen[FALSE] = CreatePen(PS_SOLID,(short)IDNINT(Width*DeviceToScreenFactor*WidthFactor),Color);
    	hAreaBorderPen[TRUE] = CreatePen(PS_SOLID,(short)IDNINT(Width*DeviceToScreenFactor),Color);
        h0Pen =   CreatePen(PS_NULL,0,RGB(0,0,0));
        hRedPen =   CreatePen(PS_SOLID,0,RGB(255,0,0));
        if (*PenWIDTH < 0)
        	Width = abs (*PenWIDTH) * DeviceToScreenFactor * BaseDistToWinDist;
        else if (*PenWIDTH > 0) 
        	Width = *PenWIDTH * DeviceToScreenFactor;
        else
        	Width = 0;
        if (*PenCOLOR >= 0) 
        	Color = *PenCOLOR;
        else
        	Color = 0;  
        pens[0] =   CreatePen(PS_SOLID,Width,AutoYellow(Color));
        if (PatternBrush || Printing)
        {   
        	HBITMAP hbmp;
            NDB.lbStyle = BS_HATCHED;
            NDB.lbColor = HighlightColor;
            NDB.lbHatch = HS_DIAGCROSS;
            HighlightBrush =  CreateBrushIndirect(&NDB);
/*			hbmp = LoadBitmap(hInst, IDB_MONO1); does'nt work - no transparent fills
			HighlightBrush = CreatePatternBrush(hbmp);
            DeleteObject (hbmp);*/
        }
        else
            HighlightBrush =   CreateSolidBrush(HighlightColor);
        HighlightPen =   CreatePen(PS_SOLID,
                           (short) IDNINT(HighlightWidth*WidthFactor*DeviceToScreenFactor),
                           HighlightColor);
        UnHighlightPen =   CreatePen(PS_SOLID,
                           (short) IDNINT(HighlightWidth*WidthFactor*DeviceToScreenFactor),
                           CurView->BackGroundColor);
        HighlightPenHP =   CreatePen(PS_SOLID,(short)IDNINT(HighlightWidth*DeviceToScreenFactor),HighlightColor);
        UnHighlightPenHP =   CreatePen(PS_SOLID,(short)IDNINT(HighlightWidth*DeviceToScreenFactor),CurView->BackGroundColor);
        CurrentPen = hRedPen;
        for (i=1;i<8;i++)
        	if (PenWIDTH[i] != 0 )
        	{
        		hProPen[TRUE][i]= CreatePen(PS_SOLID,(short) IDNINT(PenWIDTH[i]*DeviceToScreenFactor), PenCOLOR[i]);
        		hProPen[FALSE][i]= CreatePen(PS_SOLID,(short) IDNINT(PenWIDTH[i]*WidthFactor*DeviceToScreenFactor), PenCOLOR[i]);
        	}
		CreateClassPens ();                                       
		CreateRandomBrushes ();
    }
    HaveBasePens = TRUE;
    return;
}

void CloseBasePens(void)
{   
	short i;
	
	if (HaveBasePens)
    {
        GSSiDeleteObject (&hRedBrush);
        GSSiDeleteObject (&hGreenBrush);
        GSSiDeleteObject (&hBlueBrush);
        GSSiDeleteObject (&h0Pen);
        GSSiDeleteObject (&hRedPen);
        GSSiDeleteObject (&HighlightBrush);
        GSSiDeleteObject (&HighlightPen);
        GSSiDeleteObject (&UnHighlightPen);
        GSSiDeleteObject (&HighlightPenHP);
        GSSiDeleteObject (&UnHighlightPenHP);
        GSSiDeleteObject (&hAreaBorderPen[0]);
        GSSiDeleteObject (&hAreaBorderPen[1]);
        GSSiDeleteObject (&pens[0]); 
        for (i=1;i<8;i++)
        {
        	GSSiDeleteObject (&hProPen[TRUE][i]);
        	GSSiDeleteObject (&hProPen[FALSE][i]);
       	}
    } 
    DestroyClassPens();  
    CurrentPen = 0;
    HaveBasePens = FALSE;
    return;

} 

void CreateRandomBrushes (void)
{
	LOGBRUSH    NDB;
    LPHBRUSH	pRandBrush;
    short	i;
    static	First=TRUE; 
    COLORREF	Color;
    short	MinColor = GetGlobalLVal2("[%RANDCOLORMIN]",184);
    short	MaxColor = min (255,GetGlobalLVal2("[%RANDCOLORMAX]",255));  
    short	ColorRange = MaxColor - MinColor;
    double	RedFactor = min (1.0,GetGlobalDVal2("[%RANDREDFACTOR]",1.0));
    double	GreenFactor = min (1.0,GetGlobalDVal2("[%RANDGREENFACTOR]",1.0));
    double	BlueFactor = min (1.0,GetGlobalDVal2("[%RANDBLUEFACTOR]",1.0));   
    
    DestroyRandomBrushes (); 
    if (!CurVis)
    	return;
    if (!hRandBrushes)
    { 
    	First = FALSE;
	    srand(1);
		NumRandomColors = max (16,GetGlobalLVal ("[%NUMRANCOLORS]"));   
		hRandBrushes = GSSiGlobAlloc (GMEM_MOVEABLE,NumRandomColors*(sizeof(HPEN)+sizeof(HBRUSH)));
		pRandBrush = (LPHBRUSH)GlobalLock (hRandBrushes); 
		for (i=0;i<NumRandomColors;i++,pRandBrush++)
		{   
			if (ColorRange)
		    	Color = RGB(IDNINT((MinColor+rand()%ColorRange)*RedFactor),
			                IDNINT((MinColor+rand()%ColorRange)*GreenFactor),
			                IDNINT((MinColor+rand()%ColorRange)*BlueFactor)); 
			else
				Color = 0;
		    *pRandBrush++ = CreatePen (PS_SOLID,0,Color); 
			if (SolidAreas && GetBit (7,(LPSTR)&CurVis->WantType[7]))
				*pRandBrush = CreateSolidBrush(Color); 
			else
			{ 
				NDB.lbStyle = BS_HATCHED;
				NDB.lbColor = Color;
				NDB.lbHatch	= HS_DIAGCROSS;
				*pRandBrush = CreateBrushIndirect(&NDB);
	        }
	    }  
	    GlobalUnlock (hRandBrushes); 
    }
    return;
}

void DestroyRandomBrushes (void)
{
    LPHBRUSH	pRandBrush;
    short	i; 
    
    if (!hRandBrushes)
    	return;
	pRandBrush = (LPHBRUSH)GlobalLock (hRandBrushes); 
	for (i=0;i<NumRandomColors;i++,pRandBrush++)  
	{
		GSSiDeleteObject (pRandBrush);
		pRandBrush++;
		GSSiDeleteObject (pRandBrush); 
	}
	GSSiGlobUlFree (&hRandBrushes);
	return;
}

long	RandLong (long Value, long Range)
{   
	long	rtn, IntTot=0;
	unsigned	long	i;
	union {
			char	bytes[4];
		    long	InValue;
	      }	InUnion; 
	union {
			double	Rval;  
			short	ieq[4];
		  } OutUnion;
			
    InUnion.InValue = Value;
    for (i=0;i<4;i++)
    	IntTot += InUnion.bytes[i] * (i+1);
    OutUnion.Rval = 1907719e0 * IntTot + 907633963e0;
 //     IHRAN = MOD (IABS((long)(IEQ[1])*(long)(IEQ[2])*(long)(IEQ[3])),MAX) + 1;  
 	rtn = (long)OutUnion.ieq[0] + (long)OutUnion.ieq[1] + (long)OutUnion.ieq[2] + (long)OutUnion.ieq[3];
 	rtn = labs (rtn) % Range;
	return rtn;
}  

HBRUSH SelectRandomBrush (HDC hDC,long Refno,HPEN *phSavePen)
{   
	LPHBRUSH	pRandBrushes; 
	HBRUSH	hOldBrush; 
	short	icolor;
	
	icolor = RandLong (Refno,NumRandomColors);
	pRandBrushes = (LPHBRUSH)GlobalLock (hRandBrushes);
	pRandBrushes += (2*icolor);
	if (!*phSavePen)
		*phSavePen = SelectObject (hDC,*pRandBrushes); 
//	else
//		*phSavePen = *pRandBrushes;
	pRandBrushes++;
	hOldBrush = SelectObject (hDC,*pRandBrushes);
	GlobalUnlock (hRandBrushes);
	return hOldBrush;
}

void OpenNewObjects(void)
{   short  i;
    
    if (!Display)
    	return;
    if (HiPrecis && NewObOpen == 2) 
    	return;
    if (!HiPrecis && NewObOpen == 1) 
    	return;
    if (NewObOpen)
    	CloseNewObjects();
    if (HiPrecis)
    	NewObOpen = 2;
    else
    	NewObOpen = 1;
    for (i=0;i<min(100,CurView->NumNewObjects);i++)
    	CreateNewObject(i);
    return;
}                    

void CreateNewObject(short i)
{
    LOGBRUSH	NDB;
    double		WF=WidthFactor;
    
    if (HiPrecis)
    	WF = 1.0; 

    if (CurView->NewObject[i].Type==3)
    {   
    	BOOL	WantXHatch=FALSE;
    	
    	if (CurVis)
    		WantXHatch = GetBit (6, (LPSTR)&CurVis->WantType[7]);
		if (SolidAreas && !WantXHatch)
        	CurView->NewObject[i].Handle=CreateSolidBrush(
                                    	 RGB(CurView->NewObject[i].R,CurView->NewObject[i].G,CurView->NewObject[i].B));
		else
		{ 
			NDB.lbStyle = BS_HATCHED;
			NDB.lbColor = RGB(CurView->NewObject[i].R,CurView->NewObject[i].G,CurView->NewObject[i].B);
			NDB.lbHatch	= HS_DIAGCROSS;
			CurView->NewObject[i].Handle = CreateBrushIndirect(&NDB);
        }
		CurView->NewObject[i].ProPen = 0;                                     
	}
    else if (CurView->NewObject[i].Type>0)
    {
    	short IWidth;
    	
    	if (CurView->NewObject[i].ProPen)
    	{   
    		if (hProPen[HiPrecis][CurView->NewObject[i].ProPen])  
    			CurView->NewObject[i].Handle = hProPen[HiPrecis][CurView->NewObject[i].ProPen];
    		return;
    	}
    	if (CurView->NewObject[i].Width<0)
        	IWidth = (short)IDNINT(((double)-CurView->NewObject[i].Width / CurView->BaseUnitsPerPixel)*WF); 
//    		IWidth = (short)IDNINT((-CurView->NewObject[i].Width)/(CurView->FileFactor*FileDistToBaseDist));
    	else 
    		IWidth = IDNINT((CurView->NewObject[i].Width+1) * WF * DeviceToScreenFactor);
        CurView->NewObject[i].Handle=CreatePen (CurView->NewObject[i].Style,IWidth,
                                                AutoYellow(RGB(CurView->NewObject[i].R,
                                                	CurView->NewObject[i].G,
                                                	CurView->NewObject[i].B)));
    }
    return;
}

void CloseNewObjects(void)
{   short i;
    
    NewObOpen = 0;
    if (!CurView)
    	return;
    for (i=0;i<min(100,CurView->NumNewObjects);i++) 
    {
        if(CurView->NewObject[i].Handle && !CurView->NewObject[i].ProPen)
            DeleteObject (CurView->NewObject[i].Handle);
        CurView->NewObject[i].Handle = 0;
    }
    return;
}

void SetClassColor (short i,short type, COLORREF color)
{   
    short Style;
    
    if (i>=100)
    	return;
    if (CurView->NewObject[i].Handle) 
        DeleteObject(CurView->NewObject[i].Handle); 
    else 
    {
        CurView->NewObject[i].Width=(float)0.0;  
        Style = PS_SOLID;
    }
    
    CurView->NewObject[i].Type  = (unsigned char)type;
    CurView->NewObject[i].R     = GetRValue(color);
    CurView->NewObject[i].G     = GetGValue(color);
    CurView->NewObject[i].B     = GetBValue(color);
    CurView->NewObject[i].Style = (unsigned char)Style;  
    CurView->NewObject[i].ProPen = 0;
    CreateNewObject(i);
    return;

}

void SetClassLineType (short i, short Type, float Width, short Style,short ProPen, COLORREF color)
{
    if  (i>=100)
    	return;
    if (CurView->NewObject[i].Handle) 
        DeleteObject(CurView->NewObject[i].Handle); 
    CurView->NewObject[i].R=GetRValue(color);
    CurView->NewObject[i].G=GetGValue(color);
    CurView->NewObject[i].B=GetBValue(color);
    CurView->NewObject[i].Type=(unsigned char)Type;
    CurView->NewObject[i].Width=Width;  
    CurView->NewObject[i].Style=(unsigned char)Style;  
    CurView->NewObject[i].ProPen=(unsigned char)ProPen;  
    CreateNewObject(i);
    return;
} 

