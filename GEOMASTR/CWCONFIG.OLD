		      	}
/*		      	else 
		      	{
	          		ShowWindow (GetDlgItem(hWndDlg,IDC_TEXT_FILE),SW_HIDE);
	          		ShowWindow (GetDlgItem(hWndDlg,IDC_LOCATE),SW_HIDE);
		      		ShowWindow (GetDlgItem(hWndDlg,IDC_HP_NAME),SW_SHOW);
