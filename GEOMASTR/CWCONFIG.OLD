	 				}
	 				SetAutoPan (AP);
					if (fabs(OffsetLineOffset) > 0.000000001) 
					{   
						HaltMapDisplay(FALSE);
			        	OffsetPickedArea (0,OffsetLineOffset);
				        DisplayPolyOff();  
				        DisplayMaskArea();
					    CurView->CurZoomAreaRef = 0;
