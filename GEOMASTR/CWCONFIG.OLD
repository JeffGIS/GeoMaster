					 ifield=1;
				 }
		         
				 hItems=GSSiGlobAlloc(GHND,nItems*2);
				 lpItems=  (LPINT) GlobalLock(hItems);
                 SendDlgItemMessage(hWndDlg,IDC_FIELDS,LB_GETSELITEMS,nItems,(LPARAM)lpItems);
				 for (i=0;i<nItems;i++,lpItems++,ifield++)
