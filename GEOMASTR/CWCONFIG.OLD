DisplayParcel:	 	
  				    SetViewport(CommandViewport);
			    	ClearCurrentCD ();

					if (LocationOffset)
				 	{
			 			AP = SetAutoPan (FALSE);
						ZoomToPickedItem (0,LocationOffset,OffsetFromLimits,FALSE,FALSE);
