		           	mess = pExpanded+3064;
		           	sprintf (mess,"Expansion of %s",Command); 
		           	_fstrcpy (pExpanded,Command);
			   	 	ExpandText (pExpanded);    
			   	 	MessageBox (GetFocus(),pExpanded,mess,0);
