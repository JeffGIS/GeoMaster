				 _lwrite (FidData,&GWDHead,sizeof(GWDHEADER));
				 ibeg = 0;
				 
				 hVars = LocalAlloc (LHND,NumIndexFields * sizeof(BTVARDESC));
			     pVars = (BTVARDESC *) LocalLock(hVars);
			     
				 GWFldInfo.Len = 4;
