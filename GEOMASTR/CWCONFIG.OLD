            	 else if (TotRecs)
            	 {
            	 	 TotRecs = 0;
					 goto TimerOn;
            	 }
            	 else
            	 {
//	               	 CloseUM(FALSE);
	                 EndDialog(hWndDlg, TRUE);
                 }
                 break;

            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */ 
				 if (WSAIsBlocking ())
				 	return TRUE;
                 if (HaveTimer)
                 {
					 TotRecs = 0;
                 }
