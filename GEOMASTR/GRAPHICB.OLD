BOOL CurrentMidPointArea (LPDOUBLE MidPointAZ,LPDOUBLE Length,BOOL Clip, LPMINMAX pMinMax,LPPOINT pPoint,LPSHORT pNum,short From)
{   POINT	MidPoint, TestPoint, LastPoint, Point,FPoint;
	LPINT	ipnt;   
	HPDPOINT	lpDPoints;
	DWORD	/*nPnts,*/ i, cenpt;
	HPPOINT lpPoints;
	double	X=0, Y=0, dist; 
	short	ib,ie, np=0;
    
    if (*pNum)
    	return FALSE;  
    *pNum = 1; 
    if (From == 1 && BlockCompletelyInWindow (CurrentItemMinMax))
    {   
    	FPoint.x = CurrentItemMinMax.xmn;
    	FPoint.y = CurrentItemMinMax.ymn;
   		Point = FileCoordToWinCoord(FPoint);
		AddPointToMinMax (Point,pMinMax);
    	FPoint.x = CurrentItemMinMax.xmx;
    	FPoint.y = CurrentItemMinMax.ymx;
   		Point = FileCoordToWinCoord(FPoint);
		AddPointToMinMax (Point,pMinMax);
		MidPoint = MinMaxMidPoint(pMinMax);    
		*pPoint = MidPoint;
    	return TRUE;
    }
    if (HiPrecis) 
    {
    	lpDPoints = lpDCurPoints;
		LastPoint = BasePtToWinPt (lpDPoints+nPnts-1);   
	}
    else 
    {
	    lpPoints = lpCurPoints;
   		LastPoint = FileCoordToWinCoord(*(lpPoints+nPnts-1));
	}
	for (i=0;i<nPnts;i++) 
	{   
		if (HiPrecis)
			Point = BasePtToWinPt (lpDPoints++);   
		else
    		Point = FileCoordToWinCoord(*lpPoints++);
    	if (!Clip || PtInDrawRect (Point))
    	{   
    		dist = idist (Point,LastPoint);
	        *Length += dist;
    		np++;
			AddPointToMinMax (Point,pMinMax);
			if (From == 3)
			{
		    	X += Point.x * dist;
		        Y += Point.y * dist;
		    }
			else
			{
		    	X += Point.x;
		        Y += Point.y;
		    }
		    LastPoint = Point;
		}
	}
    if (!np)
    {	
    	return (FALSE);
    }    
	if (From == 3 && *Length)
	{
	    MidPoint.x = (X / *Length);
	    MidPoint.y = (Y / *Length); 
	}
	else
	{
	    MidPoint.x = X / np;
	    MidPoint.y = Y / np; 
		MidPoint = AveragePoint (MidPoint, MinMaxMidPoint(pMinMax));    
	}
	*pPoint = MidPoint;
	return TRUE;
}

BOOL CurrentMidPoint (int Type,LPDOUBLE MidPointAZ,LPDOUBLE Length,LPSHORT Height,BOOL Clip, LPMINMAX pMinMax,LPPOINT pPoint,LPSHORT pNum,short From)
{   POINT	MidPoint, Point, LastWPoint, NextWPoint;
	DPOINT  LastPoint, StartPoint, AZPt1, AZPt2;
	LPINT	ipnt;
	DWORD		/*nPnts,*/ i, cenpt;
	HPPOINT lpPoints;
	HPDPOINT lpDPoints;  
	BOOL	IsIn;
	long	X, Y; 
	long	ib,ie, np=0;
	static	long	beginpoint;
    
    if (!*pNum)
    	beginpoint = 0; 
    *Length = 0; 
    *MidPointAZ = 0;
	MinMaxInit (pMinMax);
//    if (Type == GF_AREA) 
//    	Type = GF_POLYLINE;
    *Height = 0;
    if (Type == GF_AREA)
    	return CurrentMidPointArea (MidPointAZ,Length,Clip,pMinMax,pPoint,pNum,From);  
    (*pNum)++;  
	switch (Type)
	{
		case GF_POINT:
			if (*pNum>1)
				return FALSE;
   			Point = CurPointLoc;   
	    	if (PtInDrawRect (Point))
	    	{
				AddPointToMinMax (Point,pMinMax);
    			*MidPointAZ = PTRot;
				*pPoint = Point; 
				*Height = CurPointSize*ThemeWidthFactor;
				InflateMinMax (pMinMax,(*Height)/2);
				return TRUE; 
			}
			else
				return FALSE;
		case GF_POLYLINE:
		case GF_LINE:
		case GF_TEXT:
			break;
		default:
			return (FALSE);
	}
    if (Clip)
    {     
	    ib = -1;
	    if (HiPrecis)
	    	lpDPoints = lpDCurPoints+beginpoint;
	    else
		    lpPoints = lpCurPoints+beginpoint;
    	for (i=beginpoint;i<nPnts;i++) 
    	{   
    		if (HiPrecis)
    		{
    			if ((IsIn = PointInWBounds (lpDPoints)))
    				Point = BasePtToWinPt (lpDPoints);
    			lpDPoints++;
    		}   
    		else 
    		{   
    			POINT	point = *lpPoints;
    			
   			    ProjectFilePt (&point);
    			if ((IsIn = PtInBounds (point)))
	    			Point = FileCoordToWinCoord(*lpPoints); 
	    		lpPoints++;
	    	}
	    	if (IsIn)
	    	{
				AddPointToMinMax (Point,pMinMax);
	    		if (ib <0)
	    			ib = i; 
	    		np++;
	    		ie = i+1;
	    	}
	    	else
	    	{ 
	    		if (ib >= 0)
	    		{    
	    			if (np == 1) 
	    			{
	    				ie = i+1;
	    				np++;
	    			}
	    			else
	    				ie = i;
	    			break;
	    		} 
	    	} 
	    }
    }
    else
    {
    	ib = 0;
    	ie = nPnts;  
    	np = nPnts;
    }           
	beginpoint = ie+1;
    if (!np)
    {	
    	return (FALSE);
    }    
    if (HiPrecis)
    {
    	lpDPoints = lpDCurPoints;   
    	lpDPoints += ib;
		Point = BasePtToWinPt (lpDPoints);   
    }
    else 
    {
	    lpPoints = lpCurPoints; 
	    lpPoints += ib;
   		Point = FileCoordToWinCoord(*lpPoints);
	}
    X = Point.x;
    Y = Point.y;  
    if (np == 1)
    {    
    	if (HiPrecis)
    	{
	    	if (ib)
	    	{
			    LastPoint = *lpDPoints--; 
			    StartPoint = *lpDPoints++; 
		 	}
		 	else
		 	{ 
			    StartPoint = *lpDPoints++; 
			    LastPoint = *lpDPoints; 
		    }
		}
	    else
	    {  
	    	if (ib)
	    	{
			    LastPoint = PointToDPoint(*lpPoints--); 
			    StartPoint = PointToDPoint(*lpPoints++); 
		 	}
		 	else
		 	{ 
			    StartPoint = PointToDPoint(*lpPoints++); 
			    LastPoint = PointToDPoint(*lpPoints); 
		    }
		}  
	}
    else
    {   
    	if (HiPrecis) 
    	{
	    	LastWPoint = BasePtToWinPt (lpDPoints);
    		StartPoint = *lpDPoints++;
    	}
    	else 
    	{
    		LastWPoint = FileCoordToWinCoord(*lpPoints);
	    	StartPoint = PointToDPoint(*lpPoints++);  
	    }
	    LastPoint = StartPoint;
	    cenpt = ib + np/2;
	    for (i=ib+1;i<ie;i++)
	    {   
	    	if (HiPrecis) 
	    		Point = BasePtToWinPt (lpDPoints);
	    	else
		    	Point = FileCoordToWinCoord(*lpPoints); 
			AddPointToMinMax (Point,pMinMax);
	    	X += Point.x;
	        Y += Point.y;
		    if (i==cenpt)
		    {
		    	if (np % 2 || (i+1)>=ie)
		    	{
		    		MidPoint = AveragePoint (LastWPoint,Point); 
		    		AZPt2 = WinPtToBasePt (Point); 
		    	} 
		    	else 
		    	{
		    		MidPoint = Point;
			    	if (HiPrecis) 
			    		AZPt2 = *(LPDPOINT)(lpDPoints+1);
			    	else
				    	AZPt2 = FilePtToBasePt(*(LPPOINT)(lpPoints+1)); 
		    	}
		    	AZPt1 = WinPtToBasePt (LastWPoint);
		    	*MidPointAZ = getazd (&AZPt1,&AZPt2); 
		    }
	        *Length += idist (Point,LastWPoint); 
	        LastWPoint = Point;
	    	if (HiPrecis) 
	    		LastPoint = *lpDPoints++;
	    	else
		    	LastPoint = PointToDPoint(*lpPoints++); 
	    } 
    }         
    if (np == 1)
    {   
    	ProjectBasePt (&StartPoint);
    	ProjectBasePt (&LastPoint);
    	if (StartPoint.x != LastPoint.x || StartPoint.y != LastPoint.y)
    		*MidPointAZ = getazd (&StartPoint,&LastPoint);
    }  
    if (np < 3)
    {
	    MidPoint.x = X / np;
	    MidPoint.y = Y / np;  
	}
	*pPoint = MidPoint;
	return TRUE;
}

double ComputeAreaArea (HPPOINT lpPoints,long nPnts,LPDOUBLE pPerim)
{
	HANDLE handle=GSSiGlobAlloc (GMEM_MOVEABLE,nPnts*sizeof(DPOINT));
	HPDPOINT	lpDpoints=(HPDPOINT)GlobalLock (handle);
	DWORD	i;   
	double	Area;
	
	for (i=0;i<nPnts;i++)
		lpDpoints[i] = FilePtToBasePt(lpPoints[i]);
	Area = ComputeAreaAreaD (lpDpoints,nPnts,pPerim);
	GSSiGlobUlFree (&handle);
	return Area;
}

BOOL ShowOrthoRes (double Res)
{   
	short	x,y; 
	char	str[32],fmt[32];  
	         
	if (!WantOrthoResDisplay || !CurView)
		return FALSE;                   
	if (CurView->ID != CommandViewport)
		return FALSE;  
    SaveDC (CurView->hDC);
    SetMapMode    (CurView->hDC, MM_TEXT );
    SelectClipRgn (CurView->hDC,0);
	SetBkMode (CurView->hDC,OPAQUE);
	SetTextColor (CurView->hDC,0);  
	SetBkColor (CurView->hDC,RGB(255,255,255)); 
	sprintf (fmt,"%%.%if",WantOrthoResDisplay);
	sprintf (str,fmt,Res);
	x = CurView->Rect.left + 4*(CurView->DrawRect.right - CurView->DrawRect.left)/5;
	y = CurView->DrawRect.bottom + 2;
	TextOut (CurView->hDC,x,y,str,_fstrlen(str));
    RestoreDC (CurView->hDC,-1);
	return TRUE;
}

short CoordDisplayMacro (POINT MousePoint)
{	 
	int		iclass; 
    
	if (!CurView->pTheme)
		return 0;    
	if (CurView->pTheme->ID != PF_COORD_DISPLAY)
		return 0;
	PickList[0].Desc = -1;
	PickList[0].ViewID = CurView->ID;
	_fstrcpy (PickList[0].Prefix,"%COORDDISPLAY");
	return 1;
}

short DistDisplayMacro (POINT MousePoint)
{	 
	int		iclass; 
    
	if (!CurView->pTheme)
		return 0;    
	if (CurView->pTheme->ID != GF_DISTANCE_THEME)
		return 0;
	PickList[0].Desc = -1;
	PickList[0].ViewID = CurView->ID;
	_fstrcpy (PickList[0].Prefix,"%DISTDISPLAY");
	return 1;
}

BOOL CopyHighlightedRecords (BOOL DeleteFromSource,BOOL ShowStatus)
{
	long	Refno, n=0, TotLen; 
	short	pos=BT_FIRST, WhichFile=1;
	HIGHLIGHTDATA	HighlightData;   
	HCURSOR	hcurSave;
	
	
	if (DeleteFromSource)
		WhichFile = 2;
	if (ShowStatus)
		CreateStatusWindow (CurView->hWnd,1,NULL);
    else 
    {
		hCursor =  LoadCursor(NULL, IDC_WAIT);
		hcurSave = GSSiSetCursor(hCursor); 
	}
		
    TotLen = BT_NUM_IN_INDEX (hHighlight);
	while (!BT_FIND (hHighlight,(LPSTR)&Refno,pos,BT_ANY,(LPSTR)&HighlightData)) 
	{   
		n++;
		pos = BT_NEXT; 
		PickList[0] = HighlightData.PD;  
		UpdateRecord (0,PickList[0].Desc,PickList[0].Prefix,PickList[0].UDI,NULL,NULL,WhichFile);
		if (ShowStatus)
			StatusWindowUpdate ("","Copying Map Data", TotLen, n);
    }
	if (ShowStatus)
		DestroyStatusWindow ();
	else
	{
		hCursor = hcurSave;
		GSSiSetCursor(hCursor);
	}
    return TRUE;
}

BOOL AreaInArea (LPSTR TAGOrRef,LPSTR ThemeVP,LPSTR AinAGMD,double MinPCT)
{   
	char	DefStr[]="BoundaryRef(B4),PCT(R4),InRef(B4),InTAG(C42),InAreaPCT(R4),BoundaryTAG(C42),NumInBoundary(B4)";
	short	NumFields=7, NumIndexFields=1;
	LPSTR	pColon=_fstrchr (TAGOrRef,':');
	long	AreaRef, Num, InRefno;
	BOOL	st; 
	HANDLE	hDB;
	LPGWDHEADER lpGWDHead;
	HIGHLIGHTDATA	HighlightData;   
	char	BoundaryTAG[44], InTAG[44];
	
	if (!ExistFile (AinAGMD))
	{
		if (!CreateGWDDatabase (AinAGMD,1,NumFields,NumIndexFields,DefStr))
			return FALSE;
	} 
	ClearPolyOff();
	if (pColon)
	{  
		*pColon++ = 0;
		st = PickByRefno (0,TAGOrRef,pColon,-1); 
		pColon--;
		*pColon = ':';
		AreaRef = PickList[0].Refno;
	}
	else 
	{
		AreaRef = atol (TAGOrRef);
		st = PickByRefno (AreaRef,NULL,NULL,-1);
	}
	sprintf (BoundaryTAG,"%s:%s",PickList[0].Prefix,PickList[0].UDI);
	if (!SelectAreaToOffsetFile (0))
		return FALSE;
	ClearHighlightList(FALSE);
	Num = HighlightInArea (CurView->hWnd,NULL,TRUE,FALSE);
    hDB = OpenGWDatabase (AinAGMD,BT_WRITE);
    if (!hDB)
    	return (FALSE);
    lpGWDHead = (LPGWDHEADER)GlobalLock (hDB);
    SetFieldValFromCharAndName(lpGWDHead,"BoundaryRef",(LPSTR)&AreaRef,TRUE);
	if (Num)
	{
		BT_FIND (hHighlight,(LPSTR)&InRefno,BT_FIRST,BT_ANY,(LPSTR)&HighlightData);
		InRefno = HighlightData.PD.Refno;
		sprintf (InTAG,"%s:%s",HighlightData.PD.Prefix,HighlightData.PD.UDI);
	}
	else
	{
		InRefno = 0;
		*InTAG = 0;
	}
   	SetFieldValFromCharAndName(lpGWDHead,"InRef",(LPSTR)&InRefno,TRUE);
    SetFieldValFromCharAndName(lpGWDHead,"InTAG",(LPSTR)InTAG,FALSE);
    SetFieldValFromCharAndName(lpGWDHead,"BoundaryTAG",(LPSTR)BoundaryTAG,FALSE);
    SetFieldValFromCharAndName(lpGWDHead,"NumInBoundary",(LPSTR)&Num,TRUE);
	st = GWDReplaceRecord (lpGWDHead,0,NULL,-1); 
    GlobalUnlock (hDB); 
    CloseGWDatabase (hDB); 
	ClearPolyOff();
	ClearHighlightList(FALSE);
	return TRUE;
}  

BOOL ThemeInArea (LPSTR TAGOrRef,LPSTR ThemeVPName,LPSTR TinAGMD,double MinPCT,long Precision)
{   
	char	DefStr[]="BoundaryRef(B4),PCT(R4),InClassNum(B2),InClassDesc(C42),InClassPCT(R4),BoundaryTAG(C42),NumClassInBoundary(B2)";
	short	NumFields=7, NumIndexFields=2;
	LPSTR	pColon=_fstrchr (TAGOrRef,':');
	long	AreaRef, Num, InRefno;
	BOOL	st; 
	HANDLE	hDB;
	LPGWDHEADER lpGWDHead;
	HIGHLIGHTDATA	HighlightData;   
	char	BoundaryTAG[44], InTAG[44]; 
	HDC		SaveDCMem = hdcMemMap, SaveDC;  
	BOOL	SaveMemMap = MemMap, SaveMaskOffsetLine = MaskOffsetLine, SaveBleedThrough=BleedThrough;
	short	SaveMMW = MemMapWidth, SaveMMH = MemMapHeight; 
    HBITMAP	SaveMemBitmap;
    LPVIEWPORT	ThemeVP, SaveVP=CurView; 
    short	Err,ClassNo;
    float	PCT;
    double	TotCount=0;
    BOOL	rtn=FALSE;
	
	SetViewport (CommandViewport);	
	SaveDC = CurView->hDC;
	if (!ExistFile (TinAGMD))
	{
		if (!CreateGWDDatabase (TinAGMD,1,NumFields,NumIndexFields,DefStr))
			goto Exit;
	}
	ThemeVP = SetVPFromName (ThemeVPName,&Err);
	if (Err)
		goto Exit;
	 
	ClearPolyOff();
	if (pColon)
	{  
		*pColon++ = 0;
		st = PickByRefno (0,TAGOrRef,pColon,-1); 
		pColon--;
		*pColon = ':';
		AreaRef = PickList[0].Refno;
	}
	else 
	{
		AreaRef = atol (TAGOrRef);
		st = PickByRefno (AreaRef,NULL,NULL,-1);
	} 
	if (!st)
		goto Exit;
	if (!SelectAreaToOffsetFile (0))
		goto Exit;
	sprintf (BoundaryTAG,"%s:%s",PickList[0].Prefix,PickList[0].UDI);  

	MaskOffsetLine = TRUE;	
	MemMap = TRUE;
	MemMapWidth = Precision;
	MemMapHeight = Precision;   
	BleedThrough = FALSE;
	hdcMemMap = CreateCompatibleDC(CurView->hDC);    
	hMemBitmap = CreateCompatibleBitmap (CurView->hDC,MemMapWidth,MemMapHeight); 
	CurView->hDC = hdcMemMap;
	hbmpOld = SelectObject(hdcMemMap, hMemBitmap); 
    SetMainRect (CurView->hWnd,CurView->hDC,NULL);
    SetupViewports (hWndMain,hdcMemMap,0,MainRect);
	
	*MemMapName = 0; 
    CurView->CurZoomAreaRef = PickList[0].Refno;
	ZoomToRect(PickList[0].Rect,TRUE);  
    
    MaskOffsetLine = SaveMaskOffsetLine;
	SelectObject(hdcMemMap,hbmpOld);
    DeleteDC (hdcMemMap);  
    DeleteObject (hMemBitmap); 
    SetupViewports (hWndMain,SaveDC,0,MainRect);
    hdcMemMap = SaveDCMem;  
	MemMap = SaveMemMap;
	MemMapWidth = SaveMMW;
	MemMapHeight = SaveMMH;
	hMemBitmap = SaveMemBitmap;
	BleedThrough = SaveBleedThrough;
    hDB = OpenGWDatabase (TinAGMD,BT_WRITE);
    if (!hDB)
    	goto Exit;
    lpGWDHead = (LPGWDHEADER)GlobalLock (hDB);
    SetFieldValFromCharAndName(lpGWDHead,"BoundaryRef",(LPSTR)&AreaRef,TRUE);
    SetFieldValFromCharAndName(lpGWDHead,"BoundaryTAG",(LPSTR)BoundaryTAG,FALSE);
    SetFieldValFromCharAndName(lpGWDHead,"NumClassInBoundary",(LPSTR)&ThemeVP->pTheme->NumClass,TRUE);
   	TotCount = CurTheme->NumNonMask;
	if (ThemeVP->pTheme->NumClass)
	{   
		short	i;
		double	MaxCount=-1;
		
		for (i=0;i<ThemeVP->pTheme->NumClass;i++)
		{   
			ClassNo = i+1;
		   	SetFieldValFromCharAndName(lpGWDHead,"InClassNum",(LPSTR)&ClassNo,TRUE);
		    SetFieldValFromCharAndName(lpGWDHead,"InClassDesc",(LPSTR)ThemeVP->pTheme->ClassBM[i],FALSE);
			if (!TotCount)
				PCT = 0;
			else
				PCT = CurTheme->ClassCount[i] / TotCount; 
			PCT *= -1;
		   	SetFieldValFromCharAndName(lpGWDHead,"PCT",(LPSTR)&PCT,TRUE); 
		   	if (fabs (PCT) > MinPCT)
				st = GWDReplaceRecord (lpGWDHead,0,NULL,-1); 
		}
	}
	else
	{
		PCT = 0; 
		ClassNo=0;
	   	SetFieldValFromCharAndName(lpGWDHead,"PCT",(LPSTR)&PCT,TRUE);
		InRefno = 0;
		*InTAG = 0;
	   	SetFieldValFromCharAndName(lpGWDHead,"InClassNum",(LPSTR)&ClassNo,TRUE);
	    SetFieldValFromCharAndName(lpGWDHead,"InClassDesc",(LPSTR)"",FALSE);
		st = GWDReplaceRecord (lpGWDHead,0,NULL,-1); 
	}
    GlobalUnlock (hDB); 
    CloseGWDatabase (hDB); 
	ClearPolyOff();
	ClearHighlightList(FALSE); 
	rtn = TRUE;
Exit:
	SetCurView ( SaveVP);
	return rtn;
}  


BOOL FAR PASCAL TEXTSTRINGMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	
  
  HFILE Fid;
  OFSTRUCT OFStruct;
  HANDLE	hSTR;  
  static	HANDLE	hSaveBM=0;
  LPSTR		str, lpBAR; 
  static	BOOL	UseBAR;       
  short		Item,DefaultItem=-1;
  long		Loc; 
  DWORD		CBData;
  WORD		GeneratedInc;  
  static	POINT	CursorLoc;
  
 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:   
    	 hSaveBM = EnterBlockingWindow (hWndDlg);
    	 UseBAR = FALSE; 
    	 if (maxTEXTSTRING < 0)
    	 {
         	Wait (1000); //allows installer time to exit
    	 	maxTEXTSTRING *= -1;
         	cwCenter(hWndDlg, INT_MAX);   
         	BringWindowToTop(hWndDlg);
         }
         GetCursorPos (&CursorLoc);
         SetWindowText (hWndDlg,pTEXTSTRINGTITLE); 
         if (pTEXTSTRINGLIST)   
         {  
         	if (*pTEXTSTRINGLIST == '*')
         	{
         		char	txt[128];
         		
         		_fstrcpy (txt,pTEXTSTRINGLIST);
         		DlgDirListComboBox (hWndDlg,txt,IDC_STRINGLIST,0,DDL_READWRITE);
         	}
         	else
         	{
	         	Fid = GSSiOpenFile (pTEXTSTRINGLIST,&OFStruct,OF_READ);
	         	if (Fid == HFILE_ERROR) 
	         	{
	                 GSSiEndDialog(hWndDlg, FALSE,hSaveBM);
	                 break;
	            }
	            hSTR = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
	            str = GlobalLock (hSTR);
	         	Loc = _llseek (Fid,0,1);
	         	while (fgetstring (str,1020,Fid))
	         	{   
	         		if (!_fstrnicmp (str,"$GENLIST(",9))
	         		{
	         			DefaultItem = GenList (hWndDlg,IDC_STRINGLIST,TRUE,TRUE,str,pINITVAL,&UseBAR);
	         		}
	         		else
	         		{
		         		lpBAR = _fstrchr (str,'|');
		         		if (lpBAR)
		         		{
		         			*lpBAR = 0;
		         			UseBAR = TRUE;
		         		} 
		         		CBData = MAKELPARAM ((WORD)Loc,0);
		                Item = SendDlgItemMessage (hWndDlg,IDC_STRINGLIST,CB_ADDSTRING,0,(LPARAM)str); 
			         	SendDlgItemMessage (hWndDlg,IDC_STRINGLIST,CB_SETITEMDATA,(WPARAM)Item,(LPARAM)CBData);
			        }
		         	Loc = _llseek (Fid,0,1);
	            }
	            GSSiClose (Fid);
	            GSSiGlobUlFree (&hSTR);
	        }
         	ShowWindow (GetDlgItem(hWndDlg,IDC_STRINGLIST),SW_SHOW); 
         	SetFocusAndCursor (GetDlgItem(hWndDlg,IDOK));
/*            if (pINITVAL)
		    	SendDlgItemMessage (hWndDlg,IDC_STRINGLIST,CB_SELECTSTRING,-1,(LPARAM)pINITVAL);*/
	    	SendDlgItemMessage (hWndDlg,IDC_STRINGLIST,CB_SETCURSEL,DefaultItem,0L);
         }
         else
         {
         	ShowWindow (GetDlgItem(hWndDlg,IDC_STRING),SW_SHOW);   
         	if (AutoIncIntVal)
         	{
         		long	lval = atol (pINITVAL);
         		lval += AutoIncIntVal;
         		ltoa (lval,pINITVAL,10);
         		SetFocusAndCursor (GetDlgItem(hWndDlg,IDOK));
         	}
         	else
         		SetFocusAndCursor (GetDlgItem(hWndDlg,IDC_STRING));
         	SetDlgItemText(hWndDlg,IDC_STRING,pINITVAL);
         }
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDC_STRING:
            	switch (HIWORD(lParam))
            	{
            	        case EN_SETFOCUS: 
            	        	SetPrompt (PRMT_GETSTRING,FALSE);
                        break;

                }
                break;
            
            case IDOK: 
       	         if (pTEXTSTRINGLIST)
       	         {
				    Item=SendDlgItemMessage(hWndDlg,IDC_STRINGLIST,CB_GETCURSEL,NULL,NULL);
				    if (Item < 0) break;
       	         	if (UseBAR) 
       	         	{
                	 	CBData = SendDlgItemMessage(hWndDlg,IDC_STRINGLIST,CB_GETITEMDATA,Item, (LPARAM) 0);
                	 	Loc = LOWORD (CBData);
                	 	GeneratedInc = HIWORD (CBData);
			         	Fid = GSSiOpenFile (pTEXTSTRINGLIST,&OFStruct,OF_READ);
			            hSTR = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
			            str = GlobalLock (hSTR);  
			            _llseek (Fid,Loc,0);
			         	fgetstring (str,1020,Fid); 
			         	if (GeneratedInc)
			         	{ 
			         		GetGenListVal (str,GeneratedInc-1,str);
			         	}
			         	else
			         	{
				         	if ((lpBAR = _fstrchr (str,'|')))
				         	{   
				         		*lpBAR++ = 0;
				         		if (pINITVAL)
				         			_fstrcpy (pINITVAL,str);
				         		str = lpBAR;
				         	}	
				         	if ((lpBAR = _fstrchr (str,'|')))
				         	{   
				         		*lpBAR++ = 0;
				         		ExpandText (lpBAR);
				         	}
				         	else
				         		ExpandText (str);
				        }	
			         	_fstrncpy (pTEXTSTRING,str,maxTEXTSTRING);
			         	GSSiClose (Fid);
			         	GSSiGlobUlFree (&hSTR);
       	         	}
       	         	else 
       	         	{
	            		GetDlgItemText(hWndDlg,IDC_STRINGLIST,pTEXTSTRING,maxTEXTSTRING+1); 
		         		if (pINITVAL)
		         			_fstrcpy (pINITVAL,pTEXTSTRING); 
		         	}
	             }
	             else
	             {
	            	 GetDlgItemText(hWndDlg,IDC_STRING,pTEXTSTRING,maxTEXTSTRING+1);
		         		if (pINITVAL)
		         			_fstrcpy (pINITVAL,pTEXTSTRING);
		         } 
                 GSSiEndDialog(hWndDlg,TRUE,hSaveBM); 
               	 SetCursorPos (CursorLoc.x,CursorLoc.y);

              break;   
              
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 GSSiEndDialog(hWndDlg, FALSE,hSaveBM);
               	 SetCursorPos (CursorLoc.x,CursorLoc.y);
                 break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
} /* End of TEXTSTRINGMsgProc                                      */

BOOL GetTextString (HWND hWnd,LPSTR String,short lenstring, LPSTR Title,LPSTR ListFile,LPSTR InitVal,long AutoInc)
{
	HANDLE hString, hTitle;
	FARPROC lpfnTEXTSTRINGMsgProc;
	int		nRc;
	char	str[256], InitValc[64];
	BOOL	SaveDoPaint = DoPaint;
	
	DoPaint = FALSE;
	_fstrcpy (str,String); 
	AutoIncIntVal = AutoInc;
	pTEXTSTRING=str;
	pTEXTSTRINGTITLE=Title; 
	pTEXTSTRINGLIST=ListFile; 
	*InitValc = 0;
	if (InitVal)  
		pINITVAL=InitVal;
	else
		pINITVAL=str;
	maxTEXTSTRING=lenstring;
	EnableWindow (hWnd,FALSE);
	lpfnTEXTSTRINGMsgProc = MakeProcInstance((FARPROC)TEXTSTRINGMsgProc, hInst);
	nRc = DialogBox(hInst, (LPSTR)"TEXTSTRING", hWnd, lpfnTEXTSTRINGMsgProc);
	FreeProcInstance(lpfnTEXTSTRINGMsgProc);
	EnableWindow (hWnd,TRUE);
	if (nRc)
		_fstrcpy (String,str);
	DoPaint = SaveDoPaint;
	return (nRc);
}

BOOL GetTextStringML (HWND hWnd,LPSTR String,short lenstring, LPSTR Title,LPSTR InitVal)
{
	HANDLE hString, hTitle;
	FARPROC lpfnTEXTSTRINGMsgProc;
	int		nRc;
	char	str[256], InitValc[64];
	BOOL	SaveDoPaint = DoPaint;
	
	DoPaint = FALSE;
	_fstrcpy (str,String); 
	AutoIncIntVal = 0;
	pTEXTSTRING=str;
	pTEXTSTRINGTITLE=Title;  
	pTEXTSTRINGLIST=NULL;
	*InitValc = 0;
	if (InitVal)  
		pINITVAL=InitVal;
	else
		pINITVAL=str;
	maxTEXTSTRING=lenstring;
	EnableWindow (hWnd,FALSE);
	lpfnTEXTSTRINGMsgProc = MakeProcInstance((FARPROC)TEXTSTRINGMsgProc, hInst);
	nRc = DialogBox(hInst, (LPSTR)"TEXTSTRING_ML", hWnd, lpfnTEXTSTRINGMsgProc);
	FreeProcInstance(lpfnTEXTSTRINGMsgProc);
	EnableWindow (hWnd,TRUE);
	if (nRc)
		_fstrcpy (String,str);
	DoPaint = SaveDoPaint;
	return (nRc);
}

BOOL SetScale (LPSTR Scale)
{   
	BOOL	rtn=TRUE;
	if (!_fstricmp (Scale,"REMOVE"))
	{
		CurView->WindowZoomedToOrtho=FALSE; 
		CurView->OrthoRes=0;   
		SetGlobalValue("%SCALE","");
	}
	else
	{
	}
	return rtn;
}

BOOL FAR PASCAL ZOOMSCALEMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	int		st, Choice;
	HFILE	Fid;
	static	int	CurrentScale=-1;
 	static	int		iunits=0, iper=0; 
 	static	char	OtherScale[32]="";
	long	FIPS, Recnum;
	int		nread;
	HANDLE	hBT;
	char	str[260];
	LPSTR	lpTab;
	int		TabStops[2]={400,500}; 
	OFSTRUCT	OFStruct;  
	

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
         /* initialize working variables                                */  
Redisplay: 
        if (CurView->WindowZoomedToOrtho && CurView->OrthoRes > 0)
        {   
        	int	DeviceRes;
        	
        	CurrentScale = -1;
			DeviceRes = GetDeviceCaps(CurView->hDC, LOGPIXELSX);
        	sprintf (OtherScale,"%.4f",CurView->OrthoRes*DeviceRes);  
        	iper = 0;
        	iunits = PRJ_UNITS[1]-1;
        }
        if (CurView->WindowZoomedToOrtho)
        	SetDlgItemText (hWndDlg,IDC_SCALE_VAL,OtherScale);  
		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_RESETCONTENT,NULL,NULL);
		SendDlgItemMessage (hWndDlg,IDC_SCALE_INCHORCM,CB_RESETCONTENT,NULL,NULL);
		SendDlgItemMessage (hWndDlg,IDC_SCALES,LB_SETTABSTOPS,2,(LPARAM)&TabStops);
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Feet"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Meters"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Miles"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Kilometers"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_INCHORCM,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Inch"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_INCHORCM,CB_ADDSTRING,(WPARAM)NULL,(LPARAM) "Centimeter"); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_UNITS,CB_SETCURSEL,(WPARAM)iunits,(LPARAM)NULL); 
 		SendDlgItemMessage (hWndDlg,IDC_SCALE_INCHORCM,CB_SETCURSEL,(WPARAM)iper,(LPARAM)NULL); 
		SendDlgItemMessage (hWndDlg,IDC_SCALES,LB_RESETCONTENT,NULL,NULL);
		Fid = GSSiOpenFile ("scales.txt",&OFStruct,OF_READ);
	    if (Fid==HFILE_ERROR)
	    {
	    	char	Name[128]="[%DATA_LOC]scales.txt";
	    	
	    	EnableWindow (GetDlgItem(hWndDlg,IDC_EDIT),FALSE);
	    	ExpandText (Name);
			Fid = GSSiOpenFile (Name,&OFStruct,OF_READ);
		    if (Fid==HFILE_ERROR) 
		    	break; 
		}
		else
	    	EnableWindow (GetDlgItem(hWndDlg,IDC_EDIT),TRUE);
		while (fgetstring (str,256,Fid))
		{   
			REPLAC (str,"|","\t",256);
			if (_fstrchr(str,'\t'))
		 		SendDlgItemMessage (hWndDlg,IDC_SCALES,LB_ADDSTRING,(WPARAM)NULL,(LPARAM) str); 
		} 
		GSSiClose (Fid);
        if (!CurView->WindowZoomedToOrtho)
        	EnableWindow (GetDlgItem(hWndDlg,IDC_REMOVE),FALSE);
        else
 			SendDlgItemMessage (hWndDlg,IDC_SCALES,LB_SETCURSEL,(WPARAM)CurrentScale,(LPARAM)NULL); 
        break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDC_SCALES: /* List box                           */
                 switch(HIWORD(lParam))
                 {   
                 	 case LBN_SELCHANGE:
                 	 	 SetDlgItemText (hWndDlg,IDC_SCALE_VAL,"");
                 	 	 break;
                 	 	 
                     case LBN_DBLCLK:
				         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
		 		     break;
		 		 }
		 		 break; 
		 	case IDC_SCALE_VAL:
				switch(HIWORD(lParam))
				{   
				 case EN_CHANGE:
				 	 GetDlgItemText (hWndDlg,IDC_SCALE_VAL,str,256);
				 	 if (str[0]) 
					 	SendDlgItemMessage (hWndDlg,IDC_SCALES,LB_SETCURSEL,-1,NULL);				 	 
				 	 break;
				                 	 	 
				}
				break; 
		 	
		 	case IDOK:
				 GetDlgItemText (hWndDlg,IDC_SCALE_VAL,OtherScale,sizeof(OtherScale));
				 if (OtherScale[0]) 
				 {  
				 	double	val; 
				 	double	UFac[4]={FTM,1.0,5280*FTM,1000.0}; 
				 	char	CUnits[32], CPer[32], SORB, ScaleText[128];  
				 	LPSTR	lpEnd;
				 	
				 	CurrentScale = -1;
				 	val = atof (OtherScale);
			    	iunits=SendDlgItemMessage(hWndDlg,IDC_SCALE_UNITS,CB_GETCURSEL,NULL,NULL); 
 		         	CurView->OrthoRes = -(val * UFac[iunits]);
			    	iper=SendDlgItemMessage(hWndDlg,IDC_SCALE_INCHORCM,CB_GETCURSEL,NULL,NULL);
			    	if (iper)
			    		CurView->OrthoRes /= INCHES_PER_CM; 
			        SendDlgItemMessage(hWndDlg,IDC_SCALE_UNITS,CB_GETLBTEXT,iunits,(DWORD)&CUnits);
			        if (val == 1)
					{
						if (!iunits)
							_fstrcpy (CUnits,"Foot");
						else   
						{
							lpEnd = _fstrchr (CUnits,0);
							lpEnd--;
							*lpEnd=0;
						}
					}
			        SendDlgItemMessage(hWndDlg,IDC_SCALE_INCHORCM,CB_GETLBTEXT,iper,(DWORD)&CPer);
			    	sprintf (ScaleText,"%s %s/%s",OtherScale,CUnits,CPer);
			    	SetGlobalValue("%SCALE",ScaleText);

				 }
		 	     else
		 	     {
			    	 CurrentScale=SendDlgItemMessage(hWndDlg,IDC_SCALES,LB_GETCURSEL,NULL,NULL);
			         if (CurrentScale != LB_ERR)
			         {
				         SendDlgItemMessage(hWndDlg,IDC_SCALES,LB_GETTEXT,CurrentScale,(DWORD)&str);
		 		         lpTab = _fstrrchr(str,'\t'); 
		 		         *lpTab = 0;
				    	 SetGlobalValue("%SCALE",str);
		 		         lpTab++;
		 		         CurView->OrthoRes = -atof(lpTab);
		 		         if (_fstrchr(lpTab,'F'))
		 		         	CurView->OrthoRes *= FTM; 
		 		     }
		 		     else
		 		     	break;
		 		 }
	 		     CurView->WindowZoomedToOrtho=TRUE;  
				 GMEnableMenuItem(hWndMain, IDM_Z_IN, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
				 GMEnableMenuItem(hWndMain, IDM_Z_OUT, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
				 GMEnableMenuItem(hWndMain, IDM_Z_WINDOW, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
	 		     
	             EndDialog(hWndDlg, TRUE); 
		 	     break; 
		 	     
		 	case IDC_REMOVE:  
		 		 SetScale ("REMOVE");
				 GMEnableMenuItem(hWndMain, IDM_Z_IN, MF_BYCOMMAND | MF_ENABLED);
				 GMEnableMenuItem(hWndMain, IDM_Z_OUT, MF_BYCOMMAND | MF_ENABLED);
				 GMEnableMenuItem(hWndMain, IDM_Z_WINDOW, MF_BYCOMMAND | MF_ENABLED);
                 EndDialog(hWndDlg, FALSE); 
                 break;  
                 
            case IDC_EDIT:  
            	 _fstrcpy (str,"NOTEPAD.EXE ");
            	 _fstrcat (str,"scales.txt");
            	 WinExec (str,SW_SHOWMAXIMIZED);
                 goto Redisplay;
            	 break;
		 	     
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 EndDialog(hWndDlg, FALSE);
                 break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
} 

