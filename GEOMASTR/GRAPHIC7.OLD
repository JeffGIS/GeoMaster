UINT GetFunStackPrompt(void)
{   
	UINT	Prompt=0;  
	LPCMDSTRING    pCmdStr;
	
    if (CurView->FunStackHandle)
    { 
    	pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
    	Prompt = pCmdStr->Prompt;
    	GlobalUnlock (CurView->FunStackHandle);
    } 
	return Prompt;
}

void SetFunStackPrompt(UINT Prompt)
{
	LPCMDSTRING    pCmdStr;
    if (CurView->FunStackHandle)
    { 
    	pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
    	pCmdStr->Prompt = Prompt;
    	GlobalUnlock (CurView->FunStackHandle);
    } 
	return;
}

BOOL ConvertCDV101To102 (HFILE Fid,LPCOORDINATEDISPLAY CD)
{
    COORDINATEDISPLAY_V101 CD101; 
    UINT	i;

   	_lread (Fid,&CD101,sizeof(COORDINATEDISPLAY_V101));

	CD->ID = CD101.ID;
	CD->Version = 102;
	CD->TargetViewport = CD101.TargetViewport;
	CD->DisplayViewport = CD101.DisplayViewport; 
	_fmemmove (CD->AltCVTFile,CD101.AltCVTFile,14);
	CD->Font = CD101.Font;
	CD->FontColor = CD101.FontColor;
	CD->Refresh = CD101.Refresh;
	_fmemmove (CD->PrintText,CD101.PrintText,100);
	for (i=0;i<3;i++)
	{
		CD->DisplayLine[i] = CD101.DisplayLine[i];  
		_fmemmove (CD->LineID[i],CD101.LineID[i],34); 
		CD->Units[i] = CD101.Units[i];
		CD->Precision[i] = CD101.Precision[i];
		CD->Commas[i] = CD101.Commas[i];
	}
	return TRUE;
}

BOOL ReadObject (int Fid, BOOL UpdateTarget,LPVOID *RtnAdd,short WantID)
{   short ObjectID,Version,nVars;   
	UINT	Length;
	long	ii, StartLoc, lMem;
    LPVIEWPORT  SaveView;
    HANDLE  handle, hMem;
    LPCOORDINATEDISPLAY CD; 
    LPSTR	pObject, pVName, pVVal, pTemp;
    char    FoundLit=0;
	TAGBOX	TAGBox;
	LPMNMXCORD	pRect; 
	HPDPOINT	pPoint;
    
    if (_lread (Fid,&ObjectID,2) != 2)
    	return FALSE;   
    if (ObjectID < 0) 
    	BlowOut ("Invalid object in configuration file",NULL);
    if (WantID && ObjectID != WantID) 
    {
    	_llseek (Fid,-2,1);  
    	return FALSE;
    }
    _lread (Fid,&handle,2);
    _lread (Fid,&Version,2);
    StartLoc = _llseek (Fid,-6,1);
    
    switch (ObjectID)
    {   
    	case OB_SAVEINFOBOX:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Version,2);
			while (_lread(Fid,&TAGBox,sizeof(TAGBOX)) ==  sizeof(TAGBOX))
			    SaveTAG(0);
    		return TRUE;
    		
    	case OB_SAVEMASK:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&CurView->NumMaskPoints,2);
		    CurView->hMaskArea = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(MNMXCORD)+(long)CurView->NumMaskPoints*sizeof(DPOINT));
		    pRect = (LPMNMXCORD) GlobalLock (CurView->hMaskArea);
			_lread (Fid,pRect,sizeof(MNMXCORD));
			pRect++;
			pPoint = (HPDPOINT) pRect; 
			BigRead (Fid,(HPSTR)pPoint,(long)CurView->NumMaskPoints*(long)sizeof(DPOINT)); 
			GlobalUnlock (CurView->hMaskArea); 
    		return TRUE;
    		
    	case OB_SAVEGLOBALS:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&nVars,2);
			_lread (Fid,&lMem,4); 
			hMem = GSSiGlobAlloc (GMEM_MOVEABLE,lMem+1024);
			pVName = GlobalLock (hMem); 
			pTemp = pVName + lMem;
			BigRead (Fid,pVName,lMem);
			while (nVars--)
			{
				pVVal = _fstrchr (pVName,0);
				pVVal++;  
				FoundLit = *pVVal++; 
				if (_fstricmp (pVName,"%SYM_DICT") && 
					_fstricmp (pVName,"%DATA_LOC") &&
					_fstricmp (pVName,"%DL") &&
					GetVarSaveStatus (pVName) ) 
				{
					if (!_fstrncmp (pVVal,"[%DL]",5))
					{
						_fstrcpy (pTemp,"[%DL]"); 
						ExpandText (pTemp); 
						_fstrcat (pTemp,&pVVal[5]);
						SetGlobalValue3 (pVName,pTemp,0,(BOOL)FoundLit); 
					}
					else
						SetGlobalValue3 (pVName,pVVal,0,(BOOL)FoundLit);
				}
				pVName = _fstrchr (pVVal,0);
				pVName++;
			}
			GSSiGlobUlFree (&hMem);
    		return TRUE;
    		
    	case TR_ATTIMPORT:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
			GSSiGlobFree (&hAttImport);
    		hAttImport = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hAttImport);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hAttImport);
    		return TRUE;   
    		
    	case TR_STREET_SEG_FIELDS:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hStreetSegFields = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hStreetSegFields);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hStreetSegFields);
    		return TRUE;   
    		
    	case TR_IMPORT_LIMITS:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hImportLimits = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hImportLimits);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hImportLimits);
    		return TRUE;   
    		
    	case TR_IMPORT_FILTER:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hImportFilter = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hImportFilter);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hImportFilter);
    		return TRUE;   
    		
    	case TR_GRTEXT:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hGRText = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hGRText);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hGRText);
    		return TRUE;   
    		
    	case TR_GRCOMMAND:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hGRCommand = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hGRCommand);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hGRCommand);
    		return TRUE;   
    		
    	case TR_TIMESTAMP:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hTimeStamp = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hTimeStamp);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hTimeStamp);
    		return TRUE;   
    		
    	case TR_IMPORT_REFNO:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hImportRefno = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hImportRefno);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hImportRefno);
    		return TRUE;   
    		
    	case TR_IMPORT_SETUP:
			_lread (Fid,&ObjectID,2);
			_lread (Fid,&Version,2);
			_lread (Fid,&Length,2);
			
    		hImportPreSet = GSSiGlobAlloc (GMEM_MOVEABLE,Length); 
    		pObject = GlobalLock (hImportPreSet);
    		_llseek (Fid,StartLoc,0);
			_lread (Fid,&ObjectID,2);
    		_lread (Fid,pObject,Length);
    		GlobalUnlock (hImportPreSet);
    		return TRUE;
    		
    	case OB_HIGHLIGHTLIST:
			return (ReadHighlightListFromConfig (Fid));
    		
        case GF_SINGLE_VALUE_THEME:
        case GF_SINGLE_NONNUM_VALUE_THEME:
        case GF_TWO_VALUE_THEME:
        case GF_MULT_BITMAPS_THEME: 
        case GF_CRIME_THEME:  
        case GF_NETMARKER_THEME: 
        case GF_DOCUMENTS_THEME: 
        case GF_STREET_TEXT_THEME: 
        case GF_STREET_ADDRESS_THEME: 
        case GF_CONTEST_THEME:
		case GF_TRANSFORM_THEME:  
		case GF_HOTSPOT_THEME:
		case GF_BOUNDS_DISPLAY_THEME:
		case GF_DISTANCE_THEME:
		case GF_COORDGRID_THEME: 
		case GF_DYNAMIC_SEG_THEME:
		case GF_PROFILE_THEME:
		case GF_2D_THEME:
		case GF_GRAPHICS_FUNCTION_THEME: 
		case GF_POLYINFO_THEME:
        case GF_CACHE_DISPLAY_THEME:
    
            handle=GSSiGlobAlloc(GHND,sizeof(THEME));
            CurTheme=(LPTHEME)GlobalLock(handle); 
            switch (Version)
            {   
            	case 0:
            	{
            		HANDLE	handle_v0 = GSSiGlobAlloc(GHND,sizeof(THEME_v0));
            		LPTHEME_v0	pTheme_v0=(LPTHEME_v0)GlobalLock (handle_v0);
            		_lread (Fid,pTheme_v0,sizeof(THEME_v0)); 
            		ConvertThemeV0toV1 (CurTheme,pTheme_v0);
            		GSSiGlobUlFree (&handle_v0); 
            	}
            		break;
            	case CUR_THEME_VERSION:
            		_lread (Fid,CurTheme,sizeof(THEME)); 
            		break;
            }
            CurTheme->handle = handle;
			CurTheme->hDisperseFileName = 0; 
			CurTheme->hDisperseFile = 0;
			CurTheme->hHighlightFileName = 0; 
			CurTheme->hHighlightFile = 0;
            CurTheme->hThemeDB = 0;
            CurTheme->ScatterFile[0]=0; 
            CurTheme->hScatterFile = 0;
            CurTheme->HotSpotData.hGrid = 0;  
            CurTheme->HotSpotData.hMask = 0;  
            CurTheme->HotSpotData.hTranBaseToHotSpot = 0;  
            
            if (UpdateTarget)
            {
                SaveView = CurView;
                SetCurView ( pViewports[CurTheme->TargetViewport-1]); 
                if (CurView)
                {
                    CurView->pThemes[CurView->NumThemes]=CurTheme;
                    CurView->NumThemes++;  
                } 
                if (CurTheme->ID == GF_TRANSFORM_THEME)
                {
	                SetCurView ( pViewports[CurTheme->ReScan-1]); 
	                if (CurView)
	                {
	                    CurView->pThemes[CurView->NumThemes]=CurTheme;
	                    CurView->NumThemes++;  
	                }
	            }
                SetCurView (SaveView); 
            } 
            if (CurTheme->ID == GF_SINGLE_VALUE_THEME || CurTheme->ID == GF_TWO_VALUE_THEME)
            { 
                if (CurTheme->Recompute)
                {
                    CurTheme->WantDataPass = TRUE;
                    CurTheme->ComputeClassBoundaries = TRUE;                    
                }
            }
            if (CurTheme->ID == GF_SINGLE_NONNUM_VALUE_THEME)
            {
#if WIN32
				char *pRecs;
#else
                char huge   *pRecs;
#endif
                HANDLE  hRecs;
                short     ClassNo, len;  
                LPINT   lpint; 
                long    NumRecs;
                LPSTR   lpVal;  
                char	Key[210];
                                
                NumRecs = 0;                    
                ii=_lread(Fid,&NumRecs,4);
                if (NumRecs || CurTheme->AutoClassDef)
                {
                    CurTheme->hScatterFile = CreateClassValueList();
					if (CurTheme->FieldFun[0]) 
					{           // temp code 12/11/99
						len =  GetGlobalLVal2 ("[%EXLEN]",128); 
						if (len < 128)
							SetGlobalValueLong ("%EXLEN",128);
					}
					else 
						len = GetBTKeyLen(CurTheme->hScatterFile);    
//                  		len = GetValListFieldLen (&CurTheme->Field[0]); 
                  	len = min (len,200);
                    hRecs = GlobalAlloc (GMEM_MOVEABLE,NumRecs*(2+len));
                    pRecs = GlobalLock(hRecs);  
                    BigRead (Fid,pRecs,NumRecs*(2+len));
                    while (NumRecs--)
                    {   
                        lpVal = pRecs; 
                        _fstrncpy (Key,lpVal,len);
                        pRecs += len;
                        lpint = (LPSHORT) pRecs;
                        ClassNo = *lpint++;
                        BT_PUT(CurTheme->hScatterFile,(LPSTR)Key,(LPSTR)&ClassNo);
                        pRecs = (LPSTR) lpint;
                    }
                    GSSiGlobUlFree (&hRecs);
                    BT_CLOSE(CurTheme->hScatterFile);
                    CurTheme->hScatterFile = 0;
                }
            }
            if (CurTheme->ID == GF_STREET_TEXT_THEME) 
            {
			    LPSTREETTEXTDATA	pStreetData=(LPSTREETTEXTDATA)CurTheme->ClassBM;
				pStreetData->hNameFile1 = pStreetData->hNameFile2 = 0;
				*pStreetData->NameFile1 = *pStreetData->NameFile2 = 0;
            }
            if (CurTheme->ID == GF_DOCUMENTS_THEME)
            {
                short     NumDocs;
                LPSHORT   pNumDocs;
                LPSTR   pName; 
                
                _lread(Fid,&NumDocs,2);
                if (hDesiredDocs)
                    GlobalFree (hDesiredDocs);
                if (NumDocs)
                {                             
                    hDesiredDocs = GSSiGlobAlloc (GHND,sizeof(short)+14*NumDocs);
                    pNumDocs = (LPSHORT)GlobalLock (hDesiredDocs);
                    *pNumDocs = NumDocs;  
                    pNumDocs++;
                    pName = (char *)pNumDocs; 
                    _lread (Fid,pName,NumDocs*14);
                    GlobalUnlock (hDesiredDocs);
                }
            } 
            
            *RtnAdd = CurTheme;
            return TRUE;
            break;
            
        case PF_COORD_DISPLAY:
        
            handle=GSSiGlobAlloc(GHND,sizeof(THEME));
            CD=(LPCOORDINATEDISPLAY)GlobalLock(handle);
            if (Version == 101) 
            	ConvertCDV101To102 (Fid,CD);
            else if (Version == 102) 
            	_lread (Fid,CD,sizeof(COORDINATEDISPLAY)); 
            else
            	_lread (Fid,CD,sizeof(COORDINATEDISPLAY_V0));
            CD->handle = handle;
            AddPassiveFun (CD);
            
            *RtnAdd = CD;
            return TRUE;
            break;
    } 
    return FALSE;

}

void CloseObject (LPVOID pObject)
{   OFSTRUCT    OFStruct;
    HANDLE  handle;
    
    CurTheme = pObject;
    if (!CurTheme)
    	return;
    switch (CurTheme->ID)
    {
        case GF_SINGLE_VALUE_THEME:
        case GF_SINGLE_NONNUM_VALUE_THEME:
        case GF_TWO_VALUE_THEME:
        case GF_MULT_BITMAPS_THEME:  
        case GF_CRIME_THEME: 
        case GF_NETMARKER_THEME:  
        case GF_DOCUMENTS_THEME:  
        case GF_CONTEST_THEME:
        case GF_TRANSFORM_THEME: 
		case GF_BOUNDS_DISPLAY_THEME:
		case GF_DISTANCE_THEME:
		case GF_COORDGRID_THEME:
		case GF_DYNAMIC_SEG_THEME:
		case GF_PROFILE_THEME:
		case GF_2D_THEME: 
		case GF_GRAPHICS_FUNCTION_THEME:
            
            if (CurTheme->hScatterFile)
				BT_CLOSEANDDELETE (&CurTheme->hScatterFile);
			else if (*CurTheme->ScatterFile)
				GSSiOpenFile (CurTheme->ScatterFile,&OFStruct,OF_DELETE);
			CurTheme->ScatterFile[0] = 0;
			DeleteThemeHighlightFile ();
			DeletePointDispersionFile ();
		    CloseThemeDataFile (TRUE);
	FreeTheme:
			handle = CurTheme->handle;
			GSSiGlobUlFree (&handle); 
			CurTheme = 0;
			break;  
			
        case GF_STREET_ADDRESS_THEME: 
		case GF_STREET_TEXT_THEME:
	    	GSSiGlobFree (&CurTheme->hScatterFile);
			
    	case PF_COORD_DISPLAY:   
    	case GF_POLYINFO_THEME:
        case GF_CACHE_DISPLAY_THEME:
	    	goto FreeTheme; 
	    
        case GF_HOTSPOT_THEME:
	    	GSSiGlobUlFree (&CurTheme->HotSpotData.hGrid);
			GSSiGlobUlFree (&CurTheme->HotSpotData.hMask);
			CloseTRANS2 (&CurTheme->HotSpotData.hTranBaseToHotSpot);
	    	goto FreeTheme; 

    } 
    return;
}
BOOL AddSymToMap (short NumSyms,HANDLE hSymDesc,short NumPens,LPPENDESC pPenDesc)
{   
    LPSYMDESC pSymDesc;
    char    Name[128];  
    mnmxCor     MinMax;  
    long    NewPrimeOffset, MemLen;
    HANDLE  hMem;
    LPSHORT   pInt;  
    short	nbytes;
    HANDLE	hSpace, hPar, hSym;    
    short	nPar=0, nSym=0, NumNew=0;
    LPSTR	Space;
    OFSTRUCT    OFStruct;
    short     	lMem, Signature, Version, i2, i, n, NumParent, ndesc,idesc;  
    LPSHORT		ipnt;
    short SymNameLen=32, iparent;
    PRIMEOFFSETS NewPrimeOffs;
    LPSYMBOL    pSymbol;
    BOOL	parent=FALSE, Opened;   
    char	Drive[4], Dir[128],name[34],Ext[8], TempName[128], DescName[34]; 
typedef    struct	{short	desc,parent;
    		 char	Name[32];} SYMENTRY;
typedef	SYMENTRY	FAR	*LPSYMENTRY;
	LPSYMENTRY	pPar, pSym, pEnt;
	
	if (!NumSyms)
		return TRUE;
    if (Fid>=0)
    	Opened = FALSE;
    else  
	{
		Opened = TRUE;		
    	if (!OpenMap (0,0))
    		return FALSE;
    }
   	if (MapVersion < 8)
   		return FALSE; 
   	_llseek (Fid,-18,2);
   	_lread (Fid,(char *)&NewPrimeOffset,4);
    _lread (Fid,(char *)&MinMax,8);
    _lread (Fid,(char *)&Signature,2);
    _lread (Fid,(char *)&Version,2);
   	_llseek (Fid,NewPrimeOffset+2,0); 
   	_lread (Fid,&NewPrimeOffs,sizeof(NewPrimeOffs));
    _llseek(Fid,NewPrimeOffs.UsedDescOffset,0);
    _lread (Fid,&nbytes,2);
    hSpace = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nbytes);
    Space = GlobalLock (hSpace);
    ipnt = (LPSHORT)Space;
    _lread (Fid,Space,(WORD)nbytes);
    
    MemLen = UINT_MAX;
    hSym = GSSiGlobAlloc (GMEM_MOVEABLE,MemLen);  
    pSym = (LPSYMENTRY)GlobalLock (hSym);
    hPar = GSSiGlobAlloc (GMEM_MOVEABLE,MemLen);
    pPar = (LPSYMENTRY)GlobalLock (hPar);   
    pEnt = pSym;
    ipnt++;                
moredesc:
    ndesc = *ipnt;
	ipnt++;
	for (i=0;i<ndesc;i++)
	{	
		idesc=abs (*ipnt);
		ipnt++;
		iparent=*ipnt;
		ipnt++;
    	_fmemmove (DescName,ipnt,SymNameLen); 
    	DescName[SymNameLen]=0;
    	Truncate (DescName);
    	if (!_fstricmp(DescName,"ALL"))
    		iparent=0;  
    	if (parent)
    		nPar++;
    	else
    		nSym++;
		pEnt->desc=idesc;
		pEnt->parent=iparent;
		_fstrncpy (pEnt++->Name,DescName,32);
    	ipnt+=(SymNameLen/2);
	}
	if (!parent)
		pEnt = pPar;
	parent = TRUE;  
	if (ndesc)
		goto moredesc;
	GSSiGlobUlFree (&hSpace);
	    
    n = NumSyms; 
    NumParent = 0;
    pSymDesc = (LPSYMDESC)GlobalLock (hSymDesc);
    while (n--)
    {   
		if (!pSymDesc->Handle)
		    pSymDesc->Handle = GetDictSymDesc (pSymDesc->Number); 
        pSymbol = (LPSYMBOL)GlobalLock (pSymDesc->Handle);
        if (!pSymbol->Type) 
        {   
        	for (i=0,pEnt=pPar;i<nPar;i++,pEnt++)
        		if (!_fstricmp(pEnt->Name,pSymbol->Name))
        			goto SkipAdd;
        	pEnt = pPar + nPar;
            nPar++;
            NumNew++;            
        }
        else
        {
        	for (i=0,pEnt=pSym;i<nSym;i++,pEnt++)
        		if (!_fstricmp(pEnt->Name,pSymbol->Name))
        			goto SkipAdd;
        	pEnt = pSym + nSym;
            nSym++; 
            NumNew++;           
        }
		pEnt->desc=pSymDesc->Number;
		pEnt->parent=pSymbol->Parent;
		_fstrncpy (pEnt++->Name,pSymbol->Name,32);
SkipAdd:
        GlobalUnlock (pSymDesc->Handle);
    	DestroySymbol (pSymDesc->Handle); 
    	pSymDesc++->Handle = 0;
    }
    GlobalUnlock (hSymDesc);
    
    if (NumNew)
    {
	    NewPrimeOffs.UsedDescOffset = _llseek (Fid,-18,2); 
	    lMem = (1+nSym+nPar)*36+2+2+2+2+2;  
	    _lwrite (Fid,(char *)&lMem,2);
	    i2 = 11; 
	    _lwrite (Fid,(char *)&i2,2);
	    _lwrite (Fid,(char *)&nSym,2);  
	    pEnt = pSym;
	    n=nSym;
	    while (n--)
	        _lwrite (Fid,(char *)pEnt++,sizeof(SYMENTRY));
	    pEnt = pPar;
	    _lwrite (Fid,(char *)&nPar,2);
	    n=nPar;
	    while (n--)
	        _lwrite (Fid,(char *)pEnt++,sizeof(SYMENTRY));
	    i2 = 0;  
	    _lwrite (Fid,(char *)&i2,2); 
	    _lwrite (Fid,(char *)&i2,2); 
	    
	    NewPrimeOffset = _llseek (Fid,0,1);    
	    i2 = sizeof(NewPrimeOffs);
	    _lwrite (Fid,(char *)&i2,2);
	    if (NewPrimeOffs.Code202 != 202)
	    {
	        NewPrimeOffs.Code202 = 202;                 
	        NewPrimeOffs.MinTime=0;
	        NewPrimeOffs.MaxTime=LONG_MAX; 
	    }
	    _lwrite (Fid,(char *)&NewPrimeOffs,sizeof(NewPrimeOffs));
	    _lwrite (Fid,(char *)&NewPrimeOffset,4);
	    _lwrite (Fid,(char *)&MinMax,8);
	    Signature = 32349;       
	    _lwrite (Fid,(char *)&Signature,2);
	    Version = 8;            
	    _lwrite (Fid,(char *)&Version,2);
	    _lwrite (Fid,(char *)&Version,2); 
	    if (Opened)
	    	CloseMap (FALSE);  
		LastQuadOff=-2; //need to be set when anything but GetFileConnectOffset writes to file
	}
	else if (Opened)
		CloseMap (FALSE);
    GSSiGlobUlFree (&hSym);
    GSSiGlobUlFree (&hPar);
    return TRUE;
} 

short GetBaseRecordType (short Type)
{
	switch (Type)
	{
		case 1: 
		case GF_POINT:
		case GF_LINE:
		case GF_CURVE:
		case GF_POLYLINE:
		case 2:      
		case 4:
		case 5:
			Type = 1;
			break;
		case 3:       
		case GF_AREA:
			Type = 0;    
			break;
		case GF_TEXT:
			Type = 2;
			break;
	}
	return Type;
}

BOOL UpdateRecord (short Item,short NewDesc,LPSTR NewPrefix, LPSTR NewUDI,LPLINEDESCRIPTION pNewLineDesc, LPAREADESCRIPTION pNewAreaDesc,short WhichFile)
{   
//Which file = 0 if same as picked, 1 if EditFile, 2 if delete from existing and copy to edit file
    HANDLE	hBuf, hRec;
    HPSTR	pBuf; 
    BOOL	First;
	LPSTR	Rec;  
	long	RecLen, loc, Offset, item_len;
	short	Type, id;
	mnmxCor		MinMax;  
	LPITEM	pRecHeader;
	LPITEM	ItemHeader;  
    LPVIEWPORT	SaveView = CurView;  
    PICKDATA   PickSave;
	
    if (!GetPickName (Item))  
    {
    	UpdateItem = 0;
        return FALSE;  
    }
    PickSave = PickList[Item]; 
    SetViewport (PickList[Item].ViewID);
    Type = GetBaseRecordType (PickList[Item].Type); 
    _fstrcpy (PltName,PickName);
	CopyRec = TRUE;
	hUpdateBuf = GSSiGlobAlloc (GMEM_MOVEABLE,MAXREORGBUF); 
	lUpdateBuf = 0;  
	KeepTranFileToBase = 1;
	ProcessPickedItem (Item,FALSE); 
	CopyRec = FALSE; 
	
/*	if (pNewAreaDesc)
	{
		id = 22;
		BufWrite(&pBuf,&lbuf,(HPSTR)&id,2);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewAreaDesc->Pattern,2);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewAreaDesc->ForeColor,4);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewAreaDesc->BackColor,4);
	}
	if (pNewLineDesc)
	{
		if (HiPrecis)
			id = 121;
		else
			id = 21;
		BufWrite(&pBuf,&lbuf,(HPSTR)&id,2);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewLineDesc->Color,4);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewLineDesc->Width,2);
		BufWrite(&pBuf,&lbuf,(HPSTR)&pNewLineDesc->Style,2);
	}*/
	      		
    if (!WhichFile)
		DeletePickedItem (Item,12,92);
	else if (CurView->UpdateFile)
	{
	   	_fstrcpy (PltName,CurView->lpFiles[CurView->UpdateFile-1]);
	   	PltType = CurView->FileType[CurView->UpdateFile-1];  
	}
	else  
		goto RtnFalse;
    ForceRefIndex = ForceTAGIndex = TRUE;  
	if (!OpenMap (CurView->hWnd,NULL))
	{   
RtnFalse:
	    ForceRefIndex = ForceTAGIndex = FALSE; 
	    GSSiGlobFree (&hUpdateBuf); 
		CloseTRANS2 (&KeepTranFileToBase);
	    UpdateItem = 0; 
	    SetCurView ( SaveView);
		return(FALSE); 
	}
    pBuf = (HPSTR)GlobalLock (hUpdateBuf); 
    pRecHeader = (LPITEM)pBuf;  
    item_len = lUpdateBuf/2 - 6;
	if (item_len > 16000)
		item_len=0;
	else
		item_len = -item_len;
    pRecHeader->Len = item_len; 
    pBuf += lUpdateBuf;
	id=13;
	BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&id,2);
	Offset = -1;
	BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&Offset,4);
	id = 0;
	BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&id,2);  
	GlobalUnlock (hUpdateBuf);
    pBuf = GlobalLock (hUpdateBuf); 
    hTranCopyFile = KeepTranFileToBase; 
	RecomputeMinMax (&MinMax,pBuf,lUpdateBuf,0,NULL); 
	hTranCopyFile = 0;
	CloseTRANS2 (&KeepTranFileToBase);
	ItemHeader = (LPITEM)pBuf; 
    ItemHeader->MinMax = MinMax;
    First = TRUE;  
    hRec = 0; 
    while (SplitRec (&(HPSHORT)pBuf,&lUpdateBuf,&(LPSHORT)Rec,&RecLen,&hBuf,&hRec,TRUE))
    {
		loc = GetFileConnectOffset(Type,NewDesc,MinMax,(short)RecLen,-1,Rec); 
		if (First)
		{
			First = FALSE;
			CurrentItem = loc - CurrentSeg -2;
			ItemSeg = CurrentSeg;
		}    
	    GSSiGlobUlFree (&hUpdateBuf);
	}
   	FileInIndex=0;
   	CurrentRefno=PickList[Item].Refno;
   	BuildRefIndex(TRUE,FALSE);
   	if (NewPrefix)	
		BuildTAGIndex (NewPrefix,NewUDI,0,CurrentRefno,FALSE);
	CloseMap (TRUE); 
	{
		HANDLE	hSymDesc=0;
		short	NumSyms=0;  
		AddToSymList (NewDesc,&NumSyms,&hSymDesc); 
		AddSymToMap (NumSyms,hSymDesc,0,NULL); 
        DestroySymList (&NumSyms,&hSymDesc);
    }
    ForceRefIndex = ForceTAGIndex = FALSE;  
    UpdateItem = 0;
    PickList[Item] = PickSave;   
 	if (WhichFile == 2)
		DeletePickedItem (Item,12,92);    
    SetCurView ( SaveView);
	return(TRUE);
}

void SkipSubRec (LPBYTE Pcode,HPSHORT *ipnt)
{	int		idesc, ItemLen, TSize, ltag;
	long	*pRefno;
	long	remlen; 
	static	long	LastRef;    
	static	short	nPnts;

    switch (*Pcode)
    {   
		case 1:
			(*ipnt) += 6;
		break;
		
		case 25:			
	    case 2: /* pen up */
		{
			(*ipnt)++;
			(*ipnt)++;
			/*pu++;*/
		}
	    break;
	
	    case 3: /* set pen */
		{    
			(*ipnt)++;
		}
	    break;
	
	    case 4: /* put line */
		{
			nPnts = 2;    
			CurElementType = GF_LINE;
			goto DoPolyline;
		}
	    break;
	
	    case 41: /* put line */
		{
			nPnts = 2;
		    *ipnt = (*ipnt) + nPnts * 8;
			CurElementType = GF_LINE;
		}
	    break;
	
	    case 5: /* put area */
	
			(*ipnt)++;
			CurElementType = GF_AREA;
	
	    case 6: /* put polyline */
	
		{   nPnts = *(*ipnt);
			CurElementType = GF_POLYLINE;
		    (*ipnt)++;
	DoPolyline://lpCurPoints = (HPPOINT) (*ipnt);
		    *ipnt = (*ipnt) + nPnts * 2;
		}
		break;
	
	    case 51: /* put area */
	
			(*ipnt)++;
			CurElementType = GF_AREA;
	
	    case 61: /* put polyline */
	
		{   nPnts = *(*ipnt);
		    (*ipnt)++;
//	        lpDCurPoints = (HPDPOINT) (*ipnt);
		    *ipnt = (*ipnt) + nPnts * 8;
			CurElementType = GF_POLYLINE;
		}
		break;
	
		case 7: /* block minmax */
		{	
			*ipnt += 4;
	    }
	    break;
	
	    case 8:	/*	description */
		{   
		 	CurrentDesc = **ipnt;
			(*ipnt)++;
	    }
	    break;
	
	    case 9:	/*	refno	*/
	    {   
	    	short ii;   
	    	static	long	debugrefno=1591435;
	    	  
           	pRefno =(LPLONG) *ipnt;
           	CurrentRefno = LastRef = *pRefno; 
           	if (CurrentRefno == debugrefno)
           		ii=1;
        	(*ipnt) += 2; 
        	ltag = *++Pcode;
        	if (ltag) 
        	{   LPSTR	lpTAG;
                	
        		lpTAG = (LPSTR)(*ipnt);
				(*ipnt) = (LPINT) (lpTAG + ltag + ltag%2);
			}  
	    }
	    break;
	
	    case 10:/*	street numbers	*/
	    {   (*ipnt) += (2*4);
	    }
	    break;
	
        case 11: /* get used description list*/
        {   int	ndesc, i;
                
moredesc:   ndesc = *(*ipnt);
        	ipnt++;
        	for (i=0;i<ndesc;i++)
        	{	ipnt++;
        		ipnt++;
            	ipnt+=4; 
            }
        	if (ndesc) goto moredesc;
        }
        break;
        
        case 92: /* deleted record */
		case 12: /* item minmax */
		{	
						    
			(*ipnt) += 4;
			ItemLen = abs(**ipnt);
			(*ipnt)++;
	    }
	    break;
	
		case 13: /* continuation offset */
		{	ContinuationOffset = *(LPLONG)(*ipnt);
			(*ipnt) += 2;
			**ipnt = 0;
	    }
	    break;
	
		case 14: /* text size */
		{	(*ipnt)++;
	    }
	    break;
	
		case 15: /* point symbol */
			(*ipnt) += 3;
		break; 
		
		case 16: /* line symbol */
			(*ipnt) += 4;
		break; 
		
		case 172: // HiPrecis Curve
			(*ipnt)++;
			(*ipnt) += 24;
			CurElementType = GF_LINE;
		break;
		
		case 171:
			(*ipnt)++;
		case 17: /* curve symbol */
			(*ipnt) += 6;
			CurElementType = GF_LINE;
		break;
		
		case 18: /* text character*/
			(*ipnt) += 5;
		break;
		
		case 19: // graphics text
		{ 
			int		nchar;
			LPGRTEXTHEADER	pGRTextHeader;
			LPSTR	pText;
			
		    pGRTextHeader = (LPGRTEXTHEADER)*ipnt;
		    (*ipnt) += sizeof(GRTEXTHEADER) / 2;  
		    nchar = pGRTextHeader->lText;  
		    (*ipnt) += nchar/2;
		}
		break;   
		
		case 191: //text pointer
			(*ipnt) += 38/2;
		break;
		
		case 192: //text pointer (UltiMap Style)
			(*ipnt) += 50/2;
		break;
		
		case 20: /* point symbol with size and real rot*/
			(*ipnt) += 6;  
			CurElementType = GF_POINT;
		break;
		
		case 120: // hiprecis point
			(*ipnt) += 16;
			CurElementType = GF_POINT;
		break;
		
		case 121:    
    	case 21: /* set pen color, width and style*/
    	{   
    		(*ipnt) += 4; 
    	}
    	break;
	        	
    	case 22: /* set brush pattern color and forecolor*/
    	{   
    		(*ipnt) += 5; 
    	}
    	break;
	        	
    	case 23: /* clear temp pen and brush */   
    	case 24: // dummy delete
    	break; 
		
		case 127:
    	case 27: // Multipolygon indicator
    	case 28: // Curve Point ID's
    	{
    		short	n;   
    		
    		n = *(*ipnt);
		    (*ipnt)++;
    		while (n--)
    			(*ipnt)++;
        }
        break;
        
        case 32: //extra peoplenet data
		case 30: /* intersection data */
			(*ipnt) += **ipnt+1;
		break;

		case 31: /* intersection data */
			(*ipnt) += 12;
		break; 
		
	    case 35: /* point array */
	
		{   nPnts = *(*ipnt);
		    (*ipnt)++;
		    *ipnt = (*ipnt) + nPnts * 2;
		}
		break;   
		
	    case 135: /* Dpoint array */
	
		{   nPnts = *(*ipnt);
		    (*ipnt)++;
		    *ipnt = (*ipnt) + nPnts * 8;
		}
		break;   
		
		case 36: /* null code */
		break;   
		
		case 37: // time stamp
			(*ipnt) += 4;
		break;
	        	
	    case 38: /* Elevation array */
	
		{   nPnts = *(*ipnt);
		    (*ipnt)++;
		    *ipnt = (*ipnt) + nPnts * 2;
		}
		break;   
		
		case 40: /* command string */
		{                    
			lGCmdString = *(*ipnt);
		    (*ipnt)++;
			(*ipnt) += lGCmdString/2; 
		}
		break;	
	        	
        case 101:	/*	used description offset	*/
        {   
        	(*ipnt) += 2;
        }
        break;

	    case 102: /* color palette offset */
        {   
        	(*ipnt) += 2;
        }
        break;

        case 103: /* transformation point offset */
        {   
        	(*ipnt) += 2;
        }
        break;
        
        case 201: /* desc block offset */
        case 200: /* quad tree offset */
        {   
        	(*ipnt) += 2;
        }
        break;

	    default:
            ProcessInvalidRecord ((short)*Pcode,*ipnt,4);
	    break;
	
	}
	return;
} 

BOOL CopySubRec (LPBYTE Pcode,HPSHORT *ipnt)
{	short	idesc, ItemLen, TSize, ltag, n;
	long	*pRefno;
	long	remlen; 
	static	long	LastRef;    
	static	WORD	nPnts;
    HPSTR	pBuf;
    short	PointSize=4;  
    BOOL	rtn = FALSE;
	HPSTR	pCoords; 
	LPWORD	pMultiPolygon; 
	static	short	nPoly, iPoly; 
	LPWORD	pPartLen; 
	static	DPOINT	LinkPointD; 
	static	POINT	LinkPoint;
	static	long	PolyBufferLen;
    
    pBuf = GlobalLock (hUpdateBuf); 
    pBuf += lUpdateBuf;
    switch (*Pcode)
    {   
		case 1:
			(*ipnt) += 6;  
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+6*2);			
		break;
		
		case 25:			
	    case 2: /* pen up */
		{
			(*ipnt)++;
			(*ipnt)++;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+2*2);			
			/*pu++;*/
		}
	    break;
	
	    case 3: /* set pen */
		{    
			(*ipnt)++;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+1*2);			
		}
	    break;
	
	    case 4: /* put line */
		{
			nPnts = 2;  
			*Pcode = 6;
			goto DoPolyline;
		}
	    break;
	    
	    case 41: /* put line */
		{
			nPnts = 2;
	    	PointSize = 16; 
	    	*Pcode = 61;
			goto DoPolyline;
		}
	    break;
	    
	    case 51:
	    	PointSize = 16;
	    case 5: /* put area */
	
			(*ipnt)++;
		    nPnts = *(LPWORD)(*ipnt);
		    (*ipnt)++; 
			goto DoPolyline;
	    
	    case 61:
	    	PointSize = 16;
	    case 6: /* put polyline */
	
		{
		    nPnts = *(LPWORD)(*ipnt);
		    (*ipnt)++; 
DoPolyline:	
			if (PointSize == 4)
				lpCurPoints = (HPPOINT) (*ipnt);
			else
				lpDCurPoints = (HPDPOINT) (*ipnt);
		    *ipnt += nPnts * PointSize/2; 
		    if (hCoords) 
		    {
		    	nCoords += nPnts;
		    	hCoords = GlobalReAlloc (hCoords,(long)nCoords*PointSize,GMEM_MOVEABLE);
			    pCoords = GlobalLock (hCoords);
			    pCoords += lCoords;
		    	if (PointSize == 16)
		    	{
				    BufWrite (&pCoords,&lCoords,(HPSTR)lpDCurPoints,nPnts*PointSize);  
				    GlobalUnlock (hCoords);
				    lpDCurPoints = (HPDPOINT)GlobalLock (hCoords);
				}
				else
				{
				    BufWrite (&pCoords,&lCoords,(HPSTR)lpCurPoints,(long)nPnts*PointSize);  
				    GlobalUnlock (hCoords);
				    lpCurPoints = (HPPOINT)GlobalLock (hCoords); 
				}
			    nPnts = nCoords;
		    }
			if (nPoly)
			{   
				long	lbuf=0;
				
				pCoords = GlobalLock (hPolyBuffer);
				pCoords += ((long)nPolyPoints*PointSize);
				pPartLen = (LPWORD)GlobalLock (hPolyPartLen);
				pPartLen+=iPoly;
				*pPartLen = nPnts;
				GlobalUnlock (hPolyPartLen);
				if (PointSize == 16)
				{  
					BufWrite (&pCoords,&lbuf,(HPSTR)lpDCurPoints,(long)nPnts*PointSize);
					if (!iPoly)
						LinkPointD = *lpDCurPoints;
					else
					{
						*(HPDPOINT)pCoords = LinkPointD;
						nPolyPoints++; 
					}
				}
				else
				{
					BufWrite (&pCoords,&lbuf,(HPSTR)lpCurPoints,(long)nPnts*PointSize); 
					if (!iPoly)
						LinkPoint = *lpCurPoints;
					else
					{
						*(HPPOINT)pCoords = LinkPoint;
						nPolyPoints++; 
					}
				}
				nPolyPoints += nPnts; 
				iPoly++;   
				GlobalUnlock (hPolyBuffer);
			}           
			if (iPoly == nPoly)
			{
				if (*Pcode == abs(UpdateItem)) //negative updateitem forces data to hiprecis
				{   
					if (UpdateItem < 0)
						PointSize = 16;
					GSSiGlobFree (&hPolyBuffer); 
					nPnts = nPolyPoints = nUpdatePolyPoints;   
					hPolyBuffer = hUpdatePoly; 
					hUpdatePoly = 0;
					GSSiGlobFree (&hPolyPartLen);
					hPolyPartLen = hUpdateMultiPolygon; 
					hUpdateMultiPolygon = 0;
					nMultiPolygon = nUpdateMultiPolygon;
					hUpdateMultiPolygon = 0;
				}
				if (hPolyPartLen)
				{   
					short	pcode = 27;
						
					pMultiPolygon = (LPWORD)GlobalLock (hPolyPartLen);
					if (PointSize == 16)
						pcode = 127;
					BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&pcode,2);			
					BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&nMultiPolygon,2);			
					BufWrite(&pBuf,&lUpdateBuf,(HPSTR)pMultiPolygon,nMultiPolygon*2);			
					GlobalUnlock (hPolyPartLen);
					nPoly = nMultiPolygon;	
				}
				else
					nPoly = 1;
				if (hPolyBuffer)
				{
					if (PointSize == 4)
						lpCurPoints = (HPPOINT) GlobalLock (hPolyBuffer);
					else
						lpDCurPoints = (HPDPOINT) GlobalLock (hPolyBuffer);
				}
				for (iPoly = 0; iPoly<nPoly; iPoly++)
				{   
					if (nPoly > 1)
					{
						pMultiPolygon = (LPWORD)GlobalLock (hPolyPartLen); 
						pMultiPolygon += iPoly;
						nPnts = *pMultiPolygon;
						GlobalUnlock (hPolyPartLen);
					}
					switch (*Pcode)
					{   
						case 4: 
							if (PointSize == 16)
								*Pcode = 41;
						case 41:
							BufWrite(&pBuf,&lUpdateBuf,Pcode,2);
							break;
						case 6:
							if (PointSize == 16)
								*Pcode = 61;
						case 61: 
							if (nPnts == 2)
							{
								if (PointSize == 16)
									*Pcode = 61;
								else
									*Pcode = 6;
							}
							BufWrite(&pBuf,&lUpdateBuf,Pcode,2);
							BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&nPnts,2);			
							break;
						case 5:
							if (PointSize == 16)
								*Pcode = 51;
						default:
							BufWrite(&pBuf,&lUpdateBuf,Pcode,2+1*2);			
							BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&nPnts,2);			
					}	
					if (PointSize == 16) 
					{
						BufWrite(&pBuf,&lUpdateBuf,(HPSTR)lpDCurPoints,(long)nPnts*(long)PointSize);  
						lpDCurPoints += nPnts;
						if (iPoly)
							lpDCurPoints++;
					}
					else
					{
						BufWrite(&pBuf,&lUpdateBuf,(HPSTR)lpCurPoints,(long)nPnts*(long)PointSize);  
						lpCurPoints += nPnts;
						if (iPoly)
							lpCurPoints++;
					}
				}
				GSSiGlobFree (&hPolyPartLen);
				GSSiGlobUlFree (&hPolyBuffer); 
			}
			GSSiGlobUlFree (&hCoords);
		}
		break;
	
		case 7: /* block minmax */
		{	
			(*ipnt) += 4;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+4*2);			
	    }
	    break;
	
	    case 8:	/*	description */
		{   
			short	SymNum = *(*ipnt);
			
			if (UpdateItem == 8) 
				SymNum = NewSymbol;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2);			
			(*ipnt)++;
			BufWrite(&pBuf,&lUpdateBuf,(HPSTR)&SymNum,2);			
	    }
	    break;
	
	    case 9:	/*	refno	*/
	    {   
	    	short ii;
	    	LPSHORT	pcode=(LPSHORT)Pcode;  
	    	BYTE	byte;
	    	  
           	pRefno =(LPLONG) *ipnt;
           	CurrentRefno = LastRef = *pRefno; 
        	(*ipnt) += 2; 
        	ltag = *++Pcode;
        	if (ltag) 
        	{   LPSTR	lpTAG;
                	
        		lpTAG = (LPSTR)(*ipnt);
				(*ipnt) = (LPINT) (lpTAG + ltag + ltag%2);
			}
			if (UpdateItem == 9)
			{   
				byte = 9;
				BufWrite(&pBuf,&lUpdateBuf,&byte,1);	
				byte = lNewTAG;		
				BufWrite(&pBuf,&lUpdateBuf,&byte,1);			
				BufWrite(&pBuf,&lUpdateBuf,(HPSTR)pRefno,4);			
				BufWrite(&pBuf,&lUpdateBuf,NewTAG,lNewTAG + lNewTAG%2);			
			}
			else  
				BufWrite(&pBuf,&lUpdateBuf,(HPSTR)pcode,2+2*2+(ltag + ltag%2));			
	    }
	    break;
	
	    case 10:/*	street numbers	*/
	    {   (*ipnt) += (2*4);
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+8*2);			
	    }
	    break;
	
        case 11: /* get used description list*/
        {   int	ndesc, i;
                
moredesc:   ndesc = *(*ipnt);
        	ipnt++;
        	for (i=0;i<ndesc;i++)
        	{	ipnt++;
        		ipnt++;
            	ipnt+=4; 
            }
        	if (ndesc) goto moredesc;
        }
        break;
        
        case 92: /* deleted record */
		case 12: /* item minmax */
		{	
						    
			GSSiGlobFree (&hCoords);
			GSSiGlobFree (&hPolyPartLen);			
			GSSiGlobFree (&hPolyBuffer); 
			nPoly = iPoly = 0;
			if (HaveFirstHeader)    
			{
				if (ProcessSingleItem) 
					**ipnt = 0; 
			}
			else  
			{
				HaveFirstHeader=TRUE;
				(*ipnt) += 4;
				ItemLen = abs(**ipnt);
				(*ipnt)++;
				BufWrite(&pBuf,&lUpdateBuf,Pcode,2+5*2);
			}
	    }
	    break;
	
		case 13: /* continuation offset */
		{	ContinuationOffset = *(LPLONG)(*ipnt);
			(*ipnt) += 2;
			**ipnt = 0;   
			if (ContinuationOffset >=0) 
				rtn = TRUE;
	    }
	    break;
	
		case 14: /* text size */
		{	(*ipnt)++;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+1*2);			
	    }
	    break;
	
		case 15: /* point symbol */
			(*ipnt) += 3;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+3*2);			
		break; 
		
		case 16: /* line symbol */
			(*ipnt) += 4;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+4*2);			
		break; 
		
		case 172:
			(*ipnt)++;
			(*ipnt) += 24;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+2+6*8);			
		break;
		
		case 171:
			(*ipnt)++;
		case 17: /* line symbol */
			(*ipnt) += 6;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+6*2);			
		break;
		
		case 18: /* text character*/
			(*ipnt) += 5;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+5*2);			
		break;
		
		case 19: // graphics text
		{ 
			int		nchar;
			LPGRTEXTHEADER	pGRTextHeader;
			LPSTR	pText;
	    	BYTE	byte;
			
		    pGRTextHeader = (LPGRTEXTHEADER)*ipnt;
		    (*ipnt) += sizeof(GRTEXTHEADER) / 2;  
		    nchar = pGRTextHeader->lText;  
		    (*ipnt) += nchar/2; 
			if (UpdateItem == 19)
			{   
				BufWrite(&pBuf,&lUpdateBuf,Pcode,2);	
				pGRTextHeader = (LPGRTEXTHEADER)GlobalLock (hPickedTextHeader);	
		    	nchar = pGRTextHeader->lText;  
				BufWrite(&pBuf,&lUpdateBuf,(HPSTR)pGRTextHeader,(sizeof(GRTEXTHEADER) / 2+nchar/2)*2);
				GlobalUnlock (hPickedTextHeader);	
            }
            else
				BufWrite(&pBuf,&lUpdateBuf,Pcode,2+(sizeof(GRTEXTHEADER) / 2+nchar/2)*2);			
		}
		break;
		
		case 191: //text pointer  
			(*ipnt) += 38/2;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+38);			
		break;
		
		case 192: //text pointer (UltiMap Style)  
			(*ipnt) += 50/2;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+38);			
		break;
		
		case 120: // point symbol (hi precis) 
			if (UpdateItem == 20)
			{
	    		double PTRot,CurPointSize = *(LPDOUBLE)*ipnt;
        		(*ipnt) += 4;
        		PTRot = *(LPDOUBLE)*ipnt;
        		(*ipnt) += 4;
        		lpDCurPoints = (LPDPOINT)*ipnt; 
        		*lpDCurPoints = NewPointD;
        		(*ipnt) += 8;  
			}
			else
				(*ipnt) += 16;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+16*2);			
		break;
		
		case 20: /* point symbol with size and real rot*/
			if (UpdateItem == 20)
			{
	    		float PTRot,CurPointSize = *(LPFLOAT)*ipnt;
        		(*ipnt) += 2;
        		PTRot = *(LPFLOAT)*ipnt;
        		(*ipnt) += 2;
        		lpCurPoints = (LPPOINT)*ipnt; 
        		*lpCurPoints = BasePtToFilePt (NewPointD);
	        	(*ipnt) += 2;  
	        }
	        else	
				(*ipnt) += 6;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+6*2);			
		break;
		
		case 121:    
    	case 21: /* set pen color, width and style*/
    	{   
    		(*ipnt) += 4; 
    	}
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+4*2);			
    	break;
	        	
    	case 22: /* set brush pattern color and forecolor*/
    	{   
    		(*ipnt) += 5; 
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+5*2);			
    	}
    	break;
	    case 24: //dummy delete    	
    	case 23: /* clear temp pen and brush */
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2);			
    	break; 
		
		case 127: 
			PointSize = 16;
    	case 27: // Multipolygon indicator
    	{
    		nMultiPolygon = n = nPoly = *(*ipnt);
		    (*ipnt)++;
		    GSSiGlobFree (&hPolyPartLen);
			GSSiGlobFree (&hPolyBuffer); 
            hPolyPartLen = GSSiGlobAlloc (GMEM_MOVEABLE,nMultiPolygon*sizeof(WORD));
            pMultiPolygon = (LPWORD)GlobalLock (hPolyPartLen);  
            PolyBufferLen = 2 * (nPoly - 1);
    		while (n--) 
    		{   
    			PolyBufferLen += *(LPWORD)(*ipnt);
    			*pMultiPolygon = *(LPWORD)(*ipnt)++;
    		}
           	GlobalUnlock (hPolyPartLen);
       		hPolyBuffer = GSSiGlobAlloc (GMEM_MOVEABLE,(long)PolyBufferLen*PointSize);  
       		nPolyPoints = 0;
        }
        break;

    	case 28: // Curve Point ID's
    	{
    		short	n; 
    		LPSHORT	pCurvePoints;
	        		
			GSSiGlobFree (&hCurvePoints); 
    		nCurvePoints = n = *(*ipnt); 
		    (*ipnt)++;
    		hCurvePoints = GSSiGlobAlloc (GMEM_MOVEABLE,(nCurvePoints+1)*sizeof(short));
    		pCurvePoints = (LPSHORT)GlobalLock (hCurvePoints);
    		while (n--)
    			*pCurvePoints++ = *(*ipnt)++;  
    		*pCurvePoints = -1;
    		GlobalUnlock (hCurvePoints);
    	}
    	break;
        
        case 32: //extra Peoplenet data
		case 30: /* intersection data */ 
		{
			short	n;  
			n = **ipnt + 1;
			(*ipnt) += **ipnt+1;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+n*2);			
		}
		break;

		case 31: /* intersection data */
			(*ipnt) += 12;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+12*2);			
		break; 
		
		case 135:
    		PointSize = 16;
	    case 35: /* point array */
	
		{   nPnts = *(*ipnt);
		    (*ipnt)++;

		    if (hCoords) 
		    {
		    	nCoords += nPnts;
		    	hCoords = GlobalReAlloc (hCoords,(long)nCoords*PointSize,GMEM_MOVEABLE);
		    }
		    else 
		    {
		    	hCoords = GSSiGlobAlloc (GMEM_MOVEABLE,(long)nPnts*PointSize);
		    	nCoords = nPnts;
		    	lCoords = 0;
		    }
		    pCoords = GlobalLock (hCoords);
		    pCoords += lCoords;
		    BufWrite (&pCoords,&lCoords,(HPSTR)(*ipnt),nPnts*PointSize); 
		    GlobalUnlock (hCoords);
		    *ipnt = (*ipnt) + nPnts * PointSize/2;
		}
		break;   
		
		case 36: /* null code */
//			BufWrite(&pBuf,&lUpdateBuf,Pcode,2);			
		break;
	        	
		case 37: /* block minmax */
		{	
			(*ipnt) += 4;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+4*2);			
	    }
	    break;
	
	    case 38: /* elevation array */
	
		{  	PointSize = 4;
			nPnts = *(*ipnt);
		    (*ipnt)++;
		    *ipnt = (*ipnt) + nPnts * PointSize/2;
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+2+nPnts*PointSize);			
		}
		break;   
		
		case 40: /* command string */
		{                    
			lGCmdString = *(*ipnt);
		    (*ipnt)++;
			(*ipnt) += lGCmdString/2; 
			BufWrite(&pBuf,&lUpdateBuf,Pcode,2+2+lGCmdString);			
		}
		break;	
	        	
        case 101:	/*	used description offset	*/
        {   
        	(*ipnt) += 2;
        }
        break;

	    case 102: /* color palette offset */
        {   
        	(*ipnt) += 2;
        }
        break;

        case 103: /* transformation point offset */
        {   
        	(*ipnt) += 2;
        }
        break;
        
        case 201: /* desc block offset */
        case 200: /* quad tree offset */
        {   
        	(*ipnt) += 2;
        }
        break;

	    default:
            ProcessInvalidRecord ((short)*Pcode,*ipnt,4);
	    break;
	
	}  
	GlobalUnlock (hUpdateBuf);
	return rtn;
} 

void cwCenterBelowCursor(HWND hWnd, short top)
{
 POINT      pt, CursorPt;
 RECT       swp;
 RECT       rParent;
 int        iwidth;
 int        iheight;

 /* get the rectangles for the parent and the child                     */
 GetWindowRect(hWnd, &swp);
 GetClientRect(hWndMain, &rParent);
 GetCursorPos(&CursorPt);
 /* calculate the height and width for MoveWindow                       */
 iwidth = swp.right - swp.left;
 iheight = swp.bottom - swp.top;

 /* find the center point and convert to screen coordinates             */
// pt.x = (rParent.right - rParent.left) / 2;
// pt.y = (rParent.bottom - rParent.top) / 2;
// ClientToScreen(hWndMain, &pt);

 /* calculate the new x, y starting point                               */
// pt.x = pt.x - (iwidth / 2);
// pt.y = pt.y - (iheight / 2);
 pt.x = CursorPt.x - (iwidth / 2);
 
 if(pt.x < rParent.left) pt.x = rParent.left;
 if(pt.x + iwidth > rParent.right)
     pt.x = rParent.right - (iwidth);
 pt.y = CursorPt.y;
 /* top will adjust the window position, up or down                     */
 if(top)
   pt.y = pt.y + top;

 /* move the window                                                     */
 MoveWindow(hWnd, pt.x, pt.y, iwidth, iheight, FALSE);
}

BOOL DisplayPickedItems (HWND hWnd,int NumPicked,BOOL UseMenus, LPSTR Cmd,LPSTR File)
{	short	nRc, item;
    HFILE	Fid;  
    HANDLE	hStr;
    char	SymName[34],txt[64];
    BOOL	rtn=FALSE; 
    LPSTR	lpDesc, lpSymbol,lpAction;     
    HMENU	Menus[16], PickMenu;
    long	loc;
    BOOL	TopOnlyOpt, SingleOpt, DescTAGOpt;
    UINT	CmdID; 
    POINT	position; 
    int		irec, imenu=1,NumAction, TotAction,SingleItem,SingleRec;  
    LPVIEWPORT	lpV; 
    OFSTRUCT	OFStruct; 
    HANDLE	hNames=0;
	short	nNames;
	LPSTR	pNames, str,text; 
	BOOL	WantThisItem;   
    
    if (!NumPicked)
    	return rtn;
    if (File)
		Fid = GSSiOpenFile (File,&OFStruct,OF_READ);  
    else
    { 
	    lpV=GetVP (PickList[NumPicked-1].ViewID);   
		Fid = GSSiOpenFile (lpV->PickMacroFile,&OFStruct,OF_READ);  
	}
    if (Fid == HFILE_ERROR)
    	return rtn;  
    hStr = GSSiGlobAlloc (GMEM_MOVEABLE,4096+1024);
    str=GlobalLock (hStr);
    text=str+1024;  
    if (File)  
    	_fstrcpy (LastPMFile,File);
    else
    	_fstrcpy (LastPMFile,lpV->PickMacroFile);
    fgetstring (str,1020,Fid); while (str[0]<'A') {fgetstring (str,1020,Fid);}
	TopOnlyOpt = (str[0]=='Y');
	DescTAGOpt = (str[1]=='Y');
	SingleOpt = (str[2]=='Y');    
	loc = _llseek (Fid,0,1);
    fgetstring (str,1020,Fid); while (str[0]<'!') {loc = _llseek(Fid,0,1);fgetstring (str,1020,Fid);}
	item=NumPicked;
	TotAction = 0; 
	if (UseMenus)
		PickMenu = CreatePopupMenu(); 
	Menus[0]=PickMenu;
	while (item--)	
	{   
		SetPickGlobals (item);
		if (PickList[item].Desc < 0) 
		{
			nNames = 1;
			pNames = SymName; 
			hNames = 0;
			_fstrcpy (SymName,PickList[item].Prefix);
		}
		else 
		{
    		SetViewport (PickList[item].ViewID);
			nNames = GetSymbolNames (PickList[item].Desc,&hNames,-(PickList[item].FileNum+1));  
			pNames = GlobalLock (hNames);
		}
	    _llseek (Fid,loc,0); 
	    NumAction=0;
	    if (DescTAGOpt)                                          
	    {   
	    	sprintf (txt,"%s (%s:%s)",
	    				 pNames,PickList[item].Prefix,PickList[item].UDI); 
	    	if (UseMenus)
				Menus[imenu++] = CreatePopupMenu();
	    }          
	    irec = -1;
	    while (fgetstring (str,1020,Fid))
	    {   
	    	if (str[0]<'!') goto GetNextLine;
	    	irec++;
			if ((lpDesc = MatchLev(str,',')))
			{
				*lpDesc++ = 0;
				_fstrcpy (text,str);
				ExpandText (text);
				if (*text == '-')
				{
					if (_fstricmp (&text[1],PickList[item].Prefix))
						WantThisItem = FALSE;
					else
						WantThisItem = TRUE;
				}
				else
					WantThisItem =  NameInSymList (text,nNames,pNames) ||!_fstricmp(text,"ALL");
				if (WantThisItem)
				{           
					if ((lpAction=MatchLev(lpDesc,',')))
					{   
						SingleItem = item;
						SingleRec = irec;
						*lpAction++ = 0;  
						if (!_fstricmp(lpAction,"DOCUMENTS"))
						{
							DisplayDocumentList (hWnd,
												 PickList[NumPicked-1].Prefix,
												 PickList[NumPicked-1].UDI,item,Menus[imenu-1]);
							NumAction++; 
							TotAction++;
						} 
						else if (_fstricmp(lpAction,"NULL"))
                        {   
                        	HANDLE	hTxt=GSSiGlobAlloc (GMEM_MOVEABLE,2048);
                        	LPSTR	pTxt=GlobalLock (hTxt);
                        	
                        	rtn = TRUE;
							CmdID = item * 256 + irec + 64000; 
							_fstrcpy (pTxt,lpDesc);
							ExpandText (pTxt);
							if (UseMenus)						
								AppendMenu (Menus[imenu-1],MF_ENABLED|MF_STRING,CmdID,pTxt); 
							else 
							{
								SetGlobalValue ("%ZOOMSELECTIONTEXT",pTxt);
								if (Cmd)
								{
									if (!_fstrnicmp (lpAction,"COMMAND,",8))
									{
										lpAction += 8;
										_fstrcpy (Cmd,lpAction);
									}
								}
							} 
							GSSiGlobUlFree (&hTxt);
							NumAction++; 
							TotAction++;
						}
					}
				}
			}
GetNextLine:;			 
		} 
	    if (DescTAGOpt && UseMenus)                                          
	    {   
			if (NumAction)
				AppendMenu (PickMenu,MF_POPUP,Menus[imenu-1],txt);
			else
				AppendMenu (PickMenu,MF_ENABLED|MF_STRING,0,txt);
		}	
		if (TopOnlyOpt)
			item=0;
		GSSiGlobUlFree (&hNames);
	} 
	GSSiClose (Fid);
	if (UseMenus && ((!SingleOpt && TotAction == 1) || (!hWnd && TotAction)))
		ProcessPickedItems (hWndMain,SingleItem,SingleRec);
	else if (hWnd && UseMenus)
	{
	   	GetCursorPos (&position);  
	   	if (GetMenuItemCount(PickMenu))
	   	{
	   		DoPaint = FALSE;
	  		TrackPopupMenu (PickMenu,TPM_CENTERALIGN|TPM_LEFTBUTTON,position.x,position.y,NULL,hWnd,NULL);
	  	}
	}
	if (UseMenus)
  		while (imenu)
	  		DestroyMenu (Menus[(imenu--)-1]); 
	GSSiGlobUlFree (&hStr);
	GSSiGlobUlFree (&hNames); 
	return rtn; 
	                                     
}   

BOOL ItemInPickMacro (short Item)
{	 
    HFILE	Fid;  
    HANDLE	hStr;
    char	SymName[34],txt[64];
    BOOL	rtn=FALSE; 
    LPSTR	lpDesc, lpSymbol,lpAction;     
    LPVIEWPORT	lpV; 
    OFSTRUCT	OFStruct; 
    HANDLE	hNames=0;
	short	nNames;
	LPSTR	pNames, str,text; 
	BOOL	WantThisItem;   
	long	loc;
    
    lpV=GetVP (PickList[Item].ViewID);
	Fid = GSSiOpenFile (lpV->PickMacroFile,&OFStruct,OF_READ);
    if (Fid == HFILE_ERROR)
    	return rtn;
    hStr = GSSiGlobAlloc (GMEM_MOVEABLE,4096+1024);
    str=GlobalLock (hStr);
    text=str+1024;
    fgetstring (str,1020,Fid); while (str[0]<'A') {fgetstring (str,1020,Fid);}
	loc = _llseek (Fid,0,1);
    fgetstring (str,1020,Fid); while (str[0]<'!') {loc = _llseek(Fid,0,1);fgetstring (str,1020,Fid);}
	if (PickList[Item].Desc < 0) 
	{
		nNames = 1;
		pNames = SymName; 
		hNames = 0;
		_fstrcpy (SymName,PickList[Item].Prefix);
	}
	else 
	{
	    SetViewport (PickList[Item].ViewID);
		nNames = GetSymbolNames (PickList[Item].Desc,&hNames,-(PickList[Item].FileNum+1));  
		pNames = GlobalLock (hNames);
	}
    _llseek (Fid,loc,0); 
    while (fgetstring (str,1020,Fid))
    {   
    	if (str[0]<'!') goto GetNextLine;
		if ((lpDesc = MatchLev(str,',')))
		{
			*lpDesc++ = 0;
			_fstrcpy (text,str);
			ExpandText (text);
			if (*text == '-')
			{
				if (_fstricmp (&text[1],PickList[Item].Prefix))
					WantThisItem = FALSE;
				else
					WantThisItem = TRUE;
			}
			else
				WantThisItem =  NameInSymList (text,nNames,pNames) ||!_fstricmp(text,"ALL");
			if (WantThisItem)
			{ 
				rtn = TRUE;
				goto Exit;          
			}
		}
GetNextLine:;			 
	}  
Exit:
	GSSiClose (Fid);
	GSSiGlobUlFree (&hStr);
	GSSiGlobUlFree (&hNames);
	return rtn; 
	                                     
}   

BOOL ProcessPickedItems (HWND hWnd,int item, int irec)
{	int nRc,ii;
    HFILE	Fid; 
    HANDLE	hSTR=GSSiGlobAlloc (GMEM_MOVEABLE,4096+1024);
    LPSTR	str=GlobalLock(hSTR);
    LPSTR	txt=str+1024;
    LPSTR	NextLine=txt+512;
    BOOL	rtn=FALSE; 
    LPSTR	lpSymbol,lpAction, lpNext, lpHOUSE, lpSTREET, lpCITY, lpVIEWPORT, lpLAYER;     
    int		rec; 
    long	CurLoc;
    short	Layer;   
    OFSTRUCT	OFStruct;
    
	Fid = GSSiOpenFile (LastPMFile,&OFStruct,OF_READ);
    if (Fid == HFILE_ERROR)
    {
		GSSiGlobUlFree (&hSTR);  
    	return FALSE;
    }
    GSSiGlobFree (&hIntData); 
    GSSiGlobFree (&hPNAddData); 
    hIntData = GSSiGlobAlloc (GHND,1024); 
    hPNAddData = GSSiGlobAlloc (GHND,1024); 
    ProcessPickedItem (item,FALSE);
    fgetstring (str,1020,Fid); while (*str<'!') {fgetstring (str,1020,Fid);} 
    rec = -1;
    while (rec<irec)
    {
    	rec++;
    	fgetstring (str,1020,Fid);while (*str<'!') {fgetstring (str,1020,Fid);}
    } 
    
ProcessNextLine:
    CurLoc = _llseek (Fid,0,1);
	if (!fgetstring (NextLine,1020,Fid))
		NextLine[0]=0;
	GSSiClose (Fid);  
	
	if (*str=='+')
	{
		lpAction=str;
		while (*(++lpAction)<'!');
	}
	else
	{
		if ((lpDesc= MatchLev(str,',')))
		{
			*lpDesc++=0;
			lpAction = MatchLev (lpDesc,',');
			*lpAction++=0;
		}
		else
			goto RtnFalse;    
	}
	lpNext=_fstrchr(lpAction,','); 
	if (lpNext) *lpNext = 0;    
	
	SetPickGlobals (item);
    
	if (!_fstricmp (lpAction,"HIGHLIGHT")) 
	{    
		     AddToHighlightList (PickList[item].Refno,&PickList[item],TRUE);
			 ShowPickedItem (hWndMain, item);  
    }
    
	else if (!_fstricmp (lpAction,"BASIC")) 
	{    
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"Error in Database parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		if (!(lpSQL = _fstrchr(lpDB,',')))
		{
	   		 MessageBox( GetFocus(), str,"Error in SQL parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpSQL++=0;
	    {
	 	   FARPROC lpfnIDENTIFYMsgProc;
	         
	        BasicDisplayItem=item; 
		    lpfnIDENTIFYMsgProc = MakeProcInstance((FARPROC)IDENTIFYMsgProc, hInst);
		    nRc = DialogBox(hInst, (LPSTR)"IDENTIFY", hWndMain, lpfnIDENTIFYMsgProc);
		    FreeProcInstance(lpfnIDENTIFYMsgProc);
	
	    } 
    }
	else if (!_fstricmp (lpAction,"GETVALS")) 
	{   
		HANDLE hSQL=0;
		LPSTR	lpCMD;
		 
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"Error in Database parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		if (!(lpSQL = _fstrchr(lpDB,',')))
		{
	   		 MessageBox( GetFocus(), str,"Error in SQL parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpSQL++=0;
		if ((lpCMD = _fstrchr(lpSQL,',')))
		{
			*lpCMD++=0;
		    if (!OpenDataFile (lpDB,lpSQL,BT_READ,&hSQL))
				goto RtnFalse;
			ExpandText (lpCMD);  
		    CloseDataFile (TRUE, &hSQL);
		}
    }
	else if (!_fstricmp (lpAction,"REPORT")) 
	{    
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"Error in report name parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		if (!(lpSQL = _fstrchr(lpDB,',')))
		{
	   		 MessageBox( GetFocus(), str,"Error in viewport parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpSQL++=0; 
		Report (lpDB, lpSQL,PickList[item].Prefix,PickList[item].UDI,PickList[item].Refno);
	} 
	else if (!_fstricmp (lpAction,"INFOBOX")) 
	{    
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"Error in infobox pathname parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		if (!CreateTAGBoxFromFile (CurView->hDC,PickList[item].PickedPoint,lpDB,item))
			goto RtnFalse;
	} 
	else if (!_fstricmp (lpAction,"DIALOG")) 
	{    
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"Error in dialog name parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		if (!(lpSQL = _fstrchr(lpDB,',')))
		{
	   		 MessageBox( GetFocus(), str,"Error in SQL parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpSQL++=0; 
		if ((lpInsert = _fstrchr(lpSQL,',')))
		*lpInsert++=0; 
		EditDynamicDialog (CurView->hWnd,lpDB, lpSQL, lpInsert);
	} 
	else if (!_fstricmp (lpAction,"COMMAND")) 
	{    
		lpDB = lpNext;
		if (!lpDB)
		{
	   		 MessageBox( GetFocus(), str,"No command string", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpDB++=0;
		AddGraphicsCmd (CurView->hWnd,lpDB,FALSE,0); 		
//		ExpandText (lpDB);
	} 
	else if (!_fstricmp (lpAction,"CITYTOUR")) 
	{    
		lpLAYER = lpNext; 
		if (!lpLAYER)
		{
	   		 MessageBox( GetFocus(), str,"Error in CITYTOUR data layer parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		} 
		lpLAYER++;
		if (!(lpVIEWPORT = _fstrchr(lpLAYER,',')))
		{
	   		 MessageBox( GetFocus(), str,"Error in Viewport parameter", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
		*lpVIEWPORT++=0;  
		for (Layer=0;Layer<CurView->NumFiles;Layer++)
		{
			if (!_fstricmp (lpLAYER,CurView->FileID[Layer]))
				break;
		}  
 		if (Layer >= CurView->NumFiles)
		{
	   		 MessageBox( GetFocus(), lpLAYER,"Invalid layer name", MB_OK|MB_ICONEXCLAMATION);
			 goto RtnFalse;
		}
 		StartGEOSPANvp = CurView->ID;
		GEOSPANAtPoint (PickList[item].PickedPoint,Layer,lpVIEWPORT);
    }
	else if (!_fstricmp (lpAction,"GEONET")) 
	{    
		GEOSPANAtNetwork (&CurPath,PickList[item].Refno,PickList[item].PCT,PickList[item].Length,PickList[item].OffDist,FALSE);
    }  
    
	else if (!_fstricmp (lpAction,"TIGER")) 
	{    
    	GetPickName (item);
		DisplayTIGERName (PickList[item].Refno);
    }  
	else if (!_fstricmp (lpAction,"PEOPLENET")) 
	{    
		DisplayPNData (PickList[item].Refno,hIntData,hPNAddData);
    }  
	else if (!_fstricmp (lpAction,"NULL")) 
		ii=1;
	
	if (NextLine[0]=='+')
	{
		Fid = GSSiOpenFile (CurView->PickMacroFile,&OFStruct,OF_READ);
		_llseek (Fid,CurLoc,0);
		fgetstring (str,1020,Fid);
		goto ProcessNextLine;
	} 
	GSSiGlobFree (&hIntData);
	GSSiGlobFree (&hPNAddData);
	GSSiGlobUlFree (&hSTR);  
	return TRUE; 

RtnFalse:
	GSSiGlobFree (&hIntData);  
	GSSiGlobFree (&hPNAddData);
	GSSiGlobUlFree (&hSTR);  
	return FALSE;
}


BOOL MoveSizeViewport (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 HDC	hDC;
 char key;
 POINT	MousePoint; 
 RECT	MoveRect;
 static	int	Mode=0; 
 static	POINT	LastPoint; 
 static LPVIEWPORT EditView=0;  
 static	RECT	LastRect, OrigRect; 
 static BOOL	HaveRect;
 HPEN	hWidePen; 
 int	OldMode;  

 switch (Message)
   {
   	case GF_INIT:
/*		GetCursorPos (&MousePoint);
		ScreenToClient (hWnd,&MousePoint); 
		SelectViewport (MousePoint,FALSE,FALSE);*/   
    	if (EditView && EditView != CurView)
    	{   
    		GMMessageBox (MSG_MOVESIZE1,MB_ICONEXCLAMATION,0);
			return FALSE; 
    	}
    	if (CurView->WidthType == 1)
    	{   
    		GMMessageBox (MSG_MOVESIZE2,MB_ICONEXCLAMATION,0);
			return FALSE; 
    	}
   		EditView = CurView; 
   		DisableMarginPan=TRUE; 
   		HaveRect = FALSE;
       	AddLBUTTON = TRUE; 
       	Mode = 0;
   		break;

    case WM_MOUSEMOVE: 
    	if (!EditView)
    		break;
		SetCurView ( EditView);
		MousePoint = MAKEPOINT(lParam);
    	if (wParam == (MK_LBUTTON))
    	{   
    		int	xdiff, ydiff;
    		
			hDC = GetDC (hWnd);  
		  	SetDisplayMode (hDC, GF_TEXTMODE);
		  	SelectClipRgn (CurView->hDC,NULL);
			hWidePen = CreatePen (PS_SOLID,3,RGB(0,0,0));
			OldMode = SetROP2(hDC,R2_NOT); 
			DrawRectPoly (hDC,&LastRect,hWidePen); 
			xdiff = MousePoint.x - LastPoint.x;
			ydiff = MousePoint.y - LastPoint.y;
			switch (Mode)
			{
				case 0:
				break;
				
				case 1:
					LastRect.left += xdiff;
					LastRect.right += xdiff;
					LastRect.top += ydiff;
					LastRect.bottom += ydiff;  
				break;
				
				case 2:
					LastRect.left += xdiff;
				break;
				
				case 3:
					LastRect.left += xdiff;
					LastRect.top += ydiff;
				break; 
				
				case 4:
					LastRect.top += ydiff;
				break;  
				
				case 5:
					LastRect.top += ydiff;
					LastRect.right += xdiff;
				break;

				case 6:
					LastRect.right += xdiff;
				break;

				case 7:
					LastRect.bottom += ydiff;
					LastRect.right += xdiff;
				break;

				case 8:
					LastRect.bottom += ydiff;
				break;
				
				case 9:
					LastRect.left += xdiff;
					LastRect.bottom += ydiff;
				break;
			}
			DrawRectPoly (hDC,&LastRect,hWidePen); 
			DeleteObject (hWidePen);
			SetROP2(hDC,OldMode); 
		    ReleaseDC (hWnd,hDC);
		    LastPoint = MousePoint; 
		    CurView->Rect = LastRect;
    	}
    	else
    	{   
    		Mode = 0;
    		if (!PtInRect (&CurView->Rect,MousePoint))
    		{
        		SetCurs (0,FALSE);
				DisableMarginPan=FALSE;
    			break; 
    		} 
    		MoveRect = CurView->Rect;
    		InflateRect (&MoveRect,-6,-6);
    		if (PtInRect (&MoveRect,MousePoint))
    		{
				Mode = 1;
    		}
    		else
    		{   double	NearDist, Dist;
    		    POINT	VPoint;
    			
    			VPoint.x = CurView->Rect.left;
    			VPoint.y = (CurView->Rect.top + CurView->Rect.bottom) / 2;
    			NearDist = idist (VPoint,MousePoint);
				Mode = 2; 
				
    			VPoint.x = CurView->Rect.left;
    			VPoint.y = CurView->Rect.top;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 3;
					NearDist = Dist;
				} 
				
    			VPoint.x = (CurView->Rect.left + CurView->Rect.right)/2;
    			VPoint.y = CurView->Rect.top;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 4;
					NearDist = Dist;
				} 
				
    			VPoint.x = CurView->Rect.right;
    			VPoint.y = CurView->Rect.top;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 5;
					NearDist = Dist;
				} 
				
    			VPoint.x = CurView->Rect.right;
    			VPoint.y = (CurView->Rect.top + CurView->Rect.bottom) / 2;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 6;
					NearDist = Dist;
				} 
				
    			VPoint.x = CurView->Rect.right;
    			VPoint.y = CurView->Rect.bottom;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 7;
					NearDist = Dist;
				} 
				
    			VPoint.x = (CurView->Rect.left + CurView->Rect.right)/2;
    			VPoint.y = CurView->Rect.bottom;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 8;
					NearDist = Dist;
				} 
				
    			VPoint.x = CurView->Rect.left;
    			VPoint.y = CurView->Rect.bottom;
    			Dist = idist (VPoint,MousePoint);
				if (Dist < NearDist)
				{
					Mode = 9;
					NearDist = Dist;
				} 
    		} 
			DisableMarginPan=TRUE;
			SetMoveCursor (Mode);
    	}
    	
       	break;

    case WM_LBUTTONDOWN: 
    	if (!EditView)
    		break;
		SetCurView ( EditView);
		LastRect = CurView->Rect;
    	LastPoint.x = LOWORD(lParam);
	    LastPoint.y = HIWORD(lParam);  
	    if (HaveRect) break;
	    HaveRect = TRUE;
		hDC = GetDC (hWnd);  
		OrigRect = CurView->Rect;
	  	SetDisplayMode (hDC, GF_TEXTMODE);
	  	SelectClipRgn (CurView->hDC,NULL);
		hWidePen = CreatePen (PS_SOLID,3,RGB(0,0,0));
		OldMode = SetROP2(hDC,R2_NOT); 
		DrawRectPoly (hDC,&LastRect,hWidePen);
		DeleteObject (hWidePen);  
		SetROP2(hDC,OldMode);
	    ReleaseDC (hWnd,hDC);
	    
		break;

    case WM_LBUTTONUP:
		break;

    case WM_RBUTTONUP: 
    	RecomputeViewport(OrigRect);
//        RemoveGraphicsFunction (hWnd);
		PostMessage(hWnd, GF_CLOSE,0, 0L); 
   		EditView = 0; 
   		HaveRect = FALSE;
		DoPaint = TRUE;      
		DisableMarginPan = FALSE;
       	SetCurs (0,FALSE);
		RedisplayWindow();   
		break;
    
    case GF_CLOSE: 
   		EditView = 0;  
   		Mode = 0;
   		HaveRect = FALSE;
		DisableMarginPan = FALSE;
       	SetCurs (0,FALSE);
    	return FALSE;
    	break;
    	
    default:
    	return (FALSE);
    }
    return (TRUE);
} 


BOOL EditViewport (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{ 

  FARPROC lpfnVPEDITMsgProc;
  int	nRc;

  switch (Message)
  {
	   	case GF_INIT:
	       	AddLBUTTON = FALSE;
	       	if (hWnd)
				PostMessage(hWnd, GF_EXECUTE,0, 0L); 
	   		break;
	    
	    case GF_EXECUTE:  
	    {   
	    	DisableMarginPan = TRUE;
			lpfnVPEDITMsgProc = MakeProcInstance((FARPROC)VPEDITMsgProc, hInst);
			nRc = DialogBox(hInst, (LPSTR)"VPEDIT", hWndMain,lpfnVPEDITMsgProc);
			FreeProcInstance(lpfnVPEDITMsgProc);
			if (nRc)
	 			DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);
			DoPaint = TRUE;      
			DisableMarginPan = FALSE;
			RedisplayWindow();   
			PostMessage(hWnd, GF_CLOSE,0, 0L); 
		}
	    default:
	    	return (FALSE);
    }
    return (TRUE);
}

BOOL MoveViewport (short NewVPID)
{
	UINT	iv;
	short	OldID, FirstRenumberedVP, LastRenumberedVP, VPIDChange;  
	short	NewID[MAX_VIEWPORTS];  
	LPVIEWPORT	SaveVP[MAX_VIEWPORTS];
	HANDLE		SavehVP[MAX_VIEWPORTS];
	
	OldID = CurView->ID;
	if (NewVPID == OldID)
		return FALSE;
	if (NewVPID < CurView->ID)
	{
		FirstRenumberedVP= NewVPID;
		LastRenumberedVP = CurView->ID-1;
		VPIDChange = 1;
	}
	else
	{
		FirstRenumberedVP= CurView->ID+1;
		LastRenumberedVP = NewVPID;
		VPIDChange = -1;
	}
    for (iv=0;iv<NumViewports;iv++)
    {
		if (pViewports[iv]->ID >= FirstRenumberedVP &&
			pViewports[iv]->ID <= LastRenumberedVP)
			NewID[iv] =  pViewports[iv]->ID + VPIDChange;
		else
			NewID[iv] =  pViewports[iv]->ID;   
	}
	NewID[CurView->ID-1] = NewVPID;
    for (iv=0;iv<NumViewports;iv++)
    {   
    	pViewports[iv]->ID = NewID[pViewports[iv]->ID-1];
		if (pViewports[iv]->ZoomTarget)
			pViewports[iv]->ZoomTarget = NewID[pViewports[iv]->ZoomTarget-1];  
		if (pViewports[iv]->Parent)
			pViewports[iv]->Parent = NewID[pViewports[iv]->Parent-1];  
		if (pViewports[iv]->BoundsDisplayID)
			pViewports[iv]->BoundsDisplayID = NewID[pViewports[iv]->BoundsDisplayID-1];    
		if (pViewports[iv]->BoundsDisplayVP)
			pViewports[iv]->BoundsDisplayVP = NewID[pViewports[iv]->BoundsDisplayVP-1]; 
		if (pViewports[iv]->LinkedTo)
			pViewports[iv]->LinkedTo = NewID[pViewports[iv]->LinkedTo-1]; 
		if (pViewports[iv]->OnPrintAddSpaceToVP)
			pViewports[iv]->OnPrintAddSpaceToVP = NewID[pViewports[iv]->OnPrintAddSpaceToVP-1];
		if (pViewports[iv]->pTheme)
		{ 
			if (pViewports[iv]->pTheme->TargetViewport) 
				pViewports[iv]->pTheme->TargetViewport = NewID[pViewports[iv]->pTheme->TargetViewport-1];
			if (pViewports[iv]->pTheme->DisplayViewport) 
				pViewports[iv]->pTheme->DisplayViewport = NewID[pViewports[iv]->pTheme->DisplayViewport-1];
		}
    } 
    _fmemmove (SaveVP,pViewports,sizeof(LPVIEWPORT)*MAX_VIEWPORTS);  
    _fmemmove (SavehVP,hViewports,sizeof(HANDLE)*MAX_VIEWPORTS);  
    for (iv=0;iv<NumViewports;iv++)
    {
        pViewports[NewID[iv]-1] = SaveVP[iv];
        hViewports[NewID[iv]-1] = SavehVP[iv];
    }  
    CommandViewport = NewID[CommandViewport-1];
	UpdateInfoBoxVPID (NewID);
	return TRUE;
}  

BOOL FAR PASCAL COORDLOCMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	int		st, choice, n;
	int		TabStops[2]={900,1000}; 
	char	str[256]; 
	LPSTR	lpTAB;

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
		 FillList (hWndDlg,IDC_COORD_LIST,lpCLFile,str);    
		 if (GetVal (lpCLGlob, str))
		 {
		 	n = atoi (str);
 		 	SendDlgItemMessage (hWndDlg,IDC_COORD_LIST,LB_SETCURSEL,(WPARAM)n,(LPARAM)NULL); 
		 }
		 break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDC_COORD_LIST: 
                 switch(HIWORD(lParam))
                 {    
                     case LBN_DBLCLK:
					 PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
					 break;
                 }
                 break;

		 	case IDOK:
		    	 choice=SendDlgItemMessage(hWndDlg,IDC_COORD_LIST,LB_GETCURSEL,NULL,NULL);
		         if (choice != LB_ERR)
		         {
			         SendDlgItemMessage(hWndDlg,IDC_COORD_LIST,LB_GETTEXT,choice,(DWORD)str);
			         lpTAB = _fstrrchr (str,'\t');
			         if (lpTAB)
			         {  
			         	lpTAB++;
			         	if (sscanf (lpTAB,"%Flf %Flf",&CLocPoint.x,&CLocPoint.y) == 2)
			         	{
			         		n = SendDlgItemMessage (hWndDlg,IDC_COORD_LIST,LB_GETCURSEL,(WPARAM)0,(LPARAM)NULL); 
			         		SetGlobalValueLong (lpCLGlob,n);
	                 		EndDialog(hWndDlg, TRUE);
	                 	} 
	                 }
	             }
		 	     break;   
		 	     
            case IDCANCEL:
                 EndDialog(hWndDlg, FALSE);
                 break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}  

