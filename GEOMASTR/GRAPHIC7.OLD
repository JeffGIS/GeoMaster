short OkToContinue2 (BOOL ForceCheck);
BOOL OkToContinue (BOOL ForceCheck)
{   
	short	rtn;
	
	if (GetGlobalBVal2 ("[%IGNORESYSMSG]",FALSE))
		return TRUE;
	while ((rtn = OkToContinue2 (ForceCheck)) == 2)
    {
      FARPROC lpfnWAITMESSAGEMsgProc;
      short	nRc;
	              
	  HaltMapDisplay(FALSE);
      lpfnWAITMESSAGEMsgProc = MakeProcInstance((FARPROC)WAITMESSAGEMsgProc, hInst);
      nRc = DialogBox(hInst, (LPSTR)"WAITMESSAGE", hWndMain, lpfnWAITMESSAGEMsgProc);
      FreeProcInstance(lpfnWAITMESSAGEMsgProc);
	  if (!nRc)
	  	return FALSE;
	  ForceCheck = TRUE;
	
    }
	return rtn;
}

short OkToContinue2 (BOOL ForceCheck)
{   
	DWORD	now, elapsed;
	static	DWORD	last_check=0;     
	time_t	last_msg_time;
	int	ii, l;    
	OFSTRUCT	OFStruct; 
	char	str[128];
	
	now = GetTickCount();
	elapsed = now - last_check;  
	if (!PeopleNet && (elapsed > max_check_time || ForceCheck))
	{
		char	MessageFile[128]="[%DATA_LOC]sysmsg.txt", type[36];   
		HFILE	Fid;
		struct _stat    statmsg; 
		
		ExpandText (MessageFile);
		Fid = OpenFile (MessageFile,&OFStruct,OF_READ); 
		if (Fid == HFILE_ERROR)
		{
			last_check = now;
			return 1;
		} 
		fgetstring (type,sizeof(type)-4,Fid);
		l=_lread (Fid,GMmess,sizeof(GMmess)-1); 
		GMmess[l]= 0;
		ii=_fstat (Fid,&statmsg);
		GSSiClose (Fid);
		switch (*type)
		{
			case 'A':
			case 'a':
 				DoPaint = FALSE;
				HaltMapDisplay(FALSE);
				MessageBox( GetFocus(),GMmess,"GeoMaster System Message", MB_OK|MB_ICONEXCLAMATION);
 				BlowOut(NULL,NULL);
 			case 'M':
 			case 'm':  
 			{
				last_check = now;
				GetPrivateProfileString("User", "LastMsg","0",str,sizeof(str),"geomastr.ini");
    			last_msg_time = atol(str);
    			if (last_msg_time == statmsg.st_mtime)
    				return 1;
    			ltoa ((long)statmsg.st_mtime,str,10);
    			WritePrivateProfileString("User", "LastMsg",str,"geomastr.ini");
 				DoPaint = FALSE;
				MessageBox( GetFocus(),GMmess,"GeoMaster System Message", MB_OK|MB_ICONEXCLAMATION);
				DoPaint = TRUE;
 				return 1;  
 			}
 			case 'S':
 			case 's': 
				HaltMapDisplay(FALSE);
				MessageBox( GetFocus(),GMmess,"GeoMaster System Message", MB_OK|MB_ICONEXCLAMATION);
 				return 0;
 			case 'W':
 			case 'w': 
 				return 2;
 		}

	}
	return TRUE;
	
}

BOOL FAR PASCAL WAITMESSAGEMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
         
         cwCenter(hWndDlg, 0);
		 SetDlgItemText(hWndDlg,IDC_WAITMESS,GMmess);
		 SetTimer(hWndDlg, 1, 10000, (FARPROC) NULL);
         break; /* End of WM_INITDIALOG                                 */
    
    case WM_TIMER:
    	 PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
    	 break;
    	 
    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
    	 PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
         {  
            case IDCANCEL: 
            	KillTimer (hWndDlg,1);
                EndDialog(hWndDlg, FALSE);
                break;
            case IDOK: 
            	KillTimer (hWndDlg,1);
                EndDialog(hWndDlg, TRUE);
            	break;
         }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}  

short GetCDDriveForVolWait (LPSTR VolLabel,LPSTR Drive)
{   
	FARPROC lpfnWAITMESSAGEMsgProc;
	short	nRc;
	BOOL	SaveDP = DoPaint, SaveDH = DisableHalt;
	
	if (GetCDDriveForVol (VolLabel,Drive))
		return 1; 
	if (StopCDPrompts)
		return -1;
	sprintf (GMmess,"Please load the CD named %s",VolLabel);
	_fstrcpy (WaitForVolLabel,VolLabel);
	HaltMapDisplay(FALSE);  
	DoPaint = FALSE; 
	DisableHalt = TRUE;
	lpfnWAITMESSAGEMsgProc = MakeProcInstance((FARPROC)WAITMESSAGECDMsgProc, hInst);
	nRc = DialogBox(hInst, (LPSTR)"WAITMESSAGECD", hWndMain, lpfnWAITMESSAGEMsgProc);
	FreeProcInstance(lpfnWAITMESSAGEMsgProc);
	DoPaint = SaveDP;
	DisableHalt = SaveDH; 
	_fstrcpy (Drive,WaitForDrive);
	return nRc; 
}
 
BOOL FAR PASCAL WAITMESSAGECDMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
         
         cwCenter(hWndDlg, 0);
		 SetDlgItemText(hWndDlg,IDC_WAITMESS,GMmess);
		 SetTimer(hWndDlg, 100, 2000, (FARPROC) NULL);
         break; /* End of WM_INITDIALOG                                 */
    
    case WM_TIMER: 
    	 if (wParam != 100)
    	 	return TRUE;
		 KillTimer (hWndDlg,100);
		 if (GetCDDriveForVol (WaitForVolLabel,WaitForDrive))
    	 	PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
    	 else
			SetTimer(hWndDlg, 100, 2000, (FARPROC) NULL);
    	 return FALSE;
    	 
    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
    	 PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
         {  
         	case IDC_STOPCD:
         		StopCDPrompts = TRUE;
            	KillTimer (hWndDlg,100);
                EndDialog(hWndDlg, -1);
                break;
            case IDCANCEL: 
            	KillTimer (hWndDlg,100);
                EndDialog(hWndDlg, FALSE);
                break;
            case IDOK: 
                EndDialog(hWndDlg, TRUE);
            	break;
         }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}

BOOL SelectDrive (int Type,LPSTR Drive)
{
	FARPROC	lpfnSELECTDRIVEMsgProc;
	short		nRc; 
    
    WantDriveType = Type;              
	lpfnSELECTDRIVEMsgProc = MakeProcInstance((FARPROC)SELECTDRIVEMsgProc, hInst);
	nRc = DialogBox(hInst, (LPSTR)"SELECTDRIVE", hWndMain, lpfnSELECTDRIVEMsgProc);
	FreeProcInstance(lpfnSELECTDRIVEMsgProc);  
    if (nRc)
    	_fstrcpy (Drive,WaitForDrive);
    return nRc;
}

BOOL FAR PASCAL SELECTDRIVEMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	int		st, choice, n;
	char	str[256], str2[128]; 
	int		TabStops[2]={36,110};
	LPSTR	lpTAB, pLoc, eLoc,pPar; 
	static	HANDLE	hSaveBM;
	char	Drive[32], VolLabel[32];
	short	i, DriveType; 
	UINT	PrevErrMode;

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
	
    case WM_INITDIALOG:  
       	SendDlgItemMessage (hWndDlg,IDC_LIST,LB_SETTABSTOPS,2,(LPARAM)&TabStops); 
    	hSaveBM = EnterBlockingWindow (hWndDlg);
		PrevErrMode = SetErrorMode(SEM_NOOPENFILEERRORBOX|SEM_FAILCRITICALERRORS);
			
		for (i=0;i<26;i++)
		{   
			DriveType = GetDriveType (i);
			if (DriveType && (!WantDriveType || DriveType == WantDriveType))
			{                 
				GetVolumeLabel(i,VolLabel);
				{   
					char	DriveID=(char)('A'+i);	
					double FreeSpace=GetDriveFreeSpace (DriveID), mb = FreeSpace/((double)1024*(double)1024);
	            	sprintf (str,"%c:\\\t%s\t%.1f",DriveID,VolLabel,mb); 
			        SendDlgItemMessage (hWndDlg,IDC_LIST,LB_ADDSTRING,0,(LPARAM)str);
		        } 
		    }
		} 
		SetErrorMode(PrevErrMode);
		 
		 break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDC_LIST: 
                 switch(HIWORD(lParam))
                 {    
                     case LBN_DBLCLK:
					 	PostMessage(hWndDlg, WM_COMMAND, IDC_INSTALL, 0L);
					 break;
                 }
                 break;

            case IDOK:
		    	 choice=SendDlgItemMessage(hWndDlg,IDC_LIST,LB_GETCURSEL,NULL,NULL);
		         SendDlgItemMessage(hWndDlg,IDC_LIST,LB_GETTEXT,choice,(DWORD)str);
		         lpTAB = _fstrchr (str,'\t');
		         *lpTAB = 0;
		         _fstrcpy (WaitForDrive,str); 
                 GSSiEndDialog(hWndDlg,TRUE,hSaveBM); 
                 break;
            case IDCANCEL:
                 GSSiEndDialog(hWndDlg,FALSE,hSaveBM); 
                 break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}  

BOOL AddEditTAG (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{ 
 static	char	NewTAGSave[80];
 
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE;  
       	GetGlobalCVal ("[%NEWTAG]",NewTAGSave,NULL);
       	return GF_READY_TO_PROCESS;
   		break;
    
    case GF_CLOSE:  
    	SetGlobalValue ("%NEWTAG",""); 
    	return FALSE;
    	break;
    	 
    case GF_EXECUTE:
    case WM_LBUTTONUP:
    {
		LPSTR	pColon; 
		short	Item; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, ls, TAGHead, ID2;  
    	HFILE	Fid; 
    	OFSTRUCT	OFStruct;
		FARPROC lpfnADDEDITTAGMsgProc;
		int	nRc; 
    	
        if (Message == GF_EXECUTE)
        	Item = 0;
        else
        {
	    	MousePoint = MAKEPOINT(lParam);
		    if (!CurView->hTranWinToBase) break;
		    BasePoint=WinPtToBasePt(MousePoint);
		    PickItems (hWnd,BasePoint);
		    if (!NumPicked)
		    	break;  
		    Item = NumPicked-1;
		}
		ProcessPickedItem (Item,FALSE);        		
		
		if (!*NewTAGSave)
		{				
			lpfnADDEDITTAGMsgProc = MakeProcInstance((FARPROC)ADDEDITTAGMsgProc, hInst);
			nRc = DialogBox(hInst, (LPSTR)"ADDEDITTAG", hWndMain, lpfnADDEDITTAGMsgProc);
			FreeProcInstance(lpfnADDEDITTAGMsgProc);
			if (!nRc)
			 	break;   
			sprintf (NewTAGSave,"%s:%s",NewPrefix,NewUDI); 
		} 
		else
		{
			if ((pColon = _fstrchr (NewTAGSave,':')))
			{
				*pColon = 0;
				_fstrcpy (NewPrefix,NewTAGSave);
				*pColon++ = ':';
				_fstrcpy (NewUDI,pColon);   
			}
		}
		ExpandText (NewPrefix);
		ExpandText (NewUDI);
		sprintf (NewTAG,"%s:%s",NewPrefix,NewUDI); 
		lNewTAG = _fstrlen (NewTAG);
       	{   
       		BOOL	SaveDisableHalt, SaveFTI=ForceTAGIndex, OpenedTAGList; 
       		short	ltag;
       		
        	SaveDisableHalt = DisableHalt;
    	    DisableHalt = TRUE;
       		_fstrcpy (PltName,PickName);
			OpenedTAGList = OpenTAGIndex (FALSE,StoreTAGBounds);
			DeleteFromTAGList (PickList[Item].Prefix,PickList[Item].UDI,PickList[Item].Refno);
			if (OpenedTAGList)
				CloseTAGIndex ();
			ForceTAGIndex = SaveFTI;		
			if (lNewTAG <= CurlTAG)
			{
				Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
				if (Fid != HFILE_ERROR)
				{
					_llseek (Fid,CurTAGLoc,0);
					_lread (Fid,&ID2,2); 
					ID = LOBYTE (ID2);
					ltag = HIBYTE (ID2);
					if (ID == 9)
					{
						_llseek (Fid,4,1);
						_lwrite (Fid,NewTAG,CurlTAG);
					}
					GSSiClose (Fid);
				}  
				SaveFTI = ForceTAGIndex;
				ForceTAGIndex = ForceRefIndex = TRUE;
				ProcessPickedItem (Item,TRUE);        		
				ForceTAGIndex = ForceRefIndex = SaveFTI;
			} 
			else
			{   
				UpdateItem=9;
				UpdateRecord (Item,PickList[Item].Desc,NewPrefix,NewUDI,NULL,NULL,0);
			}
        	DisableHalt = SaveDisableHalt;
       	}
    }
    	break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

BOOL EditText (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 short	rtn=1;     
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE;
       	return GF_READY_TO_PROCESS;
   		break;
    
    case GF_CLOSE:
    	rtn=0;
    	break;
    	
    case GF_EXECUTE:
    case WM_LBUTTONUP:
    {             
		LPSTR	pString; 
		short	Item, NewLen; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, ls;  
    	HFILE	Fid; 
    	OFSTRUCT	OFStruct; 
    	GRTEXTHEADER	GRTextHeader;
		LPGRTEXTHEADER	pPickedTextHeader;


        if (Message == GF_EXECUTE)
        	Item = 0;
        else
        {   
	    	MousePoint = MAKEPOINT(lParam);
		    if (!CurView->hTranWinToBase) break;
		    BasePoint=WinPtToBasePt(MousePoint);
		    PickItems (hWnd,BasePoint);
		    if (!NumPicked)
		    	break;  
		    Item = NumPicked-1;
		}
	    hPickedTextHeader = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(GRTEXTHEADER)+512); 
	    pPickedTextHeader = (LPGRTEXTHEADER)GlobalLock (hPickedTextHeader);
		ProcessPickedItem (Item,FALSE);        		
       	if (lTextString && hTextString)
       	{   
       		BOOL	SaveDisableHalt;
       		char	NewText[260]; 
       		LPSTR	pStr;
       		
       		pString = GlobalLock (hTextString);
       		_fstrcpy (NewText,pString);
			GSSiGlobUlFree (&hTextString);  
        	SaveDisableHalt = DisableHalt;
    	    DisableHalt = TRUE;
       		
			if (GetTextStringML (hWnd,NewText,256,"Edit Text",0))
			{   
				Truncate (NewText);
				NewLen = _fstrlen (NewText); 
				NewLen += NewLen % 2; 
				if (NewLen <= lTextString)
				{
					Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
					if (Fid != HFILE_ERROR)
					{
						_llseek (Fid,CurTextStringLoc,0);
						_lread (Fid,&ID,2);
						_lread (Fid,&GRTextHeader,sizeof(GRTEXTHEADER)); 
						if (ID == 19)
							_lwrite (Fid,NewText,lTextString);
						GSSiClose (Fid);
					}
					ProcessPickedItem (Item,TRUE);        		
				}
				else
				{   
					UpdateItem=19;
					pPickedTextHeader->lText = NewLen;
					pStr = (LPSTR)pPickedTextHeader;
					pStr += sizeof(GRTEXTHEADER);
					_fstrcpy (pStr,NewText);
					UpdateRecord (Item,PickList[Item].Desc,NULL,NULL,NULL,NULL,0);
				} 
				rtn = GF_INCREASE_SUCCESS_COUNT; 
			}
        	DisableHalt = SaveDisableHalt;
    	} 
       	GSSiGlobUlFree (&hPickedTextHeader);
    }
    	break;
    default:
    	return (FALSE);
    }
    return (rtn);
} 

BOOL FAR PASCAL ADDEDITTAGMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 
	char	str[128];
	static	BOOL	AutoInc=FALSE;	

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
		 SendDlgItemMessage (hWndDlg,IDC_AUTOINC,BM_SETCHECK,AutoInc,0L);
         LoadTAGDef ();   
         if (NumTAGDef)
         { 
            LPTAGDEF    lpTAGDef;
            short	i; 
            
            lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
            for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
            {
                SendDlgItemMessage (hWndDlg,IDC_PREFIX,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
            }
            GlobalUnlock (hTAGDef);
         }                                                           
       	 _fstrcpy (str,"[%PREFIX]:[%UDI]");
       	 ExpandText (str); 
       	 if (!_fstrcmp (str,"REFNO:"))
       	 {
       	 	_fstrcat (str,"[%INT_REFNO]");
       	 	ExpandText (str);
       	 }
       	 if (*str != ':')
       	 {
         	SetDlgItemText (hWndDlg,IDC_CURRENTTAG,str);  
       	 	EnableWindow (GetDlgItem(hWndDlg,IDC_CURTONEW),TRUE); 
       	 }
         SetDlgItemText (hWndDlg,IDC_PREFIX,NewPrefix);
         if (AutoInc) 
         {
       	 	sprintf (str,"$AUTOINC(%s,%s)",NewPrefix,NewUDI); 
       	 	ExpandText (str);
       	 	_fstrcpy (NewUDI,str);
       	 }
  
         SetDlgItemText (hWndDlg,IDC_UDI,NewUDI);  
			
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
    	 PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
         {  
            case IDCANCEL: 
                EndDialog(hWndDlg, FALSE);  
            break; 
            
            case IDC_CURTONEW:
       	 	_fstrcpy (str,"[%PREFIX]");
	       	ExpandText (str); 
         	SetDlgItemText (hWndDlg,IDC_PREFIX,str); 
         	if (!_fstrcmp (str,"REFNO")) 
       	 		_fstrcpy (str,"[%INT_REFNO]");
       	 	else
       	 		_fstrcpy (str,"[%UDI]");
	       	ExpandText (str); 
	        SetDlgItemText (hWndDlg,IDC_UDI,str);  
            break;
            
            case IDOK: 
            	AutoInc = SendDlgItemMessage (hWndDlg,IDC_AUTOINC,BM_GETCHECK,0,0L);
            	GetDlgItemText (hWndDlg,IDC_PREFIX,NewPrefix,sizeof(NewPrefix));
            	GetDlgItemText (hWndDlg,IDC_UDI,NewUDI,sizeof(NewUDI)); 
                EndDialog(hWndDlg, TRUE);
            break;
         }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
} 

BOOL EditTextMultiple (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 char key;     
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = FALSE;
		PostMessage(hWnd, GF_EXECUTE,0, 0L); 
   		break;
    
    case GF_EXECUTE:  
    {
		LPSTR	pString; 
		short	Item; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, ls;  
    	HFILE	Fid; 
    	OFSTRUCT	OFStruct; 
    	GRTEXTHEADER	GRTextHeader; 
    	short	pos = BT_FIRST;
    	HIGHLIGHTDATA	HighlightData; 
    	long	Refno; 
    	char	ChangeCommand[256];


		while (!BT_FIND (hHighlight,(LPSTR)&Refno,pos,BT_ANY,(LPSTR)&HighlightData)) 
		{   
			pos = BT_NEXT; 
			PickList[0] = HighlightData.PD;
			CurView->PassID = 2;
			ProcessPickedItem (0,FALSE);        		
	       	if (lTextString && hTextString)
	       	{   
	       		BOOL	SaveDisableHalt;
	       		
			    GetGlobalValRaw ("%TEXTCHANGECOMMAND",ChangeCommand);
	       		pString = GlobalLock (hTextString); 
	       		SetGlobalValue ("%CURRENTTEXT",pString);
	        	SaveDisableHalt = DisableHalt;
	    	    DisableHalt = TRUE;
	    	    if (*ChangeCommand)
	    	    {
		       		ExpandText (ChangeCommand); 
		       		if (_fstrlen (ChangeCommand) <= lTextString)
					{   
						Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
						if (Fid != HFILE_ERROR)
						{
							_llseek (Fid,CurTextStringLoc,0);
							_lread (Fid,&ID,2);
							_lread (Fid,&GRTextHeader,sizeof(GRTEXTHEADER)); 
							if (ID == 19)
								_lwrite (Fid,ChangeCommand,lTextString);
							GSSiClose (Fid);
						}
					}
				}
	        	DisableHalt = SaveDisableHalt;
				GSSiGlobFree (&hTextString);  
	       	} 
	    } 
   		PostMessage(hWnd, GF_CLOSE,0, 0L); 

    }
    	break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

void InitDlgPrompts (HWND hWnd)
{
	return;
}

void SetDlgPrompt (HWND hWnd,UINT Prompt, UINT More)
{   
	LPWORD	pPrompt;
	
	if (!hWnd)
		return;
	if (!hPromptList)
	{
		hPromptList = GSSiGlobAlloc (GMEM_MOVEABLE,256*3*sizeof(UINT));
		nPromptList = 0;  
	}
	pPrompt = (LPWORD)GlobalLock (hPromptList); 
	if (!pPrompt)
		return;
	pPrompt += (3 * nPromptList); 
	*pPrompt++ = hWnd;
	*pPrompt++ = Prompt;
	*pPrompt = More;
	nPromptList++;
	GlobalUnlock (hPromptList);
	return;
}

void ClearDlgPrompts (void)
{   
	GSSiGlobFree (&hPromptList);
	return;
}

DWORD GetDlgItemPrompt (HWND hWnd)
{   
	LPWORD	pPrompt; 
	UINT	Prompt, More; 
	short	n;
	
	if (!hPromptList)
		return 0;
	pPrompt = (LPWORD)GlobalLock (hPromptList);  
	n = nPromptList;
	while (n--)
	{ 
		if (*pPrompt++ == hWnd)
		{
			Prompt = *pPrompt++;
			More = *pPrompt;
			GlobalUnlock (hPromptList);
			return MAKELONG (Prompt,More);	
		}
		pPrompt+=2;
	}
	GlobalUnlock (hPromptList);
	return 0;
} 

void DisplayPromptText (HDC hDC,LPSTR txt)
{   
	HFONT hFont, OldFont;  
	RECT	Rect=PromptRect;
	short	FontSize;  
	BOOL	GotDC=FALSE;
	
	if (!hDC)
	{
		hDC=GetDC(hWndMain);   
		GotDC=TRUE;
	}
	FontSize=PromptRect.bottom - PromptRect.top - 2;
	SaveDC (hDC);
  	SetDisplayMode (hDC, GF_TEXTMODE);
  	SelectClipRgn (hDC,NULL);   
  	SetTextColor (hDC,0); 
  	if (!Printing)
		FillRect (hDC,&Rect,GetStockObject (LTGRAY_BRUSH)); 
	Rect.left+=2;
	hFont = CreateFont(FontSize, 0, 0, 0, FW_BOLD, 
    					0, 0, 0, 0, 0, 0, 0, 0,"Arial");   
    OldFont = SelectObject (hDC,hFont);
	DrawText (hDC,txt,_fstrlen(txt),&Rect,DT_LEFT); 
	SelectObject (hDC,OldFont);
	DeleteObject (hFont);
	RestoreDC (hDC,-1);	
	if (GotDC)
		ReleaseDC (hWndMain,hDC);   
	_fstrcpy (LastPromptText,txt);
	return;
}

void SetPromptDlg (UINT PromptID)
{
	SetPrompt2 (0,PromptID);
	return;
}   

BOOL SetErrorProcessing (LPSTR ErrString)
{   
	short	l;   
	LPCMDSTRING    pCmdStr;   
	LPSTR	pStr;
	
	if (CurView)
	{   
		if (CurView->FunStackHandle)
		{
			pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
			GSSiGlobFree (&pCmdStr->hError);
			l=_fstrlen (ErrString); 
			if (l)
			{
				pCmdStr->hError = GSSiGlobAlloc (GMEM_MOVEABLE,l);
				pStr = GlobalLock (pCmdStr->hError); 
				_fstrcpy (pStr,ErrString);
				GlobalUnlock (pCmdStr->hError); 
			}
			GlobalUnlock (CurView->FunStackHandle); 
			return TRUE;
	    }
	}
	return FALSE;
}     

BOOL ProcessErrorString (void)  
{
	if (CurView)
	{
		if (CurView->FunStackHandle)
		{
			LPCMDSTRING pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle); 
			HANDLE	hError = pCmdStr->hError;
			
			GlobalUnlock (CurView->FunStackHandle); 
		    if (hError)
		    {
		    	LPSTR pErrStr=GlobalLock (hError);
		    	
		    	ProcessText (pErrStr); 
		    	GlobalUnlock (hError);
		    }
		}
	}
	return TRUE;
}

void SetPrompt (UINT PromptID,BOOL SetVP)
{   
	LPCMDSTRING    pCmdStr;   
	
	if (CurView)
	{   
		if (CurView->FunStackHandle && SetVP)
		{
			pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
			if (pCmdStr->Prompt != PRMT_USERPROMPT)   
				pCmdStr->Prompt = PromptID;
			else
				PromptID = PRMT_USERPROMPT;
			GlobalUnlock (CurView->FunStackHandle);
	    }
		SetPrompt2 (CurView->CurrentFunction,PromptID);
	}
	else
		SetPrompt2 (0,PromptID);  
	return;
} 

void RedisplayLastPrompt (void)
{
	if (!hWndPrompt)
		return;
	DisplayPromptText (0,LastPromptText);
	return;
}

void SetPrompt2 (short Function,UINT PromptID)
{   
	static	UINT	DebugPrompt=5076;
	short	ii;     
	LPSTR	lphf;
	LPSTR	str, txt;
	HANDLE	hStr=0;
	static	char	funstr[40];
	static	short	LastFun=-1, LastPrompt=0;
    
    if (!hWndPrompt || GetFocus() != hWndMain)
    	return; 
    if (!PromptID)  
    {
		DisplayPromptText (0,"");
		LastPrompt = 0;    
    	return;  
    }
    hStr = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
    str = GlobalLock (hStr); 
    txt = str + 512;
       
    if (PromptID == DebugPrompt)
    	ii=1;
	if (!LoadString(hInst, PromptID, str, 256))
		*str=0; 
//	if (PromptID == PRMT_USERMESS)
	ExpandText (str);  
	if (*str == '#')
	{   
		_fstrcpy (FullBM,"[%INDIR]help\\legend1.bmp");
		ExpandText (FullBM);
		ShowFullBM(TRUE);  
		GSSiGlobUlFree (&hStr);
		return; 
	}
	if ((lphf = _fstrchr (str,'^')))
	{   
		
		*lphf++ = 0; 
		_fstrcpy (CurHelpTopic,lphf);
	}
	if ((PromptID == LastPrompt && PromptID != PRMT_USERPROMPT) && Function == LastFun) 
	{
		GSSiGlobUlFree (&hStr);
		return;		
	}
	if (Function && WantFunNames)
	{
		
		if (Function != LastFun)
			GetFunName (Function,funstr);  
		sprintf (txt,"%s: %s",funstr,str);
		DisplayPromptText (0,txt);
	}
	else
		DisplayPromptText (0,str);
	LastFun = Function; 
	LastPrompt = PromptID;
	GSSiGlobUlFree (&hStr);
	return;
} 

UINT GetMenuPrompt (UINT wParam)
{  
	UINT	rtn=0;
	
	if (wParam >= 64000) /* pickmacro*/
	{
		int	item, irec;
		         	
		item = (wParam - 64000) / 256;
		irec = (wParam - 64000) % 256; 
		//         	ProcessPickedItems (hWnd,item, irec);
	
	}
	else if (wParam > 60000) /* Viewports menu used for activate/deactivate */
	{
	
	} 
    else if (wParam >= 58000) /* User commands */
	{  
		int	CmdID;
		         	
		CmdID = wParam - 58000;  
		//ExecuteUserCmd (CmdID);
	}
	else switch (wParam)
	{
		case IDM_VIEW:
			 break;
        case IDM_NEWSYM:
        	 break;
        case IDM_ABOUT: 
        	 rtn = PRMT_ABOUT;
        	 break;
        case IDM_REORG_BTREE:
        	 break;
        case IDM_CITY_EXTRACT:
        	 break;  
        case IDM_SAVE_CONFIG:
        	 break;  
        case IDM_VAN_SMALL: 
             break;
        case IDM_VAN_MEDIUM: 
             break;
        case IDM_VAN_LARGE: 
             break; 
        case IDM_MISC: 
         	 break;
        case IDM_OPEN_DIGITIZER:
        	rtn = PRMT_OPEN_DIGITIZER;
        	break;
        case IDM_CLOSE_DIGITIZER:
        	rtn = PRMT_CLOSE_DIGITIZER;
        	break; 
    }
    return rtn;
}

BOOL FAR PASCAL NEWPOINTSETMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 
	char	SymName[34], str[256]; 
	float	SymSize, SymRot;
	static	long	color;
	short	MaxCMDLen; 
	BOOL	Err, WantText;
	
 short    BRtn; 
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);

 switch(Message)
   {
    case WM_INITDIALOG:
    {
		
         LoadTAGDef ();   
         if (NumTAGDef)
         { 
            LPTAGDEF    lpTAGDef;
            short	i; 
            
            lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
            for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
            {
                SendDlgItemMessage (hWndDlg,IDC_PREFIX,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
            }
            GlobalUnlock (hTAGDef);
         } 
		 ExpandGlobalRaw ("%NEW_POINT_SIZE",str,256);
		 if (!*str)
		 	_fstrcpy (str,"10P");
		 SetDlgItemText (hWndDlg,IDC_POINTSIZE,str);
		 ExpandGlobalRaw ("%NEW_POINT_ROT",str,256);
		 if (!*str)
		 	_fstrcpy (str,"0D");
		 SetDlgItemText (hWndDlg,IDC_POINTROT,str);
		 ExpandGlobalRaw ("%NEW_POINT_UDI",str,256);
		 SetDlgItemText (hWndDlg,IDC_UDI,str);
		 ExpandGlobalRaw ("%NEW_POINT_PREFIX",str,256);
		 SetDlgItemText (hWndDlg,IDC_PREFIX,str);   
		 ExpandGlobalRaw ("%NEW_POINT_GRCMD",str,256);
		 SetDlgItemText (hWndDlg,IDC_EMBEDCMD,str); 
		 ExpandGlobalRaw ("%NEW_POINT_MACRO",str,256);
		 SetDlgItemText (hWndDlg,IDC_NPMACRO,str); 
		 MaxCMDLen = GetGlobalLVal ("[%NEW_POINT_MAXCMD]"); 
		 SetDlgItemInt (hWndDlg,IDC_MAXCMD,MaxCMDLen,FALSE);
		 SetDlgItemTextGlobal (hWndDlg,IDC_AUTOINCVAL,"[%NEW_POINT_AUTOINC]","");
		 _fstrcpy (str,"[%NEW_POINT_COLOR]");		 
		 ExpandText (str);
		 color = atol (str);
		 if (color >= 0)
		 {
       	 	SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_SETCHECK,TRUE,0L);
       	 	EnableWindow (GetDlgItem(hWndDlg,IDC_SETCOLOR),TRUE);
		 }
         cwCenter(hWndDlg, 0);
         _fstrcpy (str,"[%NEW_POINT_SYM]");
         ExpandText (str);
		 SetDlgItemText (hWndDlg,IDC_POINT_SYM,str); 
		 WantText = GetGlobalBVal("[%NEW_POINT_WANTTEXT]"); 
		 SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_SETCHECK,WantText,0L);
    	 PostMessage(hWndDlg, WM_COMMAND, IDC_SHOWSYM, 0L);
    	 PostMessage(hWndDlg, WM_COMMAND, IDC_ATTACHTEXT, 0L);
    }
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
		 switch(LOWORD (wParam))
#else
         switch(wParam)
#endif
           {
            case IDCANCEL:
                 EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDC_OVERRIDE_SYMCOLOR:
       	 		 EnableWindow (GetDlgItem(hWndDlg,IDC_SETCOLOR),
       	 					   (BOOL)SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_GETCHECK,0,0));
                 break;
            
            case IDC_SETCOLOR:
            	 if (GetColor(hWndDlg,&color))
			    	 PostMessage(hWndDlg, WM_COMMAND, IDC_SHOWSYM, 0L);
            	 break;
            
            case IDC_ATTACHTEXT:
            	 WantText = SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_GETCHECK,0,0);
				 EnableWindow (GetDlgItem(hWndDlg,IDC_SETTEXT),WantText);
            	 SetGlobalValueBool ("%NEW_POINT_WANTTEXT",WantText);
				 if (WantText)
				 {
					 GSSiGlobFree (&hGRText); 
					 GSSiGlobFree (&hGRTextTPL); 
					 SetNewText (1,&hGRText,&hGRTextTPL); 
				 }
            	 break;
            	              
            case IDC_SETTEXT:
			    {
			 	   FARPROC lpfnGRTEXTMsgProc;   
			 	   short	nRc;
			         
				    lpfnGRTEXTMsgProc = MakeProcInstance((FARPROC)GRTEXTMsgProc, hInst);
				    nRc = DialogBox(hInst, (LPSTR)"GRTEXT", hWndDlg, lpfnGRTEXTMsgProc);
				    FreeProcInstance(lpfnGRTEXTMsgProc);
			
			    } 
            	 break;
            	 
            case IDC_SHOWSYM:
            {
            	short	symnum;
            	HANDLE	hSymbol;
            	BOOL	SaveHVFC = HaveVarFillColor; 
            	long	SaveGC = GlobalColors[0];
            	
				GetDlgItemText (hWndDlg,IDC_POINT_SYM,SymName,sizeof(SymName));
				symnum = GetDictSymbolNumber (SymName); 
				if (!symnum)
					break;  
				if (SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_GETCHECK,0,0L))
				{
					HaveVarFillColor = TRUE;
					GlobalColors[0] = color;
				}
				hSymbol = GetDictSymDesc (symnum);
				DisplaySymInWindow (GetDlgItem(hWndDlg,IDC_SYMBOX),0,hSymbol,0,0,hBackBrush1);
				DestroySymbol (hSymbol);   
				HaveVarFillColor = SaveHVFC;
				GlobalColors[0] = SaveGC;
			}
                break;
                 
			case IDC_SET_POINTSYM: 
			{
				 char	NewPointSize[64]="[%POINT_SIZE]", NewPointRot[64]="[%POINT_ROT]", NewPointColor[64]="[%POINT_COLOR]";
				 
				 GetDlgItemText (hWndDlg,IDC_POINT_SYM,SymName,sizeof(SymName));
				 GetDlgItemText (hWndDlg,IDC_POINTSIZE,NewPointSize,sizeof(NewPointSize));
				 GetDlgItemText (hWndDlg,IDC_POINTROT,NewPointRot,sizeof(NewPointRot));
				 ExpandText (NewPointSize);
				 ExpandText (NewPointRot);
				 ExpandText (NewPointColor);
				 _fstrcpy (SymName,"[%NEW_POINT_SYM]"); 
				 ExpandText (SymName);
			     if (SelectPointSymbol (hWndDlg,1,SymName,"All",NewPointSize,NewPointRot,NewPointColor,FALSE))
			     {
			     	SetDlgItemText (hWndDlg,IDC_POINT_SYM,SymName);
			     	SetDlgItemText (hWndDlg,IDC_POINTSIZE,NewPointSize);
			     	SetDlgItemText (hWndDlg,IDC_POINTROT,NewPointRot); 
			     	if (*NewPointColor)
			     	{   
			     		color = atol (NewPointColor);
			       	 	SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_SETCHECK,TRUE,0L);
			       	 	EnableWindow (GetDlgItem(hWndDlg,IDC_SETCOLOR),TRUE);
			       	}
			    	PostMessage(hWndDlg, WM_COMMAND, IDC_SHOWSYM, 0L);
			     }
			}
                 break;
                 
            case IDOK:
            	 GetDlgItemText (hWndDlg,IDC_POINT_SYM,SymName,32);
            	 SetGlobalValue ("%NEW_POINT_SYM",SymName); 
            	 GetDlgItemText (hWndDlg,IDC_POINTROT,str,256);
            	 SetGlobalValue ("%NEW_POINT_ROT",str); 
            	 GetDlgItemText (hWndDlg,IDC_POINTSIZE,str,256);
            	 SetGlobalValue ("%NEW_POINT_SIZE",str); 
            	 GetDlgItemText (hWndDlg,IDC_PREFIX,str,256);
            	 SetGlobalValue ("%NEW_POINT_PREFIX",str); 
            	 GetDlgItemText (hWndDlg,IDC_UDI,str,256);
            	 SetGlobalValue ("%NEW_POINT_UDI",str); 
            	 GetDlgItemText (hWndDlg,IDC_EMBEDCMD,str,256);
            	 SetGlobalValue ("%NEW_POINT_GRCMD",str); 
            	 GetDlgItemText (hWndDlg,IDC_NPMACRO,str,256);
            	 SetGlobalValue ("%NEW_POINT_MACRO",str); 
                 MaxCMDLen = GetDlgItemInt (hWndDlg,IDC_MAXCMD,&Err,FALSE);
            	 SetGlobalValueLong ("%NEW_POINT_MAXCMD",MaxCMDLen); 
            	 SetGlobalValueLong ("%NEW_POINT_COLOR",color); 
		 		 GetDlgItemTextGlobal (hWndDlg,IDC_AUTOINCVAL,"[%NEW_POINT_AUTOINC]");
            	 WantText = SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_GETCHECK,0,0); 
            	 SetGlobalValueBool ("%NEW_POINT_WANTTEXT",WantText);
            	 if (WantText && hGRText)
            	 	GetNewText (1,hGRText,hGRTextTPL);
                 EndDialog(hWndDlg, TRUE);
                 break;

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}
BOOL FAR PASCAL NEWLINESETMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 
	char	SymName[34], str[256]; 
	float	SymSize, SymRot;
	static	long	color;  
	short	MaxCMDLen;  
	BOOL	Err, WantText;
	
 short    BRtn; 
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);

 switch(Message)
   {
    case WM_INITDIALOG:
    {
		
         LoadTAGDef ();   
         if (NumTAGDef)
         { 
            LPTAGDEF    lpTAGDef;
            short	i; 
            
            lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
            for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
            {
                SendDlgItemMessage (hWndDlg,IDC_PREFIX,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
            }
            GlobalUnlock (hTAGDef);
         } 
		 ExpandGlobalRaw ("%NEW_LINE_UDI",str,256);
		 SetDlgItemText (hWndDlg,IDC_UDI,str);
		 ExpandGlobalRaw ("%NEW_LINE_PREFIX",str,256);
		 SetDlgItemText (hWndDlg,IDC_PREFIX,str);   
		 ExpandGlobalRaw ("%NEW_LINE_WIDTH",str,256);
		 SetDlgItemText (hWndDlg,IDC_LINEWIDTH,str);   
		 ExpandGlobalRaw ("%NEW_LINE_GRCMD",str,256);
		 SetDlgItemText (hWndDlg,IDC_EMBEDCMD,str);  
		 MaxCMDLen = GetGlobalLVal ("[%NEW_LINE_MAXCMD]"); 
		 SetDlgItemInt (hWndDlg,IDC_MAXCMD,MaxCMDLen,FALSE);
		 SetDlgItemTextGlobal (hWndDlg,IDC_AUTOINCVAL,"[%NEW_LINE_AUTOINC]","");
		 _fstrcpy (str,"[%NEW_LINE_COLOR]");		 
		 ExpandText (str);
		 color = atol (str);
		 if (color >= 0)
		 {
       	 	SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_SETCHECK,TRUE,0L);
       	 	EnableWindow (GetDlgItem(hWndDlg,IDC_SETCOLOR),TRUE);
		 }
         cwCenter(hWndDlg, 0);
         _fstrcpy (str,"[%NEW_LINE_SYM]");
         ExpandText (str);
		 WantText = GetGlobalBVal("[%NEW_LINE_WANTTEXT]"); 
		 SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_SETCHECK,WantText,0L);
//    	 PostMessage(hWndDlg, WM_COMMAND, IDC_SHOWSYM, 0L);
    	 PostMessage(hWndDlg, WM_COMMAND, IDC_ATTACHTEXT, 0L);
		 SetDlgItemText (hWndDlg,IDC_LINE_SYM,str);
    }
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
		 switch(LOWORD (wParam))
#else
         switch(wParam)
#endif
           {
            case IDCANCEL:
                 EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDC_ATTACHTEXT:
            	 WantText = SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_GETCHECK,0,0);
				 EnableWindow (GetDlgItem(hWndDlg,IDC_SETTEXT),WantText);
            	 SetGlobalValueBool ("%NEW_LINE_WANTTEXT",WantText);
				 if (WantText)
				 {
					 GSSiGlobFree (&hGRText); 
					 GSSiGlobFree (&hGRTextTPL); 
					 SetNewText (-2,&hGRText,&hGRTextTPL); 
				 }
            	 break;
            	              
            case IDC_SETTEXT:
			    {
			 	   FARPROC lpfnGRTEXTMsgProc;   
			 	   short	nRc;
			         
				    lpfnGRTEXTMsgProc = MakeProcInstance((FARPROC)GRTEXTMsgProc, hInst);
				    nRc = DialogBox(hInst, (LPSTR)"GRTEXT", hWndDlg, lpfnGRTEXTMsgProc);
				    FreeProcInstance(lpfnGRTEXTMsgProc);
			
			    } 
            	 break;
            	 
            case IDC_OVERRIDE_SYMCOLOR:
       	 		 EnableWindow (GetDlgItem(hWndDlg,IDC_SETCOLOR),
       	 					   (BOOL)SendDlgItemMessage (hWndDlg,IDC_OVERRIDE_SYMCOLOR,BM_GETCHECK,0,0L));
                 break;
            
            case IDC_SETCOLOR:
            	 if (GetColor(hWndDlg,&color)) 
            	 break;
                 
			case IDC_SET_LINESYM: 
			{   
				char	SymName[34]="[%NEW_LINE_SYM]", SymSize[64]="[%NEW_LINE_WIDTH]", SymColor[64]="[%NEW_LINE_COLOR]";   
				float	size,rot;
					
				ExpandText (SymName);
				ExpandText (SymSize);
				ExpandText (SymColor);
				if (SelectLineSymbol (CurView->hWnd,1,SymName,SymSize,SymColor,FALSE))
				{   
			     	SetDlgItemText (hWndDlg,IDC_LINE_SYM,SymName);
			     	SetDlgItemText (hWndDlg,IDC_LINEWIDTH,SymSize);
			     	color = atol (SymColor);
			    }
			}
                 break;
                 
            case IDOK:
            	 GetDlgItemText (hWndDlg,IDC_LINE_SYM,SymName,32);
            	 SetGlobalValue ("%NEW_LINE_SYM",SymName); 
            	 GetDlgItemText (hWndDlg,IDC_PREFIX,str,256);
            	 SetGlobalValue ("%NEW_LINE_PREFIX",str); 
            	 GetDlgItemText (hWndDlg,IDC_UDI,str,256);
            	 SetGlobalValue ("%NEW_LINE_UDI",str); 
            	 GetDlgItemText (hWndDlg,IDC_EMBEDCMD,str,256);
            	 SetGlobalValue ("%NEW_LINE_GRCMD",str); 
                 MaxCMDLen = GetDlgItemInt (hWndDlg,IDC_MAXCMD,&Err,FALSE);
            	 SetGlobalValueLong ("%NEW_LINE_MAXCMD",MaxCMDLen); 
            	 GetDlgItemText (hWndDlg,IDC_LINEWIDTH,str,256);
            	 SetGlobalValue ("%NEW_LINE_WIDTH",str); 
            	 SetGlobalValueLong ("%NEW_LINE_COLOR",color); 
            	 WantText = SendDlgItemMessage (hWndDlg,IDC_ATTACHTEXT,BM_GETCHECK,0,0); 
            	 SetGlobalValueBool ("%NEW_LINE_WANTTEXT",WantText);
		 		 GetDlgItemTextGlobal (hWndDlg,IDC_AUTOINCVAL,"[%NEW_LINE_AUTOINC]");
            	 if (WantText && hGRText)
            	 	GetNewText (2,hGRText,hGRTextTPL);
            	 
                 EndDialog(hWndDlg, TRUE);
                 break;

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}
