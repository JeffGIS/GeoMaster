BOOL GetThemeSymbolList (short Parent, HANDLE hDBList)
{                             
    LPSYMBOL    pSymbol;
    BOOL	IsPar; 
	char	Value[128], SymName[34];
	short	nItem, nPar=0;	
	HANDLE	hSymbol, hPar = GSSiGlobAlloc (GMEM_MOVEABLE,4096); 
	LPSHORT	pPar;
    short   i, ClassNo, ClassZero=0; 
    HANDLE      hBT;
    HCURSOR hcurSave;
	LPVISLIST	SaveVis=CurVis;  
	LPVIEWPORT	SaveView=CurView;
	
    hcurSave = GSSiSetCursor(LoadCursor(0, IDC_WAIT)); 
	SetCurView ( pViewports[CurTheme->TargetViewport-1]);
	GSSiGlobFree (&CurTheme->hVisList);
	CurTheme->hVisList = SetThemeVisList (Parent);
	GetDictSymbolNumber ("CIRCLE"); // opens %SYM_DICT 
	CurVis = (LPVISLIST)GlobalLock (CurTheme->hVisList);
	for (i=1;i<3201;i++)
	{ 
		if (GetVisibility (i))
		{
			GetSymbolName (i,SymName,NULL,0,&IsPar); 
			if (!IsPar)
			{
	            _fstrncpy (Value,SymName,(size_t)GetBTKeyLen(hDBList));
	            if (BT_FIND(hDBList,Value,BT_FIRST,BT_EQ,(LPSTR)&ClassNo))
	                BT_PUT (hDBList,Value,(LPSTR)&ClassZero);  
	        }
        } 
    } 
	CurVis = SaveVis;  
	SetCurView ( SaveView);
    GSSiGlobUlFree (&CurTheme->hVisList);
    GSSiSetCursor (hcurSave); 
    return TRUE;
} 
                                       
BOOL DisplayHLTData (LPLONG pStartRef)
{
    HIGHLIGHTDATA	HighlightData;
    short	st;
    LPVIEWPORT		SaveVP;  
    HANDLE			hSaveVP;  
    BOOL	AP;
    
	if (!hHighlight)
		return FALSE;
	if (!GetGlobalBVal2 ("[%SHOWSELECTED]",FALSE) && !DisplayOnlyHLT)
		return FALSE;
	SetGlobalValue ("%SHOWSELECTED","");
	hSaveVP = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(VIEWPORT));
	SaveVP = (LPVIEWPORT)GlobalLock (hSaveVP);
	*SaveVP = *CurView;	
	AP = SetAutoPan (FALSE);
	st = BT_FIND (hHighlight,(LPSTR)pStartRef,BT_FIRST,BT_GE,(LPSTR)&HighlightData);
	while (!st)
	{   
		if (CurView->ID == HighlightData.PD.ViewID &&
			((HighlightData.PD.Type == 3 && (CurView->PassID == 2 || !CurView->PassID) && CurVis->WantType[0]) ||
			 ((HighlightData.PD.Type == 1 || HighlightData.PD.Type == 2 || HighlightData.PD.Type == 4 || HighlightData.PD.Type == 5) && (CurView->PassID == 3 || !CurView->PassID) && (CurVis->WantType[1] || CurVis->WantType[2])) ))
//			 (HighlightData.PD.Type == 4 && (CurView->PassID == 3 || !CurView->PassID) && CurVis->WantType[2]) ))
		{   
			if (RectInWBounds (&HighlightData.PD.Rect))
			{
				PickList[0]=HighlightData.PD; 
				ShowPickedItem (CurView->hWnd,-1); 
			}
		} 
		st = BT_FIND (hHighlight,(LPSTR)pStartRef,BT_NEXT,BT_ANY,(LPSTR)&HighlightData);
	}
	*CurView = *SaveVP;
	SetAutoPan (AP);
	GSSiGlobUlFree (&hSaveVP);
	SetGlobalValue ("%SHOWSELECTED","Y");
	return FALSE;
}

BOOL CreateReorgBackupFile (LPSTR PltName)
{   
	char	File[206],dir[256],name[34],ext[8],drive[34],mess[256];
	LPSTR	pBUDir, pChr;
	
	if (!hReorgBUDir)
		return TRUE;
	_fstrcpy (File,PltName);
	ExpandText (File);   
	_splitpath (File,drive,dir,name,ext);
	pBUDir = GlobalLock (hReorgBUDir);
	pChr = LastChr (drive); 
	if (*pChr == '\\'|| *pChr == ':')
	{
		*pChr-- = 0; 
		if (*pChr == '\\' || *pChr == ':')
			*pChr = 0;  
	}
	sprintf (File,"%s\\%s%s%s%s",pBUDir,drive,dir,name,ext);
	GlobalUnlock (hReorgBUDir);
	if (ExistFile (File))
		return TRUE;
	if (makedirectories (File,FALSE)) 
	{
		if (copyfile (File,PltName,FALSE,0,0,0,0,0,0))
			return TRUE; 
	}
	sprintf (mess,"Unable to create backup file: %s",File);
	MessageBox (GetFocus(),mess,NULL,MB_ICONEXCLAMATION);
	return FALSE;
}

BOOL FAR PASCAL CREATEFILELISTMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{   
    char    str[256];
    BOOL    isDir;
    short     nchar, item;
    OFSTRUCT    OFStruct;
    
 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
		 SendDlgItemMessage (hWndDlg,IDC_NEWFILE,BM_SETCHECK,TRUE,0L);
		 SendDlgItemMessage (hWndDlg,IDC_ORTHOS,BM_SETCHECK,TRUE,0L);     
		 SetDlgItemText (hWndDlg,IDC_WILDCARD,"index1");
SetType:
		 *str = 0;
         DlgDirList (hWndDlg,str,IDC_SEARCHLIST,IDC_CURDIR,DDL_DIRECTORY|DDL_DRIVES|DDL_EXCLUSIVE);

         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
		 switch(LOWORD (wParam))
#else
         switch(wParam)
#endif
           {
            case IDC_SEARCHLIST: /* List Box                                 */
              {
#if WIN32
				switch(HIWORD(wParam))
#else
                switch(HIWORD(lParam))
#endif
                    {
                     case LBN_DBLCLK:
                          isDir = DlgDirSelect(hWndDlg,str,IDC_SEARCHLIST);
                          if (isDir)
                          {
					          EnableWindow (GetDlgItem(hWndDlg,IDC_UP),TRUE);  
                              DlgDirList (hWndDlg,str,
                                  IDC_SEARCHLIST,IDC_CURDIR,DDL_DIRECTORY|DDL_DRIVES|DDL_EXCLUSIVE);
                          }
                          break;  
                     case LBN_SELCHANGE:
	                 	EnableWindow (GetDlgItem (hWndDlg,IDC_ADD),(BOOL)SendDlgItemMessage(hWndDlg, IDC_SEARCHLIST, LB_GETSELCOUNT, 0, 0));
                     	break;
                     }

              }
              break;
            
            case IDC_ORTHOS:
				SetDlgItemText (hWndDlg,IDC_WILDCARD,"index1"); 
				break;
            
            case IDC_MAPS:
				SetDlgItemText (hWndDlg,IDC_WILDCARD,"index"); 
				break;
            
            case IDC_MACROINPUT:
				SetDlgItemText (hWndDlg,IDC_WILDCARD,"*.*"); 
				break;
            
            case IDC_ADDLIST: /* List Box                                 */
              {
#if WIN32
				switch(HIWORD(wParam))
#else
                switch(HIWORD(lParam))
#endif
                    {
                     case LBN_SELCHANGE:
	                 	EnableWindow (GetDlgItem (hWndDlg,IDC_REMOVE),(BOOL)SendDlgItemMessage(hWndDlg, IDC_ADDLIST, LB_GETSELCOUNT, 0, 0));
                     	break;
                     }

              }
              break;
            
            case IDC_ADD: 
            {
            	 short	Num;
            	 HANDLE	Handle;
            	 LPSHORT	lpItems; 
            	 char	str2[128];
            	 LPSTR	lpBrack;
            	 
				 Num = SendDlgItemMessage(hWndDlg, IDC_SEARCHLIST, LB_GETSELCOUNT, 0, 0); 
				 if (!Num) break;
                 Handle = GSSiGlobAlloc (GHND,Num*2);
                 lpItems =(LPINT) GlobalLock (Handle);
                 SendDlgItemMessage((HWND) hWndDlg, IDC_SEARCHLIST, LB_GETSELITEMS,(short) Num, (LPARAM) lpItems);
                 while (Num--)
                 {
	         		  SendDlgItemMessage(hWndDlg,IDC_SEARCHLIST,LB_GETTEXT,*(lpItems++),(DWORD)&str);
	         		  if (!_fstrnicmp (str,"[-",2))
	         		  { 
	         		  	sprintf (str2,"%c:",str[2]);
	         		  }
	         		  else
	         		  {
		         		  GetDlgItemText (hWndDlg,IDC_CURDIR,str2,sizeof(str2));
		         		  if (*LastChr (str2) != '\\')
		         		  	_fstrcat (str2,"\\");
		         		  _fstrcat (str2,&str[1]); 
		         		  if ((lpBrack = _fstrchr (str2,']')))
		         		  	*lpBrack = 0;
		         	  }
	         		  SendDlgItemMessage(hWndDlg,IDC_ADDLIST,LB_ADDSTRING,0,(DWORD)&str2);
                 } 
                 GSSiGlobUlFree (&Handle);
			}
            	 break;
            case IDC_REMOVE: 
            {
            	 short	Item;
            	 
                 Item = SendDlgItemMessage((HWND) hWndDlg, IDC_ADDLIST, LB_GETCURSEL,0,0);
                 if (Item != LB_ERR)
	         	 	SendDlgItemMessage(hWndDlg,IDC_ADDLIST,LB_DELETESTRING,Item,0);
			}
            	 break;
            case IDCANCEL:
			   	 _chdir (CurDir);
           	  	 _chdrive (SaveDrive);  
                 EndDialog(hWndDlg, FALSE); 
                 ContinueProcessing = TRUE;
                 break;
                 

            case IDC_LOCATE_DESTFILE: 
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWFILE,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName2 (hWndDlg,str,IDS_FILTERTEXT,".TXT",IDS_FILETXT)) break;   
                 }
                 else  
                 {
                    if (!GetFileName3 (hWndDlg,str,IDS_FILTERTEXT,IDS_FILETXT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTFILE,str);
                 break;
                 
            case IDC_UP: 
                {
                 char   Dir[128];
                 LPSTR  LastDir;
                 short    len;
                 
                 _getcwd (Dir,128); 
                 LastDir=_fstrrchr(Dir,'\\');
                 if (*(LastDir+1))
                 {
                 	*LastDir = 0; 
                 	*(LastDir+1) = 0;
                 	if (!_fstrchr (&Dir[2],'\\'))
                 		*LastDir = '\\';
                 	_chdir (Dir);
                	goto SetType;
                 }
				 *str = 0;
		         DlgDirList (hWndDlg,str,IDC_SEARCHLIST,IDC_CURDIR,DDL_DRIVES|DDL_EXCLUSIVE);  
		         EnableWindow (GetDlgItem(hWndDlg,IDC_UP),FALSE);  
		         SetDlgItemText (hWndDlg,IDC_CURDIR,0);
               } 
                 break;
                 
            case IDOK: 
            {
            	 short	Num,i;
            	 char	str2[132],Name[144], WildCard[16], drive[32], dir[128], extension[8];
            	 LPSTR	lpBrack; 
            	 HFILE	OutFileFID, Fid;  
            	 long	TotFiles=0;
            	 HCURSOR	hcurSave; 
            	 
			   	 _chdir (CurDir);
           	  	 _chdrive (SaveDrive);  
            	 GetDlgItemText (hWndDlg,IDC_WILDCARD,WildCard,sizeof(WildCard));
				 Num = SendDlgItemMessage(hWndDlg, IDC_ADDLIST, LB_GETCOUNT, 0, 0); 
				 if (!Num)
				 {
					MessageBox( hWndDlg,"No directories selected",NULL, MB_OK|MB_ICONEXCLAMATION);
					break;
				 }
				 if (!GetDlgItemText (hWndDlg,IDC_DESTFILE,Name,sizeof(Name)))
				 {
					MessageBox( hWndDlg,"No destination file",NULL, MB_OK|MB_ICONEXCLAMATION);
					break;
				 }
				 if (SendDlgItemMessage (hWndDlg,IDC_NEWFILE,BM_GETCHECK,0,0))
				 {
				 	OutFileFID = GSSiOpenFile (Name,&OFStruct,OF_CREATE);
					if (SendDlgItemMessage (hWndDlg,IDC_MACROINPUT,BM_GETCHECK,0,0))
						fputstring ("\"FILENAME\",\"FULLNAME\",\"DRIVE\",\"DIRECTORY\",\"DRIVEDIR\",\"EXTENSION\"",OutFileFID);
				 }	
				 else 
				 {
				 	OutFileFID = GSSiOpenFile (Name,&OFStruct,OF_READWRITE);
				 	_llseek (OutFileFID,0,2); 
				 }
				 hCursor =  LoadCursor(NULL, IDC_WAIT);
				 hcurSave = GSSiSetCursor(hCursor); 
				 GetTempFileName(0,"gm",0,Name);
                 for (i=0;i<Num;i++)
                 {
	         		  SendDlgItemMessage(hWndDlg,IDC_ADDLIST,LB_GETTEXT,i,(DWORD)&str);
            	 	  Fid =	GSSiOpenFile (Name,(LPOFSTRUCT)&OFStruct,OF_CREATE);
				 	  SearchFilesInDir (str, "", Fid,&TotFiles,WildCard,1); 
				 	  _llseek (Fid,0,0);
				 	  while (fgetstring (str2,128,Fid))
				 	  { 
				 	    if (SendDlgItemMessage (hWndDlg,IDC_ORTHOS,BM_GETCHECK,0,0))
				 	    {   
				 	    	if (!_fstrchr(str2,'.'))
				 	    	{
				 	  			_fstrcpy (LastChr(str2),"[%ORTHORES]");
				 	  			fputstring (str2,OutFileFID); 
				 	  		}
				 	  	}
				 	  	else if (SendDlgItemMessage (hWndDlg,IDC_MAPS,BM_GETCHECK,0,0))
				 	  		fputstring (str2,OutFileFID);
				 	  	else
				 	  	{
				 	  		_splitpath (str2,drive,dir,Name,extension);
				 	  		sprintf (str,"\"%s\",\"%s\",\"%s\",\"%s\",\"%s%s\",\"%s\"",Name,str2,drive,dir,drive,dir,extension);
				 	  		fputstring (str,OutFileFID);
				 	  	}
				 	  }  
                      GSSiClose (Fid);
	         	 }
	         	 GSSiClose (OutFileFID);
            	 Fid =	GSSiOpenFile (Name,(LPOFSTRUCT)&OFStruct,OF_DELETE);
				 hCursor = hcurSave;
				 GSSiSetCursor(hCursor);
                 EndDialog(hWndDlg, TRUE); 
                 
                 break;      
            }

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
} 

BOOL GetBinFileBounds (LPSTR InFile,LPMNMXCORD lpMinMax)
{
    short       NumFiles;
    LPSHORT     lpNumFiles;       
    LPFILELISTENTRY lpEntry; 
    MNMXCORD	FileBounds;  
    char        File[128], drive[8], dir[128];   
    HANDLE		hBinFileList;
            
    _fstrcpy (File,InFile);
    ExpandText (File);
    _splitpath (File,drive,dir,0,0);
    sprintf (File,"%s%sglobal.ini",drive,dir);
	LoadGlobalInit (File,FALSE);
	GetViewportScale (CurView->hDC); 
    sprintf (File,"%s%sfilelist.bin",drive,dir);
    if (!(hBinFileList = LoadBinaryFileList (InFile,File)))
    	return FALSE;
    lpNumFiles = (LPSHORT)GlobalLock (hBinFileList);
    NumFiles = *lpNumFiles;   
    lpNumFiles++;
    lpEntry = (LPFILELISTENTRY)lpNumFiles; 
    while (NumFiles--)
    {
	    FileBounds = lpEntry->MinMax;
	    if (AdjustFileBounds (CurView->ID,CurView->CurFile,&FileBounds,NULL))
	        AddMinMaxD (lpMinMax,&FileBounds); 
        lpEntry++;
    }
    GSSiGlobUlFree (&hBinFileList);
    return TRUE;
}

void SetCursorPosGM (short x,short y,BOOL DisplayLinkedOnly)
{   
	LPVIEWPORT	SaveVP = CurView; 
	DPOINT	BasePoint, WinBasePoint;
	POINT	WinPoint, CurPoint;
	RECT	Rect, NewRect;
	short	xat,yat; 
	static	short	lastx=SHRT_MAX, lasty=SHRT_MAX;
	short	LinkedCursorWidth=8;    
	HPEN	hPen,hOldPen, hPen2;
	
	IgnoreMouseMove=TRUE;
	if (!DisplayLinkedOnly)
		SetCursorPos (x,y);
	RemoveLinkedCursors ();
	if (!CurView || !DisplayLinkedCursors)
		return;                
	if (!CurView->LinkedTo)
		return; 
	WinPoint.x = x;
	WinPoint.y = y;  
	ScreenToClient (CurView->hWnd,&WinPoint);
	if (!PtInRect (&CurView->DrawRect,WinPoint))
		return;
	CurPoint = WinPoint;
	BasePoint = WinPtToBasePt (WinPoint);  
	if (TranFilePoint (1,&BasePoint) == 2)
		return; 
	
    InLinkedList(-1);
    InLinkedList(CurView->ID);
    
	SaveDC (CurView->hDC);
  	SetDisplayMode (CurView->hDC, GF_TEXTMODE);
  	SelectClipRgn (CurView->hDC,NULL);   
    while (CurView->LinkedTo && !InLinkedList(CurView->LinkedTo))
    {   
		SetViewport (CurView->LinkedTo); 
		if (!CurViewActive())
			goto NextVP;
		WinBasePoint = BasePoint; 
		if (SaveVP->hProfileRoute)
		{   
			HPDPOINT	pRoute=(HPDPOINT)GlobalLock (SaveVP->hProfileRoute);
			
			DisplayProfileLoc (&CurPoint,&BasePoint, SaveVP);
	   		WinBasePoint = PointAtDistOnPoly (pRoute,SaveVP->nProfileRoute,BasePoint.x); 
	   		GlobalUnlock (SaveVP->hProfileRoute);  
		}
		else
		{
			if (TranFilePoint (2,&WinBasePoint) == 2)
				goto NextVP;
		}
		WinPoint = BasePtToWinPt (&WinBasePoint); 
		Rect.left = max (0,WinPoint.x-LinkedCursorWidth-1);
		Rect.right = WinPoint.x+LinkedCursorWidth+1;
		Rect.top = max(0,WinPoint.y-LinkedCursorWidth-1);
		Rect.bottom = WinPoint.y+LinkedCursorWidth+1;
		if (IntersectRect (&NewRect,&Rect,&CurView->DrawRect))
		{
			CurView->LinkedCursorHandle = SaveScreen2 (CurView->hDC,Rect,CurView,NULL);
		    hPen = CreatePen(PS_SOLID,3,0);
		    hOldPen = SelectObject (CurView->hDC,hPen);
			MoveTo (CurView->hDC,WinPoint.x,WinPoint.y-LinkedCursorWidth);
			LineTo (CurView->hDC,WinPoint.x,WinPoint.y+LinkedCursorWidth);
			MoveTo (CurView->hDC,WinPoint.x-LinkedCursorWidth,WinPoint.y);
			LineTo (CurView->hDC,WinPoint.x+LinkedCursorWidth,WinPoint.y);
		    hPen2 = CreatePen(PS_SOLID,1,RGB(255,255,255));
		    SelectObject (CurView->hDC,hPen2);
			DeleteObject (hPen);
			MoveTo (CurView->hDC,WinPoint.x,WinPoint.y-LinkedCursorWidth);
			LineTo (CurView->hDC,WinPoint.x,WinPoint.y+LinkedCursorWidth);
			MoveTo (CurView->hDC,WinPoint.x-LinkedCursorWidth,WinPoint.y);
			LineTo (CurView->hDC,WinPoint.x+LinkedCursorWidth,WinPoint.y);
			SelectObject (CurView->hDC,hOldPen);
			DeleteObject (hPen2);
		}
NextVP:;
	}
	RestoreDC (CurView->hDC,-1); 
Exit:
	SetCurView ( SaveVP);
	return;
}

void RemoveLinkedCursors (void)
{   
	LPVIEWPORT	SaveVP=CurView;
	short	iview;
	
    for (iview = 0;iview < NumViewports; iview++)
    {
		SetCurView ( pViewports[iview]); 
		RestoreScreen2 (CurView->hDC, CurView->LinkedCursorHandle,0);
	    DestroySavedScreen (&CurView->LinkedCursorHandle,0);
	}
    SetCurView ( SaveVP);
	return;
}



	