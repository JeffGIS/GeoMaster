BOOL ProcessGraphicsFunction (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{   
	short	st,ii, CmdLim;
	LPCMDSTRING    pCmdStr;
   	HCURSOR	hcurSave; 
	POINT	CursorLoc; 
	long	TotLen;
	
/*	if (Message == WM_COMMAND) retrn (FALSE);*/
//	if (!HavePaint) retrn (FALSE);
	if (!NumViewports)
		return (FALSE);
	if (!CurView)
		return(FALSE); 
	if (Message == GF_CLEAR_FUN_STACK)
	{
		ResetFunStack (TRUE);
		return TRUE;
	}
	if (ProcessTurnArrows(hWnd,Message,wParam,lParam))
		return (TRUE);
	if (MarginPan(hWnd,Message,wParam,lParam))
		return (TRUE);
	st = ProcessGraphicsFunction2 (CurView->CurrentFunction,hWnd,Message, wParam,lParam); 
	if (CurView && CurView->FunStackHandle)
	{
	    pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);  
	    CmdLim = pCmdStr->CommandLimit;
	    GlobalUnlock (CurView->FunStackHandle);  
		if (hHighlight2)
			TotLen = BT_NUM_IN_INDEX (hHighlight2);
		else
			TotLen = 0;
	    if (st == GF_READY_TO_PROCESS && !TotLen)
	    	st = 1;
		if (st == GF_READY_TO_PROCESS && CmdLim == UINT_MAX)
		{   
			if (TotLen)
			{   
				short	pos=BT_FIRST; 
				long	Ref,Sequence, CurLoc=0; 
				HANDLE	hMem = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(HIGHLIGHTDATA)+sizeof(PICKDATA));
				LPHIGHLIGHTDATA	pHighlightData=(LPHIGHLIGHTDATA)GlobalLock (hMem);   
				LPPICKDATA	pSavePickList0=(LPPICKDATA)(pHighlightData+1);
				LPVIEWPORT	SaveVP=CurView; 
				
				if (TotLen > 1 && GetGlobalBVal2("[%SHOWSTATUS]",TRUE))
					CreateStatusWindow (CurView->hWnd,1,NULL);
                else 
                {
					hCursor =  LoadCursor(NULL, IDC_WAIT);
					hcurSave = GSSiSetCursor(hCursor); 
				}
				*pSavePickList0 = PickList[0];
			    while (!BT_FIND (hHighlight2,(LPSTR)&Sequence,pos,BT_ANY,(LPSTR)&Ref))
			    {   
			    	pos = BT_NEXT; 
				    if (!BT_FIND (hHighlight,(LPSTR)&Ref,BT_FIRST,BT_EQ,(LPSTR)pHighlightData))
				    { 
			    		PickList[0] = pHighlightData->PD;  
			    		SetCurView ( SaveVP);
						if (ProcessGraphicsFunction2 (CurView->CurrentFunction,hWnd,GF_EXECUTE, 1,lParam) == GF_EXECUTE_CANCELED)
							break;
					}
					if (TotLen > 1 && GetGlobalBVal2("[%SHOWSTATUS]",TRUE))
						StatusWindowUpdate ("","Command Execution from Highlight List", TotLen, CurLoc++);
				} 
				SetCurView ( SaveVP);
				ProcessGraphicsFunction2 (CurView->CurrentFunction,hWnd,GF_EXECUTE_FINISHED, wParam,lParam); 
				if (TotLen > 1 && GetGlobalBVal2("[%SHOWSTATUS]",TRUE))
					DestroyStatusWindow ();
				else
				{
					hCursor = hcurSave;
					GSSiSetCursor(hCursor);
				}
				PickList[0] = *pSavePickList0;   
				GSSiGlobUlFree (&hMem);
			} 
		    pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);  
			pCmdStr->CommandLimit = 0;
		    GlobalUnlock (CurView->FunStackHandle);  
			PostMessage(hWnd, GF_CLOSE,0, 0L);	
		}
		else if (st == GF_INCREASE_SUCCESS_COUNT)
		{
		    pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);  
			if (pCmdStr->CommandLimit)
			{   
				if (pCmdStr->CommandLimit == UINT_MAX-1) //use command coord one time
					pCmdStr->CommandLimit = 0;
				pCmdStr->CommandSuccessCount++; 
				if (pCmdStr->CommandSuccessCount >= pCmdStr->CommandLimit)
					PostMessage(hWnd, GF_CLOSE,0, 0L);	
			} 
		    GlobalUnlock (CurView->FunStackHandle);  
		}
		else if (st == GF_DECREASE_SUCCESS_COUNT)
		{
		    pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);  
			if (pCmdStr->CommandLimit)
				pCmdStr->CommandSuccessCount--; 
		    GlobalUnlock (CurView->FunStackHandle);  
		}  
		else if (st == -1 && pCmdStr->CommandLimit)
		{   
			PostMessage(hWnd, GF_CLOSE,0, 0L);	
		}
	}
	if (st)
		return TRUE;  
	if (Message == GF_CLOSE)
	{
		DisableMarginPan=FALSE;
		RemoveGraphicsFunction (hWnd);
	}  
	else if (Message == WM_RBUTTONUP && !(wParam & MK_LBUTTON)) 
	{
		if (*CurView->RButFunction)
			AddGraphicsCmd (CurView->hWnd,CurView->RButFunction,FALSE,0);
		return TRUE;
	}
	else if (Message == WM_CHAR)
    {
		switch (wParam)
		{   
			case 17: //CNTLQ
				PostMessage(hWnd, GF_CANCEL,0, 0L);
				PostMessage(hWnd, GF_CLOSE,0, 0L);
			break;
			
			case 27: //ESC  
//				PostMessage(hWnd, GF_CLOSE,0, 0L);
				ProcessErrorString ();	
				ResetFunStack(TRUE); 
				DoPaint = TRUE;
				DisableHalt = FALSE;    
				ContinueProcessing = TRUE; 
        		_chdir (OriginalDir);
            	_chdrive (OriginalDrive);
            	HaltMapDisplay (TRUE); 
				
            break;

            default:
				GetCursorPos (&CursorLoc);  
				ScreenToClient (hWnd,&CursorLoc);
				if (!SelectViewport (CursorLoc,FALSE,FALSE)) 
					return FALSE;
                if (IsGFunctionKey (wParam,FALSE))
                {
                	LPSTR	pCmd=GlobalLock (hAddGraphicsFun); 
                	
					CurrentLBUTDOWNLoc=CursorLoc; 
                	HaveCurrentLBUTTON=TRUE;
                	AddGraphicsCmd (hWndMain,pCmd,TRUE,0); 
                	GSSiGlobUlFree (&hAddGraphicsFun);
                	return TRUE;
                }
            	return FALSE;
            break;
		}  
		return TRUE;
	}
	return FALSE;
} 

void ResetFunStack (BOOL All)
{
    HANDLE	hLast, hSave;
	LPCMDSTRING    pCmdStr;
	HANDLE	handle; 
	BOOL	First=TRUE;
    
	CancelWindowZoom();
    DisableMarginPan=FALSE;	
    UnlockCursor ();
    SetGlobalValue("%P","");	 
	if (CurView->FunStackHandle)
	{
		InReset = TRUE;
	    handle = hSave = CurView->FunStackHandle;
		while (handle)
		{   
	    	pCmdStr = (LPCMDSTRING)GlobalLock (handle); 
	    	if (!pCmdStr)
	    	{   
	    		if (handle == CurView->FunStackHandle)
	    			CurView->FunStackHandle = 0;
	    		break;
	    	}
	    	hLast = pCmdStr->PrevHandle;
	    	if (!First || All)
	    	{ 
				if (pCmdStr->CurFun) 
				{
				    ProcessGraphicsFunction2 (pCmdStr->CurFun,0, GF_CANCEL, 0, 0); 
				    ProcessGraphicsFunction2 (pCmdStr->CurFun,0, GF_CLOSE, 0, 0); 
				}
				GSSiGlobFree (&pCmdStr->hError);
				GSSiGlobFree (&pCmdStr->hWhile);
				GSSiGlobUlFree (&handle);
			} 
			else
			{
				pCmdStr->PrevHandle = 0;
				GlobalUnlock (handle);
			}
			First = FALSE; 
			handle = hLast; 
			CurView->FunStackHandle = handle;
		}
		if (All)
		{   
			CurView->FunStackHandle = 0;
			CurView->CurrentFunction = 0; 
		}
		else
			CurView->FunStackHandle = hSave;
	}
    DisplayFunctionStack(); 
	SetCurs (0,FALSE);
    InReset = FALSE; 
   	GSSiGlobFree(&hCurPolyPoints);
   	nCurPolyPoints=0;  
    return;
}

BOOL ProcessGraphicsFunction2 (short Function,
							   HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
	LPVIEWPORT	SaveVP=CurView;  
	BOOL		st;
    
    st = ProcessGraphicsFunction3 (Function,hWnd,Message,wParam,lParam);
	if (ConfigLoaded && !IgnoreSelectVP)
		SetCurView ( SaveVP);   
    return st;
}


BOOL RunGFCommandFromFileAtLoc (LPSTR File,long CurLoc,BOOL SendCmd)
{   
	LPSTR	lpStr, pGCmd, lpBar;  
	OFSTRUCT	OFStruct;  
	HANDLE	hStr; 
	char	str[128];
	HFILE	Fid; 
	BOOL	rtn = FALSE, First=TRUE;
    
   	GetGFFile (str,CurView->FunctionFile);
   	Fid  = GSSiOpenFile (str,&OFStruct,OF_READ); 
	if (Fid==HFILE_ERROR)
	{
		MessageBox( GetFocus(), str,"Unable to load function file", MB_OK);
		return FALSE;
	}
	_llseek (Fid,CurLoc,0);
   	GSSiGlobUlFree (&hAddGraphicsFun);
	hAddGraphicsFun = GSSiGlobAlloc (GHND,UINT_MAX);
	pGCmd = GlobalLock (hAddGraphicsFun);  
	                     	  
	hStr = GSSiGlobAlloc (GMEM_MOVEABLE,4096);
	lpStr = GlobalLock (hStr);  
	while (fgetstring (lpStr,4090,Fid))
	{
		if (First || *lpStr == '|')
		{   
			Truncate (lpStr);
		 	if ((lpBar = _fstrchr(lpStr,'|')))
		 	{
				lpBar++; 
				_fstrcat (pGCmd,lpBar);  
				rtn = TRUE;
			}
		} 
		else if (*lpStr == '#')
			continue;
		else
			break;
		First=FALSE;
	}
	GSSiClose (Fid);
	GSSiGlobUlFree (&hStr);
	GlobalUnlock (hAddGraphicsFun);  
	if (SendCmd)
    {
    	LPSTR	pCmd=GlobalLock (hAddGraphicsFun); 
	                	
    	HaveCurrentLBUTTON=FALSE; 
    	AddGraphicsCmd (hWndMain,pCmd,TRUE,0); 
    	GSSiGlobUlFree (&hAddGraphicsFun);
    } 
	return rtn;
} 

BOOL GetGFIndex (LPSTR IndexPath)
{   
	char	str[130];
	LPSTR	pBS;
	
	_fstrcpy (str,CurView->FunctionDir);
	ExpandText (str);
	if ((pBS = _fstrrchr (str,'\\')))
	{
		_fstrcpy (IndexPath,str);
		++pBS;
		if (*pBS)
			_fstrcat (IndexPath,"\\");
	}
	else
	{   
		sprintf (IndexPath,"fundir\\%s",str);
		if (!_fstrchr (str,'.'))
			_fstrcat (IndexPath,".txt");
	}
	return TRUE;
} 

BOOL GetGFFile (LPSTR File,LPSTR from)
{
	char	str[130], gfdir[130];
	LPSTR	lpBS;
	
	_fstrcpy (str,from);
	ExpandText (str);
	if ((lpBS = _fstrrchr (str,'\\')))
		_fstrcpy (File,str);
	else
	{
		GetGFIndex (gfdir);
		_fullpath (File,gfdir,128); 
		if ((lpBS = _fstrrchr (File,'\\')))
		{
			lpBS++;
			*lpBS = 0;
		}
		else
			*File = 0;
		_fstrcat (File,str);
	}
	if (!_fstrchr (File,'.'))
		_fstrcat (File,".txt");
	return TRUE;
}  

