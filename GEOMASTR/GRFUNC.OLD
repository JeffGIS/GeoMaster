BOOL LoadFunctionLists (HWND hWndDlg,HMENU hMenu,short WantLine,short opt) 
{
	char	str[260],path[128],curpath[128], str2[128], delim='\t';
	HFILE	Fid;
	OFSTRUCT	OFStruct; 
	LPSTR	lpBar;
	short	i,LineNo=0;
	
	if (opt == 3)
		LastGFTheme = CurTheme;
	if (opt > 1)
		delim = 0;
	GetGFIndex (str);
	Fid = GSSiOpenFile (str,&OFStruct,OF_READ);
	if (Fid == HFILE_ERROR)
	{  
		char	buffer[128];
				     	
		MessageBox( GetFocus(), _fullpath(buffer,str,sizeof(buffer)),"Unable to load function Index", MB_OK);
		return (FALSE);
	} 
			     
	GetGFFile (str2,CurView->FunctionFile); 
	_fullpath (curpath,str2,sizeof(curpath));
	while (fgetstring (str,128,Fid))
	{   
		LineNo++;
		lpBar = _fstrchr(str,'|');
		if (lpBar)
		{
			*lpBar++ = delim; 
			GetGFFile (str2,lpBar); 
			_fullpath (path,str2,sizeof(path));
		} 
		else
			*path = 0;
		Truncate (str);
		switch (opt)
		{
			case 1:
				i=SendDlgItemMessage (hWndDlg,FUNCTION_LIST_LB,LB_ADDSTRING,NULL,(LPARAM)str);  
				if (!_fstricmp (path,curpath))
					SendDlgItemMessage (hWndDlg,FUNCTION_LIST_LB,LB_SETCURSEL,i,NULL); 
				break;
			case 2:
				if (!_fstricmp (path,curpath))
					_fstrcpy (CurTheme->Title,str);
				break;
			case 3:
			{
				UINT	CmdID=63800+LineNo;  
				AppendMenu (hMenu,MF_ENABLED|MF_STRING,CmdID,str); 
				break;
			} 
			case 4:
				if (LineNo == WantLine)
				{
					LPVIEWPORT	SaveVP=CurView; 
					_fstrcpy (CurTheme->Title,str);
				    SetViewport (CurTheme->TargetViewport); 
					_fstrcpy (CurView->FunctionFile,lpBar);
					SetCurView ( SaveVP);
					ThemeDisplayLegend2(3);
					goto Exit;
				}
				break;
		}
	}
Exit:
	GSSiClose (Fid); 
	return TRUE;
} 

BOOL LoadGFFunctionList (short WantLine)
{                          
	LPTHEME	SaveTheme = CurTheme;
	
	CurTheme = LastGFTheme;
	LoadFunctionLists (0,0,WantLine,4);
	CurTheme = SaveTheme;
	return TRUE;
} 

BOOL LoadGFFile (HWND hWndDlg,short opt)
{   
	LPSTR	lpBar, lpCarrot;
	HANDLE	hStr = GSSiGlobAlloc (GMEM_MOVEABLE,4096);
	LPSTR	lpStr = GlobalLock (hStr);
	HFILE	Fid;
	OFSTRUCT	OFStruct; 
	char	Title[128];
	long	CurLoc;
	
	GetGFFile (lpStr,CurView->FunctionFile); 
	Fid = GSSiOpenFile (lpStr,&OFStruct,OF_READ);
	if (Fid==HFILE_ERROR)
	{
		MessageBox( GetFocus(), lpStr,"Unable to load function file", MB_OK);
		GSSiGlobUlFree (&hStr);
		return (FALSE);
	}
	CurLoc = _llseek (Fid,0,1);
	while (fgetstring (lpStr,4090,Fid))
	{   
		if (*lpStr == '#')
			continue;
		lpBar = _fstrchr(lpStr,'|');
		if (!lpBar)
		{
			ExpandText (lpStr);
			if (!ContinueProcessing)
			{
		     	PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L); 
		     	ContinueProcessing = TRUE;
				GSSiClose (Fid);
				GSSiGlobUlFree (&hStr);
				return TRUE;
		    }
		}
		if (*lpStr != '|')
		{   
			if (lpBar)
		 	{   
		 		char	key[8];
					 		
		 		*lpBar = 0; 
		 		_fstrcpy (Title,lpStr);
		 		if ((lpCarrot = _fstrchr (lpStr,'^'))) 
		 		{   
		 			*lpCarrot++ = '\t';
		 			_fstrcpy (key,lpCarrot);
		 			sprintf (lpCarrot,"(%s)\t%ld",key,CurLoc);
		 		}
		 		else
		 		{
					*lpBar++ = '\t'; 
					sprintf (lpBar,"\t%ld",CurLoc); 
				}
			}
			else
				_fstrcpy (lpStr,"\t\t-1"); 
			switch (opt)
			{
				case 1:
					SendDlgItemMessage (hWndDlg,ACTIVE_FUN_LB,LB_ADDSTRING,NULL,(LPARAM)lpStr);
					break;
				case 2:
					if (!lpBar)
						break; 
					CurTheme->ClassCount[CurTheme->NumClass] = CurLoc;
					_fstrcpy (CurTheme->ClassBM[CurTheme->NumClass++],Title);
					if (CurTheme->NumClass >= MAX_THEME_CLASSES)
						goto Exit;
					break;
			}
		}
		CurLoc = _llseek (Fid,0,1);
	}
Exit:
	GSSiClose (Fid);
	GSSiGlobUlFree (&hStr);
			 
	return TRUE;
}


