BOOL PointsFromOffset (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{  
 LPSTR	pFile;
 POINT	MousePoint;
 
 switch (Message)
   {
   	case GF_INIT: 
   		GSSiGlobFree (&hNewPolyPoints);
   		NumNewPolyPoints = 0;
	   	if (!hAreaOffFile)
	   		return FALSE;
		pFile = GlobalLock (hAreaOffFile); 
	    if (!ExistFile(pFile))  
	    {	
	    	GlobalUnlock (hAreaOffFile);
	    	return FALSE;               
	    }
    	GlobalUnlock (hAreaOffFile);
       	AddLBUTTON = FALSE;
		PostMessage(hWnd, GF_EXECUTE,0, 0L); 
   		break;
   	
   	case GF_EXECUTE:	
    {   
		DPOINT	BasePoint;
		int	np, i, nRc;
		HPDPOINT	lpDpoint;
		HPPOINT	lpPoint, lpPoly;
		HANDLE	hPoly; 
		MNMXCORD Rect; 
		OFSTRUCT OFStruct;
		short	 ID;
		HFILE	FidAO; 
    
		pFile = GlobalLock (hAreaOffFile); 
	    FidAO = GSSiOpenFile (pFile,&OFStruct,OF_READ);
    	_lread (FidAO,&np,2);
	    _lread (FidAO,&ID,2); 
	    _lread (FidAO,&Rect,sizeof(Rect)); 
	    hNewPolyPoints = GSSiGlobAlloc (GMEM_MOVEABLE,(long)np*sizeof(DPOINT)); 
	    lpDpoint = (HPDPOINT)GlobalLock (hNewPolyPoints);
	    NumNewPolyPoints = np;
	    for (i=0;i<np;i++,lpDpoint++)
	    {
			_lread(FidAO,lpDpoint,sizeof(DPOINT)); 
	    } 
	    GlobalUnlock (hNewPolyPoints);
		GSSiClose(FidAO);
	    PostMessage(hWnd, GF_CLOSE,0, 0L);
	} 
		break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

void ConvertMinMax (LPMINMAX pMinMax,HANDLE hTranFrom, HANDLE hTranTo)
{   
	DPOINT	FilePointD, WorldPoint, BoundsP[4];
	double	Minx=DBL_MAX,Miny=DBL_MAX,Maxx=-DBL_MAX,Maxy=-DBL_MAX; 
	short	i;
	
	BoundsP[0].x = pMinMax->xmn;
	BoundsP[0].y = pMinMax->ymn;
	BoundsP[1].x = pMinMax->xmn;
	BoundsP[1].y = pMinMax->ymx;
	BoundsP[2].x = pMinMax->xmx;
	BoundsP[2].y = pMinMax->ymx;
	BoundsP[3].x = pMinMax->xmx;
	BoundsP[3].y = pMinMax->ymn; 
	for (i=0;i<4;i++)
	{
	    TRANS2 (BoundsP[i].x,BoundsP[i].y,&WorldPoint.x,&WorldPoint.y,hTranFrom); 
		ConvertCoord(&WorldPoint,1,3); 
		Minx = min (Minx,WorldPoint.x);
		Miny = min (Miny,WorldPoint.y);
		Maxx = max (Maxx,WorldPoint.x);
		Maxy = max (Maxy,WorldPoint.y); 
	}
    TRANS2 (Minx,Miny,&FilePointD.x,&FilePointD.y,hTranTo); 
    pMinMax->xmn = max (SHRT_MIN,IDNINT(FilePointD.x));
    pMinMax->ymn = max (SHRT_MIN,IDNINT(FilePointD.y));
										
    TRANS2 (Maxx,Maxy,&FilePointD.x,&FilePointD.y,hTranTo);
    pMinMax->xmx = min (SHRT_MAX,IDNINT(FilePointD.x));
    pMinMax->ymx = min (SHRT_MAX,IDNINT(FilePointD.y));
    return;
}

void MinMaxToBase (LPMINMAX pMinMax,LPMNMXCORD pMinMaxOut)
{   
	DPOINT	FilePointD, WorldPoint, BoundsP[4];
	double	Minx=DBL_MAX,Miny=DBL_MAX,Maxx=-DBL_MAX,Maxy=-DBL_MAX; 
	short	i;
	
	DBoundsInit (pMinMaxOut);
	BoundsP[0].x = pMinMax->xmn;
	BoundsP[0].y = pMinMax->ymn;
	BoundsP[1].x = pMinMax->xmn;
	BoundsP[1].y = pMinMax->ymx;
	BoundsP[2].x = pMinMax->xmx;
	BoundsP[2].y = pMinMax->ymx;
	BoundsP[3].x = pMinMax->xmx;
	BoundsP[3].y = pMinMax->ymn; 
	for (i=0;i<4;i++)
	{
	    TRANS2 (BoundsP[i].x,BoundsP[i].y,&WorldPoint.x,&WorldPoint.y,hTranFileToBase); 
		AddDPointToMinMax (&WorldPoint,pMinMaxOut);
	}
    return;
}

BOOL ConvertRectCoord (LPMNMXCORD pMinMaxOut, LPMNMXCORD pMinMaxIn, short from, short to)
{
	DPOINT	DPoint;

	DBoundsInit (pMinMaxOut);

	DPoint.x = pMinMaxIn->xmn;     
	DPoint.y = pMinMaxIn->ymn;     
	ConvertCoord(&DPoint,from,to); 
	AddDPointToMinMax (&DPoint,pMinMaxOut);
	DPoint.x = pMinMaxIn->xmn;     
	DPoint.y = pMinMaxIn->ymx;     
	ConvertCoord(&DPoint,from,to); 
	AddDPointToMinMax (&DPoint,pMinMaxOut);
	DPoint.x = pMinMaxIn->xmx;     
	DPoint.y = pMinMaxIn->ymx;     
	ConvertCoord(&DPoint,from,to); 
	AddDPointToMinMax (&DPoint,pMinMaxOut);
	DPoint.x = pMinMaxIn->xmx;     
	DPoint.y = pMinMaxIn->ymn;     
	ConvertCoord(&DPoint,from,to); 
	AddDPointToMinMax (&DPoint,pMinMaxOut);
    return TRUE;
}
 
BOOL BoundsTotallyInBounds(mnmxCor MinMax,mnmxCor Bounds)
{
	if (MinMax.xmn>=Bounds.xmn &&
		MinMax.ymn>=Bounds.ymn &&
		MinMax.xmx<=Bounds.xmx &&
		MinMax.ymx<=Bounds.ymx)
		return(TRUE);
	else
		return(FALSE);

}

void RandomizePoint (LPDPOINT DPoint,UINT Seed,double MaxDist)
{   int ir;
	double pct;
	
	ir = rand();
	pct = (2*(double)ir/RAND_MAX)-1.0; 
	DPoint->x += pct * MaxDist;
	ir = rand();
	pct = (2*(double)ir/RAND_MAX)-1.0; 
	DPoint->y += pct * MaxDist;
/*	DPoint->x += (2*((double)rand()-RAND_MAX/2)/RAND_MAX) * MaxDist;
	DPoint->y += (2*((double)rand()-RAND_MAX/2)/RAND_MAX) * MaxDist;*/
	return; 
}      

double WinDistToWorldDist (double WinDist)
{ 
	return (WinDist * CurView->BaseUnitsPerPixel);
}

BOOL PointInEditBounds (LPDPOINT pPoint)
{    
	 BOOL rtn=TRUE;
	 
     if (pPoint->x > EditBounds.xmx ||
         pPoint->y > EditBounds.ymx ||
         pPoint->x < EditBounds.xmn ||
         pPoint->y < EditBounds.ymn) rtn = FALSE;
     return rtn;
}

BOOL DisplayEditLimits (void)
{
	int	i;
	int	Nump; 
	LPINT	lpNump;
	LPDPOINT	lpDpoint; 
	DPOINT	DPoint;
	LPPOINT	lpPoint;
	POINT	Points[5];
    
    if (ForceTAGIndex  || ForceRefIndex)
    	return FALSE;
    if (ComputePCTTheme)
    	return FALSE;
    if (CurView->ID == CommandViewport)
		GMEnableMenuItem(hWndMain, IDM_Z_EDITLIMITS, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
	if (!CurView->UpdateFile)
    	return FALSE;
    if (!CurVis)
    	return FALSE; 
    if (!CurVis->FileIsVisible[CurView->UpdateFile-1])
    	return FALSE; 
    if (!GetLayerBounds (&EditBounds,CurView->hDC, CurView->UpdateFile-1))
    	return FALSE; 
    if (CurView->ID == CommandViewport)
		GMEnableMenuItem(hWndMain, IDM_Z_EDITLIMITS, MF_BYCOMMAND | MF_ENABLED);
	if (!GetGlobalBVal2 ("[%SHOWEDITBOUNDS]",TRUE))
		return TRUE;
	if (!RectInWBounds (&EditBounds))  
		Nump=0; 
	else
	{   
		DPoint.x = max (EditBounds.xmn,CurView->WBounds.xmn);
		DPoint.y = max (EditBounds.ymn,CurView->WBounds.ymn);
		Points[0] = BasePtToWinPt(&DPoint);
		DPoint.y = min (EditBounds.ymx,CurView->WBounds.ymx);
		Points[1] = BasePtToWinPt(&DPoint);
		DPoint.x = min (EditBounds.xmx,CurView->WBounds.xmx);
		Points[2] = BasePtToWinPt(&DPoint);
		DPoint.y = max (EditBounds.ymn,CurView->WBounds.ymn);
		Points[3] = BasePtToWinPt(&DPoint); 
		Points[4] = Points[0]; 
		Nump=5;
    }
    lpPoint = &Points[4];
	SetDisplayMode (CurView->hDC, GF_TEXTMODE);
	if (!FileMode)
	{
	    CurView->hRgn = CreateVPRgn(FALSE);
	    SelectClipRgn (CurView->hDC,CurView->hRgn);
	    DeleteObject(CurView->hRgn);  
	}
    {   
    	HBRUSH	Brush, OldBrush;
    	HANDLE	hMaskPoly;
    	LPPOINT pMask;
	    HBITMAP		hBM;
	    short	OldMode, OldPen; 
		LOGBRUSH    NDB;

	    OldPen = SelectObject (CurView->hDC,GetStockObject(NULL_PEN)); 
        NDB.lbStyle = BS_HATCHED;
        NDB.lbColor = RGB(64,64,64);
        NDB.lbHatch = HS_DIAGCROSS;
        Brush =  CreateBrushIndirect(&NDB);
	    OldBrush = SelectObject (CurView->hDC,Brush);
	    
	    hMaskPoly = GlobalAlloc (GMEM_MOVEABLE,(Nump+5)*sizeof(POINT));
	    pMask = (LPPOINT)GlobalLock (hMaskPoly);
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.bottom+1; 
	    for (i=0;i<Nump;i++,lpPoint--,pMask++)
	    	*pMask = *lpPoint;
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.bottom+1; 
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.top-1;
	    pMask->x = CurView->DrawRect.right+1;
	    pMask++->y = CurView->DrawRect.top-1;
	    pMask->x = CurView->DrawRect.right+1;
	    pMask->y = CurView->DrawRect.bottom+1;
	    GlobalUnlock (hMaskPoly);
	    pMask = (LPPOINT)GlobalLock (hMaskPoly);  
	    OldMode = SetBkMode (CurView->hDC,TRANSPARENT);
	    i=Polygon (CurView->hDC,pMask,Nump+5);         
	    GlobalUnlock (hMaskPoly);
	    GlobalFree (hMaskPoly);
	    SetBkMode (CurView->hDC,OldMode);
	    SelectObject (CurView->hDC,OldBrush);
	    SelectObject (CurView->hDC,OldPen);
	    DeleteObject (Brush);
    }  
	return TRUE; 
}

BOOL WritePickedItem (int FidOut, int Item)
{	LPSHORT		ipnt, EndItem;
    HANDLE 		hpltBuf;
	LPSTR		LPpltBuf;
	LPITEM		ItemHeader;
	OFSTRUCT	OFStruct;
	UINT		Length, nRead;

	if (Item > NumPicked)
		return FALSE;
    GetPickName (Item);

	if (!PickName[0])
		return FALSE;
	_fstrcpy (PltName,PickName);

	CloseMap (TRUE);
	if (!OpenMap (CurView->hWnd,CurView->hDC))
		return FALSE;
    _llseek (Fid,PickList[Item].Segment,0);
    nRead = _lread (Fid,&nBytes,2);
    hpltBuf = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nBytes);
    LPpltBuf = GlobalLock (hpltBuf);
    nRead = _lread (Fid,LPpltBuf,nBytes);
    if (nRead != nBytes || PickList[Item].Offset > nRead) 
    {
    	InvalidItem (NULL,TRUE);
    	return FALSE;
    }
    ipnt = (LPSHORT)(LPpltBuf + PickList[Item].Offset);
    ItemHeader = (LPITEM)ipnt;
    if (InvalidItem (ItemHeader,TRUE))
    	return FALSE;
    EndItem = ipnt + abs(ItemHeader->Len);
    EndItem+=6;  
    Length = (LPSTR) EndItem - (LPSTR) ipnt;
    _lwrite (FidOut,&PickList[Item].Refno,4);
    _lwrite (FidOut,&Length,2);
    _lwrite (FidOut,ipnt,Length);  
    GSSiGlobUlFree (&hpltBuf);
    return TRUE;
}  

BOOL BigPolyline (HDC hDC, HPPOINT lpPoints, long npnts)
{   
	BOOL	rtn;    
	LPPOINT	pPoints;  
	HANDLE	hMem;   
	long	mxp=MaxDisplayPoints/2;
	unsigned short	np,ii;
	
	rtn = Polyline (hDC,lpPoints,(short)min (npnts,mxp));
	if (!rtn)
	{
		char	mess[128];
		OFSTRUCT	OFStruct;
		HFILE	Fid; 
		short	n=0;
		
/*		Fid = GSSiOpenFile ("temp.txt",&OFStruct,OF_CREATE);
		while (npnts--)
		{
			sprintf (mess,"%i %i %i",n++,lpPoints->x,lpPoints->y); 
			lpPoints++;
			fputstring (mess,Fid);
		}   
		GSSiClose (Fid);*/
		ii=1;     
		return FALSE;
	}
	npnts -= mxp;                 
	while (npnts > 0)
	{   
		lpPoints += mxp;
		hMem = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
		pPoints = (LPPOINT)GlobalLock (hMem);  
		np = min (npnts,mxp);
		_fmemmove (pPoints,lpPoints,np*sizeof(POINT));
		if (np > 1)
		{
			rtn = Polyline (hDC,pPoints,np);    
			if (!rtn)
				ii=1;
		}
		GSSiGlobUlFree (&hMem);
		npnts -= np; 
	}
	return rtn;
}    

BOOL BigFPolyline (HDC hDC, HPFPOINT lpPoints, long npnts)
{
	HANDLE handle = GSSiGlobAlloc (GMEM_MOVEABLE,npnts*sizeof(POINT));
	HPPOINT	pPoints = (HPPOINT)GlobalLock (handle);
	HPPOINT	pPointsBeg = pPoints;
	BOOL	rtn=1; 
	DWORD	np=npnts;
	
	while (np--)
	{
		pPoints->x = IDNINT(lpPoints->x);
		pPoints++->y = IDNINT(lpPoints++->y);
	}
	if (npnts > 1)	
		rtn = BigPolyline (hDC,pPointsBeg,npnts);
	
	GSSiGlobUlFree (&handle);
	return rtn;
}    

BOOL SlideScreen (HWND hWnd, WORD Message, WPARAM wParam, LPARAM lParam)
{
	static HANDLE	SavedScreen=0;  
	static POINT	LastPoint;
	static BOOL		HaveLastPoint;
	POINT  MousePoint;
	LPSAVESCREEN	pSavedScreen;
 
 switch (Message)
   {
    case GF_INIT:
		SavedScreen = SaveScreen2 (CurView->hDC,CurView->DrawRect,CurView,NULL);
		HaveLastPoint = FALSE;
        break;

    case WM_LBUTTONUP:
        MousePoint = MAKEPOINT(lParam);
        break;
    
    case WM_MOUSEMOVE: 
        MousePoint = MAKEPOINT(lParam);
    	
        if (ScreenIsRegistered(SavedScreen))
        {   
        	short	xinc=1, yinc=1, i; 
        	
        	if (HaveLastPoint)
        	{   
        		xinc = MousePoint.x - LastPoint.x;
        		yinc = MousePoint.y - LastPoint.y;
        		LastPoint = MousePoint;    
        		i=100;
        		while (i--)
        		{
		        	pSavedScreen = (LPSAVESCREEN)GlobalLock (SavedScreen);    
		        	pSavedScreen->Rect.left+=xinc;
		        	pSavedScreen->Rect.right+=xinc;
		        	pSavedScreen->Rect.top+=yinc;
		        	pSavedScreen->Rect.bottom+=xinc;
		        	GlobalUnlock (SavedScreen);
		            FillRectPoly (CurView->hDC,&CurView->DrawRect,CurView->BackGroundColor);
					RestoreScreen2 (CurView->hDC,SavedScreen,0); 
				}
			}
			else
			{
				LastPoint = MousePoint;
				HaveLastPoint = TRUE;
			}
        }
        break;
    
    case GF_REDRAW:
    	DestroySavedScreen (&SavedScreen,0);
		SavedScreen = SaveScreen2 (CurView->hDC,CurView->DrawRect,CurView,NULL);
    	break;
    case GF_CLOSE:
    case GF_CANCEL:
        RemoveGraphicsFunction (hWnd);
    	DestroySavedScreen (&SavedScreen,0);
        break;

    case WM_RBUTTONUP:
        break;
    default:
        return (FALSE);
    }
    return (TRUE);
} 

void ComputeIndexOrthoRes (LPFILEINDEX lpIndex)
{

    if (lpIndex->CurrentEntry->BMWidth > 1)
    	lpIndex->OrthoRes = (lpIndex->CurrentEntry->Bounds.xmx - lpIndex->CurrentEntry->Bounds.xmn) /
    						(lpIndex->CurrentEntry->BMWidth - 1);
    return;
}
	
BOOL GetOpenFileSymName (short desc,LPSTR Name)
{
	if (!hOpenFileSyms)
		return FALSE; 
	{
		LPSHORT	pSym=(LPSHORT)GlobalLock (hOpenFileSyms);
		short	nSyms=*pSym++;
		UINT	i=0; 
		BOOL	rtn=FALSE;  
		HPSTR	pName;
		
		while (nSyms--) 
		{
			if (*pSym++ == desc)
			{
				pName = GlobalLock (hOpenFileSymNames);
				pName += (32 * (long)i);
				_fstrncpy (Name,pName,32);
				*(Name+32)=0; 
				rtn = TRUE;
				goto Exit;
			}
			i++;
		}
	Exit:
		GlobalUnlock (hOpenFileSyms);
		GlobalUnlock (hOpenFileSymNames);
		return rtn;
	}
}

BOOL CreateOpenFileSymName (void)
{   
	LPSHORT	nSyms;
	DestroyOpenFileSymNames ();
//	_llseek(Fid,UsedDescOffset,0);
//	ProcessPrimarySeg (0,-Desc,NULL,FALSE);
	hOpenFileSyms = GSSiGlobAlloc (GMEM_MOVEABLE,UINT_MAX);
	hOpenFileSymNames = GSSiGlobAlloc (GMEM_MOVEABLE,((long)32 * (long)UINT_MAX)/2);
	nSyms = (LPSHORT)GlobalLock (hOpenFileSyms);
	*nSyms = 0;
	GlobalUnlock (hOpenFileSyms);
	return TRUE;
}     

BOOL OpenFileSymListAdd (short desc,LPSTR DescName)
{   
	HPSTR	pName;
	LPSHORT	pSym;
	short	nSyms;
	
	if (!hOpenFileSyms)
		return FALSE;
	pName = GlobalLock (hOpenFileSymNames);
	pSym = (LPSHORT)GlobalLock (hOpenFileSyms);
	(*pSym)++; 
	nSyms = *pSym;
	pSym += nSyms;
	*pSym = desc;
	pName += ((long)(nSyms-1) *32);
	_fstrncpy (pName,DescName,32);
	GlobalUnlock (hOpenFileSyms);
	GlobalUnlock (hOpenFileSymNames);
	return TRUE;
}  

void DestroyOpenFileSymNames (void)
{
	GSSiGlobFree (&hOpenFileSyms);
	GSSiGlobFree (&hOpenFileSymNames);
	return;
}

HBRUSH CreateGMBrush (COLORREF GMColor,HDC hDC)
{   
	BYTE		PatByt;  
	COLORREF	color;
	PATBYTE		PatByte;      
	HBRUSH		brush;
				
	PatByt = GetWValue (GMColor);
	_fmemmove (&PatByte,&PatByt,1); 
	color = ColorWOWidth (GMColor);  
	if (!PatByte.Pattern)
		return CreateSolidBrush(color);
    else
    {   
		HBITMAP hbmp = LoadBitmap(hInst,MAKEINTRESOURCE(PatBMP[PatByte.Pattern-1]));  
		brush = CreatePatternBrush(hbmp);
        DeleteObject (hbmp); 
    }
    if (hDC)
    {
	    SetTextColor (hDC,color);     
	    SetBkColor (hDC,RGB(255,255,255));
	    if (PatByte.Transparent)
			SetROP2(hDC,R2_MASKPEN);  
		else
			SetROP2(hDC,R2_COPYPEN);
    } 
    return brush;
} 

void DisplayShadow (HDC hDC,LPRECT pRect,short offset)
{   
	RECT	ShadowRect;
	COLORREF	Color;
	BYTE		PatByt;  
	COLORREF	color;
	PATBYTE		PatByte;      
	
	if (GetGlobalBVal ("[%SHADOWLEFT]"))
	{
		ShadowRect.left = pRect->left-offset;
		ShadowRect.right = pRect->right-offset;
		ShadowRect.top = pRect->top+offset;
		ShadowRect.bottom = pRect->bottom+offset;  
	}
	else
	{
		ShadowRect.left = pRect->left+offset;
		ShadowRect.right = pRect->right+offset;
		ShadowRect.top = pRect->top+offset;
		ShadowRect.bottom = pRect->bottom+offset;  
	}
	PatByte.Transparent = 1;  
	PatByte.BGOpt = 0;
	PatByte.Pattern = 2;
	_fmemmove (&PatByt,&PatByte,1);
	Color = RGBW (64,64,64,PatByt);
	if (GetROP2 (hDC) != R2_NOT)
		FillRectPoly (hDC,&ShadowRect,Color); 
	return;
}

BOOL DisplayMaskArea (void)
{
 LPDPOINT	lpBasePoint;
 int	i;
 int	Nump; 
 HPDPOINT	lpDpoint;
 HPPOINT	lpPoint, lpPoly;
 HPEN	hPen=0, OldPen=0;
 LPMNMXCORD	lpRect; 
 HANDLE	hPoly;    
 short	OffLineWidth;
 long	OffLineColor;
    
	if (!CurView->hMaskArea) 
    	return FALSE;
    SaveDC (CurView->hDC);
    Nump = CurView->NumMaskPoints;  
    lpRect = (LPMNMXCORD) GlobalLock (CurView->hMaskArea);
	lpRect++;
	lpBasePoint = (LPDPOINT) lpRect;
	lpRect--;
    hPoly = GSSiGlobAlloc(GHND,(Nump+1)*sizeof(POINT));
    lpPoint = (HPPOINT) GlobalLock (hPoly);
    lpPoly = lpPoint; 
	if (!RectInWBounds (lpRect))  
		Nump=0;  
	RectInit (&MaskRect);
    for (i=0;i<Nump;i++,lpPoint++,lpBasePoint++)
    {
		*lpPoint = BasePtToWinPt(lpBasePoint);
		AddPointToRect (*lpPoint,&MaskRect);
    }
    *lpPoint= *lpPoly;
    Nump++; 
	SetDisplayMode (CurView->hDC, GF_TEXTMODE);
	if (!FileMode)
	{
	    CurView->hRgn = CreateVPRgn(FALSE);
	    SelectClipRgn (CurView->hDC,CurView->hRgn);
	    DeleteObject(CurView->hRgn);  
	}
	OffLineWidth = GetGlobalLVal2 ("[%OFFSETLINEWIDTH]",4);
	OffLineColor = GetGlobalLVal2 ("[%OFFSETLINECOLOR]",RGB(255,0,0));
	if (OffLineColor >= 0)
	{
		hPen = CreatePen (PS_SOLID,(short)IDNINT(OffLineWidth*DeviceToScreenFactor),OffLineColor);
	    OldPen = SelectObject (CurView->hDC,hPen); 
	    if (OutlineZoomArea && !ComputePCTTheme)
		    i=Polyline (CurView->hDC,lpPoly,Nump); 
	}
    if (MaskOffsetLine)
    {   
    	HBRUSH	BkBrush, OldBrush;
    	HANDLE	hMaskPoly;
    	HPPOINT pMask;  
    	COLORREF	Color;
    	long	PenColor;
    	HPEN	OldPen,hPen=0;
    	
	    if (ComputePCTTheme)   
	    {
	    	Color = ComputePCTMaskColor;
	    	PenColor = Color;
	    }
	    else 
	    {
	    	Color = GetGlobalLVal2 ("[%MASKCOLOR]",CurView->BackGroundColor);
	    	PenColor = -1;
	    }
	     
    	if (PenColor >= 0) 
	    	hPen = CreatePen (PS_SOLID,0,Color); 
	    else
	    	hPen = GetStockObject (NULL_PEN);
	    OldPen = SelectObject (CurView->hDC,hPen);
	    
	    BkBrush = CreateGMBrush (Color,CurView->hDC);
	    OldBrush = SelectObject (CurView->hDC,BkBrush);
	    
	    hMaskPoly = GlobalAlloc (GMEM_MOVEABLE,(Nump+5)*sizeof(POINT));
	    pMask = (HPPOINT)GlobalLock (hMaskPoly);
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.bottom+1; 
	    for (i=0;i<Nump;i++,lpPoint--,pMask++)
	    	*pMask = *lpPoint;
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.bottom+1; 
	    pMask->x = CurView->DrawRect.left-1;
	    pMask++->y = CurView->DrawRect.top-1;
	    pMask->x = CurView->DrawRect.right+1;
	    pMask++->y = CurView->DrawRect.top-1;
	    pMask->x = CurView->DrawRect.right+1;
	    pMask->y = CurView->DrawRect.bottom+1;
	    GlobalUnlock (hMaskPoly);
	    pMask = (HPPOINT)GlobalLock (hMaskPoly);
	    i=Polygon (CurView->hDC,pMask,Nump+5);
	    GSSiGlobUlFree (&hMaskPoly);
	    SelectObject (CurView->hDC,OldBrush);
	    DeleteObject (BkBrush);
	    SelectObject (CurView->hDC,OldPen);
	    if (hPen)
	    	DeleteObject (hPen);
    }
    if (OldPen);
    {  
	    SelectObject (CurView->hDC,OldPen);
	    DeleteObject (hPen); 
	}
    GlobalUnlock (hPoly);
    GlobalFree (hPoly); 
Exit:
    GlobalUnlock (CurView->hMaskArea);
	RestoreDC (CurView->hDC,-1);
	return TRUE; 
} 

BOOL ProcessCmdString (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 char key;     
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE;
   		break;

    case WM_LBUTTONUP:
    {
		LPSTR	pString; 
		short	Item; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, ls;  
    	HFILE	Fid; 
    	OFSTRUCT	OFStruct;
    	short	SavePGC=ProcessGCmdStrings;

        GSSiGlobFree (&hGCmdString);
    	MousePoint.x = LOWORD(lParam);
	    MousePoint.y = HIWORD(lParam);
	    if (!CurView->hTranWinToBase) break;
	    BasePoint=WinPtToBasePt(MousePoint);  
	    ProcessGCmdStrings=0;
	    PickItems (hWnd,BasePoint); 
	    ProcessGCmdStrings = SavePGC;
	    if (!NumPicked)
	    	break;  
	    Item = NumPicked-1;
	    ProcessGCmdStrings=0;
		ProcessPickedItem (Item,FALSE);  
		ProcessGCmdStrings=SavePGC;      		
       	if (hGCmdString)
       	{   
       		BOOL	SaveDisableHalt;  
       		HANDLE	handle=GSSiGlobAlloc (GMEM_MOVEABLE,1024);
       		LPSTR	pStr=GlobalLock (handle);
       		
       		pString = GlobalLock (hGCmdString);   
       		_fstrcpy (pStr,pString);
			GlobalUnlock (hGCmdString);   
			ExpandText (pStr);
			GSSiGlobUlFree (&handle);
       	}
    }
    	break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

BOOL EditCmdString (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 char key;
 short	rtn=1;     
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE;  
       	return GF_READY_TO_PROCESS;
   		break;

    case GF_EXECUTE:
    case WM_LBUTTONUP:
    {
		LPSTR	pString; 
		short	Item; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, ls;  
    	HFILE	Fid; 
    	OFSTRUCT	OFStruct;

        if (Message == GF_EXECUTE)
        	Item = 0;
        else
        {
	    	MousePoint = MAKEPOINT(lParam);
		    if (!CurView->hTranWinToBase) break;
		    BasePoint=WinPtToBasePt(MousePoint);
		    PickItems (hWnd,BasePoint);
		    if (!NumPicked)
		    	break;  
		    Item = NumPicked-1;
		}
		ProcessPickedItem (Item,FALSE);        		
       	if (lGCmdString && hGCmdString)
       	{   
       		BOOL	SaveDisableHalt;
       		
       		pString = GlobalLock (hGCmdString);
        	SaveDisableHalt = DisableHalt;
    	    DisableHalt = TRUE;
       		
			if (GetTextString (hWnd,pString,lGCmdString-1,"Edit Graphics Command String",NULL,NULL,0))
			{
				Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
				if (Fid != HFILE_ERROR)
				{
					_llseek (Fid,CurGCmdStringLoc,0);
					_lread (Fid,&ID,2);
					_lread (Fid,&ls,2); 
					if (ID == 40 && ls == lGCmdString)
						_lwrite (Fid,pString,lGCmdString);
					GSSiClose (Fid);  
					rtn = GF_INCREASE_SUCCESS_COUNT; 
				}
			}
        	DisableHalt = SaveDisableHalt;
			GlobalUnlock (hGCmdString);
       	}
    }
    	break;
    default:
    	return (FALSE);
    }
    return (rtn);
} 

BOOL ChangeFileSymName (LPSTR FromName,LPSTR ToName)
{   
	HFILE	Fid;
	OFSTRUCT	OFStruct; 
	char	NewName[34];
	
	if (!CurView->UpdateFile)
	{
 		MessageBox(GetFocus(), "No update file in this viewport", NULL,MB_ICONEXCLAMATION|MB_OK);
        return FALSE;
	} 
	else
		_fstrcpy (PltName,CurView->lpFiles[CurView->UpdateFile-1]);
    
	SymbolNameLoc=0;
	_fstrcpy (NewDescName,FromName);
   	if (!OpenMap (CurView->hWnd,CurView->hDC))
   		return FALSE; 
   	CloseMap (FALSE);
   	if (!SymbolNameLoc)
   		return FALSE;
	Fid = GSSiOpenFile (PltName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
	if (Fid == HFILE_ERROR)
		return FALSE;
	_llseek (Fid,SymbolNameLoc,0);    
	_lread (Fid,NewName,SymbolNameLen);
	NewName[SymbolNameLen]=0;
	Truncate (NewName); 
	if (_fstricmp (NewName,FromName))
	{
		GSSiClose (Fid);
		return FALSE;
	}
	_llseek (Fid,SymbolNameLoc,0);    
	_fstrncpy (NewName,ToName,SymbolNameLen); 
	_lwrite (Fid,NewName,SymbolNameLen);
	GSSiClose (Fid);  
    return TRUE;
} 

BOOL RunHltMacro (LPSTR Macro,long StatusInit,LPSTR Title)
{               
    short	pos=BT_FIRST;      
    long	Sequence, Refno, TotNum, CurLoc=1;
    HIGHLIGHTDATA	HighlightData; 
    BOOL	rtn=TRUE; 
    
    if (!ExistFile (Macro))
    	return FALSE;
	TotNum = BT_NUM_IN_INDEX (hHighlight2);
	if (TotNum > 1 && TotNum >= StatusInit)
		CreateStatusWindow (hWndMain,1,NULL);
	while (!BT_FIND (hHighlight2,(LPSTR)&Sequence,pos,BT_ANY,(LPSTR)&Refno))
	{   
		pos = BT_NEXT;
		BT_FIND (hHighlight,(LPSTR)&Refno,BT_FIRST,BT_EQ,(LPSTR)&HighlightData);
   		PickList[0]=HighlightData.PD;
		SetPickGlobals (0);    
		rtn = ProcessMacroFile (Macro,NULL,0);
		if (!rtn)
			break;
		StatusWindowUpdate (Title,"",TotNum,CurLoc++);
	}
	DestroyStatusWindow();  
	return rtn; 
}

