short FillRectPoly(HDC hDC, LPRECT Rect, COLORREF Color)
{
    POINT   Points[4];
    HBRUSH  CurBrush, brush;
    HPEN    CurPen, pen;
    short       i;
    
    SaveDC (hDC);
    brush = CreateGMBrush (Color,hDC);
    CurBrush = SelectObject (hDC,brush); 
    pen = CreatePen (PS_SOLID,0,Color);  
    if (GetROP2 (hDC) != R2_MASKPEN)
    	CurPen = SelectObject (hDC,pen);
    else
    	CurPen = SelectObject (hDC,GetStockObject(NULL_PEN));
    Points[0].x = Rect->left;
    Points[0].y = Rect->bottom;
    Points[1].x = Rect->left;
    Points[1].y = Rect->top;    
    Points[2].x = Rect->right;
    Points[2].y = Rect->top;
    Points[3].x = Rect->right;
    Points[3].y = Rect->bottom; 
    i = Polygon (hDC,Points,4);         
    SelectObject (hDC,CurBrush);                         
    SelectObject (hDC,CurPen);  
    DeleteObject (pen);
    DeleteObject (brush);
    RestoreDC (hDC,-1);
    return (i);

}      

BOOL SetCVTFromVis (void)
{   
	UINT	idesc; 
	short	type;
	
	if (!GetGlobalBVal ("[%SYMDICTREQUIRED]"))
		return FALSE;
	SelectVisList (FALSE);
	if (CurVis->WantType[0])
		type =3;
	else
		type =2;
	for (idesc=1;idesc<3201;idesc++) 
	{ 
		if (GetVisibility (idesc))
			CurView->CurVisType[idesc] = type; 
		else
			CurView->CurVisType[idesc] = 0; 
	}
	return TRUE;
}

int GWPolyline (HDC hDC, HPPOINT lpPoints, long npnts)
{
	HANDLE Handle;
	HPPOINT	lpNewPoints, lpPntNew;
	DWORD	i;

	if (!Display || !hDC ||npnts < 2 || ShowBadSyms)
		return (0);
//    if (!GetTypeVisibility(8) && SymIsInvis (CurrentDesc))
//    	return (0);
	if (!FileProjectionType && (FileMode || CurView->FileFactor <= 1))
	{
		if (DoGraphics && npnts > 1)
			i = BigPolyline (hDC,lpPoints,npnts);
			if (!i)
				i=1;
	}
	else
	{
		if (!(Handle = GSSiGlobAlloc (GMEM_MOVEABLE,npnts * sizeof(POINT))))
			return (-1);
		lpNewPoints = (HPPOINT)GlobalLock (Handle);
		if (!CurView->FileFactor) CurView->FileFactor=1;
		for (i=0,lpPntNew = lpNewPoints;i<npnts;i++,lpPntNew++,lpPoints++)
		{   
			ProjectFilePt (lpPoints);
			lpPntNew->x = lpPoints->x / CurView->FileFactor;
			lpPntNew->y = lpPoints->y / CurView->FileFactor;
		}  
		if (DoGraphics && npnts > 1)
			i = BigPolyline (hDC,lpNewPoints,npnts);
		GSSiGlobUlFree (&Handle);
	} 
	return (i);

} 

BOOL PointInWBoundsPTOL (HPDPOINT Point)
{    
	 BOOL	rtn=TRUE;
	 
	 if (Point->x - P_TOL > CurView->WBounds.xmx ||
	     Point->y - P_TOL > CurView->WBounds.ymx ||
	     Point->x + P_TOL < CurView->WBounds.xmn ||
	     Point->y + P_TOL < CurView->WBounds.ymn) rtn=FALSE;
	 return rtn;
}



short GetWBoundsInt (LPDPOINT pPoint1,LPDPOINT pPoint2,LPDPOINT pIntPoints)
{
	short	nint=0;
	double	AZ=getazd (pPoint1,pPoint2);
	double	linelen=ldistp (*pPoint1,*pPoint2);
	double	SavePTOL = P_TOL; 
	MNMXCORD	Bounds;
	double	maxptol = 0.1 * min (CurView->WBounds.xmx - CurView->WBounds.xmn,CurView->WBounds.ymx - CurView->WBounds.ymn);
	
	Bounds.xmn = min (pPoint1->x,pPoint2->x);
	Bounds.xmx = max (pPoint1->x,pPoint2->x);
	Bounds.ymn = min (pPoint1->y,pPoint2->y);
	Bounds.ymx = max (pPoint1->y,pPoint2->y);
	if (!BoundsInBounds (&Bounds,&CurView->WBounds,1)) 
		return 0;
	P_TOL = min (P_TOL,maxptol);
	if (LINSEC (pPoint1->x,pPoint1->y,AZ,
				CurView->WBounds.xmn,CurView->WBounds.ymn,HALFPI,
				&pIntPoints->x,&pIntPoints->y) == 1)
	{   
		if (PointInWBoundsPTOL (pIntPoints) &&
			ldistp (*pIntPoints,*pPoint1) <= linelen && 
			ldistp (*pIntPoints,*pPoint2) <= linelen)
		{
			nint++;
			pIntPoints++;
		}
	}
	if (LINSEC (pPoint1->x,pPoint1->y,AZ,
				CurView->WBounds.xmn,CurView->WBounds.ymn,0,
				&pIntPoints->x,&pIntPoints->y) == 1)
		if (PointInWBoundsPTOL (pIntPoints) &&
			ldistp (*pIntPoints,*pPoint1) <= linelen && 
			ldistp (*pIntPoints,*pPoint2) <= linelen)
		{
			nint++;
			pIntPoints++;
		}
	if (LINSEC (pPoint1->x,pPoint1->y,AZ,
				CurView->WBounds.xmx,CurView->WBounds.ymx,HALFPI,
				&pIntPoints->x,&pIntPoints->y) == 1)
		if (PointInWBoundsPTOL (pIntPoints) &&
			ldistp (*pIntPoints,*pPoint1) <= linelen && 
			ldistp (*pIntPoints,*pPoint2) <= linelen)
		{
			nint++;
			pIntPoints++;
		}
	if (LINSEC (pPoint1->x,pPoint1->y,AZ,
				CurView->WBounds.xmx,CurView->WBounds.ymx,0,
				&pIntPoints->x,&pIntPoints->y) == 1)
		if (PointInWBoundsPTOL (pIntPoints) &&
			ldistp (*pIntPoints,*pPoint1) <= linelen && 
			ldistp (*pIntPoints,*pPoint2) <= linelen)
		{
			nint++;
			pIntPoints++;
		}
	P_TOL = SavePTOL;
	return nint;
}

BOOL EliminateDupPoints (long np,HPFPOINT pPoints)
{   
	long	CurWidth=0, CurWidthPlus1=CurWidth+1;
	HPFPOINT	pLastPoint, lpPntNew;
	
	if (np<2)
		return FALSE;
	else
	{
		pLastPoint = lpPntNew = pPoints + (np-1);
		lpPntNew++;
		if (fabs ((long)lpPntNew->x - (long)pLastPoint->x) > CurWidthPlus1 ||
			fabs ((long)lpPntNew->y - (long)pLastPoint->y) > CurWidthPlus1)
			return FALSE;
	}   
	return TRUE;
} 

int PlotLinearItem (HDC hDC,HPFPOINT lpPoints,long nPnts,short idesc,HANDLE hSymbol,short nElementsToDisplay, HANDLE hElementToDisplay,BOOL WantPreSym,BOOL WantPostSym)
{   
	BOOL	Invis, SingleLine=TRUE, DoDestroy=FALSE;
	int		DeviceRes, ii; 
	HPFPOINT	lpEndPoint;
	LPSYMBOLATTRIBUTE	pSymAtt;
	LPSYMBOL	CurSymbol; 
	UINT	i; 
	short	CurElem=0, WantType, Type;
	double	SymDist=0, SymFac;   
	FPOINT	Point1, Point2;
	
	if (!OpenSymDict (OF_READ))
		return 0;  
	if (nPnts < 2)
		return 0;
	if (!idesc && ShowBadSyms)
		return 0;
	if (!hSymbol && hSymbolAttributes && idesc && idesc <= NumSymbols)
	{
		pSymAtt = (LPSYMBOLATTRIBUTE)GlobalLock (hSymbolAttributes);
		Invis = pSymAtt[idesc-1].InVisible; 
		SingleLine = pSymAtt[idesc-1].SolidLine;  
		Type = pSymAtt[idesc-1].Type;
		GlobalUnlock (hSymbolAttributes);
		if (Type != 2)
			SingleLine = TRUE;  
		else if (ShowBadSyms) 
			return 0;
		if (!CurVis)
			return 0;
		if (Invis && !CurVis->WantType[8])
			return 0;
	}
	DeviceRes = GetDeviceCaps(hDC, LOGPIXELSX); 
//	SymFac = (double) DeviceRes;
	if (LineSymbolFactor > 0) 
		SymFac = LineSymbolFactor * (15.24 * BaseDistToWinDist);
	else
		SymFac = -LineSymbolFactor * DeviceRes;
	if (!hSymbol && (SymFac < 0.5 || SingleLine || Invis || !GetTypeVisibility(6)))// || CurrentType == GF_CURVE) 
		return BigFPolyline (hDC,lpPoints,nPnts);
	if (!hSymbol)
	{
		DoDestroy = TRUE;
		hSymbol = GetDictSymDesc (idesc);
	}
	if (!hSymbol)	
		return BigFPolyline (hDC,lpPoints,nPnts);  
        
	CurSymbol = (LPSYMBOL)GlobalLock (hSymbol); 
//	GSSiTrace (CurSymbol->Name);
	if (CurSymbol->NumElements && CurSymbol->HSize)
	{
	    lpEndPoint = lpPoints + 1;  
	    if (CurSymbol->Number == 109)
	    	ii=1;
	    if (WantPreSym)
	    	WantType = -1;
	    else
	    	WantType = -2;
		for (i=1;i<nPnts;i++,lpEndPoint++,lpPoints++)
		{   
			Point1 = *lpPoints;
			Point2 = *lpEndPoint;
			DrawSymbolBetweenPoints (hDC,Point1,Point2,CurSymbol,&SymDist,&CurElem,&SymFac,&WantType,nElementsToDisplay,hElementToDisplay);			
		}
		if (WantPostSym)
		{
			WantType = -3;
			DrawSymbolBetweenPoints (hDC,Point1,Point2,CurSymbol,&SymDist,&CurElem,&SymFac,&WantType,nElementsToDisplay, hElementToDisplay);			
		}
	}
 	GlobalUnlock (hSymbol); 
 	if (DoDestroy)
		DestroySymbol (hSymbol); 
	return 0;
}

int GWPolylineD (HDC hDC, HPDPOINT lpPoints, long npnts,short idesc)
{
	HANDLE Handle;
	HPFPOINT	lpNewPoints, lpPntNew;
	DWORD	i;
	long	np=0, nSplinePoints=0, MaxSplinePoints=4096;  
	FPOINT	LastPoint; 
	BOOL	PinB, LastPinB=TRUE, WantPreSym=TRUE,WantPostSym=TRUE; 
	DPOINT	IntPoints[4],LastDPoint;
	short	nint, j;  
//	BOOL	Spline=GetGlobalBVal2 ("[%SPLINE]",FALSE);
	HANDLE	hSpline=0;
	HPDPOINT	pSplinePoints;
	
	if (!Display || !hDC || npnts<=0)
		return (0);
//    if (!GetTypeVisibility(8) && SymIsInvis (CurrentDesc))
//    	retrn (0);  
/*	if (Spline)
	{   
		hSpline = GSSiGlobAlloc (GMEM_MOVEABLE,MaxSplinePoints * sizeof(DPOINT));
		pSplinePoints = (HPDPOINT)GlobalLock (hSpline);
		SplinePointsD (1,npnts,lpPoints,&nSplinePoints, pSplinePoints,CurView->BaseUnitsPerPixel,CurView->BaseUnitsPerPixel/4,0,MaxSplinePoints);
		npnts = nSplinePoints;
		lpPoints = pSplinePoints;
    }*/
    SaveDC (hDC);
	SetDisplayMode (CurView->hDC, GF_TEXTMODE);
	Handle = GSSiGlobAlloc (GMEM_MOVEABLE,((long)npnts+16L) * (long)sizeof(FPOINT));
	lpPntNew = lpNewPoints = (HPFPOINT)GlobalLock (Handle);
	for (i=0;i<npnts;i++,lpPoints++)
	{   
		if ((PinB = PointInWBounds (lpPoints)))
		{
			if (!LastPinB)
			{ 
				nint = GetWBoundsInt (&LastDPoint,lpPoints,IntPoints);
				for (j=0;j<nint;j++)
				{
					*lpPntNew = DPointToFPoint (BasePtToWinPtD (&IntPoints[j])); 
				    if (!EliminateDupPoints (np,lpNewPoints))
				    {
				    	lpPntNew++;
				    	np++;
				    }  
				}
			} 
			*lpPntNew = DPointToFPoint (BasePtToWinPtD (lpPoints));  
			LastPoint = *lpPntNew;
		    if (!EliminateDupPoints (np,lpNewPoints))
		    {
		    	lpPntNew++;
		    	np++;
		    }  
		}
		else if (i)
		{
			nint = GetWBoundsInt (&LastDPoint,lpPoints,IntPoints);
			for (j=0;j<nint;j++)
			{
				*lpPntNew = DPointToFPoint (BasePtToWinPtD (&IntPoints[j])); 
			    if (!EliminateDupPoints (np,lpNewPoints))
			    {
			    	lpPntNew++;
			    	np++;
			    }  
			}
			if (DoGraphics && np > 1)
				PlotLinearItem (hDC,lpNewPoints,np,idesc,0,0,0,WantPreSym,FALSE);   
			WantPreSym = FALSE;
			np = 0;
			lpPntNew = lpNewPoints;
		}
		else
			WantPreSym = FALSE;
		LastDPoint = *lpPoints;
		LastPinB = PinB;
	}
	if (!PinB)
		WantPostSym = FALSE;   
	if (DoGraphics && np > 1)
		PlotLinearItem (hDC,lpNewPoints,np,idesc,0,0,0,WantPreSym,WantPostSym);
	GSSiGlobUlFree (&Handle);  
	GSSiGlobUlFree (&hSpline);
	RestoreDC (hDC,-1);
	return (i);

}

int GWPolygon (HDC hDC, HPPOINT lpPoints, long npnts, short nPoly, HANDLE hPolyPartLen)
{	HANDLE Handle;
	HPPOINT	lpNewPoints, lpPntNew, lpPointsIn=lpPoints;
	DWORD	i, NewPnts, LastPartPoint; 
	short	Attempts=0, iPoly;  
	BOOL	ReduceNumPoints=FALSE, FirstPartPoint=TRUE, LinkPoint=FALSE;
	POINT	LastPoint, NextPoint, OutPoint;
	double	SkipDist;  
	LPWORD	pPartLen; 
	RECT	Rect, NewRect, BoundsRect;
	BOOL	LastOut;
	static	short	DebugID=6;
	short	ii;
	
	if (!Display || !hDC || ShowBadSyms)
		return (0);  
//    if (!GetTypeVisibility(8) && SymIsInvis (CurrentDesc))
//    	retrn (0);    
	if (CurView->ID == DebugID)
		ii=1;
	MostPoints = max (MostPoints,npnts);
	if (npnts > MaxDisplayPoints)   
	{
		if (CurrentItemMinMax.xmn/CurView->FileFactor >= CurView->Bounds.xmn &&
			CurrentItemMinMax.ymn/CurView->FileFactor >= CurView->Bounds.ymn &&
			CurrentItemMinMax.xmx/CurView->FileFactor <= CurView->Bounds.xmx &&
			CurrentItemMinMax.ymx/CurView->FileFactor <= CurView->Bounds.ymx)
			Attempts = 1;
		else
			Attempts = 0; 
		SkipDist = 0.2/(FileDistToWinDist*CurView->FileFactor);
		ReduceNumPoints = TRUE; 
	}
	if (!FileProjectionType && (FileMode || CurView->FileFactor <= 1) && !ReduceNumPoints) 
	{
		if (DoGraphics)
			i = Polygon (hDC,lpPoints,(short)npnts);
	}
	else                                 
	{   
		BoundsRect.left = CurView->Bounds.xmn;
		BoundsRect.right = CurView->Bounds.xmx ;
		BoundsRect.top = CurView->Bounds.ymn;
		BoundsRect.bottom = CurView->Bounds.ymx;
		Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)npnts * sizeof(POINT)); 
		lpNewPoints = (HPPOINT)GlobalLock (Handle);  
		if (!CurView->FileFactor) CurView->FileFactor=1;
TryAgain: 
		iPoly = 1;
		LastOut = FALSE;
		if (hPolyPartLen && ReduceNumPoints)
		{
			pPartLen = (LPWORD)GlobalLock (hPolyPartLen);
			LastPartPoint = *pPartLen-1;
			GlobalUnlock (hPolyPartLen);
		}
		else
			LastPartPoint = npnts-1;
		if (ReduceNumPoints)
			NewPnts = 0;
		else
			NewPnts = npnts;
		for (i=0,lpPntNew = lpNewPoints;i<npnts;i++,lpPoints++)
		{   
			*lpPntNew = *lpPoints;
			ProjectFilePt (lpPntNew);
			lpPntNew->x /= CurView->FileFactor;
			lpPntNew->y /= CurView->FileFactor; 
			if (ReduceNumPoints)
			{
				if (LinkPoint) 
				{
					LastPoint = *lpPntNew++;  
					NewPnts++;
					FirstPartPoint = TRUE; 
					LinkPoint = FALSE;
					LastOut = FALSE;
				}
				else if (FirstPartPoint) 
				{
					LastPoint = *lpPntNew++;  
					NewPnts++;
					FirstPartPoint = FALSE; 
					LastOut = FALSE;
				}
				else if (i == LastPartPoint)
				{   
					if (LastOut)
					{
						NewPnts++;
						NextPoint = *lpPntNew;
						*lpPntNew++ = OutPoint;
						*lpPntNew = NextPoint;
					}
					LastPoint = *lpPntNew++;  
					NewPnts++;
					LastOut = FALSE;
					if (iPoly < nPoly)
					{
						pPartLen = (LPWORD)GlobalLock (hPolyPartLen);
						pPartLen += iPoly;
						LastPartPoint = i + *pPartLen;
						if (iPoly > 1)
						{
							LastPartPoint++; 
							LinkPoint = TRUE;
						}
						iPoly++; 
						GlobalUnlock (hPolyPartLen);
					}
				}
				else if (Attempts)
				{   
				
					if (idist (*lpPntNew,LastPoint) > SkipDist)
					{
						NewPnts++;
						LastPoint = *lpPntNew++; 
					} 
					else
						ii=1;
				} 
				else
				{ 
					Rect.left = min (lpPntNew->x,LastPoint.x);
					Rect.right = max (lpPntNew->x,LastPoint.x);
					Rect.top = min (lpPntNew->y,LastPoint.y);
					Rect.bottom = max (lpPntNew->y,LastPoint.y); 
					if (IntersectRect (&NewRect,&Rect,&BoundsRect))
					{   
						if (LastOut)
						{
							NewPnts++;
							NextPoint = *lpPntNew;
							*lpPntNew++ = OutPoint;
							*lpPntNew = NextPoint;
						}
						NewPnts++;
						LastPoint = *lpPntNew++;
						LastOut = FALSE;
					}
					else
					{
						OutPoint = *lpPntNew;
						LastOut = TRUE;      
					}
				}
			}
			else
				lpPntNew++;	
		} 
		if (NewPnts > MaxDisplayPoints && Attempts < 8)
		{
			SkipDist*=2; 
			Attempts++;    
			lpPoints = lpPointsIn;
			goto TryAgain;
		}
		if (DoGraphics)
			i = Polygon (hDC,lpNewPoints,(short)NewPnts);  
		GSSiGlobUlFree (&Handle);
	}
	return (i);
	
}
    
int GWPolygonD (HDC hDC, HPDPOINT lpPoints, long npnts, short nPoly, HANDLE hPolyPartLen)
{	
	HANDLE Handle;
	HPPOINT	lpNewPoints, lpPntNew;
	HPDPOINT lpPointsIn=lpPoints;
	DWORD	i, NewPnts, LastPartPoint; 
	short	Attempts=0, iPoly;  
	BOOL	ReduceNumPoints=FALSE, FirstPartPoint=TRUE, LinkPoint=FALSE;
	POINT	LastPoint, NextPoint, OutPoint;
	double	SkipDist;  
	LPWORD	pPartLen; 
	RECT	Rect, NewRect, BoundsRect;
	BOOL	LastOut;
	
	if (!Display || !hDC || npnts<=0 || ShowBadSyms)
		return (0);  
//    if (!GetTypeVisibility(8) && SymIsInvis (CurrentDesc))
//    	retrn (0);
    if (SnapPolygons) 
    {   
    	double	SnapTol = GetGlobalDVal2 ("[%SNAPPOLYTOL]",0);
		SnapPolyPoints (npnts,lpPoints,SnapTol);
    	RemoveDupPolyPoints (&npnts,lpPoints, P_TOL);
	}
    SaveDC (hDC);
	SetDisplayMode (CurView->hDC, GF_TEXTMODE);

	MostPoints = max (MostPoints,npnts);
	if (npnts > MaxDisplayPoints)   
	{
		if (CurrentItemMinMax.xmn/CurView->FileFactor >= CurView->Bounds.xmn &&
			CurrentItemMinMax.ymn/CurView->FileFactor >= CurView->Bounds.ymn &&
			CurrentItemMinMax.xmx/CurView->FileFactor <= CurView->Bounds.xmx &&
			CurrentItemMinMax.ymx/CurView->FileFactor <= CurView->Bounds.ymx)
			Attempts = 1;
		else
			Attempts = 0; 
		SkipDist = 2;
		ReduceNumPoints = TRUE; 
	}
	if (!ReduceNumPoints) 
	{
		if (DoGraphics)
		{
			POINT	LastPoint;
			long	np=1;
	
			Handle = GSSiGlobAlloc (GMEM_MOVEABLE,npnts * sizeof(POINT)); 
			lpPntNew = lpNewPoints = (HPPOINT)GlobalLock (Handle);  
			*lpPntNew = BasePtToWinPt (lpPoints++); 
			LastPoint = *lpPntNew++;
			for (i=1;i<npnts;i++,lpPoints++)
			{
				*lpPntNew = BasePtToWinPt (lpPoints);   
				if (lpPntNew->x != LastPoint.x || lpPntNew->y != LastPoint.y)
				{   
					LastPoint = *lpPntNew;
					lpPntNew++;
					np++;
				}
			}
			if (np > 1) 
			{
				i = Polygon (hDC,lpNewPoints,(short)np); 
				if (ShowLinkLines)  
					i = Polyline (hDC,lpNewPoints,(short)np); 
			}
			GSSiGlobUlFree (&Handle);
		}
	}
	else                                 
	{   
		BoundsRect = CurView->Rect;
		Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)npnts * sizeof(POINT)); 
		lpNewPoints = (HPPOINT)GlobalLock (Handle);  
		if (!CurView->FileFactor) CurView->FileFactor=1;
TryAgain: 
		iPoly = 1;
		LastOut = FALSE;
		if (hPolyPartLen && ReduceNumPoints)
		{
			pPartLen = (LPWORD)GlobalLock (hPolyPartLen);
			LastPartPoint = *pPartLen-1;
			GlobalUnlock (hPolyPartLen);
		}
		else
			LastPartPoint = npnts-1;
		if (ReduceNumPoints)
			NewPnts = 0;
		else
			NewPnts = npnts;
		for (i=0,lpPntNew = lpNewPoints;i<npnts;i++,lpPoints++)
		{
			*lpPntNew = BasePtToWinPt (lpPoints);   
			if (ReduceNumPoints)
			{
				if (LinkPoint) 
				{
					LastPoint = *lpPntNew++;  
					NewPnts++;
					FirstPartPoint = TRUE; 
					LinkPoint = FALSE;
					LastOut = FALSE;
				}
				else if (FirstPartPoint) 
				{
					LastPoint = *lpPntNew++;  
					NewPnts++;
					FirstPartPoint = FALSE; 
					LastOut = FALSE;
				}
				else if (i == LastPartPoint)
				{   
					if (LastOut)
					{
						NewPnts++;
						NextPoint = *lpPntNew;
						*lpPntNew++ = OutPoint;
						*lpPntNew = NextPoint;
					}
					LastPoint = *lpPntNew++;  
					NewPnts++;
					LastOut = FALSE;
					if (iPoly < nPoly)
					{
						pPartLen = (LPWORD)GlobalLock (hPolyPartLen);
						pPartLen += iPoly;
						LastPartPoint = i + *pPartLen;
						if (iPoly > 1)
						{
							LastPartPoint++; 
							LinkPoint = TRUE;
						}
						iPoly++; 
						GlobalUnlock (hPolyPartLen);
					}
				}
				else if (Attempts)
				{   
				
					if (idist (*lpPntNew,LastPoint) > SkipDist)
					{
						NewPnts++;
						LastPoint = *lpPntNew++; 
					}
				} 
				else
				{ 
					Rect.left = min (lpPntNew->x,LastPoint.x);
					Rect.right = max (lpPntNew->x,LastPoint.x);
					Rect.top = min (lpPntNew->y,LastPoint.y);
					Rect.bottom = max (lpPntNew->y,LastPoint.y); 
					if (IntersectRect (&NewRect,&Rect,&BoundsRect))
					{   
						if (LastOut)
						{
							NewPnts++;
							NextPoint = *lpPntNew;
							*lpPntNew++ = OutPoint;
							*lpPntNew = NextPoint;
						}
						NewPnts++;
						LastPoint = *lpPntNew++;
						LastOut = FALSE;
					}
					else
					{
						OutPoint = *lpPntNew;
						LastOut = TRUE;      
					}
				}
			}
			else
				lpPntNew++;	
		} 
		if (NewPnts > MaxDisplayPoints && Attempts < 8)
		{
			SkipDist*=2; 
			Attempts++;    
			lpPoints = lpPointsIn;
			goto TryAgain;
		}
		if (DoGraphics)
		{
			i = Polygon (hDC,lpNewPoints,(short)NewPnts);  
			if (ShowLinkLines)  
				i = Polyline (hDC,lpNewPoints,(short)NewPnts);
		} 
		GSSiGlobUlFree (&Handle);
	}
	RestoreDC (hDC,-1);
	return (i);
	
}
    
BOOL PickPolygon (HPPOINT lpPoints,long nPnts, double Offdist)
{   
	HANDLE Handle=0;
	HPDPOINT	lpNewPoints;
	HPDPOINT	lpDpoints;  
	HPPOINT		lpPointsIn=lpPoints;
	int	 Type, NearPoint; 
	DWORD	i;
	MNMXCORD	Rect;  
	DPOINT	BeginPoint, EndPoint,PickedPoint, LastPoint, PickPointW, NodePoint;  
	POINT	BeginPointFile,EndPointFile,PickedPointFile;
	double	Area=0,Perim=0, MinDist=DBL_MAX, Dist, AZ[3];    
	BOOL	Selected=FALSE, rtn, pina=TRUE;   
	POINT	PickPoint;
    
    if (PickNET)
    	return FALSE;
    if (hHighlightArea)
    	return (PickPolyInArea(0,lpPoints,nPnts));
	PickPointW.x = (CurView->WBounds.xmn + CurView->WBounds.xmx) / 2;
	PickPointW.y = (CurView->WBounds.ymn + CurView->WBounds.ymx) / 2;
	PickPoint = BasePtToFilePt (PickPointW); 

    if (!PickingByRefno)
		pina = POINT_IN_AREA (PickPoint, nPnts, lpPoints);
    if (PickPerim==1) 
    {
    	BOOL	rtn; 
    	long	np=nPnts;
    	
    	rtn = PickPolyline (lpPoints,nPnts,3,0,pina);
   		return rtn;
    }
    if (!pina  && !(PickPerim == 2))
		goto Exit;
	
    Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)nPnts*sizeof(DPOINT));
 	lpDpoints = (HPDPOINT) GlobalLock (Handle); 
 	lpNewPoints = lpDpoints;
	for (i=0;i<nPnts;i++,lpPoints++,lpDpoints++)
	{   
		*lpDpoints = FilePtToBasePt (*lpPoints);
		Dist = ldistp (PickPointW,*lpDpoints);  
		if (Dist < MinDist)
		{
			MinDist = Dist;
			NodePoint = *lpDpoints;
			NearPoint = i;
		}
		if (!i)
			BeginPoint = *lpDpoints;
		else  
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			Area += ( LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	} 
	Perim += ldistp(LastPoint,BeginPoint);
	Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;  
	EndPoint = LastPoint;
     
    if (PickingByRefno)
    	Selected = TRUE;
    else if (PickPerim==2) 
    {
    	BOOL	rtn; 
    	
    	Selected = PickPolyline (lpPointsIn,nPnts,-3,0,pina);
    	if (Selected)
    	{
			GSSiGlobUlFree (&Handle);
			return (Selected);
    	}	
    }
    else
    	Selected = TRUE;
    if (Selected)
	{   
		if (CurrentType == GF_TEXT) 
		{
			BeginPoint = LastElementBeginPoint;
			EndPoint = LastElementEndPoint;
			Type = 4;          
		}
		else
			Type = 3;
		
		GetItemMinMax (&CurrentItemMinMax,&Rect);
		PickedPoint = PickPointW;
		PickedPointFile = BasePtToFilePt (PickPointW);
		PickListAdd (FileNum,SubFile,FileInIndex,ItemSeg,CurrentRefno,CurrentDesc,CurrentiPen,
					   -Type,0,Offdist,AZ,Perim,CurrentItem,CurElement,BeginPoint,EndPoint,PickedPoint,
					   NodePoint,NearPoint,
					   Area,&Rect,
					   BeginPointFile,EndPointFile,PickedPointFile,nPnts,NULL_ELEV);
	} 
Exit:
	GSSiGlobUlFree (&Handle);
	return (Selected);
}                  

BOOL PickPolygonD (HPDPOINT lpDpoints,long nPnts, double Offdist,HANDLE hElev)
{   POINT	PickPoint;
	HPDPOINT	lpNewPoints;
	int	 Type, NearPoint; 
	DWORD	i;
	MNMXCORD	Rect;    
	float	Elev=NULL_ELEV;
	DPOINT	BeginPoint, EndPoint,PickedPoint, LastPoint, PickPointW, NodePoint;  
	POINT	BeginPointFile,EndPointFile,PickedPointFile;
	double	Area=0,Perim=0, MinDist=DBL_MAX, Dist, AZ[3]={0,0,0};    
	BOOL	Selected=FALSE, pina;
    
    if (PickNET)
    	return FALSE;
    if (hHighlightArea)
    	return (PickPolyInAreaD(0,lpDpoints,nPnts,0,0));
	PickPointW.x = (CurView->WBounds.xmn + CurView->WBounds.xmx) / 2;
	PickPointW.y = (CurView->WBounds.ymn + CurView->WBounds.ymx) / 2;
    if (PickPerim) 
    {
    	HANDLE hNew = GSSiGlobAlloc (GMEM_MOVEABLE,(nPnts+1)*(long)sizeof(DPOINT));
    	HPDPOINT	pNewPoints=(HPDPOINT)GlobalLock (hNew);
    	BOOL	rtn; 
    	long	np=nPnts;
    	
    	pina = POINT_IN_AREAD (PickPointW, nPnts, lpDpoints,NULL);
    	hmemmove ((HPSTR)pNewPoints,(HPSTR)lpDpoints,np*(long)sizeof(DPOINT));
    	pNewPoints[np++] = *lpDpoints;
    	rtn = PickPolylineD (pNewPoints,np,3,0,0,pina);
    	GSSiGlobUlFree (&hNew); 
    	if (rtn || PickPerim == 1)
    		return rtn;
    }	
	
 	lpNewPoints = lpDpoints;
	for (i=0;i<nPnts;i++,lpDpoints++)
	{   
		Dist = ldistp (PickPointW,*lpDpoints);  
		if (Dist < MinDist)
		{
			MinDist = Dist;
			NodePoint = *lpDpoints;
			NearPoint = i;
		}
		if (!i)
			BeginPoint = *lpDpoints;
		else  
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			Area += ( LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	} 
	Perim += ldistp(LastPoint,BeginPoint);
	Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;  
	
	
/*		{
			HANDLE hCP = GSSiGlobAlloc (GHND,4); 
			LPSHORT pCP = GlobalLock (hCP); 
			double	Area2;
			
			*pCP = -1;   
			GlobalUnlock (hCP);
			Area2 = AreaFromPolyWithCurves (hUnSplinedPoly,nUnSplinedPoints,hCP);  
			GSSiGlobFree (&hCP);
		}*/
	if (hUnSplinedPoly)
		Area = AreaFromPolyWithCurves (hUnSplinedPoly,nUnSplinedPoints,hCurvePoints);
	EndPoint = LastPoint;
     
    if (PickingByRefno)
    	Selected = TRUE;
    else if (POINT_IN_AREAD (PickPointW, nPnts, lpNewPoints,NULL))
    	Selected = TRUE;
    else
    	Selected = FALSE;
    if (Selected)
	{   
		if (CurrentType == GF_TEXT) 
		{
			BeginPoint = LastElementBeginPoint;
			EndPoint = LastElementEndPoint;
			Type = 4;          
		}
		else
			Type = 3;
		
		GetItemMinMax (&CurrentItemMinMax,&Rect);
		PickedPoint = PickPointW;
		PickedPointFile = BasePtToFilePt (PickPointW);  
		if (hElev && nPnts == 3 && !PickingByRefno)
		{   
			LPFLOAT		pElev = (LPFLOAT)GlobalLock (hElev); 
			double		A1 = getazd (&lpNewPoints[0],&PickPointW);
			double		A2 = getazd (&lpNewPoints[1],&lpNewPoints[2]);  
			double		d1, d2, elev1;
			DPOINT		IntPt;
        	short		IRC = LIN_SEC (lpNewPoints[0].x,lpNewPoints[0].y,A1,
         				   			   lpNewPoints[1].x,lpNewPoints[1].y,A2,
          				   			   &IntPt.x, &IntPt.y);
                        if (IRC)
                        	IRC = 0;
                        else        
                        {
                        	d1 = ldistp (lpNewPoints[1],lpNewPoints[2]);
                        	d2 = ldistp (lpNewPoints[1],IntPt);
                        	elev1 = pElev[1] + (pElev[2] - pElev[1]) * (d2 / d1);
                        	d1 = ldistp (IntPt,lpNewPoints[0]);
                        	if (!d1)
                        		Elev = pElev[0];
                        	else
                        	{
	                        	d2 = ldistp (IntPt,PickPointW);
	                        	Elev = elev1 + (pElev[0] - elev1) * (d2 / d1); 
	                        }
                        }
			GlobalUnlock (hElev);
		}
		PickListAdd (FileNum,SubFile,FileInIndex,ItemSeg,CurrentRefno,CurrentDesc,CurrentiPen,
					   Type,0,Offdist,AZ,Perim,CurrentItem,CurElement,BeginPoint,EndPoint,PickedPoint,
					   NodePoint,NearPoint,
					   Area,&Rect,
					   BeginPointFile,EndPointFile,PickedPointFile,nPnts,Elev);
	}
	return (Selected);
}                  

BOOL PickPolyInArea (short Type,HPPOINT lpPoints,long nPnts)
{   
	LPINT	lpNump;
	HPDPOINT lpDpoint;
	HPDPOINT lpDpoints;  
	DPOINT	BeginPoint, EndPoint, LastPoint; 
	POINT	BeginPointFile, EndPointFile;
	LPMNMXCORD	lpRect; 
	DWORD	Nump, i,j; 
	HANDLE	hPoints;
	BOOL	rtn=FALSE;  
	double	Area=0,Perim=0;  
	short	Type2=GF_POLYLINE;
	
	Nump = nHighlightAreaPoints;  
	lpRect = (LPMNMXCORD) GlobalLock (hHighlightArea); 
    lpRect++;
    lpDpoint = (LPDPOINT) lpRect;  
	    
    hPoints = GSSiGlobAlloc (GMEM_MOVEABLE,(long)nPnts*sizeof(DPOINT));
 	lpDpoints = (HPDPOINT) GlobalLock (hPoints);
	for (i=0;i<nPnts;i++,lpPoints++,lpDpoints++)
	{   
		*lpDpoints = FilePtToBasePt (*lpPoints);  
		if (!i)
		{
			BeginPointFile = *lpPoints;
			BeginPoint = *lpDpoints;   
		}
		else
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			if (!Type)
				Area += (LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	}  
	lpPoints--;
	EndPointFile = *lpPoints;
	if (!Type)
	{   
		Type2 = GF_AREA;
		Perim += ldistp(LastPoint,BeginPoint);
		Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;
	}  
	EndPoint = LastPoint;
	GlobalUnlock(hPoints);
 	lpDpoints = (HPDPOINT) GlobalLock (hPoints);
	rtn = PolyInArea (Type2,nPnts,lpDpoints,Nump,lpDpoint,InclusionOpt);
Exit:
	GlobalUnlock(hPoints); 
	GlobalFree(hPoints);
	GlobalUnlock (hHighlightArea);
	if (rtn) 
	{
		PickList[0].ViewID = CurView->ID; 
		PickList[0].HiPrecis = 0;
		PickList[0].FileNum = FileNum;
		PickList[0].FileInIndex = FileInIndex; 
		PickList[0].SubFile = SubFile;
		PickList[0].Segment = ItemSeg;
		PickList[0].Refno = CurrentRefno;
		PickList[0].Desc = CurrentDesc;  
		PickList[0].ipen = CurrentiPen;
		if (CurrentType == GF_AREA)
			PickList[0].Type = 3; 
		else if (CurrentType == GF_POINT || CurrentType == GF_TEXT)
			PickList[0].Type = 1;  
		else
			PickList[0].Type = 2;  
		PickList[0].PCT = 1;
		PickList[0].OffDist = 0;  
		PickList[0].Length = Perim;
		PickList[0].Offset = CurrentItem;
		PickList[0].Element= CurElement; 
		PickList[0].BeginPointFile = BeginPointFile; 
		PickList[0].EndPointFile = EndPointFile;
		PickList[0].BeginPoint = BeginPoint; 
		PickList[0].EndPoint = EndPoint;
		PickList[0].NumPoints = nPnts;  
		PickList[0].Area = Area; 
		GetItemMinMax (&CurrentItemMinMax,&PickList[0].Rect);
//		PickList[0].Rect = *Rect; 
		_fstrcpy (PickList[0].Prefix,CurrentTAG);
		_fstrcpy (PickList[0].UDI,CurrentUDI);
		if (UnHighlightInArea) 
			RemoveFromHighlightList (PickList[0].Refno,0);
		else
			AddToHighlightList (CurrentRefno,&PickList[0],TRUE);
	}
	return (rtn);
}

BOOL PickPolyInAreaD (short Type,HPDPOINT lpDpoints,long nPnts,LPDOUBLE pAZ,LPDOUBLE pSize)
{   
	LPINT	lpNump;
	HPDPOINT lpDpointIn=lpDpoints,lpDpoint;
	DPOINT	BeginPoint, EndPoint, LastPoint; 
	POINT	BeginPointFile, EndPointFile;
	LPMNMXCORD	lpRect; 
	DWORD	Nump, i,j; 
	BOOL	rtn=TRUE;  
	double	Area=0,Perim=0, AZ=0;  
	short	Type2=GF_POLYLINE;
	
	if (pAZ)
		AZ = *pAZ;   
	if (Type == 6)
		goto Exit;
	else
		rtn = FALSE; 
	Nump = nHighlightAreaPoints;  
	lpRect = (LPMNMXCORD) GlobalLock (hHighlightArea); 
    lpRect++;
    lpDpoint = (LPDPOINT) lpRect;  
	for (i=0;i<nPnts;i++,lpDpoints++)
	{   
		if (!i)
			BeginPoint = *lpDpoints;   
		else
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			if (!Type)
				Area += (LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	}  
	BeginPointFile = BasePtToFilePt (BeginPoint);
	EndPointFile = BasePtToFilePt (LastPoint);
	if (!Type)
	{   
		Type2 = GF_AREA;
		Perim += ldistp(LastPoint,BeginPoint);
		Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;
		if (hUnSplinedPoly)
			Area = AreaFromPolyWithCurves (hUnSplinedPoly,nUnSplinedPoints,hCurvePoints);
	}  
	EndPoint = LastPoint;
 	lpDpoints = lpDpointIn;
	rtn = PolyInArea (Type2,nPnts,lpDpoints,Nump,lpDpoint,InclusionOpt);
	GlobalUnlock (hHighlightArea); 
Exit:
	if (pSize)
		Perim = *pSize;
	if (rtn) 
	{   
		PickList[0].BPAZ = PickList[0].PPAZ = PickList[0].EPAZ = AZ;
		PickList[0].HiPrecis = 1;
		PickList[0].ViewID = CurView->ID;
		PickList[0].FileNum = FileNum;
		PickList[0].FileInIndex = FileInIndex; 
		PickList[0].SubFile = SubFile;
		PickList[0].Segment = ItemSeg;
		PickList[0].Refno = CurrentRefno;
		PickList[0].Desc = CurrentDesc;  
		PickList[0].ipen = CurrentiPen;
		PickList[0].Length = Perim;
		if (Type == 6)
			PickList[0].Type = 6; 
		else if (CurrentType == GF_AREA)
			PickList[0].Type = 3; 
		else if (CurrentType == GF_CURVE)   
		{
			PickList[0].Type = 5;  
			PickList[0].NodePoint = CurPOCW;
			PickList[0].Length = fabs (CurCLEN);
		}
		else if (CurrentType == GF_POINT)
			PickList[0].Type = 1;  
		else if (CurrentType == GF_TEXT)
			PickList[0].Type = 4;  
		else
			PickList[0].Type = 2;  
		PickList[0].PCT = 1;
		PickList[0].OffDist = 0;  
		PickList[0].Offset = CurrentItem;
		PickList[0].Element= CurElement; 
		if (PickList[0].Type == 1)
		{
			PickList[0].BeginPointFile = CurPointF; 
			PickList[0].EndPointFile = CurPointF;
			PickList[0].BeginPoint = CurPointW; 
			PickList[0].EndPoint = CurPointW;  
		} 
		else 
		{
			PickList[0].BeginPointFile = BeginPointFile; 
			PickList[0].EndPointFile = EndPointFile;
			PickList[0].BeginPoint = BeginPoint; 
			PickList[0].EndPoint = EndPoint;
		} 
		PickList[0].NumPoints = nPnts;  
		PickList[0].Area = Area; 
		GetItemMinMax (&CurrentItemMinMax,&PickList[0].Rect);
//		PickList[0].Rect = *Rect; 
		_fstrcpy (PickList[0].Prefix,CurrentTAG);
		_fstrcpy (PickList[0].UDI,CurrentUDI);
		if (UnHighlightInArea) 
			RemoveFromHighlightList (PickList[0].Refno,0);
		else
			AddToHighlightList (CurrentRefno,&PickList[0],TRUE);
	}
	return (rtn);
}

BOOL ContinuePickingInArea (BOOL Display)
{
	MSG     msg;   
	BOOL	IsAccel;  
	char	str[200];
	
	while (PeekMessage(&msg,0,0,0,PM_REMOVE))
	{
		if (msg.message == WM_PAINT)
		{
		  TranslateMessage(&msg);
		  DispatchMessage(&msg);
		}
	    else if (msg.message == WM_KEYDOWN && msg.wParam == 27)  
	    {   
	    	MessageBox (GetFocus(),"Highlight terminated by user","Highlight List Incomplete",MB_ICONEXCLAMATION);
			return FALSE;
		}
	} 
	if (Display)
	{
		sprintf (str,"%s:%ld records highlighted",CurWinText,BT_NUM_IN_INDEX(hHighlight));
		SetWindowText (hWndMain,str); 
	}
	return TRUE;
}

long HighlightInArea (HWND hWnd,LPMNMXCORD pBounds,BOOL AddToList,BOOL DisplayNum)
{	MNMXCORL	SaveBounds;
	MNMXCORD	SaveWBounds, SaveNewBounds;
	
	int			iPickAp; 
	POINT		PickPoint, PickPoint2;
	LPVISLIST	SaveVis;
	double		PickApW;
	POINT		WinPT1, WinPT2;
	DPOINT		WPoint1, WPoint2, PickPointBase2;
	HPEN	hPen, OldPen;
	LPMNMXCORD	lpRect; 
	HANDLE	hPoly;   
	DPOINT	BasePoint, FilePointD;
	long	AreaNum=0;
	BOOL	SavePrint=Printing;
	HCURSOR	hcurSave;
	long	Added=0, BeginNum = BT_NUM_IN_INDEX (hHighlight);
	
	hcurSave = GSSiSetCursor(LoadCursor(NULL, IDC_WAIT)); 
    GetWindowText (hWndMain,(LPSTR)CurWinText,sizeof(CurWinText));
	SaveVis = CurVis;

	SaveBounds = CurView->Bounds;
	SaveWBounds = CurView->WBounds; 
	SaveNewBounds = CurView->NewBounds;
	
	Pick=TRUE;
	NumPicked=0;  
	if (!AddToList)
		UnHighlightInArea = TRUE;
	while (hHighlightArea = GetNextHighlightArea (AreaNum++,pBounds,&nHighlightAreaPoints))
	{
	    lpRect = (LPMNMXCORD) GlobalLock (hHighlightArea); 
		CurView->WBounds = *lpRect;
	    GlobalUnlock (hHighlightArea);
	    CurView->PassID = 0;
		CurView->CurFile=-1;
		PrevLayerVP = 0;
		SelectVisList (TRUE);
		IncrementFile ();
		Printing = TRUE;
		PickName[0] = '\0';
		while (GetNextViewportFile (FALSE))
		{   if (PltType < 5)
			{
				DisplayPlotInit(hWnd,TRUE);
				if (OpenMap (hWnd, 1))
				{   
					_fstrcpy (PickName,PltName); 
					BasePoint.x = CurView->WBounds.xmn;
					BasePoint.y = CurView->WBounds.ymn;
					FilePointD = BasePtToFilePtD (BasePoint);
					CurView->Bounds.xmn = max(INT_MIN,FilePointD.x);
					CurView->Bounds.ymn = max(INT_MIN,FilePointD.y);
					BasePoint.x = CurView->WBounds.xmx;
					BasePoint.y = CurView->WBounds.ymx;
					FilePointD = BasePtToFilePtD (BasePoint);
					CurView->Bounds.xmx = min(INT_MAX,FilePointD.x);
					CurView->Bounds.ymx = min(INT_MAX,FilePointD.y);
					while (DisplaySeg (NULL,FALSE))
						if (!ContinuePickingInArea (DisplayNum))  
						{
							GSSiGlobFree (&hHighlightArea); 
							Added = -1;
							goto Exit;
						}

				} 
			}
		} 
		GSSiGlobFree (&hHighlightArea);
	}
Exit:  
	SetWindowText (hWndMain,(LPSTR)CurWinText);
    Printing = SavePrint;
	Pick=FALSE;
	CurView->Bounds = SaveBounds;
	CurView->WBounds = SaveWBounds; 
	CurView->NewBounds = SaveNewBounds;
	SetDisplayMode (CurView->hDC,GF_TEXTMODE);
	SelectClipRgn (CurView->hDC,NULL);
	CurVis = SaveVis;
	GSSiSetCursor (hcurSave);
	UnHighlightInArea = FALSE; 
	if (Added >= 0)
    	Added = BT_NUM_IN_INDEX (hHighlight) - BeginNum;
	return (Added);

} 
 
double ComputeProjectedAreaArea (HPPOINT lpPoints,long nPnts,LPDOUBLE pPerim)
{    
	HANDLE Handle;
	HPDPOINT	lpNewPoints, lpDpoints;
	DWORD	i;
	BOOL	WantArea=TRUE; 
	DPOINT	BeginPoint, EndPoint,PickedPoint, LastPoint, PickPointW;
	double	Area=0,Perim=0;    

 	if (nPnts<3)
 		WantArea = FALSE;
 	nPnts = labs (nPnts);
    Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)nPnts*sizeof(DPOINT));
 	lpDpoints = (HPDPOINT) GlobalLock (Handle); 
 	lpNewPoints = lpDpoints;  
	for (i=0;i<nPnts;i++,lpPoints++,lpDpoints++)
	{   
		*lpDpoints = FilePtToBasePt (*lpPoints);
		ConvertCoord (lpDpoints,1,3);
		if (!i)
			BeginPoint = *lpDpoints;
		else  
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			if (WantArea)
				Area += ( LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	} 
	Perim += ldistp(LastPoint,BeginPoint);  
	if (WantArea)
		Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;  
	GlobalUnlock (Handle);
	GlobalFree (Handle);     
	*pPerim = Perim;
	return (Area);
}  

double GetPolyLengthD (HPDPOINT lpPoints,long nPnts)
{
	double Dist=0;
	DWORD	i; 
	HPDPOINT	lpPoints2=lpPoints+1;
	
	for (i=1;i<nPnts;i++,lpPoints++,lpPoints2++)
		Dist += ldistp(*lpPoints,*lpPoints2);
	return Dist;
}
                  
double ComputeProjectedAreaAreaD (HPDPOINT lpPoints,long nPnts,LPDOUBLE pPerim)
{    
	HANDLE Handle;
	HPDPOINT	lpNewPoints, lpDpoints;
	DWORD	i;
	BOOL	WantArea=TRUE; 
	DPOINT	BeginPoint, EndPoint,PickedPoint, LastPoint, PickPointW;
	double	Area=0,Perim=0;    

 	if (nPnts<3)
 		WantArea = FALSE;
 	nPnts = labs (nPnts);
    Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)nPnts*sizeof(DPOINT));
 	lpDpoints = (HPDPOINT) GlobalLock (Handle); 
 	lpNewPoints = lpDpoints;  
	for (i=0;i<nPnts;i++,lpPoints++,lpDpoints++)
	{   
		*lpDpoints = *lpPoints;
		ConvertCoord (lpDpoints,1,3);
		if (!i)
			BeginPoint = *lpDpoints;
		else  
		{
			Perim += ldistp(LastPoint,*lpDpoints);
			if (WantArea)
				Area += ( LastPoint.y - lpDpoints->y) * (lpDpoints->x + LastPoint.x) / 2;
		}
		LastPoint = *lpDpoints;
	} 
	Perim += ldistp(LastPoint,BeginPoint);  
	if (WantArea)
		Area += (LastPoint.y - BeginPoint.y) * (BeginPoint.x + LastPoint.x) / 2;  
	GSSiGlobUlFree (&Handle);
	*pPerim = Perim;
	return (Area);
} 
 
BOOL FAR PASCAL COPYVPFROMMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	
 int	TabStops[3]={87,107,120};
 struct	_find_t	FileInfo; 
 char	str[128], YorN[4],CMD[4];    
 int	i, rtn, st, iview;
 static	Choice; 
 static	HANDLE	hName=0;
 LPSTR	pName;
 int	BRtn; 
 
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
       	 SendDlgItemMessage (hWndDlg,IDC_VIEWPORTS,LB_SETTABSTOPS,3,(LPARAM)&TabStops);
		 
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDOK:
            { 
				 short	NumViews;  
				 LPVIEWPORT	CopyView, FromView;  
				 HANDLE	hViewports[MAX_VIEWPORTS];
				 LRESULT	Choice;
			
                 Choice=SendDlgItemMessage(hWndDlg,IDC_VIEWPORTS,LB_GETCURSEL,NULL,NULL);
                 if (Choice == LB_ERR)
                 	break;  
				 pName = GlobalLock (hName); 
				 NumViews = LoadCGFViewports (pName,hViewports); 
				 GlobalUnlock (hName);
				 if (!NumViews)
					break;
				 hVPToCopy = GSSiGlobAlloc (GHND,sizeof(VIEWPORT)+MAX_VIEWPORT_FILES*128);
				 CopyView = (LPVIEWPORT)GlobalLock (hVPToCopy);
				 FromView = (LPVIEWPORT)GlobalLock (hViewports[Choice]);
				 *CopyView = *FromView;
				 for (i=0;i<CopyView->NumFiles;i++)
				 {
					CopyView->lpFiles[i]=(LPSTR) &CopyView->EndOfViewport + i * 128;
					_fstrcpy (CopyView->lpFiles[i],FromView->lpFiles[i]);
				 }
				 GlobalUnlock (hViewports[Choice]);
				 for (i=0;i<NumViews;i++)    
				 	GSSiGlobFree (&hViewports[i]);
				 ClearVPFields (CopyView);   
				 GlobalUnlock (hVPToCopy);
				 GSSiGlobFree (&hName);
                 EndDialog(hWndDlg, TRUE); 
            }
            	 break;   
            	 
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
				 GSSiGlobFree (&hName);
                 EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDC_LOCCFG:
			{
				 char	title[]="Locate GeoMaster Configuration File";
				 short	CfgVersion;
				 
				 GSSiGlobFree (&hName);
				 hName = GSSiGlobAlloc (GMEM_MOVEABLE,256);
				 pName = GlobalLock (hName); 
				 OFTitle = title;
				 if (GetFileName3(hWndMain,pName,IDS_FILTERGMC,IDS_FILEGMC))   
				 {   
					SetDlgItemText (hWndDlg,IDC_FROMCFGPATH,pName);
				    SendDlgItemMessage (hWndDlg,IDC_VIEWPORTS,LB_RESETCONTENT,NULL,NULL);
					CfgVersion = GetCfgVersion (pName);
    				if (CfgVersion < 4)
    					goto BadCfg; 
					ListCGFViewports (pName,hWndDlg,IDC_VIEWPORTS);
				 }
		BadCfg:
				 GlobalUnlock (hName); 
				 break; 
			}
                 
            case IDC_VIEWPORTS: /* List box                              */
              {
                switch(HIWORD(lParam))
                    {
                     case LBN_SELCHANGE:
                     	EnableWindow (GetDlgItem(hWndDlg,IDOK),TRUE);
                     	break;
                     case LBN_DBLCLK:
				         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
				         break;
                    }
		       }
		       break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}
                
BOOL FAR PASCAL VIEWPORTSMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	
 int	TabStops[3]={87,107,120};
 struct	_find_t	FileInfo; 
 char	str[128], YorN[4],CMD[4];    
 static	BOOL	OrigStatus[MAX_VIEWPORTS];
 int	i, rtn, st, iview;
 static	short Choice=0;
 int	BRtn; 
 
 if (Message==WM_INITDIALOG)
 {  
 	InitDlgPrompts (hWndDlg);
 	SetDlgPrompt (GetDlgItem(hWndDlg,IDC_VIEWPORTS),PRMT_VPLIST,0);
 }
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
    	 HaltMapDisplay (FALSE);
   	 	 HaveBlockingWindow = TRUE;
    	 ClearDlgPrompts ();
         cwCenter(hWndDlg, 0);
		 for (iview = 0;iview<NumViewports; iview++)
		 	OrigStatus[iview] = pViewports[iview]->Active;
Redisplay:
       	 SendDlgItemMessage (hWndDlg,IDC_VIEWPORTS,LB_SETTABSTOPS,3,(LPARAM)&TabStops);
	     SendDlgItemMessage (hWndDlg,IDC_VIEWPORTS,LB_RESETCONTENT,NULL,NULL);
		 for (iview = 0;iview<NumViewports; iview++)
		 {  
		 	if (pViewports[iview]->Active)        
		 		_fstrcpy (YorN,"Yes");
		 	else
		 		YorN[0]=0;
		 	if (pViewports[iview]->ID == CommandViewport)
		 		_fstrcpy (CMD,"Cmd");
		 	else
		 		CMD[0]=0;
        	sprintf (str,"%s\t%s\t%s",pViewports[iview]->Name,CMD,YorN);
		 	SendDlgItemMessage (hWndDlg,IDC_VIEWPORTS,LB_ADDSTRING,NULL,(LPARAM)str); 
		 }
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDOK: 
                HaveBlockingWindow = FALSE;
                EndDialog(hWndDlg, TRUE);    
				PostMessage(hWndMain, WM_COMMAND, IDM_REDISPLAY, 0L);
            	 break;   
            	 
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
				 for (iview = 0;iview<NumViewports; iview++)
				 	 pViewports[iview]->Active = OrigStatus[iview];
                 HaveBlockingWindow = FALSE;
                 EndDialog(hWndDlg, FALSE);
				 PostMessage(hWndMain, WM_COMMAND, IDM_REDISPLAY, 0L);
                 break;
                 
            case IDC_VIEWPORTS: /* List box                              */
              {
                switch(HIWORD(lParam))
                    {
                     case LBN_DBLCLK:
//				         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
			    	 	 SetCurView ( pViewports[Choice]);
					{ 
						
					  FARPROC lpfnVPEDITMsgProc;
					  int	nRc;
						
					  lpfnVPEDITMsgProc = MakeProcInstance((FARPROC)VPEDITMsgProc, hInst);
					  nRc = DialogBox(hInst, (LPSTR)"VPEDIT", hWndMain,lpfnVPEDITMsgProc);
					  FreeProcInstance(lpfnVPEDITMsgProc);
					  if (nRc)
					  {  
			 			DestroySavedScreen (&CurView->Bitmap,CurView->BitmapID);
						DoPaint = TRUE;      
						RedisplayWindow();   
				        PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
					  }
					 } 
					 goto SetAct;
                     case LBN_SELCHANGE:
		                 Choice=SendDlgItemMessage(hWndDlg,IDC_VIEWPORTS,
												   LB_GETCURSEL,NULL,NULL);  
		SetAct:
			    	 	 if (pViewports[Choice]->Active)
			    	 	 	pViewports[Choice]->Active = FALSE;
			    	 	 else
			    	 	 	pViewports[Choice]->Active = TRUE; 
			    	 	 goto Redisplay;
                    }
		       }
		       break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}

HFILE GetCfgFid (LPSTR Name,LPSHORT pVersion)
{
	OFSTRUCT	OFStruct;
	HFILE		Fid;
	short		Signature;
	
	*pVersion = 0;
	Fid = GSSiOpenFile (Name,(LPOFSTRUCT)&OFStruct,OF_READ); 
	if (Fid == HFILE_ERROR)
		return Fid;
    _llseek(Fid,(LONG)-(4),2);
				
    _lread (Fid,&Signature,2);
    _lread (Fid,pVersion,2);
    if (Signature != 28052)
    {    
        MessageBox( GetFocus(), "This is not a valid configuration file",Name, MB_OK);
        goto BadFile;
    }
    if (*pVersion > 4)
    {    
        MessageBox( GetFocus(), "This configuration file version is not recognized",Name, MB_OK);
        goto BadFile;
    }
    _llseek(Fid,0,0);   
    return Fid;
    
BadFile:
    GSSiClose (Fid); 
    *pVersion = 0;
    return HFILE_ERROR;
}

short GetCfgVersion (LPSTR Name)
{
	HFILE		Fid;
	short		Version;
	
	Fid = GetCfgFid (Name,&Version); 
	if (Fid == HFILE_ERROR)
		return 0;
    GSSiClose (Fid);
    return Version;
}

BOOL ListCGFViewports (LPSTR Name,HWND hWndDlg,UINT icntl)
{   
	short	iview;
	short	NumViews;  
	LPVIEWPORT	CurView;  
	HANDLE	hViewports[MAX_VIEWPORTS];

	NumViews = LoadCGFViewports (Name,hViewports);
	if (!NumViewports)
		return FALSE;
	for (iview = 0;iview<NumViews; iview++)
	{   
		SetCurView ( (LPVIEWPORT)GlobalLock (hViewports[iview]));
	 	SendDlgItemMessage (hWndDlg,icntl,LB_ADDSTRING,NULL,(LPARAM)CurView->Name);
	 	GSSiGlobUlFree (&hViewports[iview]); 
    }

	return TRUE;
}	

short LoadCGFViewports (LPSTR Name,LPHANDLE hViewports)
{   
	LPSTR	pStr;
	short	NumIB, NumViews, CommandViewport, NumMenuMask, MenuMask, imenu, iv, len, i,Version;  
	long	WindowColor;
	LPTAGBOX	pTAGBox;
	HFILE	FidConfig; 
	HANDLE	hVisList, hTAG, hSTR;
	LPVISLIST	CurVis;
	LPVIEWPORT	CurView;
	long	ii;
	
	FidConfig = GetCfgFid (Name,&Version); 
	if (FidConfig == HFILE_ERROR)
		return 0;
    if (Version < 4)
    {
    	GSSiClose (FidConfig);
    	return 0;
    }   

    hSTR=GSSiGlobAlloc (GMEM_MOVEABLE,1024);
    pStr =(LPSTR) GlobalLock (hSTR);
    hVisList=GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(VISLIST));
    CurVis =(LPVISLIST) GlobalLock (hVisList);
    hTAG=GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(TAGBOX));
    pTAGBox =(LPTAGBOX) GlobalLock (hTAG);

    ii=_lread (FidConfig,pStr,256);
    ii=_lread (FidConfig,pStr,128);
    ii=_lread (FidConfig,&NumIB,sizeof(NumIB));  
    while (NumIB--)
    {
        _lread(FidConfig,pTAGBox,sizeof(TAGBOX));
    }  
    ii=_lread (FidConfig,&NumViews,2);
    ii=_lread (FidConfig,&CommandViewport,2); 
    ii=_lread (FidConfig,&NumMenuMask,sizeof(NumMenuMask)); 
    for (imenu=0;imenu<NumMenuMask;imenu++)
    {
        _lread (FidConfig,&MenuMask,sizeof(MenuMask));  
    }
    ii=_lread (FidConfig,&WindowColor,4);
    ii=_lread(FidConfig,pTAGBox,sizeof(TAGBOX));
    for (iv=0;iv<NumViews;iv++)
    {
        hViewports[iv]=GSSiGlobAlloc (GHND,sizeof(VIEWPORT)+MAX_VIEWPORT_FILES*128);
        CurView = GlobalLock (hViewports[iv]);
        ii=_lread (FidConfig,CurView,sizeof(VIEWPORT)); 
        ClearVPFields (CurView);  
        for (i=0;i<CurView->NumFiles;i++)
        {
            _lread (FidConfig,&len,2);
            CurView->lpFiles[i]=(LPSTR) &CurView->EndOfViewport + i * 128;
            _lread (FidConfig,CurView->lpFiles[i],len); 
        } 
        for (i=0;i<CurView->NumVisList;i++)
        {
            _lread (FidConfig,CurVis,sizeof(VISLIST));
        } 
        CurView->NumVisList = 0;
        for (i=0;i<CurView->NumPickList;i++)
        {
            _lread (FidConfig,CurVis,sizeof(VISLIST));
        } 
        CurView->NumPickList = 0;
        if (CurView->pVisListManual)
        {
            _lread (FidConfig,CurVis,sizeof(VISLIST));
        }
        CurView->pVisListManual = 0;
        if (CurView->pPickListManual)
        {
            _lread (FidConfig,CurVis,sizeof(VISLIST));
        } 
        CurView->pPickListManual = 0;
        ReadObject(FidConfig,FALSE,NULL,OB_SAVEMASK);
        if (CurView->pTheme)
        {
            ReadObject(FidConfig,FALSE,&CurView->pTheme,0);
        }
        if (CurView->BoundsDisplayID)
        {
            BoundsDisplayRead (&CurView->lpBoundsDisplay,FidConfig);
        }
		GlobalUnlock (hViewports[iv]);
   }

	GSSiClose (FidConfig);

	GSSiGlobUlFree (&hVisList);
	GSSiGlobUlFree (&hTAG);
	GSSiGlobUlFree (&hSTR);
	return NumViews;
}	

void ClearVPFields (LPVIEWPORT CurView)
{   
	CurView->lpfnFUNSTACKMsgProc = 0;
	CurView->FunStackWnd = 0;
    CurView->NumThemes=0; 
	CurView->hMaskArea = 0;
    CurView->hTranWinToBase=0; 
    CurView->hTranBaseToWin=0;
    CurView->hTAGList=0;  
    CurView->hPenRedef=0; 
    CurView->hReport=0;  
    CurView->Bitmap = CurView->BitmapID = 0;
    CurView->hBinFileList=0;
    CurView->SubFile=CurView->RestoreFile=0; 
    CurView->hCursor=CurView->LinkedCursorHandle=0;
    CurView->LastCursor=0;  
    CurView->FunStackHandle=0;   
    CurView->CurrentFunction = 0;   
    CurView->BoundsDisplayCycle = -1;
    CurView->hEditRect=0;    
    CurView->hFileTransIn=CurView->hFileTransOut=0;
    CurView->HaveEditRect=FALSE;  
    CurView->ToolbarHandle = 0;
    CurView->lpBoundsDisplay = 0;  
    CurView->hProfileRoute = 0;
    CurView->hProfileElev = 0;     
	return;
}		

BOOL ConvertPoly (LPSHORT ipnt,HANDLE hTranFrom,HANDLE hTranTo,LPSTR BeginSeg)
{	int		idesc, ItemLen, TSize, PointSize;
	long	*pRefno;
	long	remlen;
	LPBYTE	Pcode;
	int		x1,y1,x2,y2, ipen, ii;   
	HPDOUBLE	pDSize;
	HPFLOAT	pSize;
	DWORD	i;   
	WORD	nPnts;
    DPOINT	FilePointD, WorldPoint;
	static	long	StartElement=-1;
	static	short	nPoly=0, iPoly=0; 
         
         
		if (StartElement > 0)
			ipnt += StartElement;
		StartElement = -1;
        while (*ipnt != 0)
        {   Pcode = (LPBYTE)ipnt;
        	CurElementPnt = ipnt++; 
        	PointSize = 4;

		    switch (*Pcode)
	        {   
	            case 4: /* put line */
		 		{
		 			nPnts = 2;
					goto DoPolyline;
				}
	            break;

	            case 41: /* put line */
		 		{
		 			nPnts = 2;
					goto DoPolylineD;
				}
	            break;

	            case 5: /* put area */

		 		    ipen = *ipnt;
		 			ipnt++;
                
	            case 6: /* put polyline */

		 		{   nPnts = *ipnt;
		 		    ipnt++;
		 DoPolyline:lpCurPoints = (HPPOINT) ipnt;
		 
		 		    ipnt = ipnt + nPnts * 2;
					for (i=0;i<nPnts;i++,lpCurPoints++)
					{
     					FilePointD.x = lpCurPoints->x;
     					FilePointD.y = lpCurPoints->y;
					    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
						ConvertCoord(&WorldPoint,1,3);
					    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
					    lpCurPoints->x = IDNINT (FilePointD.x);
					    lpCurPoints->y = IDNINT (FilePointD.y);
					}
				}
				break;
                
	            case 51: /* put area */

		 		    ipen = *ipnt;
		 			ipnt++;
                
	            case 61: /* put polyline */

		 		{   nPnts = *ipnt;
		 		    ipnt++;
		DoPolylineD:lpDCurPoints = (HPDPOINT) ipnt;
		 
		 		    ipnt = ipnt + nPnts * 8;
					for (i=0;i<nPnts;i++,lpDCurPoints++)
					{
						ConvertCoord(lpDCurPoints,1,3);
					}
				}
				break;
                
                case 92:
				case 12: /* item minmax */
				{	
					LPMINMAX   pMinMax;
					
					pMinMax = (LPMINMAX)ipnt;  
										
					ItemSeg = CurrentSeg;
					ConvertMinMax (pMinMax,hTranFrom,hTranTo);
					nPoly = 0;    
					ipnt += 4;
					ItemLen = abs(*ipnt);
					ipnt++;
                }
                break;

		case 15: /* point symbol */
		{	
			LPINT	ipnt1=ipnt++;
			LPINT	ipnt2=ipnt++;
			
			FilePointD.x = *ipnt1;
			FilePointD.y = *ipnt2;
			PointRot = *ipnt++; 
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *ipnt1 = IDNINT (FilePointD.x);
		    *ipnt2 = IDNINT (FilePointD.y);
		}
		break;
		
/*		case 172: // HiPrecis Curve
		{
			HPDPOINT	pDPoint;
					
        	ipnt++;
			pDPoint = ipnt;ipnt+=8;
			FilePointD = *pDPoint;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *pDPoint = FilePointD;
			pDPoint = ipnt;ipnt+=8;
			FilePointD = *pDPoint;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *pDPoint = FilePointD;
			pDPoint = ipnt;ipnt+=8;
			FilePointD = *pDPoint;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *pDPoint = FilePointD;
		}
		break; */
		
        case 172:
        {
			HPDPOINT	pDPoint;
			int		st;
					
        	ipnt++;
			pDPoint = (HPDPOINT)ipnt;ipnt+=8;
			ConvertCoord(pDPoint,1,3);
			pDPoint = (HPDPOINT)ipnt;ipnt+=8;
			ConvertCoord(pDPoint,1,3);
			pDPoint = (HPDPOINT)ipnt;ipnt+=8;
			ConvertCoord(pDPoint,1,3);
		}
		break;
		
		case 16: /* line symbol */
		{	
			LPINT	ipnt1=ipnt++;
			LPINT	ipnt2=ipnt++;
			LPINT	ipnt3=ipnt++;
			LPINT	ipnt4=ipnt++;
			
			FilePointD.x = *ipnt1;
			FilePointD.y = *ipnt2;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *ipnt1 = IDNINT (FilePointD.x);
		    *ipnt2 = IDNINT (FilePointD.y);
			FilePointD.x = *ipnt3;
			FilePointD.y = *ipnt4;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    *ipnt3 = IDNINT (FilePointD.x);
		    *ipnt4 = IDNINT (FilePointD.y);
		}
		break;
		
		case 19: // graphics text
		{ 
			int		nchar;
			LPGRTEXTHEADER	pGRTextHeader;
			LPSTR	pText;  
			double	THeight;
			
		    pGRTextHeader = (LPGRTEXTHEADER)ipnt;
			THeight = GetTextHeadSize (pGRTextHeader);   
			SetTextHeadSize (pGRTextHeader,THeight*DistanceConversionFactor);
		    ipnt += sizeof(GRTEXTHEADER) / 2;  
		    nchar = pGRTextHeader->lText;  
		    ipnt += nchar/2;
		}
		break;   
		
    	case 20:	/* point symbol */   
    	{   
    		LPFLOAT	pRot;
    		
    		CurPointSize = *(LPFLOAT)ipnt; 
    		pSize = (HPFLOAT)ipnt; 
    		(*pSize) *= DistanceConversionFactor;
    		ipnt += 2; 
    		pRot = (LPFLOAT)ipnt;
    		ipnt += 2;
    		lpCurPoints = (HPPOINT)ipnt;
    		ipnt += 2;  
			FilePointD.x = lpCurPoints->x;
			FilePointD.y = lpCurPoints->y;
		    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
    		*pRot = ConvertRotation (*pRot,&WorldPoint);
    		PTRot = *pRot;
			ConvertCoord(&WorldPoint,1,3);
		    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
		    lpCurPoints->x = IDNINT (FilePointD.x);
		    lpCurPoints->y = IDNINT (FilePointD.y);
/*			if (CurPointSize < 0)
				CurPointSize = -CurPointSize *DeviceToScreenFactor;
			else
				CurPointSize /= CurView->BaseUnitsPerPixel;*/
        }
    	break;
	        	
		
    	case 120:	/* point symbol (HiPrecis)*/   
    	{   
    		LPDOUBLE	pRot;
    		
    		CurPointSize = *(LPDOUBLE)ipnt;
    		pDSize = (HPDOUBLE)ipnt; 
    		(*pDSize) *= DistanceConversionFactor;
    		ipnt += 4;
    		pRot = (LPDOUBLE)ipnt;
    		ipnt += 4;
    		lpDCurPoints = (HPDPOINT)ipnt; 
    		ipnt += 8;  
    		*pRot = ConvertRotation (*pRot,lpDCurPoints);
    		PTRot = *pRot;
			ConvertCoord(lpDCurPoints,1,3);
/*			if (CurPointSize < 0)
				CurPointSize = -CurPointSize * DeviceToScreenFactor;
			else
				CurPointSize /= CurView->BaseUnitsPerPixel; */
        }
    	break;
	        	
		case 127:
			PointSize = 16;
    	case 27: // Multipolygon indicator
    	{
    		short	n;   
       		long	PolyBufferLen;
    		
			GSSiGlobFree (&hPolyBuffer);   
    		nPoly = n = *ipnt++; 
    		iPoly = 0;
    		PolyBufferLen = nPoly - 1; // allows for linklines  
    		while (n--)
    			PolyBufferLen += *(LPWORD)ipnt++;
    		hPolyBuffer = GSSiGlobAlloc (GMEM_MOVEABLE,(long)PolyBufferLen*PointSize);
        }
        break;

    	case 33: /* jump to long rec and back */
    	{
			ContinuationOffset = *(LPLONG)ipnt; 
			ipnt += 2;    
			JumpBackSeg = CurrentSeg;
			JumpBackElement = (LPSTR)ipnt - BeginSeg;
			JumpBackElement++;
		}
		break; 
				
    	case 34: /* jump to long rec and back */
    	{
			ContinuationOffset = JumpBackSeg; 
			StartElement = JumpBackElement;
			*ipnt = 0;	
		}
		break; 

        case 35: /* point array */

 		{   nPnts = *ipnt;
 		    ipnt++;
  			lpCurPoints = (HPPOINT) ipnt;
		 
 		    ipnt = ipnt + nPnts * 2;
			for (i=0;i<nPnts;i++,lpCurPoints++)
			{
				FilePointD.x = lpCurPoints->x;
				FilePointD.y = lpCurPoints->y;
			    TRANS2 (FilePointD.x,FilePointD.y,&WorldPoint.x,&WorldPoint.y,hTranFrom);
				ConvertCoord(&WorldPoint,1,3);
			    TRANS2 (WorldPoint.x,WorldPoint.y,&FilePointD.x,&FilePointD.y,hTranTo); 
			    lpCurPoints->x = IDNINT (FilePointD.x);
			    lpCurPoints->y = IDNINT (FilePointD.y);
			}
		}
		break;
				
        case 135: /* point array */

 		{   nPnts = *ipnt;
 		    ipnt++;
			lpDCurPoints = (HPDPOINT) ipnt;		 
 		    ipnt = ipnt + nPnts * 8;
			for (i=0;i<nPnts;i++,lpDCurPoints++)
			{
				ConvertCoord(lpDCurPoints,1,3);
			}
		}
		break;
				
                default: 
                	SkipSubRec (Pcode,(HPSHORT*)&ipnt);
                break;

			}
        }
	GSSiGlobFree (&hPolyBuffer);   
	return(FALSE);
}  

void DebugShowLine (LPDPOINT p1,LPDPOINT p2)
{
	DPOINT Point[2];
	
	if (GetGlobalBVal ("[%SHOWTIN]"))
	{
	    SaveDC (CurView->hDC);
		SetDisplayMode (CurView->hDC, GF_TEXTMODE);
		CurView->hRgn = CreateVPRgn(FALSE);
	  	SelectClipRgn (CurView->hDC,CurView->hRgn);
	  	DeleteObject(CurView->hRgn);
	
		Point[0].x = p1->x;
		Point[0].y = p1->y;
		Point[1].x = p2->x;
		Point[1].y = p2->y;
		GWPolylineD (CurView->hDC,Point,2,0);  
		RestoreDC (CurView->hDC,-1);
	}
	return;
}


BOOL FAR PASCAL DISTANDDIRMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{ 	int		st, choice, n,ii;
	char	str[256],DegC[8],MinC[8],SecC[16], PreDir[4], PostDir[4]; 
	static	char	CurDist[256]="";
	static	short	CurDistUnits=0;  
	static	double	AZ;      
	static	UINT	SetVal;
	double	DEG,MIN,SEC;
	BOOL	Err, NORTH,EAST;
	LPSTR	lpTAB;   
	short	IRC; 
	double	Dist,ROT; 
	HWND	hFocus;

 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:  
    	 SetDlgItemText (hWndDlg,IDC_DISTANCE,CurDist);
         SendDlgItemMessage (hWndDlg,IDC_DISTUNITS,CB_ADDSTRING,0,(LPARAM)"Feet");
         SendDlgItemMessage (hWndDlg,IDC_DISTUNITS,CB_ADDSTRING,0,(LPARAM)"Meters");
         SendDlgItemMessage (hWndDlg,IDC_DISTUNITS,CB_ADDSTRING,0,(LPARAM)"Yards");
         SendDlgItemMessage (hWndDlg,IDC_DISTUNITS,CB_ADDSTRING,0,(LPARAM)"Miles");
         SendDlgItemMessage (hWndDlg,IDC_DISTUNITS,CB_ADDSTRING,0,(LPARAM)"Kilometers");
		 SendDlgItemMessage(hWndDlg,IDC_DISTUNITS,CB_SETCURSEL,CurDistUnits,NULL); 
         AZ = CurrentAZ;
         PostMessage(hWndDlg, WM_COMMAND, IDC_ROT0, 0L); 
         SetVal = 0;
    case GSSI_REINITDIALOG:  
    	 if (SetVal != 1)
    	 {   
	    	 AZToBear (AZ,PreDir,DegC,MinC,SecC,PostDir);
	    	 SetDlgItemText (hWndDlg,IDC_PREDIR,PreDir);
	    	 SetDlgItemText (hWndDlg,IDC_BDEG,DegC);
	    	 SetDlgItemText (hWndDlg,IDC_BMIN,MinC);
	    	 SetDlgItemText (hWndDlg,IDC_BSEC,SecC);
	    	 SetDlgItemText (hWndDlg,IDC_POSTDIR,PostDir);
	     }
	     if (SetVal != 2)
	     {
	    	 AZToAZIM (AZ,DegC,MinC,SecC);
	    	 SetDlgItemText (hWndDlg,IDC_ADEG,DegC);
	    	 SetDlgItemText (hWndDlg,IDC_AMIN,MinC);
	    	 SetDlgItemText (hWndDlg,IDC_ASEC,SecC);  
	     }
		 break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND: 
    	 if (!SetVal)
    	 {
	    	 hFocus = GetFocus ();
	    	 if (hFocus == GetDlgItem (hWndDlg,IDC_PREDIR) ||
	    	 	 hFocus == GetDlgItem (hWndDlg,IDC_POSTDIR))
	    	 	SetVal = 1;
	     }
         switch(wParam)
           { 
            case IDC_BDEG:
            case IDC_BMIN:
            case IDC_BSEC: 
            case IDC_PREDIR:
            case IDC_POSTDIR:  
                 switch (HIWORD(lParam))
                 {      
                 		case EN_SETFOCUS:
	            		SetVal = 1;  
	            		goto xx;
                 		case EN_CHANGE:  
                 			ii=1;
	            		case EN_KILLFOCUS:
	            	xx:
                 		if (!SetVal || SetVal == 2)
                 			break;
                        GetDlgItemText (hWndDlg,IDC_PREDIR,str,2);
                        switch (*str)
                        {
                        	case 'n': 
                        		SetDlgItemText (hWndDlg,IDC_PREDIR,"N");
                        	case 'N':
                        		NORTH = TRUE;
                        		break;
                        	case 's':
                        		SetDlgItemText (hWndDlg,IDC_PREDIR,"S");
                        	case 'S':
                        		NORTH = FALSE;
                        		break;
                        	default:
                				Sound (BAD_SOUND);
                				SetVal = 0;
								PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
                        		return TRUE;
                        }
                        GetDlgItemText (hWndDlg,IDC_POSTDIR,str,2);
                        switch (*str)
                        {   
                        	case 'e':
                        		SetDlgItemText (hWndDlg,IDC_POSTDIR,"E");
                        	case 'E':
                        		EAST = TRUE;
                        		break;
                        	case 'w':
                        		SetDlgItemText (hWndDlg,IDC_POSTDIR,"W");
                        	case 'W':
                        		EAST = FALSE;
                        		break;
                        	default:
                				Sound (BAD_SOUND);
                				SetVal = 0;
								PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
                        		return TRUE;
                        }
                        DEG = GetDlgItemInt (hWndDlg,IDC_BDEG,&Err,FALSE);
                        MIN = GetDlgItemInt (hWndDlg,IDC_BMIN,&Err,FALSE); 
                        GetDlgItemText (hWndDlg,IDC_BSEC,str,14);
                        SEC = atof (str);
						AZ = DEG + MIN / 60E0 + SEC / 3600E0;
						if (NORTH && EAST)
							AZ+=0;
						else if (NORTH && !EAST)
						  AZ = 360E0 - AZ; 
						else if (!NORTH && EAST)
						  AZ = 180E0 - AZ; 
						else if (!NORTH && !EAST) 
						  AZ = 180E0 + AZ;
						AZ *= RADDEG; 
						AZ = LTWOPI(HALFPI-AZ);
						PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
                        break;
                 }
                 break;
            
            case IDC_ADEG:
            case IDC_AMIN:
            case IDC_ASEC:   
                 switch (HIWORD(lParam))
                 {  
                 	case EN_SETFOCUS:
            	 		SetVal = 2;
            	 	case EN_CHANGE:
                 	case EN_KILLFOCUS: 
                 		if (!SetVal || SetVal == 1)
                 			break;
                        DEG = GetDlgItemInt (hWndDlg,IDC_ADEG,&Err,FALSE);
                        MIN = GetDlgItemInt (hWndDlg,IDC_AMIN,&Err,FALSE); 
                        GetDlgItemText (hWndDlg,IDC_ASEC,str,14);
                        SEC = atof (str);
						AZ = DEG + MIN / 60E0 + SEC / 3600E0;
						AZ *= RADDEG; 
						AZ = LTWOPI(HALFPI-AZ);
						PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
                        break;
                 }
                 break;
            
            case IDC_ROT0:
            	SetDlgItemText (hWndDlg,IDC_RDEG,"0");
            	goto ZeroMS;
            case IDC_ROTP90:
            	SetDlgItemText (hWndDlg,IDC_RDEG,"90");
            	goto ZeroMS;
            case IDC_ROTM90:
            	SetDlgItemText (hWndDlg,IDC_RDEG,"-90");
            	goto ZeroMS;
            case IDC_ROT180:
            	SetDlgItemText (hWndDlg,IDC_RDEG,"180");
     ZeroMS:
            	SetDlgItemText (hWndDlg,IDC_RMIN,"0");
            	SetDlgItemText (hWndDlg,IDC_RSEC,"0.0000");  
            	break;
		 	case IDOK: 
		        PostMessage(hWndDlg, WM_COMMAND, IDC_OK, 0L); //allows changes to be made to 
		        											  // az and bearing vals before reading
		        break;
		        
		    case IDC_OK:
                DEG = GetDlgItemInt (hWndDlg,IDC_ADEG,&Err,FALSE);
                MIN = GetDlgItemInt (hWndDlg,IDC_AMIN,&Err,FALSE); 
                GetDlgItemText (hWndDlg,IDC_ASEC,str,14);
                SEC = atof (str);
				AZ = DEG + MIN / 60E0 + SEC / 3600E0;
				AZ *= RADDEG; 
				AZ = LTWOPI(HALFPI-AZ);
                DEG = (int)GetDlgItemInt (hWndDlg,IDC_RDEG,&Err,TRUE);
                MIN = GetDlgItemInt (hWndDlg,IDC_RMIN,&Err,FALSE); 
                GetDlgItemText (hWndDlg,IDC_RSEC,str,14);
                SEC = atof (str);
				ROT = DEG + MIN / 60E0 + SEC / 3600E0;
				ROT *= RADDEG; 
			    CurDistUnits=SendDlgItemMessage(hWndDlg,IDC_DISTUNITS,CB_GETCURSEL,NULL,NULL); 
			    GetDlgItemText (hWndDlg,IDC_DISTANCE,CurDist,sizeof(CurDist));
			    Dist = FltAP (CurDist,&IRC);
			    if (IRC)
			    {
			    	break;
			    }
				Dist = ConvertInDist (Dist,CurDistUnits+1);
				PandDPoint = dnewpt (CurrentPoint,AZ-ROT,Dist);
	       		EndDialog(hWndDlg, TRUE);
		 	    break;   
		 	     
            case IDCANCEL:
                 EndDialog(hWndDlg, FALSE);
                 break;
           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}  

void PolylineINV (HDC hDC,LPPOINT P,short n)
{   
	UINT	i;
	POINT	PINV[10];
	
	for (i=0;i<n;i++)
	{
		PINV[i] = P[i];
		PINV[i].y = 30 - PINV[i].y;  
	}
	Polyline (hDC,PINV,n);
	return;
}

BOOL AddToSpecialCursorList (hCurs)
{
	UINT	i;
	
	for (i=0;i<nSpecialCursors;i++)
		if (hCurs == SpecCursors[i])
			return FALSE; 
	if (nSpecialCursors == 32)
		return FALSE;
	SpecCursors[nSpecialCursors++] = hCurs;
	return TRUE;
}

BOOL InSpecialCursorList (hCurs)
{
	UINT	i;
	
	for (i=0;i<nSpecialCursors;i++)
		if (hCurs == SpecCursors[i])
			return TRUE;
	return FALSE;
}

void CreateDigCursor (HDC hDC)
{   
    HDC			hdcMem;
    HBITMAP		hbmPrev, hNewBM;  
    HPEN		OldPen, WidePen;
    POINT		P[4];  
    DPOINT		p[3];
    RECT		Rect;  
    HCURSOR		hCur,hNewDigCursor=0;   
    static		hDebugCurs=0;
    BOOL		DigIsCurCursor;
    UINT		i,ii; 
    BITMAP		bm; 
    COLORREF	WideColor = 0, BGColor = RGB(255,255,255);  
    BYTE		bits1[128],bits2[128], allon=255;   
    double		AZ;  
    short		Pass=0, NumPass=0, Width=1;
    char		str[128];
    
    if (!CursorIsLocked && GetGlobalCVal ("[%DIGCURSOR]",str,NULL))
    {
	    hNewDigCursor = LoadCursor (hInst,str); 
	    AddToSpecialCursorList (hNewDigCursor);
	}
	if (!hNewDigCursor)
	{
		hdcMem = CreateCompatibleDC(hDC);
		hNewBM = CreateBitmap(32,32,1,1,NULL);
	    if (GetGlobalBVal ("[%WIDECURSOR]"))
	    {
	    	WideColor = RGB(255,255,255); 
	    	BGColor = 0;
	    	Width=3; 
	    	NumPass = 3;
	    }
	    Rect.left=Rect.top=0;
	    Rect.right=Rect.bottom=31;
		_fmemset (bits2,0,128);    
		WidePen = CreatePen (PS_SOLID,Width,WideColor);
	NextPass:
	    hbmPrev = SelectObject (hdcMem,hNewBM); 
	    switch (Pass)
	    {
	    	case 0: 
	    		if (NumPass)
	    		{
				    FillRectPoly (hdcMem,&Rect,RGB(255,255,255)); 
		    		OldPen = SelectObject (hdcMem,GetStockObject (BLACK_PEN)); 
		    	}
		    	else
	    		{
				    FillRectPoly (hdcMem,&Rect,0); 
		    		OldPen = SelectObject (hdcMem,GetStockObject (WHITE_PEN)); 
		    	}
	    		break;
	    	case 1:
			    FillRectPoly (hdcMem,&Rect,BGColor); 
	    		OldPen = SelectObject (hdcMem,WidePen);
	    		break;
	    	case 2:   
	    		OldPen = SelectObject (hdcMem,GetStockObject (BLACK_PEN));
	    		break; 
	    }
	    P[0].x=P[0].y=15; 
	    CurrentAZ = LTWOPI (CurrentAZ);
	    P[1]=newpt(P[0],CurrentAZ,15);
	    PolylineINV (hdcMem,P,2);
	    P[3]=P[2]=newpt(P[1],CurrentAZ+HALFPI+HALFPI/2,5);
	    PolylineINV (hdcMem,&P[1],2);
	    P[2]=newpt(P[1],CurrentAZ-HALFPI-HALFPI/2,5);
	    PolylineINV (hdcMem,&P[1],2);   
	    if (AZLocked)
	    	PolylineINV (hdcMem,&P[2],2);
	    P[1]=newpt(P[0],CurrentAZ+HALFPI,15);
	    PolylineINV (hdcMem,P,2);
	    P[1]=newpt(P[0],CurrentAZ+PY,15);
	    PolylineINV (hdcMem,P,2);
	    P[1]=newpt(P[0],CurrentAZ+HALFPI*3,15);
	    PolylineINV (hdcMem,P,2);  
	    if (CursorIsLocked)
	    {   
	    	for (i=0;i<4;i++)
	    	{   
	    		AZ=CurrentAZ+(i*HALFPI)+HALFPI/2;
			    P[1]=newpt(P[0],AZ,3);
			    P[2]=newpt(P[1],AZ,8);
			    PolylineINV (hdcMem,&P[1],2);
			    P[2]=newpt(P[1],AZ-HALFPI/2,4);
			    PolylineINV (hdcMem,&P[1],2);
			    P[2]=newpt(P[1],AZ+HALFPI/2,4);
			    PolylineINV (hdcMem,&P[1],2);
			}
	    }
	    SelectObject (hdcMem,hbmPrev);  
	    SelectObject (hdcMem,OldPen);
	    GetObject(hNewBM, sizeof(BITMAP), (LPSTR) &bm);
	    switch (Pass)
	    {
	    	case 0:
			    GetBitmapBits (hNewBM,(bm.bmWidthBytes * bm.bmHeight),&bits1);  
			    if (!NumPass)  
			    {
			    	_fmemset (bits2,allon,sizeof(bits2));
			    	break;                               
			    }
	    	case 1:
	    		Pass++;
	    		if (Pass < 2 || Width > 1)
	    			goto NextPass; 
	    	case 2:
	    		GetBitmapBits (hNewBM,(bm.bmWidthBytes * bm.bmHeight),&bits2); 
	    }
	    DeleteDC (hdcMem); 
	    DeleteObject (hNewBM); 
	    DeleteObject (WidePen);
	}
    hCur = GSSiSetCursor (LoadCursor(NULL, IDC_ARROW));     
    DigIsCurCursor = (hCur == hDigCursor) && hCur;
    if (DigIsCurCursor)
    {   
    	if (hDigCursor && (hDigCursor != hNewDigCursor))
    	{
    		short ii =1;
    		
    		if (!InSpecialCursorList (hDigCursor))
    			ii=DestroyCursor (hDigCursor);
    		if (!ii)
    			ii=1;    
    		hDigCursor = 0;
    	}
    	if (hNewDigCursor)
    		hDigCursor = hNewDigCursor;
    	else if (Width > 1)
	    	hDigCursor = CreateCursor (hInst,15,15,32,32,bits1,bits2);  
    	else
	    	hDigCursor = CreateCursor (hInst,15,15,32,32,bits2,bits1);  
    	SetCurs (2,FALSE);
       	PostMessage(hWndMain, WM_SETCURSOR, 0, 0L);
    }
    else
    {   
    	if (hDigCursor && (hDigCursor != hNewDigCursor))
    	{
    		short ii=1; 
    		if (!InSpecialCursorList (hDigCursor))
    			ii=DestroyCursor (hDigCursor);
    		if (!ii)
    			ii=1;
    		hDigCursor = 0;
    	}
    	if (hNewDigCursor)
    		hDigCursor = hNewDigCursor;
    	else if (Width > 1)
	    	hDigCursor = CreateCursor (hInst,15,15,32,32,bits1,bits2);  
    	else
	    	hDigCursor = CreateCursor (hInst,15,15,32,32,bits2,bits1);  
//    	if (!LoadCursor (hInst,hCur))
//    		ii=1;
    }
    	
	return;
}

BOOL PickCurve (HPDPOINT lpPointsIn,long nPnts,LPDPOINT PC,LPDPOINT POC, LPDPOINT PT)
{
	DPOINT	BeginPoint, EndPoint, PickedPoint,NodePoint, WPoint, LastWPoint, NearPoint; 
	HPDPOINT lpPoints = lpPointsIn;
	POINT	BeginPointFile, EndPointFile, PickedPointFile;
	DWORD	i, mini;
	double	PCT, OffDist, TotDistW, AZ[3], MinDist, Dist, AZAdjust;
	BOOL	First=TRUE, rtn=FALSE;   
	MNMXCORD	Rect;    
	short	st;

	if (PickNET)
	{
		if (!RefInNet (CurrentRefno))
			return FALSE;
	}
	st = RCURVE(&PC->x,&PC->y,&POC->x,&POC->y,&PT->x,&PT->y,&CurRP.x,&CurRP.y,&CurCLEN); 
    if (hHighlightArea)
    	return (PickPolyInAreaD(1,lpPoints,nPnts,0,0));
	
	TotDistW=0;   
	BeginPoint = *lpPoints; 
	if (CurCLEN < 0)
		AZAdjust = HALFPI;
	else
		AZAdjust = -HALFPI; 
	AZ[0] = LTWOPI(getazd (&CurRP,PC)+AZAdjust);
	AZ[2] = LTWOPI(getazd (&CurRP,PT)+AZAdjust);
	MinDist = DBL_MAX;
	DBoundsInit (&Rect);
	for (i=0;i<nPnts;i++,lpPoints++)
	{   
		AddDPointToMinMax (lpPoints,&Rect);
		WPoint = *lpPoints;
		if (!First) 
			TotDistW += ldistp(LastWPoint,WPoint);
		else
			First = FALSE;
		LastWPoint = WPoint;  
		Dist = ldistp (PickPointBase,WPoint);
		if (Dist < MinDist)
		{
			MinDist = Dist;
			NearPoint = WPoint;
			mini = i;
		}
	}
	EndPoint = LastWPoint;
    if (PickingByRefno)
    {
    	PCT = 0.5;
    	OffDist = 0;
    	goto Add;
    }
	if (!LineInBoundsD (nPnts,lpPointsIn,TotDistW,&PCT,&OffDist,&AZ[1],
					    &CurView->WBounds,&PickedPoint)) goto Exit;
    if (WantOnlyShapePoints) 
	   	PickedPoint = NearPoint; 
	for (i=0; i<NumPicked; i++)
	{
		if (CurrentRefno == PickList[i].Refno)
		{
			if (fabs(OffDist)<fabs(PickList[i].OffDist))
				PickListDelete((short)i);
			else
				goto Exit;
		}
	} 
Add: 
	rtn = TRUE;  
//	if (!PickingByRefno)
//		PickedPointFile = BasePtToFilePt (PickedPoint);
	PickListAdd (FileNum,SubFile,FileInIndex,ItemSeg,CurrentRefno,CurrentDesc,CurrentiPen,
				   GF_CURVE,PCT,OffDist,AZ,fabs(CurCLEN),CurrentItem,CurElement,
				   *PC,*PT,PickedPoint,*POC,mini,0,&Rect,
				   BeginPointFile, EndPointFile,PickedPointFile,nPnts,NULL_ELEV);
Exit:
	return (rtn);
} 

