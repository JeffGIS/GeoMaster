	    SetViewport (PickList[Item].ViewID);
		pTheme = AddTheme (GF_SAVEPOLY_THEME);
		CurView->PassID = 2; 
		ProcessSelectedTheme = CurView->NumThemes;
		ProcessPickedItem (Item,FALSE); 
		ProcessSelectedTheme = 0;       		
		DeleteTheme (pTheme);
   		while (GetSavedPolys ())
		if (hSavePoly)
		{   LPMNMXCORD lpRect;
	    		
	        nPnts = nSavePoly; 
	        lpRect = (LPMNMXCORD) GlobalLock (hSavePoly);
	        lpRect++;
	        lpDpoint = (LPDPOINT) lpRect;
			AddAreaToOffsetFile (nPnts, lpDpoint);
			GSSiGlobUlFree (&hSavePoly);
		} 
		return TRUE;
	}
	return FALSE;
} 

BOOL PolyInMaskAreaFileCoord (short Type,LPLONG pnPnts,LPHANDLE phCoords,HPPOINT *plpPolyPoints,HPDPOINT *plpDPolyPoints,BOOL HiPrecis)
{
	LPMNMXCORD	lpRect; 
	HPDPOINT lpDpoints, pPolyPointsD; 
	HPPOINT	pPolyPoints=*plpPolyPoints;
	BOOL	rtn=FALSE;
	DPOINT	DPoint;
	HANDLE	Handle=0; 
	UINT	i,nIn;
	short	nInt; 
	
    if (!CurView->hMaskArea || !MaskOffsetLine)
    	return TRUE;
	if (!ComputePCTTheme && (IgnoreBounds || InclusionOpt == 3 || BleedThrough))
		return TRUE; 
	if (HiPrecis)
		pPolyPointsD = *plpDPolyPoints;
	else
	{
	    Handle = GSSiGlobAlloc (GMEM_MOVEABLE,(long)*pnPnts*sizeof(DPOINT));
	 	pPolyPointsD = (HPDPOINT) GlobalLock (Handle); 
		for (i=0;i<*pnPnts;i++,pPolyPoints++,pPolyPointsD++)
		{   
			*pPolyPointsD = FilePtToBasePt (*pPolyPoints);
		}
		GlobalUnlock (Handle);
	 	pPolyPointsD = (HPDPOINT) GlobalLock (Handle);
	}
	lpRect = (LPMNMXCORD) GlobalLock (CurView->hMaskArea);
    lpRect++;
    lpDpoints = (LPDPOINT) lpRect;  
 	rtn = PolyInArea (Type,*pnPnts,pPolyPointsD,CurView->NumMaskPoints,lpDpoints,InclusionOpt);    
	GlobalUnlock (CurView->hMaskArea); 
	GSSiGlobUlFree (&Handle);
	return rtn;
}

BOOL PointInMaskAreaWinCoord (POINT Point)
{
	LPMNMXCORD	lpRect; 
	HPDPOINT lpDpoints; 
	POINT	BadPointWin;
	BOOL	rtn;
	DPOINT	DPoint, BadPoint; 

	if (!CurView->hMaskArea || !MaskOffsetLine || IgnoreBounds)
		return TRUE;
	lpRect = (LPMNMXCORD) GlobalLock (CurView->hMaskArea);
    lpRect++;
    lpDpoints = (LPDPOINT) lpRect;  
	DPoint = WinPtToBasePt (Point);
	rtn = POINT_IN_AREAD (DPoint,CurView->NumMaskPoints,lpDpoints,NULL);
	if (!rtn && GetGlobalPVal ("[%BADCOORDPOINT]",NULL,&BadPoint))
	{
		if (GetGlobalBVal2 ("[%WANTBADPOINTS]",FALSE))
		{    
			BadPointWin = BasePtToWinPt (&BadPoint);
			if (idist (Point,BadPointWin) < 2)
				rtn = TRUE;
		}
	}
	GlobalUnlock (CurView->hMaskArea);
	return rtn;
}  

BOOL PointInMaskAreaWinCoordD (LPDPOINT pDPoint)
{
	LPMNMXCORD	lpRect; 
	HPDPOINT lpDpoints; 
	BOOL	rtn;
	DPOINT	DPoint; 

	if (!CurView->hMaskArea)
		return TRUE;
	lpRect = (LPMNMXCORD) GlobalLock (CurView->hMaskArea);
    lpRect++;
    lpDpoints = (LPDPOINT) lpRect;  
	rtn = POINT_IN_AREAD (*pDPoint,CurView->NumMaskPoints,lpDpoints,NULL); 
	GlobalUnlock (CurView->hMaskArea);
	return rtn;
}  

BOOL PolyInArea (short Type,long nPolyPoints,HPDPOINT pPolyPointsD,long nAreaPoints,HPDPOINT pAreaPoints,short InclusionOpt)
{
	short	nInt;
	DWORD	i;
	HPDPOINT	pPolyPointsDInit=pPolyPointsD;
	BOOL	rtn=FALSE, HaveIn=FALSE, HaveOut=FALSE;
	
 	nInt=0;
	for (i=0;i<nPolyPoints;i++,pPolyPointsD++)
	{
		if (POINT_IN_AREAD (*pPolyPointsD,nAreaPoints,pAreaPoints,NULL))
		{
			HaveIn = TRUE;
			switch (InclusionOpt)
			{   
				default:
				case 0: // both partial and total
					rtn=TRUE;
					goto Done;
				case 1: // total only
					break;
				case 2: // partial only
					if (HaveOut)
					{
						rtn=TRUE;
						goto Done;
					}
					break;
			}
		}
		else
		{
			HaveOut = TRUE;
			switch (InclusionOpt)
			{   
				default:
				case 0: // both partial and total
					if (HaveIn)
					{
						rtn=TRUE;
						goto Done;
					}
					break;
				case 1: // total only 	
					goto Done;
				case 2: // partial only
					if (HaveIn)
					{
						rtn=TRUE;
						goto Done;
					}
					break;
			}  
		}
	} 
	nInt = IntersectPolys1 (Type,nPolyPoints,pPolyPointsDInit,nAreaPoints,pAreaPoints,NULL,NULL); 
	if (nInt)
	{   
		if (InclusionOpt != 1)
			rtn = TRUE;
		goto Done;
	}
	if (HaveIn && InclusionOpt == 1)
	{
		rtn = TRUE;
		goto Done;
	}
	if (Type != GF_AREA)
		goto Done;
	if (POINT_IN_AREAD (*pAreaPoints,nPolyPoints,pPolyPointsDInit,NULL))
		rtn = TRUE;
Done:
	return rtn;
}

BOOL AdjustFileBounds (short VPID, short FileNo, LPMNMXCORD FileBounds, LPSTR IndexEntryName)
{   
	DPOINT	DPoint; 
	
	if (FileBounds->xmn > FileBounds->xmx || FileBounds->ymn > FileBounds->ymx)
		return FALSE;
	if (FileNo == ConvertLayer)
	{ 
		DPoint.x = FileBounds->xmn;
		DPoint.y = FileBounds->ymn;
		if (ConvertCoord (&DPoint,3,1))
			return FALSE;
		FileBounds->xmn = DPoint.x;
		FileBounds->ymn = DPoint.y;
		DPoint.x = FileBounds->xmx;
		DPoint.y = FileBounds->ymx;
		if (ConvertCoord (&DPoint,3,1))
			return FALSE;
		FileBounds->xmx = DPoint.x;
		FileBounds->ymx = DPoint.y;
	}
    else if (OrthoAdjustVP == VPID && OrthoAdjustFile == FileNo) 
    {
		if (IndexEntryName)
		{
			if (*PickedOrthoName)
			{   
				HANDLE	hName=GSSiGlobAlloc (GMEM_MOVEABLE,128);
				LPSTR	pName = GlobalLock (hName), lpChr; 
				short	i;
				
				_fstrcpy (pName,IndexEntryName);
				if ((lpChr = _fstrchr (pName,':')))
					*lpChr=0;
				else if ((lpChr = _fstrrchr (pName,'.')))
					*lpChr=0;
				i = _fstricmp (PickedOrthoName,pName);	
	    		GSSiGlobUlFree (&hName);
				if (i)
					return TRUE;
			}
    		AdjustBounds (FileBounds,OrthoAdjustX,OrthoAdjustY);
	    Exit:
	    	return TRUE;
	    } 
        else
        {
	        FileBounds->xmn = -DBL_MAX;
	        FileBounds->xmx = DBL_MAX;
	        FileBounds->ymn = -DBL_MAX;
	        FileBounds->ymx = DBL_MAX;
	    } 
    }
	return TRUE;
}
void AdjustMapControlPoints (short VPID, short FileNo, LPDOUBLE XBASE, LPDOUBLE YBASE)
{
    short i;
    
    if (ConvertMapVP == VPID && ConvertMapFileNo == FileNo) 
    {
		for (i=0;i<4;i++)
		{	
			DPOINT	Point;
			
			Point.x = XBASE[i];
			Point.y = YBASE[i];
			ComputeNewMapControlPoint (&Point);
	        XBASE[i] = Point.x;
	        YBASE[i] = Point.y;                      
	    }
	}
    else if (OrthoAdjustVP == VPID && OrthoAdjustFile == FileNo) 
    {   
		for (i=0;i<4;i++)
		{	
	    	XBASE[i]+=OrthoAdjustX;
	    	YBASE[i]+=OrthoAdjustY;
	    }
	} 
    return;
}

BOOL PointsFromHLT (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{  
 char key;
 long			Radius;  
 POINT	MousePoint;
 
 switch (Message)
   {
   	case GF_INIT:  
       	AddLBUTTON = FALSE;
		PostMessage(hWnd, GF_EXECUTE,0, 0L); 
   		break;
   	
   	case GF_EXECUTE:	
    {   
    	long	EndSeq;
		hNewPolyPoints = GetConnectedItems (0,&EndSeq,&NumNewPolyPoints);
	    PostMessage(hWnd, GF_CLOSE,0, 0L);
	} 
		break;
    default:
