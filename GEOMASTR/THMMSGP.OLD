	pName = GlobalLock (CurTheme->hDisperseFileName);
	CurTheme->hDisperseFile = BT_OPEN (pName, 0, mode, 0); 
	if (mode == BT_WRITE)
		BT_CLEAR (CurTheme->hDisperseFile);
	GlobalUnlock (CurTheme->hDisperseFileName);
	return TRUE;
}
