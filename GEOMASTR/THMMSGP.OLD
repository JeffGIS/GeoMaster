BOOL DisplayProfileLoc (LPPOINT pWinPoint,LPDPOINT BasePoint,LPVIEWPORT pVP)
{   
	static	POINT	LastLine[2];
	static	LPVIEWPORT	LastVP=0; 
	LPVIEWPORT	SaveVP=CurView;  
	short	OldMode; 
	HPEN	hPen, hOldPen;  
	double	LastDist;
	
	if (LastVP)
	{ 
		SaveDC (CurView->hDC);
	    SetDisplayMode (CurView->hDC,GF_TEXTMODE);
	    SelectClipRgn (CurView->hDC,0);
		SetCurView (LastVP);
		OldMode = SetROP2(CurView->hDC,R2_NOT);
		hPen = CreatePen (PS_SOLID,0,RGB(255,0,0));
		hOldPen = SelectObject (CurView->hDC,hPen);
		Polyline (CurView->hDC,LastLine,2);  
		SelectObject (CurView->hDC,hOldPen);
		DeleteObject (hPen);
    	SetROP2(CurView->hDC,OldMode);
		SetCurView (SaveVP);
		RestoreDC (CurView->hDC,-1);  
	}                        
	LastVP = pVP;
	if (!pVP)
		return FALSE;
	if (BasePoint->x < 0)
	{
		LastVP = 0;
		return FALSE;
	}
	if (pVP->hProfileElev)
	{
		LPDPOINT	pProfile = (LPDPOINT)GlobalLock(pVP->hProfileElev);
		pProfile += (pVP->nProfileElev-1);
		LastDist = pProfile->x;
		GlobalUnlock (pVP->hProfileElev);
		if (BasePoint->x > LastDist)  
		{
			LastVP = 0;
			return FALSE;
		}
	}
	SaveDC (CurView->hDC);
    SetDisplayMode (CurView->hDC,GF_TEXTMODE);
    SelectClipRgn (CurView->hDC,0);
	SetCurView (pVP); 
	LastLine[0].x = pWinPoint->x;
	LastLine[1].x = pWinPoint->x;
	LastLine[0].y = CurView->DrawRect.bottom;
	LastLine[1].y = CurView->DrawRect.top;
	OldMode = SetROP2(CurView->hDC,R2_NOT);
	hPen = CreatePen (PS_SOLID,0,RGB(255,0,0));
	hOldPen = SelectObject (CurView->hDC,hPen);
	Polyline (CurView->hDC,LastLine,2);  
	SelectObject (CurView->hDC,hOldPen);
	DeleteObject (hPen);
   	SetROP2(CurView->hDC,OldMode);
	SetCurView (SaveVP);
	RestoreDC (CurView->hDC,-1);  
	return TRUE;
}  

BOOL GetProfileElevAndSlope (double Dist,HANDLE hProfile,long nProfile,LPDOUBLE Elev, LPDOUBLE Slope)
{
	LPDPOINT pProfile;
	DWORD	i; 
	double	LastElev, LastDist, inc;
	
	if (!hProfile || Dist < 0)
		return FALSE;
	
	pProfile = (LPDPOINT)GlobalLock (hProfile);
	for (i = 0;i < nProfile;i++,pProfile++)
	{
		if (pProfile->x > Dist)
		{             
			inc = (Dist - LastDist)/(pProfile->x - LastDist);
			*Elev =  (LastElev + (pProfile->y - LastElev) * inc) * MFT;
			*Slope = 100 * (pProfile->y - LastElev)/(pProfile->x - LastDist);
			GlobalUnlock (hProfile);
			return TRUE;
		} 
		LastElev = pProfile->y;
		LastDist = pProfile->x;
	}
	GlobalUnlock (hProfile);
	return FALSE;
} 

void SetupHotSpotMask (short MaskWidth,HANDLE hMask,short DecayOpt)
{   
	LPSHORT pMask=(LPSHORT)GlobalLock (hMask);
	double	d; 
	double	HalfMaskWidth= MaskWidth/2;
	POINT	MidPoint={HalfMaskWidth,HalfMaskWidth}, p;
	
	switch (DecayOpt)
	{                     
		case 1:
			HalfMaskWidth =  sqrt (HalfMaskWidth);
			break;  
		case 2:
			HalfMaskWidth =  HalfMaskWidth * HalfMaskWidth;  
			break;
	}
	p.y = 0;
	while (p.y < MaskWidth)
	{
		p.x = 0;
		while (p.x < MaskWidth)
		{   
			d = idist (p,MidPoint);
			switch (DecayOpt)
			{                     
				case 1:
					d = sqrt(d);
					break; 
				case 2:
					d = d * d;
					break; 
				case 3:
					d = 0;
					break;
			}
			*pMask++ = max (0,IDNINT(((HalfMaskWidth - d) / HalfMaskWidth) * 1000));  
			p.x++;
		}
		p.y++;
	}
	GlobalUnlock (hMask);
	return;
}


BOOL ThemeNeedsDataPass (void)
{	BTVARDESC	BTVar[3];
	int	i;
	OFSTRUCT	OFStruct; 
	char		str[128];
    
    if (CurTheme->DisplayViewport && CurTheme->DisplayViewport <= NumViewports)
    	CurTheme->VPDisplayed = pViewports[CurTheme->DisplayViewport-1]->Active;
	if (!CurTheme->VPDisplayed || !CurTheme->IsActive ||
		 CurTheme->ID == PF_COORD_DISPLAY || CurTheme->ID == PF_BOUNDS_DISPLAY)
		return (FALSE);
	if (CurTheme->PCTByArea && CurTheme->PCTDisplayCycle != DisplayCycle)
		ComputePCTTheme = CurTheme;	                                     
	else
		ComputePCTTheme = 0;	                                     
	if (!CurTheme->WantDataPass)
		return FALSE;
	if (!CurTheme->Recompute && CurTheme->NumClass)
		return (FALSE);
	if (*CurTheme->RefValChar)
	{
		_fstrcpy (str,CurTheme->RefValChar);
		ExpandText (str);  
		CurTheme->RefValDbl = atof (str);
	}
	CurTheme->Xmin = DBL_MAX;
	CurTheme->Xmax = -DBL_MAX;
	if (CurTheme->ZeroBased)
		CurTheme->Ymin = 0;
	else
		CurTheme->Ymin = DBL_MAX;
	CurTheme->Ymax = -DBL_MAX;
	CurTheme->NumVals = 0;
	if (CurTheme->SymNum > 0)
		CurTheme->hVisList = SetThemeVisList (CurTheme->SymNum);
	if (CurTheme->ID == GF_HOTSPOT_THEME)
	{   
		LPHOTSPOTDATA	pHSData = &CurTheme->HotSpotData;
		double dw, shrinkfactor=1;
		LPVIEWPORT	SaveVP = CurView; 
		long	GridSize;
	    double  BASEX[4], BASEY[4], HSX[4], HSY[4];  
	    double	BaseDToWinD=1, d1, d2;
	    DPOINT	dp1, dp2;
	    float	RSQMIN;
		
		GSSiGlobUlFree (&pHSData->hGrid);
		GSSiGlobUlFree (&pHSData->hMask);
		CloseTRANS2 (&pHSData->hTranBaseToHotSpot);
        
        dp1.x = CurView->WBounds.xmn;
        dp1.y = CurView->WBounds.ymn;
        dp2.x = CurView->WBounds.xmx;
        dp2.y = CurView->WBounds.ymx;
        d1 = ldistp (dp1,dp2);
        dp1.x = CurView->DrawRect.left;
        dp1.y = CurView->DrawRect.right;
        dp2.x = CurView->DrawRect.top;
        dp2.y = CurView->DrawRect.bottom;
        d2 = ldistp (dp1,dp2);
        if (d1)
        	BaseDToWinD = d2/d1;
        
		SetViewport (CurTheme->TargetViewport);   
		dw = BaseDToWinD * pHSData->Radius;
		if (dw > 128)
			shrinkfactor = dw / 128;
		pHSData->MaskWidth = IDNINT (dw * shrinkfactor); 
		pHSData->GridWidth = ((CurView->DrawRect.right - CurView->DrawRect.left) * shrinkfactor)/pHSData->Granularity;
		pHSData->GridHeight = ((CurView->DrawRect.bottom - CurView->DrawRect.top) * shrinkfactor)/pHSData->Granularity;  
		GridSize =  (long)pHSData->GridWidth * (long)pHSData->GridHeight * 4; 
		pHSData->hGrid = GSSiGlobAlloc (GHND,GridSize);
		pHSData->hMask = GSSiGlobAlloc (GMEM_MOVEABLE,(long)pHSData->MaskWidth * (long)pHSData->MaskWidth * 4); 
		SetupHotSpotMask (pHSData->MaskWidth,pHSData->hMask,pHSData->DecayOpt);
		HSX[0]=HSX[1]=0;
		HSX[2]=HSX[3]=pHSData->GridWidth-1;
		HSY[0]=HSY[3]=0;
		HSY[1]=HSY[2]=pHSData->GridHeight-1;
		BASEX[0]=BASEX[1]=CurView->WBounds.xmn;
		BASEX[2]=BASEX[3]=CurView->WBounds.xmx;
		BASEY[0]=BASEY[3]=CurView->WBounds.ymn;
		BASEY[1]=BASEY[2]=CurView->WBounds.ymx;
		pHSData->hTranBaseToHotSpot = STRAN2 (BASEX,BASEY,HSX,HSY,4,&RSQMIN,1,NULL);
		SetCurView (SaveVP);
	}
	else
	{
		BT_CLOSEANDDELETE (&CurTheme->hScatterFile); 
		if (CurTheme->DisplayScatterDiagram || CurTheme->ClassType == 2)
		{
			if (CurTheme->ScatterFile[0])
				GSSiOpenFile (CurTheme->ScatterFile,(LPOFSTRUCT)&OFStruct,OF_DELETE);
			else
				GetTempFileName (NULL,"thm",NULL,(LPSTR)CurTheme->ScatterFile);
		
			BTVar[0].BT_VARTYP=BT_REAL;
			BTVar[0].BT_VARLEN=8;
			BTVar[0].BT_VAROFF=0;
			BTVar[1].BT_VARTYP=BT_REAL;
			BTVar[1].BT_VARLEN=8;
			BTVar[1].BT_VAROFF=8;
			BTVar[2].BT_VARTYP=BT_INTEGER;
			BTVar[2].BT_VARLEN=4;
			BTVar[2].BT_VAROFF=16;
			BT_CREATE (CurTheme->ScatterFile, 16, FALSE, 3, 1, (LPBTVARDESC)BTVar, FALSE, 0, 0, FALSE);
			CurTheme->hScatterFile = BT_OPEN (CurTheme->ScatterFile,0, BT_WRITE, 0);  
		}
	    if (CurTheme->DataFileType != MSACCESS_DATAFILE) OpenThemeDataFile ();
    }
	return(TRUE);
}

void AddItemToHotSpot (short Type)
{   
	LPHOTSPOTDATA	pHSData = &CurTheme->HotSpotData;
	DPOINT	HotSpotPoint;
	short	x,y, MaskBegRow, MaskEndRow, MaskBegCol, MaskEndCol,GridBegRow, GridBegCol, GridEndRow, GridEndCol, row, col;
	HPLONG	pGrid, pGridRow;
	LPSHORT	pMask, pMaskRow;  
	long	MaxGrid=0;
	
	if (Type != GF_POINT)
		return;  
	HotSpotPoint = TranPoint (&CurPointLocD,pHSData->hTranBaseToHotSpot);
	x = IDNINT (HotSpotPoint.x);
	y = IDNINT (HotSpotPoint.y);
	GridBegRow = y - pHSData->MaskWidth/2;
	if (GridBegRow < 0)
	{
		MaskBegRow = -GridBegRow;
		GridBegRow = 0;
	}
	else
		MaskBegRow = 0;
	GridEndRow = y + pHSData->MaskWidth/2;
	if (GridEndRow > pHSData->GridHeight-1)
	{
		MaskEndRow = pHSData->MaskWidth - (GridEndRow - (pHSData->GridHeight-1));
		GridEndRow = pHSData->GridHeight-1;
	}
	else
		MaskEndRow = pHSData->MaskWidth-1;
	GridBegCol = x - pHSData->MaskWidth/2;
	if (GridBegCol < 0)
	{
		MaskBegCol = -GridBegCol;
		GridBegCol = 0;
	}
	else
		MaskBegCol = 0;
	GridEndCol = x + pHSData->MaskWidth/2;
	if (GridEndCol > pHSData->GridWidth-1)
	{
		MaskEndCol = pHSData->MaskWidth - (GridEndCol - (pHSData->GridWidth-1));
		GridEndCol = pHSData->GridWidth-1;
	}
	else
		MaskEndCol = pHSData->MaskWidth-1;
	pMaskRow = (LPSHORT)GlobalLock (pHSData->hMask);
	pMaskRow += (MaskBegRow * pHSData->MaskWidth) + MaskBegCol;
	pGridRow = (HPLONG)GlobalLock (pHSData->hGrid);
	pGridRow += (long)pHSData->GridWidth * (long)GridBegRow + (long)GridBegCol; 
	row = MaskBegRow; 
	while (row < MaskEndRow)
	{
		col = MaskBegCol;
		pMask = pMaskRow;
		pGrid = pGridRow;
		while (col < MaskEndCol)
		{
			*pGrid += *pMask;  
			MaxGrid = max (MaxGrid,*pGrid);
			pGrid++;
			pMask++;
			col++;
		} 
		row++;
		pMaskRow += pHSData->MaskWidth;    
		pGridRow += pHSData->GridWidth;
	}
	GlobalUnlock (pHSData->hGrid);
	GlobalUnlock (pHSData->hMask);  
	CurTheme->Ymax = max (CurTheme->Ymax,(double)MaxGrid);
	return;
}

BOOL SaveHotSpotSurface (void)
{
	LPHOTSPOTDATA	pHSData = &CurTheme->HotSpotData;
	long	GridSize;
    HPLONG	pGrid;
    HFILE	Fid;
	
	if (!pHSData->PromptForSave)
		return FALSE;
	Fid = GSSiOpenFile (CurTheme->HotSpotSaveTo,NULL,OF_CREATE);
	if (Fid == HFILE_ERROR)
		return FALSE;	
	GridSize =  (long)pHSData->GridWidth * (long)pHSData->GridHeight * 4; 
	pGrid =  (HPLONG)GlobalLock (pHSData->hGrid); 
	BigWrite (Fid,(HPSTR)pHSData,sizeof(HOTSPOTDATA));
	BigWrite (Fid,(HPSTR)pGrid,GridSize);
	GSSiClose (Fid);
	return TRUE;
}

HANDLE LoadHotSpotSurface (LPSTR File)
{
	LPHOTSPOTDATA	pHSData;
	long	GridSize;
    HPLONG	pGrid;
    HFILE	Fid; 
    HANDLE	handle;
	
	if (!pHSData->PromptForSave)
		return FALSE;
	Fid = GSSiOpenFile (File,NULL,OF_READ);
	if (Fid == HFILE_ERROR)
		return FALSE;	
	handle = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(HOTSPOTDATA));
	pHSData = (LPHOTSPOTDATA)GlobalLock (handle);  
	BigRead (Fid,(HPSTR)pHSData,sizeof(HOTSPOTDATA));
	GridSize =  (long)pHSData->GridWidth * (long)pHSData->GridHeight * 4;   
	pHSData->hGrid = GSSiGlobAlloc (GMEM_MOVEABLE,GridSize);
	pGrid =  (HPLONG)GlobalLock (pHSData->hGrid); 
	BigRead (Fid,(HPSTR)pGrid,GridSize);   
	GlobalUnlock (pHSData->hGrid);
	GSSiClose (Fid); 
	GlobalUnlock (handle);
	return handle;
} 

BOOL CompareHotSpotData (LPHOTSPOTDATA pHSData)
{   
	HANDLE	hCompare;
	LPHOTSPOTDATA	pHSDataCT;
    HPLONG	pGrid, pGridCT;
    long	GridSize;  
    double Factor=1;
    char	File[150];   
    LPSTR	pFile=File, pEnd;
	
	if (!*CurTheme->HotSpotCompareTo)
		return FALSE; 
	_fstrcpy (File,CurTheme->HotSpotCompareTo);
	ExpandText (File);
	if (!*File)
		return FALSE;
	if (*File == '(')
	{
		pEnd = _fstrrchr (File,')');
		*pEnd++ = 0; 
		pEnd++;
		Factor = atof (pEnd);
		pFile++;
	}
	if (!(hCompare = LoadHotSpotSurface (pFile)))
		return FALSE; 
	pHSDataCT = (LPHOTSPOTDATA)GlobalLock (hCompare); 
	pGridCT = (HPLONG)GlobalLock (pHSDataCT->hGrid);   
	pGrid = (HPLONG)GlobalLock (pHSData->hGrid);     
	CurTheme->Ymax = LONG_MIN;
	CurTheme->Ymin = LONG_MAX;
	if (pHSData->GridWidth == pHSDataCT->GridWidth && pHSData->GridHeight == pHSDataCT->GridHeight)
	{
		GridSize =  (long)pHSData->GridWidth * (long)pHSData->GridHeight; 
		while (GridSize--)
		{ 
			(*pGrid) -= (*pGridCT++)/Factor;
			CurTheme->Ymax = max (CurTheme->Ymax,*pGrid);
			CurTheme->Ymin = min (CurTheme->Ymin,*pGrid);
			pGrid++;
		}  
	}
	else
		GSSiMessageBox ("Unable to compare hot spot surfaces due to unequal dimensions",NULL,MB_ICONEXCLAMATION);
	GlobalUnlock (pHSData->hGrid);
	GSSiGlobUlFree (&pHSDataCT->hGrid); 
	GSSiGlobUlFree (&hCompare); 
	
	return TRUE;
}

void DisplayHotSpots (void)
{
	LPHOTSPOTDATA	pHSData = &CurTheme->HotSpotData;
	LPVIEWPORT	SaveVP = CurView;
    COLORREF	Color=RGB(255,0,0);  
    HBRUSH	hBrush=GetStockObject(BLACK_BRUSH);  
    RECT	Rect; 
    short	r=255,g=0,b=0,i,j;
    double	rw, MV;
    HPLONG	pGridRow = (HPLONG)GlobalLock (pHSData->hGrid), pGrid;
    
    if (CurTheme->Ymax > 0 && pHSData->GridWidth)
    {   
    	CompareHotSpotData (pHSData);
    	SaveHotSpotSurface ();
		SetViewport (CurTheme->TargetViewport);   
		SaveDC (CurView->hDC);
	    SetDisplayMode (CurView->hDC,GF_TEXTMODE);
	    SelectClipRgn (CurView->hDC,0);
	    switch (pHSData->ColorOpt)
	    {
	    	case 0:    
	    		MV = max (-CurTheme->Ymin,CurTheme->Ymax);
	    		break;
	    	case 1:
	    		MV = sqrt (max (-CurTheme->Ymin,CurTheme->Ymax));
	    		break;
	    	case 2:
	    		MV = pow (max (-CurTheme->Ymin,CurTheme->Ymax),2);
	    		break;
	    }
	    rw = (double)(CurView->DrawRect.right - CurView->DrawRect.left)/(double)pHSData->GridWidth; 
	    i=0;
    	Rect.top = CurView->DrawRect.bottom;
	    while (i < pHSData->GridHeight)
	    {   
	    	Rect.bottom = Rect.top;
	    	Rect.top = Rect.bottom - pHSData->Granularity;
	    	pGrid = pGridRow;   
	    	j=0;   
	    	Rect.right=CurView->DrawRect.left;
	    	while (j < pHSData->GridWidth)
	    	{   
	    		double	GridVal = *pGrid;
	    		
	    		switch (pHSData->ColorOpt)
	    		{
	    			case 1:
	    				GridVal = sqrt (fabs (GridVal)) * Signof (GridVal);                 
	    				break;
	    			case 2:
	    				GridVal = pow (GridVal,2);
	    				break;
	    			default:
	    				break;
	    		}
		    	Rect.left=Rect.right; 
	    		Rect.right = Rect.left + pHSData->Granularity;  
		    	if (*pGrid>0)  
		    	{
	    			g = b = 255 * ((1.0-(((double)100-pHSData->ColorMin)/(double)100)*(GridVal / MV))*((double)(100-pHSData->ColorMin)/100));
		    		Color = RGB(255,g,b);
		    		hBrush = CreateSolidBrush (Color);
		    		FillRect (CurView->hDC,&Rect,hBrush);
		    		DeleteObject (hBrush);
				}
		    	else if (*pGrid<0)  
		    	{
	    			g = r = 255 * ((1.0-(((double)100-pHSData->ColorMin)/(double)100)*(fabs(GridVal) / MV))*((double)(100-pHSData->ColorMin)/100));
		    		Color = RGB(r,g,255);
		    		hBrush = CreateSolidBrush (Color);
		    		FillRect (CurView->hDC,&Rect,hBrush);
		    		DeleteObject (hBrush);
				}
	            pGrid++;
	            j++;
	    	} 
	    	pGridRow += pHSData->GridWidth;
	    	i++;
	    } 
		RestoreDC (CurView->hDC,-1);  
		SetCurView (SaveVP);
	}
	GlobalUnlock (pHSData->hGrid);
	return;
}

BOOL SetVisibilityFromTheme (LPSTR Name,short setopt)
{   
	HFILE		Fid;  
	OFSTRUCT	OFStruct;
	LPTHEME		pTheme, SaveTheme=CurTheme; 
	short		pos=BT_FIRST, idesc;
	char		SymName[128],Data[128];
	
	Fid = GSSiOpenFile (Name,(LPOFSTRUCT)&OFStruct,OF_READ);  
	if (Fid == HFILE_ERROR)
		return FALSE;
	ReadObject (Fid,FALSE,&pTheme,NULL); 
	GSSiClose (Fid);
	if (pTheme->ScatterFile)
	{
		pTheme->hScatterFile = BT_OPEN (pTheme->ScatterFile,0, BT_READ, 0); 
		while (!BT_FIND (pTheme->hScatterFile,SymName,pos,BT_ANY,Data))
		{
			pos = BT_NEXT;
			if ((idesc = GetSymbolNum (SymName)))
			{
				if (GetVisibility(idesc) != setopt)
					ToggleVisibility (idesc);
			}
		} 
	}	
	CloseObject (pTheme);  
	CurTheme = SaveTheme;
	return TRUE;
}  

double GetThemeClassDistance (short iclass)
{   
	double	Dist=0, MinDist, Dist2;  
	DPOINT	MidPoint, FromPoint;
	HANDLE	handle;  
	HPDPOINT	pPoint; 
	long	nPoints=0,i,Mini;
	short	pos, cond;
	static	double	ClassDist[MAX_THEME_CLASSES];
	
	if (iclass < 0)
		_fmemset (ClassDist,0,sizeof(double)*MAX_THEME_CLASSES);
	if (iclass < 0)
	{	
		if (!OpenThemeHighlightFile (BT_READ))
			return 0;
		for (iclass=0;iclass<CurTheme->NumClass;iclass++)
		{   
			Dist = 0;
			if (CurTheme->ClassCount[iclass])
			{
				handle = GSSiGlobAlloc (GMEM_MOVEABLE,(CurTheme->ClassCount[iclass]+1)*sizeof(DPOINT));
				pPoint = (HPDPOINT)GlobalLock (handle); 
				ThemeHighlightKey.Class = iclass;
				ThemeHighlightKey.Refno = LONG_MIN; 
				nPoints = 0;
				pos = BT_FIRST;
				cond = BT_GE;
				while (!BT_FIND (CurTheme->hHighlightFile,(LPSTR)&ThemeHighlightKey,pos,cond,(LPSTR)&ThemeHighlightData))
				{
					pos = BT_NEXT;
					cond = BT_ANY;
					if (ThemeHighlightKey.Class != iclass)
						break;
					if (nPoints)
					{
						MidPoint.x += ThemeHighlightData.Point.x;
						MidPoint.y += ThemeHighlightData.Point.y;
					}
					else
						MidPoint =  ThemeHighlightData.Point;
					pPoint[nPoints++] = ThemeHighlightData.Point;
				}
				MidPoint.x /= nPoints;
				MidPoint.y /= nPoints;
				GetGlobalPVal ("[%STARTPOINT]",&MidPoint,&FromPoint); 
				while (nPoints)
				{   
					MinDist = DBL_MAX;
					for (i=0;i<nPoints;i++) 
					{
						Dist2 = ldistp (FromPoint,pPoint[i]);
						if (Dist2 < MinDist)
						{
							MinDist = Dist2;
							Mini = i;
						}
					}
					Dist += MinDist;
					FromPoint = pPoint[Mini];
					nPoints--;
					if (Mini < nPoints)
						hmemmove ((HPSTR)&pPoint[Mini],(HPSTR)&pPoint[Mini+1],(long)sizeof(DPOINT)*(nPoints-Mini));
				}
				GSSiGlobUlFree (&handle);
				ClassDist[iclass] = Dist*MFT/5280;
			}
		} 
		CloseThemeHighlightFile (); 
		return 0;
	}
	return ClassDist[iclass];
}
void EndProcessingThemeLegends (void)
{   
	short	iview, itheme;  
	LPVIEWPORT	SaveView = CurView;
	
	for (iview = 0;iview < NumViewports; iview++)
    {
    	SetCurView (pViewports[iview]); 
        if (CurViewActive() && CurView->pTheme)
		{
			CurTheme=CurView->pTheme;
			if ((CurTheme->ID == PF_COORD_DISPLAY || CurTheme->IsActive) &&
			    CurTheme->ID != GF_BOUNDS_DISPLAY_THEME)
			    ThemeDisplayLegend(4);
		}
	}
	SetCurView (SaveView);
	return;
}

BOOL FAR PASCAL EDIT_ADDS_THEMEMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{	
 	FILE	*FidNoteType; 
 	char	str[130]; 
	int		TabStops[2]={1200,1300}; 
	LPSTR	lpBar, lpName;
	LPINT	pNumDocs;
	int		NumDocs=0;
   	int		nItems;


 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 if (ThemeCommonCode (hWndDlg, Message, wParam, lParam,0))
 	return TRUE;
 switch(Message)
   {
    case WM_INITDIALOG: 
    	 switch (CurTheme->Xmove)
    	 {
    	 	case 1: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITADDS,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 2: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITNAMES,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 3: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITADDSNAMES,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 4: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITSPEED,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 5: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITTRAFVOL,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 6: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITZIP,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 7: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITONEWAY,BM_SETCHECK,TRUE,0L);
		 		break;
    	 	case 8: 
		 		SendDlgItemMessage (hWndDlg,IDC_EDITLANES,BM_SETCHECK,TRUE,0L);
		 		break;
		 }
		 if (CurTheme->Ymove)
	 		SendDlgItemMessage (hWndDlg,IDC_ALLOW_ADD,BM_SETCHECK,TRUE,0L);
		 	
		 break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
         switch(wParam)
           {
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 EndDialog(hWndDlg, FALSE);
                 break;
            case IDC_SAVE_THEME:  
            case IDOK:
            {
            	HANDLE	hItems;
            	LPINT	lpItems;
            	
				if (SendDlgItemMessage (hWndDlg,IDC_EDITADDS,BM_GETCHECK,0,0))
					CurTheme->Xmove = 1;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITNAMES,BM_GETCHECK,0,0))
					CurTheme->Xmove = 2;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITADDSNAMES,BM_GETCHECK,0,0))
					CurTheme->Xmove = 3;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITSPEED,BM_GETCHECK,0,0))
					CurTheme->Xmove = 4;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITTRAFVOL,BM_GETCHECK,0,0))
					CurTheme->Xmove = 5;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITZIP,BM_GETCHECK,0,0))
					CurTheme->Xmove = 6;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITONEWAY,BM_GETCHECK,0,0))
					CurTheme->Xmove = 7;
				else if (SendDlgItemMessage (hWndDlg,IDC_EDITLANES,BM_GETCHECK,0,0))
					CurTheme->Xmove = 8;
				CurTheme->Ymove = SendDlgItemMessage (hWndDlg,IDC_ALLOW_ADD,BM_GETCHECK,0,0);
                if (wParam == IDC_SAVE_THEME)
            		SaveCurTheme(hWndDlg);
				else            	
                	EndDialog(hWndDlg, TRUE);
            }
                break;

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}

