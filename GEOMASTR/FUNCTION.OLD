				UDI = _fstrchr (Arg2,':');
				if (!UDI)
					goto RtnFalse;
				*UDI++=0;
				if (!PickByRefno (0,Arg2,UDI,PickFile))
					goto RtnFalse;
				Bounds = PickList[0].Rect;
				SetPickGlobals (0);
				sprintf (OutLoc,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmx,Bounds.ymx);
				goto Rtnl;  
			} 
			
			goto RtnFalse;
		} 
		
