		case 321: // $VIS(SymbolName or #SymbolNumber or LAYER:layername or themename.thm,0 or 1 or no arg 2 toggles) 
			PickVis = FALSE;
SetVis: 
		{	
			BOOL	IsPar;
			short	Parent, idesc, iopt;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			if (!(ParLoc = MatchLev (Args,',')))
				iopt = 2;
			else
			{
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
				ExpandText (Arg2); 
				iopt = atoi (Arg2);
			}
			SelectVisList (PickVis);
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			_fstrupr (Arg1);
			if (*Arg1 == '#')
			{
				Arg1++;
				idesc = atoi (Arg1);  
			} 
			else if (!_fstrnicmp (Arg1,"LAYER:",6))
			{
				if (SetLayerVisibility ((LPSTR)(Arg1+6),iopt))
					goto RtnTrue;                      
				else
					goto RtnFalse;
			}
			else if (!_fstrnicmp (Arg1,"TYPE:",5))
			{
				if (SetTypeVisByName ((LPSTR)(Arg1+5),iopt))
					goto RtnTrue;                      
				else
					goto RtnFalse;
			}
			else if (_fstrstr (Arg1,".THM"))
			{
				if (SetVisibilityFromTheme (Arg1,iopt))
					goto RtnTrue;                      
				else
					goto RtnFalse;
			}
			else
				idesc = GetSymbolNum (Arg1);  
			if (!idesc)
				goto RtnFalse;
			if (!GetSymbolName (idesc,Arg1,&Parent,0,&IsPar))
				goto RtnFalse;
			if (IsPar)
			{
				SetParentVisibility (idesc,iopt,-1); 
			}
			else
			{
				if (GetVisibility(idesc) != iopt)
					ToggleVisibility (idesc);
			}
			
			goto RtnTrue;
		}  
		
		case 322: //$GPS (WPTRAN or CONFIG)
        {
        	BOOL	nRc=FALSE;

			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
            DoPaint = FALSE;      
            if (!_fstricmp (Arg1,"WPTRAN"))
             {
				lpfnGPSMsgProc = MakeProcInstance((FARPROC)GPSMsgProc, hInst);
				nRc = DialogBox(hInst, (LPSTR)"GPS",hWndMain, lpfnGPSMsgProc);
				FreeProcInstance(lpfnGPSMsgProc);  
			}
			else
            {
				lpfnGPSCONFIGMsgProc = MakeProcInstance((FARPROC)GPSCONFIGMsgProc, hInst);
				nRc = DialogBox(hInst, (LPSTR)"GPSCONFIG", hWndMain, lpfnGPSCONFIGMsgProc);
				FreeProcInstance(lpfnGPSCONFIGMsgProc);   
			}
			DoPaint = TRUE; 
				
            if (nRc)
            	goto RtnTrue;
            else
				goto RtnFalse;
        }
		
		case 323: //$DMS (dec deg,ndp) returns xxD xxM xx.ndpS or xxD xx.abs(ndp)M if ndp < 0
		{
			short	Deg, Min, ndp;
			double	Sec, decdeg;
			  
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2); 
			ndp = atoi (Arg2);
			decdeg = atof (Arg1);
			GetDMS (decdeg,&Deg,&Min,&Sec);
			if (ndp < 0)
				sprintf (OutLoc,"%2.2iD %.*fM",abs(Deg),abs(ndp),(double)Min + Sec/60);
			else 
				sprintf (OutLoc,"%2.2iD %2.2iM %.*fS",abs(Deg),Min,ndp,Sec);
			goto Rtnl;
		}
			
		case 324: // $CFG(LOAD,config file) Load config file 
				  //      SAVE,config file) Save with current zoom
		{	
			HDC	hDC;			
			if (!(ParLoc = MatchLev (Args,','))) goto RtnFalse;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			
			if (!_fstricmp (Arg1,"LOAD"))
			{
				if (!ExistFile (Arg2))
	            	goto RtnFalse;
				SaveZooms (NULL);
		        UnallocateConfig ();
	    		_fstrcpy (CfgName,Arg2);
				CheckForContinue ();
				PostMessage(hWndMain, WM_COMMAND, IDM_REDISPLAY, 0L);
				goto RtnTrue;  
			}
			else if (!_fstricmp (Arg1,"SAVE"))
			{   BOOL SaveSaveZoom = SaveZoom, SaveSaveGlobals = SaveGlobals, rtn;
				
             	SaveZoom = TRUE;
             	SaveGlobals = TRUE;
	            rtn = SaveConfig (Arg2);
	            SaveZoom = SaveSaveZoom;
	            SaveGlobals = SaveSaveGlobals;
	            if (rtn)
	            	goto RtnTrue;
			}
			goto RtnFalse;
		}
		
		case 325: /* $LEN(string) returns length of string*/
		{	
			long	ICmd;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			l = _fstrlen (Arg1);
			itoa (l,OutLoc,10);
			goto Rtnl;
		} 
		
		case 326: /* $HEX(string) returns hex value*/
		{	
			long	ICmd;
			
