		case 723: // $GETPATH (R W or C,Extension,title(opt),storvar(opt)) Get pathname
		{	
			HANDLE	hTemp;
			LPSTR	str, lpSave;    
			BOOL	rtn,ResetSubDL;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GHND,2048*4);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			Arg4 = Arg3 + 2048; 
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc++ = 0;
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc++ = 0; 
				if ((ParLoc = MatchLev (Arg3,',')))
				{
					_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
					*ParLoc = 0; 
				}
			}
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			ExpandText (Arg4);
			_fstrupr (Arg1);  
			hTemp = GSSiGlobAlloc (GHND,256);
			str = GlobalLock (hTemp);
			if (*Arg4) 
				GetGlobalCVal (Arg4,str,NULL);
			else
				*str = 0; 
			ResetSubDL = GetGlobalBVal ("[%SUBDL]");
			SetGlobalValue("%SUBDL","N");
			switch (*Arg1)
			{
				case 'R':
                	rtn = GetFileName4 (GetFocus(),str,0,Arg2,Arg3,Arg4);
                	goto TestGPRtn;
				case 'W': 
					OverWritePrompt = FALSE;
				case 'C':
                	rtn = GetSaveName3 (GetFocus(),str,0,Arg2,Arg3,Arg4);
                	break; 
                default:
                	rtn=FALSE;
            }
TestGPRtn:	if (ResetSubDL)
				SetGlobalValue("%SUBDL","Y");
			if (rtn)
				_fstrcpy (OutLoc,str); 
			else
			{
				ContinueProcessing = FALSE;  
           		PostMessage(hWndMain, GF_CLEAR_FUN_STACK, 0, 0L);
           		*OutLoc = 0;
			}
			GSSiGlobUlFree (&hTemp);
			goto Rtnl;
		} 
		
		case 724: // $NULLMAP(pathname,CoordOpt,R to replace existing file)
		{	double	rval;
