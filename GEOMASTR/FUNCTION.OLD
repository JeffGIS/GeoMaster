int	GetFunctionValue (int FunID,LPSTR Args, LPSTR OutLoc)
{   HANDLE	hMem=0,hDLT,hSurf;
	LPSTR	Arg1, Arg2, Arg3, Arg4, Arg5, Arg6,Arg7, ParLoc, lpstr, lpstrb;  
	LPSTR	pEnd, pCR, pFile, Arg[8];
	short	nArgs;
	HFILE	Fid1, Fid2, Fid3;   
	int		l, CvtDir, year;    
	DPOINT	Point, Point2;
	POINT	Point16;
	RECT	Rect; 
	MNMXCORD	Bounds;           
	long	hNum, Refno,ii, nlong;
	LPSTR	lpColon;
	time_t	systime; 
	BOOL	TORF, rtn, Err, PickVis;  
	LPVIEWPORT	SaveVP=CurView;
	short SymNum, Mode;			
	short	n, n1,n2,pos, nrem;  
	double	AZ, Dist,Elevation, RVal;
	HFILE	Fid;
	LPOFSTRUCT	pOFStruct;
	LPDPOINT	pPoint;
	HANDLE	hDibInfo;
	long	ImageOffset; 
	double	Offset;
	HANDLE	hSQL;
    LPOPENFILEDATA  FilePtr;
    LPOPENSQLDATA   SQLPtr;
	
	if (LinkToVar)
	{
		ExpandText (Args);
		return 0;
	}
	if (TraceType[0])
	{
		hMem=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
		lpstr = GlobalLock (hMem);
		sprintf (lpstr,"GFV:%s",Args);
		GSSiTraceLev (lpstr,1);
		GSSiGlobUlFree (&hMem);
	}
	switch (FunID)
	{    
		case 101: /* $D(str) displays str */
		{				
			DWORD	TextExt;  
			int		l,i;
			LPSTR	loc,endloc,tab;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);    
			if (FidDisplay != HFILE_ERROR)
			{
				fputstring (Arg1,FidDisplay);
				goto RtnTrue;
			}
			if (!CurReport)
				goto RtnFalse;
			if (CurReport->hScrollLine)
			{    
				LPSTR	pLine;     
				
				pLine = GlobalLock (CurReport->hScrollLine); 
				if (_fstrlen (pLine) + _fstrlen (Arg1) < 1020)
					_fstrcat(pLine,Arg1);
				GlobalUnlock (CurReport->hScrollLine);
				goto RtnTrue;
			}
			if (CurReport->hDC && CurFont && CurFont <= CurReport->NumFonts)
				SelectObject (CurReport->hDC,CurReport->hFonts[CurFont-1]);
			loc = Arg1;
			endloc = _fstrchr (Arg1,0);
			while (loc < endloc)
			{ 
				tab = _fstrchr (loc,'\t');
				if (tab)
				{   
					*tab = 0;
					for (i=0;i<CurReport->NumTabs;i++)
					{
						if (CurReport->x < CurReport->TabLen[i])
						{
							CurReport->x = CurReport->TabLen[i];
							break;
						}
					}
				}
				else
					tab=endloc;
				l = _fstrlen (loc);
				if (l)   
				{   
					char just[8];
					
					GetGlobalCVal ("[%JUST]",just,"L");
					TextExt = GetTextExtent (CurReport->hDC,loc,l);
					switch (just[0])
					{
						default:
						case 'l':
						case 'L':
							break;
						case 'c':
						case 'C':
							CurReport->x = CurReport->Rect.left + (CurReport->Rect.right - CurReport->Rect.left)/2 - LOWORD(TextExt)/2;
							break;
						case 'R':
						case 'r':
							CurReport->x = CurReport->Rect.right - LOWORD(TextExt);
							break;
					}	
					TextOut (CurReport->hDC,CurReport->x,CurReport->y,loc,l);
		    		CurReport->x += LOWORD(TextExt);
				}
				loc = tab+1;
			}

			goto RtnTrue;
		}
		
		case 102: /* $L(num) increases line counter by num*/
		{	
			int	nlines;
						
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			if (!CurReport)
				goto RtnFalse;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			nlines = max (1,atoi (Arg1));  
			if (CurReport->hScrollLine)
			{
				LPSTR	pLine;     
				
				pLine = GlobalLock (CurReport->hScrollLine); 
				while (nlines--) 
				{   
					if (ScrollRptDlg == 1)
						fputstring (pLine,ScrollRptCntl);
					else if (ScrollRptDlg)
			 			SendDlgItemMessage (ScrollRptDlg,ScrollRptCntl,LB_ADDSTRING,(WPARAM)NULL,(LPARAM)pLine); 
					*pLine = 0; 
				}
				GlobalUnlock (CurReport->hScrollLine);
				goto RtnTrue;
			}
			CurReport->y += nlines * CurrentReportFontHeight (); 
			if ((CurReport->y+CurrentReportFontHeight ()) > CurReport->Rect.bottom) 
			{
				NextPage (CurReport->hDC);
				CurReport->y = CurReport->Rect.top;  
			}
			CurReport->x = CurReport->Rect.left;

			goto RtnTrue;
		} 
		
		case 103: /* $X(str) extracts x value from point */
		{				
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			*OutLoc = 0;
			if ((pEnd = _fstrchr (Arg1,' ')))
			{
				*pEnd = 0;
				_fstrcpy (OutLoc,Arg1);
			}
			goto Rtnl;   
		}
		
		case 104: /* $Y(str) extracts x value from point */
		{				
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			*OutLoc = 0;
			if ((pEnd = _fstrchr (Arg1,' ')))
			{
				*pEnd++ = 0;
				_fstrcpy (OutLoc,pEnd);
			}
			goto Rtnl;   
		}
		
		case 201: /* $OS(string) */
		{
			BOOL LastWasBlank, HaveNonBlank=FALSE; 
			LPSTR	SaveOutLoc; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			LastWasBlank = FALSE;  
			SaveOutLoc = OutLoc;
			while (*Arg1)
			{
				if (*Arg1 != ' ')
				{   
					if (LastWasBlank && HaveNonBlank)
						*OutLoc++ = ' '; 
					LastWasBlank = FALSE;  
					HaveNonBlank=TRUE;
					*OutLoc++ = *Arg1;
				}                        
				else
					LastWasBlank = TRUE;
				Arg1++;
			}
			*OutLoc = '\0';  
			OutLoc = SaveOutLoc;
			goto Rtnl;
		}
		
		case 202: /* $LV(view) returns left view */
		{	double	rval; 
			int		iview;
			int		ndec, ntoadd; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			iview = IDNINT(rval); 
			if (iview == 3)
				iview = 1; 
			else
				iview = 5;
			itoa (iview,OutLoc,10);

			goto Rtnl;
		}
		
		case 203: /* $RV(view) returns right view */
		{	double	rval; 
			int		iview;
			int		ndec, ntoadd; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			iview = IDNINT(rval); 
			if (iview == 3)
				iview = 5; 
			else
				iview = 1;
			itoa (iview,OutLoc,10);

			goto Rtnl;
		}
		
		case 204: /* $VP(SET,name)sets current viewport
					or
						(SHOW,name) displays current viewport
					or
						(HIDE,name) hides current viewport 
					or	
						(DISPLAY,name) redisplays viewport
					or
						(REZOOM,name) rezooms viewport
					or
						(ZOOM,                    
				 */
		{	
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			if ((ParLoc = MatchLev (Args,',')))
			{ 
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
			}
			else
				*Arg2 = 0;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			
			SaveVP = CurView; 
			if (*Arg2)
				SetCurView ( SetVPFromName (Arg2,&Err));
			else if (Err)
				SetViewport (CommandViewport);	
			if (!_fstrcmp (Arg1,"SET"))
			{
				if (InGRCmd) goto Rtn0;    
				IgnoreSelectVP = TRUE;
			}
			else if (!_fstrcmp (Arg1,"SHOW"))
			{
				CurView->Active = TRUE;
				SetCurView ( SaveVP);
			}
			else if (!_fstrcmp (Arg1,"TOGGLE"))
			{
				CurView->Active = !CurView->Active;
				SetCurView ( SaveVP);
			}
			else if (!_fstrcmp (Arg1,"HIDE"))
			{
				CurView->Active = FALSE;
				SetCurView ( SaveVP);
			}
			else if (!_fstrcmp (Arg1,"DISPLAY"))
			{   
				BOOL SaveDisableHalt = DisableHalt;
				
//				DisableHalt = TRUE;
				PostMessage(CurView->hWnd, WM_COMMAND, IDM_Z_REDRAW, CurView->ID);
//	         	RedisplayViewport (TRUE,FALSE);  
//	         	DisableHalt = SaveDisableHalt;
				SetCurView ( SaveVP);
			}
			else if (!_fstrcmp (Arg1,"REZOOM"))
			{   
				double	dist;
				
				if (!GetVisBounds (&Bounds,CurView->hDC))
					goto RtnFalse; 
				dist = min(Bounds.xmx - Bounds.xmn,Bounds.ymx - Bounds.ymn);
				dist *= 0.01;
				Bounds.xmn -= dist;
				Bounds.ymn -= dist;
				Bounds.xmx += dist;
				Bounds.ymx += dist; 
			    CurView->CurZoomAreaRef = LONG_MAX;
				ZoomToRect(Bounds,FALSE);
			}
			else
			{
				SetCurView ( SaveVP);
				goto RtnFalse;
			}
			goto RtnTrue;
		}
		case 205: // $LN(length,optunits) element length
		{				
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (OutLoc,Args);
			ExpandText (OutLoc); 

			goto Rtnl;
		}
		case 301: /* $RND(numval,decplace,(optional TF add commas)) rounds numeric values*/ 
		{	double	rval;
			int		ndec; 
			char	Format[16]; 
			BOOL	AddC=FALSE;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				*ParLoc++ = 0;
				_fstrcpy (Arg3,ParLoc);
				ExpandText (Arg3);
				AddC = atob (Arg3);
			}
			ExpandText (Arg1);
			ExpandText (Arg2);
			
			ndec = atoi (Arg2);
			rval = atof (Arg1);
			if (ndec<0) goto Rtn0; 
			sprintf (Format,"%%.%ilf",ndec);
			sprintf (OutLoc,Format,rval);  
			if (AddC)
				AddCommas (OutLoc);
			goto Rtnl;
		}
		case 302: /* $CMA(numval) Adds commas to numeric values*/ 
		{	double	rval;
			int		ndec, lc, ntoadd; 
			char	Format[16];
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			
			sprintf (Format,"%%.%ilf",ndec);
			sprintf (OutLoc,Format,rval); 
			l = _fstrlen(OutLoc); 
			if (ndec)
				lc = l - (ndec + 1);
			else
				lc = l;
			ntoadd = (lc-1)/3;
			
			if (ntoadd)
			{
				LPSTR	lpOut1, lpOut2;
				int		n=3; 
				
				lpOut1 = OutLoc + l;
				lpOut2 = lpOut1 + ntoadd;
				if (ndec)
					n += ndec + 1;
				while (lpOut1 != lpOut2)
				{   
					*lpOut2-- = *lpOut1--;
					if (!n)
					{
						*lpOut2-- = ',';
						n = 2;
					}
					else
						n--;
				}
			}
			goto Rtnl;
		}
		case 303: /* $OPV(view) returns opposite view */
		{	double	rval; 
			int		iview;
			int		ndec, ntoadd; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			iview = IDNINT(rval); 
			iview = OppositeView(iview); 
			itoa (iview,OutLoc,10);

			goto Rtnl;
		}
		case 304: /* $RUN(runid) returns run date */
		{				
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			GetRunDate (Arg1,OutLoc);

			goto Rtnl;
		}
		case 305: /* $CAL(time,format) returns date in specified format*/  
				 //also sets globals %YEAR, %MONTH, %CMONTH, %MDAY, %WDAY, %YEAR1900
		{	double	rval;
			int		iformat; 
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			systime = max (0,IDNINT(atof(Arg1)));
			ExpandText (Arg2);
			iformat = atoi(Arg2);
			tmtime = *localtime (&systime); 
			switch (iformat)
			{
				case 2:			        
					_fstrcpy (OutLoc,ctime(&systime));
					*_fstrchr(OutLoc,'\n') = 0;   
					break;
				case 1:
					if (tmtime.tm_year < 100)
						year = tmtime.tm_year;
					else
						year = tmtime.tm_year - 100;
					sprintf (OutLoc,"%i/%i/%2.2i",tmtime.tm_mon+1,tmtime.tm_mday,year);
					break;      
				case 3: //ODBC format 1999-12-15 00:00:00.000
					sprintf (OutLoc,"%i-%2.2i-%2.2i %2.2i:%2.2i.000",tmtime.tm_year+1900,tmtime.tm_mon+1,tmtime.tm_mday,
													  tmtime.tm_hour,tmtime.tm_min,tmtime.tm_sec);
					break;      
			}

			goto Rtnl;
		}
		case 311: /* $CLK(datetime,format(optional-defaults to 1) returns systime (seconds) from specified format*/ 
		{	double	rval;
			int		iformat; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			if ((ParLoc = MatchLev (Args,',')))
			{
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
			}
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (ParLoc)
			{
				ExpandText (Arg2);   
				iformat = atoi(Arg2);
			}
			else
				iformat = 1;
			switch (iformat)
			{
				case 1: /* ODBC format  1996-12-01 08:48:00.000 */  
                    _fmemset (&tmtime,0,sizeof(tmtime));  
                    if (!(lpstr=_fstrchr (Arg1,'-'))) break; 
                    *lpstr++=0; 
                    tmtime.tm_year = atoi (Arg1);
                    if (tmtime.tm_year < 70)
                    	tmtime.tm_year += 100;
                    else if (tmtime.tm_year >= 1900)
                    	tmtime.tm_year -= 1900;
                    lpstrb = lpstr;
                    tmtime.tm_mon = atoi (lpstrb)-1; 
                    if (!(lpstr=_fstrchr (lpstrb,'-'))) break; 
                    *lpstr++=0;
                    lpstrb = lpstr;
                    tmtime.tm_mday = atoi (lpstrb); 
                    if (!(lpstr=_fstrchr (lpstrb,' '))) break; 
                    *lpstr++=0; 
                    lpstrb = lpstr;
                    tmtime.tm_hour = atoi (lpstrb); 
                    if (!(lpstr=_fstrchr (lpstrb,':'))) break; 
                    *lpstr++=0;
                    lpstrb = lpstr;
                    tmtime.tm_min = atoi (lpstrb); 
                    if (!(lpstr=_fstrchr (lpstrb,':'))) break; 
                    *lpstr++=0;
                    lpstrb = lpstr;  
                    tmtime.tm_sec = atof (lpstrb);
                    break;
                    
             case 2: // mmddyyyyhhmmss 
                    _fmemset (&tmtime,0,sizeof(tmtime));  
                    if (_fstrlen (Arg1) != 14)
                    	break; 
                    tmtime.tm_year = ldread (&Arg1[4],4);
                    if (tmtime.tm_year < 70)
                    	tmtime.tm_year += 100;
                    else if (tmtime.tm_year >= 1900)
                    	tmtime.tm_year -= 1900;
                    tmtime.tm_mon = ldread (Arg1,2)-1; 
                    tmtime.tm_mday = ldread (&Arg1[2],2); 
                    tmtime.tm_hour = ldread (&Arg1[8],2);  
                    tmtime.tm_min = ldread (&Arg1[10],2);  
                    tmtime.tm_sec = ldread (&Arg1[12],2);  
                    break;
             case 3: // yyyymmddhhmmss 
                    _fmemset (&tmtime,0,sizeof(tmtime));  
                    if (_fstrlen (Arg1) != 14)
                    	break; 
                    tmtime.tm_year = ldread (&Arg1[0],4);
                    if (tmtime.tm_year < 70)
                    	tmtime.tm_year += 100;
                    else if (tmtime.tm_year >= 1900)
                    	tmtime.tm_year -= 1900;
                    tmtime.tm_mon = ldread (&Arg1[4],2)-1; 
                    tmtime.tm_mday = ldread (&Arg1[6],2); 
                    tmtime.tm_hour = ldread (&Arg1[8],2);  
                    tmtime.tm_min = ldread (&Arg1[10],2);  
                    tmtime.tm_sec = ldread (&Arg1[12],2);  
                    break;
             case 4: // yymmdd hh:mm:ss 
                    _fmemset (&tmtime,0,sizeof(tmtime));  
                    if (_fstrlen (Arg1) != 15)
                    	break; 
                    tmtime.tm_year = ldread (&Arg1[0],2);
                    if (tmtime.tm_year < 70)
                    	tmtime.tm_year += 100;
                    else if (tmtime.tm_year >= 1900)
                    	tmtime.tm_year -= 1900;
                    tmtime.tm_mon = ldread (&Arg1[2],2)-1; 
                    tmtime.tm_mday = ldread (&Arg1[4],2); 
                    tmtime.tm_hour = ldread (&Arg1[7],2);  
                    tmtime.tm_min = ldread (&Arg1[10],2);  
                    tmtime.tm_sec = ldread (&Arg1[13],2);  
                    break;
			}
               
    		tmtime.tm_isdst = -1;
    		if (!tmtime.tm_mday)
    			tmtime.tm_mday = 1;
    		systime = mktime (&tmtime);  
			ltoa ((long)systime,OutLoc,10);
			goto Rtnl;

		}
		case 306: /* $HLT(CLEAR) clears highlight list*/
				  // $HLT(ROUTE,routefilepathname,REFNO,display(YNTF10)); 
		{	   
			BOOL	FromLimits, Immediate; 
			
			
			if (!_fstrcmp(Args,"COUNT"))
			{
				nlong = BT_NUM_IN_INDEX (hHighlight);
				ltoa (nlong,OutLoc,10); 
				goto Rtnl;
			}
			if (!_fstrcmp(Args,"CLEAR"))
			{
				ClearHighlightList(FALSE); 
				goto RtnTrue;
			}
			if (!_fstrcmp(Args,"VIEWPORT"))
			{
				nlong = HighlightInArea (CurView->hWnd,&CurView->WBounds,TRUE,TRUE);
				ltoa (nlong,OutLoc,10); 
				goto Rtnl;
			} 
			if (!_fstrcmp(Args,"AREA"))
			{
				nlong = HighlightInArea (CurView->hWnd,NULL,TRUE,TRUE);
				ltoa (nlong,OutLoc,10); 
				goto Rtnl;
			} 
			if (!_fstrcmp(Args,"EDLIM"))
			{
    			if (!GetLayerBounds (&Bounds,CurView->hDC, CurView->UpdateFile-1))
    			 	goto RtnFalse;
				HighlightInArea (CurView->hWnd,&Bounds,TRUE,TRUE);
				goto RtnTrue;
			} 
			if (!_fstrcmp(Args,"UNHLT"))
			{   
				long	StartRef=LONG_MIN;
				HANDLE	hHlt = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(HIGHLIGHTDATA));
				LPHIGHLIGHTDATA	pHighlightData = (LPHIGHLIGHTDATA)GlobalLock (hHlt);

				while (!BT_FIND (hHighlight,(LPSTR)&StartRef,BT_FIRST,BT_GT,(LPSTR)pHighlightData))
				{
					PickList[0]=pHighlightData->PD;
				    RemoveFromHighlightList (StartRef,2);
			    	ShowPickedItem (CurView->hWnd,0); 
				    RemoveFromHighlightList (StartRef,0);
			    	ShowPickedItem (CurView->hWnd,0); 
				}
				ClearHighlightList(FALSE);   
				GSSiGlobUlFree (&hHlt);
				goto RtnTrue;
			} 
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*5);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			Arg4 = Arg3 + 2048; 
			Arg5 = Arg4 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!_fstrcmp(Arg1,"BOUNDS"))
			{   
				ExpandText (Arg2); 
				Bounds = atobounds (Arg2,&Err);
				if (Err)
					goto RtnFalse;
				nlong = HighlightInArea (CurView->hWnd,&Bounds,TRUE,TRUE);
				ltoa (nlong,OutLoc,10); 
				goto Rtnl;
			} 
			if (!_fstrcmp(Arg1,"COPY"))
			{   
				if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
				ExpandText (Arg2); 
				ExpandText (Arg3);
				FromLimits = atob (Arg2);//actually delete exiting items
				Immediate = atob (Arg3);//actually show status option
				if (CopyHighlightedRecords (FromLimits,Immediate))
					goto RtnTrue;
				goto RtnFalse;
			}
             
			if (!_fstricmp(Arg1,"ITEM"))
			{
				ExpandText (Arg2); 
				if ((lpColon = _fstrchr (Arg2,':')))
					*lpColon++=0;
				else 
				{
					Refno = atol (Arg2); 
					Arg2 = 0;
				}
	            if (!PickByRefno (Refno,Arg2,lpColon,-1))
					goto RtnFalse;
				else 
				{
			    	AddToHighlightList (PickList[0].Refno,&PickList[0],TRUE);
					goto RtnTrue;  
				}
			}
			if (!_fstricmp(Arg1,"PICKED"))
			{
				ExpandText (Arg2); 
				hNum = atol (Arg2);
			    AddToHighlightList (PickList[hNum-1].Refno,&PickList[hNum-1],TRUE);
				goto RtnTrue;
			}
			if (!_fstricmp(Arg1,"SAVE"))
			{
				ExpandText (Arg2); 
				if (!hHighlight) 
					goto RtnFalse;
	            if (CopyHighlightList (Arg2))
					goto RtnTrue;
				goto RtnFalse;
			}
			if (!_fstricmp(Arg1,"RECALL"))
			{
				ExpandText (Arg2); 
	            if (RecallHighlightList (Arg2))
					goto RtnTrue;
				goto RtnFalse;
			}
			if (!_fstricmp(Arg1,"REFNO"))
			{
				ExpandText (Arg2); 
				Refno = atol (Arg2);
				if (!PickByRefno (Refno,NULL,NULL,-1))
					goto RtnFalse;
			    AddToHighlightList (PickList[0].Refno,&PickList[0],TRUE);
				goto RtnTrue;
			}
			if (!_fstricmp(Arg1,"MACRO"))
			{
				if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
				ExpandText (Arg2); 
				ExpandText (Arg3);   
				if ((ParLoc = MatchLev (Arg3,',')))
				{
					_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
					*ParLoc = '\0'; 
				}
				else
					*Arg4 = 0;
				hNum = atol (Arg3);
				if (!RunHltMacro (Arg2,hNum,Arg4))
					goto RtnFalse;
				else
					goto RtnTrue;
			}
			if (!_fstricmp(Arg1,"ROUTE"))
			{
				if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
				if (!(ParLoc = MatchLev (Arg3,','))) goto Rtn0;
				_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
				ExpandText (Arg2); 
				ExpandText (Arg3);
				ExpandText (Arg4); 
				Refno = atol (Arg3);
				if (!HighlightRoute (Arg2,Refno,0,TORF))
					goto RtnFalse;
				else
					goto RtnTrue;
			}
				
			if (!(ParLoc = MatchLev (Arg4,','))) goto Rtn0;
			_fstrcpy (Arg5,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg2); 
			hNum = atol(Arg2);
			ExpandText (Arg3);
			Offset = atof(Arg3);
			ExpandText (Arg4);  
			FromLimits = atoi(Arg4);
			ExpandText (Arg5);      
			Immediate = atoi(Arg5);
			
		//	ZoomToHltItem (hNum,Offset,FromLimits,Immediate);
			goto RtnTrue;
		} 
		case 307: /* $ZMV(view) returns zoomed view */
		{	double	rval; 
			int		iview;
			int		ndec, ntoadd; 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			iview = IDNINT(rval); 
