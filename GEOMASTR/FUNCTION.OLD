		case 627: //$RUNSQL ()
        {   
        	LPSTR pStatusText, pLoopText=0; 
        	HANDLE	hDB=0;
        	long	nRecs=0, TotRecs=0; 
        	HCURSOR	hcurSave=0;
        	
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*4);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			Arg4 = Arg3 + 2048;
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
            if ((pStatusText = _fstrchr (Arg1,'!')))
            	*pStatusText++ = 0; 
            	
			ExpandText (Arg2);
            if (!OpenDataFile (Arg1,Arg2,BT_READ,&hDB))
            	goto RtnFalse;
			hcurSave = GSSiSetCursor(LoadCursor(NULL, IDC_WAIT));
			if (pStatusText)
			{   
				if ((pLoopText = _fstrrchr (pStatusText,'!')))
					*pLoopText++ = 0;
		        while (FetchDBRec (hDB))
		        	TotRecs++;
				CloseDataFile (FALSE,&hDB);
				OpenDataFile (Arg1,Arg2,BT_READ,&hDB);
				GSSiSetCursor (hcurSave);
				CreateStatusWindow (CurView->hWnd,1,pStatusText);
		    } 
		    
	        while (ContinueProcessing && FetchDBRec (hDB))
	        {   
	        	_fstrcpy (Arg4,Arg3);
	        	ExpandText (Arg4); 
	        	nRecs++;
	            if (pStatusText)
					StatusWindowUpdate (NULL,pLoopText,TotRecs,nRecs);
            } 
            ContinueProcessing = TRUE;
			CloseDataFile (FALSE,&hDB);
            if (pStatusText)
				DestroyStatusWindow(); 
			else 
				GSSiSetCursor (hcurSave);
			ltoa (nRecs,OutLoc,10);  
            goto Rtnl;
		}
		
