		case 407: /* $FILL(val,len,fillchar) left fills val with fillchar to length len */ 
		{	double	rval;
			int		l, len; 
			LPSTR	lpOut; 
			char	fillchar;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			
			l = _fstrlen(Arg1);
			len = IDNINT(atof (Arg2));
			fillchar = *Arg3;
			lpOut = OutLoc;
			while (l++ < len)
				*lpOut++ = fillchar;
			_fstrcpy (lpOut,Arg1);
			goto Rtnl;
		} 
		
		case 408: // $OPEN(DBNAME,Optional SQL,Mode(R or W)) opens database
		{	 
			int		nRc;
			short	Mode=BT_READ; 
			HFILE	Fid;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			*Arg3 = 0;
			ParLoc = MatchLev (Args,',');
			if (ParLoc)
			{ 
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
			}
			else
				*Arg2=0;
			ParLoc = MatchLev (Arg2,',');
			if (ParLoc)
			{ 
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = 0; 
			}
			_fstrcpy (Arg1,Args);  
			ExpandText (Arg1);
			ExpandText (Arg2); 
			ExpandText (Arg3); 
			switch (*Arg3)
			{
				default:
					Mode = BT_READ; 
				break;
				
				case 'W':
				case 'w':
					Mode = BT_WRITE;
				break;
			}

			{  

			    double      rtn;
			    
			    rtn = FALSE;
			    hSQL=0;
			    if (!OpenDataFile (Arg1,Arg2,Mode,&hSQL))
			        goto RtnFalse;
            } 
			goto RtnTrue;
		}
		
		case 409: /* $EDIT(Layer Name)  changes edit layer in current viewport*/
		{	
			long	ICmd; 
			short	i;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			Truncate (Arg1);
			CurView->UpdateFile = 0;
			if (!*Arg1)
				goto RtnTrue;
			for (i=0;i<CurView->NumFiles;i++)
			{  
				if (!_fstricmp (Arg1,CurView->FileID[i]))
					CurView->UpdateFile = i+1;
			} 
			if (CurView->UpdateFile)
			{
		   		_fstrcpy (EditName,CurView->lpFiles[CurView->UpdateFile-1]);
				GetLayerBounds (&EditBounds,CurView->hDC, CurView->UpdateFile-1);
				goto RtnTrue;
			}
			goto RtnFalse;
		}
		
		case 410: //$BOOL(str)
		{
			BOOL val;      
			short	irc;
			
			val = LogicP (Args,&irc);
		    if (irc)
		    {
		    	switch (irc)
		    	{
		    		case 1:
		    			SetGlobalValue ("%LASTERR","Non-numeric in numeric field");
		    			break;
		    		case 2:
		    			SetGlobalValue ("%LASTERR","Mismatched parenthesis");
		    			break;
		    		case 3:
		    			SetGlobalValue ("%LASTERR","Invalid expression");
		    			break;
		    		case 4:
		    			SetGlobalValue ("%LASTERR","Divide by 0");
		    			break;
		    		case 5:
		    			SetGlobalValue ("%LASTERR","Invalid operand");
		    			break;
		    	}
		    	SetGlobalValue ("%C","F");
		    	goto RtnFalse; 
		    }
		    if (val)
		    	goto RtnTrue;
		    else
		    	goto RtnFalse;
		}
		case 411: /* $INDX(string1,string2) returns 1 based position of string2 in string1 */ 
		{	long pos;
			LPSTR	loc;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			loc = _fstrstr (Arg1,Arg2);
			if (!loc) goto Rtn0; 
			pos = (long)loc - (long)Arg1 + 1;
			ltoa (pos,OutLoc,10);
			goto Rtnl;
		}

		case 412: /* $TEST(string1,string2,Message) tests string1 vs string2. If not same displays message and returns false */ 
		{	double	rval;
			int		l, len; 
			LPSTR	lpOut; 
			long	nrecs;
			LPSTR	pFile;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3); 
			if (!_fstricmp (Arg1,Arg2)) 
				goto RtnTrue;
			if (*Arg3)
           		GSSiMessageBox (Arg3,NULL,MB_ICONEXCLAMATION);
			goto RtnFalse;
		} 
		
		case 413: // $MASK(CLEAR)  
 		{	 
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			if (!(ParLoc = MatchLev (Args,',')))
				*Arg2 = 0;
			else 
			{
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			if (!(ParLoc = MatchLev (Arg2,',')))
				*Arg3 = 0;
			else 
			{
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			ExpandText (Arg2);  
			ExpandText (Arg3);  
			if (!_fstrcmp (Arg1,"CLEAR")) 
			{   
				ClearMaskArea (); 
				goto RtnTrue;
			} 
			else if (!_fstrcmp (Arg1,"SET")) 
			{       
				short	Item=atoi (Arg2);
				
				Dist = atof (Arg3);
				if (SetMaskArea(Item-1,Dist))
					goto RtnTrue;
			} 
			goto RtnFalse;
			
		}
		
		case 414: /* $SAVE(filenum) fetch next rec */
