			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!ExistFile (Arg1))
			{
				GSSiMessageBox (Arg1,"Unable to Access Image File",MB_ICONEXCLAMATION);
				goto RtnFalse;
			} 
			else
			{
				if (InInfoBox)
				{   
					sprintf (OutLoc,"$BITMAP(%s)",Arg1);
