		case 308: /* $MID(string,start,end) returns portion of string*/ 
		{	double	rval;
			int		ndec, start, len, end; 
			LPSTR	lpEnd;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			
			start = IDNINT(atof (Arg2));
			end = IDNINT(atof (Arg3));
			len = end - start + 1;
			l = _fstrlen(Arg1);
			if (len<=0 || start<=0) goto Rtn0;
			if (start <= l)
			{
				start--;
				Arg1+=start;
				_fstrncpy (OutLoc,Arg1,len); 
				lpEnd = OutLoc + len;
				*lpEnd=0;  
			}
			else 
			{
				*OutLoc = 0;
				l=0;        
			}
			goto Rtnl;
		}

