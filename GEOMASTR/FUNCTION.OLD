		case 501: /* $THEME(LOAD,theme,vpname(opt)) Loads and activates theme
						or
							(DEACT,vpname (opt)) deactivates theme 
						or  (SET,vp name) sets to theme in specified legend vp
						or	(REFCLASS,refno) returns class in current theme for specified refno
						*/
		{	 
			int		nRc; 
			
			SaveVP = CurView;      
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096+2048+256);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			*Arg3 = 0; 
			pOFStruct = (LPOFSTRUCT)(Arg2 + 2048); 
			if (!(ParLoc = MatchLev (Args,',')))
				*Arg2 = 0;
			else 
			{
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			_fstrcpy (Arg1,Args);
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			ExpandText (Arg1); 
			ExpandText (Arg2);  
			ExpandText (Arg3); 
			if (!_fstrcmp (Arg1,"ACT")) 
			{   
				SetCurView ( SetVPFromName (Arg2,&Err));
				if (!Err && CurView->pTheme)
				{
					CurView->pTheme->IsActive = TRUE; 
					rtn = TRUE;
				}
				else
					rtn = FALSE;   
				SetCurView ( SaveVP);
				goto Rtnrtn;
			}
			else if (!_fstrcmp (Arg1,"SELECTCLASS")) 
			{   
				if (SelectThemeClasses (-1))
					rtn = TRUE;
				else
					rtn = FALSE;
				goto Rtnrtn;
			}
			else if (!_fstrcmp (Arg1,"SET")) 
			{   
				SetCurView ( SetVPFromName (Arg2,&Err));
				if (!Err && CurView->pTheme)
				{
					CurTheme = CurView->pTheme; 
					rtn = TRUE;
				}
				else
					rtn = FALSE;   
				SetCurView ( SaveVP);
				goto Rtnrtn;
			}
			else if (!_fstrcmp (Arg1,"DEACT")) 
			{   
				SetCurView ( SetVPFromName (Arg2,&Err));
				if (!Err && CurView->pTheme)
				{
					CurView->pTheme->IsActive = FALSE; 
					rtn = TRUE;
				}
				else
					rtn = FALSE;   
				SetCurView ( SaveVP);
				goto Rtnrtn;
			}
			else if (!_fstrcmp (Arg1,"REFCLASS")) 
			{   
				short	class;
				long	refno;
				
				refno = atol (Arg2); 
				class = GetThemeRefClass (refno);
				itoa (class,OutLoc,10);
				goto Rtnl;  
			}
			else if (!_fstrcmp (Arg1,"CLOSE"))
			{  
				rtn = TRUE;
				SetCurView ( SetVPFromName (Arg2,&Err));
				if (!Err)
					CloseTheme();
				else
					rtn = FALSE;   
				SetCurView ( SaveVP);
				goto Rtnrtn;
			}
			else if (!_fstrcmp (Arg1,"LOAD"))  
			{
				if (*Arg3)
				{
					SetCurView ( SetVPFromName (Arg3,&Err));
					if (Err)
						goto RtnFalse;
				}
				CloseTheme();
				Truncate (Arg2);
				if (!*Arg2)
				{
					SetCurView ( SaveVP);
					goto RtnTrue;
				} 
				Fid = GSSiOpenFile (Arg2,(LPOFSTRUCT)pOFStruct,OF_READ);
				if (Fid == HFILE_ERROR)
				{
					if (!_fstrchr(Arg2,'\\'))
					{                
						HANDLE	hTemp=GSSiGlobAlloc (GMEM_MOVEABLE,256);
						LPSTR	Name=GlobalLock (hTemp);
						
						_fstrcpy (Name,"themes\\");
						_fstrcat (Name,Arg2); 
						if (!_fstrchr (Name,'.'))
							_fstrcat (Name,".thm");
						Fid = GSSiOpenFile (Name,(LPOFSTRUCT)pOFStruct,OF_READ);  
						GSSiGlobUlFree (&hTemp);
						if (Fid == HFILE_ERROR) 
						{
							SetCurView ( SaveVP);
							goto RtnFalse;
						} 
						SetCurVal (Name,IDS_FILETHM);  
					} 
					else  
					{
						SetCurView ( SaveVP);
						goto RtnFalse;
					}
				}
				else
					SetCurVal (Arg2,IDS_FILETHM);  
				ReadObject (Fid,TRUE,&CurView->pTheme,0); 
	            CurView->pTheme->DisplayViewport = CurView->ID; 
	            CurView->pTheme->IsActive = TRUE;
				GSSiClose (Fid);
				SetCurView ( SaveVP);
				goto RtnTrue;
			}
			else
			{
				SetCurView ( SaveVP);
				goto RtnFalse;
			}
			
		}
		
		case 502: /* $WHILE(statement,string) */
		{	 
			int		nRc; 
			HFILE	Fid;
			LPSTR	clause, WhileString;
			HANDLE	hMem1,hMem2;
			long	lmem1,lmem2;
			char	clause1;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,UINT_MAX);
			Arg2 = GlobalLock(hMem);
			if (!(ParLoc = MatchLev (Args,',')))
		   	    goto RtnFalse;
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			lmem2 = _fstrlen (Arg2);
			*ParLoc = 0;
			lmem1 = _fstrlen (Args);
NextWhile:  
			if (HaltReport)
				goto RtnFalse;
			hMem1 = GSSiGlobAlloc(GMEM_MOVEABLE,lmem1+4);
			clause = GlobalLock(hMem1); 
			_fstrcpy (clause,Args);  
			ExpandText (clause);   
			clause1 = clause[0];
			GlobalUnlock (hMem1);
			GlobalFree (hMem1);
			if (clause1 =='0')
				goto RtnTrue; 
			hMem2 = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			WhileString = GlobalLock(hMem2); 
			_fstrcpy (WhileString,Arg2);
			ExpandText (WhileString);
			GlobalUnlock (hMem2);
			GlobalFree (hMem2);			
			goto NextWhile;
		}
		
		case 503: /* $FETCH(filenum) fetch next rec */
		{				
			LPFIELDINFO	lpFieldInfo;
			LPOPENFILEDATA	FilePtr;
			LPOPENSQLDATA	SQLPtr;
			LPSQLFIELD	lpSQLField;
			LPFILEPATH	FilePathPtr;
			LPHANDLE	lpFileHandle; 
			int			irc=1, ifile,i;    
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
	        
	        if (!_fstricmp (Arg1,"HLTLIST"))
	        { 
	        	if (GetNextHLTListItem (FALSE))
	        		goto RtnTrue;
	        	else
	        		goto RtnFalse; 
	        }
            if (!FilePathHandle)
            	goto RtnFalse;
			FilePathPtr = (LPFILEPATH)GlobalLock (FilePathHandle);  
			lpFileHandle = &FilePathPtr->FileHandle;
            
			for (i=0;i<FilePathPtr->NumFiles;i++,lpFileHandle++)
			{
				if (*lpFileHandle)
				{
					SQLPtr = (LPOPENSQLDATA)GlobalLock (*lpFileHandle);
					if (!_fstrcmp (SQLPtr->IDName,Arg1))
						goto GotFile;
					GlobalUnlock (*lpFileHandle);
				} 
			}
			GlobalUnlock (FilePathHandle);
            goto RtnFalse;
            
GotFile:	irc = FetchDBRec (*lpFileHandle);
			GlobalUnlock (*lpFileHandle);
			GlobalUnlock (FilePathHandle);
			if (irc)
				goto RtnTrue;
			else
				goto RtnFalse;
		}

		case 504: /* $TABLE(database,SQL,SelectMacro) creates grid control from database using SQL */ 
		{	double	rval;
			int		l, len; 
			LPSTR	lpOut; 
			long	nrecs;
			LPSTR	pFile;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*4);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			Arg4 = Arg3 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);  
			_fstrcpy (UGridPickMacro,Arg3); 
			if ((ParLoc = MatchLev (Arg3,','))) 
			{
				_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
				*ParLoc = 0;
				ExpandText (Arg4);
				hGridSize = AllocateVar(Arg4);
            }
	    	if (!hScreenFile)
	    	{
		    	hScreenFile = GSSiGlobAlloc (GMEM_MOVEABLE,256);
	    		pFile = GlobalLock (hScreenFile);
	        	GetTempFileName (0,"gm",0,pFile); 
		    }
		    else
	    		pFile = GlobalLock (hScreenFile);
			if (OutputToFile (pFile,Arg1, Arg2, NULL,FALSE,TRUE,FALSE,0,0)) 
			{
	    		GlobalUnlock (hScreenFile);  
        		ShowGrid(hWndMain);
				goto RtnTrue;
			}
			else 
			{
	    		GlobalUnlock (hScreenFile);  
				goto RtnFalse;
			}
		} 
		
		case 507: // $CLOSE(fileid)
		{				
			LPFIELDINFO	lpFieldInfo;
			LPOPENFILEDATA	FilePtr;
			LPOPENSQLDATA	SQLPtr;
			LPSQLFIELD	lpSQLField;
			LPFILEPATH	FilePathPtr;
			LPHANDLE	lpFileHandle,lpFileHandle2; 
			int			irc=1, ifile,i;  
			HANDLE	hSQL;  
			BOOL	CloseAll=FALSE;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
	        if (!_fstricmp (Arg1,"HLTLIST"))
	        	goto RtnTrue;
			hSQL = atol (Arg1);
            if (!FilePathHandle)
            	goto RtnFalse;
	        
	        if (!_fstricmp (Arg1,"ALL"))
	        	CloseAll = TRUE;
CloseNext:
			FilePathPtr = (LPFILEPATH)GlobalLock (FilePathHandle);  
			lpFileHandle = &FilePathPtr->FileHandle;
            
			for (i=0;i<FilePathPtr->NumFiles;i++,lpFileHandle++)
			{   
				if (hSQL && hSQL == *lpFileHandle)
					goto GotCloseFilehSQL;
				if (*lpFileHandle)
				{
					SQLPtr = (LPOPENSQLDATA)GlobalLock (*lpFileHandle);
					if (CloseAll || !_fstrcmp (SQLPtr->IDName,Arg1))
						goto GotCloseFile;
					GlobalUnlock (*lpFileHandle);
				} 
			}
			GlobalUnlock (FilePathHandle);
            goto RtnFalse;
            
GotCloseFile:
			GlobalUnlock (*lpFileHandle);
			hSQL = *lpFileHandle;   
GotCloseFilehSQL:
			GlobalUnlock (FilePathHandle);
			CloseDataFile (FALSE, &hSQL);   
			if (CloseAll && FilePathHandle)
				goto CloseNext;
			goto RtnTrue;
		}

		case 508: // $SLEEP(Seconds)
		{				
			double	Seconds;
			time_t	MicroSecs;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			Seconds = atof (Arg1);
			MicroSecs = Seconds*1000; 
            Wait (MicroSecs);
	
			goto RtnTrue;
		}

		case 509: // $RESET()  resets the function stack - terminates active functions
		{				
    		
    		ResetFunStack (FALSE);
			goto RtnTrue;
    	} 
    	
		case 510: // $MACRO(macro file pathname,arg1,arg2...arg10)
		{				
			HANDLE	hMacroArgs=0;
			LPSTR	LastArg, pMacroArg,pName,pSTR, pPAR, pEnd;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4*2048);
			Arg1 = GlobalLock(hMem); 
			pName = Arg1 + 2048;
			pSTR = pName + 2048;   
			pOFStruct = (LPOFSTRUCT)(pSTR + 2048);
			if ((ParLoc = MatchLev (Args,',')))
			{
				*ParLoc++ = 0; 
				hMacroArgs=GSSiGlobAlloc(GHND,4096L*11);
				pMacroArg = GlobalLock (hMacroArgs);
				while (ParLoc)
				{   
					LastArg = ParLoc;
					if ((ParLoc = MatchLev (ParLoc,',')))
						*ParLoc++ = 0;
					_fstrcpy (pMacroArg,LastArg); 
					if (_fstricmp (Args,"INLINE"))
						ExpandText (pMacroArg);
					pMacroArg += 4096;
				}
				GlobalUnlock (hMacroArgs);
			}
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
	        
	        if (!(pPAR = _fstrchr (Arg1,'(')))
				ProcessMacroFile (Arg1,OutLoc,&hMacroArgs);
			else
			{   
				long	TotFiles=0;
				
				*pPAR++ = 0; 
				if ((pEnd = _fstrchr (pPAR,')')))
					*pEnd = 0;
				GetTempFileName(0,"gm",0,pName);
				Fid =	GSSiOpenFile (pName,pOFStruct,OF_CREATE);
				SearchFilesInDir (Arg1,NULL, Fid,&TotFiles,pPAR,1); 
				_llseek (Fid,0,0);    
				while (fgetstring (pSTR,256,Fid))
				{  
					ProcessMacroFile (pSTR,OutLoc,&hMacroArgs);
				}
				GSSiClose (Fid);			
				GSSiOpenFile (pName,pOFStruct,OF_DELETE);
			}
			GSSiGlobFree (&hMacroArgs);
			goto Rtnl;
		}   
		 
		case 511: // $IMAGE(image file pathname)
		{				
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
