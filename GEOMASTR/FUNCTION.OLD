			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			loc = _fstrrchr (Arg1,*Arg2);
