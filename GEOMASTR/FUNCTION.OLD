			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			*Arg3 = 0;
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0'; 
			ParLoc = MatchLev (Arg2,',');
			if (ParLoc)
			{ 
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = 0; 
			}
			_fstrcpy (Arg1,Args);  
			ExpandText (Arg1);
			ExpandText (Arg2); 
			ExpandText (Arg3);
			_fstrcpy (OutLoc,Arg1); 
			REPLAC (OutLoc,Arg2,Arg3,1024); 
			goto Rtnl;
		}  
		
		case 753: // $SYMPLOT(Parent,outfile,format) 
		{	 
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			*Arg3 = 0;
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0'; 
