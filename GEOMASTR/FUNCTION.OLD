		case 615:	// $BOUNDS(MAP,pathname) returns bounds of map 
					// $BOUNDS(REF,refno,(opt)picklayerid) returns bounds of refno  
					// $BOUNDS(POINT,point,dist) returns bounds from point and dist 
		{				
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*6);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048;
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc++ = '\0';  
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				*ParLoc++ = 0;
				_fstrcpy (Arg3,ParLoc);
			}
			else
				*Arg3 = 0;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);  
			ExpandText (Arg2); 
			ExpandText (Arg3); 
			
			if (!_fstricmp (Arg1,"MAP"))
			{   
				SetViewport (CommandViewport); 
				SelectVisList (FALSE); 
				if (!GetMapBounds (Arg2,&Bounds))
					goto RtnFalse;
				sprintf (OutLoc,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmx,Bounds.ymx);
				goto Rtnl;  
			} 
			else if (!_fstricmp (Arg1,"POINT"))
			{   
				Point = atopt (Arg2,&Err);
				if (Err)
					goto RtnFalse; 
				Dist = atof (Arg3);
				Bounds.xmn = Point.x - Dist;
				Bounds.xmx = Point.x + Dist;
				Bounds.ymn = Point.y - Dist;
				Bounds.ymx = Point.y + Dist;
				sprintf (OutLoc,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmx,Bounds.ymx);
				goto Rtnl;  
			} 
			else if (!_fstricmp (Arg1,"REF"))
			{   
				short	PickFile, PickLayerID;
				
				PickLayerID = atoi (Arg3);
				if (!PickLayerID)
					PickFile = -1; 
				else
					PickFile = GetPickFile (PickLayerID);
				SetGlobalValue("%PICKLAYERID","0");
				Refno = atol (Arg2);
				if (!PickByRefno (Refno,NULL,NULL,PickFile))
					goto RtnFalse;
				Bounds = PickList[0].Rect;
				sprintf (OutLoc,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmx,Bounds.ymx);
				goto Rtnl;  
			} 
			
			else if (!_fstricmp (Arg1,"TAG"))
			{   
				short	PickFile, PickLayerID;  
				LPSTR	UDI;
				
				PickLayerID = atoi (Arg3);
