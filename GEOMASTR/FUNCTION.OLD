			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);  
			ExpandText (Arg2); 
		
			if (LoadTIN (Arg1,Arg2))
				goto RtnTrue;
			goto RtnFalse;
		}

		case 751: // $SYMTYPE(symname) 
		{	 
			short	itype;
			char	CTypes[4][2]={"p","P","L","A"};
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2);
			Arg1 = GlobalLock(hMem);
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			n = GetDictSymbolNumber (Arg1);
			itype = GetDictSymbolType (n);
            if (itype > 3)
            	*OutLoc = 0;
            else
            	_fstrcpy (OutLoc,CTypes[itype]);
