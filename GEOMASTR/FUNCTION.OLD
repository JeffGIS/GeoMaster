		case 514: // $ALERT(message,wave file) 
		{	double dist;
			COLORREF	Color[2]={RGB(255,0,0),RGB(255,255,0)};
			short	cycle=0;
			HANDLE	hSaveScreen=0; 
			long	ScreenID; 
			LPHANDLE	phSaveScreen=&hSaveScreen;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			GetClientRect (CurView->hWnd,&Rect);
			Point16 = RectMid (&Rect);
			Point = WinPtToBasePt (Point16); 
			SetWindowText (hWndMain,Arg1);
			sndPlaySound(Arg2,SND_ASYNC|SND_LOOP|SND_NODEFAULT); 
			do 
			{   
				if (hSaveScreen)
					phSaveScreen = NULL;
				DisplayMarker (Point,500,Arg1,1.0,0,Color[cycle%2],FALSE,FALSE,phSaveScreen,&ScreenID); 
				Sleep (1000); 
				cycle++;
			}
			while (!WaitForKeystroke ());
			RestoreScreen2 (CurView->hDC, hSaveScreen,ScreenID);
		    DestroySavedScreen (&hSaveScreen,ScreenID);
			sndPlaySound(NULL,SND_ASYNC);			
			goto RtnTrue;
		}
		
