		case 310: /* $TAB(tabnum) tabs to numbered tab loc */
		{	double	rval; 
			int		itab;
			int		ndec, lc, ntoadd; 
			
			if (!CurReport)
				goto RtnFalse;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			if (!rread (Arg1,&rval,&ndec)) goto Rtn0;
			itab = max (1,IDNINT(rval)); 
			if (CurReport->hScrollLine)
			{    
				LPSTR	pLine;  
				float	DBU; 
				int		lline, CurLoc;  
				int	Tabloc, i, nTabs;  
				LPSTR	lpTab, LastTab;
				
				pLine = GlobalLock (CurReport->hScrollLine);   
				nTabs = 0;
				lpTab = pLine;
				LastTab = pLine;  
				DBU = (float)(LOWORD(GetDialogBaseUnits())) / 2;
				i=0;
				while ((lpTab = _fstrchr(lpTab,'\t')))  
				{    
					LPSTR	lpBeg;
					
					lpBeg = LastTab; 
					if (lpBeg != pLine)
						lpBeg++;
					*lpTab = 0;
					lline = _fstrlen (lpBeg);
					*lpTab = '\t';
					if (CurReport->TabLen[0])
	                	i += (IDNINT((DBU * lline)))/CurReport->TabLen[0];
					LastTab = lpTab++;
					i++;
				} 
				if (i)  
				{    
					LastTab++;
					if (CurReport->NumTabs < i)
						CurLoc = CurReport->TabLen[0]*i;
					else
						CurLoc = CurReport->TabLen[i-1];  
				}	
				else
					CurLoc = 0;
				lline = _fstrlen (LastTab); 
                CurLoc += IDNINT((DBU * lline));
				Tabloc = 0;
				i=0; 
				while (Tabloc <= CurLoc)
				{
					i++;
					if (CurReport->NumTabs < i)
						Tabloc += CurReport->TabLen[0];
					else
						Tabloc = CurReport->TabLen[i-1];  
				} 
				i--;
				itab -= i;
				while (itab-->0)
					_fstrcat(pLine,"\t");
				GlobalUnlock (CurReport->hScrollLine);
			}
			else 
			{   
				int	Tabloc, i;  
				
				Tabloc = CurReport->Rect.left; 
				i=0;
				while (itab--)
				{
					i++;
					if (CurReport->NumTabs < i)
						Tabloc += CurReport->TabLen[0];
					else
						Tabloc += CurReport->TabLen[i-1];  
				} 
				CurReport->x = Tabloc;
			}
			goto RtnTrue;
		}

		case 312: /* $CMD(cmdid) invokes menu command */
		{	
			long	ICmd;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			ICmd = GetCmdID (Arg1); 
			if (ICmd < 0)
			{   
				ICmd = -ICmd;
				if (!CurView)
					SetViewport (CommandViewport); 
				AddGraphicsCmd (CurView->hWnd,Arg1,FALSE,0); 
				SetCurView ( SaveVP);
			}	
		    else if (ICmd)
           		PostMessage(hWndMain, WM_COMMAND, (WPARAM)ICmd, 0L);
			else 
				goto RtnFalse;
			goto RtnTrue;
		}
		
