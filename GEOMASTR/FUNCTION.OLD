		case 505: // $TRNTO(Transformation file,Point)  transform point from 'to' coords to 'from' coords
		case 720: // $TRNFROM(Transformation file,Point)  transform point from 'to' coords to 'from' coords
			CvtDir = 1;
			if (FunID == 720)
				CvtDir = 2;
		{	 
			double	X,Y, OutX, OutY;
			short	n, Type; 
			HANDLE	hTran;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = 0;  
			}
			else
				*Arg3=0;
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			Type = atoi (Arg3);
			if (Type < 1 || Type > 3)
				Type = 1;
			
			if (sscanf (Arg2,"%Flf %Flf",&X,&Y) != 2)  
			{
				_fstrcpy (OutLoc,"Invalid Coordinate");
				goto Rtnl;
			}
			if (!(hTran=LoadTranFile(Arg1,CvtDir,Type)))
			{
				_fstrcpy (OutLoc,"Invalid Transformation File");
				goto Rtnl;
			}
			
		    TRANS2 (X,Y,&OutX,&OutY,hTran);  
			sprintf (OutLoc,"%.14lg %.14lg",OutX,OutY);
			CloseTRANS2 (&hTran);
			goto Rtnl;
		}
		case 506: // $CVTTO(convert file,Point) convert point between projections 
		case 721: // $CVTFROM(convert file,Point) convert point between projections  
			CvtDir=1;
			if (FunID==506)
				CvtDir=2;
		{	 
			short	n; 
			HANDLE	hTran;
			DPOINT	Point;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			
			if (sscanf (Arg2,"%Flf %Flf",&Point.x,&Point.y) != 2)  
			{
				_fstrcpy (OutLoc,"Invalid Coordinate");
				goto Rtnl;
			}
			if (ConvertPoint (Arg1,&Point,CvtDir))
			{
				_fstrcpy (OutLoc,"Invalid Projection File");
				goto Rtnl;
			}
			sprintf (OutLoc,"%.14lg %.14lg",Point.x,Point.y);
			goto Rtnl;
		}
		
