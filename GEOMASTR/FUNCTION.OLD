			CurPage = IDNINT (atof(Arg2));
			TotPage = IDNINT (atof(Arg3));
			if (!atob(Arg1))
				hwnd = 0;
			else
				hwnd = hWndMain;
            rtn = PrintMap (hwnd,CurPage,TotPage);
