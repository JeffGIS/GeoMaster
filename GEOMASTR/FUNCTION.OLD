				goto RtnTrue;
			goto RtnFalse;
		}
		case 755: // $SYMDICT(COMPRESS) 
		{	 
			short	itype;
			char	CTypes[4][2]={"p","P","L","A"};
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2);
			Arg1 = GlobalLock(hMem);
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			if (!_fstricmp (Arg1,"COMPRESS"))
				CompressSymDict ();
			goto RtnTrue;
		}  
		break;    
		

		default:
			goto Rtn0;
	}
Rtnrtn:
	if (!rtn)
		goto RtnFalse;
RtnTrue: 
	l = 1;                
	_fstrcpy(OutLoc,"1");
	goto Exit;
RtnFalse: 
	l = 1;
	_fstrcpy(OutLoc,"0");
	goto Exit;
Rtn0:
	l = 0;
	goto Exit;
Rtnl:
	l = _fstrlen(OutLoc); 
Exit:
	GSSiGlobUlFree (&hMem);
	if (TraceType[0])
	{
		hMem=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
		lpstr = GlobalLock (hMem);
		sprintf (lpstr,"GFV:%s",Args);
		GSSiTraceLev (lpstr,-1);
		GSSiGlobUlFree (&hMem);
	}
	return (l);
}  

		
			
