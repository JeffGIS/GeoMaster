			ParLoc = MatchLev (Arg3,',');
			if (ParLoc)
			{ 
				_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
				*ParLoc = 0; 
			}
			_fstrcpy (Arg1,Args);
