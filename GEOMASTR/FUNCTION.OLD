			{
				if (DeleteTAGByName (Arg2))
					goto RtnTrue;
			}  
			if (!_fstricmp (Arg1,"CREATE")) 
			{   
				if (!_fstricmp (Arg3,"ITEM"))    
				{
					item = atoi (Arg4)-1;
					Point = PickList[item].PickedPoint;
				}
				else if (!_fstricmp (Arg3,"ZOOM"))    
					item = -2;
				else
					Point = atopt (Arg3,&Err);
				if (CreateTAGBoxFromFile (CurView->hDC,Point,Arg2,item))
					goto RtnTrue;
			}  
			goto RtnFalse;
		}
