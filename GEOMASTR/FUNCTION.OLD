			systime = atol (Arg1);
			tmtime = *localtime (&systime); 
			itoa (tmtime.tm_hour,OutLoc,10);                                              
			goto Rtnl;
			
		case 418: //$TRIM(maxdist) trims highligted data to last highlighted item 
