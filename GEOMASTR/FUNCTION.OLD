			{
				nSetVals=0;
				lSetVals=0;
				hSetVals = GSSiGlobAlloc (GHND,UINT_MAX);
			}
			pSetVals = GlobalLock (hSetVals); 
			pSetVals += lSetVals;
			_fstrcpy (pSetVals,Arg1);
			ln = _fstrlen (Arg1) + 1;
			pSetVals += ln;
			lSetVals += ln;
			_fstrcpy (pSetVals,Arg2);
			ln = _fstrlen (Arg2) + 1;
			lSetVals += ln; 
