			if (ParLoc)
			{ 
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = 0; 
			}
			_fstrcpy (Arg1,Args);  
			ExpandText (Arg1);
			ExpandText (Arg2); 
			ExpandText (Arg3);
