short GetSymbolTextStart (short symbol)
#if ENABLETRACE
{GSSiEnterProg (777);
#endif
{
	LPSHIELDS	pShields; 
	short		i=nShields, start=0;
	
	
	if (!hShields || !symbol)
{
#if ENABLETRACE
GSSiExitProg (777);
#endif
		return 0;
}
	pShields = (LPSHIELDS)GlobalLock (hShields);
	pShields += (symbol-1);  
	start = pShields->TextStart;
	GlobalUnlock (hShields);
{
#if ENABLETRACE
GSSiExitProg (777);
#endif
	return start;
}
#if ENABLETRACE
}
#endif
} 

