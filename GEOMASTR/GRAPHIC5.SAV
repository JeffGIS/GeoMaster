		BufType = TxtType;
		if (hDescBlock)
			BufDesc = idesc;
		else
			BufDesc = 0;
		MinMaxInit (&MinMax);
    }
	pBuf = GlobalLock (hBuf);
	pBuf += lbuf;
	MinMaxInit (&PtMinMax);
	if (size > 0)
	{   
		double	halfsize=size/2;
		RECT	SymRect = GetSymRect (idesc);
		
		pt1 = dnewpt (DPoint,rot,halfsize*(double)SymRect.right/1000);
		pt2 = dnewpt (pt1,rot+HALFPI,-halfsize*(double)SymRect.top/1000);  
		AddPointToMinMax (BasePtToFilePt(pt2),&PtMinMax);             
		pt2 = dnewpt (pt1,rot-HALFPI,halfsize*(double)SymRect.bottom/1000);
		AddPointToMinMax (BasePtToFilePt(pt2),&PtMinMax);   
		pt1 = dnewpt (DPoint,rot,halfsize*(double)SymRect.left/1000);
		pt2 = dnewpt (pt1,rot+HALFPI,-halfsize*(double)SymRect.top/1000);  
		AddPointToMinMax (BasePtToFilePt(pt2),&PtMinMax);   
		pt2 = dnewpt (pt1,rot-HALFPI,halfsize*(double)SymRect.bottom/1000);
		AddPointToMinMax (BasePtToFilePt(pt2),&PtMinMax);   
    }
    else
		AddPointToMinMax (Point,&PtMinMax); 
	PtMinMax.xmn--;
	PtMinMax.xmx++;
	PtMinMax.ymn--;
	PtMinMax.ymx++;  
	AddMinMax (&MinMax,&PtMinMax);
	ltag = 0;
	if (Prefix) 
