	pBufBeg = pBuf;
	lBufBeg = lbuf;
	BufWrite(&pBuf,&lbuf,(HPSTR)&id,2);
	
	MinMaxLoc = pBuf;
	BufWrite(&pBuf,&lbuf,(HPSTR)&PtMinMax,8);
	item_len /= 2;
	item_len = -item_len;
	BufWrite(&pBuf,&lbuf,(HPSTR)&item_len,2); 
	id = 9 + 256 * ltag;
	BufWrite(&pBuf,&lbuf,(HPSTR)&id,2);
	BufWrite(&pBuf,&lbuf,(HPSTR)&NewRefno,4); 
