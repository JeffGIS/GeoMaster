			Offset = -1;
			BufWrite(&pBuf,&lbuf,(HPSTR)&Offset,4);
			id = 0;
			BufWrite(&pBuf,&lbuf,(HPSTR)&id,2);
			GlobalUnlock (hBuf);
			pBuf = GlobalLock (hBuf);
			loc = GetFileConnectOffset(BufType,BufDesc,MinMax,(short)lbuf,-1,pBuf);
		    GlobalUnlock (hBuf);
			GSSiGlobFree (&hBuf); 
			lbuf = 0; 
			CloseMap (TRUE);
