	call++; 
	if (hGRText && !SymbolIsVisible (idesc))
		TxtType = 2;

//	CurView->HaveBounds=FALSE;
	if (!idesc && (!hBuf || !lbuf))
{
#if ENABLETRACE
GSSiExitProg (740);
