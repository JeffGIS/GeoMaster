{
	HIGHLIGHTDATA	HighlightData;  
	long TLID;

	BT_FIND (hHighlight,(LPSTR)&TLID,BT_FIRST,BT_ANY,(LPSTR)&HighlightData);   
	PickList[0] = HighlightData.PD;
	ClearHighlightList (FALSE);
	GetPickName (0);   
	if (!_fstricmp (EditName,PickName))
