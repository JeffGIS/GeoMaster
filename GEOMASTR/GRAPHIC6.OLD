                (double)652653.961142,(double)696965.463514,
                (double)47187.860422,(double)88271.352328);
/*                MinMaxD.xmx,  
                MinMaxD.ymn,  
                MinMaxD.ymx, 
                MinMaxCoord.xmn, 
                MinMaxCoord.xmx, 
                MinMaxCoord.ymn, 
                MinMaxCoord.ymx);*/ 
    _lwrite (Fid,Coords,128);
    GSSiClose (Fid);
	return 0;
}


BOOL Report (LPSTR Name, LPSTR ViewportName, LPSTR Prefix, LPSTR UDI, long ref)
{   short iview;
    BOOL    rtn;
    LPVIEWPORT  UseView=0, SaveView;
     
    SaveView = CurView; 
    if (!_fstricmp (ViewportName,"SCROLL"))
    {
        DisplayScrollReport (Name,Prefix,UDI, ref);
        SetCurView ( SaveView);
        return rtn;
    }
    else if (_fstrstr (ViewportName,".TXT"))
    {
        ReportToFile (Name,Prefix,UDI, ref,ViewportName);
        SetCurView ( SaveView);
        return rtn;
    }
    else if (!_fstricmp (ViewportName,"NONE"))
    {
        ProcessMacroReport (Name,Prefix,UDI, ref);
        SetCurView ( SaveView);
        return rtn;
    }
    for (iview = 0; iview<NumViewports; iview++)
    {   
        SetCurView ( pViewports[iview]); 
        if (!_fstricmp (ViewportName,CurView->Name))  
        {
            UseView = CurView;
            break;
        }
        if (CurView->Type == 6)
        {   
            if (!UseView)
                UseView = CurView;
        }
    }
    if (!UseView)
        goto RtnFalse;
    
    SetCurView (UseView);
    if (Prefix)
    	_fstrcpy (CurView->Prefix,Prefix);  
    if (UDI)                  
    	_fstrcpy (CurView->UDI,UDI);
    CurView->ReportRefno=ref;
    UnloadReport (CurView->hReport);  
    CurView->hReport = LoadReport (Name);
    if (!CurView->hReport)
        goto RtnFalse;
    CurView->Active = TRUE;
    CurView->ShrinkToFit=FALSE; 
    CurView->CurZoomAreaRef = 0;
    RedisplayViewport(TRUE,FALSE);
    SetCurView (SaveView);
    
    return TRUE; 
    
RtnFalse:
    SetCurView ( SaveView);
    return FALSE;
}  

void DestroySavedZooms (void)
{ 
    LPSAVEDZOOM pSavedZoom;
    LPSHORT   pNumSavedViews;

	if (hSavedZooms)
	{
	    pNumSavedViews = (LPSHORT)GlobalLock (hSavedZooms);
	    pNumSavedViews++;
	    pSavedZoom = (LPSAVEDZOOM)pNumSavedViews;
	    GSSiGlobFree (&pSavedZoom->hMask);
	    GSSiGlobUlFree (&hSavedZooms);
	}
	return;
}
 
void SaveZooms (LPMNMXCORD pBounds)
{   
    LPSAVEDZOOM pSavedZoom;
    short iview; 
    LPSHORT   pNumSavedViews;
    
    DestroySavedZooms ();
    if (!NumViewports)
    	return;
    hSavedZooms = GSSiGlobAlloc (GHND,NumViewports*sizeof(SAVEDZOOM)+sizeof(short));
    pNumSavedViews = (LPSHORT)GlobalLock (hSavedZooms);
    *pNumSavedViews = 1;
    pNumSavedViews++;
    pSavedZoom = (LPSAVEDZOOM)pNumSavedViews; 
    if (pBounds)
    {
	    pSavedZoom->HaveBounds = TRUE;
	    pSavedZoom->Bounds = *pBounds; 
	    iview = 0;
	} 
    else
    {
	    iview = CommandViewport-1;
	    pSavedZoom->HaveBounds = pViewports[iview]->HaveBounds;
	    pSavedZoom->Bounds = pViewports[iview]->WBounds;
	    pSavedZoom->hMask = pViewports[iview]->hMaskArea;
	    pSavedZoom->NumMaskPoints = pViewports[iview]->NumMaskPoints; 
	    pViewports[iview]->hMaskArea = 0; 
	    pViewports[iview]->NumMaskPoints = 0;
	}
    _fstrcpy (pSavedZoom->Name,pViewports[iview]->Name);
    GlobalUnlock (hSavedZooms);
    
    return;
}

void TransferSavedZoom (void)
{   
    LPSAVEDZOOM pSavedZoom;
    LPSHORT   pNumSavedViews;
    short iview, nsv, isv;

    if (!hSavedZooms)
    	return; 
    
    pNumSavedViews = (LPSHORT)GlobalLock (hSavedZooms);
    nsv = *pNumSavedViews;
    pNumSavedViews++;
    iview = CommandViewport-1;
    pSavedZoom = (LPSAVEDZOOM)pNumSavedViews;
    if (pSavedZoom->HaveBounds && !pViewports[iview]->HaveBounds)
    {
        pViewports[iview]->WBounds=pSavedZoom->Bounds;  
        pViewports[iview]->NewBounds=pSavedZoom->Bounds;  
        pViewports[iview]->HaveBounds=TRUE;  
        pViewports[iview]->WindowIsZoomed=TRUE;  
        GSSiGlobFree (&pViewports[iview]->hMaskArea);
        pViewports[iview]->hMaskArea = pSavedZoom->hMask;  
        pSavedZoom->hMask = 0;
        pViewports[iview]->NumMaskPoints = pSavedZoom->NumMaskPoints;
    }
    GSSiGlobFree (&pSavedZoom->hMask);
    GSSiGlobUlFree (&hSavedZooms);
    return;
}
BOOL GetVisBounds (LPMNMXCORD	pBounds,HDC hDC)
{ 
	short	FileNum;
	HANDLE	handle;
	BOOL	rtn=FALSE; 
	
	SelectVisList (FALSE); 
	DBoundsInit (pBounds); 
	if (!CurVis)
	    return FALSE;
	
	CurView->HaveBounds = TRUE;
    for (FileNum=0;FileNum<CurView->NumFiles;FileNum++)
    {    
    	 CurView->CurFile = FileNum;
	     if (!CurVis->FileIsVisible[CurView->CurFile])
	     	goto NextFile; 
	     if (!AutoTypeConvert ())
	     	goto NextFile;
    	 PltType = CurView->FileType[CurView->CurFile];
		 if (PltType<4)
		 {
		     _fstrcpy (PltName,CurView->lpFiles[CurView->CurFile]); 
		     if (!OpenMap (CurView->hWnd,hDC))
		     	goto NextFile;
		     CloseMap (FALSE);
		 }
         else if (PltType <= 5) 
         {
         	if (_fstrstr(CurView->lpFiles[CurView->CurFile],"FILELIST.TXT"))  
         	{
				GetBinFileBounds (CurView->lpFiles[CurView->CurFile],pBounds);
         		goto NextFile; 
         	}
         	else
         	{
				handle = OpenMapIndex (CurView->lpFiles[CurView->CurFile]);
            	CloseMapIndex (CurView->lpFiles[CurView->CurFile],handle,FALSE);
            } 
         }
         else
         	goto NextFile;
		pBounds->xmn = min (pBounds->xmn,CurView->FileMNMX.xmn);
		pBounds->xmx = max (pBounds->xmx,CurView->FileMNMX.xmx);
		pBounds->ymn = min (pBounds->ymn,CurView->FileMNMX.ymn);
		pBounds->ymx = max (pBounds->ymx,CurView->FileMNMX.ymx); 
		rtn = TRUE;
NextFile:;
	}
	return rtn;
} 

BOOL GetLayerBounds (LPMNMXCORD	pBounds,HDC hDC, short FileNum)
{
	HANDLE	handle;
	BOOL	SaveHaveBounds=CurView->HaveBounds;
	BOOL	rtn=FALSE; 
	
	if (FileNum < 0 || FileNum+1 > CurView->NumFiles)
		return FALSE;
	DBoundsInit (pBounds);
	
	CurView->HaveBounds = TRUE;
	PltType = CurView->FileType[FileNum];
	if (PltType<4)
	{
		 _fstrcpy (PltName,CurView->lpFiles[FileNum]); 
		 OpenMap (CurView->hWnd,hDC);
		 CloseMap (FALSE);
	}
	else if (PltType <= 5) 
	{
		if (_fstrstr(CurView->lpFiles[FileNum],"FILELIST.TXT"))
		{
			rtn = GetBinFileBounds (CurView->lpFiles[FileNum],pBounds);
			goto Exit;
		}
		else
		{
			handle = OpenMapIndex (CurView->lpFiles[FileNum]);
			CloseMapIndex (CurView->lpFiles[FileNum],handle,FALSE);
		} 
	}
	else
		goto Exit;
	pBounds->xmn = min (pBounds->xmn,CurView->FileMNMX.xmn);
	pBounds->xmx = max (pBounds->xmx,CurView->FileMNMX.xmx);
	pBounds->ymn = min (pBounds->ymn,CurView->FileMNMX.ymn);
	pBounds->ymx = max (pBounds->ymx,CurView->FileMNMX.ymx); 
	rtn = TRUE;
Exit:
	CurView->HaveBounds = SaveHaveBounds;
	return rtn;
}

	