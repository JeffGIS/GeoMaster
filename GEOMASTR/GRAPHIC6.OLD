BOOL DeleteItems (HWND hWnd, WORD Message, WORD wParam, LONG lParam,short function)
{
 switch (Message)
   {
   	case GF_INIT:  
   		DeleteHighlightedItems (function);
        PostMessage(hWnd, WM_COMMAND, GF_CANCEL, 0L);
   		break;

	case WM_COMMAND:
		if (wParam != GF_CANCEL)
			return FALSE;
   		RemoveGraphicsFunction (hWnd);
		break;
    case WM_LBUTTONUP:
    	break;
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

BOOL DeleteHighlightedItems (short Function)
{   
	HIGHLIGHTDATA	HighlightData;
	short pos=BT_FIRST;
	long	Loc,Ref;
	BTHEAD	BTHead;  
	char	Mess[128], Type[12]="Delete"; 
	short	OldType=12,NewType=92; 
	HCURSOR hcurSave;  
						
	
	if (!hHighlight)
	{   
		MessageBox (GetFocus(),"No items highlighted",NULL,MB_ICONEXCLAMATION);
		return FALSE;
	}
	if (Function == GF_UNDELETE_HIGHLIGHTED_ITEMS)
	{
		OldType = 92;
		NewType = 12;
		_fstrcpy (Type,"Un-delete");
	}
	GetBTHeader (hHighlight,&BTHead); 
	if (GetGlobalBVal2("[%DeletePrompt]",TRUE))
	{
		if (BTHead.BT_NUMRECS > 1)
			sprintf (Mess,"%s these %ld records?",Type,BTHead.BT_NUMRECS); 
		else
			sprintf (Mess,"%s this record?",Type);
		if (MessageBox(hWndMain,Mess,"Verify Delete", MB_YESNO) != IDYES)
			return FALSE;
	}
    hcurSave = GSSiSetCursor(LoadCursor(0, IDC_WAIT));
    while (!BT_FIND (hHighlight,(LPSTR)&Ref,pos,BT_ANY,(LPSTR)&HighlightData))
    {
    	pos=BT_NEXT;
    	if (HighlightData.Show)
    	{   
			PickList[0]=HighlightData.PD; 
   			if (!CurView->UpdateFile || ((PickList[0].FileNum+1) == CurView->UpdateFile))
				DeletePickedItem (0,OldType,NewType);
   			else
   			{   
   				short	DeleteType;
   				
   				switch (HighlightData.PD.Type)   //Point","Line","Area","Text","Curve"
   				{
   					case 1:
   					case 2:            
   					case 4:
   					case 5:
   					default:
   						DeleteType = 1;
   						break;
   					case 3:
   						DeleteType = 0;
   				}
   				_fstrcpy (PltName,CurView->lpFiles[CurView->UpdateFile-1]);
	    		PltType = 2;
				AddPolyToMap (0,NULL, NULL,DeleteType,Ref,NULL,-1,PickList[0].Desc,NULL,PickList[0].Prefix,PickList[0].UDI,-1,-1,0,0,0,0,0,FALSE);
				CloseMap(TRUE);
				CloseRefIndex();    		
	    		ForceRefIndex = ForceTAGIndex = FALSE;
   			}
		}
	} 
	GSSiSetCursor (hcurSave);
	ClearHighlightList(FALSE);
	return TRUE;      		                 
} 

BOOL ChangeDesc (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
	static short	NewDesc;
	static	char	NewSymbolSave[80];
   	char	SymName[34];   
 char key;     
 switch (Message)
   {
    case GF_CLOSE:  
    	SetGlobalValue ("%NEWSYMBOL",""); 
    	return FALSE;
    	break;
    	 
   	case GF_INIT:  
   		NewDesc = 0;
		if (!SetEditName (FALSE))
			break;
       	GetGlobalCVal ("[%NEWSYMBOL]",NewSymbolSave,NULL);
       	AddLBUTTON = TRUE;
       	return GF_READY_TO_PROCESS;
   		break;

    case GF_EXECUTE:
    case WM_LBUTTONUP:
    {
		short	Item; 
		POINT	MousePoint;
		DPOINT	BasePoint;
    	short	ID, rtn;  
    	HFILE	Fid; 
		float	SymSize, SymRot;
    	OFSTRUCT	OFStruct; 
    	long	Ref; 
   		BOOL	SaveDisableHalt= DisableHalt;

        if (Message == GF_EXECUTE)
        	Item = 0;
        else
        {
	    	MousePoint = MAKEPOINT(lParam);
		    if (!CurView->hTranWinToBase) break;
	        BasePoint=WinPtToBasePt(MousePoint);
	        PickItems (hWnd,BasePoint);
        	if (!NumPicked)
        		break;
        	Item = NumPicked-1; 
        	NewDesc = 0;
        }
   		if (NewDesc<=0)
   		{
			if (*NewSymbolSave)
				NewDesc = GetDictSymbolNumber(NewSymbolSave);
			else
	       		switch (PickList[Item].Type)
	       		{
		       		case 1:   
		       			_fstrcpy (SymName,"[%NEW_POINT_SYM]"); 
		       			ExpandText (SymName);
						NewDesc = SelectPointSymbol (hWnd,1,SymName,"All",NULL,NULL,NULL,FALSE);
						break;
					case 2:
		       			_fstrcpy (SymName,"[%NEW_LINE_SYM]"); 
		       			ExpandText (SymName);
					    NewDesc = SelectLineSymbol (hWnd,1,SymName,NULL,NULL,FALSE);
		                break;
				                 
					case 3:
		       			_fstrcpy (SymName,"[%NEW_AREA_SYM]"); 
		       			ExpandText (SymName);
					    NewDesc = SelectAreaSymbol (hWnd,1,SymName,NULL,FALSE);
					    break;  
				}
		}
				 
        GetPickName (Item);   
		if (!CurView->UpdateFile || !_fstricmp (EditName,PickName))
		{
		    CurDescLoc=0;
			ProcessPickedItem (Item,FALSE);        		
	       	if (CurDescLoc)
	       	{   
	    	    DisableHalt = TRUE;
		       		
				if (NewDesc>0)
				{
					Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
					if (Fid != HFILE_ERROR)
					{
						_llseek (Fid,CurDescLoc,0);
						_lread (Fid,&ID,2);
						if (ID == 8)
							_lwrite (Fid,&NewDesc,2);
						GSSiClose (Fid);
						if (!GetSymbolName (NewDesc,SymName,NULL,2,NULL))
						{   
							HANDLE	hSymDesc=0;
							short	NumSyms=0;
								
				    		_fstrcpy (PltName,PickName);
				    		PltType = 2;
							AddToSymList (NewDesc,&NumSyms,&hSymDesc); 
							AddSymToMap (NumSyms,hSymDesc,0,NULL); 
			                DestroySymList (&NumSyms,&hSymDesc);
						} 
					}
				}
			}
		}	
		else
		{
			UpdateItem=8; 
			NewSymbol = NewDesc;
			UpdateRecord (0,NewSymbol,NULL,NULL,NULL,NULL,1);
		}
					
					
		DisableHalt = SaveDisableHalt;  
		if (Message == GF_EXECUTE) 
			break;

    }
    
    case GF_EXECUTE_FINISHED:  
    {
	}
		break;
    
    default:
    	return (FALSE);
    }
    return (TRUE);
} 

BOOL CreateSpecial (void)
{	BTVARDESC	BTVar[1];
    char	SpecialFile[144];
    
	if (hSpecial)
		return FALSE;
	GetTempFileName (NULL,"spc",NULL,(LPSTR)SpecialFile);
	BTVar[0].BT_VARTYP=BT_INTEGER;
	BTVar[0].BT_VARLEN=4;
	BTVar[0].BT_VAROFF=0;
	BT_CREATE (SpecialFile, sizeof(SPECIALDATA), FALSE, 1, 1,(LPBTVARDESC)BTVar,FALSE, 0, 0, FALSE);
	hSpecial = BT_OPEN (SpecialFile, 0, BT_WRITE, 0);
	return TRUE;
}

void ClearSpecial (void)
{
	if (!hSpecial)
		return;
	BT_CLOSEANDDELETE (&hSpecial);
	return;
}

BOOL AddSpecial (long Ref,short Type,COLORREF Color,short Width)
{
	SPECIALDATA	SpecialData;
	
	if (!hSpecial)
		return FALSE;
	SpecialData.Type = Type;
	SpecialData.Color = Color;
	SpecialData.Width = Width;
	BT_PUT (hSpecial,(LPSTR)&Ref,(LPSTR)&SpecialData);
	return TRUE;
}

void SetPickCursor (BOOL InPick)
{   
	HCURSOR	hCursor;
	
	if (InPick) 
		SetCurs (1,FALSE);  
	else
		SetCurs (OldCursor,FALSE);
	return;
}  

HCURSOR VPCursor (HWND hWnd)
{   
	POINT	CursorPoint;
	LPVIEWPORT	SaveView; 
	short	iview;
	
	if (idTimer)
		return (LoadCursor (0,IDC_UPARROW));
	if (hCursor == hWaitCursor || CursorIsGlobal)
		return (hCursor);  
		
	GetCursorPos (&CursorPoint); 
	ScreenToClient (hWnd,&CursorPoint);
    SaveView = CurView;
	iview = NumViewports; 
	hCursor = 0;
    while (iview--)
    {   SetCurView ( pViewportsD[iview]); 
        if (CurViewActive())
        	if (PtInRect (&CurView->Rect,CursorPoint))
        {   
        	hCursor = CurView->hCursor;    
        	if (hCursor == 1)
        		hCursor = CurPickCursor; 
        	else if (hCursor == 2)
        		hCursor = hDigCursor; 
        	else if (!hCursor)
        		hCursor = DefaultCursor;
		    goto Exit;
        }
    } 
Exit:
    SetCurView ( SaveView);
    return hCursor;
} 

void SetCurs (HCURSOR hCurs,BOOL Global)
{   
	LPCMDSTRING    pCmdStr;
	short	ii;
    
    if (hCurs == CurPickCursor)
    	ii=1;
	CursorIsGlobal = Global; 
	if (!Global && CurView->FunStackHandle)
	{
    	pCmdStr = (LPCMDSTRING)GlobalLock (CurView->FunStackHandle);
		pCmdStr->hCursor = hCurs;
		GlobalUnlock (CurView->FunStackHandle);
    }
	if (!hCurs)
	{
		GSSiSetCursor (DefaultCursor);  
		if (!CursorIsGlobal)
			CurView->hCursor = 0;
		hCursor = 0;
		return;     
	}
	if (CursorIsGlobal)     
		hCursor = hCurs;
	else 
	{   
//		CurView->LastCursor = CurView->hCursor;
		CurView->hCursor = hCurs; 
		if (hCurs == 1)
			hCurs = CurPickCursor;  
		if (hCurs == 2)
			hCurs = hDigCursor;  
	}             
	GSSiSetCursor (hCurs);
	return;
}

void ResetLastCursor (void)
{          
	SetCurs (CurView->LastCursor,FALSE);
	return;
}

BOOL SetNewRefno (LPSTR EditFile,long Refno)
{
    HFILE	Fid;
	char	str[128]; 
	char	NewRefnoPath[128]; 
	OFSTRUCT	OFStruct;
	LPSTR	lpBS;
	
	_fstrcpy (str,EditFile);
	ExpandText (str);
	_fullpath (NewRefnoPath,str,128);
	lpBS = _fstrrchr (NewRefnoPath,'\\');
	*lpBS = 0;
	_fstrcat (NewRefnoPath,"\\nextref.txt");
	Fid = GSSiOpenFile (NewRefnoPath,&OFStruct,OF_DELETE);  
	SetGlobalValueLong ("%INITIALREFNO",Refno); 
	Refno = GetNewRefno(EditFile,NULL,NULL,NULL,NULL);
	return TRUE; 
} 

