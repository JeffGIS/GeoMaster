					     TestPoint  = BasePtToWinPt(&BasePoint);
					  }
                         st =  CURVPLT(OutArea->Lines, &np,  &lpPoint);
                         
                    }
               }
               *lpPoint = TestPoint;
               lpPoint = lpPoly;
