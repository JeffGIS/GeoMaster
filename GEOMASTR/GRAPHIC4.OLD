               		hPen = CreatePen (PS_SOLID,6,RGB(255,0,0));
                    OldPen = SelectObject (CurView->hDC,hPen);
                    i = Polyline (CurView->hDC,lpPoly,np);*/
                    GSSiGlobUlFree (&heap_ptr); 
                   /*                          
