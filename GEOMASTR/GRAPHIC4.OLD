                hDPoints = GSSiGlobAlloc (GMEM_MOVEABLE,(long)np*sizeof(DPOINT));
                lpDPoints = (HPDPOINT)GlobalLock (hDPoints);
                for (i=0;i<np;i++,lpPoint++,lpDPoints++)
					*lpDPoints = WinPtToBasePt(*lpPoint);
				GlobalUnlock (hDPoints);
               
                
