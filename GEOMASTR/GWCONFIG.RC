    MORE_SV_FIELD_VALUE     "#GMEXPRESSIONS"
    PRMT_IDC_SETSQL         "Invokes the SQL builder. (-more-)"
    MORE_IDC_SETSQL         "#SQLBUILDER"
    PRMT_IDC_SQL            "Contains the SQL statement used to retrieve the sppropriate attribute information for each graphic element. (-more-)"
    MORE_IDC_SQL            "#SQLTHEME"
    PRMT_SV_NUM_CLASSES     "Specifies the number of classes the elements will be grouped into. There is a limit of 16 classes per theme. (-more-)"
END

STRINGTABLE
BEGIN
    PRMT_SV_MAXVAL          "Sets the upper value for highest class. Elements with values above this will be placed into the highest class."
    PRMT_IDC_ROUND_TO       "Specifies how the class range values are rounded. Only applies if the Recompute option is selected."
    PRMT_SV_CB_PERCENTILES  "Instructs the system to compute class ranges so as to put an even number of elements into each class."
    PRMT_SV_CB_EVENRANGES   "Instructs the system to compute class ranges of equal width through the range of values."
    PRMT_SV_CB_MANUAL       "Allows the user to specify the class ranges by selecting the Edit Ranges icon."
    PRMT_IDC_EDITRANGES     "Invokes the Class Range Editor allowing the user to manually set the class ranges and titles."
    PRMT_IDC_MISSING_OPT0   "If selected the system will mark elements with no associated attribute data. (-more-)"
    MORE_IDC_MISSING_OPT0   "Areas will be filled with question marks  lines will be drawn with dots."
    PRMT_IDC_MISSING_OPT1   "If selected elements with missing attribute records will not be displayed."
    PRMT_IDC_MISSING_OPT2   "If selected elements with missing attribute records will be displayed in their normal state."
    PRMT_IDC_MISSING_OPT3   "If selected, only graphics elements with missing attribute records will be displayed. (-more-)"
    MORE_IDC_MISSING_OPT3   "This applies only to the elements matching the Contents selection. Other visible items will be drawn as well."
    PRMT_SV_DISPLAY_DATAPOINTS 
                            "Places data points in the legend representing each element. Must be using Even Class Ranges. (-more-)"
    MORE_SV_DISPLAY_DATAPOINTS 
                            "These data points can be selected and a pointer will show which element it represents."
    PRMT_SV_INSERT_COMMAS   "Causes commas to be inserted into the class range values in the legend. Does not apply to Manual Ranges."
    PRMT_SV_DISPLAY_VALUE   "Instructs the system to display the attribute value on the graphics element. (-more-)"
END

STRINGTABLE
BEGIN
    MORE_SV_DISPLAY_VALUE   "Primarily intended for debugging - there is no guarentee of proper placement."
    PRMT_SV_CB_ZEROASMISS   "Instructs the system to treat a value of zero as a missing attribute record."
    PRMT_IDC_MARK_INVALID   "Instructs the system to mark graphics elements with non-numeric values in a special way. (-more-)"
    MORE_IDC_MARK_INVALID   "Areas will be filled with exclamation marks (!), lines will be drawn with dashes "
    PRMT_SV_CB_RECOMPUTE    "Instucts the system to recompute the class ranges before each display. Does not apply to Manual Class Ranges.  (-more-)"
    MORE_SV_CB_RECOMPUTE    "You may wish to have this "
