            VALUE "LegalTrademarks", "GeoMaster(TM)"
            VALUE "OriginalFilename", "GeoMaster"
            VALUE "ProductName", "GSSi GeoMaster"
            VALUE "ProductVersion", "34j"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


