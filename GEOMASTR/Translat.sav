"0900313435","Central Manchester","60900313435","fplace",129
-72.562200, 41.780900 -72.559500, 41.780400 -72.557800, 41.779700
-72.555300, 41.773400 -72.557100, 41.772900 -72.558700, 41.772000
-72.560700, 41.768500 -72.560400, 41.768200 -72.559700, 41.767800

*/
 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
         
         SendDlgItemMessage (hWndDlg,IDC_ALL_COUNTIES,BM_SETCHECK,TRUE,0L);
         
         cwCenter(hWndDlg, 0);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
            case IDC_LOCATE_SOURCE: 
            {    
                BOOL    HaveMID=FALSE;
                LPTAGDEF    lpTAGDef; 
                short     nFields; 
                LPSTR   lpSpace, lpDelim; 
                    
                 _fstrcpy (Ext,".BNA"); 
                 _fstrcpy (ExtID,"BNA Files");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,Name,0))   
                 {
                     FidBNA=fopen(Name,"rt");
                     if (!FidBNA)
                     {
                        MessageBox(GetFocus(),"Unable to open source file", 0,MB_ICONQUESTION|MB_OK);
                        break;
                     }
                     fgetss(str,256,FidBNA);  
                     fclose (FidBNA);    
                     lpDelim = _fstrrchr (str,'"');
                     *lpDelim = 0;
                     lpDelim = _fstrrchr (str,'"');
                     lpDelim++;
                     if (!_fstricmp (lpDelim,"county"))
                        FileType = 1;
                     else if (!_fstricmp (lpDelim,"tract"))
                        FileType = 2;
                     else if (!_fstricmp (lpDelim,"blkgrp"))
                        FileType = 3;
                     else if (!_fstricmp (lpDelim,"blk"))
                        FileType = 4;  
                     else if (!_fstricmp (lpDelim,"fplace"))
                        FileType = 5;  
                     else
                     {
                        FileType = 0; 
                        sprintf (str,"Unrecognized file type: %s",lpDelim);
                        MessageBox(GetFocus(),str, 0,MB_ICONQUESTION|MB_OK);
                        break;
                     }   
                     SetDlgItemText (hWndDlg,IDC_FILE,Name); 
                     SendDlgItemMessage (hWndDlg,IDC_ALL_COUNTIES,BM_SETCHECK,TRUE,0L);
                     SendDlgItemMessage (hWndDlg,IDC_SELECT_COUNTIES,BM_SETCHECK,FALSE,0L);
                     SendDlgItemMessage (hWndDlg,IDC_COUNTY_LIST,LB_RESETCONTENT,0,0);
                     
                 }
            }
                 break;
                 
            case IDC_LOCATE_DESTMAP: 
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName (hWndDlg,str,IDS_FILTERPLT,".PLT")) break;   
                 }
                 else  
                 {
                    if (!GetFileName (hWndDlg,str,IDS_FILTERPLT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTMAP,str);
                 break;
                 
            case IDC_ALL_COUNTIES:
                 SendDlgItemMessage (hWndDlg,IDC_COUNTY_LIST,LB_RESETCONTENT,0,0);
                 break;
                 
            case IDC_SELECT_COUNTIES:
            {    
                 SendDlgItemMessage (hWndDlg,IDC_COUNTY_LIST,LB_RESETCONTENT,0,0);  
                 SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"Scanning for Counties");
                 GetDlgItemText (hWndDlg,IDC_FILE,Name,sizeof(Name));
                 FidBNA=fopen(Name,"rt");
                 if (!FidBNA)
                 {
                    MessageBox(GetFocus(),"Unable to open source file", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
                 fseek (FidBNA,0,SEEK_END);
                 TotLen = ftell (FidBNA);  
                 fseek (FidBNA,0,SEEK_SET);   
                 hCounties = GSSiGlobAlloc (GHND,4096);
                 NumCounties = 0;
                 pCounty = (LPLONG)GlobalLock (hCounties);
                 while (fgetss(str,256,FidBNA))
                 {  
                    if (*str == '"')
                    {   
                        County = ldread (&str[1],5);  
                        for (i=0,pCnty=pCounty;i<NumCounties;i++,pCnty++)
                        {
                            if (County == *pCnty)
                                goto GotCounty;
                        } 
                        NumCounties++;
                        *pCnty = County;
                GotCounty:
                        CurLoc = ftell (FidBNA);       
                        PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                    }
                 } 
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, TotLen,0);
                 for (i=0,pCnty=pCounty;i<NumCounties;i++,pCnty++)
                 {  
                    sprintf (str,"%5.5ld   %s",*pCnty,"Hennepin County, MN");
                    SendDlgItemMessage (hWndDlg,IDC_COUNTY_LIST,LB_ADDSTRING,0,(LPARAM)str);
                 }
                 GlobalUnlock (hCounties);
                 GlobalFree (hCounties);
                 fclose (FidBNA); 
                 SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"");
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, -1,0);
                 
            }
                 break;
                 
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 if (ContinueProcessing)
                    ContinueProcessing=FALSE;
                 else
                    EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDOK: 
            {
                 MNMXCORD MinMaxCoord;  
                 long   lineno=0, TotLen, CurLoc, MidLine;  
                 long   NewRefno; 
                 short    st, SymNum, iUDI=0, AreaSym, LineSym, Pass;
                 BOOL   Done; 
                 HANDLE hMIDstr;
                 char   Prefix[10], UDI[34], AreaSymName[10], LineSymName[10]; 
                 LPSTR  lpComma;  
                 OFSTRUCT   OFStruct;
                 long       filecode,filelength,ii=100, NumOverLimit;  
                 HFILE  FidBNA;
                 char   mess[256];  
                 short        nPoly, nPoints,lastnpoints, Symbol, MaxSides;
                 long   nVertex;
                 DPOINT	LinkPoint, FirstIslandPoint;
                 HANDLE hPoly;
#if WIN32
                 DPOINT  *pPoints;
#else                  
                 DPOINT huge *pPoints;
#endif                 
                 HANDLE     hPoints, hnPoints;
                 LPINT      pnPoints;
                 COLORREF   AreaColor; 
                 short        NumPoints, Nump;  
                 short    NumSyms=0, n;  
                 HANDLE hSymDesc=0; 
                 BOOL   Store,WantFirstPoint;   
                 char   LSym[20];
                 LPSTR  lpBeg, lpEnd, lpSpace;
                                          
                                        
                 if (!GetDlgItemText (hWndDlg,IDC_DESTMAP,PltName,sizeof(PltName)))
                 {  
                    
                    MessageBox(GetFocus(),"No destination map", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 GetDlgItemText (hWndDlg,IDC_FILE,Name,sizeof(Name)); 
                 FidBNA=GSSiOpenFile (Name,&OFStruct,OF_READ);
                 if (FidBNA == HFILE_ERROR)  
                 {  
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 PltType = 2; 
                 switch (FileType)
                 {
                    case 1:
                        _fstrcpy (Prefix,"COUNTY");
                        _fstrcpy (LSym,"COUNTYBL");
                        break;
                    case 2:
                        _fstrcpy (Prefix,"CENTRACT");
                        _fstrcpy (LSym,"CENTRABL");
                        break;
                    case 3:
                        _fstrcpy (Prefix,"BLOCKGRP");
                        _fstrcpy (LSym,"BLOCKGBL");
                        break;
                    case 4:
                        _fstrcpy (Prefix,"CENBLOCK");
                        _fstrcpy (LSym,"CENBLOBL");
                        break;
                    case 5:
                        _fstrcpy (Prefix,"CENPLACE");
                        _fstrcpy (LSym,"CENPLACE");
                        break;
                 } 
                 AreaSym = GetDictSymbolNumber (Prefix);
                 LineSym = GetDictSymbolNumber (LSym);
                 if (AreaSym)
                    AddToSymList (AreaSym,&NumSyms,&hSymDesc);
                 else
                 {
                    sprintf (mess,"Unable to load area symbol: %s",Prefix);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 if (LineSym)
                    AddToSymList (LineSym,&NumSyms,&hSymDesc); 
                 else
                 {
                    sprintf (mess,"Unable to load line symbol: %s",LSym);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                                 
                 if (SendDlgItemMessage (hWndDlg,IDC_SELECT_COUNTIES,BM_GETCHECK,0,0))
                 {   
                    long nItems;
                    HANDLE hItems;  
                    LPINT   lpItems;
                    
                     nItems=SendDlgItemMessage(hWndDlg,IDC_COUNTY_LIST,LB_GETSELCOUNT,0,0);
                     if (!nItems)
                     {
                        MessageBox( GetFocus(), "No Counties Selected",0, MB_OK);
                        break;
                     } 
                     hItems = GSSiGlobAlloc (GMEM_MOVEABLE,nItems*2);
                     lpItems = (LPINT) GlobalLock (hItems); 
                     SendDlgItemMessage(hWndDlg,IDC_COUNTY_LIST,LB_GETSELITEMS,(WPARAM)nItems,(LPARAM)lpItems); 
                     hCounties = GSSiGlobAlloc(GHND,nItems*4);
                     pCounty = (LPLONG)GlobalLock(hCounties);      
                     NumCounties = nItems;
                     for (i=0;i<nItems;i++,pCounty++)
                     {
                        SendDlgItemMessage(hWndDlg,IDC_COUNTY_LIST,LB_GETTEXT,*lpItems,(LPARAM)str); 
                        *pCounty = atol (str);
                     }
                     GlobalUnlock (hCounties);
                 }
                 else
                    hCounties = 0; 
                 TotLen = _llseek (FidBNA,0,2);  
                 ExpandText (PltName);
                 PltType = 2;
                 ForceRefIndex = TRUE;   
                 Done = FALSE;
                 MidLine=0; 
                 str[0]=0;  
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0))
                    Pass = 0;
                 else
                    Pass = 1; 
                 
                 SaveFPT = FileProjectionType; 
				 FileProjectionType=0;
                 DisableHalt = TRUE;  
NextPass:        
				 NumOverLimit = MaxSides = 0;
                 _llseek (FidBNA,0,0);
                 if (Pass)
                    SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"Loading Data");
                 else
                 {       
                    SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"Scanning for min/max coordinates");
                    MinMaxCoord.xmn = DBL_MAX;
                    MinMaxCoord.xmx = -DBL_MAX; 
                    MinMaxCoord.ymn = DBL_MAX;
                    MinMaxCoord.ymx = -DBL_MAX; 
                 }       
                                    
                 NewRefno=0;
NextLine:       
                if (!ContinueProcessing)
                    goto EndFile;
                if (!fgetstring (str,128,FidBNA))
                    goto EndFile; 
                lineno++; 
                if (!(lpComma = _fstrrchr (lpstr,',')))
                    goto ErrorEnd;
                NumPoints = (short)atol (++lpComma);
                if (hCounties)
                {   
                    Store = FALSE;
                    County = ldread (&str[1],5);  
                    pCounty = (LPLONG)GlobalLock (hCounties);
                    for (i=0;i<NumCounties;i++,pCounty++)
                    {
                        if (County == *pCounty)
                            Store = TRUE;  
                    }
                    GlobalUnlock (hCounties); 
                }
                else
                    Store = TRUE; 
               	MaxSides = max (MaxSides,NumPoints);
                if (NumPoints > 4096)  
                {
                	NumOverLimit++;
                    Store = FALSE; 
                }
                lpBeg = lpstr+1;
                lpEnd = _fstrchr (lpBeg,'"');
                *lpEnd = 0;
                _fstrcpy (UDI,lpBeg);
                if (SendDlgItemMessage (hWndDlg,IDC_REMOVE_DOT,BM_GETCHECK,0,0)) 
                	strip (UDI,'.');
                hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(DPOINT)*(long)NumPoints*2);
#if WIN32
                pPoints = (DPOINT *)GlobalLock (hPoly); 
#else
                pPoints = (DPOINT huge *)GlobalLock (hPoly); 
#endif          
                hnPoints = GSSiGlobAlloc (GHND,sizeof(short)*1024);
                pnPoints = GlobalLock (hnPoints);
				nPoly = 0;      
                n = NumPoints; 
                WantFirstPoint=FALSE;
                Nump = 0;
                while (n)
                {   
                    
                    if (!fgetstring (str,128,FidBNA))
                        goto ErrorEnd;   
                    lineno++;
                    lpEnd = _fstrchr (str,0);
                    lpBeg = str; 
                    while (lpBeg < lpEnd)
                    {
                        if ((lpComma = _fstrchr (lpBeg,',')))
                        {
                            *lpComma++ = 0;
                            lpComma = _fstrpbrk (lpComma,"+-0123456789."); 
                            lpSpace = _fstrchr (lpComma,' ');
                            if (!lpSpace)
                                lpSpace = lpEnd;
                            pPoints->x = atof (lpBeg);
                            pPoints->y = atof (lpComma);
                            (*pnPoints)++;  
                            if (n == NumPoints)
                            {
                            	LinkPoint = *pPoints;
                            	FirstIslandPoint = LinkPoint;
                            }
                            else if (WantFirstPoint)
                            {
                            	FirstIslandPoint = *pPoints;
                            	WantFirstPoint=FALSE;
							}                            
                            else
                            {
                            	if (fabs (FirstIslandPoint.x - pPoints->x) < 0.00000001 &&   
                            		fabs (FirstIslandPoint.y - pPoints->y) < 0.00000001) 
                            	{
                            		if (nPoly)
                            		{  
                            			pPoints++;
                            			*pPoints = LinkPoint;  
                            			NumPoints++;
                            		}
                            		nPoly++;
                            		pnPoints++; 
                            		WantFirstPoint=TRUE;
                            	}
                            } 
                            pPoints++;
                            n--; 
                            lpBeg = lpSpace+1; 
                        }
                        else
                            lpBeg = lpEnd;
                    }
                }
                GlobalUnlock (hPoly); 
                if (nPoly < 1)
                	Store = FALSE;
                
                if (Store)
                {
#if WIN32
                	pPoints = (DPOINT *)GlobalLock (hPoly); 
#else
                	pPoints = (DPOINT huge *) GlobalLock (hPoly); 
#endif                
                    for (i=0;i<NumPoints;i++,pPoints++)
                    {
                        ConvertCoord (pPoints,2,1);
                        Store = PointInFileBounds (pPoints,&MinMaxCoord,Pass);
                    }
                    GlobalUnlock (hPoly);
                } 
                if (Pass)
                {
                    AreaColor = RGB(127+64+32+IDNINT(((double)rand()/RAND_MAX)*32),
                                    127+64+32+IDNINT(((double)rand()/RAND_MAX)*32),
                                    127+64+32+IDNINT(((double)rand()/RAND_MAX)*32));
                     NewRefno = TMPRF$;  
                     OpenRefIndex (FALSE);
                     if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_FIRST,BT_GE,(LPSTR)&RefIdxData)) 
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_LAST,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }          
                     else
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_PRIOR,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }  
                     if (nPoly>1)
                     	nPoly = -nPoly;
                     GlobalUnlock (hnPoints);  
                     pnPoints = (LPINT)GlobalLock (hnPoints);
                     if (Store)     
                        AddPolyToMap (nPoly,
                                      pnPoints, 
                                      &hPoly,0,NewRefno,2,AreaSym,0,Prefix,UDI,
                                        AreaColor,0,0); 
                 }
                 GlobalFree (hPoly); 
                 GlobalUnlock (hnPoints);      
                 GlobalFree (hnPoints);
                 CurLoc = _llseek (FidBNA,0,1);       
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                 goto NextLine;
                 
        ErrorEnd: 
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld\r\n%s",lineno,str);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    Pass = 2;
                 }
                    
        EndFile: 
                 CloseMap ();
                 CloseRefIndex();           
                 if (!Pass && ContinueProcessing)
                 {
                     short NumPens=10;
                     PENDESC PenDesc[10];
                     
                     for (i=0;i<NumPens;i++)
                     {
                        PenDesc[i].PenNum = i+1;
                        PenDesc[i].Width = (float)1.0; 
                        PenDesc[i].Style = 1;
                        PenDesc[i].Color = RGB(0,0,0);
                     }
                     CreateNewMap (PltName,&MinMaxCoord,NumSyms,hSymDesc,
                                                        NumPens,(LPPENDESC)&PenDesc); 
                    Pass = 1;
                    lineno = 0;
                    goto NextPass;
                 }
                 _lclose (FidBNA);  
                 if (hCounties)
                    GlobalFree (hCounties);
                 DestroySymList (&NumSyms,&hSymDesc);
                 ForceRefIndex = FALSE; 
                 
                 sprintf (mess,"Load complete. %ld areas skipped due to too many points. Largest area had %i points",
                 				NumOverLimit,MaxSides);
                 MessageBox( GetFocus(),mess,"", MB_OK);
                 DisableHalt = FALSE;
                 FileProjectionType = SaveFPT; 
                 EndDialog(hWndDlg, TRUE); 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
}   

BOOL ExportData (HWND hWnd,short Type)
{
    FARPROC lpfnMIF_OUTPUTMsgProc;
    BOOL    nRc; 
    
    EXType = Type;

    lpfnMIF_OUTPUTMsgProc = MakeProcInstance((FARPROC)MIF_OUTPUTMsgProc, hInst);
    nRc = DialogBox(hInst, (LPSTR)"MIF_OUTPUT", hWnd, lpfnMIF_OUTPUTMsgProc);
    FreeProcInstance(lpfnMIF_OUTPUTMsgProc); 
    return nRc;
}

BOOL FAR PASCAL MIF_OUTPUTMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{ 
    short nItems, i, Version=1, NumFields;  
    char    File[128], Ext[8], ExtID[32], Name[128];
    LPINT   lpItems;    
    HFILE   Fid;
    OFSTRUCT    OFStruct;  
    BOOL    False=FALSE;  
    short     IDC_FieldName=IDC_FIELDS;
    LPSTR   vbar; 
    char    txt[128], txt2[128]; 
    BTHEAD  BTHead;
    long    NumItems;
 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 if (DATAFILEMsgProc(hWndDlg,Message,wParam,lParam,
                     SV_SET_FILE, SV_DATABASE_LIST, SV_TABLE_NAMES, &IDC_FieldName,1,
                     MIFOutDataFile, &MIFOUTDataFileType, &MIFOuthDB, &False,FALSE))  return TRUE;
 switch(Message)
   {
    case GSSI_REINITDIALOG:
    case WM_INITDIALOG:
         /* initialize working variables                                */
        if (!hHighlight)
        { 
    NoItems:
            MessageBox( GetFocus(),"No items highlighted","Error", MB_OK);
            PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
            break;
        }  
         GetBTHeader (hHighlight,&BTHead); 
         NumItems = BTHead.BT_NUMRECS;  
         if (!NumItems) goto NoItems;
         sprintf(txt,"%ld items selected",NumItems);
         SetDlgItemText(hWndDlg,IDC_TOT_ITEMS,txt);
         SetDlgItemText(hWndDlg,IDC_SQL,MIFOutSQL);
         if (MIFOutFields)
         {
             lpItems = (LPINT)GlobalLock(MIFOutFields);
             nItems = *lpItems++;
         
             for (i=0;i<nItems;i++,lpItems++)  
                SendDlgItemMessage(hWndDlg,IDC_FIELDS, LB_SETSEL, TRUE,
                                       MAKELPARAM(*lpItems,0)); 
             GlobalUnlock (MIFOutFields);
         }
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
           { 
             case IDC_SELECT_OUTPATH:
            {   
                char    Name[128], Ext[6]; 
                LPSTR   lpDot;   
                short     Filter;
                
                Name[0]=0; 
                switch (EXType)
                {
                    case MIF:
                        Filter = IDS_FILTERMIF;
                        _fstrcpy (Ext,".MIF");
                        break;
                    case SHP:
                        Filter = IDS_FILTERSHP;
                        _fstrcpy (Ext,".SHP");
                        break; 
                }
                if (GetSaveName (hWndDlg,Name,Filter,Ext))
                {
                    SetDlgItemText (hWndDlg,IDC_MIF_FILE,Name);
                    if ((lpDot=_fstrrchr (Name,'.')))
                    {
                        *lpDot = 0;
                        _fstrcat (Name,Ext);
                        SetDlgItemText (hWndDlg,IDC_MID_FILE,Name);
                    }                           
                }
            }
                break;
                
             case IDC_LOAD:  
                 _fstrcpy (Ext,".MIO"); 
                 _fstrcpy (ExtID,"MAPINFO Output Definition");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,File,0))   
                 {
                    LPSTR   lpID, lpPW;
                    
                    if (MIFOutFields)
                        GlobalFree(MIFOutFields);
                    CloseDataFile (FALSE,&MIFOuthDB);
                    Fid = GSSiOpenFile (File,&OFStruct,OF_READ);
                    _lread (Fid,&Version,2);
                    _lread (Fid,&MIFOutDataFile,sizeof(MIFOutDataFile));
                    _lread (Fid,&MIFOutSQL,sizeof(MIFOutSQL));
                    _lread (Fid,&nItems,sizeof(short));
                     MIFOutFields = GSSiGlobAlloc(GHND,nItems*2+2);
                     lpItems = (LPINT)GlobalLock(MIFOutFields);
                     *lpItems = nItems;
                     lpItems++;       
                     _lread (Fid,lpItems,nItems*sizeof(short));
                     GlobalUnlock(MIFOutFields);
                     _lclose (Fid); 
                     lpID = _fstrstr (MIFOutDataFile,";UID="); 
                     lpPW = _fstrstr (MIFOutDataFile,";PWD="); 
                     if (lpID && lpPW)
                     {  
                        vbar = _fstrchr (lpID,'|');
                        *lpID = 0; 
                        *lpPW = 0;
                        if (!_fstrncmp (MIFOutDataFile,"ODBC|",5))
                            _fstrcpy(CurODBCFile,&MIFOutDataFile[5]); 
                        _fstrcpy (txt2,MIFOutDataFile);
                        if (vbar)
                        {
                            _fstrcat (txt2,vbar);
                            *vbar = 0; 
                        }
                        lpID+=5;
                        lpPW+=5;
                        SetODBCPassword (lpID,lpPW);  
                        _fstrcpy (MIFOutDataFile,txt2);
                     }
                     PostMessage(hWndDlg, GSSI_REINITDIALOG, 0, 0L);
                 }
                 
            break;
             case IDC_SAVE:
                 _fstrcpy (Ext,".MIO");
                 if (!GetSaveName (hWndDlg,File,0,Ext)) 
                    break;
                 if (!_fstrncmp (MIFOutDataFile,"ODBC|",5))
                 { 
                    vbar = _fstrchr (&MIFOutDataFile[5],'|');
                    if (!vbar) break;
                    *vbar = 0;   
                    _fstrcpy (txt,&MIFOutDataFile[5]);
                    AddPWtoODBCFile (txt); 
                    sprintf (txt2,"ODBC|%s|%s",txt,++vbar); 
                    _fstrcpy (MIFOutDataFile,txt2);
                 } 
                    
                 nItems=SendDlgItemMessage(hWndDlg,IDC_FIELDS,
                                           LB_GETSELCOUNT,
                                           0,
                                           0);
                 if (!nItems)
                 {
                    MessageBox( GetFocus(), "Error","No Fields Selected", MB_OK);
                    break;
                 }  
                 if (MIFOutFields)
                    GlobalFree(MIFOutFields);
                 MIFOutFields = GSSiGlobAlloc(GHND,nItems*2+2);
                 lpItems = (LPINT)GlobalLock(MIFOutFields);
                 *lpItems = nItems;
                 lpItems++;       
                 SendDlgItemMessage(hWndDlg,IDC_FIELDS,
                                           LB_GETSELITEMS,
                                           nItems,
                                           (LPARAM)lpItems); 
                 GlobalUnlock(MIFOutFields);
                 CloseDataFile (FALSE,&MIFOuthDB);      
                 GetDlgItemText(hWndDlg,IDC_SQL,MIFOutSQL,sizeof(MIFOutSQL));
                 if (wParam == IDOK)
                     EndDialog(hWndDlg, TRUE);
                 else
                 {
                    Fid = GSSiOpenFile (File,&OFStruct,OF_CREATE);
                    _lwrite (Fid,(char *)&Version,2);
                    _lwrite (Fid,(char *)&MIFOutDataFile,sizeof(MIFOutDataFile));
                    _lwrite (Fid,(char *)&MIFOutSQL,sizeof(MIFOutSQL));
                     lpItems = (LPINT)GlobalLock(MIFOutFields);  
                     _lwrite (Fid,(char *)lpItems,(*lpItems+1)*sizeof(short));
                     GlobalUnlock(MIFOutFields);
                    _lclose (Fid);
                 }
                 break; 

            case IDOK: 
            {
                HFILE   FidMIF, FidMID, FidSHP;
                char    Name[128];   
                OFSTRUCT    OFStruct;  
                short     pos;  
                long    CurItem=0, iref, RecNum=0, Index=0;
                LPTHEME pTheme;                                        
                HIGHLIGHTDATA   HighlightData;  
                short     nareas,numpoints;
                DPOINT  CP; 
                BOOL    First; 
                char    SQL[256],OutRec[256];
                SHPPOLYHEADER   SHPPolyHeader;  
                SHPHEADER   SHPHeader;  
                SHPRECHEADER SHPRecHeader; 
                LPOPENFILEDATA  FilePtr;
                LPOPENSQLDATA   SQLPtr;
                HANDLE  hSQL;
                short IDB;
                
                CloseDataFile (FALSE,&MIFOuthDB);      
                GetDlgItemText (hWndDlg,IDC_SQL,SQL,sizeof(SQL));
                if (!OpenDataFile (MIFOutDataFile,SQL,BT_READ,&MIFOuthDB))
                    break;   
            
                CreateFilePath (MIFOuthDB);
        
                nItems=SendDlgItemMessage(hWndDlg,IDC_FIELDS,
                                           LB_GETSELCOUNT,
                                           0,
                                           0);
                if (!nItems)
                {
                    MessageBox( GetFocus(),"No Fields Selected", "Error", MB_OK);
                    break;
                }  
                if (MIFOutFields)
                    GlobalFree(MIFOutFields);
                MIFOutFields = GSSiGlobAlloc(GHND,nItems*2+2);
                lpItems = (LPINT)GlobalLock(MIFOutFields);
                SendDlgItemMessage(hWndDlg,IDC_FIELDS,
                                           LB_GETSELITEMS,
                                           nItems,
                                           (LPARAM)lpItems); 
                GlobalUnlock(MIFOutFields);


                GetBTHeader (hHighlight,&BTHead); 
                NumItems = BTHead.BT_NUMRECS;  
                GetDlgItemText (hWndDlg,IDC_MIF_FILE,Name,sizeof(Name));
                FidMIF = GSSiOpenFile (Name,&OFStruct,OF_CREATE); 
                FidSHP = FidMIF;
                GetDlgItemText (hWndDlg,IDC_MID_FILE,Name,sizeof(Name));
                switch (EXType)
                {
                    case MIF:
                        FidMID = GSSiOpenFile (Name,&OFStruct,OF_CREATE); 
                        fputstring ("Version 2",FidMIF);
                        fputstring ("Delimiter \",\"",FidMIF);
                        fputstring ("Columns 1",FidMIF);
                        fputstring ("  SoilType Char(4)",FidMIF);
                        fputstring ("Data",FidMIF);
                        fputstring ("",FidMIF);  
                    break;
                    
                    case SHP:
                        hSQL = 0;
                        if (!OpenDataFile ("ODBC|SHAPE FILE DATA|TEST","",BT_READ,&hSQL))
                            return FALSE;      
                        SQLPtr = (LPOPENSQLDATA)GlobalLock (hSQL);
                        FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle); 
                        IDB = FilePtr->FileHandle;
                      
                        _lwrite (FidSHP,(char *)&SHPHeader,sizeof(SHPHeader)); 
                        _fmemset (&SHPHeader,0,sizeof(SHPHeader));
                        SHPHeader.Xmin = DBL_MAX;   
                        SHPHeader.Xmax = -DBL_MAX;
                        SHPHeader.Ymin = DBL_MAX;
                        SHPHeader.Ymax = -DBL_MAX;
                        
                    break;
                }
                
                pos = BT_FIRST; 
                while (!BT_FIND (hHighlight,(LPSTR)&iref,pos,BT_ANY,(LPSTR)&HighlightData))
                {   
                    pos = BT_NEXT;
                    ltoa (iref,txt,10);
                    SetGlobalValue ("%INT_REFNO",txt);
                    SetUDIValue ("%INT_REFNO",HighlightData.PD.UDI);  
                    SetUDIValue (HighlightData.PD.Prefix,HighlightData.PD.UDI);     
                    SetGlobalValue ("%PREFIX",HighlightData.PD.Prefix);  
                    lpItems = (LPINT)GlobalLock (MIFOutFields);   
                    *OutRec = 0;
                    for (i=0;i<nItems;i++,lpItems++) 
                    {
                        SendDlgItemMessage(hWndDlg,IDC_FIELDS,
                                                   LB_GETTEXT,
                                                   *lpItems,(LPARAM)Name); 
                     
                        if (GetValFromOpenFiles (Name,txt) < 0) 
                        {
                            GlobalUnlock (MIFOutFields);
                            goto NextHlt;  
                        } 
                        switch (EXType)
                        {
                            case MIF:
                            if (i)
                                _fstrcat (OutRec,",");
                            _fstrcat (OutRec,"\"");
                            _fstrcat (OutRec,txt);
                            _fstrcat (OutRec,"\""); 
                            break;
                            
                            case SHP: 
                                sprintf (OutRec,"INSERT INTO test VALUES ('%s')",txt);
                            break;
                        }
                    }  
                    GlobalUnlock (MIFOutFields);   
                    switch (EXType)
                    {
                        case MIF:
                            fputstring (OutRec,FidMID);
                        break;
                        case SHP: 
                            ExternalSQLDirect (IDB, OutRec);
                        break;
                    }
                    PickList[0]=HighlightData.PD;
                    if (PickList[0].Type == 3)
                    {   
                        pTheme = AddTheme (GF_SAVEPOLY_THEME);
                        CurView->PassID = 1;
                        ProcessPickedItem (0,FALSE);                
                        DeleteTheme (pTheme);
                        if (hSavePoly)
                        {   LPMNMXCORD lpRect;
                            LPINT   npt;
                            short     nPnts; 
                            LPDPOINT    lpDpoint;
                            DPOINT  FirstPoint;
                            
                            SHPPolyHeader.Xmin = DBL_MAX;   
                            SHPPolyHeader.Xmax = -DBL_MAX;
                            SHPPolyHeader.Ymin = DBL_MAX;
                            SHPPolyHeader.Ymax = -DBL_MAX;   
                            SHPPolyHeader.NumParts = 1;
                            
                            nareas=1;  
                            CP.x=0;
                            CP.y=0;
                            npt = (INT *)GlobalLock (hSavePoly);
                            nPnts = *npt; 
                            npt++;
                            lpRect = (LPMNMXCORD) npt;
                            lpRect++;
                            lpDpoint = (LPDPOINT) lpRect;
                            while (nPnts--)
                            {
                                CP.x+=lpDpoint->x;
                                CP.y+=lpDpoint++->y;
                            }  
                            GlobalUnlock (hSavePoly);
                            npt = (INT *)GlobalLock (hSavePoly);
                            nPnts = *npt;  
                            numpoints = *npt + 1; 
                            SHPPolyHeader.NumPoints = numpoints;
                            
                            npt++;
                            CP.x/=nPnts;
                            CP.y/=nPnts; 
                            switch (EXType)
                            {
                                case MIF:
                                    sprintf (txt,"Region %i",nareas);  
                                    fputstring (txt,FidMIF);
                                    sprintf (txt,"%4i",nPnts+1);  
                                    fputstring (txt,FidMIF);  
                                break;
                                case SHP:
                                break;
                            }
                            lpRect = (LPMNMXCORD) npt;
                            lpRect++;
                            lpDpoint = (LPDPOINT) lpRect;  
                            First = TRUE;
                            while (nPnts--)
                            {   
                                double x,y;
                                
                                ConvertCoord(lpDpoint,1,2); 
                                if (First)
                                    FirstPoint = *lpDpoint;
                                First = FALSE;   
                                x=lpDpoint->x;
                                y=lpDpoint->y;  
                                SHPPolyHeader.Xmin = min (x,SHPPolyHeader.Xmin);   
                                SHPPolyHeader.Xmax = max (x,SHPPolyHeader.Xmax);
                                SHPPolyHeader.Ymin = min (y,SHPPolyHeader.Ymin);   
                                SHPPolyHeader.Ymax = max (y,SHPPolyHeader.Ymax);
                                
                                lpDpoint++;  
                                switch (EXType)
                                {
                                    case MIF:
                                        sprintf (txt,"%f %f",x,y); 
                                        fputstring (txt,FidMIF);  
                                        break;
                                    case SHP:
                                        break;
                                }
                            } 
                            switch (EXType)
                            {
                                case MIF:
                                    sprintf (txt,"%f %f",FirstPoint.x,FirstPoint.y); 
                                    fputstring (txt,FidMIF);
                                    ConvertCoord(&CP,1,2);   
                                    fputstring ("    Pen (1,2,0)",FidMIF);
                                    fputstring ("    Brush (2,16777088,16777215)",FidMIF);
                                    sprintf (txt,"    Center %f %f",CP.x,CP.y);  
                                    fputstring (txt,FidMIF);
                                     
                                    break;
                                case SHP: 
                                    SHPRecHeader.RecNum = RecNum++;
                                    SHPRecHeader.Length = (sizeof (SHPPolyHeader) + 
                                                           sizeof(long)*SHPPolyHeader.NumParts +
                                                           sizeof(double) * numpoints * 2) / 2;
                                     
                                    flip ((LPSTR)&SHPRecHeader.RecNum,4);
                                    flip ((LPSTR)&SHPRecHeader.Length,4);   
                                    SHPHeader.Xmin = min (SHPHeader.Xmin,SHPPolyHeader.Xmin);   
                                    SHPHeader.Ymin = min (SHPHeader.Ymin,SHPPolyHeader.Ymin);   
                                    SHPHeader.Xmax = max (SHPHeader.Xmax,SHPPolyHeader.Xmax);   
                                    SHPHeader.Ymax = max (SHPHeader.Ymax,SHPPolyHeader.Ymax);   
                                    
                                    _lwrite (FidSHP,(char *)&SHPRecHeader,sizeof(SHPRecHeader)); 
                                    SHPPolyHeader.Type = 5;
                                    _lwrite (FidSHP,(char *)&SHPPolyHeader,sizeof(SHPPolyHeader)); 
                                    _lwrite (FidSHP,(char *)&Index,4); 
                                    _lwrite (FidSHP,(char *)lpRect,sizeof(DPOINT)*(numpoints-1)); 
                                    _lwrite (FidSHP,(char *)&FirstPoint,sizeof(DPOINT)); 
                                
                                    break;
                            }
                            GlobalUnlock (hSavePoly);
                            GlobalFree (hSavePoly);
                         }
                     }
                    
            NextHlt:                    
                    PctBox (GetDlgItem(hWndDlg,IDC_STATUS), NumItems, CurItem++,0);
                } 
                switch (EXType)
                {
                    case MIF:
                        _lclose (FidMID);
                        break;
                    case SHP: 
                        SHPHeader.FileLength = _llseek (FidSHP,0,2); 
                        SHPHeader.FileLength /= 2; 
                        SHPHeader.FileCode = 9994;
                        SHPHeader.Version = 1000;
                        SHPHeader.ShapeType = 5;
                        _llseek (FidSHP,0,0);
                        flip ((LPSTR)&SHPHeader.FileCode,4);
                        flip ((LPSTR)&SHPHeader.FileLength,4);  
                        _lwrite (FidSHP,(char *)&SHPHeader,sizeof(SHPHeader));  
                        
                        _lclose (FidSHP);    
                        if (hSQL)
                        {
                            GlobalUnlock(FilePtr->FileHandle); 
                            GlobalUnlock (SQLPtr->OFHandle);
                            CloseDataFile (TRUE, &hSQL);  
                        } 
                        
                        break;
                }
                CloseDataFile (FALSE,&MIFOuthDB);      
                DestroyFilePath ();
                EndDialog(hWndDlg, TRUE);
                break;
            }
                 
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 CloseDataFile (FALSE,&MIFOuthDB);
                 EndDialog(hWndDlg, FALSE);
                 break;

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
}


void flip (LPSTR In, short n)
{ 
    char Out[32];
    LPSTR SaveIn=In;
    short     num=n, i=0;
    
    while (num--)
        Out[num]=*In++;
    _fmemmove (SaveIn,Out,n);
    return;
}   
    

BOOL FAR PASCAL LOADSHPMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{ 
    LPTAGDEF    lpTAGDef; 
    short     TabStops[2]={1200,1300}, i;
    char    Ext[8], ExtID[34];
    char    Name[128],MidName[128], str[256], mess[256], SymName[16];
    HFILE   FidSHP;
    LPSTR   lpDot, lpMIDstr;  
    HCURSOR OldCursor=0;    
    static   HANDLE hSQL=0;
    LPGWFLDINFO lpGWFldInfo;
    LPGWDHEADER lpGWDHead;
    HANDLE      hBT;
    long        Offset; 
    double      rtn;
    LPVOID      lpVal; 
    char        AtFile[128], str1[16], str2[64];
    short         st, len,ifield;
    LPOPENFILEDATA  FilePtr;
    LPOPENSQLDATA   SQLPtr;
    LPFIELDINFO lpFieldInfo; 
    HANDLE      SaveHandle;
    LPFILEPATH  FilePathPtr; 
    BOOL        More;   
    float		size,rot;
    short         rc; 
    

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
         
         cwCenter(hWndDlg, 0);
         LoadTAGDef ();   
         if (NumTAGDef<=0) break; 
         lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
         for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
            SendDlgItemMessage (hWndDlg,IDC_UDI,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
         GlobalUnlock (hTAGDef);
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Feet");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Meters");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Degrees");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Degrees * 1000000");
         _fstrcpy (str,"*.CVT");
         DlgDirListComboBox (hWndDlg,str,IDC_PROJECTION,0,DDL_READWRITE);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
            case IDC_GET_SYM:
                 if (!SelectPointSymbol (hWndDlg,SymName,size,rot))
                    break;  
                SetDlgItemText (hWndDlg,IDC_SYMNAME,SymName); 
                break;
                
            case IDC_LOCATE_DESTMAP: 
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName (hWndDlg,str,IDS_FILTERPLT,".PLT")) break;   
                 }
                 else  
                 {
                    if (!GetFileName (hWndDlg,str,IDS_FILTERPLT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTMAP,str);
                 break;
                 
            case IDC_LOCATE_SOURCE: 
            {    
                BOOL    HaveMID=FALSE;
                short     nFields; 
                LPSTR   lpSpace; 
                SHPHEADER SHPHeader;
                char    leaf[34];
                    
                 _fstrcpy (Ext,".SHP"); 
                 _fstrcpy (ExtID,"Shape Files");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,Name,0))   
                 {
                    OldCursor = SetCursor (LoadCursor (0,IDC_WAIT));
                    SendDlgItemMessage (hWndDlg,IDC_FIELDS,LB_RESETCONTENT,0,0);
                    
                    SetDlgItemText (hWndDlg,IDC_FILE,Name); 
                    _splitpath (Name,0,0,leaf,0);
                    
                    _strupr(leaf);
                    sprintf (AtFile,"ODBC|SHAPE FILE DATA|%s",leaf); 
                    hSQL = 0;  
                    if (!OpenDataFile (AtFile,"",BT_READ,&hSQL))
                    {
                        sprintf (mess,"Unable to open DBF via ODBC: %s",AtFile);
                        MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                        break;   
                    }
    
                    SetDlgItemText (hWndDlg,IDC_ATTRIBUTE_FILE,AtFile);
                    SaveHandle = FilePathHandle;
                    FilePathHandle = GlobalAlloc (GHND,sizeof(HANDLE)+2+MAXFILESINPATH*sizeof(HANDLE));
                    FilePathPtr = (LPFILEPATH)GlobalLock (FilePathHandle);
                    FilePathPtr->LastPathHandle = SaveHandle;
                    FilePathPtr->FileHandle=hSQL;
                    FilePathPtr->NumFiles=1; 
                    GlobalUnlock(FilePathHandle);
                        
                    SQLPtr = (LPOPENSQLDATA)GlobalLock (hSQL);
                    FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle); 
    
                    nFields = FilePtr->NumFields;  
                    lpFieldInfo = &FilePtr->FldInfo;
                    while (nFields--)
                        SendDlgItemMessage (hWndDlg,IDC_FIELDS,CB_ADDSTRING,0,(LPARAM)&lpFieldInfo++->name);
                    if (hSQL)
                    {
                        GlobalUnlock(FilePtr->FileHandle); 
                        GlobalUnlock (SQLPtr->OFHandle);
                        GlobalFree (FilePathHandle);
                        FilePathHandle = SaveHandle;
                        CloseDataFile (TRUE, &hSQL);  
                    } 
                 }
            }  
            SetCursor (OldCursor);
                 break;
                 
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 if (ContinueProcessing)
                    ContinueProcessing=FALSE;
                 else
                    EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDOK: 
            {
                 long   lineno=0, TotLen, CurLoc, MidLine, NewRefno; 
                 short  iUDI=0, LineSym;
                 BOOL   Done; 
                 HANDLE hMIDstr;
                 char   Prefix[10], UDI[34], UDIField[64], project[34]; 
                 LPSTR   pPrefix;
                 SHPHEADER SHPHeader;
                 SHPRECHEADER SHPRecHeader;
                 OFSTRUCT   OFStruct;
                 double coordcvt=1;
                 long     ii=100;
                 short    NumSyms=0, SymNum;  
                 HANDLE hSymDesc=0;
         
                 if (!GetDlgItemText (hWndDlg,IDC_DESTMAP,PltName,sizeof(PltName))) 
                 {
                    MessageBox(GetFocus(),"No destination map", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 if (!GetDlgItemText (hWndDlg,IDC_SYMNAME,SymName,sizeof(SymName)))
                 {
                    MessageBox(GetFocus(),"No symbol selected", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 if (!GetDlgItemText (hWndDlg,IDC_PROJECTION,project,sizeof(project)))
                 {
                    MessageBox(GetFocus(),"No input projection set", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 if ((lpDot=_fstrrchr(project,'.')))
                        *lpDot = 0;
                 SetGlobalValue("%ALT_PROJECTION",project);
                 GetDlgItemText (hWndDlg,IDC_UNITS,str,sizeof(str));
                 if (*str)
                 { 
                        if (!_fstrcmp(str,"Degrees * 1000000"))
                            coordcvt = 0.0000001; 
                        else if (!_fstrcmp(str,"Feet"))
                        {
                            PRJ_UNITS[3] = 1;
                            if (PRJ_UNITS[1] == 2 && !*project)
                                coordcvt = FTM;
                        }       
                        else if (!_fstrcmp(str,"Meters"))
                        {
                            PRJ_UNITS[3] = 2;
                            if (PRJ_UNITS[1] == 1 && !*project)
                                coordcvt = MFT;
                        }       
                 }
                 else
                 {
                    MessageBox(GetFocus(),"Units field not set", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
                 
                 GetDlgItemText (hWndDlg,IDC_FILE,Name,sizeof(Name)); 
                 GetDlgItemText (hWndDlg,IDC_ATTRIBUTE_FILE,AtFile,sizeof(AtFile)); 
                 FidSHP=GSSiOpenFile (Name,&OFStruct,OF_READ);
                 if (FidSHP == HFILE_ERROR)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 SymNum = GetDictSymbolNumber (SymName);
                 AddToSymList (SymNum,&NumSyms,&hSymDesc);
                 TotLen = _llseek (FidSHP,0,2);  
                 _llseek (FidSHP,0,0);
                 ExpandText (PltName);
                 PltType = 2;
                 ForceRefIndex = TRUE;   
                 Done = FALSE;
                 MidLine=0; 
                 str[0]=0;  
                 _lread (FidSHP,&SHPHeader,(UINT)sizeof(SHPHeader));
                 flip ((LPSTR)&SHPHeader.FileCode,4);
                 flip ((LPSTR)&SHPHeader.FileLength,4);  
                 
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                     short NumPens=10;
                     PENDESC PenDesc[10];
                     LPSYMDESC  pSymDesc;  
                     LPSYMBOL   pSym;
                     MNMXCORD MinMaxCoord;
                     DPOINT Points[4];
                     short    i;  
                    
                     MinMaxCoord.xmn = DBL_MAX;
                     MinMaxCoord.xmx = -DBL_MAX; 
                     MinMaxCoord.ymn = DBL_MAX;
                     MinMaxCoord.ymx = -DBL_MAX; 
                     Points[0].x = SHPHeader.Xmin;   
                     Points[0].y = SHPHeader.Ymin;   
                     Points[1].x = SHPHeader.Xmin;   
                     Points[1].y = SHPHeader.Ymax;   
                     Points[2].x = SHPHeader.Xmax;   
                     Points[2].y = SHPHeader.Ymax;   
                     Points[3].x = SHPHeader.Xmax;   
                     Points[3].y = SHPHeader.Ymin; 
                     for (i=0;i<4;i++)
                     {
                        if (ConvertCoord(&Points[i],3,1))
                        {   
                            MessageBox(GetFocus(),"Unable to convert coordinates as specified", 0,MB_ICONQUESTION|MB_OK);
                            goto ErrorEnd;
                        } 
                        MinMaxCoord.xmn = min(MinMaxCoord.xmn,Points[i].x);
                        MinMaxCoord.xmx = max(MinMaxCoord.xmx,Points[i].x);
                        MinMaxCoord.ymn = min(MinMaxCoord.ymn,Points[i].y);
                        MinMaxCoord.ymx = max(MinMaxCoord.ymx,Points[i].y);
                     }   
                     for (i=0;i<NumPens;i++)
                     {
                        PenDesc[i].PenNum = i+1;
                        PenDesc[i].Width = (float)1; 
                        PenDesc[i].Style = 1;
                        PenDesc[i].Color = RGB(0,0,0);
                     }
                     CreateNewMap (PltName,&MinMaxCoord,NumSyms,hSymDesc,
                                                        NumPens,(LPPENDESC)&PenDesc);
                 }
                 
                 pPrefix = Prefix;    
                 GetDlgItemText(hWndDlg,IDC_UDI,Prefix,sizeof(Prefix));
                 UDIField[0]=0; 
                 if (*pPrefix) 
                     GetDlgItemText(hWndDlg,IDC_FIELDS,UDIField,sizeof(UDIField));               
                 else
                    pPrefix = 0;   
                    
                hSQL = 0;
                if (!OpenDataFile (AtFile,"",BT_READ,&hSQL))
                {  
                    MessageBox(GetFocus(),"Cannot open data file", 0,MB_ICONQUESTION|MB_OK);
                    break;
                }
                    
                SaveHandle = FilePathHandle;
                FilePathHandle = GlobalAlloc (GHND,sizeof(HANDLE)+2+MAXFILESINPATH*sizeof(HANDLE));
                FilePathPtr = (LPFILEPATH)GlobalLock (FilePathHandle);
                FilePathPtr->LastPathHandle = SaveHandle;
                FilePathPtr->FileHandle=hSQL;
                FilePathPtr->NumFiles=1; 
                GlobalUnlock(FilePathHandle);
                 SaveFPT = FileProjectionType; 
				 FileProjectionType=0;
                 DisableHalt = TRUE;  
                                        
                 NewRefno=0;
        NextLine: 
                 if (!ContinueProcessing) Done = TRUE;
                 if (Done)
                    goto EndFile;                
                 lineno++;   
/*               NewRefno = TMPRF$;  
                 OpenRefIndex (FALSE);
                 if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_FIRST,BT_GE,(LPSTR)&RefIdxData)) 
                 {
                    if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_LAST,BT_ANY,(LPSTR)&RefIdxData))
                        NewRefno = LONG_MIN; 
                    else
                        NewRefno++; 
                 }          
                 else
                 {
                    if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_PRIOR,BT_ANY,(LPSTR)&RefIdxData))
                        NewRefno = LONG_MIN; 
                    else
                        NewRefno++; 
                 }  */
                 
                 if (SHPHeader.ShapeType == 5)
                 {  
                    short     nPoly, nPoints,lastnpoints;
                    long    nVertex;
                    HANDLE  hPoly; 
                    LPDPOINT    lpDPoint, lpDPoints;
                    DPOINT  LinkPoint;
                    LPSTR   lpSpace;
                    BOOL    Store, FirstPoly;
                    SHPPOLYHEADER   SHPPolyHeader;  
                    LPDPOINT    pPoints;
                    LPLONG      pPartIndex;
                    HANDLE      hPoints, hPartIndex, hnPoints;
                    LPINT       pnPoints;
                    long    LastIndex; 
                    COLORREF    AreaColor; 
                    short     NumPoints;                                            
                                        
//                  if (!GetMIDData(FidSHP,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    _lread (FidSHP,&SHPRecHeader,sizeof(SHPRecHeader));
                    flip ((LPSTR)&SHPRecHeader.RecNum,4);
                    flip ((LPSTR)&SHPRecHeader.Length,4);
                    _lread (FidSHP,&SHPPolyHeader,sizeof(SHPPolyHeader));  
                    hPartIndex = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(long)*(SHPPolyHeader.NumParts+1));
//                  hnPoints = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(short)*SHPPolyHeader.NumParts);
//                  pnPoints = GlobalLock (hnPoints);
                    NumPoints = SHPPolyHeader.NumPoints+SHPPolyHeader.NumParts-1;
                    hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(DPOINT)*NumPoints);
                    pPartIndex = (LPLONG)GlobalLock (hPartIndex);
                    _lread (FidSHP,pPartIndex,(UINT)(sizeof(long)*SHPPolyHeader.NumParts)); 
                    pPartIndex+=SHPPolyHeader.NumParts;
                    *pPartIndex = SHPPolyHeader.NumPoints;
                    GlobalUnlock (hPartIndex);  
                    pPartIndex = (LPLONG)GlobalLock (hPartIndex);
                    pPoints = (LPDPOINT)GlobalLock (hPoly); 
                    
                    SHPPolyHeader.Xmin = DBL_MAX;
                    SHPPolyHeader.Xmax = -DBL_MAX; 
                    SHPPolyHeader.Ymin = DBL_MAX;
                    SHPPolyHeader.Ymax = -DBL_MAX; 
                    for (i=0;i<SHPPolyHeader.NumParts;i++)
                    {   
                        long    numpoints, startpoint;
                        
                        startpoint = *pPartIndex++;
                        numpoints = *pPartIndex-startpoint;
                        _lread (FidSHP,pPoints,(UINT)(sizeof(DPOINT)*numpoints)); 
                        if (!i)
                            LinkPoint = *pPoints;
                        pPoints += numpoints;  
                        if (i) 
                        {
                            *pPoints = LinkPoint; 
                            pPoints++;
                        }
                    }
                    GlobalUnlock (hPartIndex);  
                    
                    if (GetValFromOpenFiles (UDIField,UDI)<0)
                    {
                        MessageBox(GetFocus(),"Attribute database ends before shape file", 0,MB_ICONQUESTION|MB_OK);
                        goto ErrorEnd;
                    }
                    FetchDBRec (hSQL);
            //      if(rc != SQL_SUCCESS && rc != SQL_SUCCESS_WITH_INFO) More=FALSE;   
                    GlobalUnlock (hPoly);
                    pPoints = (LPDPOINT)GlobalLock (hPoly); 
                    for (i=0;i<NumPoints;i++,pPoints++)
                    {
                        if (ConvertCoord(pPoints,3,1))
                        {   
                            MessageBox(GetFocus(),"Unable to convert coordinates as specified", 0,MB_ICONQUESTION|MB_OK);
                            goto ErrorEnd;
                        }
                        SHPPolyHeader.Xmin = min(SHPPolyHeader.Xmin,pPoints->x);
                        SHPPolyHeader.Xmax = max(SHPPolyHeader.Xmax,pPoints->x);
                        SHPPolyHeader.Ymin = min(SHPPolyHeader.Ymin,pPoints->y);
                        SHPPolyHeader.Ymax = max(SHPPolyHeader.Ymax,pPoints->y);
                    }
                    GlobalUnlock (hPoly);
                    Store=TRUE; 
                    LastIndex = 0;   
/*                  pPartIndex++;
                    for (i=0;i<SHPPolyHeader.NumParts;i++,pnPoints++,pPartIndex++)
                    {   
                        if (i+1 == SHPPolyHeader.NumParts)
                            *pnPoints = SHPPolyHeader.NumPoints-LastIndex;
                        else
                            *pnPoints = *pPartIndex-LastIndex;
                        LastIndex = *pPartIndex;
                    } 
                    GlobalUnlock (hnPoints);
                    pnPoints = GlobalLock (hnPoints); 
                    GlobalUnlock (hPartIndex);*/
                    GlobalFree (hPartIndex);
                    nPoly = SHPPolyHeader.NumParts;  
                    FirstPoly=TRUE; 
                    if (SHPPolyHeader.Xmin < CurView->FileMNMX.xmn ||   
                        SHPPolyHeader.Xmax > CurView->FileMNMX.xmx ||
                        SHPPolyHeader.Ymin < CurView->FileMNMX.ymn ||
                        SHPPolyHeader.Ymax > CurView->FileMNMX.ymx)
                        Store=FALSE;    
/*                  while (nPoly--)
                    {    
                         OpenRefIndex (FALSE);
                         if (!fgetss(str,256,FidSHP)) goto ErrorEnd;lineno++; 
                         nVertex = atol (str);
                         lastnpoints=nPoints;
                         nPoints += nVertex;
                         if (hPoly)
                         {  
                            nPoints++;
                            hPoly = GlobalReAlloc (hPoly,(DWORD)nPoints*sizeof(DPOINT),0); 
                            lpDPoints = GlobalLock(hPoly); 
                            lpDPoint = lpDPoints;
                            lpDPoint += lastnpoints;
                         }
                         else
                         {
                             hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nPoints*sizeof(DPOINT));
                             lpDPoint = GlobalLock (hPoly); 
                             lpDPoints = lpDPoint;
                         } 
                         while (nVertex--)
                         { 
                            if (!fgetss(str,256,FidSHP)) goto ErrorEnd;lineno++; 
                            lpDPoint->x = atof (str);
                            if (!(lpSpace=_fstrchr(str,' '))) goto ErrorEnd;
                            lpDPoint->y = atof (lpSpace); 
                            ConvertCoord(lpDPoint,2,1);
                            if (lpDPoint->x < CurView->FileMNMX.xmn ||   
                                lpDPoint->x > CurView->FileMNMX.xmx ||
                                lpDPoint->y < CurView->FileMNMX.ymn ||
                                lpDPoint->y > CurView->FileMNMX.ymx)
                                Store=FALSE;    
                            lpDPoint++;
                         }   
                         if (FirstPoly)
                         {
                            lpDPoint--;
                            LinkPoint = *lpDPoint;
                         }  
                         else
                            *lpDPoint = LinkPoint; 
                         GlobalUnlock (hPoly);
                         FirstPoly=FALSE;
                    }*/  
                    AreaColor = RGB(127+IDNINT(((double)rand()/RAND_MAX)*128),
                                    127+IDNINT(((double)rand()/RAND_MAX)*128),
                                    127+IDNINT(((double)rand()/RAND_MAX)*128));
                    NewRefno++;   
                    if (Store)     
                        AddPolyToMap (1,(int *)&NumPoints, &hPoly,0,NewRefno,2,SymNum,0,Prefix,UDI,
                                        AreaColor,0,0); 
//                  GlobalUnlock (hnPoints); 
//                  GlobalFree (hnPoints);
                    GlobalFree (hPoly);  
                    
                 }
                 else   
                    goto ErrorEnd;
                 
                 CurLoc = _llseek (FidSHP,0,1);       
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                 if (TotLen-CurLoc <= 8)
                    Done=TRUE;
                 goto NextLine;
                 
        ErrorEnd: 
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld\r\n%s",lineno,str);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                 }
                    
        EndFile: 
                 DisableHalt = FALSE;
                 FileProjectionType = SaveFPT; 
                 DisableHalt = FALSE;
                 DestroySymList (&NumSyms,&hSymDesc);
                 CloseMap();
                 _lclose (FidSHP); 
                 CloseRefIndex();           
                 ForceRefIndex = FALSE; 
                 if (hSQL)
                 {
                    GlobalFree (FilePathHandle);
                    FilePathHandle = SaveHandle;
                    CloseDataFile (TRUE, &hSQL);  
                } 

                 EndDialog(hWndDlg, TRUE); 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
}   

BOOL FAR PASCAL POINTMAPMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{ 
    short     TabStops[2]={100,1300}, i;
    LPSTR   pPrefix, lpDot, lpMIDstr;  
    HCURSOR OldCursor=0;    
    static   HANDLE hSQL=0;
    LPGWFLDINFO lpGWFldInfo;
    LPGWDHEADER lpGWDHead;
    HANDLE      hBT;    
    float       size=(float)12.0,rot=(float)0.0;
    long        Offset; 
    double      rtn;
    LPVOID      lpVal; 
    char        str1[16], str2[64];
    char        str[256]; 
    short         st, len,ifield;
    LPOPENFILEDATA  FilePtr;
    LPOPENSQLDATA   SQLPtr;
    LPFIELDINFO lpFieldInfo; 
    HANDLE      SaveHandle;
    LPFILEPATH  FilePathPtr; 
    BOOL        More;
    short         rc; 
    static      short PMDataFileType;
    static      HANDLE  PMhDB=0;
    static      char    PMDataFile[128]; 
    short         FieldLists[3]={IDC_FIELDS,IDC_XFIELD,IDC_YFIELD},
                FieldListTypes[3]={TRUE,TRUE,TRUE};
    

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 if (DATAFILEMsgProc(hWndDlg,Message,wParam,lParam,
                     SV_SET_FILE, SV_DATABASE_LIST, SV_TABLE_NAMES, FieldLists,3,
                     PMDataFile, &PMDataFileType, &PMhDB,FieldListTypes,TRUE))  return TRUE;
 switch(Message)
   {
    case GSSI_REINITDIALOG:
    case WM_INITDIALOG:
         SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_SETCHECK,TRUE,0L);
         SendDlgItemMessage (hWndDlg,IDC_VIA_TAG,BM_SETCHECK,TRUE,0L);
         SendDlgItemMessage (hWndDlg,IDC_SYM_ASSIGNMENT_LIST,LB_SETTABSTOPS,2,(LPARAM)&TabStops); 
         LoadTAGDef ();   
         if (NumTAGDef)
         { 
            LPTAGDEF    lpTAGDef; 
            
            lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
            for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
                SendDlgItemMessage (hWndDlg,IDC_TAPREFIX,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
            GlobalUnlock (hTAGDef);
         } 
         SendDlgItemMessage (hWndDlg,IDC_METHOD,CB_ADDSTRING,0,(LPARAM)"By Coordinates");
         SendDlgItemMessage (hWndDlg,IDC_METHOD,CB_ADDSTRING,0,(LPARAM)"From TAGed Item");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Feet");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Meters");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Degrees");
         SendDlgItemMessage (hWndDlg,IDC_UNITS,CB_ADDSTRING,0,(LPARAM)"Degrees * 1000000");
         _fstrcpy (str,"*.CVT");
         DlgDirListComboBox (hWndDlg,str,IDC_PROJECTION,0,DDL_READWRITE);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 if (ContinueProcessing)
                    ContinueProcessing=FALSE;
                 else
                 {
	                 if (hSQL)
	                 {
	                    GlobalUnlock(FilePtr->FileHandle); 
	                    GlobalUnlock (SQLPtr->OFHandle);
	                    GlobalFree (FilePathHandle);
	                    FilePathHandle = SaveHandle;
	                    CloseDataFile (TRUE, &hSQL);  
	                 } 
	                 EndDialog(hWndDlg, FALSE); 
	             }
                 break;
            
            case IDC_LOCATE_DESTMAP: 
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName (hWndDlg,str,IDS_FILTERPLT,".PLT")) break;   
                 }
                 else  
                 {
                    if (!GetFileName (hWndDlg,str,IDS_FILTERPLT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTMAP,str);
                 break;
                 
            case IDC_OPEN_DB:
                 EnableWindow (GetDlgItem(hWndDlg,IDC_SAADD),TRUE);
                 break;
                      
            case IDC_SAADD:      
            {    
                 HANDLE hMem;
                 LPSTR  lpStr, lpWhere;
                 char   SymName[10];
                 
                 if (!SelectPointSymbol (hWndDlg,SymName,size,rot))
                    break;

                 hMem = GSSiGlobAlloc (GMEM_MOVEABLE,4096);
                 lpStr = GlobalLock (hMem);
                 if (!GetSQLWhereClause (hWndDlg, PMhDB, lpStr))
                 {
                    GlobalUnlock (hMem);
                    GlobalFree (hMem);
                    break;            
                 }
                 SendDlgItemMessage (hWndDlg,IDC_SYMBOL_LIST,LB_ADDSTRING,0,(LPARAM)SymName);
                 SendDlgItemMessage (hWndDlg,IDC_SQL_LIST,LB_ADDSTRING,0,(LPARAM)lpStr);
                 break;
            }    
            case IDC_SADELETE:
                 break;
            
            case IDOK: 
            {
                 long   lineno=0, TotLen, CurLoc, MidLine;  
                 long   NewRefno; 
                 short    st, SymNum, iUDI=0, AreaSym, LineSym, LocOpt, Pass=1;
                 BOOL   Done, First=TRUE; 
                 HANDLE hMIDstr;
                 char   Prefix[10], UDI[256], UDIField[256], XCoordField[256], YCoordField[256];
                     
                 char   LinkUDIField[64], UDILink[34], SymName[10], project[32];
                 double X,Y;
                 LPSTR  lpTAB, pSQL, pUDI=UDI; 
                 DPOINT Point;
                 BOOL   Store;
                 short    Symbol=1; 
                 COLORREF   Color;
                 LPSTR  lpDot; 
                 MNMXCORD MinMaxCoord;  
                 double coordcvt=1;
                 short    NumSyms=0;  
                 HANDLE hSymDesc=0; 
                  
                 if (!GetDlgItemText (hWndDlg,IDC_DESTMAP,PltName,sizeof(PltName)))
                 {
                    MessageBox(GetFocus(),"No destination map", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
                 if (SendDlgItemMessage (hWndDlg,IDC_VIA_TAG,BM_GETCHECK,0,0))
                    LocOpt=1;
                 else 
                 {
                    LocOpt=2;
                    GetDlgItemText (hWndDlg,IDC_XFIELD,XCoordField,sizeof(XCoordField));
                    GetDlgItemText (hWndDlg,IDC_YFIELD,YCoordField,sizeof(YCoordField)); 
                    if (!*XCoordField ||!*YCoordField)
                    {
                        MessageBox(GetFocus(),"X and/or Y coordinate field missing", 0,MB_ICONQUESTION|MB_OK);
                        break;
                    }
                    if (!GetDlgItemText (hWndDlg,IDC_PROJECTION,project,sizeof(project)))
                    {
                        MessageBox(GetFocus(),"No input projection set", 0,MB_ICONEXCLAMATION|MB_OK);
                        break;
                    }
                    if ((lpDot=_fstrrchr(project,'.')))
                        *lpDot = 0;
                    SetGlobalValue("%ALT_PROJECTION",project);
                    GetDlgItemText (hWndDlg,IDC_UNITS,str,sizeof(str));
                    if (*str)
                    { 
                        if (!_fstrcmp(str,"Degrees * 1000000"))
                            coordcvt = 0.0000001; 
                        else if (!_fstrcmp(str,"Feet"))
                        {
                            PRJ_UNITS[3] = 1;
                            if (PRJ_UNITS[1] == 2 && !*project)
                                coordcvt = FTM;
                        }       
                        else if (!_fstrcmp(str,"Meters"))
                        {
                            PRJ_UNITS[3] = 2;
                            if (PRJ_UNITS[1] == 1 && !*project)
                                coordcvt = MFT;
                        }       
                    }
                    else
                    {
                        MessageBox(GetFocus(),"Units field not set", 0,MB_ICONQUESTION|MB_OK);
                        break;
                    }
                 }
                 i = SendDlgItemMessage(hWndDlg,IDC_SYMBOL_LIST,LB_GETCOUNT,0,0);
                 if (i<=0)  
                 {  
                    MessageBox(GetFocus(),"No symbol assignment rules", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
				 size = atof (CurSymSize);  
				 switch (CurSymSizeUnits)
				 {
				 	case 0:
				 	case 1: 
				 	break;
				 	case 2:
				 		size = -size;
				 	break;
				 }
                 ExpandText (PltName);
                 PltType = 2;
                 ForceRefIndex = TRUE;   
                 Done = FALSE;
                 MidLine=0; 
                 str[0]=0;  
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0))
                    Pass = 0;
                 else
                    Pass = 1; 
                 
NextPass:       
                 if (Pass)
                    SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"Loading Data");
                 else
                 {       
                    SetDlgItemText (hWndDlg,IDC_PROCESS_MESS,"Scanning for min/max coordinates");
                    MinMaxCoord.xmn = DBL_MAX;
                    MinMaxCoord.xmx = -DBL_MAX; 
                    MinMaxCoord.ymn = DBL_MAX;
                    MinMaxCoord.ymx = -DBL_MAX; 
                 }       
                 pPrefix = Prefix;    
                 GetDlgItemText(hWndDlg,IDC_TAPREFIX,Prefix,sizeof(Prefix));
                 UDIField[0]=0; 
                 if (*pPrefix) 
                     GetDlgItemText(hWndDlg,IDC_FIELDS,UDIField,sizeof(UDIField));               
                 else
                    pPrefix = 0;   
                    
                CloseDataFile (TRUE, &hSQL);  
                SendDlgItemMessage(hWndDlg,IDC_SYMBOL_LIST,LB_GETTEXT,0,(DWORD)SymName);
                Symbol = GetDictSymbolNumber (SymName);              
                AddToSymList (Symbol,&NumSyms,&hSymDesc);
                SendDlgItemMessage(hWndDlg,IDC_SQL_LIST,LB_GETTEXT,0,(DWORD)str);                
                pSQL = str;
                if (!_fstrcmp (pSQL,"ALL ROWS"))
                    *pSQL = 0;
                    
                hSQL = 0;
                if (!OpenDataFile (PMDataFile,pSQL,BT_READ,&hSQL))
                {  
                    MessageBox(GetFocus(),"Cannot open data file", 0,MB_ICONQUESTION|MB_OK);
                    break;
                }
                    
                SaveHandle = FilePathHandle;
                FilePathHandle = GlobalAlloc (GHND,sizeof(HANDLE)+2+MAXFILESINPATH*sizeof(HANDLE));
                FilePathPtr = (LPFILEPATH)GlobalLock (FilePathHandle);
                FilePathPtr->LastPathHandle = SaveHandle;
                FilePathPtr->FileHandle=hSQL;
                FilePathPtr->NumFiles=1; 
                GlobalUnlock(FilePathHandle);
                                        
                SQLPtr = (LPOPENSQLDATA)GlobalLock (hSQL);
                FilePtr = (LPOPENFILEDATA)GlobalLock (SQLPtr->OFHandle); 
                if (First)
                {   
                	HCURSOR	OldCursor;
                	
                    OldCursor = SetCursor (LoadCursor (0,IDC_WAIT));
                    TotLen = NumSQLRows (SQLPtr);  
		            SetCursor (OldCursor);
                }
                First = FALSE;
                                    
                NewRefno=0;
        NextLine:
                 if (Done || !ContinueProcessing)
                    goto EndFile; 
                 if (LocOpt == 1)
                    GetValFromOpenFiles (LinkUDIField,UDILink);
                 else 
                 {  
                    _fstrcpy (str,XCoordField);
                    ExpandText(str);  
                    Point.x = atof (str)*coordcvt;
                    _fstrcpy (str,YCoordField);
                    ExpandText(str);  
                    Point.y = atof (str)*coordcvt;
                    if (*project)
                        ConvertCoord(&Point,3,1);
                 }
                 if (*UDIField)
                 {
                    _fstrcpy (UDI,UDIField);
                    ExpandText (UDI); 
                 } 
                 lineno++; 
                 Store = PointInFileBounds (&Point,&MinMaxCoord,Pass);
                 if (Pass)
                 {
                     NewRefno = TMPRF$;  
                     OpenRefIndex (FALSE);
                     if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_FIRST,BT_GE,(LPSTR)&RefIdxData)) 
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_LAST,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }          
                     else
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_PRIOR,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }  
                     
                     if (Store)     
                            AddPointToMap (Point,NewRefno,Symbol,size,rot,pPrefix,pUDI,-1,-1,-1); 
                 }
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, lineno,0);
                 rc = FetchODBCRecord (SQLPtr);  
                 if(rc != SQL_SUCCESS && rc != SQL_SUCCESS_WITH_INFO)
                    Done=TRUE;  
                 goto NextLine;
                 
        ErrorEnd: 
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld\r\n%s",lineno,str);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                 }
                    
        EndFile: 
                 CloseRefIndex();           
                 if (hSQL)
                 {
                    GlobalUnlock(FilePtr->FileHandle); 
                    GlobalUnlock (SQLPtr->OFHandle);
                    GlobalFree (FilePathHandle);
                    FilePathHandle = SaveHandle;
                    CloseDataFile (TRUE, &hSQL);  
                 } 
                 if (!Pass && ContinueProcessing)
                 {
                     short NumPens=10;
                     PENDESC PenDesc[10];
                     
                     for (i=0;i<NumPens;i++)
                     {
                        PenDesc[i].PenNum = i+1;
                        PenDesc[i].Width = (float)1.0; 
                        PenDesc[i].Style = 1;
                        PenDesc[i].Color = RGB(0,0,0);
                     }
                     CreateNewMap (PltName,&MinMaxCoord,NumSyms,hSymDesc,
                                                        NumPens,(LPPENDESC)&PenDesc); 
//                   GlobalUnlock (hSymDesc);     
                    Pass = 1;
                    Done = FALSE; 
                    lineno = 0;
                    goto NextPass;
                 }

                 DestroySymList (&NumSyms,&hSymDesc);
                 ForceRefIndex = FALSE; 
                 EndDialog(hWndDlg, TRUE); 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
}   

#if WIN32
    BOOL WINAPI LOADMIFMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
#else
    BOOL FAR PASCAL LOADMIFMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
#endif
{ 
    short     TabStops[2]={1200,1300}, i;
    char    Ext[8], ExtID[34];
    char    Name[128],MidName[128], str[256];
    FILE    *FidMIF, *FidMID;
    LPSTR   pPrefix, pUDI, lpDot, lpMIDstr;  
    HCURSOR OldCursor=0;  
    char	SymName[16]; 
    double	size,rot;  

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
		 SetDlgItemText(hWndDlg,IDC_SYMNAMEA,"AUTOMATIC");         
		 SetDlgItemText(hWndDlg,IDC_SYMNAMEL,"AUTOMATIC");         
		 SetDlgItemText(hWndDlg,IDC_SYMNAMEP,"AUTOMATIC");         
         SendDlgItemMessage (hWndDlg,IDC_PRESERVE_MAPINFO,BM_SETCHECK,TRUE,0L);
         cwCenter(hWndDlg, 0);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
            case IDC_LOCATE_SOURCE: 
            {    
                BOOL    HaveMID=FALSE;
                LPTAGDEF    lpTAGDef; 
                short     nFields; 
                LPSTR   lpSpace;
    
                 _fstrcpy (Ext,".MIF"); 
                 _fstrcpy (ExtID,"MapInfo Data Interchange Format");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,Name,0))   
                 {
                    OldCursor = SetCursor (LoadCursor (0,IDC_WAIT));
                    SendDlgItemMessage (hWndDlg,IDC_UDI,CB_RESETCONTENT,0,0);
                    SendDlgItemMessage (hWndDlg,IDC_FIELDS,CB_RESETCONTENT,0,0);
                    
                     SetDlgItemText (hWndDlg,IDC_FILE,Name);  
                     _fstrcpy (MidName,Name);
                     lpDot = _fstrrchr (MidName,'.');
                     if (lpDot)
                     {
                        *lpDot = 0;
                        _fstrcat (MidName,".mid");   
                        HaveMID = ExistFile (MidName);
                     }
                     if (!HaveMID) 
	                 {  
	                    
	                    MessageBox(GetFocus(),"No data file (.mid extension)", 0,MB_ICONEXCLAMATION|MB_OK);
	                    break;
	                 }
                     SetDlgItemText (hWndDlg,IDC_ATTRIBUTE_FILE,MidName);
                     LoadTAGDef ();   
                     if (NumTAGDef<=0) break; 
                     lpTAGDef = (LPTAGDEF)GlobalLock (hTAGDef);
                     for (i=0;i<NumTAGDef;i++,lpTAGDef++) 
                        SendDlgItemMessage (hWndDlg,IDC_UDI,CB_ADDSTRING,0,(LPARAM)lpTAGDef->Prefix);
                     GlobalUnlock (hTAGDef);
                     FidMIF=fopen(Name,"rt");
                     if (!FidMIF) break;  
                     while (fgetss(str,256,FidMIF))
                     {
                        if (!_fstrnicmp (str,"Columns ",8))
                        {
                            nFields = atoi (&str[8]);
                            while (nFields--)
                            {
                                fgetss(str,256,FidMIF);
                                if ((lpSpace=_fstrchr(&str[2],' ')))
                                    *lpSpace = 0;
                                SendDlgItemMessage (hWndDlg,IDC_FIELDS,CB_ADDSTRING,0,(LPARAM)&str[2]);
                            }
                        }
                     }
                     fclose (FidMIF); 
                 }
            }  
            SetCursor (OldCursor);
                 break;
                 
            case IDC_LOCATE_DESTMAP: 
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName (hWndDlg,str,IDS_FILTERPLT,".PLT")) break;   
                 }
                 else  
                 {
                    if (!GetFileName (hWndDlg,str,IDS_FILTERPLT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTMAP,str);
                 break;
                 
            case IDC_GET_SYMA:
                 if (!SelectPointSymbol (hWndDlg,SymName,size,rot))
                    break;  
                SetDlgItemText (hWndDlg,IDC_SYMNAMEA,SymName); 
                break;
                
            case IDC_GET_SYML:
                 if (!SelectPointSymbol (hWndDlg,SymName,size,rot))
                    break;  
                SetDlgItemText (hWndDlg,IDC_SYMNAMEL,SymName); 
                break;
                
            case IDC_GET_SYMP:
                 if (!SelectPointSymbol (hWndDlg,SymName,size,rot))
                    break;  
                SetDlgItemText (hWndDlg,IDC_SYMNAMEP,SymName); 
                break;
                
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 EndDialog(hWndDlg, FALSE);
                 break;
            
            case IDOK: 
            {
                 MNMXCORD MinMaxCoord;  
                 long   lineno=0, TotLen, CurLoc, MidLine;  
                 long   NewRefno; 
                 short    st, iUDI=0, AreaSym, LineSym, PointSym, Pass;
                 BOOL   Done; 
                 HANDLE hMIDstr;
                 char   Prefix[10], UDI[34]; 
                 LPSTR  lpTAB;
                 short  NumSyms=0, SymNum;  
                 HANDLE hSymDesc=0;
         
                 if (!GetDlgItemText (hWndDlg,IDC_DESTMAP,PltName,sizeof(PltName)))
                 {  
                    
                    MessageBox(GetFocus(),"No destination map", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 GetDlgItemText (hWndDlg,IDC_FILE,Name,sizeof(Name)); 
                 _fstrcpy (MidName,Name);
                 lpDot = _fstrrchr (MidName,'.');
                 if (lpDot)
                 {
                    *lpDot = 0;
                    _fstrcat (MidName,".mid");   
                    FidMID=fopen(MidName,"rt");
                 }    
                 hMIDstr = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
                 lpMIDstr = GlobalLock (hMIDstr);
                 FidMIF=fopen(Name,"rt");
                 if (!FidMIF)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 i=GetDlgItemText(hWndDlg,IDC_SYMNAMEA,(DWORD)SymName,sizeof(SymName));
                 if (i<0)  
                 {  
                    MessageBox(GetFocus(),"No area symbol selected", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 } 
                 if (_fstricmp (SymName,"AUTOMATIC"))
                 {
	                 AreaSym = GetDictSymbolNumber (SymName);
	                 AddToSymList (AreaSym,&NumSyms,&hSymDesc); 
	             }
                 i=GetDlgItemText(hWndDlg,IDC_SYMNAMEL,(DWORD)SymName,sizeof(SymName));
                 if (i<0)  
                 {  
                    MessageBox(GetFocus(),"No line symbol selected", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
                 if (_fstricmp (SymName,"AUTOMATIC"))
                 {
	                 LineSym = GetDictSymbolNumber (SymName);
	                 AddToSymList (LineSym,&NumSyms,&hSymDesc); 
	             }
                 i=GetDlgItemText(hWndDlg,IDC_SYMNAMEP,(DWORD)SymName,sizeof(SymName));
                 if (i<0)  
                 {  
                    MessageBox(GetFocus(),"No point symbol selected", 0,MB_ICONQUESTION|MB_OK);
                    break;
                 }
                 if (_fstricmp (SymName,"AUTOMATIC"))
                 {
	                 PointSym = GetDictSymbolNumber (SymName);
	                 AddToSymList (PointSym,&NumSyms,&hSymDesc);  
	             }
                                 
                 fseek (FidMIF,0,SEEK_END);
                 TotLen = ftell (FidMIF);  
                 MinMaxCoord.xmn = DBL_MAX;
                 MinMaxCoord.xmx = -DBL_MAX; 
                 MinMaxCoord.ymn = DBL_MAX;
                 MinMaxCoord.ymx = -DBL_MAX; 
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0))
                    Pass = 0;
                 else
                    Pass = 1; 
                 
                 SaveFPT = FileProjectionType; 
				 FileProjectionType=0;
                 DisableHalt = TRUE;  
                 ExpandText (PltName);
                 PltType = 2; 
                 
NextPass:       
                 fseek (FidMIF,0,SEEK_SET); 
                 ExpandText (PltName);
                 PltType = 2;
                 ForceRefIndex = TRUE;   
                 Done = FALSE;
                 MidLine=0; 
                 str[0]=0;
                 while (_fstricmp(str,"Data")) 
                 {
                    if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++;
                 }
                 if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++;
                 if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++; 
                 
                 if (Pass)
                 {
                     pPrefix = Prefix;    
                     iUDI = SendDlgItemMessage(hWndDlg,IDC_UDI,LB_GETCURSEL,0,0); 
                     if (iUDI != LB_ERR) 
                     {
                         SendDlgItemMessage(hWndDlg,IDC_UDI,LB_GETTEXT,iUDI,(DWORD)pPrefix);                 
                         pUDI = UDI; 
                         iUDI = SendDlgItemMessage(hWndDlg,IDC_FIELDS,LB_GETCURSEL,0,0); 
                         if (iUDI == LB_ERR) 
                         {  
                            MessageBox(GetFocus(),"No TAG Field selected", 0,MB_ICONQUESTION|MB_OK);
                            break;
                         }
                     }
                     else
                        pPrefix = 0;
                 }
                 else
                    iUDI = -1;
        NextLine:
                 if (Done) goto EndFile;                 
                 lineno++;
                 if (Pass)
                 {   
                     NewRefno = TMPRF$;  
                     OpenRefIndex (FALSE);
                     if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_FIRST,BT_GE,(LPSTR)&RefIdxData)) 
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_LAST,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }          
                     else
                     {
                        if (BT_FIND (hRefIdx,(LPSTR)&NewRefno,BT_PRIOR,BT_ANY,(LPSTR)&RefIdxData))
                            NewRefno = LONG_MIN; 
                        else
                            NewRefno++; 
                     }
                 }
                 if (!_fstrncmp(str,"Region ",7))
                 {  
                    short     nPoly, nPoints,lastnpoints, nPolygon;
                    long    nVertex;
                    HANDLE  hPoly, hnPnts; 
                    LPINT   pnPnts;
                    LPDPOINT    lpDPoint, lpDPoints;
                    DPOINT  LinkPoint;
                    LPSTR   lpSpace;
                    BOOL    Store, FirstPoly;
                    
                    if (!GetMIDData(FidMID,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    Store=TRUE;  
                    hPoly = 0; 
                    nPoints = 0;
                    nPoly = atoi(&str[7]);  
                    FirstPoly=TRUE;
                    if (nPoly > 1)
                    {
                        hnPnts = GSSiGlobAlloc (GHND,nPoly*sizeof(short));
                        pnPnts = (LPINT)GlobalLock (hnPnts); 
                        nPolygon = nPoly;
                    }
                    else
                        hnPnts = 0;
                    while (nPoly--)
                    {    
                         OpenRefIndex (FALSE);
                         if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++; 
                         nVertex = atol (str);
                         if (hnPnts)
                            *(pnPnts++)=nVertex;
                         lastnpoints=nPoints;
                         nPoints += nVertex;
                         if (hPoly)
                         {  
                            nPoints++;
                            hPoly = GlobalReAlloc (hPoly,(DWORD)nPoints*sizeof(DPOINT),0); 
                            lpDPoints = (LPDPOINT)GlobalLock(hPoly); 
                            lpDPoint = lpDPoints;
                            lpDPoint += lastnpoints;
                         }
                         else
                         {
                             hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nPoints*sizeof(DPOINT));
                             lpDPoint = (LPDPOINT)GlobalLock (hPoly); 
                             lpDPoints = lpDPoint;
                         } 
                         while (nVertex--)
                         { 
                            if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++; 
                            lpDPoint->x = atof (str);
                            if (!(lpSpace=_fstrchr(str,' '))) goto ErrorEnd;
                            lpDPoint->y = atof (lpSpace); 
                            if (ConvertCoord(lpDPoint,2,1)) 
                            {
                                Store=FALSE;
                                Done=TRUE;
                                FirstPoly=FALSE; 
                                break;
                            } 
                            if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                                Store=FALSE;    
                            lpDPoint++;
                         }   
                         if (FirstPoly)
                         {
                            lpDPoint--;
                            LinkPoint = *lpDPoint;
                         }  
                         else
                            *lpDPoint = LinkPoint; 
                         GlobalUnlock (hPoly);
                         FirstPoly=FALSE;
                    }
                    Done = GetMIFCharacteristics (FidMIF,str,&lineno);
                    if (hnPnts)   
                    {
                        GlobalUnlock (hnPnts);  
                        pnPnts = (LPINT)GlobalLock (hnPnts);
                        if (Store)
                            AddPolyToMap (-nPolygon,pnPnts, &hPoly,0,NewRefno,2,AreaSym,0,pPrefix,pUDI,
                                            MIFForeColor,MIFPenColor,MIFPenWidth); 
                        GlobalUnlock (hnPnts); 
                        GlobalFree (hnPnts);
                    } 
                    else 
                    {
                        if (Store)
                            AddPolyToMap (1,(int *)&nPoints, &hPoly,0,NewRefno,2,AreaSym,0,pPrefix,pUDI,
                                            MIFForeColor,MIFPenColor,MIFPenWidth); 
                    }
                    GlobalFree (hPoly);  
                    
                 }
                 else if (!_fstrncmp(str,"Point ",6))
                 {  
                    HANDLE  hDPoints, hnPnts; 
                    LPHANDLE    phDpoints;
                    LPDPOINT    lpDPoints;  
                    LPINT   pnPnts;
                    DPOINT  DPoint; 
                    BOOL    Store=TRUE;  
                    LPSTR   lpSpace;  
                    short     i, nPnts, nPoly;
                    
                    if (!GetMIDData(FidMID,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    lpSpace = &str[5];
                    DPoint.x = atof(lpSpace++);
                    lpSpace = _fstrchr(lpSpace,' ');
                    DPoint.y = atof(lpSpace++);
                    ConvertCoord(&DPoint,2,1);
                    if (!PointInFileBounds (&DPoint,&MinMaxCoord,Pass))
                        Store=FALSE;    
                    Done = GetMIFCharacteristics (FidMIF,str,&lineno);
                    nPoly = GetSymbol (SymNum,&DPoint,&hnPnts,&hDPoints);
                    pnPnts = (LPINT)GlobalLock (hnPnts);  
                    phDpoints = (LPHANDLE)GlobalLock (hDPoints);
                    if (Store)
                        AddPolyToMap (nPoly,pnPnts, phDpoints,0,NewRefno,3,251,0,pPrefix,pUDI,
                                        MIFForeColor,MIFPenColor,MIFPenWidth); 
                        
                    GlobalUnlock (hnPnts); 
                    GlobalFree (hnPnts);  
                    GlobalUnlock (hDPoints);
                    phDpoints = (LPHANDLE)GlobalLock (hDPoints);
                    for (i=0;i<nPoly;i++,phDpoints++)
                        GlobalFree (*phDpoints);
                    GlobalUnlock (hDPoints);
                    GlobalFree (hDPoints); 
                 }
                 else if (!_fstrncmp(str,"Line ",5))
                 {  
                    HANDLE  hDPoints;
                    LPDPOINT    lpDPoints;  
                    BOOL    Store=TRUE;  
                    LPSTR   lpSpace;  
                    short     i, nPnts;
                    
                    if (!GetMIDData(FidMID,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    hDPoints = GSSiGlobAlloc (GMEM_MOVEABLE,2*sizeof(DPOINT));  
                    lpDPoints = (LPDPOINT)GlobalLock (hDPoints);
                    lpSpace = &str[5];
                    lpDPoints->x = atof(lpSpace++);
                    lpSpace = _fstrchr(lpSpace,' ');
                    lpDPoints++->y = atof(lpSpace++);
                    lpSpace = _fstrchr(lpSpace,' ');
                    lpDPoints->x = atof(lpSpace++);
                    lpSpace = _fstrchr(lpSpace,' ');
                    lpDPoints->y = atof(lpSpace); 
                    GlobalUnlock (hDPoints);
                    lpDPoints = (LPDPOINT)GlobalLock (hDPoints);
                    for (i=0;i<2;i++,lpDPoints++)
                    {
                        ConvertCoord(lpDPoints,2,1);
                        if (!PointInFileBounds (lpDPoints,&MinMaxCoord,Pass))
                            Store=FALSE;    
                    } 
                    GlobalUnlock (hDPoints); 
                    Done = GetMIFCharacteristics (FidMIF,str,&lineno);
                    nPnts = 2;
                    if (Store)
                        AddPolyToMap (1,(int *)&nPnts, &hDPoints,1,NewRefno,3,LineSym,0,pPrefix,pUDI,
                                        MIFForeColor,MIFPenColor,MIFPenWidth); 
                        
                    GlobalFree (hDPoints); 
                 }
                 else if (!_fstrncmp(str,"Pline ",6))
                 { 
                    short     nPoly, nPoints,lastnpoints, i;
                    long    nVertex; 
                    LPINT   pnPnts;    
                    LPHANDLE    phPoly;
                    HANDLE  hPoly, hPolys, hnPnts;
                    LPDPOINT    lpDPoint, lpDPoints;
                    DPOINT  LinkPoint;
                    LPSTR   lpSpace;
                    BOOL    Store, FirstPoly;
                    
                    if (!GetMIDData(FidMID,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    Store=TRUE;  
                    hPoly = 0; 
                    if (_fstrnicmp (&str[6],"Multiple",8)) 
                    {
                        nPoly = 1;
                        nVertex = atoi(&str[6]);
                    }
                    else
                    {
                        nPoly = atoi(&str[15]);   
                        if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++;
                        nVertex = atoi(str);
                    }  
                    hnPnts = GSSiGlobAlloc (GHND,nPoly*sizeof(short));
                    pnPnts = (LPINT)GlobalLock (hnPnts);
                    hPolys = GSSiGlobAlloc (GHND,nPoly*sizeof(HANDLE));
                    phPoly = (LPHANDLE)GlobalLock (hPolys);
                    for (i=0;i<nPoly;i++,pnPnts++,phPoly++)
                    {                       
                        *pnPnts = nVertex;
                        *phPoly = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nVertex*sizeof(DPOINT));
                        lpDPoint = (LPDPOINT) GlobalLock (*phPoly); 
                        lpDPoints = lpDPoint;
                        while (nVertex--)
                        { 
                            if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++; 
                            lpDPoint->x = atof (str);
                            if (!(lpSpace=_fstrchr(str,' '))) goto ErrorEnd;
                            lpDPoint->y = atof (lpSpace); 
                            ConvertCoord(lpDPoint,2,1);
                            if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                                Store=FALSE;    
                            lpDPoint++;
                        }  
                        GlobalUnlock (*phPoly);
                        if (i+1<nPoly) 
                        {
                            if (!fgetss(str,256,FidMIF)) goto ErrorEnd;lineno++;
                            nVertex = atoi(str);
                        }
                    }  
                    GlobalUnlock (hPolys);   
                    Done = GetMIFCharacteristics (FidMIF,str,&lineno);
                    phPoly = (LPHANDLE)GlobalLock (hPolys);
                    GlobalUnlock (hnPnts);  
                    pnPnts = (LPHANDLE)GlobalLock (hnPnts);
                    if (Store)     
                        AddPolyToMap (nPoly,pnPnts, phPoly,1,NewRefno,3,LineSym,0,pPrefix,pUDI,
                                        MIFForeColor,MIFPenColor,MIFPenWidth); 
                           
                    GlobalUnlock (hnPnts);  
                    GlobalUnlock (hPolys); 
                    phPoly = (LPHANDLE)GlobalLock (hPolys);  
                    for (i=0;i<nPoly;i++,phPoly++)
                        GlobalFree (*phPoly);   
                    GlobalFree (hPolys);  
                    GlobalFree (hnPnts);
                 }  
                 else if (!_fstrnicmp(str,"None",4))
                 {
                    if (!GetMIDData(FidMID,lpMIDstr,iUDI,pUDI)) goto ErrorEnd;
                    Done = GetMIFCharacteristics (FidMIF,str,&lineno);
                 }                  
                 else   
                    goto ErrorEnd;
                 
                 CurLoc = ftell (FidMIF);       
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                 
                 goto NextLine;
                 
        ErrorEnd: 
                 Pass = 2;
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld\r\n%s",lineno,str);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                 }
                    
        EndFile: 
                 if (!Pass)
                 {   
                     short NumPens=10;
                     PENDESC PenDesc[10];  
                     SYMBOL Symbol;
                         
                     for (i=0;i<NumPens;i++)
                     {
                        PenDesc[i].PenNum = i+1;
                        PenDesc[i].Width = (float)1.0; 
                        PenDesc[i].Style = 1;
                        PenDesc[i].Color = RGB(0,0,0);
                     }
//                   pSymDesc = GlobalLock(hSymDesc); 
                     CreateNewMap (PltName,&MinMaxCoord,NumSyms,hSymDesc,
                                                        NumPens,(LPPENDESC)&PenDesc);
//                   GlobalUnlock (hSymDesc);     
                     Pass=1;
                     goto NextPass;
                 }
                 fclose (FidMIF); 
                 if (FidMID)
                    fclose (FidMID); 
                 DestroySymList (&NumSyms,&hSymDesc);
                 GlobalUnlock (hMIDstr);
                 GlobalFree (hMIDstr);
                 CloseRefIndex();           
                 ForceRefIndex = FALSE;
                 DisableHalt = FALSE;
                 FileProjectionType = SaveFPT; 
                 DisableHalt = FALSE;
                 EndDialog(hWndDlg, TRUE); 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
}   

BOOL GetMIDData(FILE *FidMID,LPSTR lpMIDstr,short iUDI, LPSTR pUDI) 
{   
    LPSTR   lpStart, lpEnd, lpChar;
    char    EndChar; 
    short     i;
    
    if (!FidMID || !pUDI || iUDI<0) return TRUE;
    if (!fgetss(lpMIDstr,1024,FidMID))
        return FALSE; 
    lpStart = lpMIDstr; 
    i = 0;
Loop:
    if (*lpStart == '"')
    {
        EndChar = '"';
        lpStart++;
    }
    else
        EndChar = ',';
    lpChar = lpStart;
    while (*lpChar != EndChar && *lpChar)
        lpChar++;
    lpEnd = lpChar;
    *lpEnd = 0; 
    if (i < iUDI) 
    {
        if (EndChar == '"')
            lpChar++;
        lpChar++;
        lpStart = lpChar;
        i++;
        goto Loop;       
    }
    _fstrcpy (pUDI,lpStart);
    return TRUE;
}

BOOL GetMIFCharacteristics (FILE *FidMIF, LPSTR str,LPLONG lineno)
{
    LPSTR   lpBeg, lpEnd; 
    long    ii;
    
NextLine:
    if (!fgetss(str,256,FidMIF))
        return TRUE;
    (*lineno)++; 
    if (!_fstrnicmp (&str[4],"PEN ",4))
    {
        lpBeg = _fstrchr (str,'(');
        lpEnd = _fstrchr (lpBeg++,',');
        *lpEnd = 0;
        MIFPenWidth = atoi (lpBeg);
        lpBeg = ++lpEnd;
        lpEnd = _fstrchr (lpBeg,',');
        *lpEnd = 0;
        MIFPenStyle = atoi (lpBeg);
        lpBeg = ++lpEnd;
        lpEnd = _fstrchr (lpBeg,')');
        *lpEnd = 0;
        MIFPenColor = atol (lpBeg); 
    }
    else if (!_fstrnicmp (&str[4],"BRUSH ",6))
    { 
        lpBeg = _fstrchr (str,'(');
        lpEnd = _fstrchr (lpBeg++,',');
        *lpEnd = 0;
        MIFPattern = atoi (lpBeg);
        lpBeg = ++lpEnd;
        lpEnd = _fstrchr (lpBeg,',');
        *lpEnd = 0;
        MIFForeColor = atol (lpBeg);
        lpBeg = ++lpEnd;
        lpEnd = _fstrchr (lpBeg,')');
        *lpEnd = 0;
        MIFBackColor = atol (lpBeg); 
    }
    else if (!_fstrnicmp (&str[4],"SYMBOL ",7))
    {
    }
    else if (!_fstrnicmp (&str[4],"CENTER ",7))
    {
    } 
    else if (!_fstrnicmp (&str[4],"SMOOTH",6))
    {
    } 
    else
        return FALSE;
    goto NextLine;
}

short StreetNameType (LPSTR STName)
{
    short l, Type;
    
    l = _fstrlen (STName);
    if (!_fstrnicmp (STName,"I-",2))
        Type = 1;
    else if (!_fstrncmp (STName,"US Hwy",6))
        Type = 2;
    else if (!_fstrncmp (STName,"US Rte",6))
        Type = 2;
    else if (!_fstrnicmp (STName,"State Hwy",9))
        Type = 3;
    else if (!_fstrnicmp (STName,"State Rte",9))
        Type = 3;
    else if (!_fstrnicmp (STName,"County Hwy",10))
        Type = 4;
    else if (!_fstrnicmp (STName,"County Rte",10))
        Type = 4;
    else if (!_fstrnicmp (STName,"Twp Hwy",7))
        Type = 5;
    else if (!_fstricmp (&STName[max(0,l-4)],"Frwy"))
        Type = 6;
    else if (!_fstricmp (&STName[max(0,l-3)],"Hwy"))
        Type = 7;
    else if (!_fstricmp (&STName[max(0,l-4)],"Mtwy"))
        Type = 7;  
    else if (!_fstricmp (&STName[max(0,l-5)],"Thoro"))
        Type = 7;  
    else if (!_fstricmp (&STName[max(0,l-4)],"Thwy"))
        Type = 7;  
    else if (!_fstricmp (&STName[max(0,l-4)],"Tpke"))
        Type = 7;  
    else if (!_fstrnicmp (STName,"State Rd",8))
        Type = 8;
    else if (!_fstrnicmp (STName,"County Rd",9))
        Type = 8;
    else if (!_fstrnicmp (STName,"Twp Rd",6))
        Type = 9;
    else
        Type = 100;
    return Type; 
}
    

BOOL FAR PASCAL LOAD_TIGERMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{ 
    short         TabStops[2]={1200,1300};
    char    File[128], Ext[8], ExtID[34];

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
         SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_SETCHECK,TRUE,0L);
         SendDlgItemMessage (hWndDlg,IDC_TF_NONE,BM_SETCHECK,TRUE,0L);
         cwCenter(hWndDlg, 0);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
            case IDC_LOCATE_SOURCE: 
            {
                 _fstrcpy (Ext,".F61"); 
                 _fstrcpy (ExtID,"TIGER File");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,File,0))   
                 {
                    SetDlgItemText (hWndDlg,IDC_FILE,File);
                 }
            }
                 break;
                 
            case IDC_LOCATE_DESTMAP: 
            {
            	char	str[128];
                 *str=0;
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    if (!GetSaveName (hWndDlg,str,IDS_FILTERPLT,".PLT")) break;   
                 }
                 else  
                 {
                    if (!GetFileName (hWndDlg,str,IDS_FILTERPLT)) break;   
                 }
                 SetDlgItemText (hWndDlg,IDC_DESTMAP,str);
            }
                 break;
                 
            case IDC_FIND_CFCC: 
            {
                 _fstrcpy (Ext,".txt"); 
                 _fstrcpy (ExtID,"TIGER CFCC list");
                 sprintf (gszFilter,"%s(*%s)|*%s|",ExtID,Ext,_fstrlwr(Ext));
                 if (GetFileName(hWndDlg,File,0))   
                 {
                    SetDlgItemText (hWndDlg,IDC_CFCC_FILE,File);
                 }
            }
                 break;
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
                 EndDialog(hWndDlg, FALSE);
                 break;
                 
            case IDC_ADD_CFCC_TO_DICT:
                 LoadCFCCTable ();
                 break;                 
            
            case IDOK: 
            {
                 char Name[128],TrueName[34], str[256], SymName[16];
                 FILE   *FidTIGER1, *FidTIGER2, *FidCFCC;
                 long   lineno=0, TotLen, CurLoc;  
                 long   NewRefno, Offset; 
                 short    st, NumShapes, ii;   
                 BTVARDESC  BTVar[3];
                 TIGER1 Tiger1; 
                 TIGER1_PEOPLENET   Tiger1PN; 
                 TIGER1_GEOSPAN     Tiger1GS; 
                 OFSTRUCT   OFStruct;
                 short        nPoly, lastnpoints, Pass, idesc, NumSyms,i, AttFormat=0;
                 long   nVertex;
                 HANDLE hPoly, hShapes, hSymDesc=0, hCFCC;
                 LPDPOINT   lpDPoint, lpDPoints, lpShapes;
                 DPOINT LinkPoint;
                 LPSTR  lpSpace, lpExt, lpCFCC;
                 LPINT  lpNumCFCC;
                 BOOL   Store, FirstPoly, WantAreas[8];
                 MNMXCORD MinMaxCoord;  
                 HANDLE     hBTTiger1Out;
                 HFILE  FidTiger1Out; 
                 char   STName[48], Buff[64];   
                 LPSYMDESC  pSymDesc;
                
                          
                 if (!GetDlgItemText (hWndDlg,IDC_DESTMAP,PltName,sizeof(PltName)))
                 {  
                    MessageBox(GetFocus(),"No destination map", 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 if (SendDlgItemMessage (hWndDlg,IDC_TF_NONE,BM_GETCHECK,0,0))
                    AttFormat = 0;
                 if (SendDlgItemMessage (hWndDlg,IDC_TF_NAMES,BM_GETCHECK,0,0))
                    AttFormat = 1;
                 if (SendDlgItemMessage (hWndDlg,IDC_TF_ALL,BM_GETCHECK,0,0))
                    AttFormat = 2;
                 if (SendDlgItemMessage (hWndDlg,IDC_TF_GEOSPAN,BM_GETCHECK,0,0))
                    AttFormat = 3;
                 
                switch (AttFormat)
                {
                    case 0:
                    break;
                    case 3:  
                    {
                        LPGWDHEADER lpGWDHead;    
                        
                        CreateSegData();  
                        hDBSegdata = OpenGWDatabase ("geospan.gwd",BT_WRITE);
                        lpGWDHead = (LPGWDHEADER)GlobalLock (hDBSegdata); 
                        hSegData = lpGWDHead->BTHandle[0]; 
                        hBTTiger1Out = hSegData;
                        SegDataFid = lpGWDHead->Fid; 
                        FidTiger1Out = SegDataFid;
                        GlobalUnlock (hDBSegdata);
                    }
                    break;
                    default:

                        BTVar[0].BT_VARTYP=BT_INTEGER;
                        BTVar[0].BT_VARLEN=4;
                        BTVar[0].BT_VAROFF=0;
                        if (!(hBTTiger1Out= BT_OPEN ("tiger1.btr", 0, BT_WRITE, 0)))
                        {
                            BT_CREATE ("tiger1.btr", 4, FALSE, 1, 1,(LPBTVARDESC)&BTVar,FALSE, 0, 0, FALSE);
                            hBTTiger1Out= BT_OPEN ("tiger1.btr", 0, BT_WRITE, 0);
                            FidTiger1Out = GSSiOpenFile ("tiger1.dat",&OFStruct,OF_CREATE);
                         } 
                         else 
                            FidTiger1Out = GSSiOpenFile ("tiger1.dat",&OFStruct,OF_READWRITE);
                 }
                 GetDlgItemText (hWndDlg,IDC_FILE,Name,sizeof(Name)); 
                 _fstrlwr (Name);
                 FidTIGER1=fopen(Name,"rt");
                 if (!FidTIGER1)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 fseek (FidTIGER1,0,SEEK_END);
                 TotLen = ftell (FidTIGER1);
                 lpExt = _fstrstr(Name,".f61");  
                 *lpExt = 0;
                 _fstrcat (Name,".f62");
                 FidTIGER2=fopen(Name,"rt");
                 if (!FidTIGER2)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 GetDlgItemText (hWndDlg,IDC_CFCC_FILE,Name,sizeof(Name)); 
                 _fstrlwr (Name);
                 FidCFCC=fopen(Name,"rt");
                 if (!FidCFCC)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open CFCC file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 
                 hCFCC = GSSiGlobAlloc (GHND,1024);
                 lpNumCFCC = (LPINT)GlobalLock (hCFCC);
                 lpCFCC = (LPSTR)lpNumCFCC;
                 lpCFCC+=2;
                 while (fgetss(str,sizeof(str),FidCFCC))  
                 {
                    (*lpNumCFCC)++;
                    _fstrncpy(lpCFCC,str,3);
                    lpCFCC+=3;
                 }
                 GlobalUnlock (hCFCC);
                 fclose (FidCFCC);     
                 
                 
                 hShapes = GSSiGlobAlloc (GHND,(long)UINT_MAX);
                 lpShapes = (LPDPOINT)GlobalLock (hShapes);   
                 SetDlgItemText (hWndDlg,IDC_MESS1,"Creating shape file index");
                 GetTLIDShapePoints (-1,&NumShapes,lpShapes,FidTIGER2);  
                 GlobalUnlock (hShapes);
                 OpenSymDict ("TIGER.gsd", OF_READWRITE);     
                 OpenGSStreetNames (BT_WRITE,3);
                 if (SendDlgItemMessage (hWndDlg,IDC_NEWMAP,BM_GETCHECK,0,0)) 
                 {
                    Pass=0;
                 }
                 else
                 {
                    Pass=1;
                 }
                 SaveFPT = FileProjectionType; 
				 FileProjectionType=0;
                 DisableHalt = TRUE;  
                 ExpandText (PltName);
                 PltType = 2; 
                 MinMaxCoord.xmn = DBL_MAX;
                 MinMaxCoord.xmx = -DBL_MAX; 
                 MinMaxCoord.ymn = DBL_MAX;
                 MinMaxCoord.ymx = -DBL_MAX;
                 
        NextPass:

                 fseek (FidTIGER1,0,SEEK_SET);
                 if (!Pass)
                    SetDlgItemText (hWndDlg,IDC_MESS1,"Scanning for min/max coordinates");
                 else
                    SetDlgItemText (hWndDlg,IDC_MESS1,"Loading data");
        NextLine:                
                 if (!fgetss((char *)&Tiger1,sizeof(TIGER1),FidTIGER1))
                    goto EndFile;
                 lineno++;  
                 if (Pass)
                 {
                    sprintf (STName,"%s %s %s %s", 
                             strncpy0(Buff,Tiger1.FEDIRP,2),
                             strncpy0(&Buff[16],Tiger1.FENAME,30),
                             strncpy0(&Buff[4],Tiger1.FETYPE,4),
                             strncpy0(&Buff[10],Tiger1.FEDIRS,2)); 
                    OneSpace (STName);
                    Tiger1PN.StreetNum = GetGSStreetNum (STName);
                 } 
                 NewRefno = ldread(Tiger1.TLID,10);   
                 lpShapes = (LPDPOINT)GlobalLock (hShapes);
                 GetTLIDShapePoints (NewRefno,&NumShapes,lpShapes,FidTIGER2); 
                 if (WantThisTLID (NewRefno,&Tiger1,WantAreas,Pass,hCFCC))
                 {  
                    if (Pass)
                    {   
                        if (AttFormat)
                        {
                            Offset = _llseek (FidTiger1Out,0,2);
                            BT_PUT (hBTTiger1Out,(LPSTR)&NewRefno,(LPSTR)&Offset);  
                            Tiger1PN.TLID = ldread (Tiger1.TLID,10);  
                        
                            Tiger1PN.ZIPL = ldread (Tiger1.ZIPL,5);
                            Tiger1PN.ZIPR = ldread (Tiger1.ZIPR,5);
                            Tiger1PN.STATEL = ldread (Tiger1.STATEL,2);
                            Tiger1PN.STATER = ldread (Tiger1.STATER,2);
                            Tiger1PN.COUNTYL = ldread (Tiger1.COUNTYL,3);
                            Tiger1PN.COUNTYR = ldread (Tiger1.COUNTYR,3);
                            Tiger1PN.FPLL = ldread (Tiger1.FPLL,5);
                            Tiger1PN.FPLR = ldread (Tiger1.FPLR,5);
                            _fmemmove (Tiger1PN.CTBNAL,Tiger1.CTBNAL,6);
                            _fmemmove (Tiger1PN.CTBNAR,Tiger1.CTBNAR,6);
                            _fmemmove (Tiger1PN.BLKL,Tiger1.BLKL,4);
                            _fmemmove (Tiger1PN.BLKR,Tiger1.BLKR,4);
                            Tiger1PN.FRLONG = ldread (Tiger1.FRLONG,10);
                            Tiger1PN.TOLONG = ldread (Tiger1.TOLONG,10);
                            Tiger1PN.FRLAT = ldread (Tiger1.FRLAT,9);
                            Tiger1PN.TOLAT = ldread (Tiger1.TOLAT,9);  
                            switch (AttFormat)
                            {  
                                case 2:
                                    _lwrite (FidTiger1Out,&Tiger1PN,sizeof(TIGER1_PEOPLENET));
                                break;   
                                case 3:
                                    _fmemset (&Tiger1GS,0,sizeof(Tiger1GS)); 
                                    Tiger1GS.TLID = Tiger1PN.TLID;
                                    Tiger1GS.street_num = Tiger1PN.StreetNum;
                                    Tiger1GS.frlong = Tiger1PN.FRLONG;
                                    Tiger1GS.frlat = Tiger1PN.FRLAT;
                                    Tiger1GS.tolong = Tiger1PN.TOLONG;
                                    Tiger1GS.tolat = Tiger1PN.TOLAT;
                                    _fmemcpy (Tiger1GS.CTBNAL,Tiger1PN.CTBNAL,6);
                                    _fmemcpy (Tiger1GS.CTBNAR,Tiger1PN.CTBNAR,6);
                                    _fmemcpy (Tiger1GS.CFCC,Tiger1.CFCC,3);
                                    Tiger1GS.BGL = ldread (Tiger1PN.BLKL,1);
                                    Tiger1GS.BGR = ldread (Tiger1PN.BLKR,1);
                                    Tiger1GS.FMCDL = ldread (Tiger1.FMCDL,5);
                                    Tiger1GS.FMCDR = ldread (Tiger1.FMCDR,5);
                                    Tiger1GS.ZIPLeft = Tiger1PN.ZIPL;
                                    Tiger1GS.ZIPRight = Tiger1PN.ZIPR;
                                    Tiger1GS.faddl = ldread (Tiger1.FRADDL,11);
                                    Tiger1GS.taddl = ldread (Tiger1.TOADDL,11);
                                    Tiger1GS.faddr = ldread (Tiger1.FRADDR,11);
                                    Tiger1GS.taddr = ldread (Tiger1.TOADDR,11);
                                    WriteSegData(Offset,&Tiger1GS);
                                break;   
                            }  
                        }
                    }
                    Store=TRUE;  
                    hPoly = 0; 
                    nVertex = NumShapes+2;
                    hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nVertex*sizeof(DPOINT));
                    lpDPoint = (LPDPOINT)GlobalLock (hPoly); 
                    lpDPoints = lpDPoint;  
                    lpDPoint->x = dread(Tiger1.FRLONG,10)/1000000;
                    lpDPoint->y = dread(Tiger1.FRLAT,10)/1000000;    
                    ConvertCoord(lpDPoint,2,1);
                    if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                        Store=FALSE;
                    lpDPoint++;
                    while (NumShapes--)
                    { 
                        *lpDPoint = *(lpShapes++);
                        ConvertCoord(lpDPoint,2,1);
                        if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                            Store=FALSE;    
                        lpDPoint++;
                    } 
                    lpDPoint->x = dread(Tiger1.TOLONG,10)/1000000;
                    lpDPoint->y = dread(Tiger1.TOLAT,10)/1000000;    
                    ConvertCoord(lpDPoint,2,1);
                    if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                        Store=FALSE;    
                    
                    _fmemmove (SymName,Tiger1.CFCC,3);
                    SymName[3]=0;
                    idesc = GetDictSymbolNumber (SymName);
                    if (!idesc)  
                    {
                        _fstrcpy (SymName,"X00");
                        idesc = GetDictSymbolNumber ("X00"); 
                    }
                    if (hSymDesc)
                    {
                        pSymDesc = (LPSYMDESC)GlobalLock(hSymDesc);
                        for (i=0;i<NumSyms;i++,pSymDesc++)
                            if (idesc == pSymDesc->Number)
                            {
                                GlobalUnlock (hSymDesc);
                                goto HaveSym;
                            }
                        GlobalUnlock (hSymDesc);
                        NumSyms++;
                        hSymDesc = GlobalReAlloc (hSymDesc,NumSyms*sizeof(SYMDESC),0); 
                    }
                    else                                        
                    {
                        NumSyms=1;
                        hSymDesc = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(SYMDESC));
                    }
                    pSymDesc = (LPSYMDESC)GlobalLock(hSymDesc);
                    pSymDesc += NumSyms-1;
                    pSymDesc->Number = idesc;
                    pSymDesc->Handle = GetDictSymDesc (idesc);
                    GlobalUnlock (hSymDesc);
            HaveSym:    
                    GlobalUnlock (hPoly);
                    if (Store)  
                    {    
                        short     ipen; 
                        
                        ipen = SymName[0]-'A' + 1;
                        ipen = min (9,ipen);
                        
                        AddPolyToMap (1,(LPINT)&nVertex, &hPoly,1,NewRefno,ipen,idesc,0,0,0,-1,-1,0); 
                    }
                    GlobalFree (hPoly); 
                 }
                 GlobalUnlock (hShapes); 
                 CurLoc = ftell (FidTIGER1);       
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                 
                 goto NextLine;
                 Pass=1; 
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld",lineno);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                 }
                    
        EndFile: 
                 if (Pass>=0)
                 {
                     if (!Pass)
                     {   
                         short NumPens=10;
                         PENDESC PenDesc[10];
                         
                         for (i=0;i<NumPens;i++)
                         {
                            PenDesc[i].PenNum = i+1;
                            PenDesc[i].Width = 1; 
                            PenDesc[i].Style = 1;
                            PenDesc[i].Color = RGB(0,0,0);
                         }
                         CreateNewMap (PltName,&MinMaxCoord,NumSyms,hSymDesc,
                                                            NumPens,(LPPENDESC)&PenDesc);
                         Pass=1;
                         goto NextPass;
                     }
                 }
                 switch (AttFormat)
                 {
                    case 0:
                        break;
                    case 3:
                        CloseGWDatabase (hDBSegdata);
                        hDBSegdata = 0;
                        hSegData = 0;  
                        break;
                    default:                    
                        _lclose (FidTiger1Out);
                        BT_CLOSE (hBTTiger1Out);
                        break;
                 }           
                 fclose (FidTIGER1); 
                 fclose (FidTIGER2);
                 CloseGSStreetNames();
                 CloseSymDict();
                 GetTLIDShapePoints (-2,&NumShapes,lpShapes,FidTIGER2);
                 GlobalUnlock (hSymDesc);
                 GlobalFree (hSymDesc);
                 GlobalUnlock (hCFCC);
                 GlobalFree (hCFCC);   
                 GlobalFree (hShapes);              
                 DisableHalt = FALSE;
                 FileProjectionType = SaveFPT; 
                 EndDialog(hWndDlg, TRUE); 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
} 


BOOL FAR PASCAL LOAD_TIGER_PNMsgProc(HWND hWndDlg, WORD Message, WPARAM wParam, LPARAM lParam)
{ 
    short         TabStops[2]={1200,1300};
    char    File[128], Ext[8], ExtID[34];

 short    BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam))) return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG:
         if (!EditName[0] && !NewName[0])
         {
            MessageBox(GetFocus(),"No New or Update layer", 0,MB_ICONEXCLAMATION|MB_OK);
            EndDialog(hWndDlg, FALSE);
            break;
         }
         cwCenter(hWndDlg, 0);
         break; /* End of WM_INITDIALOG                                 */

    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_COMMAND:
#if WIN32
         switch(LOWORD(wParam))
#else
         switch(wParam)
#endif
         {  
         	case IDC_STATELEV: 
         	{
				short State;
				SaveFPT = FileProjectionType; 
				FileProjectionType=0;
				DisableHalt = TRUE;  
         		for (State = 1;State<60;State++)
					 CreateStateLev (State,hWndDlg,IDC_STATUS,IDC_MESS2);
				DisableHalt = FALSE;
				FileProjectionType = SaveFPT; 
			}
         		break;
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */   
                 if (ContinueProcessing)
                    ContinueProcessing=FALSE;
                 else
                    EndDialog(hWndDlg, FALSE);
                 break;
                 
            case IDOK: 
            {
                 char Name[34],TrueName[34], str[260], SymName[16], Dir[128], Directories[128];
                 FILE   *FidTIGER1, *FidTIGER2,*FidTIGER4,*FidTIGER5;
                 HFILE  FidCFCC;
                 long   lineno=0, TotLen, CurLoc, TotLen2, CurLoc2;  
                 long   NewRefno, Offset; 
                 short    st, NumShapes, idummy;   
                 BTVARDESC  BTVar[3];
                 TIGER1 Tiger1; 
                 TIGER4 Tiger4; 
                 TIGER5 Tiger5; 
                 TIGER1_MN  Tiger1PN;  
                 OFSTRUCT   OFStruct;
                 short        nPoly, lastnpoints, Pass, idesc, NumSyms,i, Stuff[256], FirstType;
                 long   nVertex, StreetNum, FeatID, StreetNums[4], Tiger1Snum;
                 HANDLE hPoly, hShapes, hSymDesc=0, *phSymDesc, hCFCC, hBTNames1,hBTNames2;
                 LPDPOINT   lpDPoint, lpDPoints, lpShapes;
                 DPOINT LinkPoint, BeginPoint,EndPoint;
                 LPSTR  lpSpace, lpExt, lpCFCC, lpSlash, lpNextState, lpState;
                 LPINT  lpNumCFCC;
                 BOOL   Store, FirstPoly, WantAreas[8];
                 MNMXCORD MinMaxCoord;  
                 HANDLE     hBTTiger1Out, hIntersect;
                 HFILE  FidTiger1Out; 
                 char   STName[48], Buff[64];
                 char   mess[256];
                 short  State, County, Layer, ii, PrimeName;
                 HFILE  FidFileList, FidStateLev;      
                 struct {long   TLID;
                         short    Type;
                         long   StreetNum;
                         } Names1Key;
                 struct {
                         short    Type;
                         long   StreetNum;
                         } Names2Data;   
                 struct {
                         long   TLID,
                                SNums[4];
                         DPOINT BeginPoint,
                                EndPoint;
                         char   CFCC[3];
                         } StateLev;
                         
                                
                 
                 SaveFPT = FileProjectionType; 
				 FileProjectionType=0;
                 DisableHalt = TRUE;  
                 GetDlgItemText (hWndDlg,IDC_DIRECTORY,Directories,sizeof(Directories)); 
                 lpNextState = Directories;
     NextState:        
     			 if (!lpNextState)
     			 	goto EndState;
     			 lpState = lpNextState; 
                 lpNextState = _fstrchr (lpState,',');
                 if (lpNextState)
                 	*lpNextState++=0;
                 _fstrcpy (Dir,lpState);  
                 sprintf (str,"Loading state %s",Dir);
                 SetDlgItemText (hWndDlg,IDC_MESS3,str);
                 _fstrcat (Dir,"\\");
                 _fstrcpy (str,Dir);
                 _fstrcat (str,"layer1");
                 _mkdir (str);   
                 _fstrcpy (str,Dir);
                 _fstrcat (str,"layer2");
                 _mkdir (str);   
                 SetGlobalValue("STATE_DIR",Dir);  
                 SetGlobalValue("%DATA_LOC",Dir);
                 CreateStnameFilesUpdate ();
                FidStateLev = GSSiOpenFile ("[STATE_DIR]statelev",&OFStruct,OF_CREATE);
                _lclose (FidStateLev);
                BTVar[0].BT_VARTYP=BT_INTEGER;
                BTVar[0].BT_VARLEN=4;
                BTVar[0].BT_VAROFF=0;
                BT_CREATE ("[STATE_DIR]tiger1.btr", 4, FALSE, 1, 1,(LPBTVARDESC)&BTVar,FALSE, 0, 0, FALSE);
                FidTiger1Out = GSSiOpenFile ("[STATE_DIR]tiger1.dat",&OFStruct,OF_CREATE);
                _lclose (FidTiger1Out); 
                 FidFileList = GSSiOpenFile ("[STATE_DIR]filelist.txt",&OFStruct,OF_READ);
                 if (FidFileList == HFILE_ERROR)  
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Unable to open filelist file: %s","[STATE_DIR]filelist.txt");
                    ExpandText (mess);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }  
                TotLen2 = _llseek (FidFileList,0,2);
                _llseek (FidFileList,0,0);  
     NextFile1:
                 if (!fgetstring (Name,128,FidFileList)|| !ContinueProcessing) 
                 {
                    _llseek (FidFileList,0,0); 
                     CloseGSStreetNames();
                    CreateIntersectionFile (TRUE);
                    goto NextFile; 
                 }

                 lpSlash = _fstrrchr (Name,'\\');
                 if (lpSlash)
                    _fstrcpy (str,++lpSlash);
                 else
                    _fstrcpy (str,Name);
                 State = ldread (&str[3],2); 
                 CurState = State;
                 OpenGSStreetNames (BT_WRITE,3);
                 SetDlgItemText (hWndDlg,IDC_MESS2,Name); 
                 hBTTiger1Out= BT_OPEN ("[STATE_DIR]tiger1.btr", 0, BT_WRITE, 0);
                 FidTiger1Out = GSSiOpenFile ("[STATE_DIR]tiger1.dat",&OFStruct,OF_READWRITE);
                 CurLoc2 = _llseek (FidFileList,0,1);
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS2), TotLen2, CurLoc2,0);   
                 FidTIGER1=fopen(Name,"rt");
                 if (!FidTIGER1)  
                 {  
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 fseek (FidTIGER1,0,SEEK_END);
                 TotLen = ftell (FidTIGER1);
                 fseek (FidTIGER1,0,SEEK_SET);  
                 SetDlgItemText (hWndDlg,IDC_MESS1,"Creating Intersection File");
        NextLine1:
                 if (!fgetss((char *)&Tiger1,sizeof(TIGER1),FidTIGER1) || !ContinueProcessing) 
                 {
                    fclose (FidTIGER1);
                    _lclose (FidTiger1Out);
                    BT_CLOSE (hBTTiger1Out);
                    goto NextFile1;      
                 }  
                 NewRefno = ldread(Tiger1.TLID,10);  
                 if (NewRefno == 203169772)
                    ii=1;
                
                 if (Tiger1.CFCC[0] == 'A')
                 {  
                    sprintf (STName,"%s %s %s %s", 
                             strncpy0(Buff,Tiger1.FEDIRP,2),
                             strncpy0(&Buff[16],Tiger1.FENAME,30),
                             strncpy0(&Buff[4],Tiger1.FETYPE,4),
                             strncpy0(&Buff[10],Tiger1.FEDIRS,2)); 
                    OneSpace (STName); 
                    if (*STName)
                    {
                        REPLAC (STName,"I -","I-",sizeof(STName)); 
                        Tiger1Snum = GetGSStreetNum (STName);
                    }
                    else
                        Tiger1Snum = 0;
                    Offset = _llseek (FidTiger1Out,0,2);
                    BT_PUT (hBTTiger1Out,(LPSTR)&NewRefno,(LPSTR)&Offset);  
                    Tiger1PN.TLID = NewRefno;  
                    Tiger1PN.StreetNum = Tiger1Snum;;
                    Tiger1PN.ZIPL = ldread (Tiger1.ZIPL,5);
                    Tiger1PN.ZIPR = ldread (Tiger1.ZIPR,5);
                    Tiger1PN.STATEL = ldread (Tiger1.STATEL,2);
                    Tiger1PN.STATER = ldread (Tiger1.STATER,2);
                    Tiger1PN.COUNTYL = ldread (Tiger1.COUNTYL,3);
                    Tiger1PN.COUNTYR = ldread (Tiger1.COUNTYR,3);
                    Tiger1PN.FPLL = ldread (Tiger1.FPLL,5);
                    Tiger1PN.FPLR = ldread (Tiger1.FPLR,5);
                    _fmemmove (Tiger1PN.CTBNAL,Tiger1.CTBNAL,6);
                    _fmemmove (Tiger1PN.CTBNAR,Tiger1.CTBNAR,6);
                    Tiger1PN.FRLONG = ldread (Tiger1.FRLONG,10);
                    Tiger1PN.TOLONG = ldread (Tiger1.TOLONG,10);
                    Tiger1PN.FRLAT = ldread (Tiger1.FRLAT,9);
                    Tiger1PN.TOLAT = ldread (Tiger1.TOLAT,9);
                    _fmemcpy (Tiger1PN.CFCC,Tiger1.CFCC,3);
                    Tiger1PN.FMCDL = ldread (Tiger1.FMCDL,5);
                    Tiger1PN.FMCDR = ldread (Tiger1.FMCDR,5);
                    Tiger1PN.faddl = ldread (Tiger1.FRADDL,11);
                    Tiger1PN.taddl = ldread (Tiger1.TOADDL,11);
                    Tiger1PN.faddr = ldread (Tiger1.FRADDR,11);
                    Tiger1PN.taddr = ldread (Tiger1.TOADDR,11);
                    _lwrite (FidTiger1Out,(char *)&Tiger1PN,sizeof(Tiger1PN));   
                }
                CurLoc = ftell (FidTIGER1);       
                PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                goto NextLine1;
                  
        NextFile:
                 if (!fgetstring (Name,128,FidFileList) || !ContinueProcessing) 
                    goto Exit; 
                 SetDlgItemText (hWndDlg,IDC_MESS2,Name); 
//               hBTTiger1Out= BT_OPEN ("[STATE_DIR]tiger1.btr", 0, BT_READ, 0);
//               FidTiger1Out = GSSiOpenFile ("[STATE_DIR]tiger1.dat",&OFStruct,OF_READ);
                 FidStateLev = GSSiOpenFile ("[STATE_DIR]statelev",&OFStruct,OF_READWRITE);
                 _llseek (FidStateLev,0,2);
                 hIntersect = BT_OPEN ("[STATE_DIR]intersec.btr", 0, BT_READ, 0);
                 CurLoc2 = _llseek (FidFileList,0,1);
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS2), TotLen2, CurLoc2,0);   
                 lpSlash = _fstrrchr (Name,'\\');
                 if (lpSlash)
                    _fstrcpy (str,++lpSlash);
                 else
                    _fstrcpy (str,Name);
                 State = ldread (&str[3],2); 
                 CurState = State;
                 County = ldread (&str[5],3);
                 _fstrlwr (Name);
                 FidTIGER1=fopen(Name,"rt");
                 if (!FidTIGER1)  
                 {  
                    
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 fseek (FidTIGER1,0,SEEK_END);
                 TotLen = ftell (FidTIGER1);
                 lpExt = _fstrstr(Name,".f61");  
                 *lpExt = 0;
                 _fstrcat (Name,".f62");
                 FidTIGER2=fopen(Name,"rt");
                 if (!FidTIGER2)  
                 {  
                        
                    sprintf (mess,"Unable to open file %s",Name);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                    break;
                 }
                 
                 hShapes = GSSiGlobAlloc (GHND,(long)UINT_MAX);
                 lpShapes = (LPDPOINT)GlobalLock (hShapes);   
                 SetDlgItemText (hWndDlg,IDC_MESS1,"Creating shape file index");
                 GetTLIDShapePoints (-1,&NumShapes,lpShapes,FidTIGER2);  
                 GlobalUnlock (hShapes);  
                 BTVar[0].BT_VARTYP=BT_INTEGER;
                 BTVar[0].BT_VARLEN=4;
                 BTVar[0].BT_VAROFF=0;
                 BTVar[1].BT_VARTYP=BT_INTEGER;
                 BTVar[1].BT_VARLEN=2;
                 BTVar[1].BT_VAROFF=4;
                 BTVar[2].BT_VARTYP=BT_INTEGER;
                 BTVar[2].BT_VARLEN=4;
                 BTVar[2].BT_VAROFF=6;
                 BT_CREATE ("tempnam1.btr", 2, FALSE, 3, 1,(LPBTVARDESC)&BTVar,FALSE, 0, 0, FALSE);
                 BTVar[0].BT_VARTYP=BT_INTEGER;
                 BTVar[0].BT_VARLEN=4;
                 BTVar[0].BT_VAROFF=0;
                 BT_CREATE ("tempnam2.btr", sizeof(Names2Data), FALSE, 1, 1,(LPBTVARDESC)&BTVar,FALSE, 0, 0, FALSE);
                 hBTNames1= BT_OPEN ("tempnam1.btr", 0, BT_WRITE, 0);
                 OpenGSStreetNames (BT_WRITE,3);
                 
                 lpExt = _fstrstr(Name,".f62");  
                 *lpExt = 0;
                 _fstrcat (Name,".f64");
                 FidTIGER4=fopen(Name,"rt");
                 if (!FidTIGER4) 
                    goto NoFile4; 
                 lpExt = _fstrstr(Name,".f64");  
                 *lpExt = 0;
                 _fstrcat (Name,".f65");
                 FidTIGER5=fopen(Name,"rt");
                 if (!FidTIGER5)  
                 { 
                    fclose (FidTIGER4); 
                    goto NoFile4; 
                 }
                 
                 hBTNames2= BT_OPEN ("tempnam2.btr", 0, BT_WRITE, 0);
                 
                 SetDlgItemText (hWndDlg,IDC_MESS1,"Loading Alternate Street Names");
                 while (fgetss((char *)&Tiger5,sizeof(TIGER5),FidTIGER5))
                 {
                    FeatID = ldread (Tiger5.FEAT,8);  
                        
                    sprintf (STName,"%s %s %s %s", 
                             strncpy0(Buff,Tiger5.FEDIRP,2),
                             strncpy0(&Buff[16],Tiger5.FENAME,30),
                             strncpy0(&Buff[4],Tiger5.FETYPE,4),
                             strncpy0(&Buff[10],Tiger5.FEDIRS,2)); 
                    OneSpace (STName); 
                    if (*STName)
                    {
                        REPLAC (STName,"I -","I-",sizeof(STName));
                        Names2Data.StreetNum = GetGSStreetNum (STName); 
                        Names2Data.Type = StreetNameType (STName);
                        BT_PUT (hBTNames2,(LPSTR)&FeatID,(LPSTR)&Names2Data);
                    }  
                 }
                 fclose (FidTIGER5);
                 while (fgetss((char *)&Tiger4,sizeof(TIGER4),FidTIGER4))
                 {
                    Names1Key.TLID = ldread (Tiger4.TLID,10);
                    
                    for (i=0;i<5;i++)
                    {
                        if ((FeatID = ldread (Tiger4.FEAT[i],8)))
                        { 
                            if (!(st=BT_FIND (hBTNames2,(LPSTR)&FeatID,BT_FIRST,BT_EQ,(LPSTR)&Names2Data)))
                            {
                                Names1Key.Type = Names2Data.Type;
                                Names1Key.StreetNum = Names2Data.StreetNum; 
                                PrimeName = 0;
                                BT_PUT (hBTNames1,(LPSTR)&Names1Key,(LPSTR)&PrimeName);
                            }
                        }
                        else
                            goto NextTIGER4;
                    }
    NextTIGER4:; 
                 }
                 fclose (FidTIGER4); 
                 BT_CLOSE (hBTNames2); 
    NoFile4:
                 OpenSymDict ("TIGER.gsd", OF_READWRITE);     
                 if (NewName[0])
                 {
                    Pass=0;
                    _fstrcpy (PltName,NewName);  
                 }
                 else
                 {
                    Pass=1;
                    _fstrcpy (PltName,EditName);  
                 }
                 ExpandText (PltName);
                 PltType = 2; 
                 MinMaxCoord.xmn = DBL_MAX;
                 MinMaxCoord.xmx = -DBL_MAX; 
                 MinMaxCoord.ymn = DBL_MAX;
                 MinMaxCoord.ymx = -DBL_MAX; 
                 Layer = 0;
                 
        NextPass:

                 fseek (FidTIGER1,0,SEEK_SET);
                 if (!Pass)
                    SetDlgItemText (hWndDlg,IDC_MESS1,"Scanning for min/max coordinates");
                 else  
                 {  
                    char    CFCCFile[128]; 
                    char    Mess[128];
                    
                    Layer++;  
                    if (Layer > 2)
                        goto EndLayers;  
                    sprintf (NewName,"%slayer%i\\tg%2.2i%3.3i%i.plt",Dir,Layer,State,County,Layer);
                    sprintf (CFCCFile,"layer%i.txt",Layer);
                    FidCFCC=GSSiOpenFile(CFCCFile,&OFStruct,OF_READ);
                    if (FidCFCC == HFILE_ERROR)  
                    {  
                        char    mess[256];
                                                
                        sprintf (mess,"Unable to open CFCC file %s",CFCCFile);
                        MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                        break;
                    }
                                         
                    hCFCC = GSSiGlobAlloc (GHND,1024);
                    lpNumCFCC = (LPINT)GlobalLock (hCFCC);
                    lpCFCC = (LPSTR)lpNumCFCC;
                    lpCFCC+=2;
                    while (fgetstring(str,256,FidCFCC))  
                    {
                        (*lpNumCFCC)++;
                        _fstrncpy(lpCFCC,str,3);
                        lpCFCC+=3;
                    }
                    GlobalUnlock (hCFCC);
                    _lclose (FidCFCC);    

                    sprintf (PltName,"%slayer%i\\tg%2.2i%3.3i%i.plt",Dir,Layer,State,County,Layer);
                    
                    sprintf (Mess,"Loading layer %i",Layer);
                    SetDlgItemText (hWndDlg,IDC_MESS1,Mess); 
                }
        NextLine:                
                 if (!fgetss((char *)&Tiger1,sizeof(TIGER1),FidTIGER1)|| !ContinueProcessing)
                    goto EndFile;   
                 NewRefno = ldread(Tiger1.TLID,10);  
                 if (NewRefno == 203169772)
                    ii=1;
                 if (!Pass)
                 {
                    sprintf (STName,"%s %s %s %s", 
                             strncpy0(Buff,Tiger1.FEDIRP,2),
                             strncpy0(&Buff[16],Tiger1.FENAME,30),
                             strncpy0(&Buff[4],Tiger1.FETYPE,4),
                             strncpy0(&Buff[10],Tiger1.FEDIRS,2)); 
                    OneSpace (STName); 
                    if (*STName)
                    {
                        REPLAC (STName,"I -","I-",sizeof(STName)); 
                        Tiger1Snum = GetGSStreetNum (STName);
                        Names1Key.StreetNum = Tiger1Snum; 
                        Names1Key.Type = StreetNameType (STName);
                        Names1Key.TLID = NewRefno;   
                        PrimeName = 1;
                        BT_PUT (hBTNames1,(LPSTR)&Names1Key,(LPSTR)&PrimeName); 
                    }
                    else
                        Tiger1Snum = 0;
                 }
                
                _fmemset (StreetNums,0,16); 
                Names1Key.StreetNum = 0; 
                Names1Key.Type = 0;
                Names1Key.TLID = NewRefno; 
                i=0;  
                FirstType = 100;  
                Tiger1Snum = 0;
                st = BT_FIND (hBTNames1,(LPSTR)&Names1Key,BT_FIRST,BT_GE,(LPSTR)&PrimeName); 
                while (!st && Names1Key.TLID == NewRefno && i < 4)
                {   
                    if (!i)
                        FirstType = Names1Key.Type; 
                    if (PrimeName)
                    {
                        Tiger1Snum = Names1Key.StreetNum;  
                        Names1Key.StreetNum*=-1;
                    }
                    StreetNums[i++] = Names1Key.StreetNum;  
                    st = BT_FIND (hBTNames1,(LPSTR)&Names1Key,BT_NEXT,BT_ANY,(LPSTR)&PrimeName);  
                }
                if (Tiger1.CFCC[0] == 'A')
                {  
                    short Acode;
                                                
                    Acode = ldread (&Tiger1.CFCC[1],2);
                    if (Acode >= 40)
                    {
                        if (FirstType < 100)
                        {
                            Tiger1.CFCC[1] = '9'; 
                            Tiger1.CFCC[2] = '0' + FirstType;
                        }
                    }
                } 
                 lineno++;   
                 if (WantThisTLID (NewRefno,&Tiger1,WantAreas,Pass,hCFCC))
                 {  
                    Store=TRUE;  
                    lpShapes = (LPDPOINT)GlobalLock (hShapes);
                    GetTLIDShapePoints (NewRefno,&NumShapes,lpShapes,FidTIGER2);
                    hPoly = 0; 
                    nVertex = NumShapes+2;
                    hPoly = GSSiGlobAlloc (GMEM_MOVEABLE,(DWORD)nVertex*sizeof(DPOINT));
                    lpDPoint = (LPDPOINT)GlobalLock (hPoly); 
                    lpDPoints = lpDPoint;  
                    lpDPoint->x = dread(Tiger1.FRLONG,10)/1000000;
                    lpDPoint->y = dread(Tiger1.FRLAT,10)/1000000; 
                    StateLev.BeginPoint = *lpDPoint;   
                    ConvertCoord(lpDPoint,2,1);
                    if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                        Store=FALSE;
                    lpDPoint++;
                    while (NumShapes--)
                    { 
                        *lpDPoint = *(lpShapes++);
                        ConvertCoord(lpDPoint,2,1);
                        if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                            Store=FALSE;    
                        lpDPoint++;
                    } 
                    lpDPoint->x = dread(Tiger1.TOLONG,10)/1000000;
                    lpDPoint->y = dread(Tiger1.TOLAT,10)/1000000;   
                    StateLev.EndPoint = *lpDPoint; 
                    ConvertCoord(lpDPoint,2,1);
                    if (!PointInFileBounds (lpDPoint,&MinMaxCoord,Pass))
                        Store=FALSE;    
                    
                    _fmemmove (SymName,Tiger1.CFCC,3);
                    SymName[3]=0;
                    idesc = GetDictSymbolNumber (SymName);
                    if (!idesc)  
                    {
                        _fstrcpy (SymName,"X00");
                        idesc = GetDictSymbolNumber ("X00"); 
                    }
                    AddToSymList (idesc,&NumSyms,&hSymDesc);
                    GlobalUnlock (hPoly);
                    if (Pass && Tiger1.CFCC[0] == 'A' &&
                        (Tiger1.CFCC[1] < '4' || Tiger1.CFCC[1] == '9'))  
                    {
                        StateLev.TLID = NewRefno;
                        _fmemmove (StateLev.CFCC,Tiger1.CFCC,3);
                        _fmemmove (StateLev.SNums,StreetNums,16);
                        _lwrite (FidStateLev,(char *)&StateLev,sizeof(StateLev));
                    }
                    if (Store)  
                    {    
                        short     ipen; 
                        LPINT   pStuff;
                        
                        ipen = SymName[0]-'A' + 1;
                        ipen = min (9,ipen);
                        
                        if (Tiger1.CFCC[0] == 'A')
                        {   
                            long    Long, Lat, NextSnum; 
                            float   X4, Y4; 
                            DPOINT  DP;
                            
                            pStuff = Stuff; 
                            Stuff[1]=10;
                            _fmemmove (&Stuff[2],StreetNums,16);
                            Stuff[10]=31;
                            Long = ldread (Tiger1.FRLONG,10);
                            Lat  = ldread (Tiger1.FRLAT,9);
                            GetNextStreet (NewRefno,Tiger1Snum,hIntersect,&Long, &Lat, &NextSnum);
                            _fmemmove (&Stuff[11],&NextSnum,4); 
                            if (NextSnum)
                            {  
                                DP.x = (double)Long/1000000;
                                DP.y = (double)Lat/1000000;    
                                ConvertCoord(&DP,2,1);
                                X4 = DP.x;
                                Y4 = DP.y;
                                _fmemmove (&Stuff[13],&X4,4);
                                _fmemmove (&Stuff[15],&Y4,4);
                            }
                            Long = ldread (Tiger1.TOLONG,10);
                            Lat  = ldread (Tiger1.TOLAT,9);
                            GetNextStreet (NewRefno,Tiger1Snum,hIntersect,&Long, &Lat, &NextSnum);
                            _fmemmove (&Stuff[17],&NextSnum,4); 
                            if (NextSnum)
                            {  
                                DP.x = (double)Long/1000000;
                                DP.y = (double)Lat/1000000;    
                                ConvertCoord(&DP,2,1);
                                X4 = DP.x;
                                Y4 = DP.y;
                                _fmemmove (&Stuff[19],&X4,4);
                                _fmemmove (&Stuff[21],&Y4,4);
                            }
                            Stuff[23]=30; 
                            Stuff[24]=GetIntersectStuff(NewRefno,hIntersect,&Tiger1,&Stuff[25]);
                            Stuff[0] =2+24 + 2 + 16 + 2 + 2 + Stuff[24]*2;     
                        } 
                        else
                            pStuff = 0;
                        AddPolyToMap (1,(LPINT)&nVertex, &hPoly,1,NewRefno,ipen,idesc,pStuff,0,0,-1,-1,0); 
                    }
                    GlobalFree (hPoly); 
                    GlobalUnlock (hShapes); 
                 }
                 CurLoc = ftell (FidTIGER1);       
                 PctBox (GetDlgItem(hWndDlg,IDC_STATUS), TotLen, CurLoc,0);
                 
                 goto NextLine;
                 
        ErrorEnd: 
                 
                 Pass=1; 
                 {  
                    char    mess[256];
                    
                    sprintf (mess,"Error in file at line %ld",lineno);
                    MessageBox(GetFocus(),mess, 0,MB_ICONEXCLAMATION|MB_OK);
                 }
                    
        EndFile: 
                 if (Pass>=0)
                 {
                     if (!Pass)
                     {   
                         short NumPens=10;
                         PENDESC PenDesc[10];
                         
                         for (i=0;i<NumPens;i++)
                         {
                            PenDesc[i].PenNum = i+1;
                            PenDesc[i].Width = (float)1.0; 
                            PenDesc[i].Style = 1;
                            PenDesc[i].Color = RGB(0,0,0);
                         }
                         for (i=1;i<3;i++)
                         {
                            sprintf (NewName,"%slayer%i\\tg%2.2i%3.3i%i.plt",Dir,i,State,County,i);
                            CreateNewMap (NewName,&MinMaxCoord,NumSyms,hSymDesc,
                                                                NumPens,(LPPENDESC)&PenDesc);
                         }
                         Pass=1;
                         goto NextPass;
                     }
                 }
                 GlobalUnlock (hCFCC);
                 GlobalFree (hCFCC);  
                 CloseMap();
                 goto NextPass; 
        EndLayers: 
                 DestroySymList (&NumSyms,&hSymDesc);
                 _lclose (FidStateLev);
//               _lclose (FidTiger1Out);
//               BT_CLOSE (hBTTiger1Out);
                 BT_CLOSE (hBTNames1);
                 CloseGSStreetNames();
                 GetTLIDShapePoints (-2,&NumShapes,lpShapes,FidTIGER2);
                 fclose (FidTIGER1); 
                 fclose (FidTIGER2);
                 CloseSymDict();    
                 GlobalFree (hShapes);              
                 if (hIntersect)
                    BT_CLOSE (hIntersect); 
                 goto NextFile;
            Exit: 
                 _lclose (FidFileList);  
				 _fstrcpy (str,"[STATE_DIR]intersec.btr");
				 ExpandText (str);
				 remove (str); 
				 _fstrcpy (str,"[STATE_DIR]tiger1.btr");
				 ExpandText (str);
				 remove (str);
				 _fstrcpy (str,"[STATE_DIR]tiger1.dat");
				 ExpandText (str);
				 remove (str);
                 goto NextState;
        EndState:
                 EndDialog(hWndDlg, TRUE);
                 DisableHalt = FALSE;
                 FileProjectionType = SaveFPT; 
                 break;
                 
            }   
          }
          break;

    default:
        return FALSE;
   }
 return TRUE;    
} 

short GetIntersectStuff (long TLID, HANDLE hIntersect,LPTIGER1 Tiger1,LPINT Stuff)
{   
    short TotLen=0;
    LPINT   pNum;
    long    IntLong, IntLat, snum; 
    short     st, i;
    struct  {
                long Long, Lat, TLID;
            }   IntersectKey;
    struct  {
                long    Snum;
                long    OPLong, OPLat;
            }   IntersectData;
    
    if (!hIntersect)
        return 0; 
    IntLong = ldread (Tiger1->FRLONG,10); 
    IntLat = ldread (Tiger1->FRLAT,9);  
    i=2;
    
    while (i--)
    {
        pNum = Stuff++;
        TotLen++;
        *pNum = 0; 
        IntersectKey.Long = IntLong; 
        IntersectKey.Lat = IntLat; 
        IntersectKey.TLID = 0;  
        st = BT_FIND (hIntersect,(LPSTR)&IntersectKey,BT_FIRST,BT_GT,(LPSTR)&IntersectData);
        while (!st)
        {
            if (IntersectKey.Long != IntLong || IntersectKey.Lat != IntLat)
                st = 1;
            else
            {   
                if (IntersectKey.TLID != TLID)
                {   
                    _fmemmove (Stuff,&IntersectKey.TLID,4);
                    Stuff+=2;
                    _fmemmove (Stuff,&IntersectData.Snum,4);
                    Stuff+=2; 
                    (*pNum)++;  
                    TotLen += 4;
                }
                st = BT_FIND (hIntersect,(LPSTR)&IntersectKey,BT_NEXT,BT_ANY,(LPSTR)&IntersectData);
            }
        }
        IntLong = ldread (Tiger1->TOLONG,10); 
        IntLat = ldread (Tiger1->TOLAT,9);  
    }  
    return TotLen;
}

BOOL GetNextStreet (long TLID, long Snum, HANDLE hIntersect,LPLONG Long, LPLONG Lat, LPLONG NextSNum)
{   
    short     NumLinks=0, MaxLinks=25;
    TIGER1_MN   Tiger1PN; 
    short TotLen=0;
    LPINT   pNum;
    long    IntLong, IntLat, snum, NextTLID, NextLong, NextLat; 
    short     st, i;
    struct  {
                long Long, Lat, TLID;
            }   IntersectKey;
    struct  {
                long    Snum;
                long    OPLong, OPLat;
            }   IntersectData;
        
    *NextSNum = 0;
    if (!hIntersect)
        return FALSE; 
    IntLong = *Long; 
    IntLat = *Lat;  

NextLink:   
    IntersectKey.Long = IntLong; 
    IntersectKey.Lat = IntLat; 
    IntersectKey.TLID = 0;    
    NextTLID = 0;
    st = BT_FIND (hIntersect,(LPSTR)&IntersectKey,BT_FIRST,BT_GT,(LPSTR)&IntersectData);
    while (!st)
    {   
        snum = IntersectData.Snum;
        if (IntersectKey.Long != IntLong || IntersectKey.Lat != IntLat)
            st = 1;
        else
        {   
            if (IntersectKey.TLID != TLID)
            {   
                if (snum && (snum != Snum))
                {
                    *Long = IntersectKey.Long;
                    *Lat = IntersectKey.Lat;
                    *NextSNum = snum;
                    return TRUE;
                } 
                else if (snum == Snum) 
                {
                    NextTLID = IntersectKey.TLID;
                    NextLong = IntersectData.OPLong;
                    NextLat = IntersectData.OPLat;
                }
            }
            st = BT_FIND (hIntersect,(LPSTR)&IntersectKey,BT_NEXT,BT_ANY,(LPSTR)&IntersectData);
        }
    } 
    if (!NextTLID || NumLinks > MaxLinks || !Snum)
        return FALSE; 
    TLID = NextTLID;
    IntLong = NextLong;
    IntLat = NextLat;  
    NumLinks++;
    goto NextLink;
}

long GetGSStreetNum (LPSTR Name)
{   
    char    StrName[34], LastName[34];  
    long    StrNum;
    
    _fstrncpy (StrName,Name,34);
    if (!BT_FIND (hNames2,StrName,BT_FIRST,BT_EQ,(LPSTR)&StrNum))
        return StrNum;
    if (!BT_FIND (hNames1,(LPSTR)&StrNum,BT_LAST,BT_ANY,(LPSTR)&LastName))
        StrNum++;
    else
        StrNum=1;
    BT_PUT (hNames1,(LPSTR)&StrNum,(LPSTR)StrName);
    BT_PUT (hNames2,(LPSTR)StrName,(LPSTR)&StrNum);
    return StrNum;
} 

BOOL PointInFileBounds (LPDPOINT lpDPoint,LPMNMXCORD MinMaxCoord, short Pass)
{
    if (!Pass)
    {   
        MinMaxCoord->xmn = min (MinMaxCoord->xmn,lpDPoint->x);
        MinMaxCoord->xmx = max (MinMaxCoord->xmx,lpDPoint->x);
        MinMaxCoord->ymn = min (MinMaxCoord->ymn,lpDPoint->y);
        MinMaxCoord->ymx = max (MinMaxCoord->ymx,lpDPoint->y);
        return FALSE;
    } 
    if (Pass < 0) return FALSE;
    if (lpDPoint->x < CurView->FileMNMX.xmn ||   
        lpDPoint->x > CurView->FileMNMX.xmx ||
        lpDPoint->y < CurView->FileMNMX.ymn ||
        lpDPoint->y > CurView->FileMNMX.ymx)
        return FALSE;    
    else
        return TRUE;
}

void GetTLIDShapePoints (long TLID,LPINT NumShapes,LPDPOINT lpShapes,FILE *FidTIGER2)
{   
    static  short     CurNumPoints;
    static  TIGER2  Tiger2;  
    short     i, WantEvery=1;
    BTVARDESC   BTVar[2];  
    static  char    TigerShapeIndex[64]=""; 
    static  HANDLE  hIndex;
    long    Offset, CurTLID;
    struct {long    TLID;
            short     seq;} Index;
    
    *NumShapes=0;
    if (TLID == -1)
    {

        if (!TigerShapeIndex[0])
            GetTempFileName (0,"TSF",0,(LPSTR)&TigerShapeIndex);
        BTVar[0].BT_VARTYP=BT_INTEGER;
        BTVar[0].BT_VARLEN=4;
        BTVar[0].BT_VAROFF=0;
        BTVar[1].BT_VARTYP=BT_INTEGER;
        BTVar[1].BT_VARLEN=2;
        BTVar[1].BT_VAROFF=4;
        BT_CREATE (TigerShapeIndex, 4, FALSE, 2, 1,(LPBTVARDESC)&BTVar,FALSE, 0, 0, FALSE);
        hIndex= BT_OPEN (TigerShapeIndex, 0, BT_WRITE, 0); 
        Offset = ftell(FidTIGER2);
        while (fgetss((char *)&Tiger2,sizeof(TIGER2),FidTIGER2))  
        {
            Index.TLID = ldread(Tiger2.TLID,10);
            Index.seq = ldread(Tiger2.RTSQ,3); 
            BT_PUT (hIndex,(LPSTR)&Index,(LPSTR)&Offset);  
            Offset = ftell(FidTIGER2);
        }
        BT_CLOSE (hIndex);
        hIndex= BT_OPEN (TigerShapeIndex, 0, BT_READ, 0); 
        return;
    }
    if (TLID == -2)
    {
        BT_CLOSE (hIndex);
        remove (TigerShapeIndex);
        return;
    } 
    Index.TLID = TLID;
    Index.seq = 1;
    
    if (!BT_FIND (hIndex,(LPSTR)&Index,BT_FIRST,BT_EQ,(LPSTR)&Offset)) 
    {
        CurTLID = Index.TLID;      
        fseek (FidTIGER2,Offset,SEEK_SET); 
        fgetss((char *)&Tiger2,sizeof(TIGER2),FidTIGER2);       
    }
    else
        CurTLID = LONG_MAX;
    while (CurTLID == TLID)  
    {   
        for (i=0;i<10;i++)
        {
            lpShapes->x = dread((LPSTR)&Tiger2.LONGLAT[i].Longitude,10)/1000000;
            lpShapes->y = dread((LPSTR)&Tiger2.LONGLAT[i].Latitude,9)/1000000;
            if (lpShapes->x != 0 && ((i+1)%WantEvery) == 0)
            {
                (*NumShapes)++;
                lpShapes++;
            }
        }
        if (fgetss((char *)&Tiger2,sizeof(TIGER2),FidTIGER2))
            CurTLID = ldread(Tiger2.TLID,10); 
        else
            CurTLID = LONG_MAX;
    }
    return;
}

BOOL WantThisTLID (long TLID,LPTIGER1 Tiger1,LPINT WantAreas, short Pass,HANDLE hCFCC)
{   
    LPINT   pNumCFCC;
    LPSTR   lpCFCC; 
    short     i;
    
    if (!Pass) return TRUE; 
    if (Pass<0)
    {
        if (Tiger1->CFCC[0]=='A')
            return TRUE;
        else
            return FALSE;
    }
    pNumCFCC = (LPINT)GlobalLock (hCFCC);
    lpCFCC = (LPSTR)pNumCFCC;
    lpCFCC+=2;
    for (i=0;i<*pNumCFCC;i++,lpCFCC+=3)
    {
        if (!_fstrncmp(Tiger1->CFCC,lpCFCC,3))
        {
            GlobalUnlock (hCFCC);
            return TRUE;         
        }
    }
    GlobalUnlock (hCFCC);
    return FALSE;
}

DPOINT  OrthoToGround(DPOINT Ortho,LPTRN lptr)
{
    DPOINT  pt;
    
    pt.x = lptr->a * (Ortho.y - lptr->xc) + lptr->b * (Ortho.x - lptr->yc) + lptr->e;
    pt.y = lptr->c * (Ortho.y - lptr->xc) + lptr->d * (Ortho.x - lptr->yc) + lptr->f;
    return pt;
}

BOOL LoadUSGSOrthos (HWND hWnd, WORD Message, WPARAM wParam, LPARAM lParam)
{HDC hDC;
 char key;
 POINT  MousePoint,Point1,Point2;
 DPOINT BasePoint;
 char   NearRec[256];
 static BOOL    HaveDown=FALSE;
#if WIN32
    WIN32_FIND_DATA FindFileData;
    LPWIN32_FIND_DATA lpFindFileData = &FindFileData; 
    HANDLE st;
#else
    struct _find_t FileInfo;
    short st;
#endif
 char   str[512], Name[32], name[128];  
 TRN        tr;
 short    i, rtn, nr;  
 HFILE  FidOrtho,FidDump; 
 LPSTR  lpStr;  
 OFSTRUCT   OFStruct;
 long   nLines, nSamples;    
 DPOINT NWPoint, SWPoint, SEPoint, NEPoint; 
 DPOINT NWOrtho, SWOrtho, SEOrtho, NEOrtho;
 double DistGround, DistOrtho, GroundPerOrtho;
 static HANDLE hRect=0,hNames=0,hCoord=0,hRes=0;
 LPRECT pRect;
 LPDPOINT   pCoord;
 LPDOUBLE   pRes; 
 LPSTR  pNames;
 static short nRect=0;
 HANDLE hTranOrthoToBase,hTranBaseToOrtho;
 double GroundX[4], GroundY[4], OrthoX[4], OrthoY[4]; 
 float  RSQMIN;

 switch (Message)
   {
    case GF_INIT: 
        ConvertCoordClose (); 
        GSSiOpenFile("orthos.txt",&OFStruct,OF_DELETE); 
        if (!GetTextString (hWnd,CDDrive,1,"Enter the drive letter of containing the USGS DOQ CD"))
            break;
        VerifyDisk (CDDrive);
        hRect = GSSiGlobAlloc(GMEM_MOVEABLE,sizeof(RECT)*(DWORD)1024);
        pRect = (LPRECT) GlobalLock(hRect);
        hNames = GSSiGlobAlloc(GMEM_MOVEABLE,(DWORD)64*(DWORD)1024);
        pNames = GlobalLock(hNames); 
        hCoord = GSSiGlobAlloc(GMEM_MOVEABLE,(DWORD)1024*5*sizeof(DPOINT));
        pCoord = (LPDPOINT)GlobalLock(hCoord);
        hRes   = GSSiGlobAlloc(GMEM_MOVEABLE,(DWORD)1024*sizeof(double));
        pRes   = (LPDOUBLE)GlobalLock(hRes);
        nRect = 0;   
    /*  FidDump = GSSiOpenFile("odump.txt",&OFStruct,OF_CREATE);*/
        sprintf(str,"%s:\\data\\*.??h",CDDrive);
#if WIN32
        st = FindFirstFile(str,lpFindFileData);
#else
        st = _dos_findfirst (str,_A_NORMAL,&FileInfo);
#endif
        while (!st)
        {   
#if WIN32
            strcpy(name,lpFindFileData->cFileName);
#else
            _fstrcpy(name,FileInfo.name);
#endif
            sprintf (Name,"%s:\\data\\%s",CDDrive,name);
            FidOrtho=GSSiOpenFile(Name,&OFStruct,OF_READ); 
            _fstrcpy(pNames,Name); 
            lpStr = str;
            nr = _lread (FidOrtho,lpStr,400); str[400]=0; 
        /*  fputstring (str,FidDump);*/
            nLines = atol (&str[144]); 
            nSamples = atol (&str[150]); 
            NWOrtho.x = 1;
            NWOrtho.y = 1;
            NEOrtho.x = nSamples;
            NEOrtho.y = 1; 
            SEOrtho.x = nSamples;
            SEOrtho.y = nLines;
            SWOrtho.x = 1;
            SWOrtho.y = nLines;
            lpStr = &str[207];           
            SWPoint.x = dread (lpStr,24);
            lpStr += 24;
            SWPoint.y = dread (lpStr,24);
            lpStr += 24;
            NWPoint.x = dread (lpStr,24);
            lpStr += 24;
            NWPoint.y = dread (lpStr,24);
            lpStr += 24;
            NEPoint.x = dread (lpStr,24);
            lpStr += 24;
            NEPoint.y = dread (lpStr,24);
            lpStr += 24;
            SEPoint.x = dread (lpStr,24);
            lpStr += 24;
            SEPoint.y = dread (lpStr,24);
            DistOrtho = ldistp (SWOrtho,NEOrtho);
            DistGround = ldistp (SWPoint,NEPoint);
            GroundPerOrtho = DistGround / DistOrtho;
            lpStr = str; 
            _llseek (FidOrtho,nSamples,0);
            nr = _lread (FidOrtho,lpStr,400); str[400]=0;   
            /*fputstring (str,FidDump);*/
            tr.a = dread (lpStr,24);
            lpStr += 24;
            tr.b = dread (lpStr,24);
            lpStr += 24;
            tr.c = dread (lpStr,24);
            lpStr += 24;
            tr.d = dread (lpStr,24);
            lpStr += 24;
            tr.e = dread (lpStr,24);
            lpStr += 24;
            tr.f = dread (lpStr,24);
            lpStr += 24;
            tr.xc = dread (lpStr,24);
            lpStr += 24; 
            tr.yc = dread (lpStr,24);
            lpStr += 24;    
            
            NEPoint = OrthoToGround(NEOrtho,&tr);
            SWPoint = OrthoToGround(SWOrtho,&tr);
            DistGround = ldistp (SWPoint,NEPoint);
            GroundPerOrtho = DistGround / DistOrtho; 
            
            lpStr = &str[192]; 
            GroundX[0] = dread (lpStr,24);
            lpStr += 24;    
            GroundY[0] = dread (lpStr,24);
            lpStr += 24;    
            GroundX[1] = dread (lpStr,24);
            lpStr += 24;    
            GroundY[1] = dread (lpStr,24);
            lpStr += 24;    
            GroundX[2] = dread (lpStr,24);
            lpStr += 24;    
            GroundY[2] = dread (lpStr,24);
            lpStr += 24;    
            GroundX[3] = dread (lpStr,24);
            lpStr += 24;    
            GroundY[3] = dread (lpStr,24);
            lpStr += 24;    
            
            _llseek (FidOrtho,2*nSamples,0);
            lpStr = str; 
            nr = _lread (FidOrtho,lpStr,400); str[400]=0;   
            /*fputstring (str,FidDump);*/
            tr.a = dread (lpStr,24);
            lpStr += 24;
            tr.b = dread (lpStr,24);
            lpStr += 24;
            tr.c = dread (lpStr,24);
            lpStr += 24;
            tr.d = dread (lpStr,24);
            lpStr += 24;
            tr.e = dread (lpStr,24);
            lpStr += 24;
            tr.f = dread (lpStr,24);
            lpStr += 24;
            tr.xc = dread (lpStr,24);
            lpStr += 24; 
            tr.yc = dread (lpStr,24);
               
            lpStr = &str[240]; 
            OrthoY[0] = dread (lpStr,6);
            lpStr += 6;    
            OrthoX[0] = dread (lpStr,6);
            lpStr += 6;    
            OrthoY[1] = dread (lpStr,6);
            lpStr += 6;    
            OrthoX[1] = dread (lpStr,6);
            lpStr += 6;    
            OrthoY[2] = dread (lpStr,6);
            lpStr += 6;    
            OrthoX[2] = dread (lpStr,6);
            lpStr += 6;    
            OrthoY[3] = dread (lpStr,6);
            lpStr += 6;    
            OrthoX[3] = dread (lpStr,6);
            
            NEPoint = OrthoToGround(NEOrtho,&tr);
            SWPoint = OrthoToGround(SWOrtho,&tr);
            SEPoint = OrthoToGround(SEOrtho,&tr);
            NWPoint = OrthoToGround(NWOrtho,&tr);
            DistGround = ldistp (SWPoint,NEPoint);   
            
/*          hTranOrthoToBase = STRAN2 (OrthoX,OrthoY,GroundX,GroundY,4,&RSQMIN,1);
            hTranBaseToOrtho = STRAN2 (GroundX,GroundY,OrthoX,OrthoY,4,&RSQMIN,1); 
            TRANS2 (NEOrtho.x,NEOrtho.y,&NEPoint.x,&NEPoint.y,hTranOrthoToBase);
            TRANS2 (SWOrtho.x,SWOrtho.y,&SWPoint.x,&SWPoint.y,hTranOrthoToBase);
            CloseTRANS2 (&hTranOrthoToBase);
            CloseTRANS2 (&hTranBaseToOrtho);
            DistGround = ldistp (SWPoint,NEPoint);   
*/            
            _fstrcpy (str,"[%ALT_PROJECTION]=USGSDOQ");
            ExpandText (str);
            *pRes = DistGround / DistOrtho;
            ConvertCoord(&SWPoint,3,1);
            Point1 = BasePtToWinPt(SWPoint);            
            ConvertCoord(&NEPoint,3,1);
            Point2 = BasePtToWinPt(NEPoint);
            pRect->left=Point1.x;
            pRect->bottom=Point1.y;
            pRect->top=Point2.y;
            pRect->right=Point2.x;          
            ConvertCoord(&SEPoint,3,1);
            ConvertCoord(&NWPoint,3,1);
            *pCoord++ = SWPoint;
            *pCoord++ = NWPoint;
            *pCoord++ = NEPoint;
            *pCoord++ = SEPoint;
            *pCoord++ = SEOrtho;
            /*FillRectPoly(CurView->hDC, pRect, RGB(0,
                                                  ((float)rand()*255)/RAND_MAX,
                                                  ((float)rand()*255)/RAND_MAX));*/
            DrawRectPoly(CurView->hDC, pRect,HighlightPen);
            _lclose (FidOrtho);
            pRes++; 
            pRect++; 
            pNames+=64;  
            nRect++;
#if WIN32
            if(!FindNextFile(st,lpFindFileData)) break;
#else
            st = _dos_findnext (&FileInfo);
#endif
        }
        /*_lclose (FidDump); */
        GlobalUnlock(hRect);
        GlobalUnlock(hNames); 
        GlobalUnlock(hRes);
                
        break;

    case WM_LBUTTONDOWN: 
        HaveDown = TRUE;
        return TRUE;
        
    case WM_LBUTTONUP:
        if (!HaveDown)
            return FALSE;
        HaveDown = FALSE;
        MousePoint.x = LOWORD(lParam);
        MousePoint.y = HIWORD(lParam);
        pRect =(LPRECT) GlobalLock(hRect);  
        pNames = GlobalLock(hNames);
        pCoord = (LPDPOINT)GlobalLock(hCoord); 
        pRes = (LPDOUBLE)GlobalLock(hRes);
        for (i=0;i<nRect;i++,pRect++,pNames+=64,pCoord+=5,pRes++)
            if (PtInRect (pRect,MousePoint)) 
            {   HFILE   FidOut;
                OFSTRUCT    OFStruct;
                char    txt[128];
                
                FillRectPoly(CurView->hDC, pRect, RGB(255,0,0));
                
                FidOut = GSSiOpenFile("orthos.txt",&OFStruct,OF_READWRITE);  
                if (FidOut == HFILE_ERROR)
                    FidOut = GSSiOpenFile("orthos.txt",&OFStruct,OF_CREATE);  
                else
                    _llseek (FidOut,0,2);
                fputstring (pNames,FidOut);
                sprintf (txt,"%f",pCoord->x);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord++->y);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord->x);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord++->y);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord->x);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord++->y);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord->x);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord++->y);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord->x);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",pCoord++->y);
                fputstring (txt,FidOut);
                sprintf (txt,"%f",*pRes);
                fputstring (txt,FidOut);
                _lclose(FidOut);
                break;
            }
        GlobalUnlock(hRect);
        GlobalUnlock(hNames);
        GlobalUnlock(hCoord);
        GlobalUnlock(hRes);
        break;

    case WM_RBUTTONUP:  
        nRect =0;
        GlobalFree(hRect);
        hRect=0;
        GlobalFree(hNames);
        hNames=0;
        GlobalFree(hCoord);
        hCoord=0;
        RemoveGraphicsFunction (hWnd);
        break;
    case WM_KEYDOWN:
        key = wParam;
        switch (key)
        {
            case 27: //ESC
                RemoveGraphicsFunction (hWnd); 
            break;
        }
        break;

    default:
        return (FALSE);
    }
    return (TRUE);
}  

BOOL CreateNewMap (LPSTR NewName,LPMNMXCORD MinMaxCoord,short NumSyms,HANDLE hSymDesc,
                    short NumPens,LPPENDESC pPenDesc)
{   
    LPSYMDESC pSymDesc;
    char    Name[128], Coords[130];  
    long    NewPrimeOffset;
    HANDLE  hMem;
    LPINT   pInt;  
    HFILE   Fid;
    OFSTRUCT    OFStruct;
    short     lMem, Signature, Version, i2, i, n, NumParent;  
    MNMXCORD    MinMaxD;
    mnmxCor     MinMax;  
    double  Hinc, Vinc;
    PRIMEOFFSETS NewPrimeOffs;
    LPSYMBOL    pSymbol; 
    char	Drive[4], Dir[128],name[34],Ext[8], TempName[128];
       
    NewPrimeOffs.Code101 = 101;                 
    NewPrimeOffs.Code102 = 102;                 
    NewPrimeOffs.Code103 = 103;                 
    NewPrimeOffs.Code200 = 200;                 
    NewPrimeOffs.Code201 = 201;
    NewPrimeOffs.DescBlockOffset = 0;                 
    NewPrimeOffs.Term = 0;              
    
    _fstrcpy (Name,NewName);
    ExpandText (Name);     
    
    Fid = GSSiOpenFile (Name,&OFStruct,OF_CREATE); 
    _splitpath (Name,Drive,Dir,name,Ext);
    sprintf (TempName,"%s%s%s.rin",Drive,Dir,name);
    remove (TempName);
    sprintf (TempName,"%s%s%s.tin",Drive,Dir,name);
    remove (TempName);
    
    
    Hinc = (MinMaxCoord->xmx - MinMaxCoord->xmn) * 0.025;
    Vinc = (MinMaxCoord->ymx - MinMaxCoord->ymn) * 0.025; 
    MinMaxCoord->xmn -= Hinc;
    MinMaxCoord->xmx += Hinc;
    MinMaxCoord->ymn -= Vinc;
    MinMaxCoord->ymx += Vinc;
    if (MinMaxCoord->xmx - MinMaxCoord->xmn > MinMaxCoord->ymx - MinMaxCoord->ymn)
    {
        MinMaxD.xmn = -32000;   
        MinMaxD.xmx = 32000;
        MinMaxD.ymn = MinMaxD.xmn * (MinMaxCoord->ymx - MinMaxCoord->ymn) /
                                    (MinMaxCoord->xmx - MinMaxCoord->xmn);
        MinMaxD.ymx = MinMaxD.xmx * (MinMaxCoord->ymx - MinMaxCoord->ymn) /
                                    (MinMaxCoord->xmx - MinMaxCoord->xmn);
    }
    else
    {   
        MinMaxD.ymn = -32000;   
        MinMaxD.ymx = 32000;    
        MinMaxD.xmn = MinMaxD.ymn * (MinMaxCoord->xmx - MinMaxCoord->xmn) /
                                    (MinMaxCoord->ymx - MinMaxCoord->ymn);
        MinMaxD.xmx = MinMaxD.ymx * (MinMaxCoord->xmx - MinMaxCoord->xmn) /
                                    (MinMaxCoord->ymx - MinMaxCoord->ymn);
    }  
    MinMax.xmn = IDNINT (MinMaxD.xmn);
    MinMax.ymn = IDNINT (MinMaxD.ymn);
    MinMax.xmx = IDNINT (MinMaxD.xmx);
    MinMax.ymx = IDNINT (MinMaxD.ymx);
    NewPrimeOffs.TranPointOffset = _llseek (Fid,0,1);   
    lMem = 16*4*2 + 2 + 2 ;  
    _lwrite (Fid,&lMem,2);
    sprintf (Coords,"%16f%16f%16f%16f%16f%16f%16f%16f",
                MinMaxD.xmn,  
                MinMaxD.xmx,  
                MinMaxD.ymn,  
                MinMaxD.ymx, 
                MinMaxCoord->xmn, 
                MinMaxCoord->xmx, 
                MinMaxCoord->ymn, 
                MinMaxCoord->ymx); 
    _lwrite (Fid,Coords,128);
    i2 = 0;  
    _lwrite (Fid,(char *)&i2,2); 
    n = NumSyms; 
    NumParent = 0;
    pSymDesc = (LPSYMDESC)GlobalLock (hSymDesc);
    while (n--)
    {   
        pSymbol = (LPSYMBOL)GlobalLock (pSymDesc->Handle);
        if (!pSymbol->Type)
            NumParent++;
        GlobalUnlock (pSymDesc++->Handle);
    }
    GlobalUnlock (hSymDesc);
    NewPrimeOffs.UsedDescOffset = _llseek (Fid,0,1);    
    lMem = (1+NumSyms)*12+2+2+2+2+2;  
    _lwrite (Fid,(char *)&lMem,2);
    i2 = 11; 
    _lwrite (Fid,(char *)&i2,2);
    i2 = NumSyms-NumParent; 
    _lwrite (Fid,(char *)&i2,2);  
    pSymDesc = (LPSYMDESC)GlobalLock (hSymDesc);
    n=NumSyms;
    while (n--)
    {   
        pSymbol = (LPSYMBOL)GlobalLock (pSymDesc->Handle);
        if (pSymbol->Type)
        {
            _lwrite (Fid,(char *)&pSymDesc->Number,2);
            _lwrite (Fid,(char *)&pSymbol->Parent,2);
            _lwrite (Fid,(char *)&pSymbol++->Name,8);
        } 
        GlobalUnlock (pSymDesc++->Handle);
    }
    GlobalUnlock (hSymDesc);
    i2 = NumParent;  
    _lwrite (Fid,(char *)&i2,2);
    pSymDesc = (LPSYMDESC)GlobalLock (hSymDesc);
    n=NumSyms;
    while (n--)
    {   
        pSymbol = (LPSYMBOL)GlobalLock (pSymDesc->Handle);
        if (!pSymbol->Type)
        {
            _lwrite (Fid,(char *)&pSymDesc->Number,2);
            _lwrite (Fid,(char *)&pSymbol->Parent,2);
            _lwrite (Fid,(char *)&pSymbol++->Name,8);
        } 
        GlobalUnlock (pSymDesc++->Handle);
    }
    GlobalUnlock (hSymDesc);
    i2 = 0;  
    _lwrite (Fid,(char *)&i2,2); 
    _lwrite (Fid,(char *)&i2,2); 
    
    lMem = NumPens*10+2+2;
    hMem = GSSiGlobAlloc (GHND,lMem);
    pInt = (LPINT)GlobalLock (hMem);
    *pInt++ = NumPens*10+2;  
    while (NumPens--)
    {
        *pInt++ = 1;  
        *pInt++ = pPenDesc->PenNum;
        *pInt++ = GetRValue(pPenDesc->Color);
        *pInt++ = GetGValue(pPenDesc->Color);
        *pInt++ = GetBValue(pPenDesc++->Color);
    }
    *pInt = 0;
    GlobalUnlock (hMem); 
    NewPrimeOffs.ColorPaletteOffset = _llseek (Fid,0,1);    
    pInt = (LPINT)GlobalLock (hMem);
    _lwrite (Fid,(char *)pInt,lMem);  
    GlobalUnlock (hMem);
    GlobalFree (hMem); 
    
    NewPrimeOffs.GraphicsOffset=AddSimpleQuadTree (Fid);
    
    NewPrimeOffset = _llseek (Fid,0,1); 
    i2 = sizeof(NewPrimeOffs);
    _lwrite (Fid,(char *)&i2,2);
    _lwrite (Fid,(char *)&NewPrimeOffs,sizeof(NewPrimeOffs));
    _lwrite (Fid,(char *)&NewPrimeOffset,4);
    _lwrite (Fid,(char *)&MinMax,8);
    Signature = 32349;       
    _lwrite (Fid,(char *)&Signature,2);
    Version = 4;            
    _lwrite (Fid,(char *)&Version,2);
    _lwrite (Fid,(char *)&Version,2);
    _lclose (Fid);  

    ClearAllBounds();  
    _fstrcpy (PltName,NewName);
    OpenMap (CurView->hWnd,CurView->hDC);
    CloseMap ();
    return TRUE;
} 

void AddToSymList (short idesc,LPINT NumSyms, LPHANDLE hSymDesc)
{
    LPSYMDESC   pSymDesc;
    LPSYMBOL    pSymbol; 
    short     i; 
    
Top:if (*hSymDesc)
    {
        pSymDesc = (LPSYMDESC)GlobalLock(*hSymDesc);
        for (i=0;i<*NumSyms;i++,pSymDesc++)
            if (idesc == pSymDesc->Number)
            {
                GlobalUnlock (*hSymDesc);
                return;
            }
        GlobalUnlock (*hSymDesc);
        (*NumSyms)++;
        *hSymDesc = GlobalReAlloc (*hSymDesc,*NumSyms*sizeof(SYMDESC),0); 
    }
    else                                        
    {
        *NumSyms=1;
        *hSymDesc = GSSiGlobAlloc (GMEM_MOVEABLE,sizeof(SYMDESC));
    }
    pSymDesc = (LPSYMDESC)GlobalLock(*hSymDesc);
    pSymDesc += *NumSyms-1;
    pSymDesc->Number = idesc;
    pSymDesc->Handle = GetDictSymDesc (idesc);   
    pSymbol = (LPSYMBOL) GlobalLock (pSymDesc->Handle);
    idesc = pSymbol->Parent;
    GlobalUnlock (pSymDesc->Handle);
    GlobalUnlock (*hSymDesc);    
    if (idesc) goto Top;
    return;
}

void DestroySymList (LPINT NumSyms,LPHANDLE hSymDesc)
{ 
    LPSYMDESC   pSymDesc;
    LPSYMBOL    pSymbol; 
    short     i; 
    
    if (!*hSymDesc) return; 
    
    pSymDesc = (LPSYMDESC) GlobalLock(*hSymDesc);
    while ((*NumSyms)--) 
    {
        GlobalFree (pSymDesc->Handle);
        pSymDesc++;
    }   
    GlobalUnlock (*hSymDesc);  
    GlobalFree (*hSymDesc);
    *hSymDesc = 0;  
    return;
}

long AddSimpleQuadTree (HFILE Fid)
{   
    QUAD    Quad; 
    long    LenQuadSeg, MaxQuadLevel,MaxQuadType,LenQuad;
    long    NewLoc;    
    short     lMem, i, i2;
    
    MaxQuadType = 3;
    LenQuadSeg = 8 + 4 + 4 * MaxQuadType;
    MaxQuadLevel = 4;
    LenQuad = LenQuadSeg*31;
     
    NewLoc = _llseek (Fid,0,1); 
    lMem = LenQuad + 4*4;
    _lwrite (Fid,(char *)&lMem,2);
    _lwrite (Fid,(char *)&LenQuadSeg,4);
    _lwrite (Fid,(char *)&MaxQuadLevel,4);
    _lwrite (Fid,(char *)&MaxQuadType,4);
    _lwrite (Fid,(char *)&LenQuad,4);
    
//1 
