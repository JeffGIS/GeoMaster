BOOL PanToPoint (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 char key;
 POINT	MousePoint; 
 static	HaveDown=FALSE;

 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE;
   		HaveDown=FALSE;  
   		
    case WM_MOUSEMOVE: 
        SetPrompt (PRMT_PANPOINT,TRUE);
   		break;

    case WM_LBUTTONDOWN:
    	HaveDown = TRUE;
    	break;
    	
    case WM_LBUTTONUP:
    	if (!HaveDown) break;
    	HaveDown = FALSE;
    	MousePoint.x = LOWORD(lParam);
	    MousePoint.y = HIWORD(lParam);
		if (CurView->hTranWinToBase) CenterWindow (hWnd,WinPtToBasePt(MousePoint),FALSE);
		break;
    
    case GF_CLOSE:
    case GF_CANCEL:
    	HaveDown = FALSE;
    	return FALSE;
    	
    default:
    	return (FALSE);
    }
    return (TRUE);
}

void CancelWindowZoom(void)
{   
	if (DisableHalt)
		return;
	if (!CurView)
		return;
	if (CurView->CurrentFunction==GF_ZOOM_RECT)
		ZoomRectangle (CurView->hWnd,GF_CANCEL,0,0,0);
	return;
}

BOOL MarginPan (HWND hWnd, WORD Message, WORD wParam, LONG lParam)
{
 char key;
 POINT	MousePoint;
 static	HaveDownStroke=FALSE;
 
 if (DisableMarginPan)
 	return FALSE;
 if (!CurView->MarginPan)
 	return FALSE;
 switch (Message)
   {
   	case GF_INIT:
   		HaveDownStroke=FALSE;
   		break;

    case WM_LBUTTONDOWN:
    case WM_LBUTTONUP:
    	MousePoint.x = LOWORD(lParam);
	    MousePoint.y = HIWORD(lParam);
	    if (PtInRect (&CurView->DrawRect,MousePoint))
	    {
	    	HaveDownStroke=FALSE;
	    	return FALSE;
	    }
	    if (!PtInRect (&CurView->Rect,MousePoint))
	    {
	    	HaveDownStroke=FALSE;
	    	return FALSE;
	    }
	    if (Message==WM_LBUTTONDOWN)
	    {
	    	HaveDownStroke=TRUE;
	    	return(TRUE);
	    }
	    if (!HaveDownStroke)
	    	return(FALSE);
		if (CurView->hTranWinToBase)
		{
			CancelWindowZoom();
			CenterWindow (hWnd,WinPtToBasePt(MousePoint),FALSE);
		}
    	HaveDownStroke=FALSE;
		return TRUE;
		break;


    default:
    	return (FALSE);
    }
    return (FALSE);
}

