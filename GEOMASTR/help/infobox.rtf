\par \page }{\cs117\b0\fs20\super {\*\bkmkstart WHAT_LastFoot}{\*\bkmkstart WHAT_Topic}{\*\bkmkend WHAT_LastFoot}${\footnote \pard\plain \s121\ql \li120\ri0\sl-220\slmult0\widctlpar\faauto\rin0\lin120\itap0 
