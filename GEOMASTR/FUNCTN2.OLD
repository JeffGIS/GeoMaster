			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2*2048+sizeof(OFSTRUCT)+2*sizeof(REFINDEXDATA));
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			pOFStruct = (LPOFSTRUCT)(Arg2 + 2048);
			pRefIdxData1 = (LPREFINDEXDATA)((LPSTR)pOFStruct + sizeof(OFSTRUCT));
			pRefIdxData2 = (LPREFINDEXDATA)((LPSTR)pRefIdxData1 + sizeof(REFINDEXDATA));
			
			if ((ParLoc = MatchLev (Args,','))) 
			{
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			else
				*Arg2 = 0;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			if (!_fstricmp (Arg1,"OPEN"))
			{
				if (!hBlockedRefFile)                                   
				{
					hBlockedRefFile = GSSiGlobAlloc (GMEM_MOVEABLE,256);
		    		pFile = GlobalLock (hBlockedRefFile);
		        	GetTempFileName (0,"gm",0,pFile);  
