short GetFunArgs (LPSTR	Args,LPSTR *Arg,short MaxArgs,LPHANDLE phMem)
{   
	short	nArgs=1; 
	LPSTR	*pArg=Arg, LastArg, ParLoc; 
	UINT	i;
	                 
	*phMem = GSSiGlobAlloc (GMEM_MOVEABLE,MaxArgs * 2048); 
	pArg++;
	LastArg = *pArg = GlobalLock (*phMem);   
	pArg++;  
	_fstrcpy (LastArg,Args);
	for (i=1;i<MaxArgs;i++,pArg++) 
	{
		*pArg = LastArg + 2048;
		if ((ParLoc = MatchLev (LastArg,',')))
		{ 
			_fstrcpy (*pArg,(LPSTR)(ParLoc+1));
			*ParLoc = 0; 
			nArgs++;
		} 
		else
			*(*pArg) = 0;
		ExpandText (LastArg);  
		LastArg = *pArg;
	}
	ExpandText (LastArg);  
	return nArgs;		
}

int	GetFunctionValue2 (int FunID,LPSTR Args, LPSTR OutLoc)
{   HANDLE	hMem=0,hDLT,hSurf, hStr;
	LPSTR	Arg1, Arg2, Arg3, Arg4, Arg5, Arg6,Arg7, ParLoc, lpstr, lpstrb, str;  
	LPSTR	pEnd, pCR, pFile, Arg[8];
	HFILE	Fid1, Fid2, Fid3;   
	short	nArgs, l, CvtDir, year;    
	DPOINT	Point, Point2;
	POINT	Point16;
	RECT	Rect; 
	MNMXCORD	Bounds;           
	long	hNum, Refno,ii,systime, nlong,nl;
	BOOL	TORF, rtn, Err, PickVis;  
	LPVIEWPORT	SaveVP=CurView;
	short SymNum;			
	short	n, pos, nrem;  
	double	AZ, Dist,Elevation, RVal, Offset;
	HFILE	Fid;
	LPOFSTRUCT	pOFStruct;
	LPDPOINT	pPoint;
	HANDLE	hDibInfo;
	long	ImageOffset;
	UINT	Delay;
	
	if (LinkToVar)
	{
		ExpandText (Args);
		return 0;
	}
	if (TraceType[0])
	{
		hMem=GSSiGlobAlloc (GMEM_MOVEABLE,4096);
		lpstr = GlobalLock (hMem);
		sprintf (lpstr,"GFV:%s",Args);
		GSSiTraceLev (lpstr,1);
		GSSiGlobUlFree (&hMem);
	}
	switch (FunID)
	{    
		case 801: /* $POINTSYM(StartSym,displayopt) set point symbol variables */
		{   
			short	iopt;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2*2048);
			Arg1 = GlobalLock(hMem);  
			Arg2 = Arg1 + 2048; 
			if ((ParLoc = MatchLev (Args,',')))
			{ 
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			else
				*Arg2 = 0;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			iopt = atoi (Arg2); 
			if (iopt == 3)
			{
				FARPROC lpfnNEWPOINTSETMsgProc;
				
				lpfnNEWPOINTSETMsgProc = MakeProcInstance((FARPROC)NEWPOINTSETMsgProc, hInst);
				rtn = DialogBox(hInst, (LPSTR)"NEWPOINTSET", GetFocus(), lpfnNEWPOINTSETMsgProc);
				FreeProcInstance(lpfnNEWPOINTSETMsgProc);
			
			}
			else
				rtn = SelectSymbol (CurView->hWnd,1,Arg1,iopt); 
			if (rtn)
				goto RtnTrue;
			else
				goto RtnFalse;
		}
		
		case 802: // $COPYFILE(tofile,fromfile,A (append) R (replace) or anything else (default - create)
		{	double	rval;
			int		l, len; 
			LPSTR	lpOut; 
			char	fillchar;
			BOOL	Append=FALSE;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if ((ParLoc = MatchLev (Arg2,',')))
			{
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0'; 
			}
			else
				_fstrcpy (Arg3,"C");
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			if (!_fstricmp ("A",Arg3)) 
				Append = TRUE;
			else if (ExistFile (Arg1) && _fstricmp ("R",Arg3))
				goto RtnFalse;
			if (copyfile(Arg1,Arg2,Append,0,0,0,0,0,0))
				goto RtnTrue;
			else
            	goto RtnFalse;
			
		} 
		
		case 803: // $EDITFILE(file)
		{	
			LPSTR	cmd;
			HANDLE	hCmd;
						
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096);
			Arg1 = GlobalLock(hMem);
			
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1); 
			
			hCmd = GSSiGlobAlloc (GMEM_MOVEABLE,1024);  
			cmd = GlobalLock (hCmd);
			_fstrcpy (cmd,"[%TEXT_EDITOR]");  
			ExpandText (cmd);
			_fstrcat (cmd," ");
			_fstrcat (cmd,Arg1);
			WinExec (cmd,SW_SHOWMAXIMIZED);
			GSSiGlobUlFree (&hCmd);
           	goto RtnTrue;
		}

		case 804: // $CHANGEPT(file,x,y,tol,F or T) changes nearest point in control file if in tolerance F=change
				  //								from point, T to point.
		{	double	rval;   
			BOOL	rtn=FALSE, AddSpace;
			int		l, len, minpt=-1, ipt; 
			LPSTR	lpOut, lpSpace; 
			char	fillchar; 
			HFILE	Fid, Fid2;  
			LPSTR	TmpName, str;  
			HANDLE	hTemp;
			double	fromX, fromY, toX, toY, newX, newY, dist, mindist; 
			LPOFSTRUCT	pOFStruct;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*5+256);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			Arg4 = Arg3 + 2048; 
			Arg5 = Arg4 + 2048; 
			pOFStruct = (LPOFSTRUCT)(Arg5 + 2048);
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			if (!(ParLoc = MatchLev (Arg3,','))) goto Rtn0;
			_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			if (!(ParLoc = MatchLev (Arg4,','))) goto Rtn0;
			_fstrcpy (Arg5,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			ExpandText (Arg4);  
			ExpandText (Arg5);  
			newX = atof (Arg2);
			newY = atof (Arg3);
			mindist = atof (Arg4);
			if ((Fid = GSSiOpenFile (Arg1,pOFStruct,OF_READ))==HFILE_ERROR)
				goto RtnFalse;  
			hTemp = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
			TmpName = GlobalLock (hTemp);
			str = TmpName + 256;
			GetTempFileName (NULL,"tmp",NULL,(LPSTR)TmpName);
			Fid2 = GSSiOpenFile (TmpName,pOFStruct,OF_CREATE); 
			ipt = 0; 
			lpSpace = Arg5;
			lpSpace++;
			if (*lpSpace == 'R') // R for remove (FR or TR)
				AddSpace=TRUE;  // adding a space at begin of line comments it out
			else
				AddSpace=FALSE;
			while (fgetstring (str,128,Fid))
			{
				if (sscanf (str,"%Flf %Flf %Flf %Flf",&fromX,&fromY,&toX,&toY)==4)
				{   
					switch (*Arg5)
					{
						case 'F':
						case 'f':
							if ((dist=LDIST (fromX,fromY,newX,newY)) < mindist)
							{ 
								minpt = ipt;
								mindist = dist;
							}  
							break;
						case 'T':
						case 't':
							if ((dist=LDIST (toX,toY,newX,newY)) < mindist)
							{ 
								minpt = ipt;
								mindist = dist;
							}  
							break; 
					}
				}
				fputstring (str,Fid2);
				ipt++;
			} 
			GSSiClose (Fid);  
			GSSiClose (Fid2);
			if (ipt >= 0)
			{
				Fid = GSSiOpenFile (Arg1,pOFStruct,OF_CREATE);
				Fid2 = GSSiOpenFile (TmpName,pOFStruct,OF_READ); 
				ipt = 0;
				while (fgetstring (str,128,Fid2))   
				{   
					if (ipt == minpt)
					{  
						sscanf (str,"%Flf %Flf %Flf %Flf",&fromX,&fromY,&toX,&toY);
						if (AddSpace)					
							sprintf (str,"#%.14lg %.14lg %.14lg %.14lg",fromX,fromY,toX,toY); 
						else
						{
							switch (*Arg5)
							{
								case 'F':
								case 'f':
									fromX = newX;
									fromY = newY; 
									break;
								case 'T':
								case 't': 
									toX = newX;
									toY = newY;
							} 
							sprintf (str,"%.14lg %.14lg %.14lg %.14lg",fromX,fromY,toX,toY);
						}
					}
					ipt++;
					fputstring (str,Fid);
				}
				GSSiClose (Fid);  
				GSSiClose (Fid2); 
				rtn=TRUE;
			}
			GSSiOpenFile (TmpName,pOFStruct,OF_DELETE); 
			GlobalUnlock (hTemp);
			GlobalFree (hTemp);
			if (rtn)
				goto RtnTrue;
			else
            	goto RtnFalse;
			
		} 
		
		case 805: // $GOFILEPT(file,N or P or F or num) zooms to next, previous or specified point in file
		{	 
			BOOL	rtn=FALSE;
			HFILE	Fid;  
			LPSTR	str;  
			double	dist; 
			short	ipt;
			LPOFSTRUCT	pOFStruct;  
			HANDLE	hTemp;
			static	short	WantPt=0;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2+256);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			pOFStruct = (LPOFSTRUCT)(Arg2 + 2048);
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			switch (*Arg2)
			{
				case 'N':
				case 'n': 
					WantPt++;
				break;
				
				case 'P':
				case 'p':    
					WantPt--;
				break;  
				
				case 'F':
				case 'f':
					WantPt = 0;
					break;
				
				default:
					WantPt = atoi (Arg2);
			}
			if ((Fid = GSSiOpenFile (Arg1,pOFStruct,OF_READ))==HFILE_ERROR)
				goto RtnFalse;  
			ipt = 0; 
			hTemp = GSSiGlobAlloc (GMEM_MOVEABLE,512);
			str = GlobalLock (hTemp);
			while (fgetstring (str,128,Fid))
			{   
				if (*str && *str != '#')
				{
					if (ipt == WantPt)
					{
						if (sscanf (str,"%Flf %Flf",&Point.x,&Point.y)==2) 
							rtn = TRUE;
						break;
					}
					ipt++; 
				}
			}
			GSSiClose (Fid);	
			GlobalUnlock (hTemp);
			GlobalFree (hTemp);		
			if (rtn)
			{   
				dist = min (CurView->WBounds.xmx - CurView->WBounds.xmn, CurView->WBounds.ymx - CurView->WBounds.ymn);
				ZoomToPointAndDist (Point,dist/2,FALSE); 
				itoa (WantPt,OutLoc,10);
				goto Rtnl;
			}
			else
			{    
				WantPt = min (max (WantPt,-1),ipt);
				Sound (BAD_SOUND);
            	goto RtnFalse;
            }
			
		}  
		
		case 806: /* $COORDLOC(File,CurrentLocGlobal,D or S(sorted) or N or P) coordinate location file*/
		{	 
            FARPROC lpfnCOORDLOCMsgProc;
		    HFILE       Fid; 
		    LPSTR       lpBAR, LastChar; 
			LPSTR	str;   
			HANDLE	hTemp;
			int		nRc;
			long	RecNum, WantRec; 
			LPOFSTRUCT	pOFStruct;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4*2048);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			pOFStruct = (LPOFSTRUCT)(Arg3 + 2048);
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,','))) goto Rtn0;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
        	lpCLFile = Arg1;
        	lpCLGlob = Arg2;
            _fstrupr (Arg3);
            switch (*Arg3)
            {
            	case 'N':
            	case 'P':

				    Fid=GSSiOpenFile (lpCLFile,pOFStruct,OF_READ);  
	    			if (Fid==HFILE_ERROR)
	    				goto RtnFalse; 
	    			hTemp = GSSiGlobAlloc (GMEM_MOVEABLE,1024);
	    			str = GlobalLock (hTemp);
					if (!GetVal (lpCLGlob, str))
						_fstrcpy (str,"-1");
					WantRec = atol (str); 
					if (*Arg3 == 'N')
						WantRec++;
	    			else
	    				WantRec--;	
				    RecNum=0;
				    while (fgetstring (str,128,Fid))
				    {   
				    	if (RecNum == WantRec)
				    	{   
				    		GSSiClose (Fid);
			         		SetGlobalValueLong (lpCLGlob,WantRec);
				    		if ((lpBAR = _fstrrchr (str,'|')))
				    		{   
				    			lpBAR++;
								if (sscanf (lpBAR,"%Flf %Flf",&CLocPoint.x,&CLocPoint.y) == 2)
								{	
									GSSiGlobUlFree (&hTemp);
					              	ZoomToPointAndDist (CLocPoint,LocationOffset,FALSE);
									ExecutePointLocationMacro (CLocPoint);
					              	goto RtnTrue;
					            }
					        }   
							GSSiGlobUlFree (&hTemp);
							goto RtnFalse;
						}
				    	RecNum++;
				    }  
				    GSSiClose (Fid);
					GSSiGlobUlFree (&hTemp);
					goto RtnFalse;
            	
            	case 'D':
            	case 'S':
		            lpfnCOORDLOCMsgProc = MakeProcInstance((FARPROC)COORDLOCMsgProc, hInst); 
		            if (*Arg3 == 'D')
		            	nRc = DialogBox(hInst, (LPSTR)"COORDLOC", hWndMain, lpfnCOORDLOCMsgProc); 
		            else
		            	nRc = DialogBox(hInst, (LPSTR)"COORDLOC_SORT", hWndMain, lpfnCOORDLOCMsgProc);
		            FreeProcInstance(lpfnCOORDLOCMsgProc); 
		             
		            if (nRc)
		            {
		              	ZoomToPointAndDist (CLocPoint,LocationOffset,FALSE);
						ExecutePointLocationMacro (CLocPoint);
		              	goto RtnTrue;
		            }   
		            else
						goto RtnFalse;
			}
		}
		
		case 807: // $IMAGELIM(Indexfile,IMAGE) returns limits of original image file in indexed ortho
		{	 
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			if (GetOriginalImageBounds (Arg1,Arg2,&Bounds))
			{
				UserBounds[0].x = Bounds.xmn;
				UserBounds[0].y = Bounds.ymn;
				UserBounds[1].x = Bounds.xmx;
				UserBounds[1].y = Bounds.ymx;
				goto RtnTrue; 
			}
			else
            	goto RtnFalse;
			
		}  
		break;
		
		case 808: 
			if (WMASetUp())
				goto RtnTrue;
			else
				goto RtnFalse;
		break;
				
		case 809: // $LOADTRAN(Transformation file,Type (1=default,2=onescale,3=fixedpoint),which(P for projection trans)V( default loads Viewport transformation file)R (loads reverse viewport trans)
		{
			short	Type;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*3);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048; 
			if ((ParLoc = MatchLev (Args,',')))
			{ 
				_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			else
				*Arg2 = 0;
			if ((ParLoc = MatchLev (Arg2,',')))
			{ 
				_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
				*ParLoc = '\0';
			}
			else
				*Arg3 = 0;
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			Type = atoi (Arg2);
			if (Type < 1 || Type > 3)
				Type = 1;
			if (*Arg3 == 'P')
			{
				CloseTRANS2 (&hTranProjection);
				CloseTRANS2 (&hTranProjectionReverse);
				if ((hTranProjection=LoadTranFile(Arg1,1,Type)))
				{
					hTranProjectionReverse=LoadTranFile(Arg1,2,Type);
					goto RtnTrue;
				}
				else
					goto RtnFalse;
			}
			else
			{   
				short	from=1,to=2;
				
				if (*Arg3 == 'R')
				{
					from = 2;
					to = 1;
				}
				if (CurView->hFileTransIn > 1)
					CloseTRANS2 (&CurView->hFileTransIn);
				CloseTRANS2 (&CurView->hFileTransOut);
				if ((CurView->hFileTransIn=LoadTranFile(Arg1,from,Type)))
				{
					CurView->hFileTransOut=LoadTranFile(Arg1,to,Type);
					goto RtnTrue;
				}
				CurView->hFileTransIn=1;
				goto RtnFalse;
			}
		} 

		case 810: //$GETCOLOR(variablename)
		{
			COLORREF	Color;
			 
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096+256);
			Arg1 = GlobalLock(hMem); 
			lpstr = Arg1 + 4096;
			
			_fstrcpy (Arg1,Args);  
			ExpandText (Arg1);
			if (!*Arg1)
				goto RtnFalse;
			sprintf (lpstr,"[%s]",Arg1);
			Color = GetGlobalLVal (lpstr);
			if (GetColor(CurView->hWnd,&Color)) 
			{
				SetGlobalValueLong(Arg1,Color);
				goto RtnTrue; 
			}  
			else
				goto RtnFalse;   
		}
		break;
				
		case 811: //$ADDPOINT(x y)
		{
			COLORREF	Color;
			 
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,4096+256);
			Arg1 = GlobalLock(hMem); 
			lpstr = Arg1 + 4096;
			
			_fstrcpy (Arg1,Args);  
			ExpandText (Arg1);
			if (!*Arg1)
				goto RtnFalse;
