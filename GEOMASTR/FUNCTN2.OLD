		case 1108: //$RUNTEXTFILE (pathname!statuswindtitle!statuslooptext,command)   or
				   //$RUNTEXTFILE (pathname(lineno),command) runs only single line
        {   
        	LPSTR pStatusText, pLoopText=0, pLineNo;
        	long	ProcessLine = -1, AtLine=0;
        	
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*5);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 2048; 
			Arg3 = Arg2 + 2048;
			Arg4 = Arg3 + 2048;
			pOFStruct = (LPOFSTRUCT)(Arg4 + 2048);
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
            if ((pStatusText = _fstrchr (Arg1,'!')))
            	*pStatusText++ = 0;   
            if ((pLineNo = _fstrchr (Arg1,'(')))
            {
            	*pLineNo++ = 0;    
            	ProcessLine =  atol (pLineNo);
            }
			Fid = GSSiOpenFile (Arg1,pOFStruct,OF_READ);
			if (Fid == HFILE_ERROR)
	           	goto RtnFalse;
			if (pStatusText)
			{   
				if ((pLoopText = _fstrrchr (pStatusText,'!')))
					*pLoopText++ = 0;
		        nlong = _llseek (Fid,0,2);
		        _llseek (Fid,0,0); 
				CreateStatusWindow (CurView->hWnd,1,NULL);
		    }
	        fgetstring (Arg3,2040,Fid);
			ProcessDelimTextHeader(Arg3,&hDLT);
			IgnoreSelectVP = TRUE;
			while (ContinueProcessing && fgetstring (Arg3,2040,Fid))
			{   
				if (ProcessLine < 0 || AtLine == ProcessLine)
				{
			    	GetDelimTextData(Arg3,hDLT); 
			    	_fstrcpy (Arg4,Arg2);
			    	ExpandText (Arg4);
		            if (pStatusText)
						StatusWindowUpdate (pStatusText,pLoopText,nlong,_llseek (Fid,0,1)); 
					if (ProcessLine >= 0)
						break;
				}
				AtLine++;
            }  
            IgnoreSelectVP = FALSE;
            ContinueProcessing = TRUE;
			GSSiGlobFree (&hDLT);
            GSSiClose (Fid);
            if (pStatusText)
				DestroyStatusWindow();  
            goto RtnTrue;
		}
		
		case 1109: //$GETTRANDATA(tranfile) gets tranfile data from highlight list and editlimits
		{	
			LPHIGHLIGHTDATA	pHighlightData;
			
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,2048*2+256+sizeof(HIGHLIGHTDATA));
			Arg1 = GlobalLock(hMem);
			str = Arg1 + 2048;
			pOFStruct = (LPOFSTRUCT)(str + 256);
			pHighlightData = (LPHIGHLIGHTDATA)((LPSTR)pOFStruct + sizeof(OFSTRUCT));
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);   
			if (!GetLayerBounds (&Bounds,CurView->hDC, CurView->UpdateFile-1))
				goto RtnFalse;
			Fid = GSSiOpenFile (Arg1,pOFStruct,OF_CREATE); 
			if (Fid == HFILE_ERROR)
				goto RtnFalse;
			sprintf (str,"L %.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmx,Bounds.ymx);
			fputstring (str,Fid);				
			sprintf (str,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymn,Bounds.xmn,Bounds.ymn);
			fputstring (str,Fid);				
			sprintf (str,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmn,Bounds.ymx,Bounds.xmn,Bounds.ymx);
			fputstring (str,Fid);				
			sprintf (str,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmx,Bounds.ymx,Bounds.xmx,Bounds.ymx);
			fputstring (str,Fid);				
			sprintf (str,"%.14lg %.14lg %.14lg %.14lg",Bounds.xmx,Bounds.ymn,Bounds.xmx,Bounds.ymn);
			fputstring (str,Fid);				
			pos = BT_FIRST;
			while (!BT_FIND (hHighlight,(LPSTR)&Refno,pos,BT_ANY,(LPSTR)pHighlightData))
			{
				pos = BT_NEXT;
				switch (pHighlightData->PD.Type)
				{
					case 1:
						Point = Point2 = pHighlightData->PD.BeginPoint;
						break;
					case 2:
						Point = pHighlightData->PD.BeginPoint;
						Point2 = pHighlightData->PD.EndPoint;
						break;
					default:
						goto NextTranPoint;
						
				}  
				sprintf (str,"%.14lg %.14lg %.14lg %.14lg",Point.x,Point.y,Point2.x,Point2.y);
				fputstring (str,Fid);				
NextTranPoint:;
			}
			GSSiClose (Fid);
			goto RtnTrue;
		} 
		
		case 1110: // $GETNEXTLINE(longvar,outvarname,positionvarname,maxline)
		{	 
			HANDLE	hGlobal;
			
			if (!(ParLoc = MatchLev (Args,','))) goto Rtn0;
			hMem = GSSiGlobAlloc(GMEM_MOVEABLE,3*2048+4096+256);
			Arg1 = GlobalLock(hMem);
			Arg2 = Arg1 + 4096; 
			Arg3 = Arg2 + 2048; 
			Arg4 = Arg3 + 2048; 
			str	= Arg4 + 4096;
			
			_fstrcpy (Arg2,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			if (!(ParLoc = MatchLev (Arg2,',')))
				goto RtnFalse;
			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			if (!(ParLoc = MatchLev (Arg3,',')))
				goto RtnFalse;
			_fstrcpy (Arg4,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			ExpandText (Arg4);
            n = _fstrlen (Arg1); 
    		hGlobal = FindVar(Arg3);	
			GetGlobalVal (hGlobal,str,0); 
			pos = atoi (str);
			if (pos < n)
			{   
				if (Arg1[pos] == '\n')
					pos++;
				nrem = _fstrlen (&Arg1[pos]);
				if (!nrem)
					goto RtnFalse;
				l = atoi (Arg4);
				if (l <= 0)
					goto RtnFalse;
				nrem = min (l,nrem);
				pEnd = &Arg1[pos] + nrem;
				*pEnd = 0;
				if ((pCR = _fstrchr (&Arg1[pos],'\r')))
				{
					*pCR++ = ' ';
					*pCR = 0;  
					pEnd = pCR;
				}
				if (nrem >= l && _fstrrchr (&Arg1[pos],' ')>&Arg1[pos])
				{
					while (*pEnd != ' ')
					{
						pEnd--;
					} 
					*pEnd = 0;
				} 
				SetGlobalValue(Arg2,&Arg1[pos]); 
				if (*(LPSTR)(pEnd+1) == '\n')
					pEnd++;
				nlong = (long)pEnd - (long)Arg1 + 1;
				SetGlobalValueLong (Arg3,nlong);
              	goto RtnTrue;
            }
            else
				goto RtnFalse;
		} 
		
