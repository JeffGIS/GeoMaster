			_fstrcpy (Arg3,(LPSTR)(ParLoc+1));
			*ParLoc = '\0';
			_fstrcpy (Arg1,Args);
			ExpandText (Arg1);
			ExpandText (Arg2);
			ExpandText (Arg3);
			GetDistAndUnits (Arg3,&Dist,&DistUnits);  
			Dist = ConvertInDist (Dist,DistUnits+1); 
			if (CreateAreaGrid (Arg1,Arg2,Dist))
				goto RtnTrue;
			goto RtnFalse;
		}
		 
