BOOL TraceSpill (HWND hWnd, WORD Message, WORD wParam, LONG lParam,short Function)
{
 char key;
 short	rtn=1; 
 static	BOOL	HaveFirstPoint, DoTrack=TRUE; 
 static	PICKDATA	PickData;
 static	POINT	TrackPoints[5], LastPoint;  
 POINT	MousePoint;
 
 switch (Message)
   {
   	case GF_INIT:
       	AddLBUTTON = TRUE; 
       	HaveFirstPoint = FALSE; 
   		break;

    case GF_CLOSE: 
    	return FALSE;
    	
    case WM_LBUTTONUP:
    {
		short	i; 
		POINT	NewPoint;
		DPOINT	BasePoint, NextPoint, Points[2];
   		BOOL	SaveDisableHalt, NewPointInOldQuad=FALSE;  
    	short	ID,SurfSym; 
    	double	LenRadial = 100, MaxRadialMove = 50;
    	short	nRadials = 4;
    	HANDLE	hRadials[16];
		LPRADIAL	pRadial; 
		double	StartElev;

    	MousePoint = MAKEPOINT(lParam); 
    	SurfSym = GetSymbolNum ("OT1");
    	if (!SurfSym)
    		break;
	    if (!CurView->hTranWinToBase) break;
	    BasePoint=WinPtToBasePt(MousePoint);
	    if (!GetRadialProfiles (BasePoint,NULL,SurfSym,nRadials,LenRadial,hRadials))
	    	goto Exit;
	    StartElev = ElevFromRadials (nRadials,hRadials);
	    for (i=0;i<nRadials;i++)
	    {
	    	pRadial = (LPRADIAL)GlobalLock (hRadials[i]);
	    	pRadial->Elev = StartElev;
	    	GlobalUnlock (hRadials[i]);
	    }
NextMove:
	    if (!GetNextRadialPoint (&NextPoint,&StartElev,nRadials,hRadials,MaxRadialMove))
	    	goto Exit;
	    GWPolylineD (CurView->hDC,Points,2,0);
	    if (GetRadialProfiles (BasePoint,&StartElev,SurfSym,nRadials,LenRadial,hRadials))
	    	goto NextMove;
Exit:;
    }
    	break;  
    default:
    	return FALSE;
    	
    }
    return (TRUE);
} 

BOOL CreatePolyProfile (long nPoints,HANDLE hPolyPoints,
						LPLONG pnProfilePoints,LPHANDLE phProfilePoints,short SurfSym)
{
    HPDPOINT	pPoints;
	MNMXCORD	Bounds;
	long		n=nPoints;
	
	DBoundsInit (&Bounds);
	pPoints = (HPDPOINT)GlobalLock (hPolyPoints);
	while (n--)
		AddDPointToMinMax (pPoints++,&Bounds);
	
	ClearHighlightList (FALSE);
	HighlightInArea (CurView->hWnd,&Bounds,TRUE,FALSE);
    
    return TRUE;
}

BOOL EndPointMacros (LPSTR PrePickMacro,LPSTR BPMacro,LPSTR EPMacro,LPSTR PostPickMacro)
{   
	short	pos=BT_FIRST;
	long	Sequence, Refno; 
	HIGHLIGHTDATA	HighlightData;  
	HANDLE	hStr=GSSiGlobAlloc (GMEM_MOVEABLE,2048);
	LPSTR	str = GlobalLock(hStr);
	HCURSOR	hcurSave;
	
	hcurSave = GSSiSetCursor(LoadCursor(NULL, IDC_WAIT)); 
	while (ContinueProcessing && !BT_FIND (hHighlight2,(LPSTR)&Sequence,pos,BT_ANY,(LPSTR)&Refno))
	{   
		pos = BT_NEXT;
		BT_FIND (hHighlight,(LPSTR)&Refno,BT_FIRST,BT_EQ,(LPSTR)&HighlightData);
		PickList[0] = HighlightData.PD;
		ProcessPickedItem (0,FALSE);        		
		SavedCmdStringLoc[0] = CurGCmdStringLoc;
		_fstrcpy (SavePickName[0],PickName);	
		SetPickGlobals(0);
		sprintf (str,"$MACRO(%s)",PrePickMacro);
		ExpandText (str);
    	PickItems2 (hWndMain,HighlightData.PD.BeginPoint,FALSE,TRUE);  
    	while (NumPicked--)
    	{
			PickList[0] = HighlightData.PD;
			ProcessPickedItem (0,FALSE);        		
			SavedCmdStringLoc[1] = CurGCmdStringLoc;
			_fstrcpy (SavePickName[1],PickName);	
			SetPickGlobals(0);
			sprintf (str,"$MACRO(%s)",BPMacro);
			ExpandText (str);
    	}
    	PickItems2 (hWndMain,HighlightData.PD.EndPoint,FALSE,TRUE);  
    	while (NumPicked--)
    	{
			PickList[0] = HighlightData.PD;
			ProcessPickedItem (0,FALSE);        		
			SavedCmdStringLoc[1] = CurGCmdStringLoc;
			_fstrcpy (SavePickName[1],PickName);	
			SetPickGlobals(0);
			sprintf (str,"$MACRO(%s)",EPMacro);
			ExpandText (str);
    	}
		sprintf (str,"$MACRO(%s)",PostPickMacro);
		ExpandText (str);
	}    
	GSSiGlobUlFree (&hStr);
	GSSiSetCursor (hcurSave); 
	return TRUE; 
}

BOOL UpdateCmdStringInFile (LPSTR VarName,LPSTR VarVal,short FilePos)
{   
	HFILE	Fid;
	OFSTRUCT	OFStruct;      
	BOOL	rtn=TRUE; 
	short	ID, ls;  
	long	loc;
	LPSTR	pString;
	HANDLE	hStr;
	
	if (FilePos)
	{ 
		CurGCmdStringLoc=SavedCmdStringLoc[FilePos-1];
		_fstrcpy (PickName,SavePickName[FilePos-1]);	
	}
	if (!CurGCmdStringLoc)
		return FALSE;
	Fid = GSSiOpenFile (PickName,(LPOFSTRUCT)&OFStruct,OF_READWRITE);
	if (Fid == HFILE_ERROR)
		return FALSE;  
	hStr = GSSiGlobAlloc (GMEM_MOVEABLE,512);
	pString = GlobalLock (hStr);
	_llseek (Fid,CurGCmdStringLoc,0);
	_lread (Fid,&ID,2);
	_lread (Fid,&ls,2); 
	if (ID == 40)
	{   
		loc = _llseek (Fid,0,1);
		_lread (Fid,pString,ls);
		pString[ls] = 0;
		UpdateCmdStringVal (VarName,VarVal,pString,ls);
		_llseek (Fid,loc,0);
		_lwrite (Fid,pString,ls); 
	}
	else
		rtn=FALSE;   
	GSSiGlobUlFree (&hStr);
	GSSiClose (Fid);  
	return rtn;
}

BOOL UpdateCmdStringVal (LPSTR VarName,LPSTR VarVal,LPSTR CmdString,short MaxLen)  
{
	BOOL	rtn=TRUE;
	char	str[66];    
	LPSTR	pVar, pEnd; 
	short	StartLen,OldLen,NewLen,DifLen,RestLen;
	
	sprintf (str,"[%s]=",VarName);
	if (!(pVar=_fstrstr(CmdString,str)))
		return FALSE;   
	StartLen = _fstrlen (CmdString);
	pVar += _fstrlen (str);
	pEnd = MatchLev (pVar,';');   
	if (!pEnd)
		pEnd = _fstrchr (pVar,0); 
	RestLen = _fstrlen (pEnd); 
	OldLen = pEnd - pVar;
	NewLen = _fstrlen (VarVal); 
	DifLen = NewLen - OldLen; 
	if (StartLen + DifLen > MaxLen)
		return FALSE;             
	if (RestLen && DifLen != 0)
		_fmemmove ((pEnd+DifLen),pEnd,RestLen);
	_fmemmove (pVar,VarVal,NewLen);
	return TRUE;
}  

BOOL FAR PASCAL FULLBMMsgProc(HWND hWndDlg, WORD Message, WORD wParam, LONG lParam)
{
#define	NUMSCALES	8
	RECT	rect;
	HDC		hDC;
	char	drive[4],dir[128],leaf[16],ext[6], file[128]; 
	UINT	ScaleControls[NUMSCALES]={IDM_SCALE0,
									  IDM_SCALE100,
									  IDM_SCALE75,
									  IDM_SCALE50,
									  IDM_SCALE35,
									  IDM_SCALE25,
									  IDM_SCALE15,
									  IDM_SCALE10
									  };
	int		i;
	long	n;
	static	HANDLE	hNext=0,hPrior=0;      
	static	short	xrange, yrange;
	short	vPos, hPos;
	LPSTR	lpchr, lpFile; 
	RECT	Rect;
	LPBITMAPINFO pbmi;
	static	BOOL	Debug=FALSE; 
	static	HANDLE	hBMP=0;  
	static	double	Scale=0;
	static	short	xoff=0,yoff=0;
	
 int	BRtn;
 if ((BRtn = DIALOGSTYLEMsgProc (hWndDlg,Message, wParam, lParam)))
 	return (BRtn);
 switch(Message)
   {
    case WM_INITDIALOG: 
    { 
    	DWORD	WVer;
    	int		WinVer;
        
        if (_fstrcmp (FullBM,"INFOBOX"))
        {
	        if (!ExistFile (FullBM))
	        {
	        	EndDialog(hWndDlg, FALSE);
	        	break;
	        } 
	    } 
	    DoPaint = FALSE;
		GetClientRect(GetDesktopWindow(), &rect);
		 WVer = GetVersion ();
		 WinVer = HIBYTE(LOWORD(WVer)); 
		 if (!Debug)
		 {
			 if (WinVer <95) 
			 	SetWindowPos(hWndDlg, (HWND) NULL, 0, 0,rect.right, rect.bottom,SWP_NOZORDER);
			 else
				SetWindowPos(hWndDlg, (HWND) HWND_TOPMOST, 0,0,rect.right, rect.bottom,SWP_NOREDRAW);
		 }
    	 hPrior = GSSiGlobAlloc (GHND,256);  
    	 hNext = GSSiGlobAlloc (GHND,256);  
         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
    }    
		 break; /* End of WM_INITDIALOG                                 */
    
    case WM_DESTROY:
    	 GSSiGlobFree (&hNext);
    	 GSSiGlobFree (&hPrior);   
    	 GSSiGlobFree (&hBMP);
    	 return 0;
    	 
    case WM_CLOSE:
         /* Closing the Dialog behaves the same as Cancel               */
         PostMessage(hWndDlg, WM_COMMAND, IDCANCEL, 0L);
         break; /* End of WM_CLOSE                                      */

    case WM_VSCROLL:
         switch(wParam)
           {
           	case SB_LINEUP:
           		vPos = GetScrollPos (hWndDlg,SB_VERT);
           		vPos = min (yrange,max (0,vPos-yrange/20));  
            	SetScrollPos (hWndDlg,SB_VERT,vPos,TRUE);  
           		return 1;
           	case SB_LINEDOWN:
           		vPos = GetScrollPos (hWndDlg,SB_VERT);
           		vPos = min (yrange,max (0,vPos+yrange/20));  
            	SetScrollPos (hWndDlg,SB_VERT,vPos,TRUE);  
           		return 1;
           	case SB_PAGEUP:
           		vPos = GetScrollPos (hWndDlg,SB_VERT);
           		vPos = min (yrange,max (0,vPos-yrange/5));  
            	SetScrollPos (hWndDlg,SB_VERT,vPos,TRUE);  
           		return 1;
           	case SB_PAGEDOWN:
           		vPos = GetScrollPos (hWndDlg,SB_VERT);
           		vPos = min (yrange,max (0,vPos+yrange/5));  
            	SetScrollPos (hWndDlg,SB_VERT,vPos,TRUE);  
           		return 1;
           	case SB_TOP:  
            	SetScrollPos (hWndDlg,SB_VERT,0,TRUE);  
           		return 1;
           	case SB_BOTTOM:  
            	SetScrollPos (hWndDlg,SB_VERT,yrange,TRUE);  
           		return 1;
           	case SB_THUMBPOSITION:
           	case SB_THUMBTRACK:
           		vPos = LOWORD(lParam);
            	SetScrollPos (hWndDlg,SB_VERT,vPos,TRUE);  
           		return 1;
            case SB_ENDSCROLL:
		        PostMessage(hWndDlg, WM_COMMAND, IDC_DISPLAY, 0L);
            	break;
            default:
                 return 1;
           }
         return 0;

    case WM_HSCROLL:
         switch (wParam)
           {
           	case SB_LINEUP:
           		hPos = GetScrollPos (hWndDlg,SB_HORZ);
           		hPos = min (xrange,max (0,hPos-xrange/20));  
            	SetScrollPos (hWndDlg,SB_HORZ,hPos,TRUE);  
           		return 1;
           	case SB_LINEDOWN:
           		hPos = GetScrollPos (hWndDlg,SB_HORZ);
           		hPos = min (xrange,max (0,hPos+xrange/20));  
            	SetScrollPos (hWndDlg,SB_HORZ,hPos,TRUE);  
           		return 1;
           	case SB_PAGEUP:
           		hPos = GetScrollPos (hWndDlg,SB_HORZ);
           		hPos = min (xrange,max (0,hPos-xrange/5));  
            	SetScrollPos (hWndDlg,SB_HORZ,hPos,TRUE);  
           		return 1;
           	case SB_PAGEDOWN:
           		hPos = GetScrollPos (hWndDlg,SB_HORZ);
           		hPos = min (xrange,max (0,hPos+xrange/5));  
            	SetScrollPos (hWndDlg,SB_HORZ,hPos,TRUE);  
           		return 1;
           	case SB_TOP:  
            	SetScrollPos (hWndDlg,SB_HORZ,0,TRUE);  
           		return 1;
           	case SB_BOTTOM:  
            	SetScrollPos (hWndDlg,SB_HORZ,xrange,TRUE);  
           		return 1;
           	case SB_THUMBPOSITION:
           	case SB_THUMBTRACK:
           		hPos = LOWORD(lParam);
            	SetScrollPos (hWndDlg,SB_HORZ,hPos,TRUE);  
           		return 1;
            case SB_ENDSCROLL:
		        PostMessage(hWndDlg, WM_COMMAND, IDC_DISPLAY, 0L);
            	break;
            default:
                 return 1;
           }
         return 0;

    case WM_COMMAND:
         switch(wParam)
           {
           	case IDM_CONTINUE:
            case IDCANCEL:
                 /* Ignore data values entered into the controls        */
                 /* and dismiss the dialog window returning FALSE       */
				 sndPlaySound(NULL,SND_ASYNC); 
				 DoPaint = TRUE;
                 EndDialog(hWndDlg, FALSE);
                 break;

            case IDOK: 
	         	 GSSiGlobFree (&hBMP);
				 sndPlaySound(NULL,SND_ASYNC);
             
            	 GetClientRect (hWndDlg,&Rect);
            	 hDC = GetDC (hWndDlg);
		         _fstrupr (FullBM);
		         if (_fstrstr(FullBM,".BMP"))
				 	DisplayBMFileInRect (hDC,FullBM,Rect,TRUE);
		         else if (_fstrstr(FullBM,".PCX")) 
		         {
		         	hBMP = BMPFromPCX (FullBM);
		         	if (!hBMP)
		         		break;
		         	PostMessage(hWndDlg, WM_COMMAND, IDM_SCALE0, 0L);
//				 	DisplayPCXFileInRect (hDC,FullBM,Rect,TRUE); 
				 }
		         else if (_fstrstr(FullBM,"INFOBOX")) 
		         {  
		         	POINT	TagPoint16 = RectMid (&Rect);
		         	DPOINT TagPoint; 
		         	TAGBOX	SaveTAG=TAGBox;
		         	RECT	SaveRect=MainRect;
		         	
		         	TagPoint.x = TagPoint16.x;
		         	TagPoint.y = TagPoint16.y;     
		         	TAGBox.PLstyle = 0;  
				    TAGBox.LogFont.lfHeight = TAGFontHtToPixels (TAGBox.TXheight,TAGBox.CoordStyle);
		         	MainRect = Rect;
		         	TAGBox.CoordStyle = 2;  
		         	TAGBox.TXheight = PixelsToTAGFontHt(&TAGBox.LogFont);
		         	TAGBox.center.x = 0.5;
		         	TAGBox.center.y = 0.5;    
		         	TAGBox.bmWidthD = 1;
		         	TAGBox.bmHeightD = 1;    
		         	InExpandIB = TRUE;
					if (ResetTAGBox (hDC,3))
						DrawTAG(hWndDlg,hDC,2,TRUE);   
					InExpandIB = FALSE;
					TAGBox = SaveTAG; 
					MainRect = SaveRect;
		         }
   				 ReleaseDC (hWndDlg,hDC);

		         _splitpath (FullBM,drive,dir,leaf,ext);
		         sprintf (file,"%s%s%s.WAV",drive,dir,leaf);
				 sndPlaySound(file,SND_ASYNC|SND_NODEFAULT); 
		         i=_fstrlen(leaf);
		         lpchr = &leaf[i-1];
		         while (i && *lpchr != '0' && isdigit(*lpchr--))
		         	i--; 
		         n = atol(&leaf[i]);
		         if (n)
		         {
					EnableMenuItem(GetMenu(hWndDlg), IDM_PRINT_ALL, MF_BYCOMMAND | MF_ENABLED);
		         	leaf[i]=0; 
		         	lpFile = GlobalLock(hPrior);
		         	sprintf (lpFile,"%s%s%s%ld%s",drive,dir,leaf,n-1,ext);
		         	if (ExistFile(lpFile))
						EnableMenuItem(GetMenu(hWndDlg), IDM_PRIOR, MF_BYCOMMAND | MF_ENABLED);
		         	else
						EnableMenuItem(GetMenu(hWndDlg), IDM_PRIOR, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
					GlobalUnlock(hPrior);
					lpFile = GlobalLock(hNext);
		         	sprintf (lpFile,"%s%s%s%ld%s",drive,dir,leaf,n+1,ext);
		         	if (ExistFile(lpFile))
						EnableMenuItem(GetMenu(hWndDlg), IDM_NEXT, MF_BYCOMMAND | MF_ENABLED);
		         	else
						EnableMenuItem(GetMenu(hWndDlg), IDM_NEXT, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
					GlobalUnlock(hNext);
				 }
				 else
					EnableMenuItem(GetMenu(hWndDlg), IDM_PRINT_ALL, MF_BYCOMMAND | MF_DISABLED| MF_GRAYED);
				 DrawMenuBar(hWndDlg);
				   
                 break;
            
            case IDM_SCALE100:
            	 Scale = 1;
				 goto ChangeScale;
            case IDM_SCALE75:
            	 Scale = (double)100.0/75;
				 goto ChangeScale;
            case IDM_SCALE50:
            	 Scale = 2;
				 goto ChangeScale;
            case IDM_SCALE35:
            	 Scale = (double)100.0/35;
				 goto ChangeScale;
            case IDM_SCALE25:
            	 Scale = 4;
				 goto ChangeScale;
            case IDM_SCALE15:
            	 Scale = (double)100.0/15;
				 goto ChangeScale;
            case IDM_SCALE10:
            	 Scale = 10;
				 goto ChangeScale;
                 
            case IDM_SCALE0:
            	 Scale = 0; 
     ChangeScale: 
     			 for (i=0;i<NUMSCALES;i++)
	    		 	CheckMenuItem(GetMenu(hWndDlg), ScaleControls[i], MF_BYCOMMAND | MF_UNCHECKED); 
	    		 CheckMenuItem(GetMenu(hWndDlg), wParam, MF_BYCOMMAND | MF_CHECKED); 
     			 if (!hBMP)
     			 	break;
				 pbmi = (LPBITMAPINFO)GlobalLock (hBMP);
            	 GetClientRect (hWndDlg,&Rect);
            	 if (Scale) 
            	 {
            	 	xrange = max(0,(pbmi->bmiHeader.biWidth/Scale - Rect.right)*Scale);
            	 	yrange = max(0,(pbmi->bmiHeader.biHeight/Scale - Rect.bottom)*Scale); 
            	 }
            	 else 
            	 	xrange = yrange = 0;
				 SetScrollRange(hWndDlg, SB_HORZ, 0, xrange, TRUE);                 
				 SetScrollRange(hWndDlg, SB_VERT, 0, yrange, TRUE);                 
     			 GlobalUnlock (hBMP);
     			 
		         PostMessage(hWndDlg, WM_COMMAND, IDC_DISPLAY, 0L);
                 break;
                 
            case IDC_DISPLAY:
            	 GetClientRect (hWndDlg,&Rect);
            	 hDC = GetDC (hWndDlg); 
            	 xoff = GetScrollPos (hWndDlg, SB_HORZ);
            	 yoff = GetScrollPos (hWndDlg, SB_VERT);
            	 yoff = yrange - yoff; 
            	 FillRect (hDC,&Rect,GetStockObject(WHITE_BRUSH));
		         DisplayBMInRect2 (hDC,hBMP, Rect,Scale,yoff,xoff);
   				 ReleaseDC (hWndDlg,hDC);    
   				 break;
   				 
            case IDM_NEXT: 
            	 lpchr = GlobalLock (hNext);
            	 _fstrcpy (FullBM,lpchr);
            	 GlobalUnlock (hNext);
		         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
            	 break;

            case IDM_PRIOR: 
            	 lpchr = GlobalLock (hPrior);
            	 _fstrcpy (FullBM,lpchr);
            	 GlobalUnlock (hPrior);
		         PostMessage(hWndDlg, WM_COMMAND, IDOK, 0L);
            	 break; 
            	 
            case IDM_PRINT:  
            	 PrintImage (hWndDlg,FullBM,1);
            	 break;

            case IDM_PRINT_ALL:  
            	 PrintImage (hWndDlg,FullBM,2);
            	 break;

           }
         break;    /* End of WM_COMMAND                                 */

    default:
        return FALSE;
   }
 return TRUE;
} /* End of FULLBMMsgProc                                      */



