DLGINCLUDE RCDATA DISCARDABLE
BEGIN
    "DBTEST.H\0"
END

100 DIALOG 8, 16, 272, 215
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Test Load"
FONT 12, "Courier New"
BEGIN
    PUSHBUTTON      "Cancel", ID_CANCEL, 231, 2, 40, 14
    LISTBOX         TL_LB, 0, 83, 271, 132, LBS_USETABSTOPS | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "Up", TL_UP, 38, 51, 40, 14
    PUSHBUTTON      "Next", TL_NEXT, 72, 68, 40, 14
    PUSHBUTTON      "Back", TL_BACK, 2, 67, 40, 14
    EDITTEXT        TL_NRECS, 234, 21, 32, 12, ES_AUTOHSCROLL
    LTEXT           "# Recs", 108, 203, 23, 27, 10
    PUSHBUTTON      "Add", TL_ADD, 231, 35, 40, 14
    PUSHBUTTON      "First", TL_FIRST, 158, 68, 40, 14
END
