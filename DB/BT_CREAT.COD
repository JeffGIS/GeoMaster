;|*** C**********************************************************************
;|*** C*
;|*** %include 'bt.ins.ftn' {/umsc/include/bt.ins.ftn}
;|***       INTEGER*4 ST, LN, DELETE_POS, NEXT, LAST, UP
;|***       INTEGER*2 IBTID, IB
;|***       CHARACTER KEY*256, DATA*256, SAVE_POS*6
;|***       LOGICAL FRST
;|*** 
;|***       BT_PATH_CHANGE(BTID) = .TRUE.
;|*** 
;|*** 10    DELETE_POS = POSA
;|***       IF (UP .EQ. BT_NIL) THEN
;|***           BT_LENGTH    = 0
;|***           BT_FIRST_POS = 0
;|***           BT_NUMLEVS = 0
;|***           CALL MS_$TRUNCATE (BT_HEAD,
;|***      +                       BT_HEAD_LEN + BT_LENGTH + 32,ST)
;|***           RETURN
;|***           ENDIF
;|***       POSA      = UP
;|***       POSB      = 1
;|***       CALL BT_GET_BLOCK
;|*** 
;|***           DO WHILE (DELETE_POS .NE. BT_DOWN)
;|***           INDEX_ITEM_PNT = INDEX_ITEM_PNT + BT_PNTLEN
;|***           POSB = POSB + 1
;|***           ENDDO
;|*** 
;|***       IF (POSB .GT. 1) THEN
;|***           CALL UMDB_WRITE_JOURNAL (.TRUE.)
;|***           IF (POSB .EQ. LNCI) THEN
;|***               LNCI = LNCI - 1
;|***               RETURN
;|***               ENDIF
;|***           LN = (LNCI - POSB) * BT_PNTLEN
;|***           IB = POSB * BT_PNTLEN + 1
;|***           CALL TRAN (CIDATA(IB),CIDATA(IB-BT_PNTLEN),LN)
;|***           LNCI = LNCI - 1
;|***           RETURN
;|***           ENDIF
;|***       IF (LNCI .GT. 1) THEN
;|***           CALL UMDB_WRITE_JOURNAL (.TRUE.)
;|***           LN = LNCI * BT_PNTLEN
;|***           IB = BT_PNTLEN + 1
;|***           CALL TRAN (CIDATA(IB),CIDATA(1),LN)
;|***           LNCI = LNCI - 1
;|***           KEY(:BT_KEYLEN) = INDEX_ENTRY(:BT_KEYLEN)
;|***           CALL PROPAGATE_BT_UP (KEY,KEY(BT_KYLEN+1:))
;|***           RETURN
;|***           ENDIF
;|***       SAVE_POS = POS
;|***       NEXT     = NEXTCI
;|***       LAST     = LASTCI
;|***       IF (LAST .NE. BT_NIL) THEN
;|***           POSA = LAST
;|***           CALL BT_GET_BLOCK
;|***           CALL UMDB_WRITE_JOURNAL (.TRUE.)
;|***           NEXTCI = NEXT
;|***           ENDIF
;|***       IF (NEXT .NE. BT_NIL) THEN
;|***           POSA = NEXT
;|***           CALL BT_GET_BLOCK
;|***           CALL UMDB_WRITE_JOURNAL (.TRUE.)
;|***           LASTCI = LAST
;|***           ENDIF
;|***       POS = SAVE_POS
;|***       CALL BT_GET_BLOCK
;|***       UP  = UPCI
;|***       CALL FREE_BT_REC_ADD (CI_LENGTH_1)
;|***       POS = SAVE_POS
;|***       GO TO 10
;|***       END*/
