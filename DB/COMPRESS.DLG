DLGINCLUDE RCDATA DISCARDABLE
BEGIN
    "COMPRESS.H\0"
END

COMPRESS DIALOG 10, 20, 185, 181
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "BTree Compression"
FONT 8, "Helv"
BEGIN
    COMBOBOX        CMP_FILE_LB, 9, 20, 76, 133, CBS_SIMPLE | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Text", CMP_DIR, 8, 6, 77, 8
    PUSHBUTTON      "OK", IDOK, 138, 3, 40, 14
    PUSHBUTTON      "CANCEL", IDCANCEL, 137, 26, 40, 14
    EDITTEXT        UPPER_SIZE, 141, 81, 32, 12, ES_AUTOHSCROLL
    EDITTEXT        LOWER_SIZE, 141, 100, 32, 12, ES_AUTOHSCROLL
    EDITTEXT        UPPER_SPLIT, 142, 119, 32, 12, ES_AUTOHSCROLL
    EDITTEXT        LOWER_SPLIT, 142, 137, 32, 12, ES_AUTOHSCROLL
    LTEXT           "Upper Size", 109, 95, 84, 42, 8
    LTEXT           "Lower Size", 110, 94, 103, 42, 8
    LTEXT           "Upper Split", 111, 94, 121, 39, 8
    LTEXT           "Lower Split", 112, 95, 140, 39, 8
END
