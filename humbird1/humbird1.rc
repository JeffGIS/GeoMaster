/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_HUMBIRD1            ICON                    "humbird1.ICO"
IDI_SMALL               ICON                    "SMALL.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_HUMBIRD1 MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
    POPUP "Options"
    BEGIN
        MENUITEM "Show Contour Lines",          IDM_SHOWCON, CHECKED
        POPUP "Depth Factor"
        BEGIN
            MENUITEM "0 (Off)",                     IDM_COLORFAC0
            MENUITEM "1",                           IDM_COLORFAC1
            MENUITEM "2",                           IDM_COLORFAC2
            MENUITEM "3",                           IDM_COLORFAC3
            MENUITEM "4",                           IDM_COLORFAC4, CHECKED
            MENUITEM "5",                           IDM_COLORFAC5
            MENUITEM "6",                           IDM_COLORFAC6
            MENUITEM "7",                           IDM_COLORFAC7
            MENUITEM "8",                           IDM_COLORFAC8
            MENUITEM "9",                           IDM_COLORFAC9
            MENUITEM "10",                          IDM_COLORFAC10
        END
        MENUITEM "Highlight 20 to 30 foot",     IDM_HIGHLIGHT
        MENUITEM "Highlight 15 to 20 Feet",     IDM_HIGHLIGHT2
        MENUITEM "Highlight 15 Feet",           IDM_HIGHLIGHT3
        MENUITEM "Adjust Scale to Image",       IDM_ADJUSTSCALE, CHECKED
        POPUP "Zoom Factor"
        BEGIN
            MENUITEM "2",                           IDM_ZOOMBY2, CHECKED
            MENUITEM "1.5",                         IDM_ZOOMBY1P5
            MENUITEM "1.2",                         IDM_ZOOMBY1P2
        END
        MENUITEM "Flip Text",                   IDM_FLIPTEXT, CHECKED
        MENUITEM "Filter Text",                 IDM_DOFILTER, CHECKED
        MENUITEM "Gray Basemap",                IDM_GRAYMAP
        POPUP "Low Water Offset"
        BEGIN
            MENUITEM "None",                        IDM_OFFSET0, CHECKED
            MENUITEM "3 Foot",                      IDM_OFFSET3
            MENUITEM "5 Foot",                      IDM_OFFSET5
            MENUITEM "7 Foot",                      IDM_OFFSET7
            MENUITEM "5 Foot High Water",           IDM_OFFSET5HIGH
            MENUITEM "1 Foot",                      IDM_OFFSET1
            MENUITEM "55 Foot",                     IDM_OFFSET55
        END
        POPUP "Hazard Depth"
        BEGIN
            MENUITEM "3 Feet",                      ID_HAZARDDEPTH_3FEET
            MENUITEM "5 Feet",                      ID_HAZARDDEPTH_5FEET, CHECKED
            MENUITEM "7 Feet",                      ID_HAZARDDEPTH_7FEET
        END
        MENUITEM "Show Hazard Depth",           IDM_SHOWHAZARD
        MENUITEM "Seamless",                    IDM_SEAMLESS, CHECKED
        MENUITEM "Display Grid",                ID_OPTIONS_DISPLAYGRID
    END
    POPUP "iPilot"
    BEGIN
        MENUITEM "Create iPilot Track",         IDM_IPILOT
        POPUP "Options"
        BEGIN
            POPUP "Selected Contour Display"
            BEGIN
                MENUITEM "Use Dash Line",               ID_OPTIONS_USEDASHLINE, CHECKED
                MENUITEM "Line Width = 2",              ID_OPTIONS_LINEWIDTH2
                MENUITEM "Line Width = 3",              ID_OPTIONS_LINEWIDTH3, CHECKED
                MENUITEM "Show Selected Contour",       ID_OPTIONS_SHOWSELECTEDCONTOUR, CHECKED
            END
            POPUP "Track Line Spacing"
            BEGIN
                MENUITEM "5 Meters",                    ID_TRACKLINESPACING_5METERS
                MENUITEM "10 Meters",                   ID_TRACKLINESPACING_10METERS, CHECKED
                MENUITEM "15 Meters",                   ID_TRACKLINESPACING_15METERS
            END
            POPUP "Track Line Limit"
            BEGIN
                MENUITEM "1/2 Mile",                    ID_TRACKLINELIMIT_1MILE, CHECKED
                MENUITEM "2 Miles",                     ID_TRACKLINELIMIT_2MILES
                MENUITEM "4 Miles",                     ID_TRACKLINELIMIT_4MILES
            END
            POPUP "Track Line Display"
            BEGIN
                POPUP "Knot Removal"
                BEGIN
                    MENUITEM "0",                           ID_KNOTREMOVAL_0
                    MENUITEM "25",                          ID_KNOTREMOVAL_25, CHECKED
                    MENUITEM "100",                         ID_KNOTREMOVAL_100
                    MENUITEM "All",                         ID_KNOTREMOVAL_ALL
                END
                MENUITEM "Smooth",                      ID_OPTIONS_SMOOTH, CHECKED
                MENUITEM "ReSample",                    ID_OPTIONS_RESAMPLE, CHECKED
                MENUITEM "Show Point Numbers",          ID_OPTIONS_SHOWPOINTS
            END
        END
        MENUITEM "Continue",                    ID_IPILOT_CONTINUE
        MENUITEM "Reverse",                     ID_IPILOT_REVERSE
        MENUITEM "Double Offset",               ID_NEW_OFFSET
        MENUITEM "Restart",                     ID_IPILOT_RESTART
        MENUITEM "RestartReverse",              ID_IPILOT_RESTARTREVERSE
    END
    MENUITEM "Select Lake",                 IDM_SELECTLAKE
    MENUITEM "Zoom In",                     IDM_ZOOM_IN
    MENUITEM "Zoom Out",                    IDM_ZOOM_OUT
    MENUITEM "Pan Left",                    IDM_PAN_LEFT
    MENUITEM "Pan Right",                   IDM_PAN_RIGHT
    MENUITEM "Pan Up",                      IDM_PAN_UP
    MENUITEM "Pan Down",                    IDM_PAN_DOWN
    MENUITEM "Capture",                     ID_CAPTURE
    MENUITEM "Replay",                      ID_REPLAY
    MENUITEM "ReSelect",                    ID_RESELECT
    MENUITEM "Redisplay",                   ID_REDISPLAY
END


