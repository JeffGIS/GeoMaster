//
// Accelerator
//

IDC_HUMBIRD1 ACCELERATORS 
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG  22, 17, 230, 75
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_HUMBIRD1,IDC_MYICON,14,9,20,20
    LTEXT           "humbird1 Version 1.0",IDC_STATIC,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2009",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
    LTEXT           "Static",IDC_CARDNAME,53,46,78,8
    LTEXT           "Static",IDC_CIDMESSAGE,54,58,73,8
END

IDD_SELECTLAKE DIALOGEX 22, 17, 230, 228
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Select Lake"
FONT 8, "System", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
    LISTBOX         IDC_LIST1,5,5,187,194,LBS_SORT | LBS_USETABSTOPS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_REPLAYID,13,217,73,9,ES_AUTOHSCROLL | ES_NUMBER
END

IDD_CHOOSE_DIALOG DIALOGEX 0, 0, 215, 131
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | DS_CENTERMOUSE | WS_POPUP | WS_CAPTION
CAPTION "Tracking Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,170,26,38,14
    CONTROL         "Green (solid) NorthWest",IDC_DIRECTION1,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,19,132,10
    GROUPBOX        "Direction of Travel",IDC_STATIC,7,7,151,39
    PUSHBUTTON      "OK",IDOK,170,7,38,14,WS_DISABLED
    CONTROL         "Red (dashed) SouthEast",IDC_DIRECTION2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,31,132,10
    GROUPBOX        "Offset From Selected Contour",IDC_STATIC,7,48,201,52
    EDITTEXT        IDC_OFFSETVAL,14,61,23,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "feet",IDC_STATIC,39,64,14,8
    CONTROL         "",IDC_OFFSETLEFT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,76,177,10
    CONTROL         "",IDC_OFFSETRIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,87,177,10
    EDITTEXT        IDC_KNOT,69,103,20,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN1,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS,96,103,12,14
    LTEXT           "Knot removal",IDC_STATIC,15,106,50,8
    EDITTEXT        IDC_NSMOOTH,158,103,20,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Smooth",IDC_STATIC,131,107,26,8
END


