: ${IPW?}

## NAME
##	histeq -- make histogram equalization look-up table
##
## SYNOPSIS
##	histeq [-i low,high] [-o low,high] [-f floor] [-c ceiling] [-m max]
##
## DESCRIPTION
##	Histeq computes an IPW look-up table for a histogram equalization
##	contrast stretch, from an IPW histogram.
##	The histogram is read from the standard input, if it is not
##	specified as an operand.  The look-up table is written to the
##	standard output.
##
## OPTIONS
##	-i	low and high values to use from the input histogram
##		(default: 0, 255)
##
##	-o	low and high values for the output look-up table
##		(default: 0, 255)
##
##	-f	if -i is specified, set the values lower than the specified
##		input 'lo' to 'floor'
##		(default: output lo)
##
##	-c	if -i is specified, set the values higher than the specified
##		input 'hi' to 'ceiling'
##		(default: output hi)
##
##	-m 	maximum x-value in histogram (default: 255)
##
## OPERANDS
##	hst	IPW histogram
##
## EXAMPLES
##
## FILES
##
## DIAGNOSTICS
##
## RESTRICTIONS
##
## FUTURE DIRECTIONS
##	histeq is currently implemented as a shell script.
##	It may be desirable to reimplement histeq as a program.
##
## BUGS

PATH="$PATH:$IPW/lib"
. ipwenv

synopsis='[-i low,high] [-o low,high] [-f floor] [-c ceiling]'
descrip='make histogram equalization look-up table'

# get command-line arguments

set - `getopt 'i:o:f:c:m:' $* 2>/dev/null` || {
	usage $0 "$synopsis" "$descrip"
	exit 1
}

i_args=
o_args=
floor=
ceil=
max=256

while :; do
	case $1 in
	--)	shift
		break
		;;
	-i)	i_args=$2
		shift
		;;
	-o)	o_args=$2
		shift
		;;
	-c)	ceil=$2
		shift
		;;
	-f)	floor=$2
		shift
		;;
	-m)	max=$2
		shift
		;;
	*)	shbug $0 "'getopt' failed"
		exit 1
		;;
	esac
	shift
done

case $i_args in
'')	in_lo=0
	in_hi=`expr $max - 1`
	;;
*)	IFS_save="$IFS"
	IFS=,
	set,$i_args
	in_lo=$1
	in_hi=$2
	IFS="$IFS_save"
	;;
esac

case $o_args in
'')	out_lo=0
	out_hi=255
	;;
*)	IFS_save="$IFS"
	IFS=,
	set,$o_args
	out_lo=$1
	out_hi=$2
	IFS="$IFS_save"
	;;
esac

case $floor in
'')	floor=$out_lo
	;;
esac

case $ceil in
'')	ceil=$out_hi
	;;
esac

# avoid binary I/O on tty

if test -t 0; then
	sherror	$0 "can't read histogram from a terminal"
	exit 1
fi

if test -t 1; then
	sherror $0 "can't write lut to a terminal"
	exit 1
fi

# write lookup table header to stdout

mkbih -l 1 -s $max  -i `nbits $ceil` -f

# { equalization parameters;
#   normalized cumulative histogram < IPW histogram on stdin } |
# awk script generates LUT |
# convert to binary

{
	echo $in_lo $in_hi $out_lo $out_hi $floor $ceil
	cnhist $in_lo $in_hi
} | 
	$AWK '
		NR == 1 {
			in_lo = $1 + 2
			in_hi = $2 + 2
			scale = $4 - $3
			out_lo = $3
			floor = $5
			ceil = $6
			next
		}

		NR < in_lo {
			print floor
			next
		}

		NR <= in_hi {
			print int(scale * $1 + out_lo) 
			next
		}

		NR > in_hi {
			print ceil
		}
	' | 
	atob -1

exit 0

# $Header: /usr/home/ipw/src/bin/histeq/RCS/histeq.sh,v 1.6 89/10/23 18:34:48 frew Exp $
