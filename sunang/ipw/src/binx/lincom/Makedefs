# C_SPECIAL	"cc" options
# LD_SPECIAL	loader options
# LIBS_SPECIAL	object libraries

C_SPECIAL=
LD_SPECIAL=
LIBS_SPECIAL=

# PGM		program name
# OBJS		component object files
# SRCS		component source files

PGM= lincom
OBJS=\
	coeffs.o headers.o lincom.o main.o output.o parm.o re_map.o

SRCS=\
	coeffs.c headers.c lincom.c main.c output.c parm.c re_map.c

default: pgm
install: install-pgm

$(OBJS): pgm.h

