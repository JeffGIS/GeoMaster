# C_SPECIAL	"cc" options
# LD_SPECIAL	loader options
# LIBS_SPECIAL	object libraries

C_SPECIAL=$(C_SINGLE)

# PGM		program name
# OBJS		component object files
# SRCS		component source files

PGM= shade
OBJS=\
	azmf.o buffers.o cosines.o data.o headers.o init_shade.o invzenf.o \
	main.o newlqh.o newsunh.o shadetbl.o trigtbl.o zenf.o

SRCS=\
	azmf.c buffers.c cosines.c data.c headers.c init_shade.c invzenf.c \
	main.c newlqh.c newsunh.c shadetbl.c trigtbl.c zenf.c

default: pgm
install: install-pgm

$(OBJS): $(PGM).h

