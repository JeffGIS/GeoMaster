# C_SPECIAL	"cc" options
# LD_SPECIAL	loader options
# LIBS_SPECIAL	object libraries

C_SPECIAL=
LD_SPECIAL=
LIBS_SPECIAL=
PGM_DIR=$(HOME)/bin
PGM_MODE=711

# PGM		program name
# OBJS		component object files
# SRCS		component source files

PGM=sunlight
OBJS=\
	krontime.o main.o sunlight_opts.o sunrise.o vqk15.o vqk21.o vqkagn.o \
	zerobr.o

SRCS=\
	krontime.c main.c sunlight_opts.c sunrise.c vqk15.c vqk21.c vqkagn.c \
	zerobr.c

default: pgm
install: install-pgm

main.o: $(PGM).h
sunrise.o: $(PGM).h
sunlight_opts.o: $(PGM).h
