# some special BS here since "srcs" is identical to "objs"
# we just install 2 copies of "objs"
# a symbolic link would be cleaner but nonportable
# a hard link would cause ulcers

SCRIPT=objs
SCRIPT_DIR=$(ETC_DIR)

default: script
	$(MAKE) script SCRIPT=srcs

install: install-script
	$(MAKE) install-script SCRIPT=srcs

srcs.sh: objs.sh
	cp objs.sh srcs.sh

# $Header: /local/share/pkg/ipw/src/etc/objs/RCS/Makedefs,v 1.4 90/11/16 16:59:59 frew Exp $
