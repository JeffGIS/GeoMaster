: {$IPW?}

## NAME
##	ipwman -- generate IPW "manual" from source file comments
##
## SYNOPSIS
##	ipwman name ...
##
## DESCRIPTION
##	ipwman simulates a UNIX "man" command for IPW, by extracting and
##	(crudely) formatting the header comments from IPW source code.
##
## OPTIONS
##
## EXAMPLES
##
## FILES
##
## DIAGNOSTICS
##
## RESTRICTIONS
##
## FUTURE DIRECTIONS
##	ipwman is currently implemented as a shell script.
##	It may be desirable to reimplement ipwman as a program.
##
## BUGS

PATH=$PATH:$IPW/lib
. ipwenv

case $* in
''|-H)	usage $0 'function_or_command ...' \
		'extract header comments from IPW source'
	exit 1
	;;
esac

cd $IPW/src || exit 1

# find files containing header comments

pdirs='bin etc lib'

files=
undoc=

for item do
	found=no

	for dir in $pdirs; do
		test -r $dir/$item/main.c && {
			files="$files $dir/$item/main.c"
			found=yes
			continue
		}

		test -r $dir/$item/$item.sh && {
			files="$files $dir/$item/$item.sh"
			found=yes
		}

		test -r $dir/$item/$item.c && {
			files="$files $dir/$item/$item.c"
			found=yes
		}
	done

	for dir in lib/lib*; do
		test -r $dir/$item.c && {
			files="$files $dir/$item.c"
			found=yes
		}

		for subdir in $dir/*; do
			test -d $subdir -a -r $subdir/$item.c && {
				files="$files $subdir/$item.c"
				found=yes
			}
		done
	done

	case $found in
	no)	undoc="$undoc $item"
		;;
	esac
done

# print header comments

if test -t 0  -a  -t 1; then
	more=more
else
	more=cat
fi

{
	case $undoc in
	'')	;;
	*)	echo 'No information for:'
		for item in $undoc; do
			echo "	$item"
		done
		echo ''
		;;
	esac

	for file in $files; do
		sed -n '
			/^[*#][*#]/s/.. *//p
			/\$Header/s/^.* \(..\/..\/..\) .*$/\
				\1/p
		' $file
		echo ''
	done
} |
	$more

# $Header: /local/share/pkg/ipw/src/etc/ipwman/RCS/ipwman.sh,v 1.12 90/11/16 16:52:04 frew Exp $
