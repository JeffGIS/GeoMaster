# make rules

# A small difference here -- we make *_NORMAL = *_DEBUG.  In other words, when
# you do a make debug, it turns _off_ optimization and turns on debugging.
# The old ipwmake would add -g to the -O flags, which makes some compilers
# unhappy.  Use either 'make C_NORMAL="-g -O2"' or 'make plusdebug" to just
# add the debugging option.

debug:
	@$(MAKE) C_OPTION="$(C_DEBUG)" LD_OPTION="$(LD_DEBUG)" LINT_OPTION="$(LINT_DEBUG)" STRIP="" LIB_SUFFIX="_d.a"

plusdebug:
	@$(MAKE) C_OPTION="$(C_OPTION) $(C_DEBUG)" LD_OPTION="$(LD_OPTION) $(LD_DEBUG)" LINT_OPTION="$(LINT_OPTION) $(LINT_DEBUG)" STRIP="" LIB_SUFFIX="_do.a"

profile:
	@$(MAKE) C_OPTION+="$(C_PROFILE)" LD_OPTION+="$(LD_PROFILE)" STRIP="" LIB_SUFFIX="_p.a"

# Note that there is a major flaw with the way this works -- we can't install
# our debugged or profiled code!  As far as I can tell, GNU Make (nor normal
# make) can handle this in any reasonable way.  So..  we have a new variable
# called "OPT" that can get set to our desired option.
# Example:
#           make OPT=debug install

ifdef OPT
  ifeq "$(OPT)" "debug"
    C_OPTION     = $(C_DEBUG)
    LD_OPTION    = $(LD_DEBUG)
    LINT_OPTION  = $(LINT_DEBUG)
    LIB_SUFFIX   = _d.a
    STRIP=
  endif
  ifeq "$(OPT)" "plusdebug"
    C_OPTION    += $(C_DEBUG)
    LD_OPTION   += $(LD_DEBUG)
    LINT_OPTION += $(LINT_DEBUG)
    LIB_SUFFIX   = _do.a
    STRIP=
  endif
  ifeq "$(OPT)" "profile"
     C_OPTION   += $(C_PROFILE)
     LD_OPTION  += $(LD_PROFILE)
     LIB_SUFFIX  = _p.a
     STRIP=
  endif
endif

CFLAGS=$(C_SPECIAL) $(C_OPTION) $(C_STD)
LINTFLAGS=$(C_SPECIAL) $(LINT_SPECIAL) $(LINT_OPTION) $(LINT_STD)

#-----------------------------------------------------------------------------

$(SCRIPT): $(SCRIPT).sh
	@true

script: $(SCRIPT)

install-script: $(SCRIPT)
	$(INSTALL) -c -m $(SCRIPT_MODE) $(SCRIPT).sh $(SCRIPT_DIR)/$(SCRIPT)

#-----------------------------------------------------------------------------

lint:
	$(LINT) $(LINTFLAGS) $(SRCS) $(wildcard $(LINT_DIR)/$(LINT_PREFIX)*) \
        	$(LINTGREPV)

#-----------------------------------------------------------------------------

LDFLAGS=$(LD_SPECIAL) $(LD_OPTION) $(LD_STD)
LIB_IPW=$(LIB_DIR)/$(LIB_PREFIX)ipw$(LIB_SUFFIX)
LIB_UNIX=$(LIB_DIR)/$(LIB_PREFIX)unix$(LIB_SUFFIX)
LIBS=$(LIBS_SPECIAL) $(LIB_IPW) $(LIB_UNIX) $(LIBS_STD)

$(PGM): $(OBJS)
	$(CLD) $(LDFLAGS) -o $@ $(OBJS) $(LIBS) || $(RM) $@

pgm: $(PGM)

install-pgm: $(PGM)
	$(INSTALL) $(STRIP) -m $(PGM_MODE) $(PGM) $(PGM_DIR)

#-----------------------------------------------------------------------------

# ipwmake extracts the files from the archive, then puts them back in.  While
# this is nice in concept, it is extremely tedious when each extract/insert
# cycle is 30 seconds long for each subdirectory.  This makes a 1 minute make
# of libipw take about 10 minutes.
# Instead, we leave the .o files, then make the archive.  When the archive is
# successfully made, do a "make clean" in the lib directory and the .o files
# will be removed.

LIB_PATH=$(LIB_DIR)/$(LIB_PREFIX)$(LIB)$(LIB_SUFFIX)

# All we want to do is make the objects.  No other work necessary.
lib: $(OBJS)

# Hmm.  This doesn't seem to be working.  Fixme 8/17/95.
# On the other hand, no harm done.
ifneq ($(RANLIB),'true')
install-lib: lib
	$(AR) $(AR_ROPTS) $(LIB_PATH) $(OBJS)
	$(RANLIB) $(LIB_PATH) >/dev/null
	$(CHMOD) $(LIB_MODE) $(LIB_PATH)
else
install-lib: lib
	$(AR) $(AR_ROPTS) $(LIB_PATH) $(OBJS)
	$(CHMOD) $(LIB_MODE) $(LIB_PATH)
endif

LINTLIB=$(LINT_PREFIX)$(LIB)$(LINT_SUFFIX)


#-----------------------------------------------------------------------------

# This is pretty odd, but it makes a clean subrecursive make.
#
# for special targets that we want to recurse, we do a 
# "make all TARGET=whatever".  Since the "TARGET=whatever" string will
# get added to $(MAKE), we remove it from $(MAKE) so we don't keep
# seeing it.
#
# a "make all" will depend on each directory with .dirmake appended to it
# (to prevent problems when the directory is the name of the program target
# as is often the case).  Each of these in turn depends on FORCE -- an
# empty rule, which will force each one to execute the actions.
#
# The action for each directory is a recursive make.

MAKE := $(subst TARGET=$(TARGET),,$(MAKE))

ifdef DIRS

all: $(addsuffix .dirmake, $(DIRS))

$(addsuffix .dirmake, $(DIRS)): FORCE
	@echo ::: $(subst .dirmake,,$@) :::
	@$(MAKE) -C $(subst .dirmake,,$@) $(TARGET)

FORCE:

endif

#-----------------------------------------------------------------------------

install-all:
	@$(MAKE) all TARGET=install

#-----------------------------------------------------------------------------
#
# Default rules for uninstall, clean, realclean.  Others can be added here.
#

ifeq ($(PGM),NO_PGM)
  ifeq ($(SCRIPT),NO_SCRIPT)
    ifeq ($(LIB),NO_LIB)
#-------------------------------------------- No targets
      ifndef DIRS
realclean clean uninstall:
	@echo Nothing to $@.
lintlib:
	@echo No libraries.
      else  #DIRS
        ifeq ($(SUBLIBS),NO_LIBS)
realclean clean uninstall:
	@$(MAKE) all TARGET=$@
lintlib:
	@echo No libraries below this point.
        else   #SUBLIBS
realclean clean uninstall lintlib:
	@$(MAKE) all TARGET=$@
        endif
      endif
    else  #LIB
#-------------------------------------------- Library
realclean: clean
	rm -f core $(LINT_OBJS)
clean:
	rm -f $(OBJS)
uninstall:
	$(AR) $(AR_DOPTS) $(LIB_PATH) $(OBJS)
	$(RANLIB) $(LIB_PATH) >/dev/null
lintlib:
	$(LINT) $(LINTFLAGS) $(LINT_LIBOPT)$(LIB) $(SRCS)
	-test -f $(LIB).ln && mv $(LIB).ln $(LINTLIB)
	cat $(LINTLIB) >> $(LINT_DIR)/$(LINTLIB)
	rm -f $(LINTLIB)
#	$(INSTALL) -m $(LIB_MODE) $(LINTLIB) $(LINT_DIR)
    endif
  else  #SCRIPT
#-------------------------------------------- Script
realclean clean:
	@echo Nothing to clean.
uninstall:
	rm -f $(SCRIPT_DIR)/$(SCRIPT)
lintlib:
	@true
  endif
else  #PGM
#-------------------------------------------- Program
realclean: clean
	rm -f core $(LINT_OBJS) $(PURE_XTRA)
clean:
	rm -f $(PGM) $(OBJS) $(PURE_OBJS)
uninstall:
	rm -f $(PGM_DIR)/$(PGM)
lintlib:
	@true
endif
